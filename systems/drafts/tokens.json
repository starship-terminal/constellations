{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$value": "-apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on the homepage h1"
          }
        },
        "body": {
          "$value": "-apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body"
          }
        },
        "ui": {
          "$value": "-apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on the Menu link"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "48px",
          "fontWeight": "400",
          "lineHeight": "57.6px",
          "letterSpacing": "-0.96px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the homepage h1 at 1440"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "17px",
          "lineHeight": "27.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on body"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "17px",
          "fontWeight": "600",
          "lineHeight": "27.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the Menu link"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the error-page Drafts Home button"
        }
      },
      "card": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on a homepage feature card"
        }
      }
    },
    "space": {
      "button-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding on the error-page button"
        }
      },
      "button-y": {
        "$value": "9px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed vertical padding on the error-page button"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on body"
        }
      },
      "ink": {
        "$value": "rgb(22, 28, 45)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the homepage h1"
        }
      },
      "muted": {
        "$value": "rgb(134, 154, 184)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the error-page lede"
        }
      },
      "tagline": {
        "$value": "rgb(128, 128, 128)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the homepage tagline span"
        }
      },
      "nav": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the Menu link over the cover"
        }
      },
      "cover": {
        "$value": "rgb(15, 65, 126)",
        "$type": "color",
        "$extensions": {
          "source": "sampled cover photograph before quantize; the cover is a gradient, not a flat fill"
        }
      },
      "footer": {
        "$value": "rgb(23, 57, 115)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on footer"
        }
      },
      "cta": {
        "$value": "rgb(51, 94, 234)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on the error-page button"
        }
      },
      "on-cta": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the error-page button"
        }
      },
      "primary-declared": {
        "$value": "#335eea",
        "$type": "color",
        "$extensions": {
          "source": "declared --bs-primary"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
