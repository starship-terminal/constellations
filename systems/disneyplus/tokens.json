{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Inspire, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-family on body, h1, LOG IN, and DISNEY+ ANNUAL at https://www.disneyplus.com/en-sg, 2026-11-22"
