{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#111111",
        "$type": "color",
        "$extensions": { "source": "computed header background rgb(17, 17, 17) and ribbon type, 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Shop now face rgb(255, 255, 255) and listing title block" }
      },
      "ink-soft": {
        "$value": "#2b2b2b",
        "$type": "color",
        "$extensions": { "source": "computed product brand color rgb(43, 43, 43)" }
      },
      "muted": {
        "$value": "#656565",
        "$type": "color",
        "$extensions": { "source": "computed product name and footer meta rgb(101, 101, 101)" }
      },
      "line": {
        "$value": "#cbcbcb",
        "$type": "color",
        "$extensions": { "source": "computed service ribbon background rgb(203, 203, 203) and email border" }
      },
      "chip-line": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": { "source": "computed size chip border rgb(229, 229, 229)" }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed nav, logo fill #fff, and Add to Bag label rgb(255, 255, 255)" }
      }
    },
    "font": {
      "sans": {
        "$value": "AkkuratPro, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed nav, buttons, designer, and price. AkkuratPro 400 and 700 were loaded. Files are not in this package." }
      },
      "display": {
        "$value": "\"Chronicle Display\", \"Times New Roman\", serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed hero title, New In, Clothing, and product brand. Chronicle Display 400 was loaded." }
      },
      "serif": {
        "$value": "ChronicleText, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed hero body, product name, and footer heading. ChronicleText files are not in this package." }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "48px", "fontWeight": 500, "lineHeight": "60px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage New In and About h1" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "32px", "fontWeight": 500, "lineHeight": "40px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage hero title" }
      },
      "listing": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "40px", "letterSpacing": "1px" },
        "$type": "typography",
        "$extensions": { "source": "computed Clothing h1" }
      },
      "brand": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "40px", "letterSpacing": "1.6px" },
        "$type": "typography",
        "$extensions": { "source": "computed product brand" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "18px", "letterSpacing": "0.14px" },
        "$type": "typography",
        "$extensions": { "source": "computed department link" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "18px", "letterSpacing": "0.14px" },
        "$type": "typography",
        "$extensions": { "source": "computed Shop now" }
      },
      "designer": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 700, "lineHeight": "18px", "letterSpacing": "0.28px" },
        "$type": "typography",
        "$extensions": { "source": "computed listing designer, uppercase" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "24px" },
        "$type": "typography",
        "$extensions": { "source": "computed hero body" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "12px", "fontWeight": 700, "lineHeight": "16px", "letterSpacing": "0.12px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer NEED HELP and listing quick links" }
      }
    },
    "radius": {
      "button": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "computed Shop now, Add to Bag, size chip, and email field" }
      }
    },
    "size": {
      "ribbon": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": "computed service ribbon height" }
      },
      "header": {
        "$value": "106px",
        "$type": "dimension",
        "$extensions": { "source": "computed sf-Header2__container height, under the 32px ribbon" }
      },
      "button": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to Bag and size chip height. Shop now was 42px." }
      }
    }
  }
}
