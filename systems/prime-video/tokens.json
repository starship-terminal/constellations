    "motion": {
      "duration": {
        "nav": {
          "$type": "duration",
          "$value": "100ms",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "nav link computed transition 0.1s"
            }
          }
        },
        "cta": {
          "$type": "duration",
          "$value": "200ms",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "trial CTA computed transition 0.2s"
            }
          }
        }
      },
      "easing": {
        "cta": {
          "$type": "cubicBezier",
          "$value": [
            0.25,
            1,
            0.5,
            1
          ],
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "trial CTA computed cubic-bezier(0.25, 1, 0.5, 1)"
            }
          }
        }
      }
    }
  },
  "dark": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "#00050d",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "body and nav background-color rgb(0, 5, 13)"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#222222",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "footer background-color rgb(34, 34, 34)"
          }
        }
      },
      "action": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "trial and sign-in CTA background-color rgb(255, 255, 255)"
          }
        }
      },
      "join": {
        "$type": "color",
        "$value": "rgba(26, 152, 255, 0.8)",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Join Prime computed background-color"
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "h1, body copy and nav link color rgb(255, 255, 255)"
          }
        }
      },
      "on-action": {
        "$type": "color",
        "$value": "#00050d",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "trial CTA color rgb(0, 5, 13)"
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#8197a4",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "footer color rgb(129, 151, 164)"
          }
        }
      },
      "link": {
        "$type": "color",
        "$value": "#79b8f3",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "footer link color rgb(121, 184, 243)"
          }
        }
      }
    },
    "border": {
      "stroke": {
        "$type": "color",
        "$value": "#f1f1f1",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "focused nav link outline rgb(241, 241, 241) solid 2px. No resting border was painted on the marketing chrome."
          }
        }
