      "focus": {
        "$type": "color",
        "$value": "#e59700",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "first focusable outline rgb(229, 151, 0) auto 5px"
          }
        }
      }
    },
    "component": {
      "button": {
        "bg": {
          "$type": "color",
          "$value": "{dark.background.action}"
        },
        "text": {
          "$type": "color",
          "$value": "{dark.text.on-action}"
        },
        "radius": {
          "$type": "dimension",
          "$value": "{core.radius.control}"
        },
        "padding": {
          "$type": "dimension",
          "$value": "8px"
        },
        "height": {
          "$type": "dimension",
          "$value": "60px"
        }
      },
      "nav": {
        "bg": {
          "$type": "color",
          "$value": "{dark.background.page}"
        },
        "text": {
          "$type": "color",
          "$value": "{dark.text.primary}"
        },
        "height": {
          "$type": "dimension",
          "$value": "60px"
        }
      }
    }
