  "$themes": [
    {
      "id": "dark",
      "name": "Prime Video signed-out",
      "selectedTokenSets": {
        "core": "source",
        "dark": "enabled"
      }
    },
    {
      "id": "light",
      "name": "Amazon sign-in wall",
      "selectedTokenSets": {
