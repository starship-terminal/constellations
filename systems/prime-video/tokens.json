{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "family": {
        "ember": {
          "$type": "fontFamily",
          "$value": "Amazon Ember, Amazon Arabic Ember, Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "primevideo.com nonprime homepage, 2026-11-19, getComputedStyle on body, nav and h1"
            }
          }
        },
        "amazon-signin": {
          "$type": "fontFamily",
          "$value": "Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "amazon.sg/ap/signin reached from /signup, 2026-11-19, getComputedStyle on body. Amazon Ember did not load on this wall."
            }
          }
        }
      }
    },
    "typography": {
      "heading-800": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "36px",
          "fontWeight": 700,
          "lineHeight": "40px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "h1._heading-800 computed 36px/40px/700, and --fable-typography-heading-800-* on :root"
          }
        }
      },
      "heading-600": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "32px",
          "fontWeight": 700,
          "lineHeight": "36px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--fable-typography-heading-600-* on :root. Not used by a visible heading on the signed-out homepage."
          }
        }
      },
      "heading-400": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "28px",
          "fontWeight": 700,
          "lineHeight": "39px",
          "letterSpacing": "0.04em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--fable-typography-heading-400-* on :root"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "25px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "feature copy under each h1, computed 18px/25px/400, matching --fable-typography-body-*"
          }
        }
      },
      "label-600": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "18px",
          "fontWeight": 500,
          "lineHeight": "22px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "trial CTA computed 18px/500/22px, and --fable-typography-label-600-*"
          }
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "18px",
          "letterSpacing": "0.49px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "nav links and Join Prime, computed 14px/500, letter-spacing 0.49px. Line height from --fable-typography-label-100-line-height 18px; computed line-height was normal."
          }
        }
      },
      "fine": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "trial fine print computed 14px/20px/400"
          }
        }
      },
      "footer": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.ember}",
          "fontSize": "15px",
          "fontWeight": 400,
          "lineHeight": "19px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "footer computed font-size 15px, line-height 19px"
          }
        }
      },
      "signin-heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.amazon-signin}",
          "fontSize": "20px",
          "fontWeight": 400,
          "lineHeight": "28px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Amazon sign-in h1 computed 20px/28px/400"
          }
        }
      },
      "signin-label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.amazon-signin}",
          "fontSize": "14px",
          "fontWeight": 700,
          "lineHeight": "20px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Amazon sign-in field label computed 14px/700/20px"
          }
        }
      },
      "signin-legal": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.amazon-signin}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "16px",
          "letterSpacing": "0em"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Amazon sign-in Conditions of Use link computed 12px/16px"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "nav links, Join Prime, trial CTA, Amazon card and email field all computed border-radius 8px"
          }
        }
      },
      "dialog": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--fable-dialog-border-top-radius and --fable-dialog-border-bottom-radius on :root. No dialog was opened."
          }
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "100px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Amazon Continue button computed border-radius 100px"
          }
        }
      }
    },
