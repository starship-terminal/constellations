{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed body background rgb(255, 255, 255); css-var --xhUGwc #fff" } },
      "ink": { "$value": "#16171a", "$type": "color", "$extensions": { "source": "computed body color rgb(22, 23, 26); css-var --YLNNHc" } },
      "ink-strong": { "$value": "#202124", "$type": "color", "$extensions": { "source": "computed color on the visible Google Search button and the sign-in heading, rgb(32, 33, 36)" } },
      "blue": { "$value": "#0b57d0", "$type": "color", "$extensions": { "source": "computed Sign in background rgb(11, 87, 208); css-var --TMYS9" } },
      "blue-accounts": { "$value": "#1a73e8", "$type": "color", "$extensions": { "source": "computed Next button on the empty sign-in wall, rgb(26, 115, 232)" } },
      "link": { "$value": "#1a0dab", "$type": "color", "$extensions": { "source": "computed promo link rgb(26, 13, 171); css-var --JKqx2" } },
      "field-border": { "$value": "#dadce0", "$type": "color", "$extensions": { "source": "computed search field border rgb(218, 220, 224)" } },
      "button-face": { "$value": "#f8f9fa", "$type": "color", "$extensions": { "source": "computed Google Search button background rgb(248, 249, 250)" } },
      "footer": { "$value": "#ececed", "$type": "color", "$extensions": { "source": "sampled flat pixel rgb(236, 236, 237) on the homepage country row, before quantize" } },
      "hairline": { "$value": "#d2d2d2", "$type": "color", "$extensions": { "source": "css-var --gS5jXb declared #d2d2d2" } },
      "yellow": { "$value": "#fbbc04", "$type": "color", "$extensions": { "source": "css-var --ywz01c declared #fbbc04. Logo yellow, not a control fill." } },
      "on-accent": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed Sign in label rgb(255, 255, 255)" } }
    },
    "font": {
      "family": {
        "ui": { "$value": "Arial, sans-serif", "$type": "fontFamily", "$extensions": { "source": "computed font-family on body and the Google Search button" } },
        "brand": { "$value": "\"Google Sans Text\", Roboto, Helvetica, Arial, sans-serif", "$type": "fontFamily", "$extensions": { "source": "computed font-family on the Sign in link" } }
      }
    },
    "radius": {
      "field": { "$value": "26px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the homepage search field" } },
      "button": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the Google Search button" } },
      "pill": { "$value": "100px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the Sign in link" } },
      "accounts": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the sign-in Next button" } }
    },
    "space": {
      "button-x": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the Google Search button" } },
      "signin-x": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the Sign in link" } },
      "signin-y": { "$value": "10px", "$type": "dimension", "$extensions": { "source": "computed vertical padding on the Sign in link" } }
    },
    "size": {
      "field": { "$value": "52px", "$type": "dimension", "$extensions": { "source": "computed height of the homepage search field" } },
      "button": { "$value": "36px", "$type": "dimension", "$extensions": { "source": "computed height of the visible Google Search button" } },
      "signin": { "$value": "40px", "$type": "dimension", "$extensions": { "source": "computed height of the Sign in link" } },
      "identifier": { "$value": "56px", "$type": "dimension", "$extensions": { "source": "computed height of the empty email field on the sign-in wall" } }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "400" },
        "$type": "typography",
        "$extensions": { "source": "computed style on body at 1440" }
      },
      "field": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "22px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the homepage search textarea" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "400" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the Google Search button" }
      },
      "signin": {
        "$value": { "fontFamily": "{core.font.family.brand}", "fontSize": "14px", "fontWeight": "500", "lineHeight": "18px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the Sign in link" }
      },
      "heading": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "24px", "fontWeight": "400" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the sign-in wall h1" }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "computed body background" } },
        "footer": { "$value": "{core.color.footer}", "$type": "color", "$extensions": { "source": "sampled country row" } },
        "field": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "computed search field background" } },
        "button": { "$value": "{core.color.button-face}", "$type": "color", "$extensions": { "source": "computed Google Search button background" } }
      },
      "text": {
        "primary": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "computed body color" } },
        "button": { "$value": "{core.color.ink-strong}", "$type": "color", "$extensions": { "source": "computed Google Search button color" } },
        "on-accent": { "$value": "{core.color.on-accent}", "$type": "color", "$extensions": { "source": "computed Sign in label" } },
        "link": { "$value": "{core.color.link}", "$type": "color", "$extensions": { "source": "computed promo link" } }
      },
      "action": {
        "fill": { "$value": "{core.color.blue}", "$type": "color", "$extensions": { "source": "computed Sign in background" } },
        "accounts": { "$value": "{core.color.blue-accounts}", "$type": "color", "$extensions": { "source": "computed Next button on the empty sign-in wall" } }
      },
      "border": {
        "field": { "$value": "{core.color.field-border}", "$type": "color", "$extensions": { "source": "computed search field border" } },
        "hairline": { "$value": "{core.color.hairline}", "$type": "color", "$extensions": { "source": "css-var --gS5jXb" } }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
