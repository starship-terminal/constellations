{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#faf8f5",
        "$type": "color",
        "$extensions": { "source": "Measured. body backgroundColor rgb(250, 248, 245) on https://www.etsy.com/ 2026-11-22." }
      },
      "text": {
        "$value": "#312b36",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(49, 43, 54)." }
      },
      "accent": {
        "$value": "#f1641e",
        "$type": "color",
        "$extensions": { "source": "Measured. Search button ::after backgroundColor rgb(241, 100, 30). Logo fill matches." }
      },
      "on-accent": {
        "$value": "#faf8f5",
        "$type": "color",
        "$extensions": { "source": "Measured. Search icon fill rgb(250, 248, 245) on the orange search circle." }
      },
      "ink": {
        "$value": "#312b36",
        "$type": "color",
        "$extensions": { "source": "Measured. Signup Continue backgroundColor rgb(49, 43, 54)." }
      },
      "on-ink": {
        "$value": "#faf8f5",
        "$type": "color",
        "$extensions": { "source": "Measured. Signup Continue color rgb(250, 248, 245)." }
      },
      "disabled": {
        "$value": "#c8bdb7",
        "$type": "color",
        "$extensions": { "source": "Measured. Empty login Sign in backgroundColor rgb(200, 189, 183)." }
      },
      "field-border": {
        "$value": "#928681",
        "$type": "color",
        "$extensions": { "source": "Measured. Login email field border rgb(146, 134, 129)." }
      }
    },
    "font": {
      "ui": {
        "$value": "ABCDiatype, -apple-system, Helvetica Neue, Droid Sans, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily. Files are not in this package." }
      },
      "display": {
        "$value": "ABCOtto, Charter, Charter Bitstream, Cambria, Noto Serif Light, Droid Serif, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. Homepage h1 fontFamily." }
      }
    },
    "radius": {
      "pill": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search field left radius, Sign in radius, and login Sign in radius." }
      },
      "field": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Login email field wrapper borderRadius." }
      }
    },
    "size": {
      "search": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search field and search button height." }
      },
      "body": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. body fontSize." }
      },
      "display": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage h1 fontSize." }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled" } }
  ]
}
