{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#1e1e1e",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(30, 30, 30) on https://us.vestiairecollective.com/ 2026-11-22" }
      },
      "ink-soft": {
        "$value": "#656565",
        "$type": "color",
        "$extensions": { "source": "computed breadcrumb and product brand color rgb(101, 101, 101)" }
      },
      "price": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": { "source": "computed catalog price color rgb(51, 51, 51)" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "sampled homepage page rgb(255, 255, 255) from home-light-1440.png. Computed body background is transparent" }
      },
      "search": {
        "$value": "#f5f5f5",
        "$type": "color",
        "$extensions": { "source": "computed search button background rgb(245, 245, 245)" }
      },
      "search-ink": {
        "$value": "#282828",
        "$type": "color",
        "$extensions": { "source": "computed search label color rgb(40, 40, 40)" }
      },
      "hairline": {
        "$value": "#ececec",
        "$type": "color",
        "$extensions": { "source": "sampled header hairline rgb(236, 236, 236) on home-light-1440.png" }
      },
      "sale": {
        "$value": "#db2124",
        "$type": "color",
        "$extensions": { "source": "computed Sale nav and sale price color rgb(219, 33, 36)" }
      },
      "promo": {
        "$value": "#d31e1e",
        "$type": "color",
        "$extensions": { "source": "computed homepage promo background rgb(211, 30, 30). Sampled near rgb(194, 52, 43) where the photograph compresses it" }
      },
      "on-promo": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed promo heading color rgb(255, 255, 255)" }
      },
      "sell": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed Sell an item background rgb(0, 0, 0). Not clicked" }
      },
      "on-sell": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Sell an item label rgb(255, 255, 255)" }
      },
      "footer": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "footer block paints black. Computed footer element background is transparent over that block" }
      },
      "footer-label": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed footer column label rgb(255, 255, 255)" }
      },
      "footer-link": {
        "$value": "#ababab",
        "$type": "color",
        "$extensions": { "source": "computed footer link rgb(171, 171, 171)" }
      },
      "press": {
        "$value": "#2b2b2b",
        "$type": "color",
        "$extensions": { "source": "computed Press boilerplate background rgb(43, 43, 43). Not clicked" }
      }
    },
    "font": {
      "display": {
        "$value": "Albra-Regular, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed promo, hero, section, category, and about titles. File is not in this package" }
      },
      "ui": {
        "$value": "HelveticaNowText, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body, nav, buttons, and prices. File is not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the homepage" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": "18px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed desktop nav link, padding 20px 0px" }
      },
      "search": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed search button" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 500, "lineHeight": "20px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Sell an item. Not clicked" }
      },
      "promo": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage promo heading" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "64px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Early Black Friday heading" }
      },
      "section": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "40px", "fontWeight": 400, "lineHeight": "52px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Fresh Finds heading" }
      },
      "category": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "40px", "fontWeight": 400, "lineHeight": "40px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women h2" }
      },
      "about": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "54px", "fontWeight": 400, "lineHeight": "54px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed About h1" }
      },
      "brand": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 700, "lineHeight": "21px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed product brand on the homepage rail" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 700, "lineHeight": "21px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage price" }
      },
      "footer-label": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "15px", "letterSpacing": "1.8px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer column label, uppercase" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer link Our concept" }
      },
      "menu-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": "26px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women menu link Handbags" }
      }
    },
    "size": {
      "header": { "$value": "132px", "$type": "dimension", "$extensions": { "source": "computed header height. Top row 69px, nav row 62px" } },
      "nav": { "$value": "58px", "$type": "dimension", "$extensions": { "source": "computed nav link height" } },
      "search": { "$value": "45px", "$type": "dimension", "$extensions": { "source": "computed search button height, width 420px" } },
      "sell": { "$value": "36px", "$type": "dimension", "$extensions": { "source": "computed Sell an item height" } },
      "chip": { "$value": "44px", "$type": "dimension", "$extensions": { "source": "computed catalog filter chip height" } },
      "add-to-bag": { "$value": "48px", "$type": "dimension", "$extensions": { "source": "computed Add to Bag height. Not clicked" } }
    },
    "radius": {
      "search": { "$value": "33px", "$type": "dimension", "$extensions": { "source": "computed search button border radius" } },
      "sell": { "$value": "2px", "$type": "dimension", "$extensions": { "source": "computed Sell an item and Add to Bag border radius" } },
      "hero-button": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "computed Shop markdowns border radius" } },
      "chip": { "$value": "0px", "$type": "dimension", "$extensions": { "source": "computed catalog filter chip border radius" } }
    }
  }
}
