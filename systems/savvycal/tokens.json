{
  "$schema": "https://tr.designtokens.org/format/modules/2025.10/",
  "core": {
    "color": {
      "brand": {
        "oatmeal": {
          "$type": "color",
          "$value": "#fcf7ed",
          "$extensions": {
            "source": "Measured: computed background of body.bg-brand-oatmeal on https://savvycal.com/"
          }
        },
        "sand": {
          "$type": "color",
          "$value": "#f4ebda",
          "$extensions": {
            "source": "Measured: computed background of .bg-brand-sand on the homepage"
          }
        },
        "orange": {
          "$type": "color",
          "$value": "#f54320",
          "$extensions": {
            "source": "Measured: computed background of the hero CTA (Try SavvyCal risk-free)"
          }
        },
        "orange-hover": {
          "$type": "color",
          "$value": "#e03a18",
          "$extensions": {
            "source": "Measured: computed background of the hero CTA in hover"
          }
        },
        "neon-green": {
          "$type": "color",
          "$value": "#b9ff78",
          "$extensions": {
            "source": "Measured: computed background of the login Sign In button"
          }
        },
        "white": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": {
            "source": "Measured: computed color of the hero CTA label"
          }
        }
      },
      "olive": {
        "950": {
          "$type": "color",
          "$value": "#0c0c09",
          "$extensions": {
            "source": "Derived: oklch(0.153 0.006 107.1) computed color of the homepage nav link, converted to sRGB"
          }
        },
        "800": {
          "$type": "color",
          "$value": "#2b2b22",
          "$extensions": {
            "source": "Derived: oklch(0.286 0.016 107.4) computed color of .text-olive-800, converted to sRGB"
          }
        },
        "600": {
          "$type": "color",
          "$value": "#5b5b4b",
          "$extensions": {
            "source": "Derived: oklch(0.466 0.025 107.3) computed color of .text-olive-600, converted to sRGB"
          }
        },
        "400": {
          "$type": "color",
          "$value": "#abab9c",
          "$extensions": {
            "source": "Derived: oklch(0.737 0.021 106.9) computed color of the Privacy footer link, converted to sRGB"
          }
        },
        "50": {
          "$type": "color",
          "$value": "#fbfbf9",
          "$extensions": {
            "source": "Derived: oklch(0.988 0.003 106.5) computed color of the footer link in hover, converted to sRGB"
          }
        }
      },
      "zinc": {
        "950": {
          "$type": "color",
          "$value": "#09090b",
          "$extensions": {
            "source": "Derived: oklch(0.141 0.005 285.823) computed color of the login email field, converted to sRGB"
          }
        },
        "900": {
          "$type": "color",
          "$value": "#18181b",
          "$extensions": {
            "source": "Derived: oklch(0.21 0.006 285.885) computed color of the login Sign In label, converted to sRGB"
          }
        }
      },
      "focus": {
        "blue": {
          "$type": "color",
          "$value": "#155dfc",
          "$extensions": {
            "source": "Derived: oklch(0.546 0.245 262.881) in the login email focused box-shadow, converted to sRGB"
          }
        }
      }
    },
    "font": {
      "family": {
        "ui": {
          "$type": "fontFamily",
          "$value": "InterVariable, sans-serif",
          "$extensions": {
            "source": "Measured: computed font-family of the hero CTA and nav"
          }
        },
        "display": {
          "$type": "fontFamily",
          "$value": "GT-Alpina-Condensed",
          "$extensions": {
            "source": "Measured: computed font-family of the homepage h1"
          }
        },
        "auth": {
          "$type": "fontFamily",
          "$value": "GT-America-Standard",
          "$extensions": {
            "source": "Measured: computed font-family of the Google sign-in button"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "88px",
          "fontWeight": 700,
          "lineHeight": "83.6px"
        },
        "$extensions": {
          "source": "Measured: homepage h1 computed font-size 88px, weight 700, line-height 83.6px"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "28px"
        },
        "$extensions": {
          "source": "Measured: FAQ summary computed font-size 16px, weight 400, line-height 28px"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "26px"
        },
        "$extensions": {
          "source": "Measured: nav link and hero CTA computed font-size 14px, weight 500, line-height 26px"
        }
      },
      "field": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.ui}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "Measured: login email field computed font-size 14px, weight 400, line-height 24px"
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": "Derived: computed border-radius 3.35544e+07px on the hero CTA, the pill form of a fully rounded control"
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured: login email field and Google button border-radius 8px"
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Measured: nav Sign up padding-top 4px"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "source": "Measured: billing toggle padding-top 6px"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured: search field padding-top 8px"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "source": "Measured: hero CTA padding-top 10px"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "Measured: nav Sign up padding-left 14px"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured: FAQ summary padding-top 16px"
        }
      },
      "7": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "Measured: hero CTA padding-left 20px"
        }
      }
    },
    "size": {
      "nav-height": {
        "$type": "dimension",
        "$value": "5.25rem",
        "$extensions": {
          "source": "Measured: custom property --nav-height on :root"
        }
      },
      "hero-cta-height": {
        "$type": "dimension",
        "$value": "46px",
        "$extensions": {
          "source": "Measured: hero CTA bounding box height"
        }
      },
      "nav-cta-height": {
        "$type": "dimension",
        "$value": "34px",
        "$extensions": {
          "source": "Measured: nav Sign up bounding box height"
        }
      },
      "field-height": {
        "$type": "dimension",
        "$value": "36px",
        "$extensions": {
          "source": "Measured: login email field bounding box height"
        }
      },
      "oauth-height": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Measured: Google sign-in button bounding box height"
        }
      },
      "icon-button": {
        "$type": "dimension",
        "$value": "36px",
        "$extensions": {
          "source": "Measured: phone menu button bounding box 36x36"
        }
      }
    },
    "focus": {
      "cta-width": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Measured: hero CTA focus-visible outline-width"
        }
      },
      "cta-offset": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Measured: hero CTA focus-visible outline-offset"
        }
      },
      "link-width": {
        "$type": "dimension",
        "$value": "1px",
        "$extensions": {
          "source": "Measured: nav link focus-visible outline-width"
        }
      }
    }
  },
  "light": {
    "page": {
      "$type": "color",
      "$value": "{color.brand.oatmeal}",
      "$extensions": {
        "source": "Alias of the measured body background"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.brand.sand}",
      "$extensions": {
        "source": "Alias of the measured sand surface"
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.olive.950}",
      "$extensions": {
        "source": "Alias of the measured nav and heading ink"
      }
    },
    "muted": {
      "$type": "color",
      "$value": "{color.olive.400}",
      "$extensions": {
        "source": "Alias of the measured footer link colour"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.brand.orange}",
      "$extensions": {
        "source": "Alias of the measured hero CTA fill"
      }
    },
    "accent-hover": {
      "$type": "color",
      "$value": "{color.brand.orange-hover}",
      "$extensions": {
        "source": "Alias of the measured hero CTA hover fill"
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.brand.white}",
      "$extensions": {
        "source": "Alias of the measured CTA label"
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.olive.800}",
      "$extensions": {
        "source": "Derived from the measured olive-800 text role; no separate border token was declared"
      }
    },
    "neon": {
      "$type": "color",
      "$value": "{color.brand.neon-green}",
      "$extensions": {
        "source": "Alias of the measured login submit fill"
      }
    },
    "focus": {
      "$type": "color",
      "$value": "{color.brand.orange}",
      "$extensions": {
        "source": "Measured: hero CTA focus-visible outline-color rgb(245, 67, 32)"
      }
    },
    "link-focus": {
      "$type": "color",
      "$value": "{color.focus.blue}",
      "$extensions": {
        "source": "Derived from the measured nav-link focus outline rgb(0, 95, 204) is the browser default; the login field ring is oklch(0.546 0.245 262.881)"
      }
    },
    "component": {
      "button": {
        "bg": {
          "$type": "color",
          "$value": "{color.brand.orange}",
          "$extensions": {
            "source": "Measured: hero CTA background"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{color.brand.white}",
          "$extensions": {
            "source": "Measured: hero CTA color"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.pill}",
          "$extensions": {
            "source": "Measured pill radius on the hero CTA"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "46px",
          "$extensions": {
            "source": "Measured: hero CTA height"
          }
        },
        "padding": {
          "$type": "dimension",
          "$value": "10px",
          "$extensions": {
            "source": "Measured: hero CTA padding-top"
          }
        }
      },
      "field": {
        "bg": {
          "$type": "color",
          "$value": "{color.brand.white}",
          "$extensions": {
            "source": "Measured: search field background rgb(255, 255, 255)"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{color.zinc.950}",
          "$extensions": {
            "source": "Measured colour of the login email field"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "8px",
          "$extensions": {
            "source": "Measured: login email border-radius"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "36px",
          "$extensions": {
            "source": "Measured: login email height"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ],
  "$extensions": {
    "source": "Measured from https://savvycal.com/ on 2026-11-21, signed out, headless Chromium. oklch values converted to sRGB are Derived. Unread roles are absent, not guessed.",
    "notTokenised": [
      "Dark theme: login CSS includes dark: utilities. No control switched a dark theme. Not captured.",
      "Success, warning, danger, info roles: not painted on the public pages. Not captured.",
      "Elevation scale: public controls paint box-shadow none, except focus rings. Not captured as a scale.",
      "Motion durations: not read as a declared scale. Not captured.",
      "Pressed colour: CDP active+hover did not change the hero CTA fill from default. Not captured as a distinct colour."
    ]
  }
}
