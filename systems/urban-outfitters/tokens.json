{
  "core": {
    "color": {
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "composed from --white channel triplet 255, 255, 255"
        }
      },
      "off-white": {
        "$type": "color",
        "$value": "#f4f5f0",
        "$extensions": {
          "source": "composed from --off-white channel triplet 244, 245, 240"
        }
      },
      "grey-lightest": {
        "$type": "color",
        "$value": "#f5f5f5",
        "$extensions": {
          "source": "composed from --grey-lightest 245, 245, 245"
        }
      },
      "grey-light": {
        "$type": "color",
        "$value": "#dddddd",
        "$extensions": {
          "source": "composed from --grey-light 221, 221, 221"
        }
      },
      "grey-medium": {
        "$type": "color",
        "$value": "#aaaaaa",
        "$extensions": {
          "source": "composed from --grey-medium 170, 170, 170"
        }
      },
      "grey": {
        "$type": "color",
        "$value": "#707070",
        "$extensions": {
          "source": "composed from --grey 112, 112, 112"
        }
      },
      "grey-dark": {
        "$type": "color",
        "$value": "#222222",
        "$extensions": {
          "source": "composed from --grey-dark 34, 34, 34"
        }
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "computed body colour rgb(0, 0, 0) on the home page"
        }
      },
      "red": {
        "$type": "color",
        "$value": "#d83604",
        "$extensions": {
          "source": "composed from --red 216, 54, 4; also --error and --price-sale"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#3a8700",
        "$extensions": {
          "source": "composed from --green 58, 135, 0; also --affirmative and --price-promotion"
        }
      },
      "blue": {
        "$type": "color",
        "$value": "#006acc",
        "$extensions": {
          "source": "composed from --blue 0, 106, 204; also --alert"
        }
      },
      "promo-strip": {
        "$type": "color",
        "$value": "#eb4034",
        "$extensions": {
          "source": "computed background of the first .c-pwa-live-text-banner-outer on the home page; not a custom property"
        }
      }
    },
    "font": {
      "family": {
        "body": {
          "$type": "fontFamily",
          "$value": "Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": "--font-body"
          }
        },
        "small": {
          "$type": "fontFamily",
          "$value": "MonoSpec, sans-serif",
          "$extensions": {
            "source": "--font-body-small; @font-face MonoSpec from static.urbanoutfitters.com"
          }
        }
      },
      "weight": {
        "light": {
          "$type": "fontWeight",
          "$value": 100,
          "$extensions": {
            "source": "--font-body-light"
          }
        },
        "regular": {
          "$type": "fontWeight",
          "$value": 400,
          "$extensions": {
            "source": "computed weight on nav, utility links, and body copy"
          }
        },
        "medium": {
          "$type": "fontWeight",
          "$value": 500,
          "$extensions": {
            "source": "--font-body-medium"
          }
        },
        "semibold": {
          "$type": "fontWeight",
          "$value": 600,
          "$extensions": {
            "source": "--font-body-semibold"
          }
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700,
          "$extensions": {
            "source": "--font-body-bold; computed on .o-pwa-button-cart and .o-pwa-button-primary"
          }
        }
      },
      "size": {
        "legal": {
          "$type": "dimension",
          "$value": "11px",
          "$extensions": {
            "source": "computed on .c-pwa-sign-in-form__legal-text"
          }
        },
        "body": {
          "$type": "dimension",
          "$value": "12px",
          "$extensions": {
            "source": "computed on nav links, utility links, promo copy, tile titles"
          }
        },
        "control": {
          "$type": "dimension",
          "$value": "14px",
          "$extensions": {
            "source": "computed on accordion toggles and the All Filters button"
          }
        },
        "field": {
          "$type": "dimension",
          "$value": "16px",
          "$extensions": {
            "source": "computed on the sign-in phone field, country select, and primary button (1.6rem)"
          }
        },
        "heading": {
          "$type": "dimension",
          "$value": "18px",
          "$extensions": {
            "source": "computed on the sign-in heading and the women's grid heading"
          }
        },
        "display": {
          "$type": "dimension",
          "$value": "22px",
          "$extensions": {
            "source": "computed on the product title and sale price"
          }
        }
      },
      "letter-spacing": {
        "tight": {
          "$type": "dimension",
          "$value": "0.2px",
          "$extensions": {
            "source": "computed on promo copy, accordion labels, and tile titles"
          }
        },
        "nav": {
          "$type": "dimension",
          "$value": "0.5px",
          "$extensions": {
            "source": "computed on nav links, utility links, prices, and the cart button"
          }
        }
      },
      "line-height": {
        "body": {
          "$type": "dimension",
          "$value": "16.8px",
          "$extensions": {
            "source": "computed on 12px nav and utility text"
          }
        },
        "control": {
          "$type": "dimension",
          "$value": "19.6px",
          "$extensions": {
            "source": "computed on accordion toggles"
          }
        },
        "button": {
          "$type": "dimension",
          "$value": "22.4px",
          "$extensions": {
            "source": "computed on the cart button and section headings"
          }
        },
        "heading": {
          "$type": "dimension",
          "$value": "25.2px",
          "$extensions": {
            "source": "computed on the sign-in heading"
          }
        },
        "display": {
          "$type": "dimension",
          "$value": "30.8px",
          "$extensions": {
            "source": "computed on the product title"
          }
        }
      }
    },
    "space": {
      "2": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "selected tab border-bottom width"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "selected tab padding-bottom"
        }
      },
      "10": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "source": "promo vertical padding, button vertical padding, nav vertical padding"
        }
      },
      "12": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "primary nav horizontal padding"
        }
      },
      "15": {
        "$type": "dimension",
        "$value": "15px",
        "$extensions": {
          "source": "search input left padding; promo preheading horizontal padding"
        }
      },
      "20": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "button horizontal padding; accordion vertical padding"
        }
      },
      "40": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "source": "sign-in dialog horizontal padding"
        }
      },
      "45": {
        "$type": "dimension",
        "$value": "45px",
        "$extensions": {
          "source": "promo strip height, search control height, cart button height"
        }
      },
      "60": {
        "$type": "dimension",
        "$value": "60px",
        "$extensions": {
          "source": "primary nav item height"
        }
      },
      "80": {
        "$type": "dimension",
        "$value": "80px",
        "$extensions": {
          "source": "sign-in dialog top padding"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "computed on nav, search, cart button, tiles, size chips, and the sign-in dialog"
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "computed on the OneTrust Allow All button, which was not submitted"
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "5px",
        "$extensions": {
          "source": "computed on the sign-in country select"
        }
      },
      "round": {
        "$type": "dimension",
        "$value": "50%",
        "$extensions": {
          "source": "computed on colour swatch labels and the sign-in close button"
        }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": "1px",
        "$extensions": {
          "source": "computed on the cart button, phone field, size chip, and swatch"
        }
      },
      "focus": {
        "$type": "dimension",
        "$value": "1.5px",
        "$extensions": {
          "source": "authored :focus-visible outline width"
        }
      }
    },
    "elevation": {
      "drop": {
        "$type": "shadow",
        "$value": "0 0 0 0 rgba(0, 0, 0, 0.1)",
        "$extensions": {
          "source": "--drop-shadow is rgba(0, 0, 0, .1); no offset was measured on a visible element. Header, buttons, tiles, and the sign-in dialog computed box-shadow none."
        }
      }
    },
    "motion": {
      "header": {
        "$type": "duration",
        "$value": "0.35s",
        "$extensions": {
          "source": "computed header transition top 0.35s linear"
        }
      },
      "arrow": {
        "$type": "duration",
        "$value": "0.15s",
        "$extensions": {
          "source": "computed banner arrow transition 0.15s cubic-bezier(0.645, 0.045, 0.355, 1)"
        }
      },
      "search": {
        "$type": "duration",
        "$value": "0.05s",
        "$extensions": {
          "source": "computed search submit transition background-color 0.05s ease-in"
        }
      },
      "ease-linear": {
        "$type": "cubicBezier",
        "$value": "linear",
        "$extensions": {
          "source": "header transition timing"
        }
      },
      "ease-arrow": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.645, 0.045, 0.355, 1)",
        "$extensions": {
          "source": "banner arrow colour transition"
        }
      },
      "ease-in": {
        "$type": "cubicBezier",
        "$value": "ease-in",
        "$extensions": {
          "source": "search submit background transition"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "--site-background and computed body background rgb(255, 255, 255)"
        }
      },
      "header": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "--site-background-header"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{core.color.grey-lightest}",
        "$extensions": {
          "source": "--site-background-secondary and --utility-bar-background"
        }
      },
      "navigation": {
        "$type": "color",
        "$value": "{core.color.grey-lightest}",
        "$extensions": {
          "source": "--site-background-navigation"
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "{core.color.grey-light}",
        "$extensions": {
          "source": "--site-background-tertiary"
        }
      },
      "modal": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "--modal-background; computed sign-in dialog background"
        }
      },
      "promo": {
        "$type": "color",
        "$value": "{core.color.promo-strip}",
        "$extensions": {
          "source": "computed first promo slide; later slides use --grey-dark"
        }
      },
      "inverse": {
        "$type": "color",
        "$value": "{core.color.grey-dark}",
        "$extensions": {
          "source": "computed later promo slides and --button-primary-background"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{core.color.grey-dark}",
        "$extensions": {
          "source": "--text-dark; computed on nav, headings, and tile titles"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{core.color.grey}",
        "$extensions": {
          "source": "--text-medium; computed on sign-in subcopy and size chips"
        }
      },
      "inverse": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "--text-light; computed on promo copy and the cart button"
        }
      },
      "disabled": {
        "$type": "color",
        "$value": "{core.color.grey-medium}",
        "$extensions": {
          "source": "--disabled and --input-text-disabled"
        }
      },
      "sale": {
        "$type": "color",
        "$value": "{core.color.red}",
        "$extensions": {
          "source": "--price-sale; computed on the product sale price"
        }
      },
      "promotion": {
        "$type": "color",
        "$value": "{core.color.green}",
        "$extensions": {
          "source": "--price-promotion; computed on the grid promo line and the product promo line"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{core.color.grey}",
        "$extensions": {
          "source": "--link-text"
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{core.color.grey-light}",
        "$extensions": {
          "source": "--border-default; computed on size chips"
        }
      },
      "strong": {
        "$type": "color",
        "$value": "{core.color.grey-dark}",
        "$extensions": {
          "source": "--button-primary-border; computed on the cart button and phone field"
        }
      },
      "input": {
        "$type": "color",
        "$value": "{core.color.grey}",
        "$extensions": {
          "source": "--input-border; computed on the country select"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "{core.color.grey}",
        "$extensions": {
          "source": "--focus-ring, used by the authored :focus-visible outline"
        }
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{core.color.grey-dark}",
        "$extensions": {
          "source": "--button-primary-background and computed cart button"
        }
      },
      "primary-text": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "--button-primary-text"
        }
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{core.color.grey}",
        "$extensions": {
          "source": "--button-primary-background-hover and --button-cart-background-hover"
        }
      },
      "primary-disabled": {
        "$type": "color",
        "$value": "{core.color.grey-medium}",
        "$extensions": {
          "source": "--button-primary-background-disabled"
        }
      },
      "affirmative": {
        "$type": "color",
        "$value": "{core.color.green}",
        "$extensions": {
          "source": "--affirmative and --button-cart-background-confirmation"
        }
      },
      "error": {
        "$type": "color",
        "$value": "{core.color.red}",
        "$extensions": {
          "source": "--error and --button-error-text"
        }
      },
      "alert": {
        "$type": "color",
        "$value": "{core.color.blue}",
        "$extensions": {
          "source": "--alert and --button-alert-text"
        }
      }
    },
    "component": {
      "header-height": {
        "$type": "dimension",
        "$value": "207px",
        "$extensions": {
          "source": "computed sticky header height at 1440"
        }
      },
      "promo-height": {
        "$type": "dimension",
        "$value": "45px",
        "$extensions": {
          "source": "computed promo strip height"
        }
      },
      "nav-height": {
        "$type": "dimension",
        "$value": "60px",
        "$extensions": {
          "source": "computed primary nav item height"
        }
      },
      "search-height": {
        "$type": "dimension",
        "$value": "43px",
        "$extensions": {
          "source": "computed search input height"
        }
      },
      "button-height": {
        "$type": "dimension",
        "$value": "45px",
        "$extensions": {
          "source": "computed cart button and sign-in Next button"
        }
      },
      "dialog-width": {
        "$type": "dimension",
        "$value": "475px",
        "$extensions": {
          "source": "computed sign-in dialog width"
        }
      },
      "swatch": {
        "$type": "dimension",
        "$value": "36px",
        "$extensions": {
          "source": "computed selected colour swatch label"
        }
      },
      "size-chip": {
        "$type": "dimension",
        "$value": "38px",
        "$extensions": {
          "source": "computed size chip"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme painted on the signed-out pages that were measured. No dark theme switch was found."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
