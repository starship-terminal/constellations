{
  "core": {
    "color": {
      "ink": {
        "$value": "#1c262e",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle(document.body).color on https://bluemercury.com/"
        }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle(document.body).backgroundColor on https://bluemercury.com/"
        }
      },
      "deepSea": {
        "$value": "#2f394b",
        "$type": "color",
        "$extensions": {
          "source": "Promo bar background and Add to Bag background, measured on the live homepage and the C E Ferulic product page. Wordmark SVG fill is #2F394B."
        }
      },
      "onDeepSea": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Promo line color, the selected ALL SKINCARE chip, and Add to Bag label"
        }
      },
      "muted": {
        "$value": "#6d7275",
        "$type": "color",
        "$extensions": {
          "source": "Search field border-bottom and the SKINCEUTICALS brand label on the product page"
        }
      },
      "link": {
        "$value": "#0b51c1",
        "$type": "color",
        "$extensions": {
          "source": "Gift Guide department link color on the homepage. Other department labels stay ink."
        }
      },
      "chipRest": {
        "$value": "#f5f5f5",
        "$type": "color",
        "$extensions": {
          "source": "Unselected category chip background on /collections/skin-care"
        }
      }
    },
    "font": {
      "body": {
        "$value": "neuehaas, roboto, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle(document.body).fontFamily. Font files are not in this package."
        }
      },
      "display": {
        "$value": "juana, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Skincare h1 on /collections/skin-care, 50px, weight 300"
        }
      }
    },
    "size": {
      "body": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "document.body font-size"
        }
      },
      "promo": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "Promo line font-size, uppercase, letter-spacing 0.7px, white"
        }
      },
      "department": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Department links, letter-spacing 0.8px, weight 400"
        }
      },
      "categoryTitle": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": {
          "source": "Skincare h1, Juana, weight 300"
        }
      },
      "productTitle": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "C E Ferulic h1 and the $185 price"
        }
      },
      "promoBarHeight": {
        "$value": "35px",
        "$type": "dimension",
        "$extensions": {
          "source": "Promo bar getBoundingClientRect height, full width 1440"
        }
      },
      "searchWidth": {
        "$value": "450px",
        "$type": "dimension",
        "$extensions": {
          "source": "Search input width. Height 48. Bottom border only, radius 0."
        }
      },
      "searchHeight": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "Search input getBoundingClientRect height"
        }
      },
      "chipHeight": {
        "$value": "36px",
        "$type": "dimension",
        "$extensions": {
          "source": "Category chips on the Skincare page. Radius 0."
        }
      },
      "addToBagHeight": {
        "$value": "60px",
        "$type": "dimension",
        "$extensions": {
          "source": "Add to Bag button height on the product page. Width 471. Radius 0."
        }
      },
      "shopNow": {
        "$value": "300px by 63px",
        "$type": "other",
        "$extensions": {
          "source": "Hero Shop Now button. White fill, ink label, padding 20px 40px, radius 0."
        }
      }
    },
    "radius": {
      "controls": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Search, Shop Now, category chips, and Add to Bag all measured radius 0px"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color"
      },
      "surface": {
        "$value": "{core.color.chipRest}",
        "$type": "color",
        "$extensions": {
          "source": "No surface colour. Closest existing colour is core.color.chipRest."
        }
      },
      "text": {
        "$value": "{core.color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "No text colour. Closest existing colour is core.color.ink."
        }
      },
      "muted": {
        "$value": "{core.color.muted}",
        "$type": "color"
      },
      "accent": {
        "$value": "{core.color.deepSea}",
        "$type": "color",
        "$extensions": {
          "source": "No accent colour. Closest existing colour is core.color.deepSea."
        }
      },
      "border": {
        "$value": "{core.color.muted}",
        "$type": "color",
        "$extensions": {
          "source": "No border colour. Closest existing colour is core.color.muted."
        }
      }
    }
  }
}
