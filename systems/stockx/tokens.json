{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "page": {
        "$value": "#121212",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-background-primary on https://stockx.com/ 2026-11-22, data-theme dark. Computed html background rgb(18, 18, 18)" }
      },
      "surface": {
        "$value": "#242424",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-background-secondary. Computed search background rgb(36, 36, 36)" }
      },
      "footer": {
        "$value": "#393939",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-background-tertiary. Computed footer background rgb(57, 57, 57)" }
      },
      "text": {
        "$value": "#FAFAFA",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-text-primary. Computed body color rgb(250, 250, 250)" }
      },
      "text-secondary": {
        "$value": "#CFCFCF",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-text-secondary" }
      },
      "text-disabled": {
        "$value": "#A1A5A4",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-text-disabled" }
      },
      "inverse": {
        "$value": "#0F0F0F",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-text-inverse. Computed Sign Up label rgb(15, 15, 15) on the dark shop" }
      },
      "brand": {
        "$value": "#95C0A4",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-brand-primary. Computed Buy Now background rgb(149, 192, 164) on the product page" }
      },
      "border": {
        "$value": "#393939",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-border-primary" }
      },
      "border-strong": {
        "$value": "#5F5F5F",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-border-secondary. Computed search border rgb(95, 95, 95)" }
      },
      "image": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-background-product-image" }
      },
      "deals": {
        "$value": "#EF6958",
        "$type": "color",
        "$extensions": { "source": "computed Deals nav label rgb(239, 105, 88). Same value as --colors-status-error" }
      },
      "success": {
        "$value": "#4FC58C",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-status-success" }
      },
      "warning": {
        "$value": "#F5BA1A",
        "$type": "color",
        "$extensions": { "source": "custom property --colors-status-warning" }
      },
      "on-accent": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed Sign Up label on the About page rgb(255, 255, 255)" }
      },
      "about-ink": {
        "$value": "#242424",
        "$type": "color",
        "$extensions": { "source": "computed logo fill and Sign Up background on https://stockx.com/about/how-it-works/ rgb(36, 36, 36)" }
      },
      "about-hero": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed hero section background rgb(0, 0, 0) on How It Works" }
      }
    },
    "font": {
      "ui": {
        "$value": "SuisseIntl, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "custom property --font-body and computed body fontFamily. File is not in this package" }
      },
      "display": {
        "$value": "Gestura Reg, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed How It Works h1 fontFamily. File is not in this package" }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "60px", "fontWeight": 400, "lineHeight": "64.98px", "letterSpacing": "-0.64px" },
        "$type": "typography",
        "$extensions": { "source": "computed How It Works h1, The Current Culture Marketplace" }
      },
      "title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "24px", "fontWeight": 500, "lineHeight": "30px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1, SuisseIntl-Medium" }
      },
      "section": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "23.994px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h2 Recommended For You" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "20px", "fontWeight": 500, "lineHeight": "26px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage card price, SuisseIntl-Medium" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the dark homepage" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 600, "lineHeight": "17.5px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed Sign Up | Login on the dark homepage" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed footer link on the homepage" }
      }
    },
    "radius": {
      "search": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": { "source": "computed search box border-radius. Matches --radii-md 0.5rem" }
      },
      "pill": {
        "$value": "100px",
        "$type": "dimension",
        "$extensions": { "source": "computed Sign Up and Buy Now border-radius. Token --radii-full is 6.25rem" }
      }
    },
    "size": {
      "header": {
        "$value": "91px",
        "$type": "dimension",
        "$extensions": { "source": "computed top nav height at 1440" }
      },
      "category-bar": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": { "source": "computed Product Category Switcher height" }
      },
      "search": {
        "$value": "42px",
        "$type": "dimension",
        "$extensions": { "source": "computed search box height" }
      },
      "signup": {
        "$value": "36px",
        "$type": "dimension",
        "$extensions": { "source": "computed Sign Up | Login height on the dark shop" }
      },
      "buy": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "computed Buy Now height. Not clicked" }
      },
      "logo": {
        "$value": "125px",
        "$type": "dimension",
        "$extensions": { "source": "inline style width on the header SVG" }
      }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "custom property --spacing-1, 0.25rem" } },
      "2": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "custom property --spacing-2, 0.5rem" } },
      "4": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "custom property --spacing-4, 1rem" } },
      "6": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "custom property --spacing-6, 1.5rem" } },
      "8": { "$value": "32px", "$type": "dimension", "$extensions": { "source": "custom property --spacing-8, 2rem. Footer padding top" } }
    },
    "duration": {
      "fast": { "$value": "150ms", "$type": "duration", "$extensions": { "source": "custom property --durations-fast" } },
      "moderate": { "$value": "200ms", "$type": "duration", "$extensions": { "source": "custom property --durations-moderate" } },
      "slow": { "$value": "300ms", "$type": "duration", "$extensions": { "source": "custom property --durations-slow" } }
    },
    "easing": {
      "in-out": {
        "$value": "cubic-bezier(0.42, 0, 0.58, 1)",
        "$type": "cubicBezier",
        "$extensions": { "source": "custom property --easings-ease-in-out" }
      }
    },
    "breakpoint": {
      "md": { "$value": "768px", "$type": "dimension", "$extensions": { "source": "custom property --breakpoints-md. Phone width was not photographed" } },
      "lg": { "$value": "1024px", "$type": "dimension", "$extensions": { "source": "custom property --breakpoints-lg" } }
    }
  }
}
