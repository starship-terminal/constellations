        },
        "ease-in-out": {
          "$type": "cubicBezier",
          "$value": [0.42, 0, 0.58, 1],
          "$extensions": {
            "source": "bag bulge animation uses ease-in-out",
            "evidence": "Derived"
          }
        },
        "linear": {
          "$type": "cubicBezier",
          "$value": [0, 0, 1, 1],
          "$extensions": {
            "source": "spinner animation uses linear",
            "evidence": "Derived"
          }
        }
      },
      "$extensions": {
        "source": "stylesheets only. No prefers-reduced-motion rule was found in the fetched sheets. The spinner animation is infinite",
        "evidence": "Measured",
        "reducedMotion": "no authored reduce rule in the fetched stylesheets"
      }
    }
