{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Graphik Web, Helvetica",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-family on body, h1, LOG IN, and SELECT at https://secure.hulu.com/commerce/plans, 2026-11-22"
            }
          }
        },
        "login": {
          "$type": "fontFamily",
          "$value": "Inspire, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-family on the login h1 at https://auth.hulu.com/web/login/enter-email"
            }
          }
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "1000px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius on SELECT at https://secure.hulu.com/commerce/plans"
          }
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius on the login email wrap and the Help Center search field"
          }
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$type": "color",
        "$value": "#f7f7f9",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed body background-color rgb(247, 247, 249) on the plan chooser"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#0d0e11",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed h1 and body color rgb(13, 14, 17) on the plan chooser"
          }
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#040405",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-color rgb(4, 4, 5) on SELECT and color on LOG IN"
          }
        }
      },
      "onInk": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(255, 255, 255) on SELECT"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#1cbc74",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border 2px solid rgb(21, 188, 116) on the empty Help Center search field"
          }
        }
      },
      "wordmark": {
        "$type": "color",
        "$value": "#1ce783",
        "$extensions": {
          "source": {
            "evidence": "Derived",
            "capture": "Most common opaque green pixel rgb(28, 231, 131) in the published favicon and the login wordmark image. Not a computed style."
          }
        }
      },
      "field": {
        "$type": "color",
        "$value": "#e9ebf0",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-color rgb(233, 235, 240) on the empty login email wrap"
          }
        }
      },
      "loginText": {
        "$type": "color",
        "$value": "#252526",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed h1 color rgb(37, 37, 38) on the login email wall"
          }
        }
      },
      "link": {
        "$type": "color",
        "$value": "#0000ee",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(0, 0, 238) on the and more link on the login wall"
          }
        }
      }
    }
  }
}
