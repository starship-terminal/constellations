{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$themes": ["dark"],
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": ["ui-sans-serif", "system-ui", "-apple-system", "system-ui", "Roboto", "Inter", "Helvetica Neue", "Arial", "Noto Sans", "sans-serif"],
          "$description": "Computed font-family on the homepage body and h1.",
          "$extensions": {
            "source": {
              "evidence": "computed",
              "where": "https://obsidian.md/ body and h1, 2026-11-22"
            }
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "60px",
          "fontWeight": 600,
          "lineHeight": "60px",
          "letterSpacing": "-1.2px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage h1 at 1440, 2026-11-22"
          }
        }
      },
      "lead": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "36px",
          "fontWeight": 400,
          "lineHeight": "40px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage lead paragraph at 1440, 2026-11-22"
          }
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage Pricing link at 1440, 2026-11-22"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage body, 2026-11-22"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "Get Obsidian for macOS and Pricing link border-radius, 2026-11-22"
          }
        }
      }
    },
    "space": {
      "header": {
        "$type": "dimension",
        "$value": "90px",
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "header height at 1440, 2026-11-22"
          }
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "60px",
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "Get Obsidian for macOS height, 2026-11-22"
          }
        }
      }
    }
  },
  "dark": {
    "page": {
      "$type": "color",
      "$value": "#0f0f0f",
      "$extensions": {
        "source": {
          "evidence": "computed",
          "where": "html background-color rgb(15, 15, 15) on the homepage, 2026-11-22"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#eeeeee",
      "$extensions": {
        "source": {
          "evidence": "computed",
          "where": "body and h1 color rgb(238, 238, 238), 2026-11-22"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#bcbcbc",
      "$extensions": {
        "source": {
          "evidence": "computed",
          "where": "lead paragraph and Pricing link color rgb(188, 188, 188), 2026-11-22"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#7c3aed",
      "$extensions": {
        "source": {
          "evidence": "computed",
          "where": "Get Obsidian for macOS background rgb(124, 58, 237), matching --color-accent-600, 2026-11-22"
        }
      }
    },
    "onAccent": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "source": {
          "evidence": "computed",
          "where": "Get Obsidian for macOS label color, 2026-11-22"
        }
      }
    }
  }
}
