{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#4d4d4d",
        "$type": "color",
        "$extensions": { "source": "computed nav and product title rgb(77, 77, 77) on https://monos.com/ 2026-11-22" }
      },
      "body": {
        "$value": "#808080",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(128, 128, 128) and --color-body-text" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "painted page and header, and --color-body-bg #ffffff" }
      },
      "promo": {
        "$value": "#4d4d4d",
        "$type": "color",
        "$extensions": { "source": "computed .info-bar background rgb(77, 77, 77), also the footer and Add to cart face" }
      },
      "on-promo": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed promo label and Add to cart label rgb(255, 255, 255)" }
      },
      "muted": {
        "$value": "#b3b3b3",
        "$type": "color",
        "$extensions": { "source": "computed footer text and footer links rgb(179, 179, 179)" }
      },
      "intro": {
        "$value": "#999999",
        "$type": "color",
        "$extensions": { "source": "computed luggage intro paragraph rgb(153, 153, 153)" }
      },
      "price": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": { "source": "computed card .money rgb(102, 102, 102)" }
      },
      "field-border": {
        "$value": "#dddddd",
        "$type": "color",
        "$extensions": { "source": "computed newsletter field border and --color-border #dddddd" }
      },
      "swatch-border": {
        "$value": "#b3b3b3",
        "$type": "color",
        "$extensions": { "source": "computed swatch border rgb(179, 179, 179)" }
      },
      "taupe": {
        "$value": "#c7b9ad",
        "$type": "color",
        "$extensions": { "source": "computed Desert Taupe swatch inner background rgb(199, 185, 173)" }
      }
    },
    "font": {
      "ui": {
        "$value": "Cabin, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed header, nav, and product title fontFamily" }
      },
      "body": {
        "$value": "Vollkorn, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body and collection intro fontFamily" }
      },
      "small-caps": {
        "$value": "\"Vollkorn SC\", serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed section eyebrow fontFamily" }
      }
    },
    "typography": {
      "hero": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "63px", "fontWeight": 500, "lineHeight": "81.9px", "letterSpacing": "15px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h1" }
      },
      "display": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "48px", "fontWeight": 700, "lineHeight": "48px", "letterSpacing": "0.96px" },
        "$type": "typography",
        "$extensions": { "source": "computed Our story h1" }
      },
      "title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "36px", "fontWeight": 700, "lineHeight": "39.6px", "letterSpacing": "0.72px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1" }
      },
      "intro": {
        "$value": { "fontFamily": "{core.font.body}", "fontSize": "24px", "fontWeight": 400, "lineHeight": "28.8px" },
        "$type": "typography",
        "$extensions": { "source": "computed luggage intro and Our story dek" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "24px", "fontWeight": 500, "lineHeight": "45px", "letterSpacing": "0.48px" },
        "$type": "typography",
        "$extensions": { "source": "computed .product__price" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 700, "lineHeight": "14px", "letterSpacing": "2.8px" },
        "$type": "typography",
        "$extensions": { "source": "computed Add to cart and outline buttons, uppercase" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.body}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "22.4px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12.32px", "fontWeight": 700, "lineHeight": "19.712px", "letterSpacing": "2.464px" },
        "$type": "typography",
        "$extensions": { "source": "computed primary nav link, uppercase" }
      },
      "card": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 600, "lineHeight": "19.8px", "letterSpacing": "0.36px" },
        "$type": "typography",
        "$extensions": { "source": "computed product card title" }
      },
      "promo": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "20px", "letterSpacing": "1.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed promo bar" }
      },
      "eyebrow": {
        "$value": { "fontFamily": "{core.font.small-caps}", "fontSize": "16px", "fontWeight": 600, "lineHeight": "18px", "letterSpacing": "1.6px" },
        "$type": "typography",
        "$extensions": { "source": "computed thoughtfully designed eyebrow" }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to cart, outline buttons, and newsletter field" }
      },
      "chip": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "computed EARLYBF code chip" }
      },
      "swatch": {
        "$value": "50%",
        "$type": "dimension",
        "$extensions": { "source": "computed colour swatch" }
      }
    },
    "spacing": {
      "promo": {
        "$value": "30px",
        "$type": "dimension",
        "$extensions": { "source": "desktop info bar height" }
      },
      "header": {
        "$value": "70px",
        "$type": "dimension",
        "$extensions": { "source": "header.site-header height" }
      },
      "chrome": {
        "$value": "100px",
        "$type": "dimension",
        "$extensions": { "source": "promo bar plus header" }
      },
      "logo": {
        "$value": "120px",
        "$type": "dimension",
        "$extensions": { "source": "header logo box width, 50px tall" }
      },
      "button": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": { "source": "Add to cart height" }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "alias" } },
      "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "product and nav ink" } },
      "muted": { "$value": "{core.color.muted}", "$type": "color", "$extensions": { "source": "footer links" } },
      "accent": { "$value": "{core.color.promo}", "$type": "color", "$extensions": { "source": "Add to cart face" } },
      "border": { "$value": "{core.color.field-border}", "$type": "color", "$extensions": { "source": "newsletter field border" } },
      "surface": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "header and page" } },
      "on-accent": { "$value": "{core.color.on-promo}", "$type": "color", "$extensions": { "source": "alias" } }
    },
    "component": {
      "button": {
        "primary": {
          "bg": { "$value": "{core.color.promo}", "$type": "color", "$extensions": { "source": "Add to cart" } },
          "text": { "$value": "{core.color.on-promo}", "$type": "color", "$extensions": { "source": "Add to cart" } },
          "radius": { "$value": "{core.radius.none}", "$type": "dimension", "$extensions": { "source": "alias" } },
          "height": { "$value": "{core.spacing.button}", "$type": "dimension", "$extensions": { "source": "alias" } }
        }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
