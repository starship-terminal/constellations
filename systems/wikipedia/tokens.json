{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "body": {
          "$value": "sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body, Main Page, 2026-11-22"
          }
        },
        "title": {
          "$value": "\"Linux Libertine\", Georgia, Times, \"Source Serif 4\", serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on the article h1"
          }
        }
      }
    },
    "typography": {
      "title": {
        "$value": {
          "fontFamily": "{core.font.family.title}",
          "fontSize": "28.8px",
          "fontWeight": "400",
          "lineHeight": "39.6px",
          "letterSpacing": "normal"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the article h1 at 1440. The main-page h1 computed at height 0; the article reading is the one used."
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "normal"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on body"
        }
      },
      "content": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "26px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on #mw-content-text"
        }
      },
      "link": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "26px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on an article body link. The main-page featured lead link computed at 25.92px and is not this role."
        }
      },
      "ui": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "22px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the search input and on personal links (personal line-height was normal)"
        }
      }
    },
    "radius": {
      "link": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on a content link"
        }
      },
      "search-start": {
        "$value": "2px 0 0 2px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on #searchInput"
        }
      },
      "search-end": {
        "$value": "0 2px 2px 0",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the Search button"
        }
      }
    },
    "size": {
      "search-height": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height on #searchInput and the Search button"
        }
      },
      "image-small": {
        "$value": "180px",
        "$type": "dimension",
        "$extensions": {
          "source": "--image-size-small"
        }
      },
      "image-standard": {
        "$value": "250px",
        "$type": "dimension",
        "$extensions": {
          "source": "--image-size-standard"
        }
      },
      "image-large": {
        "$value": "400px",
        "$type": "dimension",
        "$extensions": {
          "source": "--image-size-large"
        }
      }
    }
  },
  "light": {
    "color": {
      "base": { "$value": "#202122", "$type": "color", "$extensions": { "source": "--color-base" } },
      "base-hover": { "$value": "#404244", "$type": "color", "$extensions": { "source": "--color-base--hover" } },
      "emphasized": { "$value": "#101418", "$type": "color", "$extensions": { "source": "--color-emphasized" } },
      "neutral": { "$value": "#404244", "$type": "color", "$extensions": { "source": "--color-neutral" } },
      "subtle": { "$value": "#54595d", "$type": "color", "$extensions": { "source": "--color-subtle" } },
      "disabled": { "$value": "#a2a9b1", "$type": "color", "$extensions": { "source": "--color-disabled" } },
      "inverted": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "--color-inverted" } },
      "progressive": { "$value": "#3366cc", "$type": "color", "$extensions": { "source": "--color-progressive, computed link rgb(51, 102, 204)" } },
      "progressive-hover": { "$value": "#3056a9", "$type": "color", "$extensions": { "source": "--color-progressive--hover, declared, not clicked" } },
      "progressive-active": { "$value": "#233566", "$type": "color", "$extensions": { "source": "--color-progressive--active, declared, not clicked" } },
      "visited": { "$value": "#6a60b0", "$type": "color", "$extensions": { "source": "--color-visited" } },
      "destructive": { "$value": "#bf3c2c", "$type": "color", "$extensions": { "source": "--color-destructive" } },
      "error": { "$value": "#bf3c2c", "$type": "color", "$extensions": { "source": "--color-error" } },
      "success": { "$value": "#177860", "$type": "color", "$extensions": { "source": "--color-success" } },
      "warning": { "$value": "#886425", "$type": "color", "$extensions": { "source": "--color-warning" } },
      "notice": { "$value": "#404244", "$type": "color", "$extensions": { "source": "--color-notice" } },
      "border": { "$value": "#72777d", "$type": "color", "$extensions": { "source": "computed border-color on #searchInput" } }
    },
    "background": {
      "base": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "--background-color-base" } },
      "neutral": { "$value": "#eaecf0", "$type": "color", "$extensions": { "source": "--background-color-neutral" } },
      "neutral-subtle": { "$value": "#f8f9fa", "$type": "color", "$extensions": { "source": "--background-color-neutral-subtle, computed body background rgb(248, 249, 250)" } },
      "interactive": { "$value": "#eaecf0", "$type": "color", "$extensions": { "source": "--background-color-interactive" } },
      "progressive-subtle": { "$value": "#e8eeff", "$type": "color", "$extensions": { "source": "--background-color-progressive-subtle" } },
      "destructive-subtle": { "$value": "#ffe9e5", "$type": "color", "$extensions": { "source": "--background-color-destructive-subtle" } },
      "error-subtle": { "$value": "#ffe9e5", "$type": "color", "$extensions": { "source": "--background-color-error-subtle" } },
      "warning-subtle": { "$value": "#fdf2d5", "$type": "color", "$extensions": { "source": "--background-color-warning-subtle" } },
      "success-subtle": { "$value": "#dff2eb", "$type": "color", "$extensions": { "source": "--background-color-success-subtle" } },
      "disabled": { "$value": "#dadde3", "$type": "color", "$extensions": { "source": "--background-color-disabled" } },
      "inverted": { "$value": "#101418", "$type": "color", "$extensions": { "source": "--background-color-inverted" } },
      "search": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed background on #searchInput" } },
      "search-button": { "$value": "#f8f9fa", "$type": "color", "$extensions": { "source": "computed background on the Search button" } }
    }
  },
  "dark": {
    "color": {
      "base": { "$value": "#eaecf0", "$type": "color", "$extensions": { "source": "--color-base after Color Dark. Computed body color rgb(234, 236, 240)." } },
      "emphasized": { "$value": "#f8f9fa", "$type": "color", "$extensions": { "source": "--color-emphasized" } },
      "neutral": { "$value": "#c8ccd1", "$type": "color", "$extensions": { "source": "--color-neutral" } },
      "subtle": { "$value": "#a2a9b1", "$type": "color", "$extensions": { "source": "--color-subtle" } },
      "disabled": { "$value": "#54595d", "$type": "color", "$extensions": { "source": "--color-disabled" } },
      "inverted": { "$value": "#101418", "$type": "color", "$extensions": { "source": "--color-inverted" } },
      "progressive": { "$value": "#88a3e8", "$type": "color", "$extensions": { "source": "--color-progressive, computed link rgb(136, 163, 232)" } },
      "progressive-hover": { "$value": "#a6bbf5", "$type": "color", "$extensions": { "source": "--color-progressive--hover, declared, not clicked" } },
      "progressive-active": { "$value": "#b6d4fb", "$type": "color", "$extensions": { "source": "--color-progressive--active, declared, not clicked" } },
      "visited": { "$value": "#a799cd", "$type": "color", "$extensions": { "source": "--color-visited" } },
      "destructive": { "$value": "#fd7865", "$type": "color", "$extensions": { "source": "--color-destructive" } },
      "error": { "$value": "#fd7865", "$type": "color", "$extensions": { "source": "--color-error" } },
      "success": { "$value": "#2cb491", "$type": "color", "$extensions": { "source": "--color-success" } },
      "warning": { "$value": "#ca982e", "$type": "color", "$extensions": { "source": "--color-warning" } },
      "border": { "$value": "#72777d", "$type": "color", "$extensions": { "source": "computed border-color on #searchInput in the night context" } }
    },
    "background": {
      "base": { "$value": "#101418", "$type": "color", "$extensions": { "source": "--background-color-base. Search input computed background matches this." } },
      "neutral": { "$value": "#27292d", "$type": "color", "$extensions": { "source": "--background-color-neutral" } },
      "neutral-subtle": { "$value": "#202122", "$type": "color", "$extensions": { "source": "--background-color-neutral-subtle. Computed body background rgb(32, 33, 34) is this value." } },
      "progressive-subtle": { "$value": "#1b223d", "$type": "color", "$extensions": { "source": "--background-color-progressive-subtle" } },
      "destructive-subtle": { "$value": "#3c1a13", "$type": "color", "$extensions": { "source": "--background-color-destructive-subtle" } },
      "search-button": { "$value": "#202122", "$type": "color", "$extensions": { "source": "computed background on the Search button in the night context" } }
    }
  }
}
