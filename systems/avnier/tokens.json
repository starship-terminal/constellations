{
  "core": {
    "color": {
      "neutral": {
        "accent1": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-accent-1 (0, 0, 0)"
          }
        },
        "accent2": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-accent-2 (0, 0, 0)"
          }
        },
        "background": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-background (255, 255, 255)"
          }
        },
        "badgeBg": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-badge-background (255, 255, 255)"
          }
        },
        "badgeBorder": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-badge-border (0, 0, 0)"
          }
        },
        "button": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-button (0, 0, 0)"
          }
        },
        "buttonText": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-button-text (255, 255, 255)"
          }
        },
        "cardHover": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-card-hover (0, 0, 0)"
          }
        },
        "foreground": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-foreground (0, 0, 0)"
          }
        },
        "ink": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-text (0, 0, 0)"
          }
        },
        "link": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-link (0, 0, 0)"
          }
        },
        "onInk": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-solid-button-labels (255, 255, 255)"
          }
        },
        "onPaper": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-outline-button-labels (0, 0, 0)"
          }
        },
        "paper": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-background-1 (255, 255, 255)"
          }
        },
        "wash": {
          "$value": "#f3f3f3",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-base-background-2 (243, 243, 243)"
          }
        }
      },
      "accent": {
        "searchHighlight": {
          "$value": "#faf6b5",
          "$type": "color",
          "$extensions": {
            "source": "css-var --PredictiveSearchHover (#faf6b5)"
          }
        }
      }
    },
    "font": {
      "family": {
        "primary": {
          "$value": "'Space Mono', monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "--font-body-family on :root; computed on header/card/field/button text"
          },
          "$description": "Space Mono everywhere — the Avnier workhorse."
        },
        "display": {
          "$value": "avnier-font",
          "$type": "fontFamily",
          "$extensions": {
            "source": "--font-heading-family on :root; computed on pdp-title and page titles"
          },
          "$description": "The licensed display face for titles (weight 500, 3% tracking)."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of nav/body text (m-nav-link / nav-item / header, raw/components-computed.json)"
          }
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of avnier-font titles (pdp-title, raw/components-computed.json)"
          }
        }
      },
      "size": {
        "xxs": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of card-price (raw/components-computed.json)"
          },
          "$description": "12px uppercase card prices."
        },
        "xs": {
          "$value": "13px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of header (raw/components-computed.json)"
          },
          "$description": "13px body/nav copy."
        },
        "sm": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of search-toggle (raw/components-computed.json)"
          },
          "$description": "14px icons and pills."
        },
        "base": {
          "$value": "15px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of add-to-cart (raw/components-computed.json)"
          },
          "$description": "15px uppercase button labels."
        },
        "md": {
          "$value": "15px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of pdp-price (raw/components-computed.json)"
          },
          "$description": "The 15px visible price span (avnier-font); the wrapper reads 18px."
        },
        "lg": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of email-input (raw/components-computed.json)"
          },
          "$description": "16px field text."
        },
        "display": {
          "$value": "188px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of cart-title (raw/components-computed.json)"
          },
          "$description": "188-220px avnier-font page titles."
        }
      },
      "tracking": {
        "wide": {
          "$value": "1px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed letterSpacing of add-to-cart (raw/components-computed.json)"
          },
          "$description": "1px on buttons and pills."
        },
        "wider": {
          "$value": "1.3px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed letterSpacing of pdp-price (raw/components-computed.json)"
          },
          "$description": "1.3px on the price."
        }
      }
    },
    "measured": {
      "action-pressed": {
        "$value": "#f4ff7a",
        "$type": "color",
        "$extensions": {
          "source": "computed ::after backgroundColor of add-to-cart pressed (raw/components-computed.json)"
        },
        "$description": "The #f4ff7a action yellow painted by the ::after wipe on :active."
      },
      "text-muted": {
        "$value": "#7a7a7a",
        "$type": "color",
        "$extensions": {
          "source": "computed color of plp-title default (raw/components-computed.json)"
        },
        "$description": "The #7a7a7a count/secondary grey."
      },
      "text-faded": {
        "$value": "rgba(0, 0, 0, 0.75)",
        "$type": "color",
        "$extensions": {
          "source": "computed color of sort-select default (raw/components-computed.json)"
        },
        "$description": "The rgba(0,0,0,.75) dimmed select label."
      },
      "border-field": {
        "$value": "rgba(0, 0, 0, 0.55)",
        "$type": "color",
        "$extensions": {
          "source": "computed boxShadow of email-input default (raw/components-computed.json)"
        },
        "$description": "The rgba(0,0,0,.55) 1px field ring (painted as a shadow; the colour is read out of the shadow value)."
      },
      "action-text": {
        "$value": "#f6f6f6",
        "$type": "color",
        "$extensions": {
          "source": "computed color of add-to-cart default (raw/components-computed.json)"
        },
        "$description": "The near-white #f6f6f6 label on black buttons."
      }
    },
    "layout": {
      "page-width": {
        "$value": "1600px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --page-width"
        },
        "$description": "The 160rem max content width."
      },
      "page-margin": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --page-width-margin"
        },
        "$description": "The 2rem page gutter."
      }
    },
    "motion": {
      "short": {
        "$value": "100ms",
        "$type": "duration",
        "$extensions": {
          "source": "css-var --duration-short"
        },
        "$description": "The declared short duration."
      },
      "default": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "css-var --duration-default"
        },
        "$description": "The declared default duration."
      },
      "long": {
        "$value": "500ms",
        "$type": "duration",
        "$extensions": {
          "source": "css-var --duration-long"
        },
        "$description": "The declared long duration."
      }
    }
  },
  "light": {
    "action": {
      "primary": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-accent-1 resolved (0, 0, 0)"
        },
        "$description": "The black buy/action fill (add-to-cart, login, skip link) — resolved from --color-base-accent-1."
      },
      "primaryText": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-solid-button-labels resolved (255, 255, 255)"
        },
        "$description": "White labels on black actions — resolved from --color-base-solid-button-labels."
      }
    },
    "badge": {
      "promo": {
        "$value": "#faf6b5",
        "$type": "color",
        "$extensions": {
          "source": "css-var --PredictiveSearchHover resolved (#faf6b5)"
        },
        "$description": "#faf6b5 predictive-search hit highlight — resolved from --PredictiveSearchHover."
      }
    },
    "surface": {
      "inverse": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-accent-1 resolved (0, 0, 0)"
        },
        "$description": "The black buttons and dark sections — resolved from --color-base-accent-1."
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-background-1 resolved (255, 255, 255)"
        },
        "$description": "The white page and field surface — resolved from --color-base-background-1."
      },
      "subtle": {
        "$value": "#f3f3f3",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-background-2 resolved (243, 243, 243)"
        },
        "$description": "#f3f3f3 alternate scheme wash — resolved from --color-base-background-2."
      }
    },
    "text": {
      "inverse": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-solid-button-labels resolved (255, 255, 255)"
        },
        "$description": "White text on the black header icons and buttons — resolved from --color-base-solid-button-labels."
      },
      "primary": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-base-text resolved (0, 0, 0)"
        },
        "$description": "rgb(0,0,0) ink on nav, cards, fields and titles — resolved from --color-base-text."
      }
    },
    "component": {
      "control": {
        "height": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of add-to-cart default (raw/components-computed.json)"
          },
          "$description": "Buttons are 48px — add-to-cart, login, skip link."
        },
        "fieldHeight": {
          "$value": "45px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of email-input default (raw/components-computed.json)"
          },
          "$description": "Login fields are 45px."
        },
        "fieldWidth": {
          "$value": "448px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed width of email-input default (raw/components-computed.json)"
          },
          "$description": "Login fields run 448px."
        },
        "iconTarget": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed width of search-toggle default (raw/components-computed.json)"
          },
          "$description": "Header icon targets are 40px."
        },
        "pillWidth": {
          "$value": "73.2031px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed width of variant-radio default (raw/components-computed.json)"
          },
          "$description": "A size chip is ~73px."
        }
      },
      "header": {
        "height": {
          "$value": "60px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of header default (raw/components-computed.json)"
          },
          "$description": "The desktop header is 60px."
        },
        "heightMobile": {
          "$value": "50.9375px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of m-header default (raw/components-computed.json)"
          },
          "$description": "The mobile header is ~51px."
        }
      },
      "tile": {
        "width": {
          "$value": "450px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed width of product-card default (raw/components-computed.json)"
          },
          "$description": "Product cards are 450px at 1440 (3 across)."
        }
      },
      "radius": {
        "none": {
          "$value": "0px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of add-to-cart default (raw/components-computed.json)"
          },
          "$description": "Corners are square — 0px everywhere."
        }
      },
      "focus": {
        "width": {
          "$value": "3px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed outlineWidth of nav-item focus-visible (raw/components-computed.json)"
          },
          "$description": "Focus rings, where painted."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme avnier.com paints; no dark theme is offered on any captured surface."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
