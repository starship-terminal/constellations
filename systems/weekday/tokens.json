{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#1d1d1b",
        "$type": "color",
        "$extensions": { "source": "computed nav, login, search, and footer link color rgb(29, 29, 27) on https://www.weekday.com/en-ww/ 2026-11-22" }
      },
      "ink-black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed body, homepage h1, and product title rgb(0, 0, 0)" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed body and header background rgb(255, 255, 255)" }
      },
      "promo": {
        "$value": "#ffff03",
        "$type": "color",
        "$extensions": { "source": "computed promo bar background rgb(255, 255, 3). The 2x screenshot samples the same bar near #ffff55" }
      },
      "on-promo": {
        "$value": "#1d1d1b",
        "$type": "color",
        "$extensions": { "source": "computed promo bar color rgb(29, 29, 27)" }
      },
      "sale": {
        "$value": "#d1443b",
        "$type": "color",
        "$extensions": { "source": "computed mega-menu sale link UP TO 50% OFF rgb(209, 68, 59)" }
      },
      "button": {
        "$value": "#1d1d1b",
        "$type": "color",
        "$extensions": { "source": "computed ADD TO CART and YES, DELIVER TO SINGAPORE background rgb(29, 29, 27). Add to cart was not clicked" }
      },
      "on-button": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed primary button label rgb(255, 255, 255)" }
      },
      "border": {
        "$value": "#1d1d1b",
        "$type": "color",
        "$extensions": { "source": "computed JOIN NOW border 1px solid rgb(29, 29, 27). JOIN NOW was not clicked" }
      },
      "footer-line": {
        "$value": "#b4b4b4",
        "$type": "color",
        "$extensions": { "source": "computed footer border rgb(180, 180, 180)" }
      }
    },
    "font": {
      "ui": {
        "$value": "weekdayRegularFont, weekdayRegularFont Fallback, Arial Narrow, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily. Files WEEKDAY_Regular, WEEKDAY_Semibold, WEEKDAY_Mono_Regular are preloaded from /_next/static/media/ and are not in this package" }
      },
      "semibold": {
        "$value": "weekdaySemiBoldFont, weekdayRegularFont, Arial Narrow, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed homepage h1 and hero h2 fontFamily" }
      },
      "mono": {
        "$value": "weekdayMonoFont, ui-monospace, monospace",
        "$type": "fontFamily",
        "$extensions": { "source": "computed promo bar fontFamily" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "27px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the homepage" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed WOMEN nav button, padding 8px 12px, height 56px" }
      },
      "promo": {
        "$value": { "fontFamily": "{core.font.mono}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed promo bar" }
      },
      "home": {
        "$value": { "fontFamily": "{core.font.semibold}", "fontSize": "34px", "fontWeight": 400, "lineHeight": "38px", "letterSpacing": "-0.85px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h1 WEEKDAY" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.semibold}", "fontSize": "26px", "fontWeight": 400, "lineHeight": "30px", "letterSpacing": "-0.52px" },
        "$type": "typography",
        "$extensions": { "source": "computed hero h2 WOMEN and MEN" }
      },
      "sale": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "22px", "fontWeight": 400, "lineHeight": "26px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed mega-menu sale link" }
      },
      "category": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed women's clothing h1" }
      },
      "product": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed product title" }
      },
      "about": {
        "$value": { "fontFamily": "{core.font.semibold}", "fontSize": "74px", "fontWeight": 400, "lineHeight": "100px", "letterSpacing": "1.48px" },
        "$type": "typography",
        "$extensions": { "source": "computed About Us h1. It paints black over a black hero band, so the letters are not visible in the screenshot" }
      },
      "footer-heading": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "-0.45px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer column heading" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer link, height 30px" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed ADD TO CART. Not clicked" }
      }
    },
    "size": {
      "promo": {
        "$value": "58px",
        "$type": "dimension",
        "$extensions": { "source": "computed promo bar height" }
      },
      "header": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": { "source": "computed header height. No bottom border" }
      },
      "search": {
        "$value": "394px",
        "$type": "dimension",
        "$extensions": { "source": "computed search width. Height 56px, padding 16px 56px 16px 48px" }
      },
      "button": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "computed primary button and JOIN NOW height. ADD TO CART width 432px. JOIN NOW width 137px" }
      }
    },
    "radius": {
      "control": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed JOIN NOW, ADD TO CART, and shipping confirm border-radius" }
      }
    }
  }
}
