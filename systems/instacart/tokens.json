          "$description": "Overshoot for elevated motion. Resolved linear() spring. The stylesheet fallback, when linear() is unsupported, is cubic-bezier.",
          "$extensions": {
            "source": "css-var --elevated-easing-function (light, resolved)"
          }
        },
        "bounce": {
          "$value": "linear(0, 0.007 1%, 0.031 2.1%, 0.132 4.6%, 0.676 13.5%, 0.888 17.7%, 0.964 19.7%, 1.026 21.8%, 1.071 23.9%, 1.102 26.2%, 1.119 29.2%, 1.115 32.7%, 1.017 47.2%, 0.988 56%, 1)",
