    "motion": {
      "easing": {
        "smooth": {
          "$value": "linear(0, 0.159 3.3%, 0.29 6.5%, 0.41 10%, 0.515 13.7%, 0.608 17.7%, 0.686 21.9%, 0.754 26.5%, 0.812 31.6%, 0.858 36.9%, 0.896 42.7%, 0.95 56.4%, 0.98 74.2%, 1)",
