          "$description": "Default press and fade. Resolved linear() spring. The stylesheet fallback, when linear() is unsupported, is cubic-bezier.",
          "$extensions": {
            "source": "css-var --smooth-easing-function (light, resolved)"
          }
        },
        "elevated": {
          "$value": "linear(0, 0.006 1.2%, 0.026 2.5%, 0.111 5.5%, 0.591 16.8%, 0.785 22.3%, 0.859 25%, 0.918 27.7%, 0.965 30.5%, 1.002 33.5%, 1.038 38.7%, 1.049 44.9%, 1.004 72.8%, 1)",
