    "type": "dimension",
    "var": "--container-lg"
   },
   "md": {
    "type": "dimension",
    "var": "--container-md"
   },
   "sm": {
    "type": "dimension",
    "var": "--container-sm"
   },
   "xl": {
    "type": "dimension",
    "var": "--container-xl"
   },
   "xs": {
    "type": "dimension",
    "var": "--container-xs"
   }
  },
  "ease": {
   "in": {
    "type": "cubicBezier",
    "var": "--ease-in"
   },
   "inOut": {
    "type": "cubicBezier",
    "var": "--ease-in-out"
   },
   "out": {
    "type": "cubicBezier",
    "var": "--ease-out"
   },
   "default": {
    "type": "cubicBezier",
    "var": "--default-transition-timing-function"
   }
  },
  "duration": {
   "default": {
    "type": "duration",
    "var": "--default-transition-duration"
   }
  },
  "blur": {
