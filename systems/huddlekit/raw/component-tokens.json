    "type": "dimension",
    "var": "--blur-md"
   },
   "sm": {
    "type": "dimension",
    "var": "--blur-sm"
   }
  },
  "animation": {
   "ping": {
    "type": "other",
    "var": "--animate-ping",
    "description": "animation shorthand as declared"
   },
   "pulse": {
    "type": "other",
    "var": "--animate-pulse",
    "description": "animation shorthand as declared"
   },
   "spin": {
    "type": "other",
    "var": "--animate-spin",
    "description": "animation shorthand as declared"
   }
  },
  "layout": {
   "aspectVideo": {
    "type": "other",
    "var": "--aspect-video"
   },
   "sectionPadding": {
    "type": "dimension",
    "var": "--section-padding"
   },
   "sectionGap": {
    "type": "dimension",
    "var": "--section-gap"
   },
   "cardGap": {
    "type": "dimension",
    "var": "--card-gap"
   }
  },
  "typography": {
   "articleTitle": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "44px",
     "fontWeight": 500,
     "lineHeight": "48.4px",
     "letterSpacing": "-2.2px"
    },
    "$type": "typography",
    "$description": "the blog article title",
    "$extensions": {
     "source": "measured prose-h1 on /blog/introducing-huddlekit (default state)"
    }
   },
   "body": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "article body text",
    "$extensions": {
     "source": "measured prose-p on /blog/introducing-huddlekit (default state)"
    }
   },
   "navLink": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$type": "typography",
    "$description": "a header nav label",
    "$extensions": {
     "source": "measured nav-link on / (default state)"
    }
   },
   "button": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$type": "typography",
    "$description": "the primary CTA label",
    "$extensions": {
     "source": "measured cta-primary on / (default state)"
    }
   },
   "input": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$type": "typography",
    "$description": "the /support search field",
    "$extensions": {
     "source": "measured support-search on /support (default state)"
    }
   },
   "oauthButton": {
    "$value": {
     "fontFamily": "inter, \"inter Fallback\"",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$type": "typography",
    "$description": "the 'Continue with Google' label",
    "$extensions": {
     "source": "measured app-google-button on /login (default state)"
    }
   },
   "tabLabel": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", sans-serif",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "a feature tab label",
    "$extensions": {
     "source": "measured feature-tab on / (default state)"
    }
   }
  }
 },
