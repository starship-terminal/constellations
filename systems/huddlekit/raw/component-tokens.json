{
 "core": {
  "font": {
   "family": {
    "sans": {
     "type": "fontFamily",
     "var": "--font-sans",
     "description": "the product face — \"Inter\",\"Inter Fallback\",sans-serif loaded through next/font; body text and UI"
    },
    "inter": {
     "type": "fontFamily",
     "var": "--font-inter",
     "description": "Inter — the next/font face itself (with its metrics-matched fallback)"
    },
    "geistMono": {
     "type": "fontFamily",
     "var": "--font-geist-mono",
     "description": "Geist Mono — the next/font mono face (with fallback); code and MCP snippets"
    },
    "mono": {
     "type": "fontFamily",
     "var": "--font-mono",
     "description": "the mono face — ui-monospace system stack; inline code and pre blocks"
    }
   },
   "weight": {
    "bold": {
     "type": "fontWeight",
     "var": "--font-weight-bold"
    },
    "medium": {
