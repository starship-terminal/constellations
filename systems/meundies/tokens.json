        "$value": "#d23f5a",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Product sale price color rgb(210, 63, 90) on the Festive Feline product page."
        }
      },
      "bronze": {
        "$value": "#9c6d26",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Membership kicker SUBSCRIBE + SAVE color rgb(156, 109, 38)."
