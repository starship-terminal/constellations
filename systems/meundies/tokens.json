      "field-border": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Login email border 1px solid rgb(0, 0, 0). The field was empty. LOGIN was not clicked."
        }
      }
    },
    "font": {
