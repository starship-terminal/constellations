{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#fffbf1",
        "$type": "color",
        "$extensions": {
          "source": "Measured. main backgroundColor rgb(255, 251, 241) on https://www.meundies.com/ 2026-11-22. Logo row uses the same cream."
        }
      },
      "ink": {
        "$value": "#1e1e1d",
        "$type": "color",
        "$extensions": {
          "source": "Measured. LOGIN button, COOKIE SETTINGS border, and 60% Off badge type rgb(30, 30, 29)."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. LOGIN button color rgb(255, 255, 255)."
        }
      },
      "type": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Body, nav, footer, and Login title color rgb(0, 0, 0). Wordmark fill computes to the same."
        }
      },
      "lime": {
        "$value": "#d9ff6e",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Promo bar backgroundColor rgb(217, 255, 110). The 60% Off badge uses the same lime."
        }
      },
      "nav": {
        "$value": "#f2efe9",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Nav row backgroundColor rgb(242, 239, 233). Size chips use the same."
        }
      },
      "footer": {
        "$value": "#e4d8c1",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Footer backgroundColor rgb(228, 216, 193)."
        }
      },
