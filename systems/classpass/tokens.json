  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme chargetrip.com paints; the bundle declares no dark variant on the captured routes."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
