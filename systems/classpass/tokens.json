        },
        "$description": "The 1px border on pills, panels, OAuth buttons and the search box."
      },
      "card": {
        "$value": "{color.black-alpha.10}",
        "$type": "color",
        "$extensions": {
          "source": "computed paint.0.border of venue-card default (raw/components-computed.json); same value as core.color.black-alpha.10"
        },
        "$description": "The venue card's 10% black hairline."
      },
      "focusField": {
        "$value": "{color.blue.400}",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of signin-email focused (raw/components-computed.json); same value as core.color.blue.400"
        },
        "$description": "The blue the sign-in fields' border switches to when focused."
