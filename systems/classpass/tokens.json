          "$type": "dimension",
          "$extensions": {
            "source": "computed paint.1.radius of venue-card default (raw/components-computed.json)"
          },
          "$description": "The venue card's 5px corner."
        },
        "radiusHero": {
          "$value": "25px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paint.0.radius of hero-card default (raw/components-computed.json)"
          },
          "$description": "The hero card's 25px corner."
        },
        "radiusPanel": {
          "$value": "8px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paint.0.radius of filter-panel default (raw/components-computed.json)"
          },
          "$description": "The filter panel's 8px corner."
        }
