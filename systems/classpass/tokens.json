    },
    "focus": {
      "$value": "{color.blue.500}",
      "$type": "color",
      "$extensions": {
        "source": "computed outlineColor of universal-cta focus-visible (raw/components-computed.json); same value as core.color.blue.500"
      },
      "$description": "The designed focus ring on the blue controls (2px solid). Many text controls keep the browser's auto ring instead (#101010) — recorded per entry."
    },
    "shadow": {
      "card": {
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "5px",
            "blur": "16px",
            "spread": "0px",
            "color": "rgba(1, 85, 254, 0.1)"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of plan-slide default (raw/components-computed.json)"
        },
        "$description": "The brand-tinted drop shadow under the plan card."
      }
    },
    "component": {
      "control": {
        "heightCta": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of universal-cta default (raw/components-computed.json)"
