    "accentSoft": {
      "$value": "{color.blue.100}",
      "$type": "color",
      "$extensions": {
        "source": "computed paint.0.bg of plan-pill default (raw/components-computed.json); same value as core.color.blue.100"
      },
      "$description": "The light-blue plan pill and tinted plan area."
    },
    "promo": {
      "$value": "{color.yellow.300}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of m-banner default (raw/components-computed.json); same value as core.color.yellow.300"
      },
      "$description": "The mobile promo banner's yellow."
