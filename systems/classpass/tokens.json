        "heightButton": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of signin-submit default (raw/components-computed.json)"
          },
          "$description": "The full-width button height (sign-in submit, OAuth buttons, walkthrough Next)."
        },
        "heightField": {
          "$value": "42px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of signin-email default (raw/components-computed.json)"
          },
          "$description": "The sign-in field height."
        },
        "heightSearch": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of search-box default (raw/components-computed.json)"
          },
          "$description": "The search box height."
