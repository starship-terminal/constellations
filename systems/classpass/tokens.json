        "radiusSearch": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paint.1.radius of search-box default (raw/components-computed.json)"
          },
          "$description": "The search box's 20px corner."
        },
        "radiusFilter": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paint.0.radius of filter-pill default (raw/components-computed.json)"
          },
