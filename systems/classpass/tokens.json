{
  "core": {
    "color": {
      "paper": {
        "0": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of page-ground default (raw/components-computed.json)"
          },
          "$description": "White — the html element's painted ground and the card fills."
        }
      },
      "blue": {
        "100": {
          "$value": "#c0e0ff",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.bg of plan-pill default (raw/components-computed.json)"
          },
          "$description": "The soft light-blue plan pill (and the plan card's tinted area)."
        },
        "400": {
          "$value": "#1a5ee5",
          "$type": "color",
          "$extensions": {
            "source": "computed color of signin-forgot default (raw/components-computed.json)"
          },
          "$description": "The link blue — 'Forgot password?', and the focused field border."
        },
        "500": {
          "$value": "#0055ff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of universal-cta default (raw/components-computed.json)"
          },
          "$description": "The ClassPass accent — CTAs, links, the star rating."
        },
        "600": {
          "$value": "#004de6",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of universal-cta hover (raw/components-computed.json)"
          },
          "$description": "The accent's hover step."
        },
        "700": {
          "$value": "#0044cc",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of universal-cta pressed (raw/components-computed.json)"
          },
          "$description": "The accent's pressed step."
        }
      },
      "gray": {
        "100": {
          "$value": "#f7f7f7",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of nav-item hover (raw/components-computed.json)"
          },
          "$description": "The nav item's hover/focus wash."
        },
        "200": {
          "$value": "#e7e7e7",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.border of signin-email default (raw/components-computed.json)"
          },
          "$description": "The sign-in field and search-field hairline."
        },
        "300": {
          "$value": "#d6d6d6",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.border of filter-pill default (raw/components-computed.json)"
          },
          "$description": "Control borders on the filter pills, panels and OAuth buttons."
        },
        "400": {
          "$value": "#999999",
          "$type": "color",
          "$extensions": {
            "source": "computed textStyle.color of venue-card default (raw/components-computed.json)"
          },
          "$description": "Muted text — the venue card's secondary line."
        },
        "500": {
          "$value": "#757575",
          "$type": "color",
          "$extensions": {
            "source": "computed placeholder.color of search-field default (raw/components-computed.json)"
          },
          "$description": "Placeholder text in the search comboboxes."
        }
      },
      "ink": {
        "750": {
          "$value": "#040404",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.bg of walk-cta hover (raw/components-computed.json)"
          },
          "$description": "The dark button's hover step."
        },
        "800": {
          "$value": "#111111",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.bg of walk-cta default (raw/components-computed.json)"
          },
          "$description": "The near-black button fill (walkthrough Next, CMS CTAs)."
        },
        "900": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of footer default (raw/components-computed.json)"
          },
          "$description": "Black — body text and the footer field."
        }
      },
      "yellow": {
        "300": {
          "$value": "#fce172",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of m-banner default (raw/components-computed.json)"
          },
          "$description": "The mobile promo banner's yellow."
        }
      },
      "black-alpha": {
        "8": {
          "$value": "rgba(0, 0, 0, 0.08)",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.bg of hero-card default (raw/components-computed.json)"
          },
          "$description": "The 8% black scrim on the hero card."
        },
        "10": {
          "$value": "rgba(0, 0, 0, 0.1)",
          "$type": "color",
          "$extensions": {
            "source": "computed paint.0.border of venue-card default (raw/components-computed.json)"
          },
          "$description": "The venue card's 10% hairline."
        }
      },
      "blue-alpha": {
        "10": {
          "$value": "rgba(1, 85, 254, 0.1)",
          "$type": "color",
          "$extensions": {
            "source": "computed boxShadow of plan-slide default (raw/components-computed.json)"
          },
          "$description": "The brand-tinted shadow under the plan card."
        }
      }
    },
    "measured": {
      "walk-slide-ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed textStyle.color of walk-slide default (raw/components-computed.json)"
        },
        "$description": "The walkthrough slide's 20px medium label ink."
      },
      "oauth-border": {
        "$value": "#d6d6d6",
        "$type": "color",
        "$extensions": {
          "source": "computed paint.0.border of signin-apple default (raw/components-computed.json)"
        },
        "$description": "The OAuth buttons' border grey."
      }
    },
    "font": {
      "family": {
        "ui": {
          "$value": "norms, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of nav-item default (raw/components-computed.json)"
          },
          "$description": "TT Norms Pro ('norms') across the UI: nav, body copy, controls."
        },
        "display": {
          "$value": "circuit, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of plans-h1 default (raw/components-computed.json)"
          },
          "$description": "Circuit, the condensed display face of the hero and plan headings."
        }
      },
      "size": {
        "display": {
          "$value": "60px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plans-h1 default (raw/components-computed.json)"
          },
          "$description": "The 60px plan/display heading (62.4px line-height)."
        },
        "hero": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The hero heading's 36px line — the rotating word paints on an inner span."
        },
        "h2": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of section-title default (raw/components-computed.json); stale: kept from an earlier run (the 2026-11-16 recapture did not find section-title)"
          },
          "$description": "Section headings, 24px at 28.8px."
        },
        "sub": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The hero subtitle, 20px."
        },
        "faq": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of faq-question default (raw/components-computed.json)"
          },
          "$description": "FAQ questions, 18px."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of footer-link default (raw/components-computed.json)"
          },
          "$description": "Body copy and footer links, 16px."
        },
        "nav": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-item default (raw/components-computed.json)"
          },
          "$description": "Nav labels, 14px."
        },
        "price": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan prices, 36px at weight 700."
        }
      }
    }
  },
  "light": {
    "surface": {
      "page": {
        "$value": "{color.paper.0}",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of page-ground default (raw/components-computed.json); same value as core.color.paper.0"
        },
        "$description": "The white page ground — painted by the html element (body itself is transparent)."
      },
      "card": {
        "$value": "{color.paper.0}",
        "$type": "color",
        "$extensions": {
          "source": "computed paint.0.bg of plan-slide default (raw/components-computed.json); same value as core.color.paper.0"
        },
        "$description": "The card fill: plan slides, venue rows, filter panels, search box."
      },
      "dark": {
        "$value": "{color.ink.900}",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of footer default (raw/components-computed.json); same value as core.color.ink.900"
        },
        "$description": "The black island: the site footer on every page."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.ink.900}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of page-ground default (raw/components-computed.json); same value as core.color.ink.900"
        },
        "$description": "Body and heading ink on the light pages."
      },
      "muted": {
        "$value": "{color.gray.400}",
        "$type": "color",
        "$extensions": {
          "source": "computed textStyle.color of venue-card default (raw/components-computed.json); same value as core.color.gray.400"
        },
        "$description": "Secondary text — the venue card's muted line."
      },
      "placeholder": {
        "$value": "{color.gray.500}",
        "$type": "color",
        "$extensions": {
          "source": "computed placeholder.color of search-field default (raw/components-computed.json); same value as core.color.gray.500"
        },
        "$description": "Placeholder text inside the search comboboxes."
      },
      "onDark": {
        "$value": "{color.paper.0}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of footer default (raw/components-computed.json); same value as core.color.paper.0"
        },
        "$description": "Text painted on the black footer."
      },
      "onAccent": {
        "$value": "{color.paper.0}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of universal-cta default (raw/components-computed.json); same value as core.color.paper.0"
        },
        "$description": "Text painted on the blue CTA."
      },
      "accent": {
        "$value": "{color.blue.500}",
        "$type": "color",
        "$extensions": {
          "source": "computed textStyle.color of filter-pill default (raw/components-computed.json); same value as core.color.blue.500"
        },
        "$description": "Blue text — the filter pills' labels and the star rating."
      }
    },
    "link": {
      "$value": "{color.blue.400}",
      "$type": "color",
      "$extensions": {
        "source": "computed color of signin-forgot default (raw/components-computed.json); same value as core.color.blue.400"
      },
      "$description": "The sign-in page's link blue."
    },
    "accent": {
      "$value": "{color.blue.500}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of universal-cta default (raw/components-computed.json); same value as core.color.blue.500"
      },
      "$description": "The ClassPass blue CTA fill."
