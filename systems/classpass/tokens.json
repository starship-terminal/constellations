    "border": {
      "subtle": {
        "$value": "{color.gray.200}",
        "$type": "color",
        "$extensions": {
          "source": "computed paint.0.border of signin-email default (raw/components-computed.json); same value as core.color.gray.200"
        },
        "$description": "The field hairline — sign-in and search inputs."
