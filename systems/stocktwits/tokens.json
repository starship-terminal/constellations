{
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --primary-background resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Page background."
      },
      "surface": {
        "$value": "#f2f2f7",
        "$type": "color",
        "$extensions": {
          "source": "css-var --secondary-background resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Raised surface, also the field fill."
      },
      "surface-sidebar": {
        "$value": "rgba(242,242,247,0.5)",
        "$type": "color",
        "$extensions": {
          "source": "css-var --sidebar-background resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Left rail wash."
      },
      "text": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --st-primary-text resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Primary text."
      },
      "text-secondary": {
        "$value": "#636366",
        "$type": "color",
        "$extensions": {
          "source": "css-var --st-secondary-text resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Secondary text."
      },
      "text-tertiary": {
        "$value": "#8e8e93",
        "$type": "color",
        "$extensions": {
          "source": "css-var --st-tertiary-text resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Muted labels and inactive tabs."
      },
      "text-on-accent": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --primary-button-text resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Text on a filled black or blue button."
      },
      "border": {
        "$value": "#e5e5ea",
        "$type": "color",
        "$extensions": {
          "source": "css-var --primary-border resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Hairline and control border."
      },
      "link": {
        "$value": "#1b66e7",
        "$type": "color",
        "$extensions": {
          "source": "css-var --blue-5 resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Inline link and announcement blue."
      },
      "accent": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of button-primary default (raw/components-computed.json)"
        },
        "$description": "Filled pill. Sign Up paints black, not the blue token."
      },
      "accent-hover": {
        "$value": "#2c2c2e",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of button-primary hover (raw/components-computed.json)"
        },
        "$description": "Filled pill on hover."
      },
      "disabled": {
        "$value": "#d1d1d6",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of the disabled Log In button on /signin (raw/extra-readings.json)"
        },
        "$description": "Disabled submit."
      },
      "up": {
        "$value": "#128760",
        "$type": "color",
        "$extensions": {
          "source": "css-var --sentiment-green resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Gain and bullish."
      },
      "down": {
        "$value": "#dd331d",
        "$type": "color",
        "$extensions": {
          "source": "css-var --sentiment-red resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Loss and bearish."
      },
      "up-wash": {
        "$value": "#e0f7ef",
        "$type": "color",
        "$extensions": {
          "source": "css-var --tag-green resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Bullish chip fill."
      },
      "down-wash": {
        "$value": "#fbe6e3",
        "$type": "color",
        "$extensions": {
          "source": "css-var --tag-red resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Bearish chip fill."
      },
      "field": {
        "$value": "#f2f2f7",
        "$type": "color",
        "$extensions": {
          "source": "css-var --st-input-background resolved on :root (raw/components-computed.json, html.light, 1440x900, 2026-11-21)"
        },
        "$description": "Text field fill."
      }
    },
    "font": {
      "family": {
        "ui": {
          "$value": "\"Source Sans 3\", \"Source Sans 3 Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of button-primary default (raw/components-computed.json)"
          },
          "$description": "Source Sans 3, with the site's fallback face."
        }
      },
      "size": {
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of body (raw/components-computed.json _meta.foundations.body)"
          },
          "$description": "Body size."
        },
        "button": {
          "$value": "15px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of button-primary default (raw/components-computed.json)"
          },
          "$description": "Filled button label."
        },
        "nav": {
          "$value": "13px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-link default (raw/components-computed.json)"
          },
          "$description": "Top nav label."
        },
        "tab": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of tab default (raw/components-computed.json)"
          },
          "$description": "Feed tab."
        },
        "link": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of link default (raw/components-computed.json)"
          },
          "$description": "Inline link."
        },
        "field": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of input[name=login] on /signin (raw/extra-readings.json)"
          },
          "$description": "Text field."
        },
        "heading": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of h1 Log In on /signin (raw/extra-readings.json)"
          },
          "$description": "Auth heading. Display sizes on marketing pages were not measured."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of link default (raw/components-computed.json)"
          },
          "$description": "Body and links."
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of button-primary default (raw/components-computed.json)"
          },
          "$description": "Buttons."
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of h1 Log In on /signin (raw/extra-readings.json)"
          },
          "$description": "Auth heading."
        }
      },
      "lineHeight": {
        "body": {
          "$value": 1.5,
          "$type": "number",
          "$extensions": {
            "source": "Derived: body line-height 24px / font-size 16px (raw/components-computed.json)"
          },
          "$description": "Body line height."
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderRadius of button-primary default (raw/components-computed.json)"
        },
        "$description": "Buttons, chips, search."
      },
      "field": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderRadius of input[name=login] on /signin (raw/extra-readings.json)"
        },
        "$description": "Text field."
      }
    },
    "size": {
      "button-md": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Observed height of Sign Up and the sign-in Log In button. Recorded as 40px from the sign-in reading (raw/extra-readings.json)."
        },
        "$description": "Medium control."
      },
      "button-xs": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --size on .STButton_xs (stylesheets, 2026-11-21 probe)"
        },
        "$description": "Icon button."
      },
      "field": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of input[name=login] (raw/extra-readings.json)"
        },
        "$description": "Text field."
      }
    },
    "space": {
      "field-x": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of input[name=login] (raw/extra-readings.json)"
        },
        "$description": "Field horizontal padding."
      },
      "field-y": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingTop of input[name=login] (raw/extra-readings.json)"
        },
        "$description": "Field vertical padding."
      },
      "button-x": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of the sign-in Log In button (raw/extra-readings.json)"
        },
        "$description": "Button horizontal padding."
      }
    }
  },
  "light": {
    "page": {
      "$value": "{core.color.page}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.page"
      },
      "$description": "Page."
    },
    "surface": {
      "$value": "{core.color.surface}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.surface"
      },
      "$description": "Surface."
    },
    "text": {
      "$value": "{core.color.text}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.text"
      },
      "$description": "Primary text."
    },
    "muted": {
      "$value": "{core.color.text-tertiary}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.text-tertiary"
      },
      "$description": "Muted text."
    },
    "accent": {
      "$value": "{core.color.accent}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.accent"
      },
      "$description": "Filled action."
    },
    "border": {
      "$value": "{core.color.border}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.border"
      },
      "$description": "Border."
    },
    "link": {
      "$value": "{core.color.link}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.link"
      },
      "$description": "Link."
    },
    "up": {
      "$value": "{core.color.up}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.up"
      },
      "$description": "Gain."
    },
    "down": {
      "$value": "{core.color.down}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.down"
      },
      "$description": "Loss."
    },
    "component": {
      "button-primary-background": {
        "$value": "{core.color.accent}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Sign Up fill."
      },
      "button-primary-text": {
        "$value": "{core.color.text-on-accent}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Sign Up label."
      },
      "button-primary-radius": {
        "$value": "{core.radius.pill}",
        "$type": "dimension",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Pill radius."
      },
      "button-disabled-background": {
        "$value": "{core.color.disabled}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Disabled Log In."
      },
      "field-background": {
        "$value": "{core.color.field}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Field fill."
      },
      "field-radius": {
        "$value": "{core.radius.field}",
        "$type": "dimension",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Field radius."
      },
      "bullish-background": {
        "$value": "{core.color.up-wash}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Bullish chip."
      },
      "bearish-background": {
        "$value": "{core.color.down-wash}",
        "$type": "color",
        "$extensions": {
          "source": "alias"
        },
        "$description": "Bearish chip."
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
