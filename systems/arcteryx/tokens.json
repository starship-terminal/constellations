{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. main backgroundColor rgb(255, 255, 255) on https://arcteryx.com/ca/en 2026-11-22. CSS var --colour-white is #ffffff."
        }
      },
      "ink": {
        "$value": "#1a1a1a",
        "$type": "color",
        "$extensions": {
          "source": "Measured. body color rgb(26, 26, 26). CSS var --colour-black and --colour-copy are #1A1A1A. Wordmark fill is var(--colour-black)."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Promo copy and Add to cart label color rgb(255, 255, 255)."
        }
      },
      "promo": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Utility bar backgroundColor rgb(0, 0, 0), 40px, full width."
        }
      },
      "search": {
        "$value": "#f5f5f5",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Search button backgroundColor rgb(245, 245, 245)."
        }
      },
      "bag": {
        "$value": "#1a1a1a",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Add to cart backgroundColor rgb(26, 26, 26) on the Incendia Jacket page. Same ink as body text. Not clicked."
        }
      },
      "line": {
        "$value": "#b2b2b2",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Shop women's border 1px solid rgb(178, 178, 178). CSS var --colour-grey-inactive is #b2b2b2."
        }
      },
      "muted": {
        "$value": "#767676",
        "$type": "color",
        "$extensions": {
          "source": "Declared. :root --colour-grey-medium-accessible #767676. Not sampled from a painted caption in this pass."
        }
      }
    },
    "font": {
      "body": {
        "$value": "helvetica-now-display, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. body fontFamily. CSS var --font-helvetica. Files are not in this package."
        }
      },
      "display": {
        "$value": "elan-itc-pro, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. Homepage h1, category h1, and product h1 fontFamily. CSS var --font-elan. Files are not in this package."
        }
      }
    },
    "radius": {
      "search": {
        "$value": "41px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Search button border-radius 41px, 142 by 32."
        }
      },
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Add to cart border-radius 0px. Shop women's border-radius 0px."
        }
      }
    },
    "size": {
      "promo": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Utility bar height 40px."
        }
      },
      "bag": {
        "$value": "54px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Add to cart height 54px, width 488px."
        }
      },
      "cta": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Shop women's height 44px, width 160px."
        }
      }
    }
  },
  "light": {},
  "$themes": []
}
