{
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The signed-out site at color-scheme normal on 2026-11-19. body, .theme-standard declares the colour tokens. No dark theme was switched on."
    }
  ],
  "core": {
    "font": {
      "caslon": {
        "$value": "TNYAdobeCaslonPro, \"Times New Roman\", Times, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family on body and article paragraphs, homepage and article"
        }
      },
      "irvin": {
        "$value": "IrvinHeadingPro, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family on the article h1 and homepage feature hed"
        }
      },
      "irvin-text": {
        "$value": "IrvinText, IrvinHeadingPro, Georgia, \"Times New Roman\", Times, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family on the article rubric, Dept. of Medicine"
        }
      },
      "graphik": {
        "$value": "Graphik, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family on Sign In, Subscribe, and section nav"
        }
      },
      "neutra": {
        "$value": "NeutrafaceNewYorker, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family on the byline, By Dhruv Khullar"
        }
      }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.caslon}",
          "fontSize": "21px",
          "fontWeight": 400,
          "lineHeight": "1.5",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on article paragraphs: 21px / 31.5px TNYAdobeCaslonPro; matches --size-consumption-editorial-body-core 21px/1.5em"
        }
      },
      "dek": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.caslon}",
          "fontSize": "21px",
          "fontWeight": 400,
          "lineHeight": "28px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the homepage dek, Human dissection has long been"
        }
      },
      "hed-article": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.irvin}",
          "fontSize": "42px",
          "fontWeight": 400,
          "lineHeight": "46.6667px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the article h1 at 1169px width"
        }
      },
      "hed-feature": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.irvin}",
          "fontSize": "36px",
          "fontWeight": 400,
          "lineHeight": "40px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the homepage feature hed Insides Out"
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.irvin}",
          "fontSize": "28px",
          "fontWeight": 400,
          "lineHeight": "32px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on Today\u2019s Mix section heading"
        }
      },
      "rubric": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.irvin-text}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "16px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on Dept. of Medicine rubric"
        }
      },
      "byline": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.neutra}",
          "fontSize": "15px",
          "fontWeight": 600,
          "lineHeight": "17.1429px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the article byline"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.graphik}",
          "fontSize": "12px",
          "fontWeight": 500,
          "lineHeight": "15.24px",
          "letterSpacing": "-0.15px"
        },
        "$extensions": {
          "source": "computed on Sign In and section links; --tracking-navigation-text-primary is -0.01em"
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.graphik}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "16px",
          "letterSpacing": "-0.1625px"
        },
        "$extensions": {
          "source": "computed on GET DIGITAL ACCESS; matches --size-utility-button-core 13px and tracking -0.0125em"
        }
      },
      "input": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.graphik}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "1.31",
          "letterSpacing": "-0.0125em"
        },
        "$extensions": {
          "source": "computed on the sign-in email field; --size-utility-input-core 16px/1.31em"
        }
      },
      "offer-hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.caslon}",
          "fontSize": "36px",
          "fontWeight": 400,
          "lineHeight": "39.6px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the offers page line The New Yorker takes you places"
        }
      },
      "sign-in-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.caslon}",
          "fontSize": "40px",
          "fontWeight": 400,
          "lineHeight": "48px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on the Cond\u00e9 Nast sign-in h1"
        }
      },
      "date": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.graphik}",
          "fontSize": "12px",
          "fontWeight": 500,
          "lineHeight": "1.27",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "computed on November 16, 2026; --color-text-pubdate is rgba(102,102,102,1)"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the sign-in email wrap and Continue with e-mail button"
        }
      },
      "subscribe": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the homepage Subscribe link"
        }
      },
      "offer": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on GET DIGITAL ACCESS and the social buttons"
        }
      },
      "pill": {
        "$value": "50%",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the offer radio inputs"
        }
      }
    },
    "spacing": {
      "4": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-top on the homepage Subscribe link"
        }
      },
      "8": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on the homepage Subscribe link"
        }
      },
      "12": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on the sign-in email field"
        }
      },
      "14": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-block on the sign-in email field"
        }
      },
      "16": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-block on Give a gift subscription"
        }
      },
      "20": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on GET DIGITAL ACCESS and Continue with e-mail"
        }
      },
      "grid-gap": {
        "$value": "2rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --grid-gap on the homepage stylesheet"
        }
      },
      "grid-margin": {
        "$value": "4rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --grid-margin on the homepage stylesheet"
        }
      }
    },
    "size": {
      "header": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of the homepage header"
        }
      },
      "subscribe": {
        "$value": "23px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of the homepage Subscribe link"
        }
      },
      "offer-button": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of GET DIGITAL ACCESS"
        }
      },
      "sign-in-button": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of Continue with e-mail"
        }
      },
      "email": {
        "$value": "51px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of the sign-in email wrap"
        }
      },
      "search": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed width and height of the Search button"
        }
      },
      "radio": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed width of the offer radio inputs"
        }
      },
      "article-column": {
        "$value": "521px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed width of the article paragraphs at 1169px viewport"
        }
      },
      "article-hed": {
        "$value": "500px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed width of the article h1"
        }
      }
    },
    "border": {
      "width": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border width on the sign-in email wrap and social buttons"
        }
      },
      "width-strong": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border width on Continue with e-mail; also declared --divider-width 2px"
        }
      }
    },
    "motion": {
      "duration": {
        "nav": {
          "$value": "100ms",
          "$type": "duration",
          "$extensions": {
            "source": "computed transition-duration 0.1s on the homepage header"
          }
        },
        "link": {
          "$value": "200ms",
          "$type": "duration",
          "$extensions": {
            "source": "computed transition-duration 0.2s on the Sign In link"
          }
        },
        "logo": {
          "$value": "300ms",
          "$type": "duration",
          "$extensions": {
            "source": "computed transition-duration 0.3s on the logo image"
          }
        }
      },
      "easing": {
        "nav": {
          "$value": "cubic-bezier(0, 0.59, 0.32, 1)",
          "$type": "cubicBezier",
          "$extensions": {
            "source": "computed transition-timing-function on the homepage header"
          }
        },
        "link": {
          "$value": "ease-in-out",
          "$type": "string",
          "$extensions": {
            "source": "computed transition-timing-function keyword on the Sign In link. Control points were not expanded."
          }
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed background of the offers page wrapper and the sign-in portal; --color-surface on body, .theme-standard is rgba(255,255,255,1)"
      }
    },
    "surface": {
      "$value": "#fafafa",
      "$type": "color",
      "$extensions": {
        "source": "declared --color-surface-navigation-elevated rgba(250,250,250,1) on body, .theme-standard"
      }
    },
    "text": {
      "$value": "#000000",
      "$type": "color",
      "$extensions": {
        "source": "same as the text role; kept as a colour token for DESIGN.md"
      }
    },
    "muted": {
      "$value": "#666666",
      "$type": "color",
      "$extensions": {
        "source": "computed color on the article date; --color-text-pubdate and --color-text-disabled rgba(102,102,102,1)"
      }
    },
    "accent": {
      "$value": "#0879bf",
      "$type": "color",
      "$extensions": {
        "source": "alias of the brand blue"
      }
    },
    "border": {
      "$value": "#e5e5e5",
      "$type": "color",
      "$extensions": {
        "source": "same as the border role"
      }
    },
    "background": {
      "page": {
        "$value": "{light.page}",
        "$type": "color",
        "$extensions": {
          "source": "alias of light.page"
        }
      },
      "surface": {
        "$value": "{light.surface}",
        "$type": "color",
        "$extensions": {
          "source": "alias of light.surface"
        }
      },
      "subtle": {
        "$value": "#f5f5f5",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-surface-subtle and --color-surface-hover rgba(245,245,245,1)"
        }
      },
      "pressed": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-surface-pressed rgba(229,229,229,1)"
        }
      },
      "action": {
        "$value": "{light.accent}",
        "$type": "color",
        "$extensions": {
          "source": "alias of light.accent, the Subscribe fill"
        }
      },
      "action-hover": {
        "$value": "#07588b",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-surface-navigation-feature-brand-hover rgba(7,88,139,1). The live Subscribe hover was not held."
        }
      },
      "action-pressed": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-surface-navigation-feature-brand-pressed rgba(51,51,51,1). The live pressed state was not held."
        }
      },
      "inverse": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed background of Continue with e-mail"
        }
      },
      "rubric-card": {
        "$value": "#db3334",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-surface-rubric-card rgba(219,51,52,1)"
        }
      },
      "overlay": {
        "$value": "#000000d9",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-overlay-strong-solid rgba(0, 0, 0, 0.85)"
        }
      }
    },
    "textRole": {
      "primary": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed body color; --color-text"
        }
      },
      "heading": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-heading rgba(0,0,0,1)"
        }
      },
      "dek": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "computed color rgb(51, 51, 51) on the homepage dek. Declared --color-text-dek is rgba(18,18,18,1) and was not the colour on that paragraph."
        }
      },
      "secondary": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": {
          "source": "computed date color; --color-text-pubdate"
        }
      },
      "disabled": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-disabled rgba(102,102,102,1)"
        }
      },
      "on-accent": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color on Subscribe and GET DIGITAL ACCESS"
        }
      },
      "on-inverse": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the span inside Continue with e-mail"
        }
      },
      "rubric": {
        "$value": "#db3334",
        "$type": "color",
        "$extensions": {
          "source": "computed color on Dept. of Medicine; --color-text-rubric rgba(219,51,52,1)"
        }
      },
      "navigation": {
        "$value": "#121212",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-navigation rgba(18,18,18,1)"
        }
      },
      "link": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-link rgba(0,0,0,1)"
        }
      },
      "error": {
        "$value": "#aa1b19",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-error and --color-border-error rgba(170,27,25,1). No error state was triggered."
        }
      },
      "footer": {
        "$value": "#a2a2a2",
        "$type": "color",
        "$extensions": {
          "source": "computed color on homepage footer links such as Privacy Policy"
        }
      },
      "ad": {
        "$value": "#979797",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-text-ad rgba(151,151,151,1)"
        }
      },
      "legal": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": {
          "source": "computed color on User Agreement and Privacy Policy on the sign-in page"
        }
      }
    },
    "borderRole": {
      "default": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border"
        }
      },
      "input": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-input rgba(229,229,229,1)"
        }
      },
      "strong": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed border color on the sign-in email wrap"
        }
      },
      "navigation": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-navigation rgba(51,51,51,1)"
        }
      },
      "focus": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-focus rgba(51,51,51,1). Keyboard focus was not held."
        }
      },
      "error": {
        "$value": "#aa1b19",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-error. No invalid field was shown."
        }
      },
      "pullquote": {
        "$value": "#db3334",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-pullquote rgba(219,51,52,1)"
        }
      },
      "social": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": {
          "source": "computed border on Google, Apple, and Facebook buttons"
        }
      }
    },
    "component": {
      "subscribe": {
        "bg": {
          "$value": "{light.accent}",
          "$type": "color",
          "$extensions": {
            "source": "computed background of the homepage Subscribe link"
          }
        },
        "text": {
          "$value": "{light.textRole.on-accent}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of Subscribe"
          }
        },
        "radius": {
          "$value": "{core.radius.subscribe}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 1px radius"
          }
        },
        "height": {
          "$value": "{core.size.subscribe}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 23px height"
          }
        }
      },
      "offer-button": {
        "bg": {
          "$value": "{light.accent}",
          "$type": "color",
          "$extensions": {
            "source": "computed background of GET DIGITAL ACCESS"
          }
        },
        "text": {
          "$value": "{light.textRole.on-accent}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of GET DIGITAL ACCESS"
          }
        },
        "radius": {
          "$value": "{core.radius.offer}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 4px radius"
          }
        },
        "height": {
          "$value": "{core.size.offer-button}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 48px height"
          }
        }
      },
      "sign-in-button": {
        "bg": {
          "$value": "{light.background.inverse}",
          "$type": "color",
          "$extensions": {
            "source": "computed background of Continue with e-mail"
          }
        },
        "text": {
          "$value": "{light.textRole.on-inverse}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of the span inside Continue with e-mail. The button element's own color computed to rgb(0,0,0)."
          }
        },
        "radius": {
          "$value": "{core.radius.none}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 0px radius"
          }
        },
        "height": {
          "$value": "{core.size.sign-in-button}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 50px height"
          }
        }
      },
      "email": {
        "bg": {
          "$value": "{light.page}",
          "$type": "color",
          "$extensions": {
            "source": "computed background of the email input"
          }
        },
        "text": {
          "$value": "{light.text}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of the email input"
          }
        },
        "radius": {
          "$value": "{core.radius.none}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 0px radius on the email wrap"
          }
        },
        "height": {
          "$value": "{core.size.email}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed 51px height of the email wrap"
          }
        }
      }
    }
  }
}
