{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "ui": {
          "$value": "\"Mona Sans VF\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": { "source": "Measured. css-var --fontStack-sansSerif on github.com html, 2026-11-22" }
        },
        "display": {
          "$value": "\"Mona Sans\", MonaSansFallback, -apple-system, \"system-ui\", \"Segoe UI\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": { "source": "Measured. computed font-family on the homepage h1 at 1440" }
        },
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
          "$type": "fontFamily",
          "$extensions": { "source": "Measured. css-var --fontStack-monospace" }
        }
      }
    },
    "radius": {
      "small": { "$value": "3px", "$type": "dimension", "$extensions": { "source": "Derived. --borderRadius-small .1875rem at 16px" } },
      "medium": { "$value": "6px", "$type": "dimension", "$extensions": { "source": "Derived. --borderRadius-medium .375rem at 16px. Also the computed radius of the hero Sign up button and the header Sign up pill" } },
      "large": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "Derived. --borderRadius-large .75rem at 16px" } },
      "nav": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "Measured. computed border-radius on the Pricing nav link" } }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "Derived. --base-size-4 .25rem" } },
      "2": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "Derived. --base-size-8 .5rem" } },
      "3": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "Measured. horizontal padding on the header Sign up pill, 0px 12px" } },
      "4": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "Derived. --base-size-16 1rem" } },
      "6": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "Derived. --base-size-24 1.5rem" } },
      "8": { "$value": "32px", "$type": "dimension", "$extensions": { "source": "Derived. --base-size-32 2rem" } }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.family.display}", "fontSize": "56px", "fontWeight": "440", "lineHeight": "61.6px" },
        "$type": "typography",
        "$extensions": { "source": "Measured. computed style on the homepage h1 at 1440" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "21px" },
        "$type": "typography",
        "$extensions": { "source": "Measured. computed style on body at 1440" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.family.display}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "24px" },
        "$type": "typography",
        "$extensions": { "source": "Measured. computed style on the Pricing nav link" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "21px" },
        "$type": "typography",
        "$extensions": { "source": "Measured. computed style on the hero Sign up for GitHub button" }
      }
    },
    "size": {
      "header": { "$value": "68px", "$type": "dimension", "$extensions": { "source": "Measured. header getBoundingClientRect height at 1440" } },
      "header-phone": { "$value": "52px", "$type": "dimension", "$extensions": { "source": "Measured. header height at 390 in the T3 preview" } },
      "nav-button": { "$value": "32px", "$type": "dimension", "$extensions": { "source": "Measured. header Sign up pill height" } },
      "search": { "$value": "36px", "$type": "dimension", "$extensions": { "source": "Measured. search button height" } },
      "hero-button": { "$value": "43px", "$type": "dimension", "$extensions": { "source": "Measured. hero Sign up for GitHub button height" } }
    }
  },
  "light": {
    "color": {
      "bg": {
        "canvas": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "Measured. computed background-color on html at github.com" } },
        "default": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-default" } },
        "muted": { "$value": "#f6f8fa", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-muted" } },
        "inset": { "$value": "#f6f8fa", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-inset" } },
        "emphasis": { "$value": "#25292e", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-emphasis" } }
      },
      "fg": {
        "default": { "$value": "#1f2328", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-default" } },
        "muted": { "$value": "#59636e", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-muted" } },
        "on-emphasis": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-onEmphasis" } },
        "disabled": { "$value": "#818b98", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-disabled" } },
        "ink": { "$value": "#000000", "$type": "color", "$extensions": { "source": "Measured. computed color on the homepage h1" } }
      },
      "accent": {
        "fg": { "$value": "#0969da", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-accent" } },
        "emphasis": { "$value": "#0969da", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-accent-emphasis" } }
      },
      "success": {
        "fg": { "$value": "#1a7f37", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-success" } },
        "emphasis": { "$value": "#1f883d", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-success-emphasis and --button-primary-bgColor-rest" } },
        "hover": { "$value": "#1c8139", "$type": "color", "$extensions": { "source": "Measured. css-var --button-primary-bgColor-hover" } },
        "active": { "$value": "#197935", "$type": "color", "$extensions": { "source": "Measured. css-var --button-primary-bgColor-active" } }
      },
      "danger": {
        "fg": { "$value": "#d1242f", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-danger" } },
        "emphasis": { "$value": "#cf222e", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-danger-emphasis" } }
      },
      "attention": {
        "fg": { "$value": "#9a6700", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-attention" } },
        "emphasis": { "$value": "#9a6700", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-attention-emphasis" } }
      },
      "border": {
        "default": { "$value": "#d1d9e0", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-default" } },
        "muted": { "$value": "#d1d9e0b3", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-muted" } },
        "emphasis": { "$value": "#818b98", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-emphasis" } },
        "focus": { "$value": "#0969da", "$type": "color", "$extensions": { "source": "Measured. css-var --focus-outlineColor" } }
      },
      "button": {
        "hero": { "$value": "#08792b", "$type": "color", "$extensions": { "source": "Sampled. computed background-color on the hero Sign up for GitHub button, rgb(8, 135, 43). Not the Primer primary token" } },
        "header": { "$value": "#000000", "$type": "color", "$extensions": { "source": "Measured. computed background-color on the header Sign up link" } },
        "quiet": { "$value": "#0000000f", "$type": "color", "$extensions": { "source": "Sampled. computed background on Download GitHub Copilot app, rgba(0, 0, 0, 0.06)" } }
      },
      "control": {
        "bg": { "$value": "#f6f8fa", "$type": "color", "$extensions": { "source": "Measured. css-var --control-bgColor-rest" } },
        "border": { "$value": "#d1d9e0", "$type": "color", "$extensions": { "source": "Measured. css-var --control-borderColor-rest" } },
        "fg": { "$value": "#25292e", "$type": "color", "$extensions": { "source": "Measured. css-var --control-fgColor-rest" } }
      },
      "overlay": {
        "backdrop": { "$value": "#c8d1da66", "$type": "color", "$extensions": { "source": "Measured. css-var --overlay-backdrop-bgColor" } }
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "canvas": { "$value": "#0d1117", "$type": "color", "$extensions": { "source": "Measured. computed background-color on body at github.com/login with colorScheme dark" } },
        "default": { "$value": "#0d1117", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-default on the dark login wall" } },
        "muted": { "$value": "#151b23", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-muted" } },
        "inset": { "$value": "#010409", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-inset" } },
        "emphasis": { "$value": "#3d444d", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-emphasis" } }
      },
      "fg": {
        "default": { "$value": "#f0f6fc", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-default on the dark login wall" } },
        "muted": { "$value": "#9198a1", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-muted" } },
        "on-emphasis": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-onEmphasis" } },
        "disabled": { "$value": "#656c76", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-disabled" } }
      },
      "accent": {
        "fg": { "$value": "#4493f8", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-accent" } },
        "emphasis": { "$value": "#1f6feb", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-accent-emphasis" } }
      },
      "success": {
        "fg": { "$value": "#3fb950", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-success" } },
        "emphasis": { "$value": "#238636", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-success-emphasis" } }
      },
      "danger": {
        "fg": { "$value": "#f85149", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-danger" } },
        "emphasis": { "$value": "#da3633", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-danger-emphasis" } }
      },
      "attention": {
        "fg": { "$value": "#d29922", "$type": "color", "$extensions": { "source": "Measured. css-var --fgColor-attention" } },
        "emphasis": { "$value": "#9e6a03", "$type": "color", "$extensions": { "source": "Measured. css-var --bgColor-attention-emphasis" } }
      },
      "border": {
        "default": { "$value": "#3d444d", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-default" } },
        "muted": { "$value": "#3d444db3", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-muted" } },
        "emphasis": { "$value": "#656c76", "$type": "color", "$extensions": { "source": "Measured. css-var --borderColor-emphasis" } }
      }
    }
  },
  "$themes": [
    { "name": "light", "selectedTokenSets": { "core": "source", "light": "enabled" } },
    { "name": "dark", "selectedTokenSets": { "core": "source", "dark": "enabled" } }
  ]
}
