{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed page background rgb(255, 255, 255) on https://www.mytheresa.com/sg/en/women 2026-11-22"
        }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed department, nav, designer, and price rgb(0, 0, 0)"
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed Add to bag label rgb(255, 255, 255) on rgb(0, 0, 0)"
        }
      },
      "sale": {
        "$value": "#ed0000",
        "$type": "color",
        "$extensions": {
          "source": "computed .announcement background rgb(237, 0, 0) on the women homepage"
        }
      },
      "on-sale": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed .announcement__contents__item color rgb(255, 255, 255)"
        }
      },
      "promo": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed .announcement background rgb(0, 0, 0) on https://www.mytheresa.com/sg/en/about-us"
        }
      },
      "muted": {
        "$value": "#757575",
        "$type": "color",
        "$extensions": {
          "source": "computed .sizeitem--notavailable color rgb(117, 117, 117)"
        }
      },
      "tab": {
        "$value": "#f2f2f2",
        "$type": "color",
        "$extensions": {
          "source": "computed selected About us tab background rgb(242, 242, 242)"
        }
      },
      "mark": {
        "$value": "#e5ce18",
        "$type": "color",
        "$extensions": {
          "source": "sampled public favicon pixel rgb(229, 206, 24) from https://www.mytheresa.com/bucket/favicon.ico"
        }
      }
    },
    "font": {
      "sans": {
        "$value": "AvenirNextLTPro-Medium, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed nav, department, card designer, footer link, and Add to bag. The file is not in this package."
        }
      },
      "display": {
        "$value": "OptimaLTPro-Roman, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed hero title, category h1, product designer, and product price. The file is not in this package."
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "48px",
          "fontWeight": 400,
          "lineHeight": "57.6px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .bigbanner__copy__title Alaïa x Mytheresa"
        }
      },
      "page-title": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "70px",
          "fontWeight": 400,
          "lineHeight": "77px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .service__header__title About us"
        }
      },
      "section": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "28px",
          "fontWeight": 400,
          "lineHeight": "33.6px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .productcarousel__title and Clothing h1"
        }
      },
      "designer": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "24px",
          "fontWeight": 400,
          "lineHeight": "28.8px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .product__area__branding__designer"
        }
      },
      "price": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "20px",
          "fontWeight": 400,
          "lineHeight": "26px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed product .pricing__prices__price"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "16.8px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .nav__item__link and .departmentlinks__link"
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "18.2px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .button__text Add to bag"
        }
      },
      "promo": {
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "18.2px",
          "letterSpacing": "0.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed .announcement__contents__item"
        }
      }
    },
    "space": {
      "promo": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed announcement bar height 32px"
        }
      },
      "header": {
        "$value": "158px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed main navigation height 158px, promo plus wordmark row plus department row"
        }
      },
      "nav-item": {
        "$value": "73px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed .nav__item__link height 73px"
        }
      },
      "add-to-bag": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed Add to bag button height 44px"
        }
      },
      "size": {
        "$value": "46px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed .dropdown__select height 46px"
        }
      },
      "email": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed newsletter email field height 48px. The field was not filled."
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed Add to bag, size control, and nav border-radius 0px"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "{core.color.page}",
      "$type": "color",
      "$extensions": { "source": "alias of core.color.page" }
    },
    "text": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$extensions": { "source": "alias of core.color.ink" }
    },
    "accent": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$extensions": { "source": "Add to bag face is ink. The red bar is a sale promo, not the control accent." }
    },
    "sale": {
      "$value": "{core.color.sale}",
      "$type": "color",
      "$extensions": { "source": "alias of core.color.sale" }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": { "core": "source", "light": "enabled" }
    }
  ]
}
