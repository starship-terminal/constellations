{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. html backgroundColor rgb(255, 255, 255) on https://www.dermstore.com/ 2026-11-22." }
      },
      "ink": {
        "$value": "#121212",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(18, 18, 18)." }
      },
      "ink-soft": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo bar text rgb(0, 0, 0). Wordmark SVG fill is #222." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Department nav text and Add to Cart text rgb(255, 255, 255)." }
      },
      "promo": {
        "$value": "#cccccc",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo bar backgroundColor rgb(204, 204, 204), confirmed in the homepage PNG." }
      },
      "nav": {
        "$value": "#222222",
        "$type": "color",
        "$extensions": { "source": "Measured. Department bar backgroundColor rgb(34, 34, 34), 44px. Wordmark fill is the same #222." }
      },
      "trust": {
        "$value": "#f2f2f2",
        "$type": "color",
        "$extensions": { "source": "Measured. Shipping strip backgroundColor rgb(242, 242, 242), 49px." }
      },
      "search-border": {
        "$value": "#8c8c8c",
        "$type": "color",
        "$extensions": { "source": "Measured. Search wrap border 1px solid rgb(140, 140, 140)." }
      },
      "bag": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. ADD TO CART backgroundColor rgb(0, 0, 0) on the SkinCeuticals C E Ferulic page. QUICK BUY is the same black." }
      },
      "muted": {
        "$value": "#6b7280",
        "$type": "color",
        "$extensions": { "source": "Measured. Brand link color rgb(107, 114, 128) on the product page." }
      },
      "title": {
        "$value": "#111827",
        "$type": "color",
        "$extensions": { "source": "Measured. Product h1 color rgb(17, 24, 39)." }
      },
      "hero": {
        "$value": "#8c040c",
        "$type": "color",
        "$extensions": { "source": "Sampled. Holiday banner photograph, pixel at CSS 200,300 on home-light-1440.png, rgb(140, 4, 12). Not a CSS background." }
      }
    },
    "font": {
      "body": {
        "$value": "Manrope, Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily Manrope. Files are not in this package. Helvetica and Arial are fallbacks, not measured." }
      },
      "display": {
        "$value": "\"Libre Bodoni\", Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. Product title, price, category h1, and About heading fontFamily Libre Bodoni. Georgia is a fallback, not measured." }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Promo bar, department bar, search, Ask Derm AI, and Add to Cart border-radius 0px." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "ink": { "$value": "{core.color.ink}", "$type": "color" },
      "ink-soft": { "$value": "{core.color.ink-soft}", "$type": "color" },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color" },
      "promo": { "$value": "{core.color.promo}", "$type": "color" },
      "nav": { "$value": "{core.color.nav}", "$type": "color" },
      "trust": { "$value": "{core.color.trust}", "$type": "color" },
      "search-border": { "$value": "{core.color.search-border}", "$type": "color" },
      "bag": { "$value": "{core.color.bag}", "$type": "color" },
      "muted": { "$value": "{core.color.muted}", "$type": "color" },
      "title": { "$value": "{core.color.title}", "$type": "color" },
      "hero": { "$value": "{core.color.hero}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
