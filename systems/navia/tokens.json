{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "cream": {
        "$value": "#faf4e6",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--neutral-lightest, and computed body background rgb(250, 244, 230) on www.thenavia.com" }
      },
      "ink": {
        "$value": "#36312a",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--neutral-darkest, computed body color rgb(54, 49, 42)" }
      },
      "ink-nav": {
        "$value": "#332e29",
        "$type": "color",
        "$extensions": { "source": "Measured. --nav-btn-text on .navbar2_component. Computed nav CTA color rgb(51, 46, 41)" }
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--white" }
      },
      "yellow": {
        "$value": "#e8ff39",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--yellow and --color-scheme-1--accent. Computed nav CTA background rgb(232, 255, 57)" }
      },
      "orange": {
        "$value": "#f88450",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--orange. Computed .button-base background rgb(248, 132, 80)" }
      },
      "orange-press": {
        "$value": "#e5703c",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --color-brand-secondary-700. Not seen as a computed paint on the signed-out gate" }
      },
      "purple": {
        "$value": "#c99ddd",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--purple and app --color-brand-accent-600" }
      },
      "purple-soft": {
        "$value": "#efd8f9",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --color-brand-accent-500. Not painted on the signed-out gate" }
      },
      "purple-deep": {
        "$value": "#925faa",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --color-brand-accent-700. Not painted on the signed-out gate" }
      },
      "border": {
        "$value": "#cdc7b8",
        "$type": "color",
        "$extensions": { "source": "Measured. --_primitives---colors--border. Computed pricing_plan border rgb(205, 199, 184)" }
      },
      "slate-100": {
        "$value": "#efe8d9",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --brand-slate-100 and --muted" }
      },
      "slate-200": {
        "$value": "#dfd5c0",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --brand-slate-200. Computed Sign In border rgb(223, 213, 192)" }
      },
      "muted": {
        "$value": "#5a544c",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --brand-slate-600. Computed gate lede color rgb(90, 84, 76)" }
      },
      "muted-soft": {
        "$value": "#8a847a",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --brand-slate-400 and --muted-foreground. Not painted on the signed-out gate" }
      },
      "focus": {
        "$value": "#f88450",
        "$type": "color",
        "$extensions": { "source": "Measured. app gate --ring. Computed outline rgb(248, 132, 80) solid 2px on focused Sign In" }
      }
    },
    "font": {
      "body": {
        "$value": "\"Public Sans\", Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. --_typography---font-styles--body is Publicsans Variablefont Wght. The app gate loads Public Sans" }
      },
      "heading": {
        "$value": "Lora, \"Times New Roman\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. --_typography---font-styles--heading, Lora Variablefont Wght. The app gate loads Lora, Georgia" }
      },
      "hand": {
        "$value": "Notemakersmark, \"Times New Roman\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. --_typography---font-styles--handwriting. Computed on the handwriting headline and the Basic plan label" }
      }
    },
    "fontSize": {
      "display": {
        "$value": "5rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-large. Computed 77.18px at innerWidth 1169, where 1rem was 15.436px" }
      },
      "h1": {
        "$value": "3.5rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h1. Computed 54.026px" }
      },
      "h2": {
        "$value": "4rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h2. Computed 61.744px" }
      },
      "h3": {
        "$value": "3rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h3" }
      },
      "h4": {
        "$value": "2rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h4. Computed 30.872px" }
      },
      "h5": {
        "$value": "1.4rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h5. Computed 20.0668px" }
      },
      "hand": {
        "$value": "7rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h2.handwriting. Computed 108.052px, letter-spacing -6px" }
      },
      "plan": {
        "$value": "2.5rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .heading-style-h6.text-color-orange. Computed 38.59px, letter-spacing -2px" }
      },
      "large": {
        "$value": "1.25rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .text-size-large" }
      },
      "medium": {
        "$value": "1.125rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .text-size-medium. Computed 17.3655px" }
      },
      "body": {
        "$value": "1rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .text-size-regular. Computed body 15.436px at this viewport" }
      },
      "small": {
        "$value": "0.875rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .text-size-small" }
      },
      "tiny": {
        "$value": "0.75rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .text-size-tiny" }
      }
    },
    "lineHeight": {
      "display": { "$value": "1.2", "$type": "number", "$extensions": { "source": "Measured. .heading-style-large" } },
      "h1": { "$value": "1.1", "$type": "number", "$extensions": { "source": "Measured. .heading-style-h1" } },
      "h2": { "$value": "1.2", "$type": "number", "$extensions": { "source": "Measured. .heading-style-h2" } },
      "h4": { "$value": "1.3", "$type": "number", "$extensions": { "source": "Measured. .heading-style-h4" } },
      "h5": { "$value": "1.4", "$type": "number", "$extensions": { "source": "Measured. .heading-style-h5" } },
      "body": { "$value": "1.5", "$type": "number", "$extensions": { "source": "Derived. Computed body line-height 23.154px / font-size 15.436px" } }
    },
    "radius": {
      "pill": {
        "$value": "4rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. .button-base border-radius. Computed 61.744px, which is 4rem at this root" }
      },
      "button-app": {
        "$value": "25px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. app gate --radius-button. Computed Sign In border-radius 25px" }
      },
      "brand": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. app gate --radius-brand. Not painted on the signed-out gate" }
      },
      "large": {
        "$value": "1rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. --_ui-styles---radius--large" }
      },
      "medium": {
        "$value": "0.5rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. --_ui-styles---radius--medium. Computed pricing_plan 7.718px" }
      },
      "small": {
        "$value": "0.25rem",
        "$type": "dimension",
        "$extensions": { "source": "Measured. --_ui-styles---radius--small. Computed contact field 3.859px" }
      }
    },
    "spacing": {
      "2": { "$value": "0.25rem", "$type": "dimension", "$extensions": { "source": "Measured. .button-base.is-nav padding-top 0.25rem" } },
      "4": { "$value": "0.5rem", "$type": "dimension", "$extensions": { "source": "Measured. --_ui-styles---radius--medium, used as a spacing step on .button-base.is-small padding" } },
      "8": { "$value": "0.75rem", "$type": "dimension", "$extensions": { "source": "Measured. .button-base padding-top 0.75rem. Computed 11.577px" } },
      "12": { "$value": "1.5rem", "$type": "dimension", "$extensions": { "source": "Measured. .button-base padding-left 1.5rem. Computed 23.154px" } },
      "16": { "$value": "2rem", "$type": "dimension", "$extensions": { "source": "Measured. app gate card padding 32px" } },
      "page": { "$value": "5%", "$type": "dimension", "$extensions": { "source": "Measured. .padding-global padding-left 5%. Computed 58.4453px at innerWidth 1169" } }
    },
    "motion": {
      "duration": {
        "button": {
          "$value": "200ms",
          "$type": "duration",
          "$extensions": { "source": "Measured. .button transition background-color .2s, color .2s" }
        },
        "overlay": {
          "$value": "400ms",
          "$type": "duration",
          "$extensions": { "source": "Measured. --btn-overlay-duration 0.4s" }
        },
        "text": {
          "$value": "300ms",
          "$type": "duration",
          "$extensions": { "source": "Measured. --btn-text-duration 0.3s" }
        }
      },
      "easing": {
        "button": {
          "$value": "cubic-bezier(0.625, 0.05, 0, 1)",
          "$type": "cubicBezier",
          "$extensions": { "source": "Measured. --btn-ease" }
        }
      },
      "$extensions": {
        "reducedMotion": "The marketing stylesheet has no prefers-reduced-motion rule. The app stylesheet has four such rules, including animation:none on .nv-img-drawing and view transitions. The signed-out gate showed none of those elements.",
        "source": "Declared rules. The motion probe was not run, because preview frames failed and a headless session was not started."
      }
    }
  },
  "light": {
    "page": {
      "$value": "{core.color.cream}",
      "$type": "color",
      "$extensions": { "source": "Measured. body background on the home, blog, article, contact and privacy pages, and on the app gate" }
    },
    "surface": {
      "$value": "{core.color.white}",
      "$type": "color",
      "$extensions": { "source": "Measured. .section.is-white background rgb(255, 255, 255), and app --card" }
    },
    "surface-dark": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$extensions": { "source": "Measured. .section.is-dark and .pricing_plan.highlight background rgb(54, 49, 42)" }
    },
    "text": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$extensions": { "source": "Measured. body color rgb(54, 49, 42)" }
    },
    "text-on-dark": {
      "$value": "{core.color.white}",
      "$type": "color",
      "$extensions": { "source": "Measured. h1 color rgb(255, 255, 255) on the hero, and .section.is-dark color" }
    },
    "muted": {
      "$value": "{core.color.muted}",
      "$type": "color",
      "$extensions": { "source": "Measured. app gate lede rgb(90, 84, 76). The marketing body uses the ink, not a softer text colour" }
    },
    "accent": {
      "$value": "{core.color.yellow}",
      "$type": "color",
      "$extensions": { "source": "Measured. --color-scheme-1--accent and the nav Get started face" }
    },
    "accent-orange": {
      "$value": "{core.color.orange}",
      "$type": "color",
      "$extensions": { "source": "Measured. default .button-base background and article link color rgb(248, 132, 80)" }
    },
    "border": {
      "$value": "{core.color.border}",
      "$type": "color",
      "$extensions": { "source": "Measured. pricing_plan border rgb(205, 199, 184)" }
    },
    "border-strong": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$extensions": { "source": "Measured. contact field border 1px solid rgb(54, 49, 42)" }
    },
    "focus": {
      "$value": "{core.color.focus}",
      "$type": "color",
      "$extensions": { "source": "Measured. app gate focus outline. Marketing button-base focus outline was none" }
    },
    "component": {
      "button": {
        "bg": { "$value": "{core.color.orange}", "$type": "color", "$extensions": { "source": "Measured. default .button-base background" } },
        "text": { "$value": "{core.color.white}", "$type": "color", "$extensions": { "source": "Measured. default .button-base color" } },
        "radius": { "$value": "{core.radius.pill}", "$type": "dimension", "$extensions": { "source": "Measured. .button-base radius 4rem" } },
        "padding": { "$value": "0.75rem 1.5rem", "$type": "dimension", "$extensions": { "source": "Measured. .button-base padding" } }
      },
      "button-yellow": {
        "bg": { "$value": "{core.color.yellow}", "$type": "color", "$extensions": { "source": "Measured. nav Get started background rgb(232, 255, 57)" } },
        "text": { "$value": "{core.color.ink-nav}", "$type": "color", "$extensions": { "source": "Measured. nav Get started color rgb(51, 46, 41)" } },
        "radius": { "$value": "{core.radius.pill}", "$type": "dimension", "$extensions": { "source": "Measured. nav Get started radius 61.744px" } }
      },
      "field": {
        "bg": { "$value": "{core.color.cream}", "$type": "color", "$extensions": { "source": "Measured. contact input background rgb(250, 244, 230)" } },
        "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Measured. contact input color rgb(54, 49, 42)" } },
        "radius": { "$value": "{core.radius.small}", "$type": "dimension", "$extensions": { "source": "Measured. contact input radius 3.859px" } }
      },
      "plan": {
        "bg": { "$value": "{core.color.cream}", "$type": "color", "$extensions": { "source": "Measured. pricing_plan sits on the cream page" } },
        "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Measured. pricing_plan color rgb(54, 49, 42)" } },
        "radius": { "$value": "{core.radius.medium}", "$type": "dimension", "$extensions": { "source": "Measured. pricing_plan radius 7.718px" } }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": { "core": "source", "light": "enabled" }
    }
  ]
}
