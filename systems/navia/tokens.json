{
  "core": {
    "base": {
      "color": {
        "neutral": {
          "": {
            "black": {
              "$value": "#000000",
              "$type": "color",
              "$extensions": {
                "source": "css-var --base-color-neutral--black<deleted|relume-variable-color-neutral-1> (light)"
              }
            },
            "neutral": {
              "lightest": {
                "$value": "#eeeeee",
                "$type": "color",
                "$extensions": {
                  "source": "css-var --base-color-neutral--neutral-lightest<deleted|relume-variable-color-neutral-3> (light)"
                }
              }
            },
            "white": {
              "$value": "#ffffff",
              "$type": "color",
              "$extensions": {
                "source": "css-var --base-color-neutral--white<deleted|relume-variable-color-neutral-2> (light)"
              }
            }
          }
        }
      }
    },
    "color": {
      "scheme": {
        "1": {
          "": {
            "accent": {
              "$value": "#e8ff39",
              "$type": "color",
              "$extensions": {
                "source": "css-var --color-scheme-1--accent (light)"
              }
            },
            "background": {
              "$value": "#faf4e6",
              "$type": "color",
              "$extensions": {
                "source": "css-var --color-scheme-1--background (light)"
              }
            },
            "border": {
              "$value": "#cdc7b8",
              "$type": "color",
              "$extensions": {
                "source": "css-var --color-scheme-1--border (light)"
              }
            },
            "foreground": {
              "$value": "#faf4e6",
              "$type": "color",
              "$extensions": {
                "source": "css-var --color-scheme-1--foreground (light)"
              }
            },
            "text": {
              "$value": "#36312a",
              "$type": "color",
              "$extensions": {
                "source": "css-var --color-scheme-1--text (light)"
              }
            }
          }
        }
      }
    },
    "font": {
      "family": {
        "heading": {
          "$value": "\"Lora Variablefont Wght\",\"Times New Roman\",sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared on :root in the Webflow stylesheet as --_typography---font-styles--heading; vars.mjs did not resolve it onto the probe element"
          },
          "$description": "Lora, the display face. Computed fontFamily on hero-title matches this stack."
        },
        "body": {
          "$value": "\"Publicsans Variablefont Wght\",Arial,sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared on :root in the Webflow stylesheet as --_typography---font-styles--body; vars.mjs did not resolve it onto the probe element"
          },
          "$description": "Public Sans, the UI face. Computed fontFamily on nav-link and submit matches this stack."
        },
        "handwriting": {
          "$value": "Notemakersmark,\"Times New Roman\",sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared on :root in the Webflow stylesheet as --_typography---font-styles--handwriting; vars.mjs did not resolve it onto the probe element"
          },
          "$description": "Notemakersmark, declared for handwritten accents. No captured control computed this family."
        }
      }
    },
    "radius": {
      "small": {
        "$value": "0.25rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared on :root in the Webflow stylesheet as --_ui-styles---radius--small; vars.mjs did not resolve it onto the probe element"
        },
        "$description": "0.25rem. Fields measure 4px, which is this step at 16px root."
      },
      "medium": {
        "$value": "0.5rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared on :root in the Webflow stylesheet as --_ui-styles---radius--medium; vars.mjs did not resolve it onto the probe element"
        },
        "$description": "0.5rem. Declared. No captured control measured 8px."
      },
      "large": {
        "$value": "1rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared on :root in the Webflow stylesheet as --_ui-styles---radius--large; vars.mjs did not resolve it onto the probe element"
        },
        "$description": "1rem. Declared. Primary buttons measure 64px, not this step."
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "80px",
          "lineHeight": "96px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of blog-title default (raw/components-computed.json); the 80px blog h1"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "64px",
          "lineHeight": "76.8px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of contact-title default (raw/components-computed.json); the 64px contact h1"
        }
      },
      "title": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "56px",
          "lineHeight": "61.6px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of hero-title default (raw/components-computed.json); the 56px hero h1"
        }
      },
      "section": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "48px",
          "lineHeight": "57.6px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of section-title default (raw/components-computed.json); the 48px section h2"
        }
      },
      "feature": {
        "$value": {
          "fontFamily": "{font.family.heading}",
          "fontSize": "22.4px",
          "lineHeight": "26.88px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of feature-item default (raw/components-computed.json); the 22.4px feature label"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "16px",
          "lineHeight": "25.6px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of text-field default (raw/components-computed.json); the 16px field"
        }
      },
      "label": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "16px",
          "lineHeight": "16px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of nav-link default (raw/components-computed.json); the 16px nav label"
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of submit default (raw/components-computed.json); the 16px submit label"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#faf4e6",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--background (light)"
      },
      "$description": "The page field: cream #faf4e6."
    },
    "surface": {
      "$value": "#faf4e6",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--foreground (light)"
      },
      "$description": "The scheme-1 foreground, the same cream as the page."
    },
    "text": {
      "$value": "#36312a",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--text (light)"
      },
      "$description": "Ink #36312a."
    },
    "accent": {
      "$value": "#e8ff39",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--accent (light)"
      },
      "$description": "Chartreuse #e8ff39, the primary button fill on the marketing nav and hero."
    },
    "accent-pressed": {
      "$value": "#36312a",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of submit hover (raw/components-computed.json): the orange submit inverts to ink. The chartreuse button's hover overlay was not isolated as its own token."
      },
      "$description": "Pressed/hover fill observed on the contact submit."
    },
    "on-accent": {
      "$value": "#36312a",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--text (light)"
      },
      "$description": "Ink on the chartreuse button."
    },
    "border": {
      "$value": "#cdc7b8",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-scheme-1--border (light)"
      },
      "$description": "The declared border #cdc7b8."
    },
    "field": {
      "$value": "#faf4e6",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of text-field default (raw/components-computed.json)"
      },
      "$description": "Contact field fill, the page cream."
    },
    "field-focus": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of text-field focus-visible (raw/components-computed.json)"
      },
      "$description": "Contact field fill when focused."
    },
    "orange": {
      "$value": "#f88450",
      "$type": "color",
      "$extensions": {
        "source": "css-var --_primitives---colors--orange, also computed backgroundColor of submit default"
      },
      "$description": "The contact submit and the contact-page nav button."
    },
    "component": {
      "control": {
        "height": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of submit default (raw/components-computed.json)"
          },
          "$description": "The contact submit is 48px."
        },
        "field": {
          "$value": "44px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of text-field default (raw/components-computed.json)"
          },
          "$description": "Contact fields are 44px."
        },
        "area": {
          "$value": "180px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of text-area default (raw/components-computed.json)"
          },
          "$description": "The message field is 180px."
        },
        "select": {
          "$value": "44px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of select default (raw/components-computed.json)"
          },
          "$description": "The topic select is 44px."
        },
        "radius": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of submit default (raw/components-computed.json)"
          },
          "$description": "The submit is a 64px pill."
        }
      },
      "field": {
        "radius": {
          "$value": "4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of text-field default (raw/components-computed.json)"
          },
          "$description": "Fields are 4px, the small radius step."
        }
      },
      "shell": {
        "header": {
          "$value": "72px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of header default (raw/components-computed.json)"
          },
          "$description": "The desktop nav is 72px."
        },
        "headerMobile": {
          "$value": "61.0156px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of m-header default (raw/components-computed.json)"
          },
          "$description": "The phone nav is 61px."
        }
      },
      "button": {
        "fill": {
          "$value": "#e8ff39",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-scheme-1--accent (light)"
          },
          "$description": "The chartreuse fill painted on .button-base inside the nav and hero CTAs."
        },
        "radius": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderRadius of .button-base inside the Get started anchor, read live on / on 2026-11-21 (the anchor itself is transparent)"
          },
          "$description": "Primary buttons are 64px pills."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme www.thenavia.com paints; no dark class or attribute is bound on the captured routes."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
