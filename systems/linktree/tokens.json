  "light": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of claim-field default"
      },
      "$description": "Claim field fill, the painted page ground"
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of claim-field default"
      },
      "$description": "Claim field fill"
    },
    "band": {
      "$value": "#502274",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of footer default"
      },
      "$description": "Footer band fill"
    },
    "hero": {
      "$value": "#d2e823",
      "$type": "color",
      "$extensions": {
        "source": "css-var --color-chartreuse resolved on the light probe"
      },
      "$description": "Hero band fill on the marketing home"
    },
    "text": {
      "$value": "#1e2330",
      "$type": "color",
      "$extensions": {
        "source": "computed color of nav-link default"
      },
      "$description": "Nav link ink"
    },
    "textInverse": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed color of nav-signup default"
      },
      "$description": "Ink on the signup pill"
    },
    "muted": {
      "$value": "rgba(0, 0, 0, 0.75)",
      "$type": "color",
      "$extensions": {
        "source": "computed color of profile-badge default"
      },
      "$description": "Verified badge ink"
    },
    "accent": {
      "$value": "#254f1a",
      "$type": "color",
      "$extensions": {
        "source": "computed color of hero-title default"
      },
      "$description": "Hero title colour"
    },
    "border": {
      "$value": "#e5e7eb",
      "$type": "color",
      "$extensions": {
        "source": "computed borderTopColor of login-field default"
      },
      "$description": "Login field border"
    },
    "link": {
      "$value": "#676b5f",
      "$type": "color",
      "$extensions": {
        "source": "computed color of footer-link default"
      },
      "$description": "Footer link ink"
    },
    "focus": {
      "$value": "#1e2330",
      "$type": "color",
      "$extensions": {
        "source": "computed focus ring (box-shadow 4px spread, outermost layer) of nav-login focus-visible"
      },
      "$description": "Keyboard focus ring on the Log in link (the Sign up pill, hero and claim buttons draw the same ring)"
    },
    "button": {
      "$value": "#1e2330",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of nav-signup default"
      },
      "$description": "Sign up free pill fill"
    },
    "buttonText": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed color of nav-signup default"
      },
      "$description": "Sign up free pill label"
    },
    "component": {
      "control": {
        "radiusPill": {
          "$value": "9999px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of nav-signup default"
          },
          "$description": "Signup pill radius"
        },
        "heightNav": {
          "$value": "62px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of nav-signup default"
          },
          "$description": "Signup pill height"
        },
        "heightField": {
          "$value": "60px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of claim-field default"
          },
          "$description": "Claim field height"
        }
      },
      "header": {
        "height": {
          "$value": "138px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of navbar default"
          },
          "$description": "Marketing nav height"
        }
      },
      "motion": {
        "duration": {
          "$value": "150ms",
          "$type": "duration",
          "$extensions": {
            "source": "computed transitionDuration of nav-signup default"
          },
          "$description": "Signup pill transition"
        }
      }
    }
  },
  "dark": {},
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The theme every captured public route paints."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light",
      "dark"
    ]
  }
}
