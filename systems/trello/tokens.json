{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "body": {
        "$value": "Charlie Text, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of body on https://trello.com/"
        }
      },
      "display": {
        "$value": "Charlie Display, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of the homepage h1"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the homepage h1 at 1440"
        }
      },
      "body": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of body"
        }
      },
      "nav": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the Pricing link"
        }
      },
      "button": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the homepage Sign up button"
        }
      }
    },
    "radius": {
      "field": {
        "$value": "4.8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of the homepage email field and Sign up button"
        }
      },
      "header": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of the header Get Trello for free control"
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{fontSize.hero}",
          "fontWeight": "500",
          "lineHeight": "60px",
          "letterSpacing": "normal"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of the homepage h1 on https://trello.com/"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.body}",
          "fontWeight": "400",
          "lineHeight": "30px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of body"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color of body on https://trello.com/"
        }
      },
      "text": {
        "$value": "#091e42",
        "$type": "color",
        "$extensions": {
          "source": "computed color of body, rgb(9, 30, 66). Matches declared --color-N600-rgb"
        }
      },
      "nav": {
        "$value": "#172b4d",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the Pricing link, rgb(23, 43, 77)"
        }
      },
      "link": {
        "$value": "#0052cc",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the Learn more link, rgb(0, 82, 204). Matches declared --color-B400-rgb"
        }
      },
      "button": {
        "$value": "#0065ff",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color of the homepage Sign up button, rgb(0, 101, 255). Matches declared --color-B300-rgb"
        }
      },
      "buttonText": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the homepage Sign up button"
        }
      },
      "border": {
        "$value": "#dfe1e6",
        "$type": "color",
        "$extensions": {
          "source": "computed border color of the homepage email field, rgb(223, 225, 230). Matches declared --color-N40-rgb"
        }
      },
      "trelloBlue": {
        "$value": "#0079bf",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-trelloblue-rgb 0,121,191 on https://trello.com/"
        }
      }
    }
  }
}
