{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#15191a",
        "$type": "color",
        "$extensions": { "source": "computed title and search text rgb(21, 25, 26) on https://www.vinted.com/ 2026-11-22" }
      },
      "quiet": {
        "$value": "#5a6566",
        "$type": "color",
        "$extensions": { "source": "computed body, nav, price, and footer link rgb(90, 101, 102)" }
      },
      "page": {
        "$value": "#edf2f2",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(237, 242, 242)" }
      },
      "surface": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed header and hero card background rgb(255, 255, 255)" }
      },
      "search": {
        "$value": "#edf2f2",
        "$type": "color",
        "$extensions": { "source": "computed search bar background rgb(237, 242, 242)" }
      },
      "teal": {
        "$value": "#007782",
        "$type": "color",
        "$extensions": { "source": "computed Sell now background and link color rgb(0, 119, 130). Sell now was not clicked" }
      },
      "on-teal": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Sell now label rgb(255, 255, 255)" }
      },
      "chip": {
        "$value": "#e6fafa",
        "$type": "color",
        "$extensions": { "source": "computed selected Category chip background rgb(230, 250, 250) on /catalog/1904-women" }
      },
      "chip-border": {
        "$value": "#b6bebf",
        "$type": "color",
        "$extensions": { "source": "computed unselected filter chip border rgb(182, 190, 191)" }
      },
      "hairline": {
        "$value": "#ededed",
        "$type": "color",
        "$extensions": { "source": "sampled header hairline rgb(237, 237, 237) on home-light-1440.png" }
      },
      "mint": {
        "$value": "#edffe9",
        "$type": "color",
        "$extensions": { "source": "computed How it works band background rgb(237, 255, 233)" }
      }
    },
    "font": {
      "ui": {
        "$value": "V-Inter, V_INTER, Helvetica Neue, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body V_INTER and control V-Inter. Files are not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "13px", "fontWeight": 400, "lineHeight": "16.25px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the homepage" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 375, "lineHeight": "18px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed category tab, 44px row" }
      },
      "search": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 375, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed search input. Not submitted" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 375, "lineHeight": "16px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed header Sell now. Not clicked" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "24px", "fontWeight": 500, "lineHeight": "32px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h1" }
      },
      "hero-button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage Sell now in the hero card. Not clicked" }
      },
      "category": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "22px", "fontWeight": 580, "lineHeight": "28px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women catalog h1" }
      },
      "about": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "24px", "fontWeight": 500, "lineHeight": "32px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed About h1" }
      },
      "about-body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 375, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed About paragraph" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 375, "lineHeight": "16px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage price" }
      },
      "footer-label": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer column label" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer link" }
      },
      "menu-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 375, "lineHeight": "22px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women menu link" }
      }
    },
    "radius": {
      "control": { "$value": "6px", "$type": "dimension", "$extensions": { "source": "computed search, Sign up, Sell now, and Learn how it works" } },
      "card": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "computed homepage hero card" } },
      "chip": { "$value": "3996px", "$type": "dimension", "$extensions": { "source": "computed filter chip. Pill." } }
    },
    "size": {
      "header": { "$value": "98px", "$type": "dimension", "$extensions": { "source": "computed header bar, logo row plus category row" } },
      "search": { "$value": "36px", "$type": "dimension", "$extensions": { "source": "computed search bar" } },
      "sell": { "$value": "32px", "$type": "dimension", "$extensions": { "source": "computed header Sell now. Not clicked" } },
      "hero-sell": { "$value": "44px", "$type": "dimension", "$extensions": { "source": "computed hero Sell now. Not clicked" } },
      "chip": { "$value": "36px", "$type": "dimension", "$extensions": { "source": "computed filter chip" } },
      "logo": { "$value": "73px", "$type": "dimension", "$extensions": { "source": "computed wordmark width. Height 42px" } }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled" } }
  ]
}
