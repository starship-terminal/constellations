{
  "core": {
    "palette": {
      "paper": {
        "$value": "#fbf8f6",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of the painted ancestor of the home h1, 2026-11-21"
        }
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of the header bar"
        }
      },
      "ink": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of the Sign in button and nav links"
        }
      },
      "inkStrong": {
        "$value": "#161616",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of About us and All categories"
        }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of body, and backgroundColor of Sign up to buy on hover"
        }
      },
      "whiteText": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of the display heading and the primary button label"
        }
      },
      "hairline": {
        "$value": "#dadada",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed borderTopColor of the email field shell and the All filters pill"
        }
      },
      "focus": {
        "$value": "#275ec5",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed outlineColor of Sign up to buy after keyboard focus"
        }
      }
    },
    "font": {
      "family": {
        "display": {
          "$value": "Nantes_fix, serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "Measured: computed fontFamily of the home h1"
          }
        },
        "ui": {
          "$value": "Graphik_fix, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "Measured: computed fontFamily of Sign up to buy and nav links"
          }
        },
        "body": {
          "$value": "Graphik, system, -apple-system, system-ui, Helvetica Neue, Lucida Grande, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "Measured: computed fontFamily of body"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "Nantes_fix, serif",
          "fontSize": "52px",
          "fontWeight": 400,
          "lineHeight": "64px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of the home h1, Find your next bestseller"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "Nantes_fix, serif",
          "fontSize": "38px",
          "fontWeight": 400,
          "lineHeight": "50px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of the Home decor category h1"
        }
      },
      "ui": {
        "$value": {
          "fontFamily": "Graphik_fix, sans-serif",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px",
          "letterSpacing": "0.15px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of Sign up to buy and nav links"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "Graphik, sans-serif",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "20px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: body fontSize 16px. Line height taken from the category card text, which computed to 20px."
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: sign-in dialog and categories menu borderRadius"
        }
      },
      "control": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: Sign up to buy, email field shell, Sign in submit"
        }
      },
      "pill": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: All categories button borderRadius"
        }
      },
      "full": {
        "$value": "999px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: All filters pill borderRadius"
        }
      }
    },
    "space": {
      "4": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "Derived: 4px step. Control padding was measured at 16px and 20px, which sit on this step. The step itself was not a named token." } },
      "8": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "Derived: 8px step from the same measured paddings." } },
      "16": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "Measured: horizontal padding of Sign up to buy and Sign in" } },
      "20": { "$value": "20px", "$type": "dimension", "$extensions": { "source": "Measured: horizontal padding of the Sign in submit button" } },
      "24": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "Measured: horizontal padding of Sign in with Google" } }
    },
    "size": {
      "buttonSm": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: height of Sign up to buy and the email field shell" }
      },
      "buttonMd": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: height of the Sign in submit button" }
      },
      "header": {
        "$value": "108px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: header bar height at 1440" }
      },
      "dialog": {
        "$value": "420px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: sign-in dialog width" }
      }
    },
    "focusRing": {
      "width": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: outline width of Sign up to buy on keyboard focus" }
      },
      "offset": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": { "source": "Measured: outline-offset of Sign up to buy on keyboard focus" }
      }
    }
  },
  "light": {
    "background": {
      "page": { "$value": "{core.palette.paper}", "$type": "color", "$extensions": { "source": "Alias of the measured page wash" } },
      "surface": { "$value": "{core.palette.white}", "$type": "color", "$extensions": { "source": "Alias of the measured header and dialog fill" } },
      "overlay": { "$value": "{core.palette.white}", "$type": "color", "$extensions": { "source": "Measured: categories menu and sign-in dialog background" } }
    },
    "text": {
      "primary": { "$value": "{core.palette.ink}", "$type": "color", "$extensions": { "source": "Alias of measured nav and button ink" } },
      "strong": { "$value": "{core.palette.inkStrong}", "$type": "color", "$extensions": { "source": "Alias of measured menu item color" } },
      "onAccent": { "$value": "{core.palette.whiteText}", "$type": "color", "$extensions": { "source": "Measured: primary button label" } },
      "display": { "$value": "{core.palette.whiteText}", "$type": "color", "$extensions": { "source": "Measured: home h1, painted over the hero photograph" } }
    },
    "border": {
      "default": { "$value": "{core.palette.hairline}", "$type": "color", "$extensions": { "source": "Alias of the measured field and pill border" } },
      "focus": { "$value": "{core.palette.focus}", "$type": "color", "$extensions": { "source": "Alias of the measured focus outline" } }
    },
    "action": {
      "primary": { "$value": "{core.palette.ink}", "$type": "color", "$extensions": { "source": "Measured: Sign up to buy background, default" } },
      "primaryHover": { "$value": "{core.palette.black}", "$type": "color", "$extensions": { "source": "Measured: Sign up to buy background on hover" } }
    },
    "focus": {
      "ring": { "$value": "{core.palette.focus}", "$type": "color", "$extensions": { "source": "Measured: keyboard focus outline on Sign up to buy" } }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
