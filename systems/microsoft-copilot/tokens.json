{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "Segoe Serif Display, Georgia, Times New Roman, serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "computed h1 font-family SegoeSerifDisplay on https://copilot.com/"
            }
          }
        },
        "ui": {
          "$type": "fontFamily",
          "$value": "Segoe Sans, Segoe UI, Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "computed main font-family SegoeSans, SegoeUI on https://copilot.com/"
            }
