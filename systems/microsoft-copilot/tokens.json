          "$value": "Segoe UI, SegoeUI, Helvetica Neue, Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "computed --uhf-font-family and header button font-family"
            }
          }
        }
      }
    },
    "fontSize": {
