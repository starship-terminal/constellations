          }
        },
        "300ms": {
          "$type": "duration",
          "$value": "300ms",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "declared .module-card transition all .3s cubic-bezier(.4,0,.2,1) in unauth-copilotcom CSS"
            }
          }
        }
      },
      "easing": {
        "ease": {
          "$type": "cubicBezier",
          "$value": [
            0.25,
            0.1,
            0.25,
            1
          ],
          "$extensions": {
            "source": {
              "evidence": "Derived",
              "capture": "keyword ease on .copilotcom-tab transition, expanded to control points"
            }
          }
        },
        "standard": {
          "$type": "cubicBezier",
          "$value": [
            0.4,
            0,
            0.2,
            1
          ],
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "declared .module-card transition cubic-bezier(.4,0,.2,1)"
