      "duration": {
        "200ms": {
          "$type": "duration",
          "$value": "200ms",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json page-1 computed transition on div.module-cta, 200ms ease"
