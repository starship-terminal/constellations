{
  "core": {
    "color": {
      "green": {
        "$value": "#006242",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of the home order strip and body backgroundColor of auth.starbucks.com/u/login, rgb(0, 98, 66), 2026-11-21"
        }
      },
      "greenLink": {
        "$value": "#00754a",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of 'See the holiday menu' and backgroundColor of Add to Order and the Auth0 Sign in button, rgb(0, 117, 74)"
        }
      },
      "greenDeep": {
        "$value": "#1e3932",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of the Customize button on /menu/product/407/hot, rgb(30, 57, 50)"
        }
      },
      "cream": {
        "$value": "#f5f1eb",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of the home holiday panel, rgb(245, 241, 235)"
        }
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed backgroundColor of body on www.starbucks.com"
        }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of body text and backgroundColor of Join now"
        }
      },
      "ink": {
        "$value": "rgba(0, 0, 0, 0.87)",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of Sign in and product body text"
        }
      },
      "nav": {
        "$value": "rgba(0, 0, 0, 0.9)",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of the MENU header link"
        }
      },
      "fieldBorder": {
        "$value": "rgba(0, 40, 25, 0.68)",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed borderTopColor of #username on the sign-in wall"
        }
      },
      "onAccent": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured: computed color of Join now, Add to Order, and the Auth0 Sign in button"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "SoDoSans, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "Measured: computed fontFamily of body on www.starbucks.com. SoDoSans is proprietary; the guide uses the Helvetica fallback."
          }
        }
      },
      "weight": {
        "light": {
          "$value": 300,
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured: fontWeight of Start an order"
          }
        },
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured: fontWeight of body"
          }
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured: fontWeight of Join now, See the holiday menu, h1"
          }
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured: fontWeight of MENU and the product h1"
          }
        }
      }
    },
    "typography": {
      "body": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "24px",
          "letterSpacing": "-0.16px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed body style on www.starbucks.com"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "21px",
          "letterSpacing": "1.4px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of the MENU header link, text-transform uppercase"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "24px",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "33.6px",
          "letterSpacing": "-0.24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of the home h1 'Holiday flavors are in town!'"
        }
      },
      "display": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "36px",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "44px",
          "letterSpacing": "-0.36px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of the sign-in h1 Welcome back!"
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "{font.weight.semibold}",
          "lineHeight": "16.8px",
          "letterSpacing": "-0.16px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured: computed style of Join now and Sign in in the header"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: borderRadius of the MENU link and body"
        }
      },
      "field": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: borderRadius of #username on the sign-in wall"
        }
      },
      "pill": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: borderRadius of Join now, Sign in, and Start an order"
        }
      }
    },
    "space": {
      "button-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: padding-inline of Join now (7px 16px)"
        }
      },
      "button-y": {
        "$value": "7px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: padding-block of Join now"
        }
      },
      "field-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: padding-inline of #username"
        }
      },
      "order-x": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: padding-inline of Add to Order (18px 24px)"
        }
      }
    },
    "size": {
      "header": {
        "$value": "100px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: header getBoundingClientRect height on the home page at 1440"
        }
      },
      "button": {
        "$value": "33px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: Join now height"
        }
      },
      "field": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: #username height on the sign-in wall"
        }
      },
      "order": {
        "$value": "59px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: Add to Order height"
        }
      },
      "checkbox": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: keep-me-signed-in checkbox height"
        }
      }
    },
    "border": {
      "hairline": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: borderTopWidth of Join now and #username"
        }
      },
      "banner": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured: borderTopWidth of Start an order"
        }
      }
    },
    "shadow": {
      "order": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.24)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "6px",
            "spread": "0px"
          },
          {
            "color": "rgba(0, 0, 0, 0.14)",
            "offsetX": "0px",
            "offsetY": "8px",
            "blur": "12px",
            "spread": "0px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "Measured: boxShadow of Add to Order"
        }
      }
    },
    "layout": {
      "desktop": {
        "$value": "1440px",
        "$type": "dimension",
        "$extensions": {
          "source": "Requested and measured viewport width of desktop captures (innerWidth 1440)"
        }
      },
      "phone": {
        "$value": "390px",
        "$type": "dimension",
        "$extensions": {
          "source": "Requested viewport width of phone captures"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$value": "{color.white}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: body backgroundColor on www.starbucks.com"
        }
      },
      "brand": {
        "$value": "{color.green}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: home order strip and sign-in page background"
        }
      },
      "surface": {
        "$value": "{color.cream}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: home holiday panel background"
        }
      },
      "inverse": {
        "$value": "{color.greenDeep}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: Customize button fill; the product hero uses the same deep green family"
        }
      }
    },
    "text": {
      "primary": {
        "$value": "{color.black}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: body color on the home page"
        }
      },
      "ink": {
        "$value": "{color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: product body and Sign in label"
        }
      },
      "accent": {
        "$value": "{color.greenLink}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: See the holiday menu and Forgot your password?"
        }
      },
      "onBrand": {
        "$value": "{color.onAccent}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: color of text on the green order strip and green buttons"
        }
      },
      "heading": {
        "$value": "{color.green}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: home h1 color rgb(0, 98, 66)"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: border color of the Sign in pill"
        }
      },
      "accent": {
        "$value": "{color.greenLink}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: border color of See the holiday menu"
        }
      },
      "field": {
        "$value": "{color.fieldBorder}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: border color of the email field on the sign-in wall"
        }
      }
    },
    "action": {
      "primary": {
        "$value": "{color.black}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: Join now background"
        }
      },
      "brand": {
        "$value": "{color.greenLink}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: Add to Order and Auth0 Sign in backgrounds"
        }
      },
      "banner": {
        "$value": "{color.green}",
        "$type": "color",
        "$extensions": {
          "source": "Measured: Start an order background, which matches the strip"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.greenLink}",
        "$type": "color",
        "$extensions": {
          "source": "Not captured as a keyboard ring. The email field's computed box-shadow uses rgba(0, 117, 74, 0.23); a dedicated focus-visible ring was not isolated. Recorded as the accent, with this gap."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
