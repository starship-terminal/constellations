{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.eightsleep.com/sg/ 2026-11-22."
        }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. body color rgb(0, 0, 0). Promo bar and Shop the sale fill are the same black."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Shop the sale label and hero subcopy color rgb(255, 255, 255). Get up to $1,400 off fill is the same white."
        }
      },
      "gold": {
        "$value": "#e6be8c",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Promo bar text color rgb(230, 190, 140). Eyebrow gradient ends at the same gold."
        }
      },
      "gold-start": {
        "$value": "#fac78e",
        "$type": "color",
        "$extensions": {
          "source": "Measured. LIMITED TIME text fill starts at rgb(250, 199, 142)."
        }
      },
      "hero": {
        "$value": "#1f1712",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Homepage hero section backgroundColor rgb(31, 23, 18)."
        }
      },
      "compare": {
        "$value": "#696765",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Struck price $3,699 color rgb(105, 103, 101) on https://www.eightsleep.com/sg/product/pod-cover/."
        }
      },
      "badge": {
        "$value": "#e0cfbb",
        "$type": "color",
        "$extensions": {
          "source": "Measured. BLACK FRIDAY: $800 OFF badge backgroundColor rgb(224, 207, 187)."
        }
      }
    },
    "font": {
      "body": {
        "$value": "NeueMontreal, \"NeueMontreal Fallback\"",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. body, nav, buttons, product title, and prices. Font files are not in this package."
        }
      },
      "display": {
        "$value": "\"Bethany Elingston\", serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. Homepage BLACK FRIDAY headline. Font files are not in this package."
        }
      },
      "mono": {
        "$value": "\"IBM Plex Mono\", \"IBM Plex Mono Fallback\", monospace",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. LIMITED TIME eyebrow. Font files are not in this package."
        }
      }
    },
    "radius": {
      "button": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Shop the sale and Get up to $1,400 off border-radius 8px."
        }
      },
      "header": {
        "$value": "10px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Floating header glass border-radius 10px."
        }
      },
      "badge": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. BLACK FRIDAY: $800 OFF badge border-radius 4px."
        }
      }
    },
    "size": {
      "promo": {
        "$value": "42px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Promo bar height 42px, full 1440 width."
        }
      },
      "header": {
        "$value": "69px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Floating header glass height 69px, inset 32px from the viewport edges."
        }
      },
      "shop": {
        "$value": "41px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Shop the sale height 41px, width 132px."
        }
      },
      "get-off": {
        "$value": "57px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Get up to $1,400 off height 57px, width 219px."
        }
      },
      "display": {
        "$value": "120px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Hero headline font-size 120.007px, line-height 152.409px. Recorded as 120px."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "ink": { "$value": "{core.color.ink}", "$type": "color" },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color" },
      "gold": { "$value": "{core.color.gold}", "$type": "color" },
      "gold-start": { "$value": "{core.color.gold-start}", "$type": "color" },
      "hero": { "$value": "{core.color.hero}", "$type": "color" },
      "compare": { "$value": "{core.color.compare}", "$type": "color" },
      "badge": { "$value": "{core.color.badge}", "$type": "color" }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
