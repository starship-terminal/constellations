{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "display": {
        "$value": "Plus Jakarta Sans, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of the hero h1 on https://clickup.com/ at 1440"
        }
      },
      "body": {
        "$value": "Plus Jakarta Sans, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of body on https://clickup.com/"
        }
      },
      "nav": {
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of the Pricing link and the Sign Up button"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "60px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the visible hero h1 at 1440. Token --text-display-2xl is calc(.0625rem * 60)"
        }
      },
      "body": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of body. Token --text-md is calc(.0625rem * 16)"
        }
      },
      "nav": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the Pricing link"
        }
      }
    },
    "radius": {
      "nav": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of Login and Sign Up"
        }
      },
      "hero": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of Get Started. Token --radius-radius-12 is 12px"
        }
      },
      "xxs": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "custom property --border-radius-xxs on :root"
        }
      },
      "md": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "custom property --border-radius-md on :root"
        }
      }
    },
    "spacing": {
      "nav-x": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding of the Sign Up button"
        }
      },
      "nav-y": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed vertical padding of the Sign Up button"
        }
      },
      "hero-x": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding of Get Started"
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{fontSize.hero}",
          "fontWeight": "700",
          "lineHeight": "66px",
          "letterSpacing": "-2.1px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of the visible hero h1. The declared --text-display-2xl weight is 650; the painted heading computed 700"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.body}",
          "fontWeight": "400",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of body"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Background-Main. Body background computed transparent"
      }
    },
    "surface": {
      "$value": "#f8f9fa",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Background-Card"
      }
    },
    "text": {
      "$value": "#202020",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Text-Main. Hero computed rgb(32, 32, 32)"
      }
    },
    "muted": {
      "$value": "#646464",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Text-Secondary. Pricing link computed rgb(100, 100, 100)"
      }
    },
    "accent": {
      "$value": "#6647f0",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Accents-Purple. The primary marketing button is ink, not this purple"
      }
    },
    "border": {
      "$value": "#e8e8e8",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Border-Default"
      }
    },
    "button": {
      "primary": {
        "$value": "#202020",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color of Get Started, rgb(32, 32, 32). Token --Core-Button-Primary"
        }
      },
      "secondary": {
        "$value": "#f0f0f0",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color of the Login link, rgb(240, 240, 240). Token --Core-Button-Secondary"
        }
      },
      "on-primary": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of Get Started and Sign Up, rgb(255, 255, 255)"
        }
      }
    },
    "ink": {
      "$value": "#292d34",
      "$type": "color",
      "$extensions": {
        "source": "computed color of body, rgb(41, 45, 52). Token --color-slate-900 is #292d34"
      }
    },
    "success": {
      "$value": "#078d3b",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Utilities-Green"
      }
    },
    "danger": {
      "$value": "#f0382d",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Utilities-Red"
      }
    },
    "info": {
      "$value": "#0091ff",
      "$type": "color",
      "$extensions": {
        "source": "custom property --Core-Accents-Blue"
      }
    }
  }
}
