{
  "core": {
    "fontFamily": {
      "display": {
        "$value": "TT_Norms_Pro, -apple-system, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "measured computed font-family on h1.website-title (home, light, 1440); first family TT_Norms_Pro, a webfont the site loads. Not shipped in this package."
        }
      },
      "ui": {
        "$value": "TT_Norms_Pro, -apple-system, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "measured computed font-family on header nav and .website-btn (home, light, 1440)"
        }
      },
      "body": {
        "$value": "Inter, -apple-system, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "css @font-face family Inter (88 faces, woff2 from /packs/media/) plus the system stack the site names as fallback"
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontSize": "64px",
          "fontWeight": 600,
          "lineHeight": "70.4px"
        },
        "$extensions": {
          "source": "css-var --website-heading-1-font-size--desktop; derived --website-heading-1-font-size--desktop 64px * --website-heading-1-line-height 1.1; css-var --website-heading-1-font-weight"
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontSize": "48px",
          "fontWeight": 600,
          "lineHeight": "52.8px"
        },
        "$extensions": {
          "source": "css-var --website-heading-2-font-size--desktop; derived --website-heading-2-font-size--desktop 48px * --website-heading-2-line-height 1.1; css-var --website-heading-2-font-weight"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.display}",
          "fontSize": "32px",
          "fontWeight": 600,
          "lineHeight": "38.4px"
        },
        "$extensions": {
          "source": "css-var --website-heading-3-font-size--tablet; derived --website-heading-3-font-size--tablet 32px * --website-heading-3-line-height 1.2; css-var --website-heading-3-font-weight"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.ui}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "25.6px"
        },
        "$extensions": {
          "source": "css-var --website-paragraph-font-size; derived --website-paragraph-font-size 16px * --website-paragraph-line-height 1.6; not declared; paragraph uses the element default 400"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.ui}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "25.2px"
        },
        "$extensions": {
          "source": "css-var --website-subtitle-font-size--tablet; derived --website-subtitle-font-size--tablet 18px * --website-subtitle-line-height 1.4; css-var --website-subtitle-font-weight"
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.ui}",
          "fontSize": "12px",
          "fontWeight": 600,
          "lineHeight": "15.6px"
        },
        "$extensions": {
          "source": "css-var --website-caption-font-size; derived --website-caption-font-size 12px * --website-caption-line-height 1.3; css-var --website-caption-font-weight"
        }
      },
      "notes": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.ui}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "19.6px"
        },
        "$extensions": {
          "source": "css-var --website-notes-font-size; derived --website-notes-font-size 14px * --website-notes-line-height 1.4; css-var --website-notes-font-weight"
        }
      }
    },
