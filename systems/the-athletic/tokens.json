{
  "$schema": "https://design-tokens.org/schemas/tokens.schema.json",
  "core": {
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "nyt-cheltenham, georgia, 'times new roman', times, serif",
        "$extensions": {"source": "Measured: computed font-family on the article h1 and the subscribe h1, 2026-11-19"}
      },
      "slab": {
        "$type": "fontFamily",
        "$value": "RegularSlab, georgia, serif",
        "$extensions": {"source": "Measured: computed font-family on .About_PageTitle (About Us), @font-face AthleticRegularSlab-Bold.woff2"}
      },
      "ui": {
        "$type": "fontFamily",
        "$value": "nyt-franklin, helvetica, arial, sans-serif",
        "$extensions": {"source": "Measured: computed font-family on the nav link, trial button, about body and 404 copy"}
      },
      "story": {
        "$type": "fontFamily",
        "$value": "nyt-imperial, georgia, 'times new roman', times, serif",
        "$extensions": {"source": "Measured: computed font-family on the article body paragraph"}
      }
    },
    "typography": {
      "nav": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "14px", "fontWeight": 400, "letterSpacing": "0.25px", "lineHeight": "40px"},
        "$extensions": {"source": "Measured: .header-link computed style"}
      },
      "trial": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "14px", "fontWeight": 700, "letterSpacing": "0.25px", "lineHeight": "32px"},
        "$extensions": {"source": "Measured: Start a free trial computed style"}
      },
      "ui": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "16px", "fontWeight": 400, "lineHeight": "32px"},
        "$extensions": {"source": "Measured: search input computed style"}
      },
      "about-body": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "18px", "fontWeight": 400, "lineHeight": "18px"},
        "$extensions": {"source": "Measured: .About_Description"}
      },
      "story": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-imperial, georgia, 'times new roman', times, serif", "fontSize": "20px", "fontWeight": 400, "lineHeight": "30px"},
        "$extensions": {"source": "Measured: article body paragraph"}
      },
      "hero": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-cheltenham, georgia, 'times new roman', times, serif", "fontSize": "24px", "fontWeight": 500, "lineHeight": "28.8px"},
        "$extensions": {"source": "Measured: home hero headline line"}
      },
      "about-sub": {
        "$type": "typography",
        "$value": {"fontFamily": "RegularSlab, georgia, serif", "fontSize": "27px", "fontWeight": 400, "letterSpacing": "-0.135px", "lineHeight": "25.38px"},
        "$extensions": {"source": "Measured: .About_SubTitle"}
      },
      "league": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "28px", "fontWeight": 700, "lineHeight": "33.6px"},
        "$extensions": {"source": "Measured: .PageNav_PageTitle on /nfl"}
      },
      "not-found": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-franklin, helvetica, arial, sans-serif", "fontSize": "30px", "fontWeight": 400},
        "$extensions": {"source": "Measured: .NotFound_CardText"}
      },
      "subscribe": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-cheltenham, georgia, 'times new roman', times, serif", "fontSize": "36px", "fontWeight": 200, "lineHeight": "41.4px"},
        "$extensions": {"source": "Measured: subscribe page h1"}
      },
      "article": {
        "$type": "typography",
        "$value": {"fontFamily": "nyt-cheltenham, georgia, 'times new roman', times, serif", "fontSize": "40px", "fontWeight": 400, "lineHeight": "44px"},
        "$extensions": {"source": "Measured: .Article_Headline"}
      },
      "about": {
        "$type": "typography",
        "$value": {"fontFamily": "RegularSlab, georgia, serif", "fontSize": "42px", "fontWeight": 400, "letterSpacing": "-0.21px", "lineHeight": "39.48px"},
        "$extensions": {"source": "Measured: .About_PageTitle"}
      }
    },
    "radius": {
      "none": {"$type": "dimension", "$value": "0px", "$extensions": {"source": "Measured: search input and 404 card border-radius"}},
      "trial": {"$type": "dimension", "$value": "2px", "$extensions": {"source": "Measured: Start a free trial button"}},
      "plan": {"$type": "dimension", "$value": "3px", "$extensions": {"source": "Measured: subscribe plan label"}},
      "banner": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured: edition banner and Continue to checkout"}},
      "login": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured: Log In button"}},
      "pill": {"$type": "dimension", "$value": "32px", "$extensions": {"source": "Measured: comment pill"}},
      "edition": {"$type": "dimension", "$value": "100px", "$extensions": {"source": "Measured: International edition button"}}
    },
    "spacing": {
      "nav-x": {"$type": "dimension", "$value": "10px", "$extensions": {"source": "Measured: nav link padding 0px 10px"}},
      "plan": {"$type": "dimension", "$value": "14px", "$extensions": {"source": "Measured: plan label padding 14px 10px"}},
      "trial-x": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured: trial button padding 0px 16px"}},
      "article-x": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured: headline padding 0px 20px"}},
      "story-x": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured: article body padding 0px 24px"}},
      "not-found-top": {"$type": "dimension", "$value": "50px", "$extensions": {"source": "Measured: 404 root padding 50px 0px 100px"}},
      "nav": {"$type": "dimension", "$value": "60px", "$extensions": {"source": "Measured: primary nav height"}},
      "story-column": {"$type": "dimension", "$value": "722px", "$extensions": {"source": "Measured: article body width at innerWidth 1169"}},
      "about-column": {"$type": "dimension", "$value": "640px", "$extensions": {"source": "Measured: .About_Description max-width"}}
    },
    "motion": {
      "ribbon": {"$type": "duration", "$value": "100ms", "$extensions": {"source": "Measured: computed transition-duration 0.1s on .Ribbon_ScoreBlockLink"}},
      "edition": {"$type": "duration", "$value": "300ms", "$extensions": {"source": "Measured: computed transition-duration 0.3s on .ContentEdition_option"}},
      "ribbon-track": {"$type": "duration", "$value": "600ms", "$extensions": {"source": "Measured: computed transition-duration 0.6s on .Ribbon_BlocksInner"}},
      "fade": {
        "$type": "cubicBezier",
        "$value": [0, 0, 1, 1],
        "$extensions": {"source": "Derived: Modal_fadeIn and Modal_fadeOut keyframes set opacity only, with no timing function declared on the sampled rule"}
      }
    }
  },
  "light": {
    "page": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured: .root.legacy background-color rgb(255, 255, 255) and legacy --Gray10 #fff"}},
    "surface": {"$type": "color", "$value": "#f7f7f4", "$extensions": {"source": "Measured: score ribbon background rgb(247, 247, 244), legacy --Gray20"}},
    "text": {"$type": "color", "$value": "#121212", "$extensions": {"source": "Measured: article headline and body color rgb(18, 18, 18), legacy --Gray70"}},
    "muted": {"$type": "color", "$value": "#323232", "$extensions": {"source": "Measured: caption color rgb(50, 50, 50), legacy --Gray60"}},
    "accent": {"$type": "color", "$value": "#b72424", "$extensions": {"source": "Measured: Start a free trial background rgb(183, 36, 36), legacy --Red10 and --chalkRed"}},
    "border": {"$type": "color", "$value": "#c4c4c0", "$extensions": {"source": "Measured: comment pill border rgb(196, 196, 192), legacy --Gray40"}},
    "nav": {"$type": "color", "$value": "#1a1a1a", "$extensions": {"source": "Measured: primary nav and footer background rgb(26, 26, 26), legacy --Gray65"}},
    "nav-text": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured: nav link color rgb(255, 255, 255)"}},
    "secondary-nav": {"$type": "color", "$value": "#2b2b2b", "$extensions": {"source": "Measured: .DesktopNav_SecondaryNav background rgb(43, 43, 43), legacy --Gray62"}},
    "secondary-nav-text": {"$type": "color", "$value": "#dbdbd9", "$extensions": {"source": "Measured: secondary nav link color rgb(219, 219, 217), legacy --Gray35"}},
    "footer-link": {"$type": "color", "$value": "#c4c4c0", "$extensions": {"source": "Measured: footer link color rgb(196, 196, 192)"}},
    "ink": {"$type": "color", "$value": "#000000", "$extensions": {"source": "Measured: edition primary button and 404 copy, legacy --Gray80"}},
    "subscribe-text": {"$type": "color", "$value": "#363636", "$extensions": {"source": "Measured: subscribe body color rgb(54, 54, 54)"}},
    "plan-selected": {"$type": "color", "$value": "#267c30", "$extensions": {"source": "Measured: selected plan border rgb(38, 124, 48)"}},
    "plan-rest": {"$type": "color", "$value": "#dfdfdf", "$extensions": {"source": "Measured: unselected plan border rgb(223, 223, 223)"}},
    "plan-fill": {"$type": "color", "$value": "#f8f8f8", "$extensions": {"source": "Measured: selected plan background rgb(248, 248, 248)"}},
    "cta": {"$type": "color", "$value": "#121212", "$extensions": {"source": "Measured: Continue to checkout background rgb(18, 18, 18)"}},
    "scrim": {"$type": "color", "$value": "#000000a6", "$extensions": {"source": "Measured: search modal background rgba(0, 0, 0, 0.65)"}},
    "not-found": {"$type": "color", "$value": "#262627", "$extensions": {"source": "Measured: 404 root background rgb(38, 38, 39), legacy --Gray63"}},
    "banner": {"$type": "color", "$value": "#f0f0ee", "$extensions": {"source": "Measured: edition banner background rgb(240, 240, 238), legacy --Gray30"}},
    "link": {"$type": "color", "$value": "#386c92", "$extensions": {"source": "Declared: legacy --Link, and a var(--Link) probe resolved to rgb(56, 108, 146)"}},
    "focus": {"$type": "color", "$value": "#f0f0ee", "$extensions": {"source": "Measured: .Pill_Pill:focus-visible outline rgb(240, 240, 238)"}}
  },
  "dark": {
    "page": {"$type": "color", "$value": "#000000", "$extensions": {"source": "Declared, not painted: :root[data-theme=dark] --Gray10. The signed-out page was html[data-theme=legacy]"}},
    "surface": {"$type": "color", "$value": "#121212", "$extensions": {"source": "Declared, not painted: dark --Gray20"}},
    "text": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Declared, not painted: dark --Gray80"}},
    "muted": {"$type": "color", "$value": "#969693", "$extensions": {"source": "Declared, not painted: dark --Gray50"}},
    "accent": {"$type": "color", "$value": "#fd5757", "$extensions": {"source": "Declared, not painted: dark --Red"}},
    "border": {"$type": "color", "$value": "#52524f", "$extensions": {"source": "Declared, not painted: dark --Gray40"}},
    "link": {"$type": "color", "$value": "#94b4da", "$extensions": {"source": "Declared, not painted: dark --Link"}},
    "nav": {"$type": "color", "$value": "#121212", "$extensions": {"source": "Declared, not painted: dark --Gray20. The live nav is legacy #1a1a1a"}}
  },
  "$themes": [
    {"id": "light", "name": "legacy (painted)", "selectedTokenSets": {"core": "enabled", "light": "enabled"}},
    {"id": "dark", "name": "dark (declared)", "selectedTokenSets": {"core": "enabled", "dark": "enabled"}}
  ]
}
