{
  "color": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Photographed page fill. Body computed background was transparent.",
      "$extensions": {
        "source": "screenshot home-light-1440.png, body background rgba(0, 0, 0, 0)"
      }
    },
    "text": {
      "$value": "#000000",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle body color rgb(0, 0, 0)"
      }
    },
    "promo": {
      "$value": "#f3f3f3",
      "$type": "color",
      "$description": "Newsletter strip above the header.",
      "$extensions": {
        "source": "getComputedStyle promo section background rgb(243, 243, 243)"
      }
    },
    "header": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle header background rgb(255, 255, 255)"
      }
    },
    "on-photo": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Hero title and the phone wordmark over the photograph.",
      "$extensions": {
        "source": "getComputedStyle hero h1 color rgb(255, 255, 255)"
      }
    },
    "card-well": {
      "$value": "#f2f2f2",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle product card image background rgb(242, 242, 242)"
      }
    },
    "last-chance": {
      "$value": "#cf0b00",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle Last chance color rgb(207, 11, 0)"
      }
    },
    "footer-heading": {
      "$value": "#949494",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle footer column heading color rgb(148, 148, 148)"
      }
    },
    "muted": {
      "$value": "#757575",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle muted heading color rgb(117, 117, 117)"
      }
    },
    "focus": {
      "$value": "#757575",
      "$type": "color",
      "$extensions": {
        "source": "observed focus outline rgb(117, 117, 117) auto 2px"
      }
    },
    "disabled": {
      "$value": "#949494",
      "$type": "color",
      "$description": "Choose size, disabled until a size is picked. Not clicked.",
      "$extensions": {
        "source": "getComputedStyle CHOOSE SIZE background rgb(148, 148, 148)"
      }
    },
    "on-disabled": {
      "$value": "#d9d9d9",
      "$type": "color",
      "$extensions": {
        "source": "getComputedStyle CHOOSE SIZE color rgb(217, 217, 217)"
      }
    },
    "wordmark": {
      "$value": "#000000",
      "$type": "color",
      "$description": "Sprite symbol uses currentColor. Desktop header paints it black.",
      "$extensions": {
        "source": "icons/mark.svg fill currentColor, header class fill-current on white"
      }
    }
  },
  "font": {
    "body": {
      "$value": "Quadrant, quadrant, sans-serif",
      "$type": "fontFamily",
      "$extensions": {
        "source": "getComputedStyle body font-family"
      }
    },
    "mono": {
      "$value": "QuadrantMono, quadrantMono, monospace",
      "$type": "fontFamily",
      "$description": "Hero, about heading, footer column headings.",
      "$extensions": {
        "source": "getComputedStyle hero h1 and about h1 font-family"
      }
    },
    "sans": {
      "$value": "SansStories, sans-serif",
      "$type": "fontFamily",
      "$description": "Shop now and Choose size.",
      "$extensions": {
        "source": "getComputedStyle Shop now font-family, CSS variable --font-sans"
      }
    }
  },
  "fontSize": {
    "body": { "$value": "10px", "$type": "dimension", "$extensions": { "source": "getComputedStyle body font-size" } },
    "promo": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "getComputedStyle promo strip font-size" } },
    "card": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "getComputedStyle product card name font-size" } },
    "control": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "getComputedStyle Shop now font-size" } },
    "product": { "$value": "14px", "$type": "dimension", "$extensions": { "source": "getComputedStyle product h1 and price font-size" } },
    "footer-heading": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "getComputedStyle footer column heading font-size" } },
    "about": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "getComputedStyle about h1 font-size" } },
    "hero": { "$value": "34px", "$type": "dimension", "$extensions": { "source": "getComputedStyle homepage h1 font-size" } }
  },
  "fontWeight": {
    "regular": { "$value": "400", "$type": "fontWeight", "$extensions": { "source": "loaded faces SansStories 400, Quadrant 400, QuadrantMono 400" } }
  },
  "letterSpacing": {
    "control": { "$value": "0.96px", "$type": "dimension", "$extensions": { "source": "getComputedStyle Shop now and CHOOSE SIZE letter-spacing" } }
  },
  "lineHeight": {
    "body": { "$value": "15px", "$type": "dimension", "$extensions": { "source": "getComputedStyle body line-height" } },
    "hero": { "$value": "37.4px", "$type": "dimension", "$extensions": { "source": "getComputedStyle homepage h1 line-height" } },
    "about": { "$value": "26.4px", "$type": "dimension", "$extensions": { "source": "getComputedStyle about h1 line-height" } }
  },
  "radius": {
    "control": { "$value": "2px", "$type": "dimension", "$extensions": { "source": "getComputedStyle Shop now and CHOOSE SIZE border-radius" } }
  },
  "size": {
    "promo": { "$value": "34px", "$type": "dimension", "$extensions": { "source": "promo strip height, desktop" } },
    "promo-phone": { "$value": "52px", "$type": "dimension", "$extensions": { "source": "promo strip height, 390 CSS px" } },
    "header": { "$value": "72px", "$type": "dimension", "$extensions": { "source": "header height, desktop" } },
    "header-phone": { "$value": "64px", "$type": "dimension", "$extensions": { "source": "phone banner box height" } },
    "wordmark": { "$value": "100px", "$type": "dimension", "$description": "Rendered width. Height is 38px.", "$extensions": { "source": "logo getBoundingClientRect 100 by 38" } },
    "control": { "$value": "40px", "$type": "dimension", "$extensions": { "source": "Shop now and CHOOSE SIZE height" } },
    "size-chip": { "$value": "40px", "$type": "dimension", "$description": "Height. Width is 48px.", "$extensions": { "source": "size button getBoundingClientRect 48 by 40" } },
    "choose-size": { "$value": "382px", "$type": "dimension", "$extensions": { "source": "CHOOSE SIZE width, not clicked" } }
  }
}
