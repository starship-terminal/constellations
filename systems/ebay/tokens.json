{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.ebay.com/ 2026-11-22." }
      },
      "text": {
        "$value": "#191919",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(25, 25, 25)." }
      },
      "accent": {
        "$value": "#0968f6",
        "$type": "color",
        "$extensions": { "source": "Measured. Search button backgroundColor rgb(9, 104, 246). Matches --color-blue-500." }
      },
      "on-accent": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Search button color rgb(255, 255, 255)." }
      },
      "link": {
        "$value": "#0968f6",
        "$type": "color",
        "$extensions": { "source": "Measured. Sign in link color rgb(9, 104, 246)." }
      }
    },
    "font": {
      "ui": {
        "$value": "Market Sans, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily. Files are not in this package." }
      },
      "search": {
        "$value": "Helvetica Neue, Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. #gh-ac fontFamily." }
      }
    },
    "radius": {
      "pill": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search button borderRadius." }
      }
    },
    "size": {
      "search-button": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search button height." }
      },
      "body": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. body fontSize." }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled" } }
  ]
}
