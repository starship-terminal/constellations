{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$type": "color",
        "$value": "#121212",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-primary resolved on tpl-always-light"}}
      },
      "ink-dim": {
        "$type": "color",
        "$value": "#363636",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-primary-dim and computed body color rgb(54, 54, 54)"}}
      },
      "secondary": {
        "$type": "color",
        "$value": "#5a5a5a",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-secondary and summary color rgb(90, 90, 90)"}}
      },
      "secondary-dim": {
        "$type": "color",
        "$value": "#727272",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-secondary-dim and kicker rgb(114, 114, 114)"}}
      },
      "placeholder": {
        "$type": "color",
        "$value": "#8b8b8b",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-placeholder"}}
      },
      "strike": {
        "$type": "color",
        "$value": "#888888",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/subscription 2026-11-19", "note": "computed color on del, rgb(136, 136, 136)"}}
      },
      "billed": {
        "$type": "color",
        "$value": "#666666",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/subscription 2026-11-19", "note": "computed color on the billed-as line, rgb(102, 102, 102)"}}
      },
      "footer": {
        "$type": "color",
        "$value": "#767676",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://myaccount.nytimes.com/auth/login 2026-11-19", "note": "computed color on the copyright line, rgb(118, 118, 118)"}}
      },
      "search-ink": {
        "$type": "color",
        "$value": "#333333",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "search field color rgb(51, 51, 51) and search icon fill #333"}}
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-background-primary #fff and body background rgb(255, 255, 255)"}}
      },
      "paper": {
        "$type": "color",
        "$value": "#f8f8f8",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-background-secondary and the ad slot background rgb(248, 248, 248)"}}
      },
      "wash": {
        "$type": "color",
        "$value": "#ebebeb",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-background-tertiary"}}
      },
      "highlight": {
        "$type": "color",
        "$value": "#fefad1",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-background-highlight"}}
      },
      "hairline": {
        "$type": "color",
        "$value": "#dfdfdf",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-stroke-tertiary"}}
      },
      "card-line": {
        "$type": "color",
        "$value": "#dbdbdb",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/subscription 2026-11-19", "note": "unselected offer card border rgb(219, 219, 219)"}}
      },
      "stroke-mid": {
        "$type": "color",
        "$value": "#959595",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-stroke-secondary"}}
      },
      "accent": {
        "$type": "color",
        "$value": "#346eb7",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-accent, used by :focus-visible"}}
      },
      "accent-dim": {
        "$type": "color",
        "$value": "#326891",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-accent-dim and --color-signal-editorial"}}
      },
      "signal": {
        "$type": "color",
        "$value": "#2671dc",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--color-signal-accent. Not painted on the measured chrome."}}
      },
      "masthead": {
        "$type": "color",
        "$value": "#567b95",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "computed background of Subscribe and Log in spans, rgb(86, 123, 149)"}}
      },
      "masthead-border": {
        "$type": "color",
        "$value": "#326891",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "computed border of Subscribe and Log in, rgb(50, 104, 145)"}}
      },
      "positive": {
        "$type": "color",
        "$value": "#267c30",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-positive and the up-market figure rgb(38, 124, 48)"}}
      },
      "negative": {
        "$type": "color",
        "$value": "#a90111",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-negative. Not painted on the measured chrome."}}
      },
      "breaking": {
        "$type": "color",
        "$value": "#d0021b",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-content-breaking. Not painted on the measured chrome."}}
      },
      "developing": {
        "$type": "color",
        "$value": "#e6540a",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--color-signal-developing. Not painted on the measured chrome."}}
      },
      "scrim": {
        "$type": "color",
        "$value": "#12121299",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-color-background-scrim and dialog backdrop"}}
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "wordmark fill #000 and login body color rgb(0, 0, 0)"}}
      }
    },
    "font": {
      "family": {
        "cheltenham": {
          "$type": "fontFamily",
          "$value": "nyt-cheltenham, cheltenham-fallback-georgia, cheltenham-fallback-noto, georgia, Times New Roman, times, serif",
          "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-font-family-cheltenham"}}
        },
        "franklin": {
          "$type": "fontFamily",
          "$value": "nyt-franklin, helvetica, arial, sans-serif",
          "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-font-family-franklin"}}
        },
        "imperial": {
          "$type": "fontFamily",
          "$value": "nyt-imperial, georgia, Times New Roman, times, serif",
          "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "--tpl-font-family-imperial"}}
        }
      },
      "weight": {
        "light": {"$type": "fontWeight", "$value": 300, "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-font-weight-light and the 48px offer hero"}}},
        "regular": {"$type": "fontWeight", "$value": 400, "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-font-weight-regular"}}},
        "medium": {"$type": "fontWeight", "$value": 500, "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-font-weight-medium and section links"}}},
        "semibold": {"$type": "fontWeight", "$value": 600, "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-font-weight-semi-bold and Continue to checkout"}}},
        "bold": {"$type": "fontWeight", "$value": 700, "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-font-weight-bold, masthead labels, login Continue"}}}
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.cheltenham}", "fontWeight": "{core.font.weight.light}", "fontSize": "48px", "lineHeight": "52.8px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/subscription 2026-11-19", "note": "hero div.css-1msbfo0"}}
      },
      "headline": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.cheltenham}", "fontWeight": "{core.font.weight.bold}", "fontSize": "22px", "lineHeight": "25.3px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "lead story headline"}}
      },
      "feature": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.cheltenham}", "fontWeight": "{core.font.weight.light}", "fontSize": "24px", "lineHeight": "27.6px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "feature headline, font-weight 300"}}
      },
      "login-title": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.cheltenham}", "fontWeight": "{core.font.weight.regular}", "fontSize": "30px", "lineHeight": "40px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://myaccount.nytimes.com/auth/login 2026-11-19", "note": "h2 Log in or create an account"}}
      },
      "body": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.imperial}", "fontWeight": "{core.font.weight.regular}", "fontSize": "14px", "lineHeight": "19px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "story summary"}}
      },
      "ui": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.franklin}", "fontWeight": "{core.font.weight.medium}", "fontSize": "14px", "lineHeight": "18px", "letterSpacing": "0.1px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "section nav link"}}
      },
      "button": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.franklin}", "fontWeight": "{core.font.weight.semibold}", "fontSize": "16px", "lineHeight": "44px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/subscription 2026-11-19", "note": "Continue to checkout"}}
      },
      "masthead": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.franklin}", "fontWeight": "{core.font.weight.bold}", "fontSize": "11px", "lineHeight": "13px", "letterSpacing": "0.55px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "Subscribe and Log in spans, uppercase"}}
      },
      "kicker": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.franklin}", "fontWeight": "{core.font.weight.medium}", "fontSize": "10px", "lineHeight": "12px", "letterSpacing": "1px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "https://www.nytimes.com/ 2026-11-19", "note": "5 MIN READ, uppercase"}}
      }
    },
    "radius": {
      "none": {"$type": "dimension", "$value": "0px", "$extensions": {"source": {"evidence": "Measured", "note": "offer tabs and offer cards"}}},
      "control": {"$type": "dimension", "$value": "3px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-theme-button-shape and painted Subscribe, Log in, login field, login Continue"}}},
      "action": {"$type": "dimension", "$value": "4px", "$extensions": {"source": {"evidence": "Measured", "note": "Continue to checkout border-radius"}}},
      "badge": {"$type": "dimension", "$value": "20px", "$extensions": {"source": {"evidence": "Measured", "note": "BEST VALUE badge"}}},
      "icon": {"$type": "dimension", "$value": "9999px", "$extensions": {"source": {"evidence": "Declared", "note": "--tpl-theme-button-icon-button-shape. Not painted on these pages."}}},
      "radio": {"$type": "dimension", "$value": "8px", "$extensions": {"source": {"evidence": "Derived", "note": "offer radio border-radius 50%, measured, of its 16px box (core.size.radio, offer radio width and height): 8px, a circle"}}}
    },
    "spacing": {
      "4": {"$type": "dimension", "$value": "4px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-spacing-0-5 is .25rem"}}},
      "8": {"$type": "dimension", "$value": "8px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-spacing-1 is .5rem, and Subscribe padding 8px 12px"}}},
      "12": {"$type": "dimension", "$value": "12px", "$extensions": {"source": {"evidence": "Measured", "note": "Subscribe horizontal padding and login field padding-inline"}}},
      "16": {"$type": "dimension", "$value": "16px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-spacing-2 is 1rem"}}},
      "20": {"$type": "dimension", "$value": "20px", "$extensions": {"source": {"evidence": "Measured", "note": "offer card padding 20px 10px"}}},
      "24": {"$type": "dimension", "$value": "24px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-spacing-3 is 1.5rem"}}},
      "32": {"$type": "dimension", "$value": "32px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-spacing-4 and dialog padding 2rem"}}}
    },
    "borderWidth": {
      "hairline": {"$type": "dimension", "$value": "1px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-theme-button-border-width and painted 1px borders"}}},
      "rule": {"$type": "dimension", "$value": "2px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-size-border-2 is .125rem, and :focus-visible outline width"}}},
      "focus": {"$type": "dimension", "$value": "2px", "$extensions": {"source": {"evidence": "Measured", "note": ":focus-visible outline var(--tpl-size-border-2) solid var(--tpl-color-content-accent)"}}}
    },
    "size": {
      "button": {"$type": "dimension", "$value": "44px", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-theme-button-standard-height and painted Continue height"}}},
      "masthead-control": {"$type": "dimension", "$value": "29px", "$extensions": {"source": {"evidence": "Measured", "note": "Subscribe and Log in span height"}}},
      "field": {"$type": "dimension", "$value": "44px", "$extensions": {"source": {"evidence": "Measured", "note": "login email input height"}}},
      "radio": {"$type": "dimension", "$value": "16px", "$extensions": {"source": {"evidence": "Measured", "note": "offer radio width and height"}}}
    }
  },
  "light": {
    "background": {
      "page": {"$type": "color", "$value": "{core.color.white}", "$extensions": {"source": {"evidence": "Measured", "note": "body background rgb(255, 255, 255)"}}},
      "surface": {"$type": "color", "$value": "{core.color.paper}", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-color-background-secondary"}}},
      "action": {"$type": "color", "$value": "{core.color.ink}", "$extensions": {"source": {"evidence": "Measured", "note": "Continue and login Continue background rgb(18, 18, 18)"}}},
      "masthead": {"$type": "color", "$value": "{core.color.masthead}", "$extensions": {"source": {"evidence": "Measured", "note": "homepage Subscribe and Log in"}}}
    },
    "text": {
      "primary": {"$type": "color", "$value": "{core.color.ink}", "$extensions": {"source": {"evidence": "Measured", "note": "headlines and login title"}}},
      "secondary": {"$type": "color", "$value": "{core.color.secondary}", "$extensions": {"source": {"evidence": "Measured", "note": "summary and unselected edition"}}},
      "on-action": {"$type": "color", "$value": "{core.color.white}", "$extensions": {"source": {"evidence": "Measured", "note": "white label on black Continue and on the blue masthead buttons"}}}
    },
    "border": {
      "stroke": {"$type": "color", "$value": "{core.color.hairline}", "$extensions": {"source": {"evidence": "Measured", "note": "--tpl-color-stroke-tertiary"}}},
      "strong": {"$type": "color", "$value": "#000000", "$extensions": {"source": {"evidence": "Measured", "note": "login field wrap and search wrap, computed border 1px solid rgb(0, 0, 0)"}}},
      "focus": {"$type": "color", "$value": "{core.color.accent}", "$extensions": {"source": {"evidence": "Measured", "note": ":focus-visible outline colour"}}}
    },
    "component": {
      "button": {
        "bg": {"$type": "color", "$value": "{core.color.ink}", "$extensions": {"source": {"evidence": "Measured", "note": "Continue to checkout and login Continue"}}},
        "text": {"$type": "color", "$value": "{core.color.white}", "$extensions": {"source": {"evidence": "Measured", "note": "label on those buttons"}}},
        "radius": {"$type": "dimension", "$value": "{core.radius.action}", "$extensions": {"source": {"evidence": "Measured", "note": "checkout button is 4px; login Continue is 3px, recorded on core.radius.control"}}},
        "height": {"$type": "dimension", "$value": "{core.size.button}", "$extensions": {"source": {"evidence": "Measured"}}}
      },
      "mastheadButton": {
        "bg": {"$type": "color", "$value": "{core.color.masthead}", "$extensions": {"source": {"evidence": "Measured"}}},
        "text": {"$type": "color", "$value": "{core.color.white}", "$extensions": {"source": {"evidence": "Measured"}}},
        "radius": {"$type": "dimension", "$value": "{core.radius.control}", "$extensions": {"source": {"evidence": "Measured"}}},
        "height": {"$type": "dimension", "$value": "{core.size.masthead-control}", "$extensions": {"source": {"evidence": "Measured"}}}
      },
      "field": {
        "bg": {"$type": "color", "$value": "{core.color.white}", "$extensions": {"source": {"evidence": "Measured", "note": "login email input"}}},
        "text": {"$type": "color", "$value": "{core.color.black}", "$extensions": {"source": {"evidence": "Measured"}}},
        "radius": {"$type": "dimension", "$value": "{core.radius.control}", "$extensions": {"source": {"evidence": "Measured"}}},
        "height": {"$type": "dimension", "$value": "{core.size.field}", "$extensions": {"source": {"evidence": "Measured"}}}
      }
    }
  },
  "$themes": [
    {"id": "light", "name": "Light", "selectedTokenSets": {"core": "enabled", "light": "enabled"}}
  ]
}
