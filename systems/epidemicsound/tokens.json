{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "off-white": {
        "$type": "color",
        "$value": "#f1f0eb",
        "$extensions": {
          "source": "css-var --es-color-brand-off-white; painted page background"
        }
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "css-var --color-brand-black; painted text and primary fill"
        }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "css-var --color-brand-white; text on primary buttons"
        }
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#272727",
        "$extensions": {
          "source": "measured header Create free account hover background, home 1440"
        }
      },
      "secondary-fill": {
        "$type": "color",
        "$value": "rgba(61, 77, 116, 0.12)",
        "$extensions": {
          "source": "measured Contact sales and Log in button background"
        }
      },
      "ghost-hover": {
        "$type": "color",
        "$value": "rgba(61, 77, 116, 0.08)",
        "$extensions": {
          "source": "measured Music nav button hover background"
        }
      },
      "muted": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0.6)",
        "$extensions": {
          "source": "measured footer link color"
        }
      },
      "yellow": {
        "$type": "color",
        "$value": "#ffda40",
        "$extensions": {
          "source": "css-var --es-color-brand-yellow; declared brand, not a painted marketing fill on the captured pages"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#20afff",
        "$extensions": {
          "source": "css-var --es-color-misc-focused; declared. Public buttons painted a white 2px outline on focus, not this blue"
        }
      },
      "product-base": {
        "$type": "color",
        "$value": "#121418",
        "$extensions": {
          "source": "css-var --es-color-background-base; product dark palette, not the painted marketing page"
        }
      },
      "product-accent": {
        "$type": "color",
        "$value": "#ff82c2",
        "$extensions": {
          "source": "css-var --es-color-action-accent; product dark palette"
        }
      }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "Sebenta, Georgia, \"Times New Roman\", \"Noto Serif\", serif",
        "$extensions": {
          "source": "css-var --es-i-header-font-family; computed on h1"
        }
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, Arial, \"Helvetica Neue\", sans-serif",
        "$extensions": {
          "source": "css-var --es-i-text-font-family; computed on body and buttons"
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "80px",
          "fontWeight": 500,
          "lineHeight": "80px"
        },
        "$extensions": {
          "source": "measured h1 on / at 1440; family Sebenta weight 500"
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "64px",
          "fontWeight": 500,
          "lineHeight": "64px"
        },
        "$extensions": {
          "source": "css-var --es-heading-xl-font-size 4rem on body; weight from the display face"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "16px"
        },
        "$extensions": {
          "source": "measured body on / at 1440"
        }
      },
      "button-s": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "14px",
          "fontWeight": 600,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "measured header Create free account, class es-text-button-s"
        }
      },
      "button-m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "16px",
          "fontWeight": 600,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "measured Contact sales, class es-text-button-m"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.sans}",
          "fontSize": "14px",
          "fontWeight": 600,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "measured header Music button"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "css-var --es-radius-button on body is 0; marketing controls override to a pill"
        }
      },
      "medium": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "css-var --es-radius-medium"
        }
      },
      "large": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "css-var --es-radius-large on :root"
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "10000px",
        "$extensions": {
          "source": "measured border-radius on primary, secondary and nav buttons; .radii-override sets --es-radius-button to 10000px"
        }
      }
    },
    "size": {
      "button-s": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "source": "measured header Create free account height"
        }
      },
      "button-m": {
        "$type": "dimension",
        "$value": "56px",
        "$extensions": {
          "source": "measured Contact sales height"
        }
      },
      "nav": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "source": "measured Music nav button height"
        }
      },
      "header": {
        "$type": "dimension",
        "$value": "100px",
        "$extensions": {
          "source": "measured header height at 1440"
        }
      },
      "switch": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "source": "measured pricing billing switch width; height 24px"
        }
      }
    },
    "space": {
      "button-s-x": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "measured primary button padding-left"
        }
      },
      "button-s-y": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "measured primary button padding-top"
        }
      },
      "button-m-x": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": "measured Contact sales padding-left"
        }
      },
      "nav-x": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "measured Music button padding-left"
        }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "150ms",
        "$extensions": {
          "source": "measured button class duration-150; declared --animation-duration is 600ms and was not the control transition"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$extensions": {
          "source": "css-var --ease-out"
        }
      }
    },
    "focus": {
      "outline-width": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "measured focus outline on header Create free account"
        }
      },
      "outline-color": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "measured focus outline color on the black primary button"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{core.color.off-white}",
        "$extensions": {
          "source": "painted body background rgb(241, 240, 235)"
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "measured nav panel and pricing card fill"
        }
      },
      "header": {
        "$type": "color",
        "$value": "rgba(0, 0, 0, 0)",
        "$extensions": {
          "source": "measured header background; the bar reads as a white pill over the page"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{core.color.black}",
        "$extensions": {
          "source": "measured body and h1 color"
        }
      },
      "muted": {
        "$type": "color",
        "$value": "{core.color.muted}",
        "$extensions": {
          "source": "measured footer link color"
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "{core.color.white}",
        "$extensions": {
          "source": "measured primary button text"
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "{core.color.black}",
        "$extensions": {
          "source": "computed border color on text; most controls use fill, not a stroke"
        }
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{core.color.black}",
        "$extensions": {
          "source": "measured Create free account background"
        }
      },
      "primary-hover": {
        "$type": "color",
        "$value": "{core.color.ink-soft}",
        "$extensions": {
          "source": "measured Create free account hover background"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "{core.color.secondary-fill}",
        "$extensions": {
          "source": "measured Contact sales background"
        }
      },
      "ghost-hover": {
        "$type": "color",
        "$value": "{core.color.ghost-hover}",
        "$extensions": {
          "source": "measured Music button hover background"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{core.color.black}",
      "$extensions": {
        "source": "the public site uses black as the only strong fill; brand yellow is declared and not used as a marketing accent on the captured pages"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
