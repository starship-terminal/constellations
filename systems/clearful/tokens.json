  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme clearful.com paints. The Webflow stylesheet declares no dark class and no prefers-color-scheme rule."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
