          "$value": "Literatatt, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "css-var --secondary-font-family (light)"
          },
          "$description": "Display face. Literatatt is self-hosted; the style guide falls back to a serif."
        }
      }
