     "lineHeight": "75px",
     "fontWeight": 400,
     "letterSpacing": "0em"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed type of hero-title default (raw/components-computed.json); the 60px Sharp Grotesk hero"
    }
   },
   "title": {
    "$value": {
     "fontFamily": "{font.family.display}",
     "fontSize": "50px",
     "lineHeight": "62.5px",
     "fontWeight": 400,
     "letterSpacing": "0em"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed type of pricing-title default (raw/components-computed.json); the 50px pricing heading"
    }
   },
   "ui": {
    "$value": {
     "fontFamily": "{font.family.ui}",
     "fontSize": "14px",
     "lineHeight": "16px",
     "fontWeight": 500,
     "letterSpacing": "0.16px"
