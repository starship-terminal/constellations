    }
   },
   "login": {
    "$value": {
     "fontFamily": "{font.family.login}",
     "fontSize": "20px",
     "lineHeight": "28px",
     "fontWeight": 400,
     "letterSpacing": "0em"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed type of login-title default (raw/components-computed.json); the 20px login heading"
    }
