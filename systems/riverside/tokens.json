    "measured": {
      "cta-fill": {
        "$value": "#1d1d1d",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of nav-cta default (raw/components-computed.json)"
        },
        "$description": "The black Start for Free pill."
      },
      "cta-text": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of nav-cta default (raw/components-computed.json)"
        },
        "$description": "White label on the black pill."
      },
      "focus-ring": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of nav-link focus-visible (raw/components-computed.json)"
        },
        "$description": "Keyboard focus ring on the Pricing link, if one paints."
      },
      "field-fill": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of newsletter-field default (raw/components-computed.json)"
        },
        "$description": "The blog email field fill."
      },
      "login-field": {
        "$value": "#222222",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of login-email default (raw/components-computed.json)"
        },
        "$description": "The login email field fill."
      }
    },
    "font": {
      "family": {
        "display": {
          "$value": "\"Sharp Grotesk\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json); @font-face Sharp Grotesk in raw/css-vars.json"
          },
          "$description": "Marketing display headings."
        },
        "ui": {
          "$value": "\"Instrument Sans\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of nav-link and header (raw/components-computed.json); @font-face Instrument Sans in raw/css-vars.json"
          },
          "$description": "Marketing UI and body."
        },
        "login": {
          "$value": "Inter, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of login-email default (raw/components-computed.json)"
          },
          "$description": "The login wall uses Inter, not Instrument Sans."
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "60px",
          "lineHeight": "75px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of hero-title default (raw/components-computed.json); the 60px Sharp Grotesk hero"
        }
      },
      "title": {
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "50px",
          "lineHeight": "62.5px",
          "fontWeight": 400,
          "letterSpacing": "0em"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of pricing-title default (raw/components-computed.json); the 50px pricing heading"
        }
      },
