  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme riverside.com paints; no dark class or attribute is bound on the captured routes."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
