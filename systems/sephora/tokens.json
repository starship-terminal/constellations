{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.sephora.com/ 2026-11-22." }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(0, 0, 0). Wordmark fill is the same black. CSS var --color-black is #000." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo bar text and department nav text rgb(255, 255, 255)." }
      },
      "promo": {
        "$value": "#510282",
        "$type": "color",
        "$extensions": { "source": "Measured. App Exclusive promo bar backgroundColor rgb(81, 2, 130)." }
      },
      "nav": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. Department bar backgroundColor rgb(0, 0, 0), 44px." }
      },
      "search": {
        "$value": "#f6f6f8",
        "$type": "color",
        "$extensions": { "source": "Measured. Search field backgroundColor rgb(246, 246, 248). CSS var --color-nearWhite is #f6f6f8." }
      },
      "bag": {
        "$value": "#cf112c",
        "$type": "color",
        "$extensions": { "source": "Measured. Add to Basket backgroundColor rgb(207, 17, 44) on the rhode Pocket Blush page. CSS var --color-red is #cf112c." }
      },
      "link": {
        "$value": "#136bea",
        "$type": "color",
        "$extensions": { "source": "Declared. :root --color-link #136BEA. Not sampled from a painted link in this pass." }
      }
    },
    "font": {
      "body": {
        "$value": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily. CSS var --font-family-base. Files are not in this package." }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search border-radius 9999px. CSS var --rounded-full. Add to Basket computed 99999px, the same pill." }
      },
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Promo bar and department bar border-radius 0px." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "ink": { "$value": "{core.color.ink}", "$type": "color" },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color" },
      "promo": { "$value": "{core.color.promo}", "$type": "color" },
      "nav": { "$value": "{core.color.nav}", "$type": "color" },
      "search": { "$value": "{core.color.search}", "$type": "color" },
      "bag": { "$value": "{core.color.bag}", "$type": "color" },
      "link": { "$value": "{core.color.link}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
