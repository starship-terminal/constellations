      "lineHeight": {
        "display-hero": {
          "$value": "88px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Hero display leading (88px on 88px)."
        },
        "display": {
          "$value": "82px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of contact-h1 default (raw/components-computed.json)"
          },
          "$description": "Display leading (82px on 72px)."
        },
        "h2": {
          "$value": "66px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of section-h2 default (raw/components-computed.json)"
          },
          "$description": "Heading leading (66px on 56px)."
        },
        "card-title": {
          "$value": "42px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of plan-card default (raw/components-computed.json)"
          },
          "$description": "Card-title leading (42px on 32px)."
        },
        "h4": {
          "$value": "33.6px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of blog-card default (raw/components-computed.json)"
          },
          "$description": "Heading-4 leading (33.6px on 24px)."
        },
        "body": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of dd-link default (raw/components-computed.json)"
          },
          "$description": "Body leading (24px on 16px)."
        },
        "lede": {
          "$value": "22px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Lede leading (22px on 14px)."
        },
        "badge": {
          "$value": "22px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of saving-badge default (raw/components-computed.json)"
          },
          "$description": "Badge leading (22px on 12px)."
        }
      }
