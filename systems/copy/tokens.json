        "link": {
          "$value": "#5753c6",
          "$type": "color",
          "$extensions": {
            "source": "computed color of auth-signup default (raw/components-computed.json)"
          },
          "$description": "The auth host's #5753c6 link purple (Sign up, Terms)."
        }
      },
      "neutral": {
        "ink": {
          "$value": "#171717",
          "$type": "color",
          "$extensions": {
            "source": "css-var --colors--primary-black (light); css-var --colors--primary-black resolved light (raw/css-vars.json)"
