{
  "core": {
    "font": {
      "family": {
        "display": {
          "$value": "\"ABC Normal\", sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json); the @font-face blocks are served from cdn.prod.website-files.com (raw/css-vars.json fonts)"
          },
          "$description": "The display family: ABC Normal (licensed, not distributed), falling back to sans."
        },
        "sans": {
          "$value": "Inter, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of btn-nav default (raw/components-computed.json)"
          },
          "$description": "The UI family: Inter, falling back to sans."
        },
        "auth": {
          "$value": "interFont, \"interFont Fallback\", -apple-system, \"system-ui\", \"Segoe UI (Custom)\", Roboto, \"Helvetica Neue\", \"Open Sans (Custom)\", system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of auth-continue default (raw/components-computed.json)"
          },
          "$description": "The auth host's stack (login.copy.ai): its own interFont bundle then system sans."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Body and small weight (400)."
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of dd-link default (raw/components-computed.json)"
          },
          "$description": "The 500 weight on nav items, controls and prices."
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "The 600 weight on display headings."
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The 700 weight on button labels and the contact display."
        }
      },
      "size": {
        "display-hero": {
          "$value": "88px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The 88px hero display (home)."
        },
        "display": {
          "$value": "72px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of contact-h1 default (raw/components-computed.json)"
