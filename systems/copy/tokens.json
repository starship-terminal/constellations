    "color": {
      "brand": {
        "purple": {
          "$value": "#693ee0",
          "$type": "color",
          "$extensions": {
            "source": "css-var --colors--primary-purple (light); css-var --colors--primary-purple resolved light (raw/css-vars.json)"
          },
          "$description": "The Copy.ai purple #693ee0 — declared as --colors--primary-purple, painted by the nav CTA, plan prices, the SAVING badge and the auth Continue."
        },
        "purple-light": {
          "$value": "#a284ff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --colors--light-purple (light); css-var --colors--light-purple resolved light (raw/css-vars.json)"
          },
          "$description": "The declared light purple #a284ff (--colors--light-purple)."
        },
        "purple-hover": {
          "$value": "#5b36c3",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of auth-continue hover (raw/components-computed.json)"
          },
          "$description": "The auth host's #5b36c3 hover step on Continue with email."
        },
        "purple-pressed": {
          "$value": "#4e22b1",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of auth-continue pressed (raw/components-computed.json)"
