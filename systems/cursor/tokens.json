{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#14120b",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-bg declared #14120b"
        }
      },
      "fg": {
        "$value": "#edecec",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-fg declared #edecec"
        }
      },
      "fg02": {
        "$value": "#d7d6d5",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-fg-02 declared #d7d6d5"
        }
      },
      "accent": {
        "$value": "#f54e00",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-accent declared #f54e00"
        }
      },
      "card": {
        "$value": "#1b1913",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-hex declared #1b1913"
        }
      },
      "card01": {
        "$value": "#1d1b15",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-01-hex declared #1d1b15"
        }
      },
      "card02": {
        "$value": "#201e18",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-02-hex declared #201e18"
        }
      },
      "card03": {
        "$value": "#26241e",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-03-hex declared #26241e"
        }
      },
      "card04": {
        "$value": "#2b2923",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-04-hex declared #2b2923"
        }
      },
      "cardHover": {
        "$value": "#201e18",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-card-hover-hex declared #201e18"
        }
      },
      "ansiGreen": {
        "$value": "#1f8a65",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-product-ansi-green declared #1f8a65"
        }
      },
      "ansiRed": {
        "$value": "#cf2d56",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-theme-product-ansi-red declared #cf2d56"
        }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-black declared #000"
        }
      },
      "paper": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-white declared #fff"
        }
      }
    },
    "font": {
      "family": {
        "ui": {
          "$value": "CursorGothic, \"CursorGothic Fallback\", system-ui, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body and h1 at 1440. The site serves CursorGothic. It is not included."
          }
        },
        "display": {
          "$value": "\"cursorDisplay\", system-ui, Helvetica Neue, Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "css-var --font-cursor-display"
          }
        }
      }
    },
    "radius": {
      "2xs": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --radius-2xs declared 2px"
        }
      },
      "xs": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --radius-xs declared 4px"
        }
      },
      "sm": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from --radius-sm .25rem at 16px"
        }
      },
      "md": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --radius-md declared 8px, also --border-radius"
        }
      },
      "lg": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from --radius-lg .5rem at 16px"
        }
      },
      "xl": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from --radius-xl .75rem at 16px"
        }
      },
      "2xl": {
        "$value": "1rem",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --radius-2xl declared 1rem"
        }
      },
      "3xl": {
        "$value": "1.5rem",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --radius-3xl declared 1.5rem"
        }
      },
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the nav Download link was a pill (3.35544e+07px). Stored as 9999px."
        }
      }
    },
    "space": {
      "buttonX": {
        "$value": "10.5px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding on the nav Download link"
        }
      },
      "buttonY": {
        "$value": "5.6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed top padding on the nav Download link"
        }
      }
    },
    "typography": {
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed body style at 1440. Matches --text-base 1rem and line-height 1.5."
        }
      },
      "hero": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "26px",
          "fontWeight": "400",
          "lineHeight": "32.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the homepage h1 at 1440. The painted hero is 26px, not the display scale."
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "20px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed font-size and weight on the nav Download link. Line height was not isolated."
        }
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "page": {
          "$value": "{core.color.page}",
          "$type": "color",
          "$extensions": {
            "source": "computed body background rgb(20, 18, 11), matching --color-theme-bg"
          }
        },
        "card": {
          "$value": "{core.color.card}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-card-hex #1b1913"
          }
        },
        "elevated": {
          "$value": "{core.color.card02}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-card-02-hex #201e18, also --color-theme-card-hover-hex"
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{core.color.fg}",
          "$type": "color",
          "$extensions": {
            "source": "computed body color rgb(237, 236, 236), matching --color-theme-fg"
          }
        },
        "secondary": {
          "$value": "{core.color.fg02}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-fg-02 #d7d6d5. --color-theme-text-sec is a 60% mix and was not resolved."
          }
        }
      },
      "action": {
        "fill": {
          "$value": "{core.color.fg}",
          "$type": "color",
          "$extensions": {
            "source": "computed background of the nav Download link, rgb(237, 236, 236)"
          }
        },
        "onFill": {
          "$value": "{core.color.page}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of the nav Download link, rgb(20, 18, 11)"
          }
        },
        "accent": {
          "$value": "{core.color.accent}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-accent #f54e00"
          }
        }
      },
      "status": {
        "success": {
          "$value": "{core.color.ansiGreen}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-product-ansi-green #1f8a65"
          }
        },
        "danger": {
          "$value": "{core.color.ansiRed}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-theme-product-ansi-red #cf2d56"
          }
        },
        "warning": {
          "$value": "{core.color.accent}",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-warning aliases --color-theme-accent"
          }
        }
      }
    },
    "component": {
      "buttonPrimary": {
        "radius": {
          "$value": "{core.radius.pill}",
          "$type": "dimension",
          "$extensions": {
            "source": "computed border-radius on the nav Download link, a pill"
          }
        },
        "height": {
          "$value": "27px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of the nav Download link, 27.4688px, rounded"
          }
        },
        "padding": {
          "$value": "5.6px 10.5px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed padding of the nav Download link"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "Dark",
      "selectedTokenSets": {
        "core": "source",
        "dark": "enabled"
      }
    }
  ]
}
