{
  "core": {
    "color": {
      "ink": {
        "$value": "#0b1215",
        "$type": "color",
        "$description": "Near-black ink on green buttons and form text.",
        "$extensions": {
          "source": "computed color of the Sign Up button and the login Sign In button, 2026-11-21"
        }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Hero ink and the promo bar fill.",
        "$extensions": {
          "source": "computed color of the home h1, and a flat fill of the promo bar in about-light-video.png before quantize"
        }
      },
      "paper": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Page and control paper.",
        "$extensions": {
          "source": "computed background of the login email field and the Continue with Google button"
        }
      },
      "canvas": {
        "$value": "#f4f4f4",
        "$type": "color",
        "$description": "Login page canvas.",
        "$extensions": {
          "source": "computed backgroundColor of the body on /en/login"
        }
      },
      "footer": {
        "$value": "#020404",
        "$type": "color",
        "$description": "Footer fill. Sampled, not a declared token.",
        "$extensions": {
          "source": "sampled flat fill of the footer in about-light-video.png at (40, 850) before quantize"
        }
      },
      "green": {
        "$value": "#55da9b",
        "$type": "color",
        "$description": "Primary action fill.",
        "$extensions": {
          "source": "computed backgroundColor of the header Sign Up button and the login Sign In button"
        }
      },
      "green-hover": {
        "$value": "#50cf93",
        "$type": "color",
        "$description": "Primary action hover fill.",
        "$extensions": {
          "source": "computed backgroundColor of the Sign Up button with CDP forcePseudoState hover"
        }
      },
      "link": {
        "$value": "#5620c1",
        "$type": "color",
        "$description": "Link and focus purple.",
        "$extensions": {
          "source": "computed color of Continue with email and the login Sign up link"
        }
      },
      "line": {
        "$value": "#dcdee1",
        "$type": "color",
        "$description": "Field and search hairline.",
        "$extensions": {
          "source": "computed borderTopColor of the search box and the login email field"
        }
      },
      "line-strong": {
        "$value": "#394649",
        "$type": "color",
        "$description": "Social button border.",
        "$extensions": {
          "source": "computed borderTopColor of the Continue with Google button"
        }
      },
      "muted": {
        "$value": "#555555",
        "$type": "color",
        "$description": "Help search text. Help Center only.",
        "$extensions": {
          "source": "computed color of the Help Center search input"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "\"GT Walsheim Pro\", Arial, sans-serif",
          "$type": "fontFamily",
          "$description": "Marketing and product UI stack. The face is served, not bundled.",
          "$extensions": {
            "source": "computed fontFamily of the Sign Up button; @font-face src https://static.skillshare.com/assets/fonts/gt-walsheim-pro/"
          }
        }
      },
      "size": {
        "hero": {
          "$value": "46px",
          "$type": "dimension",
          "$description": "Home hero.",
          "$extensions": {
            "source": "computed fontSize of the home h1"
          }
        },
        "teams-hero": {
          "$value": "50px",
          "$type": "dimension",
          "$description": "Teams hero.",
          "$extensions": {
            "source": "computed fontSize of the teams h1"
          }
        },
        "help-title": {
          "$value": "36px",
          "$type": "dimension",
          "$description": "Help Center title.",
          "$extensions": {
            "source": "computed fontSize of the Help Center h1"
          }
        },
        "button": {
          "$value": "18px",
          "$type": "dimension",
          "$description": "Primary button label.",
          "$extensions": {
            "source": "computed fontSize of the Sign Up button"
          }
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$description": "Social button label.",
          "$extensions": {
            "source": "computed fontSize of Continue with Google"
          }
        },
        "nav": {
          "$value": "15px",
          "$type": "dimension",
          "$description": "Header nav.",
          "$extensions": {
            "source": "computed fontSize of the Browse trigger"
          }
        },
        "field": {
          "$value": "15px",
          "$type": "dimension",
          "$description": "Login field.",
          "$extensions": {
            "source": "computed fontSize of the login email field"
          }
        }
      },
      "weight": {
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$description": "Headings and actions.",
          "$extensions": {
            "source": "computed fontWeight of the home h1 and the Sign Up button"
          }
        },
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$description": "Field text.",
          "$extensions": {
            "source": "computed fontWeight of the login email field"
          }
        }
      },
      "line-height": {
        "hero": {
          "$value": "57.96px",
          "$type": "dimension",
          "$description": "Home hero line height.",
          "$extensions": {
            "source": "computed lineHeight of the home h1"
          }
        },
        "button": {
          "$value": "39px",
          "$type": "dimension",
          "$description": "Button line height.",
          "$extensions": {
            "source": "computed lineHeight of the Sign Up button"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$value": "4px",
        "$type": "dimension",
        "$description": "Shared control radius.",
        "$extensions": {
          "source": "computed borderRadius of the Sign Up button, search box, and login email field"
        }
      }
    },
    "size": {
      "header": {
        "$value": "80px",
        "$type": "dimension",
        "$description": "Desktop header.",
        "$extensions": {
          "source": "measured height of the painted header bar on the home page"
        }
      },
      "button": {
        "$value": "40px",
        "$type": "dimension",
        "$description": "Primary button.",
        "$extensions": {
          "source": "computed height of the Sign Up button and the login Sign In button"
        }
      },
      "search": {
        "$value": "40px",
        "$type": "dimension",
        "$description": "Search field.",
        "$extensions": {
          "source": "computed height of the search combobox"
        }
      },
      "social": {
        "$value": "40px",
        "$type": "dimension",
        "$description": "Home social button. The login page social buttons measure 55px.",
        "$extensions": {
          "source": "computed height of Continue with Google on the home page"
        }
      }
    },
    "border": {
      "width": {
        "$value": "1px",
        "$type": "dimension",
        "$description": "Control border.",
        "$extensions": {
          "source": "computed borderTopWidth of the Sign Up button and the search box"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "{core.color.paper}",
      "$type": "color",
      "$description": "Page paper.",
      "$extensions": {
        "source": "alias of core.color.paper"
      }
    },
    "surface": {
      "$value": "{core.color.canvas}",
      "$type": "color",
      "$description": "Login canvas.",
      "$extensions": {
        "source": "alias of core.color.canvas"
      }
    },
    "text": {
      "$value": "{core.color.ink}",
      "$type": "color",
      "$description": "Button and form ink.",
      "$extensions": {
        "source": "alias of core.color.ink"
      }
    },
    "muted": {
      "$value": "{core.color.muted}",
      "$type": "color",
      "$description": "Help search text.",
      "$extensions": {
        "source": "alias of core.color.muted"
      }
    },
    "accent": {
      "$value": "{core.color.green}",
      "$type": "color",
      "$description": "Primary action.",
      "$extensions": {
        "source": "alias of core.color.green"
      }
    },
    "border": {
      "$value": "{core.color.line}",
      "$type": "color",
      "$description": "Field hairline.",
      "$extensions": {
        "source": "alias of core.color.line"
      }
    },
    "link": {
      "$value": "{core.color.link}",
      "$type": "color",
      "$description": "Link purple.",
      "$extensions": {
        "source": "alias of core.color.link"
      }
    },
    "focus": {
      "$value": "#5620c1",
      "$type": "color",
      "$description": "Focus ring. Same purple as links.",
      "$extensions": {
        "source": "computed outline of the Sign Up button with CDP forcePseudoState focus-visible: rgb(86, 32, 193) auto 1px"
      }
    },
    "component": {
      "button": {
        "background": {
          "$value": "{core.color.green}",
          "$type": "color",
          "$description": "Sign Up and login Sign In fill.",
          "$extensions": {
            "source": "alias of core.color.green"
          }
        },
        "text": {
          "$value": "{core.color.ink}",
          "$type": "color",
          "$description": "Sign Up label.",
          "$extensions": {
            "source": "alias of core.color.ink"
          }
        },
        "radius": {
          "$value": "4px",
          "$type": "dimension",
          "$description": "Button radius.",
          "$extensions": {
            "source": "computed borderRadius of the Sign Up button"
          }
        },
        "height": {
          "$value": "40px",
          "$type": "dimension",
          "$description": "Button height.",
          "$extensions": {
            "source": "computed height of the Sign Up button"
          }
        }
      },
      "button-hover": {
        "background": {
          "$value": "{core.color.green-hover}",
          "$type": "color",
          "$description": "Sign Up hover fill.",
          "$extensions": {
            "source": "alias of core.color.green-hover"
          }
        }
      },
      "field": {
        "background": {
          "$value": "{core.color.paper}",
          "$type": "color",
          "$description": "Email field fill.",
          "$extensions": {
            "source": "alias of core.color.paper"
          }
        },
        "text": {
          "$value": "{core.color.ink}",
          "$type": "color",
          "$description": "Email field text.",
          "$extensions": {
            "source": "alias of core.color.ink"
          }
        },
        "border": {
          "$value": "{core.color.line}",
          "$type": "color",
          "$description": "Email field border.",
          "$extensions": {
            "source": "alias of core.color.line"
          }
        },
        "radius": {
          "$value": "4px",
          "$type": "dimension",
          "$description": "Field radius.",
          "$extensions": {
            "source": "computed borderRadius of the login email field"
          }
        },
        "height": {
          "$value": "40px",
          "$type": "dimension",
          "$description": "Field height.",
          "$extensions": {
            "source": "computed height of the login email field"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
