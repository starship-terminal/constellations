{
  "$description": "Scale public marketing (scale.com) and the signed-out dashboard login (dashboard.scale.com/login), measured 2026-11-19. Every value is a computed style or a custom property resolved on :root. No dark theme was on the page.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "aeonik, \"aeonik Fallback\", ui-sans-serif, system-ui, sans-serif",
          "$description": "Computed font-family on body at scale.com.",
          "$extensions": {"source": "Measured. https://scale.com/ body font-family, 2026-11-19."}
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "mono, \"mono Fallback\", ui-monospace, monospace",
          "$description": "Computed font-family on uppercase eyebrows. The page's own stack stops at 'mono Fallback'; the generic tail is the usual fallback and is labelled derived.",
          "$extensions": {"source": "Measured family 'mono' on eyebrow text. Generic tail derived."}
        },
        "login": {
          "$type": "fontFamily",
          "$value": "Inter, -apple-system, Arial, sans-serif",
          "$description": "Computed font-family on the dashboard login page. A different product surface from the marketing site.",
          "$extensions": {"source": "Measured. https://dashboard.scale.com/login body font-family."}
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "64px",
          "fontWeight": "400",
          "lineHeight": "1.05",
          "letterSpacing": "-0.01em"
        },
        "$description": "Home h2. Computed 64px / 67.2px / -0.64px.",
        "$extensions": {"source": "Measured. scale.com h2 'The world's most important decisions need reliable AI systems.'"}
      },
      "stat": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "64px",
          "fontWeight": "400",
          "lineHeight": "1",
          "letterSpacing": "-0.01em"
        },
        "$description": "Home stat line. Computed 64px / 64px / -0.64px.",
        "$extensions": {"source": "Measured. scale.com p '90% of the world's'."}
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "40px",
          "fontWeight": "400",
          "lineHeight": "1.25",
          "letterSpacing": "-0.01em"
        },
        "$description": "Demo page h1. Computed 40px / 50px / -0.4px, color #212121.",
        "$extensions": {"source": "Measured. https://scale.com/demo h1 'Let's Scale Together'."}
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.5",
          "letterSpacing": "-0.01em"
        },
        "$description": "Demo lede. Computed 16px / 24px / -0.16px.",
        "$extensions": {"source": "Measured. scale.com/demo lede paragraph."}
      },
      "body-loose": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.5",
          "letterSpacing": "0em"
        },
        "$description": "Body default. Computed 16px / 24px, letter-spacing normal.",
        "$extensions": {"source": "Measured. scale.com body."}
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "1",
          "letterSpacing": "0em"
        },
        "$description": "Header nav buttons. Computed 14px / 14px.",
        "$extensions": {"source": "Measured. scale.com header button 'Products'."}
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.mono}",
          "fontSize": "11px",
          "fontWeight": "400",
          "lineHeight": "1",
          "letterSpacing": "0.05em"
        },
        "$description": "Card eyebrows. Computed 11px / 11px / 0.55px, uppercase.",
        "$extensions": {"source": "Measured. scale.com eyebrow 'COMPANY'."}
      },
      "footer-link": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "600",
          "lineHeight": "1.5",
          "letterSpacing": "0em"
        },
        "$description": "Footer product links. Computed 14px / 600, capitalize.",
        "$extensions": {"source": "Measured. scale.com footer link 'Scale Data Engine'."}
      },
      "login-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.login}",
          "fontSize": "20px",
          "fontWeight": "400",
          "lineHeight": "2",
          "letterSpacing": "0em"
        },
        "$description": "Login h1. Computed 20px / 40px.",
        "$extensions": {"source": "Measured. dashboard.scale.com/login h1."}
      },
      "login-field": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.login}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "1.375",
          "letterSpacing": "0em"
        },
        "$description": "Login inputs. Computed 16px / 22px.",
        "$extensions": {"source": "Measured. dashboard login email input."}
      }
    },
    "radius": {
      "xs": {"$type": "dimension", "$value": "0.125rem", "$extensions": {"source": "Measured. :root --radius-xs."}},
      "sm": {"$type": "dimension", "$value": "0.25rem", "$extensions": {"source": "Measured. :root --radius-sm."}},
      "md": {"$type": "dimension", "$value": "0.375rem", "$extensions": {"source": "Measured. :root --radius-md. Also the demo Submit and Learn More radius (6px)."}},
      "lg": {"$type": "dimension", "$value": "0.5rem", "$extensions": {"source": "Measured. :root --radius-lg. Also nav Log In, Get Started, and both form fields (8px)."}},
      "xl": {"$type": "dimension", "$value": "0.75rem", "$extensions": {"source": "Measured. :root --radius-xl."}},
      "2xl": {"$type": "dimension", "$value": "1rem", "$extensions": {"source": "Measured. :root --radius-2xl. Also home cards (16px)."}},
      "3xl": {"$type": "dimension", "$value": "1.5rem", "$extensions": {"source": "Measured. :root --radius-3xl. Also login social and submit pills (24px)."}},
      "4xl": {"$type": "dimension", "$value": "2rem", "$extensions": {"source": "Measured. :root --radius-4xl."}}
    },
    "spacing": {
      "1": {"$type": "dimension", "$value": "0.25rem", "$extensions": {"source": "Measured. :root --spacing."}},
      "2": {"$type": "dimension", "$value": "0.5rem", "$extensions": {"source": "Derived. 2 times --spacing. Not read as its own property."}},
      "3": {"$type": "dimension", "$value": "0.75rem", "$extensions": {"source": "Measured. Header action gap 12px, and demo field horizontal padding."}},
      "4": {"$type": "dimension", "$value": "1rem", "$extensions": {"source": "Measured. Login container padding 16px, and demo form column-gap 16px."}},
      "5": {"$type": "dimension", "$value": "1.25rem", "$extensions": {"source": "Derived. 5 times --spacing."}},
      "6": {"$type": "dimension", "$value": "1.5rem", "$extensions": {"source": "Measured. Login field horizontal padding 24px. Also a hidden Get Started padding of 0 24px."}},
      "10": {"$type": "dimension", "$value": "2.5rem", "$extensions": {"source": "Measured. Nav control height 40px on Log In, Get Started, and demo Submit."}},
      "12": {"$type": "dimension", "$value": "3rem", "$extensions": {"source": "Measured. Login field height 48px."}},
      "22": {"$type": "dimension", "$value": "5.5rem", "$extensions": {"source": "Measured. Marketing header bar height 88px."}}
    },
    "motion": {
      "duration": {
        "default": {
          "$type": "duration",
          "$value": "150ms",
          "$extensions": {"source": "Measured. :root --default-transition-duration .15s."}
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1],
          "$extensions": {"source": "Measured. :root --default-transition-timing-function and --ease-in-out."}
        },
        "in": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 1, 1],
          "$extensions": {"source": "Measured. :root --ease-in."}
        },
        "out": {
          "$type": "cubicBezier",
          "$value": [0, 0, 0.2, 1],
          "$extensions": {"source": "Measured. :root --ease-out."}
        }
      }
    },
    "shadow": {
      "login-rest": {
        "$type": "shadow",
        "$value": {"color": "rgba(0, 0, 0, 0.3)", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"},
        "$extensions": {"source": "Measured. dashboard login social link and Log In button."}
      },
      "login-hover": {
        "$type": "shadow",
        "$value": {"color": "rgba(0, 0, 0, 0.3)", "offsetX": "0px", "offsetY": "2px", "blur": "3px", "spread": "0px"},
        "$extensions": {"source": "Measured from stylesheet rule a.jsx-2268fc33ac275efc:hover. Not forced in the live page."}
      },
      "field-focus": {
        "$type": "shadow",
        "$value": {"color": "rgba(23, 23, 23, 0.08)", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "3px"},
        "$extensions": {"source": "Measured. scale.com/demo email input after focus()."}
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {"source": "Measured. scale.com body background-color rgb(255, 255, 255). html itself is rgb(0, 0, 0)."}
      },
      "ink": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {"source": "Measured. html background, footer background, primary button face, theme-color meta."}
      },
      "nav": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {"source": "Measured. header inner bar background and --nav-background: white."}
      },
      "field": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {"source": "Measured. scale.com/demo input background."}
      },
      "field-login": {
        "$type": "color",
        "$value": "#edf2f7",
        "$extensions": {"source": "Measured. dashboard login input background rgb(237, 242, 247)."}
      },
      "field-login-focus": {
        "$type": "color",
        "$value": "#edebf4",
        "$extensions": {"source": "Measured from stylesheet .input:focus. Not forced live."}
      },
      "secondary": {
        "$type": "color",
        "$value": "#eaeaea",
        "$extensions": {"source": "Measured. Learn More button background rgb(234, 234, 234)."}
      },
      "menu": {
        "$type": "color",
        "$value": "#f5f5f5",
        "$extensions": {"source": "Measured. Open menu button background rgb(245, 245, 245). The control was display:none at 1169px."}
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {"source": "Measured. body color and nav link color rgb(0, 0, 0)."}
      },
      "on-ink": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {"source": "Measured. primary button and footer text rgb(255, 255, 255)."}
      },
      "secondary": {
        "$type": "color",
        "$value": "#575757",
        "$extensions": {"source": "Measured. demo lede and form note rgb(87, 87, 87)."}
      },
      "muted": {
        "$type": "color",
        "$value": "#929292",
        "$extensions": {"source": "Measured. Log In label rgb(146, 146, 146)."}
      },
      "title": {
        "$type": "color",
        "$value": "#212121",
        "$extensions": {"source": "Measured. demo h1 rgb(33, 33, 33)."}
      },
      "field": {
        "$type": "color",
        "$value": "#171717",
        "$extensions": {"source": "Measured. demo input color rgb(23, 23, 23)."}
      },
      "field-login": {
        "$type": "color",
        "$value": "#454d57",
        "$extensions": {"source": "Measured. dashboard login input color rgb(69, 77, 87)."}
      },
      "eyebrow": {
        "$type": "color",
        "$value": "#101010",
        "$extensions": {"source": "Measured. eyebrow on a light card rgb(16, 16, 16)."}
      },
      "link": {
        "$type": "color",
        "$value": "#2b99d8",
        "$extensions": {"source": "Measured. dashboard social link color rgb(43, 153, 216)."}
      },
      "link-strong": {
        "$type": "color",
        "$value": "#2f80ed",
        "$extensions": {"source": "Measured. 'Don't remember your password?' rgb(47, 128, 237)."}
      },
      "divider": {
        "$type": "color",
        "$value": "#4a5568",
        "$extensions": {"source": "Measured. login 'or' rgb(74, 85, 104)."}
      }
    },
    "border": {
      "stroke": {
        "$type": "color",
        "$value": "#c7c7c7",
        "$extensions": {"source": "Measured. Log In outline rgb(199, 199, 199)."}
      },
      "field": {
        "$type": "color",
        "$value": "#d1d5db",
        "$extensions": {"source": "Measured. demo input border rgb(209, 213, 219). Also :root --token-krc_s8wS1xq2."}
      },
      "focus": {
        "$type": "color",
        "$value": "#171717",
        "$extensions": {"source": "Measured. demo email input border after focus() rgb(23, 23, 23)."}
      }
    },
    "accent": {
      "sand": {
        "$type": "color",
        "$value": "#a8927c",
        "$extensions": {"source": "Measured. home rotating word 'Research' rgb(168, 146, 124)."}
      },
      "pine": {
        "$type": "color",
        "$value": "#193a29",
        "$extensions": {"source": "Measured. home rotating word 'Medicine' rgb(25, 58, 41)."}
      },
      "chart": {
        "$type": "color",
        "$value": "#72ce7b",
        "$extensions": {"source": "Measured. most frequent non-transparent fill on the home DOM, rgb(114, 206, 123). Decorative, not a button."}
      }
    },
    "component": {
      "button-primary": {
        "background": {"$type": "color", "$value": "{light.background.ink}", "$extensions": {"source": "Measured. Get Started and Submit faces."}},
        "text": {"$type": "color", "$value": "{light.text.on-ink}", "$extensions": {"source": "Measured. Get Started and Submit labels."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.lg}", "$extensions": {"source": "Measured. Get Started border-radius 8px. Demo Submit is 6px; see button-submit."}},
        "height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured. Get Started and Submit height."}}
      },
      "button-submit": {
        "background": {"$type": "color", "$value": "{light.background.ink}", "$extensions": {"source": "Measured. demo Submit."}},
        "text": {"$type": "color", "$value": "{light.text.on-ink}", "$extensions": {"source": "Measured. demo Submit."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.md}", "$extensions": {"source": "Measured. demo Submit border-radius 6px."}},
        "height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured. demo Submit height."}}
      },
      "button-login-nav": {
        "text": {"$type": "color", "$value": "{light.text.muted}", "$extensions": {"source": "Measured. header Log In."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.lg}", "$extensions": {"source": "Measured. header Log In border-radius 8px."}},
        "height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured. header Log In height."}}
      },
      "button-secondary": {
        "background": {"$type": "color", "$value": "{light.background.secondary}", "$extensions": {"source": "Measured. Learn More."}},
        "text": {"$type": "color", "$value": "{light.text.primary}", "$extensions": {"source": "Measured. Learn More."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.md}", "$extensions": {"source": "Measured. Learn More border-radius 6px."}}
      },
      "field-demo": {
        "background": {"$type": "color", "$value": "{light.background.field}", "$extensions": {"source": "Measured. demo inputs."}},
        "text": {"$type": "color", "$value": "{light.text.field}", "$extensions": {"source": "Measured. demo inputs."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.lg}", "$extensions": {"source": "Measured. demo inputs border-radius 8px."}},
        "height": {"$type": "dimension", "$value": "46px", "$extensions": {"source": "Measured. demo inputs height."}},
        "padding": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured. demo input padding 12px 16px. Horizontal only; vertical is 12px."}}
      },
      "field-login": {
        "background": {"$type": "color", "$value": "{light.background.field-login}", "$extensions": {"source": "Measured. dashboard login inputs."}},
        "text": {"$type": "color", "$value": "{light.text.field-login}", "$extensions": {"source": "Measured. dashboard login inputs."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.lg}", "$extensions": {"source": "Measured. dashboard login inputs border-radius 8px."}},
        "height": {"$type": "dimension", "$value": "48px", "$extensions": {"source": "Measured. dashboard login inputs height."}}
      },
      "button-login": {
        "background": {"$type": "color", "$value": "{light.background.ink}", "$extensions": {"source": "Measured. dashboard Log In submit."}},
        "text": {"$type": "color", "$value": "{light.text.on-ink}", "$extensions": {"source": "Measured. dashboard Log In submit."}},
        "radius": {"$type": "dimension", "$value": "{core.radius.3xl}", "$extensions": {"source": "Measured. dashboard Log In border-radius 24px."}},
        "height": {"$type": "dimension", "$value": "46px", "$extensions": {"source": "Measured. dashboard Log In height."}}
      }
    }
  },
  "$themes": [
    {"id": "light", "name": "Light", "selectedTokenSets": {"core": "source", "light": "enabled"}}
  ]
}
