{
 "core": {
  "$description": "Scales and primitives, theme-free.",
  "color": {
   "ink": {
    "$value": "#333333",
    "$type": "color",
    "$extensions": {
     "source": "computed color/borderColor of nearly every measured component (raw/components-computed.json)"
    },
    "$description": "The house ink: text, keylines, borders, the primary fill. Not pure black."
   },
   "inkDeep": {
    "$value": "#252525",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of footer default (raw/components-computed.json)"
    },
    "$description": "The dark footer ground."
   },
   "inkSoft": {
    "$value": "#393939",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of login-submit default (raw/components-computed.json)"
    },
    "$description": "A softened ink used on the sign-in submit."
   },
   "cream": {
    "$value": "#fffef2",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of filter-panel, cart-panel, search-field, newsletter-field defaults and color of add-to-cart/hero-cta/footer-link defaults (raw/components-computed.json)"
    },
    "$description": "The Aesop cream: page ground, field fills, and the light ink on dark surfaces."
   },
   "creamDark": {
    "$value": "#ebeade",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of search-button, search-close defaults (raw/components-computed.json)"
    },
    "$description": "The deeper cream of secondary fills and hairlines."
   },
   "creamAlt": {
    "$value": "#f6f5e8",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor on interior surface sections (raw/components-computed.json)"
    },
    "$description": "A mid cream for inset bands."
   },
   "creamHover": {
    "$value": "#fcfbef",
    "$type": "color",
    "$extensions": {
     "source": "computed color of login-submit default (raw/components-computed.json)"
    },
    "$description": "The light ink of the sign-in submit."
   },
   "muted": {
    "$value": "#bcbbb4",
    "$type": "color",
    "$extensions": {
     "source": "computed color of disabled/muted text nodes (raw/components-computed.json)"
    },
    "$description": "Muted grey-beige for secondary text."
   },
   "amber": {
    "$value": "#945c26",
    "$type": "color",
    "$extensions": {
     "source": "computed color of tile-badge default (New addition, Beloved formulation) and 'Learn more' links (raw/components-computed.json)"
    },
    "$description": "The one accent: a tannin amber for badges, promos and inline links."
   },
   "black": {
    "$value": "#000000",
    "$type": "color",
    "$extensions": {
     "source": "computed color of stores-title, m-menu-button, m-nav-item (raw/components-computed.json)"
    },
    "$description": "True black, used sparingly: locator title, mobile drawer items."
   },
   "white": {
    "$value": "#ffffff",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor on a few interior controls (raw/components-computed.json)"
    }
   },
   "keyline": {
    "$value": "rgba(51, 51, 51, 0.2)",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of newsletter-field, store-search, login-email defaults (raw/components-computed.json)"
    },
    "$description": "The 20%-ink hairline on fields."
   }
  },
  "font": {
   "family": {
    "sans": {
     "$value": "\"SuisseIntl\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of almost every measured text node (raw/components-computed.json)"
     },
     "$description": "Suisse Intl carries the site; the guide renders the Helvetica fallback."
    },
    "medium": {
     "$value": "\"SuisseIntl-Medium\", \"SuisseIntl\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of nav-link, hero-cta, add-to-cart, tile-badge, filter-toggle (raw/components-computed.json)"
     },
     "$description": "The medium cut, used for nav items, buttons and badges."
    },
    "display": {
     "$value": "\"CircularStd\", \"SuisseIntl\", sans-serif",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of pdp-title (raw/components-computed.json)"
     },
     "$description": "Circular Std, seen on the PDP product title."
    }
   },
   "scale": {
    "11": {
     "$value": "11px",
     "$type": "dimension",
     "$extensions": {
      "source": "account-link, tile-badge fontSize"
     }
    },
    "12": {
     "$value": "12px",
     "$type": "dimension",
     "$extensions": {
      "source": "utility nav, breadcrumbs, small print fontSize"
     }
    },
    "14": {
     "$value": "14px",
     "$type": "dimension",
     "$extensions": {
      "source": "nav-link, footer-link, field text, buttons fontSize"
     }
    },
    "16": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "filter-group row, product-card-price fontSize"
     }
    },
    "18": {
     "$value": "18px",
     "$type": "dimension",
     "$extensions": {
      "source": "footer-col-title fontSize"
     }
    },
    "24": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "plp-title, pdp-title, pdp-price, search-field fontSize"
     }
    },
    "30": {
     "$value": "30px",
     "$type": "dimension",
     "$extensions": {
      "source": "stores-title fontSize"
     }
    }
   },
   "weight": {
    "regular": {
     "$value": 400,
     "$type": "fontWeight",
     "$extensions": {
      "source": "computed fontWeight of most measured text"
     }
    },
    "bold": {
     "$value": 700,
     "$type": "fontWeight",
     "$extensions": {
      "source": "computed fontWeight of topnav-link, product-card-name, footer-col-title, search-button"
     }
    }
   },
   "lineHeight": {
    "tight": {
     "$value": "14.4px",
     "$type": "dimension",
     "$extensions": {
      "source": "12px utility labels"
     }
    },
    "snug": {
     "$value": "16.8px",
     "$type": "dimension",
     "$extensions": {
      "source": "14px nav/button labels"
     }
    },
    "body": {
     "$value": "21px",
     "$type": "dimension",
     "$extensions": {
      "source": "14px body"
     }
    },
    "loose": {
     "$value": "18px",
     "$type": "dimension",
     "$extensions": {
      "source": "12px body small"
     }
    },
    "display": {
     "$value": "30px",
     "$type": "dimension",
     "$extensions": {
      "source": "24px headings"
     }
    }
   }
  },
  "typography": {
   "utility": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.12}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "{font.lineHeight.tight}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "topnav-link, signup-link, cart-button (raw/components-computed.json)"
    },
    "$description": "12/14.4 bold utility labels in the top row."
   },
   "micro": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.11}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "17.6px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "account-link (raw/components-computed.json)"
    },
    "$description": "11/17.6 micro text."
   },
   "bodySmall": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.12}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.loose}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "breadcrumbs, footer small print (raw/components-computed.json)"
    },
    "$description": "12/18 small body."
   },
   "body": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.14}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.body}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "hero-cta, field text, footer-link (raw/components-computed.json)"
    },
    "$description": "14/21 body and control text."
   },
   "navLabel": {
    "$value": {
     "fontFamily": "{font.family.medium}",
     "fontSize": "{font.scale.14}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.snug}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "nav-link, accordion, add-to-cart, hero-cta, filter-toggle (raw/components-computed.json)"
    },
    "$description": "14/16.8 medium for nav items, buttons, CTA cards."
   },
   "productName": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.14}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "15.12px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "product-card-name (raw/components-computed.json)"
    },
    "$description": "14/15 bold tile names."
   },
   "price": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.16}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "19.2px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "product-card-price (raw/components-computed.json)"
    },
    "$description": "16/19 prices."
   },
   "title": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.24}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.display}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "plp-title, pdp-title, pdp-price, search-field (raw/components-computed.json)"
    },
    "$description": "24/30 page and product titles; the search field sets the same size."
   },
   "display": {
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "{font.scale.30}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.display}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "stores-title (raw/components-computed.json)"
    },
    "$description": "30/30 the Find a store display heading."
   }
  },
  "radius": {
   "none": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "borderTopLeftRadius of almost every measured component (raw/components-computed.json)"
    },
    "$description": "Aesop rounds almost nothing."
   },
   "small": {
    "$value": "2px",
    "$type": "dimension",
    "$extensions": {
     "source": "radius on a handful of inner controls (raw/components-computed.json)"
    }
   },
   "medium": {
    "$value": "4px",
    "$type": "dimension",
    "$extensions": {
     "source": "radius on a few cards/dialog edges (raw/components-computed.json)"
    }
   }
  },
  "border": {
   "hairline": {
    "$value": "1px",
    "$type": "dimension",
    "$extensions": {
     "source": "borderTopWidth of fields, hero-cta, keylines (raw/components-computed.json)"
    },
    "$description": "Every rule and keyline is 1px; several are drawn as 1px-spread box-shadows rather than borders."
   }
  },
  "size": {
   "header": {
    "top": {
     "$value": "30px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of the utility row at 1440 (header default, raw/components-computed.json)"
     }
    },
    "navRow": {
     "$value": "50.8px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of nav-link/search-button defaults"
     }
    },
    "mobile": {
     "$value": "50px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of m-header at 390"
     }
    }
   },
   "control": {
    "field": {
     "$value": "40px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of newsletter-field, store-search, login-email, search-field"
     }
    },
    "button": {
     "$value": "48px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of add-to-cart, hero-cta, login-submit"
     }
    },
    "navItem": {
     "$value": "48px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered height of m-nav-item rows"
     }
    }
   },
   "panel": {
    "drawer": {
     "$value": "405px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered width of cart-panel"
     }
    },
    "rail": {
     "$value": "400px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered width of filter-panel"
     }
    },
    "dialog": {
     "$value": "970px",
     "$type": "dimension",
     "$extensions": {
      "source": "rendered width of signup-dialog"
     }
    }
   },
   "hero": {
    "$value": "720px",
    "$type": "dimension",
    "$extensions": {
     "source": "rendered height of the home hero band at 1440"
    }
   }
  },
  "space": {
   "control": {
    "x": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingLeft of add-to-cart, hero-cta, login-submit"
     }
    },
    "y": {
     "$value": "13px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingTop of add-to-cart, hero-cta"
     }
    }
   },
   "nav": {
    "x": {
     "$value": "17px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingLeft of nav-link, accordion"
     }
    },
    "y": {
     "$value": "17px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingTop of nav-link"
     }
    }
   },
   "field": {
    "x": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingLeft of newsletter-field, search-button; 35px on store-search (icon inset)"
     }
    },
    "y": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingTop of search-button, search-close"
     }
    }
   },
   "dialog": {
    "x": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingLeft of no-result-dialog"
     }
    },
    "y": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "computed paddingTop of no-result-dialog"
     }
    }
   }
  },
  "focusRing": {
   "color": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed outlineColor on measured focus-visible states; the width never paints, so no ring shows (raw/components-computed.json)"
    },
    "$description": "Aesop draws no visible focus ring on the measured controls: keyboard focus lands, but outlineWidth stays 0 and no ring is painted."
   },
   "width": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed outlineWidth on every focus-visible measurement"
    }
   }
  },
  "motion": {
   "duration": {
    "instant": {
     "$value": "0ms",
     "$type": "duration",
     "$extensions": {
      "source": "computed transitionDuration of most controls (raw/components-computed.json)"
     },
     "$description": "Most state changes are instant."
    },
    "hover": {
     "$value": "500ms",
     "$type": "duration",
     "$extensions": {
      "source": "computed transitionDuration of topnav-link, signup-link, cart-button (raw/components-computed.json)"
     },
     "$description": "Utility-nav colour changes ease over half a second."
    },
    "select": {
     "$value": "200ms",
     "$type": "duration",
     "$extensions": {
      "source": "computed transitionDuration of sort-select"
     }
    }
   },
   "easing": {
    "standard": {
     "$value": [
      0.25,
      0.1,
      0.25,
      1
     ],
     "$type": "cubicBezier",
     "$extensions": {
      "source": "computed transitionTimingFunction on measured transitions"
     }
    }
   }
  },
  "breakpoint": {
   "mobile": {
    "$value": "390px",
    "$type": "dimension",
    "$extensions": {
     "source": "the width at which the burger menu replaces the nav row"
    }
   }
  }
 },
 "light": {
  "$description": "The only theme aesop.com paints; semantic roles alias core.",
  "background": {
   "page": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of the page surfaces (fields, panels, dialogs)"
    }
   },
   "surface": {
    "$value": "{color.creamDark}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor/secondary fill of header controls"
    }
   },
   "inset": {
    "$value": "{color.creamAlt}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of interior bands"
    }
   },
   "header": {
    "$value": "rgba(255, 254, 242, 0.686)",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of header and m-header defaults: the translucent cream the transparent header settles to"
    }
   },
   "dark": {
    "$value": "{color.inkDeep}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of footer"
    }
   }
  },
  "text": {
   "primary": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of nearly every measured text node"
    }
   },
   "muted": {
    "$value": "{color.muted}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of secondary text"
    }
   },
   "onDark": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of footer-link, footer-col-title, add-to-cart, hero-cta on dark fills"
    }
   },
   "accent": {
    "$value": "{color.amber}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of tile-badge and promo links"
    }
   },
   "black": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of stores-title and mobile drawer items"
    }
   }
  },
  "action": {
   "primary": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of add-to-cart default"
    },
    "$description": "The ink bar: ADD TO CART and the dark CTAs."
   },
   "primaryText": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of add-to-cart on the ink fill"
    }
   },
   "secondary": {
    "$value": "{color.inkSoft}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of login-submit"
    }
   },
   "outline": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor/color of hero-cta: the cream-bordered CTA card over photography"
    }
   }
  },
  "border": {
   "default": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor/outlineColor of keylines on controls"
    }
   },
   "field": {
    "$value": "{color.keyline}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of fields"
    }
   },
   "light": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of hero-cta and footer links on dark"
    }
   },
   "secondary": {
    "$value": "{color.creamDark}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of search-button/search-close edges"
    }
   }
  },
  "focus": {
   "ring": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed outlineColor on focused controls; no painted ring was observed"
    }
   }
  }
 },
 "$themes": [
  {
   "id": "light",
   "name": "Light",
   "selectedTokenSets": {
    "core": "source",
    "light": "enabled"
   },
   "$description": "The only theme aesop.com paints. There is no dark or high-contrast variant; every measurement was taken on the single light scheme."
  }
 ],
 "$metadata": {
  "tokenSetOrder": [
   "core",
   "light"
  ]
 }
}
