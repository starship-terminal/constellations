{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "body": {
        "$value": "Charlie Text, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of body on https://bitbucket.org/"
        }
      },
      "display": {
        "$value": "Charlie Display, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of the homepage h1"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the homepage h1 at 1440"
        }
      },
      "pricing": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the pricing h1 at 1440"
        }
      },
      "body": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of body"
        }
      },
      "nav": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the Pricing link"
        }
      },
      "button": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the header Get it Free control"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "10000px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of the header Get it Free control"
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{fontSize.hero}",
          "fontWeight": "500",
          "lineHeight": "66.56px",
          "letterSpacing": "-1.28px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of the homepage h1 on https://bitbucket.org/"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.body}",
          "fontWeight": "400",
          "lineHeight": "normal"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of body"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "sampled page fill of the homepage screenshot, and computed background of the status page body"
        }
      },
      "text": {
        "$value": "#101214",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the homepage h1, rgb(16, 18, 20)"
        }
      },
      "body": {
        "$value": "#292a2e",
        "$type": "color",
        "$extensions": {
          "source": "computed color of body, rgb(41, 42, 46)"
        }
      },
      "nav": {
        "$value": "#292a2e",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the Pricing link, rgb(41, 42, 46)"
        }
      },
      "link": {
        "$value": "#1868db",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the Watch demo link, rgb(24, 104, 219)"
        }
      },
      "button": {
        "$value": "#1868db",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color of the header Get it Free control, rgb(24, 104, 219)"
        }
      },
      "buttonText": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of the header Get it Free control"
        }
      },
      "premium": {
        "$value": "#fca700",
        "$type": "color",
        "$extensions": {
          "source": "sampled fill of the Premium Try it now control, rgb(252, 167, 0). Matches declared --rovo-yellow-color"
        }
      },
      "status": {
        "$value": "#36b37e",
        "$type": "color",
        "$extensions": {
          "source": "sampled fill of the status All Systems Operational bar, rgb(54, 179, 126)"
        }
      },
      "mark": {
        "$value": "#1868db",
        "$type": "color",
        "$extensions": {
          "source": "sampled fill of the Atlassian mark in the homepage header, rgb(24, 104, 219)"
        }
      }
    }
  }
}
