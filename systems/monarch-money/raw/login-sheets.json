 "sample": {
  "--fade-transition-time": {
   "sel": ".osano-cm-window",
   "v": "700ms"
  },
  "--slide-transition-time": {
   "sel": ".osano-cm-window",
   "v": "400ms"
  },
  "--gap": {
   "sel": "[data-mds=\"toast\"]",
   "v": "var(--space-xs)"
  },
  "--peek": {
   "sel": "[data-mds=\"toast\"]",
   "v": "var(--space-sm)"
  },
  "--scale": {
   "sel": "[data-mds=\"toast\"]",
   "v": "calc(max(0, 1 - (var(--toast-index) * 0.05)))"
  },
  "--shrink": {
   "sel": "[data-mds=\"toast\"]",
   "v": "calc(1 - var(--scale))"
  },
  "--height": {
   "sel": "[data-mds=\"toast\"]",
   "v": "var(--toast-frontmost-height, var(--toast-height))"
  },
  "--offset-y": {
   "sel": "[data-mds=\"toast\"]",
   "v": "calc(\n      var(--toast-offset-y, 0px) * -1\n      + (var(--toast-index) * var(--gap) * -1)\n      + var(--toast-swipe-movement-y, 0px)\n    )"
  }
 },
