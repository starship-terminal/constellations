{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Superlist public marketing, measured 2026-11-19. Light only. Primary button stops are sampled pixels from the painted pill, because the computed gradient is display-p3 and the preview canvas clipped color().",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": ["Haffer XH", "sans-serif"],
          "$extensions": {
            "source": "Computed font-family on the home h1 is \"Haffer XH Bold\". Faces load from framerusercontent.com. Proprietary; files are not in this package."
          }
        },
        "body": {
          "$type": "fontFamily",
          "$value": ["Inter", "sans-serif"],
          "$extensions": {
            "source": "Computed font-family on hero body and footer links is Inter. Faces load from framerusercontent.com."
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "68px",
          "fontWeight": 700,
          "lineHeight": "69.36px",
          "letterSpacing": "-3px"
        },
        "$extensions": {
          "source": "Home h1 at 1440. Computed Haffer XH Bold, 68px, weight 700, line-height 69.36px, letter-spacing -3px, color rgb(24, 24, 37)."
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "48px",
          "fontWeight": 600,
          "lineHeight": "51.84px",
          "letterSpacing": "-1px"
        },
        "$extensions": {
          "source": "Home h2 preset framer-styles-preset-1oemif7 at 1440. Haffer XH SemiBold, 48px, weight 600, line-height 51.84px, letter-spacing -1px."
        }
      },
      "page-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "52px",
          "fontWeight": 600,
          "lineHeight": "56.16px",
          "letterSpacing": "-1.56px"
        },
        "$extensions": {
          "source": "Pricing h1. Haffer XH SemiBold, 52px, weight 600, line-height 56.16px, letter-spacing -1.56px, color rgb(24, 24, 36)."
        }
      },
      "plan-name": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "32px",
          "fontWeight": 600,
          "lineHeight": "44.8px"
        },
        "$extensions": {
          "source": "Pricing plan name. Haffer XH SemiBold, 32px, weight 600, line-height 44.8px."
        }
      },
      "price": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "48px",
          "fontWeight": 600,
          "lineHeight": "67.2px"
        },
        "$extensions": {
          "source": "Pricing plan price ($0, $5, $17). Inter, 48px, weight 600, line-height 67.2px."
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "21.6px",
          "letterSpacing": "-0.18px"
        },
        "$extensions": {
          "source": "Primary pill label. Computed weight 400 on the SemiBold face, 18px, line-height 21.6px, letter-spacing -0.18px, color white."
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "16px",
          "fontWeight": 600,
          "lineHeight": "19.2px"
        },
        "$extensions": {
          "source": "Desktop nav label Features. Haffer XH SemiBold, 16px, weight 600, line-height 19.2px, color rgb(24, 24, 36)."
        }
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "11px",
          "fontWeight": 600,
          "lineHeight": "16.5px",
          "letterSpacing": "1.5px"
        },
        "$extensions": {
          "source": "Hero eyebrow preset framer-styles-preset-1gakbh3. Inter 11px, weight 600, line-height 16.5px, letter-spacing 1.5px."
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "29.7px",
          "letterSpacing": "-0.36px"
        },
        "$extensions": {
          "source": "Hero paragraph preset framer-styles-preset-qhms77. Inter 18px, weight 400, line-height 29.7px, letter-spacing -0.36px, color rgb(89, 87, 92)."
        }
      },
      "link": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "15px",
          "fontWeight": 600,
          "lineHeight": "18px"
        },
        "$extensions": {
          "source": "See how it works. Inter 15px, weight 600, line-height 18px, color rgb(24, 24, 37)."
        }
      },
      "footer": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "18.2px",
          "letterSpacing": "-0.07px"
        },
        "$extensions": {
          "source": "Footer links. Inter 14px, weight 400, line-height 18.2px, letter-spacing -0.07px, color rgb(142, 141, 160)."
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "14.4px"
        },
        "$extensions": {
          "source": "Footer version label preset framer-styles-preset-11v2ke7. Inter 12px, line-height 14.4px."
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "100px",
        "$extensions": {
          "source": "Primary button padding element border-radius 100px. Billing chips are 24px, recorded separately."
        }
      },
      "chip": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": "Pricing Monthly and Yearly controls, border-radius 24px."
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "Pricing Free plan card, border-radius 20px."
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Primary anchor border-radius 8px. The visible fill is the inner 100px pill."
        }
      }
    },
    "space": {
      "2": { "$type": "dimension", "$value": "4px", "$extensions": { "source": "Primary label wrapper padding 0px 4px." } },
      "3": { "$type": "dimension", "$value": "8px", "$extensions": { "source": "Pricing billing options padding 8px." } },
      "4": { "$type": "dimension", "$value": "10px", "$extensions": { "source": "Nav Sign up pill padding 10px." } },
      "5": { "$type": "dimension", "$value": "14px", "$extensions": { "source": "Primary pill padding-top 14px." } },
      "6": { "$type": "dimension", "$value": "20px", "$extensions": { "source": "Billing chip padding 12px 20px. Logo row padding includes 20px." } },
      "7": { "$type": "dimension", "$value": "24px", "$extensions": { "source": "Hero gap 24px. Plan card padding 24px. Hero actions gap 24px." } },
      "8": { "$type": "dimension", "$value": "40px", "$extensions": { "source": "Section horizontal padding 40px. Hero padding-left 40px." } },
      "9": { "$type": "dimension", "$value": "50px", "$extensions": { "source": "Desktop nav padding 26px 50px." } },
      "10": { "$type": "dimension", "$value": "56px", "$extensions": { "source": "Hero padding-top 56px." } },
      "11": { "$type": "dimension", "$value": "80px", "$extensions": { "source": "Feature sections padding 80px 40px and gap 80px." } },
      "12": { "$type": "dimension", "$value": "96px", "$extensions": { "source": "Workflow introduction padding 96px 40px." } }
    },
    "elevation": {
      "pill": {
        "$type": "shadow",
        "$value": [
          { "color": "rgba(0, 0, 0, 0.1)", "offsetX": "0px", "offsetY": "1px", "blur": "1px", "spread": "0px" },
          { "color": "rgba(0, 0, 0, 0.05)", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px" },
          { "color": "rgba(255, 255, 255, 0.45)", "offsetX": "0px", "offsetY": "0.5px", "blur": "0px", "spread": "0px", "inset": true }
        ],
        "$extensions": {
          "source": "Computed box-shadow on the primary pill padding element."
        }
      }
    },
    "motion": {
      "link": {
        "$type": "duration",
        "$value": "200ms",
        "$extensions": {
          "source": "Computed transition on links: color 0.2s cubic-bezier(0.44, 0, 0.56, 1). Primary hover scaled to about 1.05. No prefers-reduced-motion rule was found."
        }
      }
    },
    "palette": {
      "ink": {
        "$type": "color",
        "$value": "#181825",
        "$extensions": { "source": "rgb(24, 24, 37), declared --token-A5FR21p8J #181825. Home h1 color." }
      },
      "ink-soft": {
        "$type": "color",
        "$value": "#181824",
        "$extensions": { "source": "rgb(24, 24, 36). Final CTA, footer, pricing headings, nav labels." }
      },
      "muted": {
        "$type": "color",
        "$value": "#59575c",
        "$extensions": { "source": "rgb(89, 87, 92), declared --token-hczgwQoop #59575c. Hero body." }
      },
      "footer": {
        "$type": "color",
        "$value": "#8e8da0",
        "$extensions": { "source": "rgb(142, 141, 160). Footer links." }
      },
      "page": {
        "$type": "color",
        "$value": "#fffdf9",
        "$extensions": { "source": "Computed body background rgb(255, 253, 249). Declared --token-bbjcaqXFN #fffdf9." }
      },
      "sand": {
        "$type": "color",
        "$value": "#f0eeea",
        "$extensions": { "source": "rgb(240, 238, 234). Collaboration section, plan cards, selected billing chip." }
      },
      "peach": {
        "$type": "color",
        "$value": "#faeee7",
        "$extensions": { "source": "rgb(250, 238, 231), declared --token-f4Nz6sLdQ #faeee7. At home section." }
      },
      "coral-top": {
        "$type": "color",
        "$value": "#ff502f",
        "$extensions": { "source": "Sampled pixel rgb(255, 80, 47) at the top of the painted primary pill. Computed stop is color(display-p3 0.97561 0.379986 0.256739)." }
      },
      "coral-bottom": {
        "$type": "color",
        "$value": "#dc0000",
        "$extensions": { "source": "Sampled pixel rgb(220, 0, 0) at the bottom of the painted primary pill. Computed stop is color(display-p3 0.772358 0.137098 0.050813)." }
      },
      "focus": {
        "$type": "color",
        "$value": "#005fcc",
        "$extensions": { "source": "First Tab stop outline rgb(0, 95, 204)." }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": { "source": "Primary label color rgb(255, 255, 255)." }
      }
    }
  },
  "light": {
    "background": {
      "page": { "$type": "color", "$value": "{core.palette.page}", "$extensions": { "source": "Body background on home, pricing, and blog." } },
      "surface": { "$type": "color", "$value": "{core.palette.sand}", "$extensions": { "source": "Plan card and collaboration section." } },
      "peach": { "$type": "color", "$value": "{core.palette.peach}", "$extensions": { "source": "At home section background." } },
      "inverse": { "$type": "color", "$value": "{core.palette.ink-soft}", "$extensions": { "source": "Final CTA and footer background." } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{core.palette.ink}", "$extensions": { "source": "Home h1 color." } },
      "secondary": { "$type": "color", "$value": "{core.palette.muted}", "$extensions": { "source": "Hero body color." } },
      "footer": { "$type": "color", "$value": "{core.palette.footer}", "$extensions": { "source": "Footer link color." } },
      "on-accent": { "$type": "color", "$value": "{core.palette.white}", "$extensions": { "source": "Primary pill label." } },
      "on-inverse": { "$type": "color", "$value": "{core.palette.white}", "$extensions": { "source": "Final CTA heading computed rgb(255, 255, 255)." } }
    },
    "accent": {
      "top": { "$type": "color", "$value": "{core.palette.coral-top}", "$extensions": { "source": "Sampled top of the primary pill." } },
      "bottom": { "$type": "color", "$value": "{core.palette.coral-bottom}", "$extensions": { "source": "Sampled bottom of the primary pill." } }
    },
    "border": {
      "focus": { "$type": "color", "$value": "{core.palette.focus}", "$extensions": { "source": "Browser outline on the first focused link." } }
    },
    "component": {
      "button-primary-background": {
        "$type": "color",
        "$value": "{core.palette.coral-bottom}",
        "$extensions": { "source": "DESIGN.md needs a flat colour. The live control is a vertical gradient from accent.top to accent.bottom. This flat value is the sampled bottom stop, not a second fill." }
      },
      "button-primary-text": { "$type": "color", "$value": "{core.palette.white}", "$extensions": { "source": "Primary label." } },
      "button-primary-radius": { "$type": "dimension", "$value": "{core.radius.pill}", "$extensions": { "source": "Inner pill radius." } },
      "card-background": { "$type": "color", "$value": "{core.palette.sand}", "$extensions": { "source": "Plan card." } },
      "card-radius": { "$type": "dimension", "$value": "{core.radius.card}", "$extensions": { "source": "Plan card radius." } }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
