{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.dagnedover.com/ 2026-11-22." }
      },
      "ink": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": { "source": "Measured. Product title, price, Add to bag fill, and product-page nav rgb(51, 51, 51)." }
      },
      "text": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(102, 102, 102)." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Add to bag text and promo bar text rgb(255, 255, 255)." }
      },
      "muted": {
        "$value": "#999999",
        "$type": "color",
        "$extensions": { "source": "Measured. Product breadcrumb color rgb(153, 153, 153)." }
      },
      "orange": {
        "$value": "#ff3600",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage promo bar and product badge backgroundColor rgb(255, 54, 0)." }
      },
      "lime": {
        "$value": "#edff2c",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage hero SHOP NOW pill backgroundColor rgb(237, 255, 44)." }
      },
      "quiet": {
        "$value": "#f6f6f6",
        "$type": "color",
        "$extensions": { "source": "Measured. Swatch chip fallback and default border color rgb(246, 246, 246)." }
      }
    },
    "font": {
      "body": {
        "$value": "nimbus-sans, \"Trebuchet MS\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily. Files are not in this package. The style guide falls back to Trebuchet MS." }
      },
      "display": {
        "$value": "nimbus-sans-condensed, Times, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. Shop All title and product title fontFamily. Files are not in this package." }
      },
      "nav": {
        "$value": "nimbus-sans-condensed, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. Header link fontFamily on the product page." }
      }
    },
    "fontSize": {
      "body": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. body fontSize." }
      },
      "nav": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. SHOP ALL link fontSize." }
      },
      "card": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Collection card title fontSize." }
      },
      "product": {
        "$value": "28px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Landon title and price fontSize." }
      },
      "shop": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. SHOP ALL heading fontSize." }
      }
    },
    "size": {
      "promo": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Promo bar height." }
      },
      "header": {
        "$value": "71px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. #nav-bar height." }
      },
      "hero-pill": {
        "$value": "42px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage SHOP NOW pill height." }
      },
      "add-to-bag": {
        "$value": "46px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Product Add to bag button height. The control was not clicked." }
      },
      "size-chip": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Selected Small size label height." }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Add to bag borderRadius." }
      },
      "hero": {
        "$value": "25px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage SHOP NOW pill borderRadius." }
      },
      "chip": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Size label borderRadius." }
      },
      "badge": {
        "$value": "0px 5px 5px 0px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Collection badge borderRadius." }
      }
    }
  }
}
