{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.hoka.com/en/us/ 2026-11-22." }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(0, 0, 0). Nav labels and sale price are the same black. CSS var --primary is #000." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Utility bar text rgb(255, 255, 255) on the black strip." }
      },
      "utility": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "Measured. .top-header backgroundColor rgb(0, 0, 0), 48px." }
      },
      "mark": {
        "$value": "#009dff",
        "$type": "color",
        "$extensions": { "source": "Measured. .brand-logo-fill computed fill rgb(0, 157, 255)." }
      },
      "muted": {
        "$value": "#4d4d4d",
        "$type": "color",
        "$extensions": { "source": "Measured. Struck list price rgb(77, 77, 77) on the Women's grid. CSS var --secondary is #4d4d4d." }
      },
      "sale": {
        "$value": "#e10f00",
        "$type": "color",
        "$extensions": { "source": "Measured. Holiday Exclusive badge and (20% Off) rgb(224, 15, 0) on https://www.hoka.com/en/us/womens-view-all/." }
      },
      "ask": {
        "$value": "#efefef",
        "$type": "color",
        "$extensions": { "source": "Measured. Ask HOKA button backgroundColor rgb(239, 239, 239)." }
      }
    },
    "font": {
      "body": {
        "$value": "the-future, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily. CSS var --font-family-sans-serif. Files are not in this package. Shop Now also names futura-pt in its stack." }
      }
    },
    "radius": {
      "pill": {
        "$value": "52px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search border-radius 52px. Shop Now and Ask HOKA are the same 52px." }
      },
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Utility bar and category title border-radius 0px. Sort control radius 0px." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "ink": { "$value": "{core.color.ink}", "$type": "color" },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color" },
      "utility": { "$value": "{core.color.utility}", "$type": "color" },
      "mark": { "$value": "{core.color.mark}", "$type": "color" },
      "muted": { "$value": "{core.color.muted}", "$type": "color" },
      "sale": { "$value": "{core.color.sale}", "$type": "color" },
      "ask": { "$value": "{core.color.ask}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
