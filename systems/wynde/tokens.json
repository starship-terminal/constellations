    "motion": {
      "$description": "Motion as measured: the durations and easing curves the product's elements run, which properties transition, its animations and @keyframes, and what prefers-reduced-motion: reduce changes. Read by tools/capture/motion-probe.mjs.",
      "duration": {
        "100ms": {
          "$value": "100ms",
          "$type": "duration",
          "$description": "Read at rest on 2 elements.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "uses": 2
          }
        },
        "300ms": {
          "$value": "300ms",
          "$type": "duration",
          "$description": "Read at rest on 2 elements.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "uses": 2
          }
        },
        "400ms": {
          "$value": "400ms",
          "$type": "duration",
          "$description": "Declared in a state rule, not seen running at rest.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#declared"
            },
            "uses": 0
          }
        },
        "600ms": {
          "$value": "600ms",
          "$type": "duration",
          "$description": "Declared in a state rule, not seen running at rest.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#declared"
            },
            "uses": 0
          }
        }
      },
      "easing": {
        "bezier-0_44-0-0_56-1": {
          "$value": [
            0.44,
            0,
            0.56,
            1
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "uses": 2
          }
        },
        "ease-out": {
          "$value": [
            0,
            0,
            0.58,
            1
          ],
          "$type": "cubicBezier",
          "$description": "The keyword `ease-out`, expanded to its control points.",
          "$extensions": {
            "source": {
              "evidence": "Derived",
              "capture": "raw/motion.json#declared"
            },
            "uses": 0
          }
        },
        "linear": {
          "$value": [
            0,
            0,
            1,
            1
          ],
          "$type": "cubicBezier",
          "$description": "The keyword `linear`, expanded to its control points.",
          "$extensions": {
            "source": {
              "evidence": "Derived",
              "capture": "raw/motion.json#pages"
            },
            "uses": 2
          }
        }
      },
      "transition": {
        "color-300ms-bezier-0_44-0-0_56-1": {
          "$value": {
            "duration": "{motion.duration.300ms}",
            "delay": "0ms",
            "timingFunction": "{motion.easing.bezier-0_44-0-0_56-1}"
          },
          "$type": "transition",
          "$description": "Read at rest on 2 elements.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "property": "color",
            "elements": 2,
            "reducedMotion": {
              "kept": 2
            }
          }
        },
        "left-100ms-linear": {
          "$value": {
            "duration": "{motion.duration.100ms}",
            "delay": "0ms",
            "timingFunction": "{motion.easing.linear}"
          },
          "$type": "transition",
          "$description": "Read at rest on 1 element.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "property": "left",
            "elements": 1,
            "reducedMotion": {
              "kept": 1
            }
          }
        },
        "width-100ms-linear": {
          "$value": {
            "duration": "{motion.duration.100ms}",
            "delay": "0ms",
            "timingFunction": "{motion.easing.linear}"
          },
          "$type": "transition",
          "$description": "Read at rest on 1 element.",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "raw/motion.json#pages"
            },
            "property": "width",
            "elements": 1,
            "reducedMotion": {
              "kept": 1
            }
          }
        }
      },
      "$extensions": {
        "reducedMotion": {
          "probe": "page.emulateMedia({ reducedMotion }): 'no-preference' then 'reduce', same elements, same page",
          "verified": true,
          "pages": 2,
          "behaviour": "ignores",
          "moving": 4,
          "removed": 0,
          "reduced": 0,
          "kept": 4,
          "partial": 0,
          "increased": 0,
          "added": 0,
          "loops": [],
          "authoredRules": []
        },
        "propertyUsage": {
          "color": 2,
          "left": 1,
          "width": 1
        },
        "smoothScrollElements": 0,
        "unusedKeyframes": [
          "__framer-editorbar-spinner-spin"
        ]
      }
    }
  },
