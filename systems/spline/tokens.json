{
  "$schema": "https://design-tokens.org/schemas/latest/tokens.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "Geist, \"Helvetica Neue\", Arial, sans-serif",
          "$extensions": {
            "source": "Measured. .-pVNbW_root --display resolved to Geist, Geist Fallback, Helvetica Neue, Arial, sans-serif on https://spline.design/ at 1440px, 2026-11-19. Geist Fallback is the next/font metric face and is not loaded here."
          }
        },
        "body": {
          "$type": "fontFamily",
          "$value": "Geist, \"Helvetica Neue\", Arial, sans-serif",
          "$extensions": {
            "source": "Measured. --body on .-pVNbW_root, same page."
          }
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "\"Geist Mono\", ui-monospace, \"SF Mono\", Menlo, monospace",
          "$extensions": {
            "source": "Measured. --mono on .-pVNbW_root."
          }
        },
        "app": {
          "$type": "fontFamily",
          "$value": "\"Spline Sans\", system-ui, -apple-system, sans-serif",
          "$extensions": {
            "source": "Measured. document.body font-family on https://spline.design/ and on https://app.spline.design/signin. Spline Sans is self-hosted at /fonts/SplineSans-Regular.woff2 and SplineSans-Medium.woff2 and is not committed."
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "72px",
          "fontWeight": 450,
          "lineHeight": "80px",
          "letterSpacing": "-4.32px"
        },
        "$extensions": {
          "source": "Measured. h1._9jFHFW_title computed style on https://spline.design/ at 1440x900. line-height 79.92px rounded to 80px. font-weight 450."
        }
      },
      "display-narrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "36px",
          "fontWeight": 450,
          "lineHeight": "44px",
          "letterSpacing": "-2.16px"
        },
        "$extensions": {
          "source": "Measured. the same h1 at innerWidth 390."
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "56px",
          "fontWeight": 450,
          "lineHeight": "64px",
          "letterSpacing": "-3.36px"
        },
        "$extensions": {
          "source": "Measured. h2.-pVNbW_h2 at 1440px. Declared letter-spacing is -0.06em."
        }
      },
      "pricing-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "64px",
          "fontWeight": 450,
          "lineHeight": "72px",
          "letterSpacing": "-3.84px"
        },
        "$extensions": {
          "source": "Measured. h1.WaODtW_title on https://spline.design/pricing at 1440px."
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "24px",
          "fontWeight": 450,
          "lineHeight": "30px",
          "letterSpacing": "-1.2px"
        },
        "$extensions": {
          "source": "Measured. h3.-pVNbW_h3 on the home page."
        }
      },
      "price": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "48px",
          "fontWeight": 400,
          "lineHeight": "52px",
          "letterSpacing": "-2.4px"
        },
        "$extensions": {
          "source": "Measured. the $12 price element inside .PvLRtq_price on the pricing page."
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "Measured. the hero paragraph on the home page. color #8a8a8a."
        }
      },
      "ui": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "Measured. p.-pVNbW_body and the nav link."
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": 500,
          "lineHeight": "25px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "Measured. a.-pVNbW_btn.-pVNbW_btnSolid. Computed line-height 24.8px rounded to 25px."
        }
      },
      "app-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.app}",
          "fontSize": "24px",
          "fontWeight": 500,
          "lineHeight": "28px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "Measured. h1 on https://app.spline.design/signin."
        }
      },
      "app-body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.app}",
          "fontSize": "11px",
          "fontWeight": 400,
          "lineHeight": "13px",
          "letterSpacing": "0"
        },
        "$extensions": {
          "source": "Measured. document.body font-size 11px on the sign-in page. line-height 12.65px rounded to 13px."
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": "Measured. primary and secondary buttons, chips, and the billing toggle, border-radius 999px."
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured. a.gmmB4W_voiceLink border-radius 16px. The sign-in update card is also 16px."
        }
      },
      "media": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "Declared. .gmmB4W_media border-radius 14px."
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured. nav link radius 8px. App email field, code field, and Next button radius 8px (--radius-1)."
        }
      },
      "checkbox": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Measured. the news checkbox control on the name step, border-radius 4px."
        }
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Declared. :where(.-pVNbW_root) :where(:focus-visible) sets border-radius 2px with the outline."
        }
      }
    },
    "spacing": {
      "2": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Measured. nav link gap 4px. App --space-1 is 4px."
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured. button gap 8px. App --space-2 is 8px."
        }
      },
      "5": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "source": "Measured. chip row gap 10px and platform-item gap 10px."
        }
      },
      "7": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "Measured. small button padding-inline 14px. Story card gap 14px."
        }
      },
      "8": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured. app field padding-inline 16px. App --space-3 is 16px."
        }
      },
      "10": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "Measured. primary button padding-inline 20px. Page padding-inline at 390px is 20px."
        }
      },
      "12": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": "Declared. a feature section sets --gap: 24px."
        }
      },
      "14": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "source": "Measured. plan card padding-top 28px."
        }
      },
      "16": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "source": "Measured. plan card padding-bottom 32px. App --space-4 is 32px."
        }
      },
      "24": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Measured. main padding-inline 48px at 1440px. --gut resolves to 48px there. The sign-in shell padding is 48px."
        }
      }
    },
    "motion": {
      "duration": {
        "fast": {
          "$type": "duration",
          "$value": "150ms",
          "$extensions": {
            "source": "Declared. prompt and attach controls use 0.15s."
          }
        },
        "base": {
          "$type": "duration",
          "$value": "200ms",
          "$extensions": {
            "source": "Declared. .-pVNbW_btn, .YcErSW_link and .yDvB9G_chip transition in 0.2s."
          }
        },
        "nav": {
          "$type": "duration",
          "$value": "250ms",
          "$extensions": {
            "source": "Declared. .YcErSW_nav border-color .25s."
          }
        },
        "slow": {
          "$type": "duration",
          "$value": "800ms",
          "$extensions": {
            "source": "Declared. .gmmB4W_media video transform .8s."
          }
        }
      },
      "easing": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.2, 0.8, 0.2, 1],
          "$extensions": {
            "source": "Declared. cubic-bezier(.2,.8,.2,1) on chip-row transform and media video transform."
          }
        },
        "emphasized": {
          "$type": "cubicBezier",
          "$value": [0.22, 1, 0.36, 1],
          "$extensions": {
            "source": "Declared. --dv-ease: cubic-bezier(.22, 1, .36, 1)."
          }
        }
      },
      "$extensions": {
        "reducedMotion": "honours",
        "source": "Declared. .-pVNbW_root sets transition and animation to none under prefers-reduced-motion: reduce. Emulation was not run."
      }
    }
  },
  "dark": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "Measured. document.body background-color rgb(0, 0, 0). --ink is #000. --color-bg is #000."
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#101010",
        "$extensions": {
          "source": "Measured. .PvLRtq_card.PvLRtq_popular background rgb(16, 16, 16). --panel is #101010."
        }
      },
      "nav": {
        "$type": "color",
        "$value": "#000000d1",
        "$extensions": {
          "source": "Measured. header background color(srgb 0 0 0 / 0.82), written as #000000d1. Declared as color-mix(in srgb, var(--ink) 82%, transparent)."
        }
      },
      "action": {
        "$type": "color",
        "$value": "#eeeeee",
        "$extensions": {
          "source": "Measured. a.-pVNbW_btnSolid background rgb(238, 238, 238). --fg is #eee."
        }
      },
      "action-hover": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Declared. .-pVNbW_btnSolid:hover sets background #fff. Not hovered in the live tab."
        }
      },
      "chip": {
        "$type": "color",
        "$value": "#ffffff0f",
        "$extensions": {
          "source": "Declared. .yDvB9G_chip background #ffffff0f. Computed rgba(255, 255, 255, 0.06)."
        }
      },
      "app": {
        "$type": "color",
        "$value": "#1e1e1e",
        "$extensions": {
          "source": "Measured. document.body background rgb(30, 30, 30) on https://app.spline.design/signin. --color-background is #1e1e1e."
        }
      },
      "input": {
        "$type": "color",
        "$value": "#ffffff0d",
        "$extensions": {
          "source": "Measured. the email field background rgba(255, 255, 255, 0.05). --color-input-bg is #ffffff0d."
        }
      },
      "app-action": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Measured. the Next button on the name step, background rgb(255, 255, 255), text rgb(26, 26, 26)."
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#eeeeee",
        "$extensions": {
          "source": "Measured. header and footer color rgb(238, 238, 238). --fg is #eee."
        }
      },
      "heading": {
        "$type": "color",
        "$value": "#ffffffe6",
        "$extensions": {
          "source": "Measured. h1 color rgba(255, 255, 255, 0.9)."
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#8a8a8a",
        "$extensions": {
          "source": "Measured. hero paragraph and nav link color rgb(138, 138, 138). --mute is #8a8a8a."
        }
      },
      "on-action": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "Measured. the solid button color rgb(0, 0, 0). --ink is #000."
        }
      },
      "app": {
        "$type": "color",
        "$value": "#ffffffeb",
        "$extensions": {
          "source": "Measured. sign-in body color rgba(255, 255, 255, 0.92). --color-text-primary is #ffffffeb."
        }
      },
      "app-secondary": {
        "$type": "color",
        "$value": "#ffffff85",
        "$extensions": {
          "source": "Measured. sign-in subcopy rgba(255, 255, 255, 0.52). --color-text-tertiary is #ffffff85."
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "#ffffff61",
        "$extensions": {
          "source": "Measured. email placeholder rgba(255, 255, 255, 0.38). --color-text-placeholder is #ffffff61."
        }
      }
    },
    "border": {
      "stroke": {
        "$type": "color",
        "$value": "#2e2e2e",
        "$extensions": {
          "source": "Measured. the Talk to sales button border rgb(46, 46, 46). --line-2 is #2e2e2e."
        }
      },
      "subtle": {
        "$type": "color",
        "$value": "#1e1e1e",
        "$extensions": {
          "source": "Declared. --line is #1e1e1e. Used on .gmmB4W_media."
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#8eb2f2",
        "$extensions": {
          "source": "Declared. :focus-visible outline is 1.5px solid var(--steel). --steel is #8eb2f2. Not focused in the live tab."
        }
      },
      "app": {
        "$type": "color",
        "$value": "#ffffff0d",
        "$extensions": {
          "source": "Declared. --border-color and --color-separators are #ffffff0d on the app shell."
        }
      }
    },
    "status": {
      "accent": {
        "$type": "color",
        "$value": "#2589ff",
        "$extensions": {
          "source": "Measured. the news checkbox background rgb(37, 137, 255). --color-main is #2589ff."
        }
      },
      "success": {
        "$type": "color",
        "$value": "#00a376",
        "$extensions": {
          "source": "Declared. --color-super and --success-solid-background are #00a376. The yearly save note uses this green in the screenshot. The badge fill itself was measured as #bfdec4."
        }
      },
      "success-badge": {
        "$type": "color",
        "$value": "#bfdec4",
        "$extensions": {
          "source": "Measured. .WaODtW_save background rgb(191, 222, 196), text rgb(32, 58, 38)."
        }
      },
      "success-badge-text": {
        "$type": "color",
        "$value": "#203a26",
        "$extensions": {
          "source": "Measured. .WaODtW_save color rgb(32, 58, 38). --sage-900 is #203a26."
        }
      },
      "danger": {
        "$type": "color",
        "$value": "#fd585b",
        "$extensions": {
          "source": "Declared. --color-red is #fd585b on the marketing root. The app shell uses #fd5b5d. Not shown in an error state."
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#ffb01f",
        "$extensions": {
          "source": "Declared. --color-yellow is #ffb01f on the marketing root."
        }
      }
    },
    "component": {
      "button": {
        "bg": {
          "$type": "color",
          "$value": "{dark.background.action}",
          "$extensions": {
            "source": "Measured. solid button background."
          }
        },
        "text": {
          "$type": "color",
          "$value": "{dark.text.on-action}",
          "$extensions": {
            "source": "Measured. solid button text."
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{core.radius.pill}",
          "$extensions": {
            "source": "Measured. solid button border-radius 999px."
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "44px",
          "$extensions": {
            "source": "Measured. a.-pVNbW_btn height 44px. The small nav button is 34px."
          }
        },
        "padding": {
          "$type": "dimension",
          "$value": "20px",
          "$extensions": {
            "source": "Measured. solid button padding-inline 20px."
          }
        }
      },
      "field": {
        "bg": {
          "$type": "color",
          "$value": "{dark.background.input}",
          "$extensions": {
            "source": "Measured. email field background."
          }
        },
        "text": {
          "$type": "color",
          "$value": "#ffffffb3",
          "$extensions": {
            "source": "Measured. email field color rgba(255, 255, 255, 0.7)."
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{core.radius.control}",
          "$extensions": {
            "source": "Measured. email field border-radius 8px."
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "40px",
          "$extensions": {
            "source": "Measured. email field height 40px."
          }
        },
        "padding": {
          "$type": "dimension",
          "$value": "16px",
          "$extensions": {
            "source": "Measured. email field padding 4px 16px."
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "core": "enabled",
        "dark": "enabled"
      }
    }
  ]
}
