{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "motif-accent": {
        "$value": "#1e69f6",
        "$type": "color",
        "$extensions": { "source": "css custom property --motif-accent-1 on :root, read 2026-11-22" }
      },
      "download-blue": {
        "$value": "#1348dc",
        "$type": "color",
        "$extensions": { "source": "sampled from the full-colour homepage PNG before quantize, Download now fill, pixel (19, 72, 220)" }
      },
      "footer-blue": {
        "$value": "#164adc",
        "$type": "color",
        "$extensions": { "source": "sampled from the full-colour download PNG before quantize, footer band, pixel (22, 74, 220)" }
      }
    },
    "font": {
      "family": {
        "body": {
          "$value": "writer, writer Fallback",
          "$type": "fontFamily",
          "$extensions": { "source": "computed font-family on body at 1440" }
        },
        "display": {
          "$value": "plexSerif, plexSerif Fallback",
          "$type": "fontFamily",
          "$extensions": { "source": "computed font-family on the homepage h1 at 1440" }
        }
      }
    },
    "typography": {
      "h1": {
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "48px",
          "fontWeight": "320",
          "lineHeight": "57.6px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of h1 on https://zed.dev/ at 1440" }
      },
      "button": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "20px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of Download now at 1440" }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "20px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of the Docs nav link at 1440" }
      }
    },
    "radius": {
      "button": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of Download now and Clone source" }
      }
    }
  },
  "dark": {
    "page": {
      "$value": "#141519",
      "$type": "color",
      "$extensions": { "source": "computed background-color of body, rgb(17, 18, 22), confirmed by a flat pixel (20, 21, 25) in the full-colour homepage PNG" }
    },
    "text": {
      "$value": "oklch(0.747396 0.0150116 262.882)",
      "$type": "color",
      "$extensions": { "source": "computed color of body in the dark scheme" }
    },
    "text-strong": {
      "$value": "oklch(0.915795 0.00503706 262.882)",
      "$type": "color",
      "$extensions": { "source": "computed color of the Docs nav link and Clone source label" }
    },
    "on-accent": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": { "source": "computed color of Download now, rgb(255, 255, 255)" }
    },
    "accent": {
      "$value": "{core.color.download-blue}",
      "$type": "color",
      "$extensions": { "source": "Download now fill. Computed as lab(36.3314 31.1715 -81.0014). The sampled pixel is #1348dc." }
    },
    "h1": {
      "$value": "lab(77.5052 -6.4629 -36.42)",
      "$type": "color",
      "$extensions": { "source": "computed color of the homepage h1 in the dark scheme" }
    }
  },
  "light": {
    "page": {
      "$value": "#f4f4f2",
      "$type": "color",
      "$extensions": { "source": "sampled from the full-colour light homepage PNG, pixel (244, 244, 242). Computed body background was oklab(0.846996 0.000175841 0.0101865 / 0.2) over that page." }
    },
    "h1": {
      "$value": "lab(36.3314 31.1715 -81.0014)",
      "$type": "color",
      "$extensions": { "source": "computed color of the homepage h1 when prefers-color-scheme is light. Same lab value as the dark Download now fill." }
    },
    "accent": {
      "$value": "{core.color.download-blue}",
      "$type": "color",
      "$extensions": { "source": "Download now stays blue in the light shot. Not re-sampled as a separate pixel." }
    }
  }
}
