{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Helvetica for Target, Helvetica Neue, Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-family on body at https://www.target.com/, 2026-11-22"
            }
          }
        }
      },
      "size": {
        "body": {
          "$type": "dimension",
          "$value": "16px",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-size on body, and published --typography-font-size-150"
            }
          }
        },
        "caption": {
          "$type": "dimension",
          "$value": "13px",
          "$extensions": {
            "source": {
              "evidence": "Published",
              "capture": "Custom property --typography-font-size-050 on https://www.target.com/"
            }
          }
        },
        "display": {
          "$type": "dimension",
          "$value": "56px",
          "$extensions": {
            "source": {
              "evidence": "Published",
              "capture": "Custom property --typography-font-size-800 on https://www.target.com/"
            }
          }
        }
      },
      "weight": {
        "regular": {
          "$type": "fontWeight",
          "$value": 400,
          "$extensions": {
            "source": {
              "evidence": "Published",
              "capture": "Custom property --typography-font-weight-regular"
            }
          }
        },
        "bold": {
          "$type": "fontWeight",
          "$value": 700,
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed font-weight 700 on the footer Sign up button and on h1"
            }
          }
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius on the search wrap and the footer Sign up button. Published --radius-button is var(--_ref-measurement-radius-max), 999px"
          }
        }
      },
      "input": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --radius-input is var(--_ref-measurement-radius-x2), 8px"
          }
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --radius-card is var(--_ref-measurement-radius-x4), 16px"
          }
        }
      }
    },
    "space": {
      "x1": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --_ref-measurement-space-x1"
          }
        }
      },
      "x4": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --_ref-measurement-space-x4, also --space-margin-page-sm"
          }
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed body background-color rgb(255, 255, 255). Published --color-background-page-base is var(--_ref-color-white)"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#333333",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed body color rgb(51, 51, 51). Published --color-text-base is var(--_ref-color-gray-700)"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#666666",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-text-subdued is var(--_ref-color-gray-500), #666"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#cc0000",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-color rgb(204, 0, 0) on the footer Sign up button. Published --color-background-brand-base is var(--_ref-color-red-600), #c00"
          }
        }
      },
      "accentHover": {
        "$type": "color",
        "$value": "#aa0000",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-background-brand-base-hover is var(--_ref-color-red-700), #a00. Not held under a pointer"
          }
        }
      },
      "onAccent": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(255, 255, 255) on the footer Sign up button"
          }
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#f7f7f7",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-color rgb(247, 247, 247) on the search wrap. Published --color-background-subdued is var(--_ref-color-gray-050)"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "#888888",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-border-base is var(--_ref-color-gray-400), #888"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#151515",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-border-focus is var(--_ref-color-gray-950), #151515"
          }
        }
      },
      "success": {
        "$type": "color",
        "$value": "#008300",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-text-success is var(--_ref-color-green-600). No live success state was shown"
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#b85300",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-text-warning is var(--_ref-color-orange-600). No live warning state was shown"
          }
        }
      },
      "info": {
        "$type": "color",
        "$value": "#2758b9",
        "$extensions": {
          "source": {
            "evidence": "Published",
            "capture": "Custom property --color-text-info is var(--_ref-color-blue-600). No live info state was shown"
          }
        }
      }
    }
  }
}
