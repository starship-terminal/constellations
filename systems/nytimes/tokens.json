{
  "core": {
    "color": {
      "ink": {
        "$type": "color",
        "$value": "#121212",
        "$extensions": {
          "source": "computed --tpl-color-content-primary on :root"
        }
      },
      "body": {
        "$type": "color",
        "$value": "#363636",
        "$extensions": {
          "source": "computed --tpl-color-content-primary-dim"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#5a5a5a",
        "$extensions": {
          "source": "computed --tpl-color-content-secondary"
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#727272",
        "$extensions": {
          "source": "computed --tpl-color-content-secondary-dim"
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "#8b8b8b",
        "$extensions": {
          "source": "computed --tpl-color-content-placeholder"
        }
      },
      "paper": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "computed --tpl-color-background-primary"
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#f8f8f8",
        "$extensions": {
          "source": "computed --tpl-color-background-secondary"
        }
      },
      "surface-tertiary": {
        "$type": "color",
        "$value": "#ebebeb",
        "$extensions": {
          "source": "computed --tpl-color-background-tertiary"
        }
      },
      "highlight": {
        "$type": "color",
        "$value": "#fefad1",
        "$extensions": {
          "source": "computed --tpl-color-background-highlight"
        }
      },
      "scrim": {
        "$type": "color",
        "$value": "#12121299",
        "$extensions": {
          "source": "computed --tpl-color-background-scrim"
        }
      },
      "hairline": {
        "$type": "color",
        "$value": "#dfdfdf",
        "$extensions": {
          "source": "computed --tpl-color-stroke-tertiary"
        }
      },
      "stroke": {
        "$type": "color",
        "$value": "#959595",
        "$extensions": {
          "source": "computed --tpl-color-stroke-secondary"
        }
      },
      "rule": {
        "$type": "color",
        "$value": "#121212",
        "$extensions": {
          "source": "computed --tpl-color-stroke-primary"
        }
      },
      "link": {
        "$type": "color",
        "$value": "#346eb7",
        "$extensions": {
          "source": "computed --tpl-color-content-accent"
        }
      },
      "editorial": {
        "$type": "color",
        "$value": "#326891",
        "$extensions": {
          "source": "computed --color-signal-editorial"
        }
      },
      "positive": {
        "$type": "color",
        "$value": "#267c30",
        "$extensions": {
          "source": "computed --tpl-color-content-positive"
        }
      },
      "negative": {
        "$type": "color",
        "$value": "#a90111",
        "$extensions": {
          "source": "computed --tpl-color-content-negative"
        }
      },
      "breaking": {
        "$type": "color",
        "$value": "#d0021b",
        "$extensions": {
          "source": "computed --tpl-color-content-breaking"
        }
      },
      "developing": {
        "$type": "color",
        "$value": "#e6540a",
        "$extensions": {
          "source": "computed --color-signal-developing"
        }
      },
      "signal-accent": {
        "$type": "color",
        "$value": "#2671dc",
        "$extensions": {
          "source": "computed --color-signal-accent"
        }
      },
      "emphasis": {
        "$type": "color",
        "$value": "#121212",
        "$extensions": {
          "source": "computed --tpl-theme-button-emphasis-background-color"
        }
      },
      "emphasis-fg": {
        "$type": "color",
        "$value": "#f8f8f8",
        "$extensions": {
          "source": "computed --tpl-theme-button-emphasis-content-color"
        }
      },
      "go": {
        "$type": "color",
        "$value": "#567b95",
        "$extensions": {
          "source": "computed background of the enabled Go button after typing in the masthead search, saved page"
        }
      },
      "go-border": {
        "$type": "color",
        "$value": "#326891",
        "$extensions": {
          "source": "computed border-color of that Go button"
        }
      }
    },
    "font": {
      "franklin": {
        "$type": "fontFamily",
        "$value": "nyt-franklin, helvetica, arial, sans-serif",
        "$extensions": {
          "source": "computed --tpl-font-family-franklin"
        }
      },
      "cheltenham": {
        "$type": "fontFamily",
        "$value": "nyt-cheltenham-small, georgia, times new roman, times, serif",
        "$extensions": {
          "source": "computed --tpl-font-family-cheltenham-sh"
        }
      },
      "imperial": {
        "$type": "fontFamily",
        "$value": "nyt-imperial, georgia, times new roman, times, serif",
        "$extensions": {
          "source": "computed --tpl-font-family-imperial"
        }
      },
      "karnak": {
        "$type": "fontFamily",
        "$value": "nyt-karnak, georgia, times new roman, times, serif",
        "$extensions": {
          "source": "computed --tpl-font-family-karnak"
        }
      }
    },
    "typography": {
      "greeting": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.franklin}",
          "fontSize": "32px",
          "fontWeight": 600,
          "lineHeight": "38.4px"
        },
        "$extensions": {
          "source": "computed h1 on /account"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.franklin}",
          "fontSize": "18px",
          "fontWeight": 700,
          "lineHeight": "27px"
        },
        "$extensions": {
          "source": "computed selected Account nav link"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.franklin}",
          "fontSize": "16px",
          "fontWeight": 500,
          "lineHeight": "20.8px"
        },
        "$extensions": {
          "source": "computed Update link on /account"
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": "1rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "2rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": "3rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": "4rem",
        "$extensions": {
          "source": "computed --tpl-size-spacing-*"
        }
      }
    },
    "radius": {
      "dialog": {
        "$type": "dimension",
        "$value": "3px",
        "$extensions": {
          "source": "computed --tpl-theme-dialog-corner-radius, --tpl-theme-tile-corner-radius, dialog shadow parts, section drawer getBoundingClientRect"
        }
      },
      "tile": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "computed --tpl-theme-dialog-corner-radius, --tpl-theme-tile-corner-radius, dialog shadow parts, section drawer getBoundingClientRect"
        }
      },
      "search": {
        "$type": "dimension",
        "$value": "3px",
        "$extensions": {
          "source": "computed masthead search textbox"
        }
      }
    }
  },
  "light": {
    "page": {
      "$type": "color",
      "$value": "{color.paper}",
      "$extensions": {
        "source": "alias of core.color.paper, the account page background"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{color.surface}",
      "$extensions": {
        "source": "alias of core.color.surface"
      }
    },
    "text": {
      "$type": "color",
      "$value": "{color.ink}",
      "$extensions": {
        "source": "alias of core.color.ink"
      }
    },
    "muted": {
      "$type": "color",
      "$value": "{color.body}",
      "$extensions": {
        "source": "alias of core.color.body, body text on the account page"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{color.link}",
      "$extensions": {
        "source": "alias of core.color.link"
      }
    },
    "border": {
      "$type": "color",
      "$value": "{color.hairline}",
      "$extensions": {
        "source": "alias of core.color.hairline"
      }
    },
    "component": {
      "button-emphasis-bg": {
        "$type": "color",
        "$value": "{color.emphasis}",
        "$extensions": {
          "source": "Connect and emphasis buttons"
        }
      },
      "button-emphasis-text": {
        "$type": "color",
        "$value": "{color.emphasis-fg}",
        "$extensions": {
          "source": "text on emphasis buttons"
        }
      },
      "button-bg": {
        "$type": "color",
        "$value": "{color.paper}",
        "$extensions": {
          "source": "outlined Disconnect button face"
        }
      },
      "button-text": {
        "$type": "color",
        "$value": "{color.ink}",
        "$extensions": {
          "source": "outlined button label"
        }
      },
      "button-border": {
        "$type": "color",
        "$value": "{color.rule}",
        "$extensions": {
          "source": "outlined button border"
        }
      },
      "link-text": {
        "$type": "color",
        "$value": "{color.ink}",
        "$extensions": {
          "source": "Update, Create, Manage links"
        }
      },
      "nav-selected-text": {
        "$type": "color",
        "$value": "{color.ink}",
        "$extensions": {
          "source": "selected account nav item"
        }
      },
      "search-go-bg": {
        "$type": "color",
        "$value": "{color.go}",
        "$extensions": {
          "source": "enabled masthead Go button"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
