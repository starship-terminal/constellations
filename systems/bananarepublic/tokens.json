{
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$description": "Photographed page fill. Body computed background was transparent.",
        "$extensions": {
          "source": "screenshot home-light-1440.png, body background rgba(0, 0, 0, 0)"
        }
      },
      "text": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Body and department text.",
        "$extensions": {
          "source": "getComputedStyle body color rgb(0, 0, 0)"
        }
      },
      "universal": {
        "$value": "#e9e8e3",
        "$type": "color",
        "$description": "Gap Inc. brand strip.",
        "$extensions": {
          "source": "getComputedStyle universal bar background rgb(233, 232, 227)"
        }
      },
      "promo": {
        "$value": "#000000",
        "$type": "color",
        "$description": "Sale ticker under the universal bar.",
        "$extensions": {
          "source": "getComputedStyle promo bar background rgb(0, 0, 0)"
        }
      },
      "promo-text": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle SHOP WOMEN color rgb(255, 255, 255)"
        }
      },
      "wordmark": {
        "$value": "#ad280a",
        "$type": "color",
        "$description": "Fill of the live wordmark SVG.",
        "$extensions": {
          "source": "icons/mark.svg path fill #AD280A"
        }
      },
      "search-rule": {
        "$value": "#5e5c5a",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle search border-bottom rgb(94, 92, 90)"
        }
      },
      "chip-line": {
        "$value": "#e5e4e4",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle Filter & Sort outline rgb(229, 228, 228)"
        }
      },
      "swatch-line": {
        "$value": "#999999",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle color swatch inner border rgb(153, 153, 153)"
        }
      },
      "badge": {
        "$value": "#f2f1ee",
        "$type": "color",
        "$description": "Best Seller chip, measured at 80% opacity over the photo.",
        "$extensions": {
          "source": "getComputedStyle Best Seller background rgba(242, 241, 238, 0.8)"
        }
      },
      "footer": {
        "$value": "#f2f1ee",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle #sitewide-footer background rgb(242, 241, 238)"
        }
      },
      "add-to-bag": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle Add to Bag background rgb(0, 0, 0). Not clicked."
        }
      },
      "on-add": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle Add to Bag color rgb(255, 255, 255)"
        }
      }
    },
    "font": {
      "ui": {
        "$value": "Lynstone, Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle body font-family"
        }
      },
      "department": {
        "$value": "Banana, serif",
        "$type": "fontFamily",
        "$description": "Computed as Banana v1 on GIFTS.",
        "$extensions": {
          "source": "getComputedStyle GIFTS font-family"
        }
      },
      "display": {
        "$value": "BananaSerif, Times New Roman, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle Holiday New Arrivals span font-family"
        }
      },
      "category": {
        "$value": "Linotype Didot BR, BananaSerif, Times New Roman, serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle SWEATERS title font-family"
        }
      }
    },
    "fontSize": {
      "universal": {
        "$value": "12px",
        "$type": "dimension"
      },
      "promo": {
        "$value": "12px",
        "$type": "dimension"
      },
      "department": {
        "$value": "14px",
        "$type": "dimension"
      },
      "search": {
        "$value": "14px",
        "$type": "dimension"
      },
      "hero": {
        "$value": "48px",
        "$type": "dimension"
      },
      "hero-button": {
        "$value": "12px",
        "$type": "dimension"
      },
      "category": {
        "$value": "72px",
        "$type": "dimension"
      },
      "product-title": {
        "$value": "18px",
        "$type": "dimension"
      },
      "product-price": {
        "$value": "14px",
        "$type": "dimension"
      },
      "card": {
        "$value": "12px",
        "$type": "dimension"
      },
      "footer-heading": {
        "$value": "16px",
        "$type": "dimension"
      }
    },
    "fontWeight": {
      "book": {
        "$value": "350",
        "$type": "fontWeight"
      },
      "regular": {
        "$value": "400",
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": "600",
        "$type": "fontWeight"
      },
      "display": {
        "$value": "300",
        "$type": "fontWeight"
      }
    },
    "letterSpacing": {
      "department": {
        "$value": "2px",
        "$type": "dimension"
      },
      "sale": {
        "$value": "1.68px",
        "$type": "dimension"
      },
      "promo": {
        "$value": "1px",
        "$type": "dimension"
      },
      "product-title": {
        "$value": "1px",
        "$type": "dimension"
      }
    },
    "size": {
      "header": {
        "$value": "184px",
        "$type": "dimension"
      },
      "universal-bar": {
        "$value": "46px",
        "$type": "dimension"
      },
      "promo-bar": {
        "$value": "48px",
        "$type": "dimension"
      },
      "nav-bar": {
        "$value": "90px",
        "$type": "dimension"
      },
      "search": {
        "$value": "32px",
        "$type": "dimension"
      },
      "hero-button": {
        "$value": "56px",
        "$type": "dimension"
      },
      "add-to-bag": {
        "$value": "56px",
        "$type": "dimension"
      },
      "filter-chip": {
        "$value": "38px",
        "$type": "dimension"
      },
      "size-chip": {
        "$value": "39px",
        "$type": "dimension"
      },
      "swatch": {
        "$value": "30px",
        "$type": "dimension"
      }
    },
    "radius": {
      "control": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "hero button, Add to Bag, search, size chip, and swatch all computed border-radius 0px"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color"
      },
      "surface": {
        "$value": "{core.color.footer}",
        "$type": "color",
        "$extensions": {
          "source": "No surface colour. Closest existing colour is core.color.footer."
        }
      },
      "text": {
        "$value": "{core.color.text}",
        "$type": "color"
      },
      "muted": {
        "$value": "{core.color.search-rule}",
        "$type": "color",
        "$extensions": {
          "source": "No muted colour. Closest existing colour is core.color.search-rule."
        }
      },
      "accent": {
        "$value": "{core.color.wordmark}",
        "$type": "color",
        "$extensions": {
          "source": "No accent colour. Closest existing colour is core.color.wordmark."
        }
      },
      "border": {
        "$value": "{core.color.chip-line}",
        "$type": "color",
        "$extensions": {
          "source": "No border colour. Closest existing colour is core.color.chip-line."
        }
      }
    }
  }
}
