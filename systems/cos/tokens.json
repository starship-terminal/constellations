{
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle body background rgb(255, 255, 255)"
        }
      },
      "ink": {
        "$value": "#080808",
        "$type": "color",
        "$description": "Body, wordmark, notice bar, footer, Add to Bag.",
        "$extensions": {
          "source": "getComputedStyle body color rgb(8, 8, 8)"
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle notice color rgb(255, 255, 255)"
        }
      },
      "notice": {
        "$value": "#080808",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle .notice-container background rgb(8, 8, 8)"
        }
      },
      "header": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle .header-top background rgb(255, 255, 255)"
        }
      },
      "wordmark": {
        "$value": "#080808",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle logo svg fill rgb(8, 8, 8)"
        }
      },
      "chip-line": {
        "$value": "#858585",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle size button border rgb(133, 133, 133)"
        }
      },
      "footer": {
        "$value": "#080808",
        "$type": "color",
        "$extensions": {
          "source": "getComputedStyle footer grid background rgb(8, 8, 8)"
        }
      }
    },
    "font": {
      "body": {
        "$value": "SIM_Regular",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle body fontFamily"
        }
      },
      "display": {
        "$value": "SuisseIntl",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle hero h5 and About h1 fontFamily"
        }
      },
      "button": {
        "$value": "SuisseIntl, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "getComputedStyle cookie Accept all fontFamily"
        }
      }
    },
    "size": {
      "notice": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "notice-container height"
        }
      },
      "header": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": {
          "source": ".header-top height"
        }
      },
      "logo": {
        "$value": "66px",
        "$type": "dimension",
        "$extensions": {
          "source": "logo width, height 22px"
        }
      },
      "add-to-bag": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": {
          "source": ".addToBag height, width 372px"
        }
      },
      "cookie-button": {
        "$value": "49px",
        "$type": "dimension",
        "$extensions": {
          "source": "Accept all height, width 450px"
        }
      }
    },
    "radius": {
      "control": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Add to Bag, size chip, cookie button border-radius"
        }
      }
    },
    "type": {
      "body": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "body font-size, tracking 0.48px"
        }
      },
      "nav": {
        "$value": "13px",
        "$type": "dimension",
        "$extensions": {
          "source": "WOMEN/MEN font-size, tracking 0.5px"
        }
      },
      "hero": {
        "$value": "35px",
        "$type": "dimension",
        "$extensions": {
          "source": "SHOP WOMEN h5 font-size, weight 700"
        }
      },
      "product": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "product h1 font-size, weight 600"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color"
      },
      "surface": {
        "$value": "{core.color.header}",
        "$type": "color",
        "$extensions": {
          "source": "No surface colour. Closest existing colour is core.color.header."
        }
      },
      "text": {
        "$value": "{core.color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "No text colour. Closest existing colour is core.color.ink."
        }
      },
      "muted": {
        "$value": "{core.color.chip-line}",
        "$type": "color",
        "$extensions": {
          "source": "No muted colour. Closest existing colour is core.color.chip-line."
        }
      },
      "accent": {
        "$value": "{core.color.notice}",
        "$type": "color",
        "$extensions": {
          "source": "No accent colour. Closest existing colour is core.color.notice."
        }
      },
      "border": {
        "$value": "{core.color.chip-line}",
        "$type": "color",
        "$extensions": {
          "source": "No border colour. Closest existing colour is core.color.chip-line."
        }
      }
    }
  }
}
