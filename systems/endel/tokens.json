{
  "core": {
    "color": {
      "neutral": {
        "black": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-black"
          },
          "$description": "The pure black every page paints on (#000, body's own fill and the header scrim's base)."
        },
        "800": {
          "$value": "#191919",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-1"
          },
          "$description": "#191919: card fills (accordion rows, the mini-player pill, the timer sheet) and the footer hairline."
        },
        "700": {
          "$value": "#262626",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-2"
          },
          "$description": "#262626: the default fill of every button and pill (Try Today, Sign In, Continue, OAuth, the scenario pills)."
        },
        "500": {
          "$value": "#808080",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-3"
          },
          "$description": "#808080: field borders, the hover/pressed fill of gray-2 buttons, the link focus ring, the volume track's empty half."
        },
        "300": {
          "$value": "#bfbfbf",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-4"
          },
          "$description": "#bfbfbf: muted text (footer headings and legal links, the accordion answer, the mini-player's time)."
        },
        "200": {
          "$value": "#e0e0e0",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-5"
          },
          "$description": "#e0e0e0: the lightest grey, the FREEMIUM account chip's label."
        },
        "white": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-white"
          },
          "$description": "#fff: text, strong borders (focused fields, the Unlock and Continue borders), the play button's fill."
        }
      },
      "accent": {
        "green": {
          "$value": "#82d133",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-green"
          },
          "$description": "#82d133, declared on both hosts' :root; nothing on the captured signed-out routes paints it."
        },
        "orange": {
          "$value": "#ff7a00",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-orange"
          },
          "$description": "#ff7a00, declared on both hosts' :root; nothing on the captured signed-out routes paints it."
        },
        "bright": {
          "$value": "#58ff5d",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-accent-green"
          },
          "$description": "#58ff5d, declared on app.endel.io's :root only; nothing on the captured signed-out routes paints it."
        },
        "brightHover": {
          "$value": "#3ee843",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-accent-green-hover"
          },
          "$description": "#3ee843, the hover state of --color-accent-green, declared on app.endel.io's :root only."
        }
      }
    },
    "font": {
      "size": {
        "h1": {
          "$value": "60px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --title-h1"
          },
          "$description": "60px display size (the Endel wordmark hero)."
        },
        "h2": {
          "$value": "44px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --title-h2"
          },
          "$description": "44px section titles."
        },
        "h3": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --title-h3"
          },
          "$description": "36px smaller headings — also the mobile display size (m-hero-title computes 36px)."
        },
        "h4": {
          "$value": "28px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --title-h4"
          },
          "$description": "28px minor headings and the player title."
        },
        "text1": {
          "$value": "22px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --text-1"
          },
          "$description": "22px lead text and big links/buttons (nav items, Try Now, button labels)."
        },
        "text2": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --text-2"
          },
          "$description": "18px secondary links (Learn More, footer links)."
        },
        "text3": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --text-3"
          },
          "$description": "16px base text and small button labels (header buttons)."
        },
        "text4": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --text-4"
          },
          "$description": "14px muted labels (footer headings, mini-player meta)."
        },
        "text5": {
          "$value": "10px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --text-5"
          },
          "$description": "10px microtext."
        }
      },
      "lineHeight": {
        "h1": {
          "$value": "72px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-h1"
          },
          "$description": "72px on the 60px display size."
        },
        "h2": {
          "$value": "56px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-h2"
          },
          "$description": "56px on h2."
        },
        "h3": {
          "$value": "42px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-h3"
          },
          "$description": "42px on h3."
        },
        "h4": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-h4"
          },
          "$description": "36px on h4."
        },
        "text1": {
          "$value": "28px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-text-1"
          },
          "$description": "28px on the 22px text."
        },
        "text2": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-text-2"
          },
          "$description": "24px on the 18px text."
        },
        "text3": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-text-3"
          },
          "$description": "24px on the 16px text."
        },
        "text4": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-text-4"
          },
          "$description": "20px on the 14px text."
        },
        "text5": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --line-height-text-5"
          },
          "$description": "14px on the 10px microtext."
        }
      },
      "family": {
        "sans": {
          "$value": "apercuPro, \"apercuPro Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of page-ground default (raw/components-computed.json); the apercuPro faces are @font-face declarations in the site and app bundles (fonts in raw/css-vars.json)"
          },
          "$description": "apercuPro plus the metric-matched 'apercuPro Fallback' (a local Arial face with override descriptors), the stack every captured marketing node uses."
        },
        "appSans": {
          "$value": "apercuProRegular, \"apercuProRegular Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of login-card default (raw/components-computed.json); the apercuPro faces are @font-face declarations in the site and app bundles (fonts in raw/css-vars.json)"
          },
          "$description": "apercuProRegular plus its metric-matched fallback — the web app's own body face (the app bundle declares a separate apercuProRegular @font-face at weight 400)."
        },
        "appMedium": {
          "$value": "apercuProMedium, \"apercuProMedium Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed textStyle.fontFamily of banner default (raw/components-computed.json); the apercuPro faces are @font-face declarations in the site and app bundles (fonts in raw/css-vars.json)"
          },
          "$description": "apercuProMedium plus its fallback — the app's second declared face (weight 500); the banner's promo text is set in it even though its computed fontWeight reads 400."
        }
      }
    },
    "layout": {
      "container": {
        "$value": "1280px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --max-width"
        },
        "$description": "The 1280px page column."
      },
      "gutter": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --gutter"
        },
        "$description": "The 64px side gutter inside the 1280px column."
      },
      "gap": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --gap"
        },
        "$description": "The 24px grid gap."
      },
      "cols": {
        "$value": 12,
        "$type": "number",
        "$extensions": {
          "source": "css-var --max-cols"
        },
        "$description": "The 12-column grid."
      },
      "col": {
        "1": {
          "$value": "74px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-1"
          },
          "$description": "The width of 1 column at the 1280px container (74px)."
        },
        "2": {
          "$value": "172px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-2"
          },
          "$description": "The width of 2 columns at the 1280px container (172px)."
        },
        "3": {
          "$value": "270px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-3"
          },
          "$description": "The width of 3 columns at the 1280px container (270px)."
        },
        "4": {
          "$value": "368px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-4"
          },
          "$description": "The width of 4 columns at the 1280px container (368px)."
        },
        "5": {
          "$value": "466px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-5"
          },
          "$description": "The width of 5 columns at the 1280px container (466px)."
        },
        "6": {
          "$value": "564px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-6"
          },
          "$description": "The width of 6 columns at the 1280px container (564px)."
        },
        "7": {
          "$value": "662px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-7"
          },
          "$description": "The width of 7 columns at the 1280px container (662px)."
        },
        "8": {
          "$value": "760px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-8"
          },
          "$description": "The width of 8 columns at the 1280px container (760px)."
        },
        "9": {
          "$value": "858px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-9"
          },
          "$description": "The width of 9 columns at the 1280px container (858px)."
        },
        "10": {
          "$value": "956px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-10"
          },
          "$description": "The width of 10 columns at the 1280px container (956px)."
        },
        "11": {
          "$value": "1054px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-11"
          },
          "$description": "The width of 11 columns at the 1280px container (1054px)."
        },
        "12": {
          "$value": "1152px",
          "$type": "dimension",
          "$extensions": {
            "source": "css-var --cols-12"
          },
          "$description": "The width of 12 columns at the 1280px container (1152px)."
        }
      }
    },
    "measured": {
      "titleTracking": {
        "$value": "0.35px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed letterSpacing of hero-title default (raw/components-computed.json)"
        },
        "$description": "The 0.35px tracking on the display sizes (h1-h3 share it)."
      },
      "linkHover": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of footer-link default (raw/components-computed.json)"
        },
        "$description": "Links keep their colour on hover — only an underline paints (the footer's legal line additionally steps #bfbfbf to white)."
      },
      "glowColour": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed boxShadow of btn-try hover (raw/components-computed.json)"
        },
        "$description": "The Try Today button keeps its white 15px glow through hover."
      },
      "sliderBase": {
        "$value": "#101010",
        "$type": "color",
        "$extensions": {
          "source": "computed color of volume default (raw/components-computed.json)"
        },
        "$description": "The volume slider's own colour #101010 (the track paints a white/gray-3 gradient over it)."
      },
      "mobileMenuLabel": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed fontSize of m-menu-button default (raw/components-computed.json)"
        },
        "$description": "The 12px label on the mobile Menu button."
      }
    },
    "shadow": {
      "glow": {
        "$value": [
          {
            "color": "#ffffff",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "15px",
            "spread": "0px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of btn-try default (raw/components-computed.json)"
        },
        "$description": "The white 0 0 15px glow on the Try Today button (kept through hover and press)."
      },
      "focusRing": {
        "$value": [
          {
            "color": "#666666",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "6px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of btn-signin focus-visible (raw/components-computed.json)"
        },
        "$description": "The product's keyboard focus ring on buttons: a #666666 6px spread shadow."
      },
      "focusRingLink": {
        "$value": [
          {
            "color": "#808080",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "4px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of press-logo focus-visible (raw/components-computed.json)"
        },
        "$description": "The focus ring on plain links and tiles: a #808080 4px spread shadow."
      }
    },
    "radius": {
      "basic": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of btn-try default (raw/components-computed.json)"
        },
        "$description": "The 12px corner of buttons, fields, accordion rows and the mobile menu button (the bundle's border-radius-basic)."
      },
      "full": {
        "$value": "100px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paint.0.radius of play-button default (raw/components-computed.json)"
        },
        "$description": "The 100px pill/circle corner (play and transport buttons, scenario pills, the mini-player pill; the bundle's border-radius-full)."
      },
      "sheet": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paint.0.radius of btn-explore default (raw/components-computed.json)"
        },
        "$description": "The 20px top corner of the player's bottom Explore sheet (20px 20px 0 0)."
      },
      "card": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of banner default (raw/components-computed.json)"
        },
        "$description": "The 24px corner of the explore carousel banner."
      },
      "dialog": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paint.2.radius of timer-dialog opened (raw/components-computed.json)"
        },
        "$description": "The 32px corner of the timer sheet."
      },
      "round": {
        "$value": "50%",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paint.0.radius of banner-dot default (raw/components-computed.json)"
        },
        "$description": "The 50% carousel dot."
      }
    },
    "duration": {
      "hover": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transitionDuration of btn-signin default (raw/components-computed.json)"
        },
        "$description": "The 200ms background/border transition on every button and accordion row."
      },
      "sheet": {
        "$value": "300ms",
        "$type": "duration",
        "$extensions": {
          "source": "declared slide-in-out/slide-out transition in the app bundle's CSSOM (raw/components-computed.json _meta.sheets)"
        },
        "$description": "The 300ms slide of the timer sheet and the mobile menu."
      }
    },
    "easing": {
      "standard": {
        "$value": [
          0.25,
          0.1,
          0.25,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "computed transitionTimingFunction of btn-signin default (raw/components-computed.json)"
        },
        "$description": "Plain ease on the hover transitions."
      },
      "sheetIn": {
        "$value": [
          0.25,
          0.46,
          0.45,
          0.94
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "declared .slide-in-out-enter animation in the app bundle's CSSOM (raw/components-computed.json _meta.sheets)"
        },
        "$description": "The sheet's entrance bezier."
      },
      "sheetOut": {
        "$value": [
          0.55,
          0.085,
          0.68,
          0.53
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "declared .slide-in-out-exit animation in the app bundle's CSSOM (raw/components-computed.json _meta.sheets)"
        },
        "$description": "The sheet's exit bezier."
      }
    },
    "gradient": {
      "headerScrim": {
        "$value": [
          {
            "color": "{color.neutral.black}",
            "position": 0
          },
          {
            "color": "rgba(0, 0, 0, 0.65)",
            "position": 0.5
          },
          {
            "color": "rgba(0, 0, 0, 0)",
            "position": 1
          }
        ],
        "$type": "gradient",
        "$extensions": {
          "source": "computed backgroundImage of header default (raw/components-computed.json)"
        },
        "$description": "The fade the fixed header paints over scrolled content."
      },
      "declaredScrim": {
        "$value": [
          {
            "color": "#181818",
            "position": 0
          },
          {
            "color": "rgba(0, 0, 0, 0)",
            "position": 1
          }
        ],
        "$type": "gradient",
        "$extensions": {
          "source": "declared --color-gradient-1 on :root (raw/css-vars.json); where it mounts was not identified on the captured routes"
        },
        "$description": "The bundle's #181818-to-transparent fade."
      }
    }
  },
  "dark": {
    "page": {
      "$value": "{color.neutral.black}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of page-ground default (raw/components-computed.json); same value as core.color.neutral.black"
      },
      "$description": "The pure black every captured route paints on (body's own fill)."
    },
    "text": {
      "$value": "{color.neutral.white}",
      "$type": "color",
      "$extensions": {
        "source": "computed color of hero-title default (raw/components-computed.json); same value as core.color.neutral.white"
      },
      "$description": "The display type's white; all captured text is white or a grey."
    },
    "muted": {
      "$value": "{color.neutral.300}",
      "$type": "color",
      "$extensions": {
        "source": "computed textStyle.color of footer-legal default (raw/components-computed.json); same value as core.color.neutral.300"
      },
      "$description": "Secondary text: footer legal links, accordion answers, the mini-player's time (#bfbfbf on the text node)."
    },
    "faint": {
      "$value": "{color.neutral.200}",
      "$type": "color",
      "$extensions": {
        "source": "computed textStyle.color of app-header default (raw/components-computed.json); same value as core.color.neutral.200"
      },
      "$description": "The lightest text grey, the FREEMIUM account chip's label (#e0e0e0)."
    },
    "surface": {
      "$value": "{color.neutral.800}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of accordion-title default (raw/components-computed.json); same value as core.color.neutral.800"
      },
      "$description": "The card fill, #191919 (accordion rows, the mini-player pill, the timer sheet)."
    },
    "surfaceRaised": {
      "$value": "{color.neutral.700}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of btn-signin default (raw/components-computed.json); same value as core.color.neutral.700"
      },
      "$description": "The control fill, #262626 (every button and pill at rest)."
    },
    "fillHover": {
      "$value": "{color.neutral.500}",
      "$type": "color",
      "$extensions": {
        "source": "computed backgroundColor of btn-signin hover (raw/components-computed.json); same value as core.color.neutral.500"
      },
      "$description": "The hover and pressed fill of gray-2 controls, #808080."
    },
    "border": {
      "$value": "{color.neutral.500}",
      "$type": "color",
      "$extensions": {
        "source": "computed borderTopColor of input-email-login default (raw/components-computed.json); same value as core.color.neutral.500"
      },
      "$description": "The resting field border, #808080."
    },
    "borderStrong": {
      "$value": "{color.neutral.white}",
      "$type": "color",
      "$extensions": {
        "source": "computed borderTopColor of input-email-login focused (raw/components-computed.json); same value as core.color.neutral.white"
      },
      "$description": "The focused-field and primary-action border, pure white."
    },
    "borderSubtle": {
      "$value": "{color.neutral.800}",
      "$type": "color",
      "$extensions": {
        "source": "computed paint.2.border of footer default (raw/components-computed.json); same value as core.color.neutral.800"
      },
      "$description": "The 1px hairline under the footer columns, #191919."
    },
    "bar": {
      "$value": "#2b2b2b",
      "$type": "color",
      "$extensions": {
        "source": "computed paint.0.bg of player-header default (raw/components-computed.json)"
      },
      "$description": "The player header's inner bar, #2b2b2b, a grey between gray-2 and gray-3 that no var names."
    },
