{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "oat": {
        "50": { "$value": "#fffcfa", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-50 declared #fffcfa" } },
        "100": { "$value": "#f9f8f6", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-100 declared #f9f8f6" } },
        "200": { "$value": "#f3f2ed", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-200 declared #f3f2ed" } },
        "400": { "$value": "#dad4c8", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-400 declared #dad4c8" } },
        "800": { "$value": "#55534e", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-800 declared #55534e" } },
        "950": { "$value": "#1b1a18", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--oat-950 declared #1b1a18" } }
      },
      "grey": {
        "50": { "$value": "#f7f8f9", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--grey-50 declared #f7f8f9" } },
        "200": { "$value": "#e6e8ec", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--grey-200 declared #e6e8ec" } },
        "500": { "$value": "#979da9", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--grey-500 declared #979da9" } },
        "700": { "$value": "#525a69", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--grey-700 declared #525a69" } },
        "900": { "$value": "#282c35", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--grey-900 declared #282c35" } }
      },
      "blueberry": {
        "400": { "$value": "#4ca8fd", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--blueberry-400 declared #4ca8fd" } },
        "500": { "$value": "#0382f7", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--blueberry-500 declared #0382f7" } },
        "600": { "$value": "#0667d9", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--blueberry-600 declared #0667d9" } }
      },
      "matcha": {
        "400": { "$value": "#3ece82", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--matcha-400 declared #3ece82" } },
        "500": { "$value": "#0dac65", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--matcha-500 declared #0dac65" } }
      },
      "lemon": {
        "400": { "$value": "#f8cc65", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--lemon-400 declared #f8cc65" } },
        "500": { "$value": "#fbbd41", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--lemon-500 declared #fbbd41" } }
      },
      "ube": {
        "500": { "$value": "#8b5cf6", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--ube-500 declared #8b5cf6" } }
      },
      "dragonfruit": {
        "500": { "$value": "#ff7ad5", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--dragonfruit-500 declared #ff7ad5" } }
      },
      "pomegranate": {
        "500": { "$value": "#e94d68", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--pomegranate-500 declared #e94d68" } }
      },
      "ink": { "$value": "#000000", "$type": "color", "$extensions": { "source": "css-var --_swatches---color--black declared #000" } },
      "paper": { "$value": "#fefdfb", "$type": "color", "$extensions": { "source": "css-var --loam---web-library---colors--background declared #fefdfb" } }
    },
    "font": {
      "family": {
        "ui": { "$value": "Roobertvf, Arial, sans-serif", "$type": "fontFamily", "$extensions": { "source": "css-var --_typography---fonts--primary-font" } },
        "mono": { "$value": "\"Roobert mono\", Arial, sans-serif", "$type": "fontFamily", "$extensions": { "source": "css-var --_typography---fonts--secondary-font" } }
      }
    },
    "radius": {
      "xs": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "derived from --loam---web-library_border-radius---radius-xs .5rem at 16px" } },
      "sm": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "derived from --_layout---radius--small .75rem at 16px" } },
      "md": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "derived from --loam---web-library_border-radius---radius-md 1rem" } },
      "lg": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "derived from --_layout---radius--regular 1.5rem" } },
      "xl": { "$value": "32px", "$type": "dimension", "$extensions": { "source": "derived from --_layout---radius--medium 2rem" } },
      "pill": { "$value": "999rem", "$type": "dimension", "$extensions": { "source": "css-var --loam---web-library_border-radius---rounded" } }
    },
    "space": {
      "1": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "computed padding on the nav trial button, 8px 16px" } },
      "2": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the nav trial button" } },
      "3": { "$value": "18px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the hero demo button" } }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "88px", "fontWeight": "575", "lineHeight": "88px", "letterSpacing": "-3.52px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on home h1 at 1440, matching --_typography---h1--font-size 5.5rem" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "1.4" },
        "$type": "typography",
        "$extensions": { "source": "computed body font-size 16px and --_typography---paragraph-regular--line-height 1.4" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "500", "lineHeight": "21px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the nav Start free trial link, 13.92px rounded" }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": { "$value": "{core.color.paper}", "$type": "color", "$extensions": { "source": "css-var --loam---web-library---colors--background #fefdfb. Body computed background was rgb(255, 255, 255) on the home document; the token is the declared page colour." } },
        "hero": { "$value": "#005c44", "$type": "color", "$extensions": { "source": "sampled flat fill on the home hero band at (200, 700) of the full-colour capture, before quantize" } },
        "card": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "sampled pricing card body, white, on pricing-light-default before quantize" } }
      },
      "text": {
        "primary": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "css-var --loam---web-library---colors--text #000 and computed body color rgb(0, 0, 0)" } },
        "onHero": { "$value": "#fefdfb", "$type": "color", "$extensions": { "source": "computed h1 color rgb(254, 253, 251)" } },
        "muted": { "$value": "{core.color.grey.700}", "$type": "color", "$extensions": { "source": "declared grey-700. Used as the muted role. Not read on a specific muted element." } }
      },
      "action": {
        "fill": { "$value": "#000000", "$type": "color", "$extensions": { "source": "computed background of the nav Start free trial link, rgb(0, 0, 0), and --loam---web-library---colors--primary-action #000" } },
        "onFill": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed color of the nav Start free trial link, rgb(255, 255, 255)" } },
        "demo": { "$value": "#cbd810", "$type": "color", "$extensions": { "source": "computed background of the hero Get a demo link, rgb(203, 216, 16)" } },
        "accent": { "$value": "#3859f9", "$type": "color", "$extensions": { "source": "css-var --loam---web-library---colors--primary-accent #3859f9. Painted on the Free plan card header." } },
        "auth": { "$value": "#0382f7", "$type": "color", "$extensions": { "source": "sampled Continue button on the login wall, rgb(3, 130, 247), matching --_swatches---color--blueberry-500" } }
      },
      "border": {
        "control": { "$value": "{core.color.grey.200}", "$type": "color", "$extensions": { "source": "declared grey-200. Field borders were not isolated from the login card." } }
      }
    },
    "component": {
      "buttonPrimary": {
        "radius": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the nav Start free trial link" } },
        "height": { "$value": "39px", "$type": "dimension", "$extensions": { "source": "computed height of the nav Start free trial link" } },
        "padding": { "$value": "8px 16px", "$type": "dimension", "$extensions": { "source": "computed padding of the nav Start free trial link" } }
      },
      "buttonDemo": {
        "radius": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the hero Get a demo link" } },
        "height": { "$value": "47px", "$type": "dimension", "$extensions": { "source": "computed height of the hero Get a demo link" } }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
