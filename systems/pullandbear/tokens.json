{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Body and header color rgb(0, 0, 0). Token --color-greyscale-1000."
        }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Body backgroundColor rgb(255, 255, 255). Token --color-greyscale-000."
        }
      },
      "text": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Company display and kicker color rgb(0, 0, 0)."
        }
      },
      "muted": {
        "$value": "#5a5a5a",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Company body paragraph color rgb(90, 90, 90). Token --color-greyscale-800."
        }
      },
      "promo": {
        "$value": "#71c5fa",
        "$type": "color",
        "$extensions": {
          "source": "Sampled rgb(113, 197, 250) from the Mix & Match bar in screenshots/category-light-1440.png."
        }
      },
      "link": {
        "$value": "#2d64e3",
        "$type": "color",
        "$extensions": {
          "source": "Named token --color-primary-blue. Promotions in the open menu is this blue. Not read from a computed style on that link."
        }
      },
      "sale": {
        "$value": "#cb2c3b",
        "$type": "color",
        "$extensions": {
          "source": "Sampled rgb(203, 44, 59) from the -44% chip in screenshots/footer-light-1440.png. Named token --color-semantic-default-red is #D24343."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Sampled rgb(255, 255, 255) from the wordmark on the homepage photograph."
        }
      }
    },
    "font": {
      "body": {
        "$value": "Neue Haas",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. Body fontFamily Neue Haas, Helvetica, Arial, sans-serif. Files are not in this package."
        }
      }
    },
    "size": {
      "body": { "$value": "16px", "$type": "dimension" },
      "search": { "$value": "13px", "$type": "dimension" },
      "kicker": { "$value": "22px", "$type": "dimension" },
      "display": { "$value": "46px", "$type": "dimension" },
      "prose": { "$value": "12px", "$type": "dimension" },
      "promo-bar": { "$value": "36px", "$type": "dimension" },
      "icon-button": { "$value": "24px", "$type": "dimension" },
      "search-field": { "$value": "128px", "$type": "dimension" }
    },
    "weight": {
      "regular": { "$value": "400", "$type": "fontWeight" },
      "high": { "$value": "600", "$type": "fontWeight" }
    },
    "tracking": {
      "base": { "$value": "0.7px", "$type": "dimension" }
    }
  }
}
