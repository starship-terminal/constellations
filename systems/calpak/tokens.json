{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#030303",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(3, 3, 3) and --color-black on https://www.calpaktravel.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#FFFDF3",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(255, 253, 243) and --color-white" }
      },
      "yellow": {
        "$value": "#F8F15F",
        "$type": "color",
        "$extensions": { "source": "--color-yellow and --color-accent. Painted Add to Bag and hero CTA are rgb(248, 241, 95)" }
      },
      "promo": {
        "$value": "#F8F05F",
        "$type": "color",
        "$extensions": { "source": "computed Global-e promo bar background rgb(248, 240, 95). Slightly off --color-yellow" }
      },
      "gray": {
        "$value": "#E5E7DF",
        "$type": "color",
        "$extensions": { "source": "--color-gray and --color-background-accent" }
      },
      "blue": {
        "$value": "#8FB9DB",
        "$type": "color",
        "$extensions": { "source": "--color-blue" }
      },
      "purple": {
        "$value": "#CBBCF2",
        "$type": "color",
        "$extensions": { "source": "--color-purple" }
      },
      "red": {
        "$value": "#D21A28",
        "$type": "color",
        "$extensions": { "source": "--color-red. Sale pills on the collection page are this red as a stroke" }
      },
      "on-accent": {
        "$value": "#030303",
        "$type": "color",
        "$extensions": { "source": "computed Add to Bag and hero CTA label rgb(3, 3, 3)" }
      },
      "on-hero": {
        "$value": "#FFFDF3",
        "$type": "color",
        "$extensions": { "source": "computed hero heading color rgb(255, 253, 243)" }
      }
    },
    "font": {
      "ui": {
        "$value": "\"Futura PT\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily and --font-sans. Futura PT 500 was loaded. The file is not in this package" }
      },
      "serif": {
        "$value": "Kyoto, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "--font-serif. Kyoto 500 was loaded. The file is not in this package" }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "48px", "fontWeight": 500, "lineHeight": "48px" },
        "$type": "typography",
        "$extensions": { "source": "computed collection h1, 48px. --h1-sans-size is 3rem" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "36px", "fontWeight": 500, "lineHeight": "40px" },
        "$type": "typography",
        "$extensions": { "source": "computed .hero-carousel--slide-heading, 36px, height 40px" }
      },
      "title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "28px", "fontWeight": 500, "lineHeight": "33.6px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1, 28px. --h3-sans-size is 1.75rem" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "23.4px" },
        "$type": "typography",
        "$extensions": { "source": "computed body, 18px, weight 500, line 1.3" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "20.8px" },
        "$type": "typography",
        "$extensions": { "source": "computed header nav link" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "16px" },
        "$type": "typography",
        "$extensions": { "source": "computed Add to Bag and hero CTA, --button-size 1rem" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "23px" },
        "$type": "typography",
        "$extensions": { "source": "computed .product-card--price" }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": { "source": "--radius-full. Computed search, hero CTA, Add to Bag, and collection chips" }
      },
      "sheet": {
        "$value": "5px",
        "$type": "dimension",
        "$extensions": { "source": "computed .header-bar--nav border-radius" }
      }
    },
    "spacing": {
      "promo": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": { "source": "--promo-height and computed promo bar height" }
      },
      "nav": {
        "$value": "53px",
        "$type": "dimension",
        "$extensions": { "source": "computed .header-bar--nav height. --header-height-inner is 3.3125rem" }
      },
      "logo": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": { "source": "computed logo link height. SVG is 70 by 14, rendered about 80 by 16" }
      },
      "button": {
        "$value": "47px",
        "$type": "dimension",
        "$extensions": { "source": "computed hero CTA and Add to Bag height" }
      },
      "section": {
        "$value": "60px",
        "$type": "dimension",
        "$extensions": { "source": "--section-margin 3.75rem" }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "alias" } },
      "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "alias" } },
      "surface": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "header nav sheet" } },
      "muted": { "$value": "{core.color.gray}", "$type": "color", "$extensions": { "source": "--color-gray" } },
      "accent": { "$value": "{core.color.yellow}", "$type": "color", "$extensions": { "source": "Add to Bag and hero CTA" } },
      "border": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "search field 1px border" } },
      "promo": { "$value": "{core.color.promo}", "$type": "color", "$extensions": { "source": "Global-e bar" } }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
