{
  "core": {
    "color": {
      "brand": {
        "primary": {
          "$value": "oklch(62.6% 0.11 185.333)",
          "$type": "color",
          "$description": "Primary teal. The hero and Sign up buttons paint this.",
          "$extensions": {
            "source": "css-var --color-primary, computed on :root at https://lottiefiles.com/ (raw/css-vars.json liveRoot)"
          }
        },
        "primary-hover": {
          "$value": "oklab(0.626 -0.109524 -0.0102239 / 0.9)",
          "$type": "color",
          "$description": "Primary at 90% opacity on hover. Left as the computed oklab string.",
          "$extensions": {
            "source": "computed backgroundColor of the Get started for free link while the pointer is over it (raw/components-computed.json button-primary hover)"
          }
        },
        "primary-srgb": {
          "$value": "#28aca2",
          "$type": "color",
          "$description": "Displayed sRGB of the primary fill. The token behind it is oklch.",
          "$extensions": {
            "source": "sampled sRGB from the raw (pre-quantize) home-light-default.png pixel on the Get started for free button, 2026-11-21"
          }
        }
      },
      "page": {
        "$value": "oklch(100% 0 0)",
        "$type": "color",
        "$description": "Page background.",
        "$extensions": {
          "source": "css-var --color-background, computed on :root"
        }
      },
      "surface": {
        "$value": "oklch(100% 0 0)",
        "$type": "color",
        "$description": "Card surface. Same as the page on the public marketing site.",
        "$extensions": {
          "source": "css-var --color-card, computed on :root"
        }
      },
      "faint": {
        "$value": "oklch(98.5% 0 0)",
        "$type": "color",
        "$description": "Search field and sidebar background.",
        "$extensions": {
          "source": "css-var --color-faint, computed on :root"
        }
      },
      "text": {
        "$value": "oklch(14.1% 0.005 285.823)",
        "$type": "color",
        "$description": "Primary text.",
        "$extensions": {
          "source": "css-var --color-foreground, computed on :root"
        }
      },
      "on-accent": {
        "$value": "oklch(98.5% 0 0)",
        "$type": "color",
        "$description": "Text on the primary button.",
        "$extensions": {
          "source": "css-var --color-primary-foreground, computed on :root"
        }
      },
      "muted": {
        "$value": "oklch(55.2% 0.016 285.938)",
        "$type": "color",
        "$description": "Secondary text and the search placeholder.",
        "$extensions": {
          "source": "css-var --color-muted-foreground, computed on :root"
        }
      },
      "border": {
        "$value": "oklch(92% 0.004 286.32)",
        "$type": "color",
        "$description": "Default border and the search outline.",
        "$extensions": {
          "source": "css-var --color-border, computed on :root"
        }
      },
      "accent-wash": {
        "$value": "oklch(96.7% 0.001 286.375)",
        "$type": "color",
        "$description": "Nav hover wash. Named accent in the CSS, not the teal brand.",
        "$extensions": {
          "source": "css-var --color-accent, computed on :root"
        }
      },
      "destructive": {
        "$value": "oklch(57.7% 0.245 27.325)",
        "$type": "color",
        "$description": "Destructive role. Not shown on a public confirmation dialog.",
        "$extensions": {
          "source": "css-var --color-destructive, computed on :root"
        }
      },
      "warning": {
        "$value": "oklch(70.5% 0.213 47.604)",
        "$type": "color",
        "$description": "Warning role declared in CSS. Not shown on a public form error.",
        "$extensions": {
          "source": "css-var --color-warning, computed on :root"
        }
      },
      "inverse": {
        "$value": "oklch(14.1% 0.005 285.823)",
        "$type": "color",
        "$description": "Inverse surface. Used by the footer band, not as a theme.",
        "$extensions": {
          "source": "css-var --color-background-inverse, computed on :root"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "\"Inter LF\", sans-serif",
          "$type": "fontFamily",
          "$description": "UI and control family.",
          "$extensions": {
            "source": "css-var --font-sans, computed on :root; also computed fontFamily of header buttons"
          }
        },
        "display": {
          "$value": "\"DM Sans LF\", \"DM Sans\", sans-serif",
          "$type": "fontFamily",
          "$description": "Display and hero body family.",
          "$extensions": {
            "source": "computed fontFamily of the home h1 and the hero paragraph, 2026-11-21"
          }
        },
        "mono": {
          "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
          "$type": "fontFamily",
          "$description": "Code family. Not shown in a public code block on the captured pages.",
          "$extensions": {
            "source": "css-var --font-mono, computed on :root"
          }
        }
      },
      "size": {
        "display": {
          "$value": "96px",
          "$type": "dimension",
          "$description": "Home display size.",
          "$extensions": {
            "source": "computed fontSize of the home h1"
          }
        },
        "hero": {
          "$value": "24px",
          "$type": "dimension",
          "$description": "Hero supporting line.",
          "$extensions": {
            "source": "computed fontSize of the hero paragraph"
          }
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$description": "Control and body size.",
          "$extensions": {
            "source": "computed fontSize of the hero CTA"
          }
        },
        "nav": {
          "$value": "14px",
          "$type": "dimension",
          "$description": "Header control size.",
          "$extensions": {
            "source": "computed fontSize of header nav and Sign up"
          }
        }
      },
      "weight": {
        "display": {
          "$value": 500,
          "$type": "fontWeight",
          "$description": "Display weight.",
          "$extensions": {
            "source": "computed fontWeight of the home h1"
          }
        },
        "control": {
          "$value": 500,
          "$type": "fontWeight",
          "$description": "Control weight.",
          "$extensions": {
            "source": "computed fontWeight of the hero CTA and Sign up"
          }
        }
      },
      "line-height": {
        "display": {
          "$value": "99.84px",
          "$type": "dimension",
          "$description": "Display line height.",
          "$extensions": {
            "source": "computed lineHeight of the home h1"
          }
        }
      },
      "letter-spacing": {
        "display": {
          "$value": "-4.8px",
          "$type": "dimension",
          "$description": "Display tracking.",
          "$extensions": {
            "source": "computed letterSpacing of the home h1"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$value": "12px",
        "$type": "dimension",
        "$description": "Hero button radius.",
        "$extensions": {
          "source": "computed borderRadius of the hero CTA"
        }
      },
      "nav": {
        "$value": "6px",
        "$type": "dimension",
        "$description": "Header control radius.",
        "$extensions": {
          "source": "computed borderRadius of Sign up and Log in"
        }
      },
      "md": {
        "$value": "0.5rem",
        "$type": "dimension",
        "$description": "Base radius token.",
        "$extensions": {
          "source": "css-var --radius, computed on :root"
        }
      }
    },
    "space": {
      "control-x": {
        "$value": "24px",
        "$type": "dimension",
        "$description": "Hero button horizontal padding.",
        "$extensions": {
          "source": "computed paddingLeft of the hero CTA"
        }
      },
      "nav-x": {
        "$value": "16px",
        "$type": "dimension",
        "$description": "Header control horizontal padding.",
        "$extensions": {
          "source": "computed paddingLeft of Sign up"
        }
      }
    },
    "size": {
      "control": {
        "$value": "48px",
        "$type": "dimension",
        "$description": "Hero button height.",
        "$extensions": {
          "source": "computed height of the hero CTA"
        }
      },
      "nav": {
        "$value": "36px",
        "$type": "dimension",
        "$description": "Header control height.",
        "$extensions": {
          "source": "computed height of Sign up and the search button"
        }
      }
    },
    "border": {
      "width": {
        "$value": "1px",
        "$type": "dimension",
        "$description": "Quiet button border.",
        "$extensions": {
          "source": "computed borderTopWidth of Log in and Get in touch"
        }
      }
    },
    "shadow": {
      "control": {
        "$value": {
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "color": "rgba(0, 0, 0, 0.05)"
        },
        "$type": "shadow",
        "$description": "The painted layer of the hero button shadow. The computed value also lists four transparent layers.",
        "$extensions": {
          "source": "computed boxShadow of Get started for free (raw/components-computed.json button-primary default)"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "{core.color.page}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.page"
      }
    },
    "surface": {
      "$value": "{core.color.surface}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.surface"
      }
    },
    "text": {
      "$value": "{core.color.text}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.text"
      }
    },
    "muted": {
      "$value": "{core.color.muted}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.muted"
      }
    },
    "accent": {
      "$value": "{core.color.brand.primary}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.brand.primary"
      }
    },
    "on-accent": {
      "$value": "{core.color.on-accent}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.on-accent"
      }
    },
    "border": {
      "$value": "{core.color.border}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.border"
      }
    },
    "component": {
      "button-primary": {
        "background": {
          "$value": "{core.color.brand.primary}",
          "$type": "color",
          "$extensions": {
            "source": "alias"
          }
        },
        "text": {
          "$value": "{core.color.on-accent}",
          "$type": "color",
          "$extensions": {
            "source": "alias"
          }
        },
        "radius": {
          "$value": "{core.radius.control}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        },
        "height": {
          "$value": "{core.size.control}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        }
      },
      "button-quiet": {
        "background": {
          "$value": "{core.color.page}",
          "$type": "color",
          "$extensions": {
            "source": "alias"
          }
        },
        "text": {
          "$value": "{core.color.text}",
          "$type": "color",
          "$extensions": {
            "source": "alias"
          }
        },
        "border": {
          "$value": "{core.color.border}",
          "$type": "color",
          "$extensions": {
            "source": "alias"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
