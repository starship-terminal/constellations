{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": {
        "$value": "#27272b",
        "$type": "color",
        "$extensions": {
          "source": "computed body color rgb(39, 39, 43) on https://ulysses.app/en/ on 2026-11-22"
        }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed body background rgb(255, 255, 255) on the homepage"
        }
      },
      "footer": {
        "$value": "#262626",
        "$type": "color",
        "$extensions": {
          "source": "computed footer background rgb(38, 38, 38) on the pricing page"
        }
      },
      "accent": {
        "$value": "#ffcc00",
        "$type": "color",
        "$extensions": {
          "source": "computed 2px border on the empty Log In submit, rgb(255, 204, 0). The stylesheet also declares --primary and --yellow as #fc0."
        }
      },
      "field": {
        "$value": "#f7f7f5",
        "$type": "color",
        "$extensions": {
          "source": "computed background of the empty email field on the login wall, rgb(247, 247, 245). Matches --light."
        }
      },
      "on-footer": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed footer color rgb(255, 255, 255)"
        }
      },
      "focus": {
        "$value": "#ffe680",
        "$type": "color",
        "$extensions": {
          "source": "computed 2px border on the focused empty email field, rgb(255, 230, 128)"
        }
      }
    },
    "font": {
      "family": {
        "ui": {
          "$value": "interstate, -apple-system, system-ui, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed body font-family on ulysses.app. Served by Adobe Typekit kit arm6quo. The font files are licensed and are not in this package."
          }
        }
      }
    },
    "radius": {
      "control": {
        "$value": "3px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the empty email field and the Log In submit"
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "48px",
          "fontWeight": "700",
          "lineHeight": "57.6px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the homepage h2 at 1440: The Ultimate Writing App for Mac, iPad and iPhone"
        }
      },
      "section": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "48px",
          "fontWeight": "700",
          "lineHeight": "49.92px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the first homepage h1. That heading paints white over a dark product photograph."
        }
      },
      "auth-title": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "30px",
          "fontWeight": "700",
          "lineHeight": "36px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the Log In h2"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "15px",
          "fontWeight": "400",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed body font-size, weight, and line-height"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "16px",
          "fontWeight": "500"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed Why Ulysses link at the preview width, 15.999px weight 500. Recorded as 16px."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color",
        "$extensions": {
          "source": "the public site paints a white page. color-scheme on the root was normal. No theme control was present."
        }
      },
      "text": {
        "$value": "{core.color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "computed body color"
        }
      },
      "action": {
        "$value": "{core.color.accent}",
        "$type": "color",
        "$extensions": {
          "source": "the public action is a yellow outline, not a filled pill. The Log In submit and the 404 Back to Homepage control both paint a 2px #ffcc00 border on a transparent fill."
        }
      },
      "footer": {
        "$value": "{core.color.footer}",
        "$type": "color",
        "$extensions": {
          "source": "computed footer background"
        }
      }
    }
  }
}
