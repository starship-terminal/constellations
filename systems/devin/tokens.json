{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": { "$value": "#191919", "$type": "color", "$extensions": { "source": "css-var --color-text-primary rgb(25, 25, 25) and --color-legacy-black #191919" } },
      "black": { "$value": "#000000", "$type": "color", "$extensions": { "source": "css-var --color-black #000, computed Get started fill" } },
      "paper": { "$value": "#fcfcfc", "$type": "color", "$extensions": { "source": "css-var --color-bg-page rgb(252, 252, 252) and --color-legacy-white #fcfcfc" } },
      "surface": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "css-var --color-surface rgb(255, 255, 255)" } },
      "accent": { "$value": "#317cff", "$type": "color", "$extensions": { "source": "css-var --color-accent rgb(49, 124, 255)" } },
      "border": { "$value": "#00000014", "$type": "color", "$extensions": { "source": "css-var --color-border-primary rgb(0 0 0 / .08)" } },
      "muted": { "$value": "#1919198f", "$type": "color", "$extensions": { "source": "css-var --color-text-secondary rgb(25 25 25 / .56)" } },
      "disabled": { "$value": "#19191966", "$type": "color", "$extensions": { "source": "css-var --color-text-disabled rgb(25 25 25 / .4)" } },
      "success": { "$value": "#00a558", "$type": "color", "$extensions": { "source": "css-var --color-text-green rgb(0, 165, 88)" } },
      "warning": { "$value": "#f58e3a", "$type": "color", "$extensions": { "source": "css-var --color-text-orange rgb(245, 142, 58)" } },
      "danger": { "$value": "#f53b3a", "$type": "color", "$extensions": { "source": "css-var --color-diff-removed rgb(245, 59, 58)" } },
      "info": { "$value": "#337df4", "$type": "color", "$extensions": { "source": "css-var --color-text-blue rgb(51, 125, 244)" } },
      "on-accent": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed color on the black Get started link" } }
    },
    "font": {
      "family": {
        "ui": { "$value": "skandia, system-ui, sans-serif", "$type": "fontFamily", "$extensions": { "source": "css-var --font-body and computed body font" } },
        "product": { "$value": "Inter, sans-serif", "$type": "fontFamily", "$extensions": { "source": "css-var --font-product-sans, computed on the auth wall" } },
        "mono": { "$value": "geistMono, ui-monospace, monospace", "$type": "fontFamily", "$extensions": { "source": "css-var --font-mono" } },
        "serif": { "$value": "stkBureauSerif, Georgia, serif", "$type": "fontFamily", "$extensions": { "source": "css-var --font-serif" } }
      }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "css-var --radius-sm .25rem" } },
      "md": { "$value": "6px", "$type": "dimension", "$extensions": { "source": "css-var --radius-md .375rem" } },
      "lg": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "css-var --radius-lg .5rem" } },
      "xl": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "css-var --radius-xl .75rem" } },
      "2xl": { "$value": "16px", "$type": "dimension", "$extensions": { "source": "css-var --radius-2xl 1rem" } },
      "3xl": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "css-var --radius-3xl 1.5rem" } },
      "pill": { "$value": "9999px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the nav Get started link, a pill" } }
    },
    "space": {
      "1": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "css-var --spacing .25rem" } },
      "3": { "$value": "12px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the nav Get started link" } }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "64px", "fontWeight": "400", "lineHeight": "70.4px", "letterSpacing": "-1.92px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the pricing h1 at 1440, matching --text-dt-display 4rem" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "36px", "fontWeight": "400", "lineHeight": "43.2px", "letterSpacing": "-1.08px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the home h1 at 1440. The declared --text-dt-h1 is 4rem and was not the painted home heading." }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "1.4" },
        "$type": "typography",
        "$extensions": { "source": "computed body font-size 16px and --text-dt-body--line-height 1.4" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "21px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the nav Get started link" }
      }
    },
    "elevation": {
      "l1": { "$value": "0px 1px 2px 0px rgb(0 0 0 / .05)", "$type": "shadow", "$extensions": { "source": "css-var --shadow-L1" } },
      "l4": { "$value": "0px 25px 50px -12px rgb(0 0 0 / .25)", "$type": "shadow", "$extensions": { "source": "css-var --shadow-L4" } }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.paper}", "$type": "color", "$extensions": { "source": "the public site paints one light theme" } },
      "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "computed body and h1 color rgb(25, 25, 25)" } },
      "action": {
        "fill": { "$value": "{core.color.black}", "$type": "color", "$extensions": { "source": "computed Get started background" } },
        "label": { "$value": "{core.color.on-accent}", "$type": "color", "$extensions": { "source": "computed Get started color" } }
      },
      "accent": { "$value": "{core.color.accent}", "$type": "color", "$extensions": { "source": "declared --color-accent, painted on the 404 numeral and community heading" } }
    }
  }
}
