{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "body": {
        "$value": "RoundHog, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Computed font-family on the homepage body and the h1, 2026-11-22. The font file is not committed."
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "36px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed font-size of the homepage h1 at 1440"
        }
      },
      "nav": {
        "$value": "13px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed font-size of the Pricing link in the header"
        }
      },
      "button": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed font-size of Get started – free"
        }
      },
      "body": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed font-size of body"
        }
      }
    },
    "fontWeight": {
      "hero": {
        "$value": "800",
        "$type": "fontWeight",
        "$extensions": {
          "source": "Computed font-weight of the homepage h1"
        }
      },
      "nav": {
        "$value": "500",
        "$type": "fontWeight",
        "$extensions": {
          "source": "Computed font-weight of the Pricing link"
        }
      }
    },
    "lineHeight": {
      "hero": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed line-height of the homepage h1"
        }
      }
    },
    "letterSpacing": {
      "hero": {
        "$value": "-0.9px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed letter-spacing of the homepage h1"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed border-radius of Get started – free"
        }
      },
      "nav": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed border-radius of the Pricing link"
        }
      },
      "highlight": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "Computed border-radius of the blue highlight in the h1"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "#eeefe9",
        "$type": "color",
        "$extensions": {
          "source": "Computed background-color of body on the homepage, rgb(238, 239, 233)"
        }
      },
      "text": {
        "$value": "#111827",
        "$type": "color",
        "$extensions": {
          "source": "Computed color of the homepage h1, rgb(17, 24, 39)"
        }
      },
      "nav": {
        "$value": "#23251d",
        "$type": "color",
        "$extensions": {
          "source": "Computed color of the Pricing link and of Get started – free, rgb(35, 37, 29)"
        }
      },
      "accent": {
        "$value": "#cd8407",
        "$type": "color",
        "$extensions": {
          "source": "Computed background-color of Get started – free, rgb(205, 132, 7)"
        }
      },
      "accent-border": {
        "$value": "#b17816",
        "$type": "color",
        "$extensions": {
          "source": "Computed border-color of Get started – free, rgb(177, 120, 22)"
        }
      },
      "link": {
        "$value": "#2f80fa",
        "$type": "color",
        "$extensions": {
          "source": "Computed color of the highlighted words in the homepage h1, rgb(47, 128, 250)"
        }
      },
      "link-wash": {
        "$value": "#2f80fa1a",
        "$type": "color",
        "$extensions": {
          "source": "Computed background of that highlight, rgba(47, 128, 250, 0.1)"
        }
      },
      "wall": {
        "$value": "#f3f4f0",
        "$type": "color",
        "$extensions": {
          "source": "Computed background-color of body on the signup wall, rgb(243, 244, 240)"
        }
      },
      "wall-text": {
        "$value": "#111111",
        "$type": "color",
        "$extensions": {
          "source": "Computed color of the signup heading, rgb(17, 17, 17)"
        }
      }
    }
  }
}
