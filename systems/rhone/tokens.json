{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#1c1519",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(28, 21, 25) on https://www.rhone.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#fbf9f9",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(251, 249, 249)" }
      },
      "courtesy": {
        "$value": "#efedea",
        "$type": "color",
        "$extensions": { "source": "computed .courtesy-nav background rgb(239, 237, 234)" }
      },
      "line": {
        "$value": "#e3dfd9",
        "$type": "color",
        "$extensions": { "source": "computed .main-nav border rgb(227, 223, 217)" }
      },
      "olive": {
        "$value": "#617259",
        "$type": "color",
        "$extensions": { "source": "computed Bundle & save color rgb(97, 114, 89); same fill on the about olive band" }
      },
      "on-hero": {
        "$value": "#fbf9f9",
        "$type": "color",
        "$extensions": { "source": "computed homepage h1 color rgb(251, 249, 249)" }
      }
    },
    "font": {
      "ui": {
        "$value": "Denim, -apple-system, system-ui, Segoe UI, Helvetica Neue, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily; Denim 400 and 500 were loaded" }
      },
      "quote": {
        "$value": "Reckless, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Reckless 400 loaded; used on footer and review quotes. Fallback is not from the page." }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "56px", "fontWeight": 400, "lineHeight": "58px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h1" }
      },
      "heading": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "34px" },
        "$type": "typography",
        "$extensions": { "source": "computed about h2, 32px Denim 400" }
      },
      "title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "24px", "fontWeight": 500, "lineHeight": "26px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1 and collection h1" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "26px" },
        "$type": "typography",
        "$extensions": { "source": "computed Shop men's and Add to bag" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px" },
        "$type": "typography",
        "$extensions": { "source": "computed body and nav labels" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "16px" },
        "$type": "typography",
        "$extensions": { "source": "computed shipping bar 12px and breadcrumb 12px" }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed shop button, size chip, and search border-radius 0px" }
      }
    },
    "spacing": {
      "shipping": {
        "$value": "30px",
        "$type": "dimension",
        "$extensions": { "source": "shipping bar height" }
      },
      "courtesy": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": ".courtesy-nav height" }
      },
      "nav": {
        "$value": "68px",
        "$type": "dimension",
        "$extensions": { "source": "department row height inside the 101px header" }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "alias" } },
      "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "alias" } },
      "muted": { "$value": "{core.color.olive}", "$type": "color", "$extensions": { "source": "Bundle & save ink, used as the muted role" } },
      "accent": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Add to bag face" } },
      "border": { "$value": "{core.color.line}", "$type": "color", "$extensions": { "source": "alias" } },
      "surface": { "$value": "{core.color.courtesy}", "$type": "color", "$extensions": { "source": "courtesy bar, the only filled chrome surface besides the page" } },
      "on-accent": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "Add to bag label" } }
    },
    "component": {
      "button": {
        "primary": {
          "bg": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Add to bag" } },
          "text": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "Add to bag" } },
          "radius": { "$value": "{core.radius.none}", "$type": "dimension", "$extensions": { "source": "alias" } },
          "height": { "$value": "55px", "$type": "dimension", "$extensions": { "source": "Add to bag height" } }
        },
        "inverse": {
          "bg": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "Shop men's on the hero" } },
          "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Shop men's" } },
          "radius": { "$value": "{core.radius.none}", "$type": "dimension", "$extensions": { "source": "alias" } },
          "height": { "$value": "57px", "$type": "dimension", "$extensions": { "source": "Shop men's height" } }
        }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
