{
  "core": {
    "font": {
      "family": {
        "sans": {
          "$value": "Inter, \"Inter Fallback\", system-ui, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body (html class light, body class font-sans); @font-face Inter variable 100-900 in the Next stylesheet, src redacted to url(…)"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "81.4px",
          "fontWeight": 500,
          "lineHeight": "81.4px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured h1 on /for-agencies, computed font-size 81.4px / line-height 81.4px / weight 500"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "46.2px",
          "fontWeight": 500,
          "lineHeight": "46.2px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured h2 'Thanks for everything.' on /, computed 46.2px / 46.2px / 500"
        }
      },
      "price": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "66px",
          "fontWeight": 500,
          "lineHeight": "99px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured p.font-display '$0' on /pricing, computed 66px / 99px / 500"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "15px",
          "fontWeight": 400,
          "lineHeight": "22.5px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured first main paragraph on /, computed 15px / 22.5px / 400"
        }
      },
      "label": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "15.4px",
          "fontWeight": 500,
          "lineHeight": "22px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured nav link and Get Started button, computed 15.4px / 22px / 500 (14px at 110% root)"
        }
      },
      "caption": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "13.2px",
          "fontWeight": 500,
          "lineHeight": "17.6px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "measured archive banner and Popular badge, computed 13.2px / 17.6px / 500 (12px at 110% root)"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured banner and headings, border-radius 0px"
        }
      },
      "md": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured demo iframe, border-radius 12px"
        }
      },
      "lg": {
        "$value": "17.6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed .rounded-lg on a probe div, 17.6px (calc(var(--radius) * 1) at 110% root; --radius is 1rem)"
        }
      },
      "full": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured Get Started, Pay Annually and Popular, border-radius 9999px"
        }
      }
    },
    "space": {
      "1": {
        "$value": "4.4px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived: 0.25rem at the measured 17.6px root (110%). Tailwind step, not a named Marathon token"
        }
      },
      "2": {
        "$value": "8.8px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured segment padding-top 8.8px and badge padding-right 8.8px"
        }
      },
      "3": {
        "$value": "13.2px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured banner padding-top 13.2px and primary button padding-right 13.2px"
        }
      },
      "4": {
        "$value": "17.6px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured banner padding-right 17.6px (1rem at 110% root)"
        }
      },
      "5": {
        "$value": "22px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured segment padding-right 22px"
        }
      },
      "8": {
        "$value": "31.68px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured large Get Started padding-right 31.68px"
        }
      }
    },
    "size": {
      "controlSm": {
        "$value": "39.6px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured header Get Started and Pay Annually height 39.5938px, and the phone menu button 39.5938px"
        }
      },
      "controlMd": {
        "$value": "48.4px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured pricing and agencies Get Started height 48.3906px"
        }
      },
      "badge": {
        "$value": "22px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured Popular badge height 21.9688px"
        }
      },
      "banner": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured archive banner height 43.9688px"
        }
      },
      "icon": {
        "$value": "36px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured phone Open menu button width 39.6px; the painted glyph sits inside that circle. Icon file itself is the wordmark SVG"
        }
      }
    },
    "border": {
      "hairline": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "source": "header bottom border observed as a 1px hairline on the screenshots; cards use box-shadow 0 0 0 1px rather than a border-width"
        }
      }
    },
    "elevation": {
      "ring": {
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px",
            "color": "rgba(0, 0, 0, 0.1)"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "measured demo iframe box-shadow rgba(0, 0, 0, 0.1) 0px 0px 0px 1px"
        }
      }
    },
    "motion": {
      "duration": {
        "fast": {
          "$value": "150ms",
          "$type": "duration",
          "$extensions": {
            "source": "measured transition-duration 0.15s on nav links, buttons and the archive banner"
          }
        }
      },
      "easing": {
        "ease": {
          "$value": [
            0.25,
            0.1,
            0.25,
            1
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": "derived: computed transition-timing-function ease on those controls, expanded to the CSS keyword's control points"
          }
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "css-var --background (light); raw/css-vars.json"
      },
      "$description": "Page field. Computed on the public pages as white; the visible field reads slightly off-white from the body class, and the token is the declared variable."
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "css-var --card (light); raw/css-vars.json"
      }
    },
    "text": {
      "$value": "#0b0b0b",
      "$type": "color",
      "$extensions": {
        "source": "css-var --foreground (light); raw/css-vars.json"
      }
    },
    "textMuted": {
      "$value": "#717171",
      "$type": "color",
      "$extensions": {
        "source": "css-var --muted-foreground (light); raw/css-vars.json"
      }
    },
    "textOnAccent": {
      "$value": "#21240c",
      "$type": "color",
      "$extensions": {
        "source": "css-var --primary-foreground (light); raw/css-vars.json"
      }
    },
    "textLink": {
      "$value": "#0b0b0b",
      "$type": "color",
      "$extensions": {
        "source": "css-var --foreground (light); raw/css-vars.json; text links use the foreground colour and add an underline on hover; there is no separate link colour"
      }
    },
    "border": {
      "$value": "#e1e1e1",
      "$type": "color",
      "$extensions": {
        "source": "css-var --border (light); raw/css-vars.json"
      }
    },
    "borderStrong": {
      "$value": "#b7b7b7",
      "$type": "color",
      "$extensions": {
        "source": "css-var --input-focus (light); raw/css-vars.json"
      }
    },
    "focus": {
      "$value": "#005fcc",
      "$type": "color",
      "$extensions": {
        "source": "measured focus-visible outline-color rgb(0, 95, 204) on links and buttons. Browser default, not a Marathon custom property"
      }
    },
    "accent": {
      "$value": "#d7fd51",
      "$type": "color",
      "$extensions": {
        "source": "css-var --primary (light); raw/css-vars.json"
      }
    },
    "accentHover": {
      "$value": "#c8ee3a",
      "$type": "color",
      "$extensions": {
        "source": "css-var --primary-hover (light); raw/css-vars.json"
      },
      "$description": "Declared. The filled Get Started button hovers to #404040, not this lime."
    },
    "accentPressed": {
      "$value": "#c8ee3a",
      "$type": "color",
      "$extensions": {
        "source": "css-var --primary-hover (light); raw/css-vars.json; pressed uses the same declared hover token; CDP active+hover on the lime banner did not change its fill"
      }
    },
    "ink": {
      "$value": "#0b0b0b",
      "$type": "color",
      "$extensions": {
        "source": "css-var --foreground (light); raw/css-vars.json"
      },
      "$description": "Filled button face. Get Started, selected segment and Pro card button."
    },
    "inkHover": {
      "$value": "#404040",
      "$type": "color",
      "$extensions": {
        "source": "measured primary button hover and pressed background rgb(64, 64, 64)"
      }
    },
    "onInk": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "measured primary button color oklch(1 0 0), resolved #ffffff"
      }
    },
    "secondary": {
      "$value": "#f2f2f2",
      "$type": "color",
      "$extensions": {
        "source": "css-var --secondary (light); raw/css-vars.json"
      }
    },
    "secondaryHover": {
      "$value": "#e4e4e4",
      "$type": "color",
      "$extensions": {
        "source": "css-var --secondary-hover (light); raw/css-vars.json"
      }
    },
    "secondaryText": {
      "$value": "#161616",
      "$type": "color",
      "$extensions": {
        "source": "css-var --secondary-foreground (light); raw/css-vars.json"
      }
    },
    "muted": {
      "$value": "#f2f2f2",
      "$type": "color",
      "$extensions": {
        "source": "css-var --muted (light); raw/css-vars.json"
      }
    },
    "destructive": {
      "$value": "#d40924",
      "$type": "color",
      "$extensions": {
        "source": "css-var --destructive (light); raw/css-vars.json"
      },
      "$description": "Declared. No destructive control was painted on a public page."
    },
    "destructiveText": {
      "$value": "#f8f8f8",
      "$type": "color",
      "$extensions": {
        "source": "css-var --destructive-foreground (light); raw/css-vars.json"
      }
    },
    "component": {
      "button": {
        "primary": {
          "bg": {
            "$value": "#0b0b0b",
            "$type": "color",
            "$extensions": {
              "source": "css-var --foreground (light); raw/css-vars.json; Get Started header button background oklch(0.15 0 0)"
            }
          },
          "text": {
            "$value": "#ffffff",
            "$type": "color",
            "$extensions": {
              "source": "Get Started color oklch(1 0 0)"
            }
          },
          "radius": {
            "$value": "9999px",
            "$type": "dimension",
            "$extensions": {
              "source": "measured border-radius 9999px"
            }
          },
          "height": {
            "$value": "39.6px",
            "$type": "dimension",
            "$extensions": {
              "source": "measured height 39.5938px"
            }
          },
          "hoverBg": {
            "$value": "#404040",
            "$type": "color",
            "$extensions": {
              "source": "measured hover background rgb(64, 64, 64)"
            }
          }
        },
        "secondary": {
          "bg": {
            "$value": "#f2f2f2",
            "$type": "color",
            "$extensions": {
              "source": "css-var --secondary (light); raw/css-vars.json"
            }
          },
          "text": {
            "$value": "#161616",
            "$type": "color",
            "$extensions": {
              "source": "css-var --secondary-foreground (light); raw/css-vars.json"
            }
          },
          "hoverBg": {
            "$value": "#e4e4e4",
            "$type": "color",
            "$extensions": {
              "source": "css-var --secondary-hover (light); raw/css-vars.json"
            }
          },
          "radius": {
            "$value": "9999px",
            "$type": "dimension",
            "$extensions": {
              "source": "measured Free-plan Get Started"
            }
          },
          "height": {
            "$value": "48.4px",
            "$type": "dimension",
            "$extensions": {
              "source": "measured height 48.3906px"
            }
          }
        }
      },
      "badge": {
        "bg": {
          "$value": "#0b0b0b",
          "$type": "color",
          "$extensions": {
            "source": "css-var --foreground (light); raw/css-vars.json"
          }
        },
        "text": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "Popular badge color oklch(1 0 0)"
          }
        },
        "radius": {
          "$value": "9999px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured"
          }
        }
      },
      "banner": {
        "bg": {
          "$value": "#d7fd51",
          "$type": "color",
          "$extensions": {
            "source": "css-var --primary (light); raw/css-vars.json"
          }
        },
        "text": {
          "$value": "#21240c",
          "$type": "color",
          "$extensions": {
            "source": "css-var --primary-foreground (light); raw/css-vars.json"
          }
        }
      },
      "focus": {
        "width": {
          "$value": "1px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured outline-width 1px on focus-visible"
          }
        },
        "color": {
          "$value": "#005fcc",
          "$type": "color",
          "$extensions": {
            "source": "measured outline-color rgb(0, 95, 204)"
          }
        },
        "offset": {
          "$value": "1px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured outline-offset 1px on links and buttons; 0px on the pricing segment"
          }
        }
      }
    }
  },
