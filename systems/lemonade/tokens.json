{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Merriweather",
          "fontSize": "55px",
          "fontWeight": 400,
          "lineHeight": "71.5px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "h1 on https://www.lemonade.com/ at 1440x900, 2026-11-21",
            "file": "raw/home-readings.json"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Lato",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "28px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "hero subcopy on the homepage",
            "file": "raw/home-readings.json"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Lato",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "20.8px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "header link Renters",
            "file": "raw/home-readings.json"
          }
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Lato",
          "fontSize": "18px",
          "fontWeight": 700,
          "lineHeight": "23.4px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "Check our prices link",
            "file": "raw/home-readings.json"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "5px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "CTA border-radius and the login email field",
            "file": "raw/home-readings.json"
          }
        }
      }
    },
    "spacing": {
      "button-x": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "CTA padding-left and padding-right",
            "file": "raw/home-readings.json"
          }
        }
      },
      "button-y": {
        "$type": "dimension",
        "$value": "18px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "CTA padding-top and padding-bottom",
            "file": "raw/home-readings.json"
          }
        }
      }
    }
  },
  "light": {
    "page": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "body background rgb(255, 255, 255); theme-color #ffffff",
          "file": "raw/home-readings.json"
        }
      }
    },
    "text": {
      "$type": "color",
      "$value": "#4a4a4a",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "h1 and nav link color rgb(74, 74, 74); :root --night-color",
          "file": "raw/home-readings.json"
        }
      }
    },
    "muted": {
      "$type": "color",
      "$value": "#8c8c8c",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": ":root --gray-color on the homepage stylesheets",
          "file": "raw/home-readings.json"
        }
      }
    },
    "surface": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "header background rgb(255, 255, 255)",
          "file": "raw/home-readings.json"
        }
      }
    },
    "accent": {
      "$type": "color",
      "$value": "#ff0083",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "Check our prices background rgb(255, 0, 131); :root --pink-color",
          "file": "raw/home-readings.json"
        }
      }
    },
    "accent-hover": {
      "$type": "color",
      "$value": "#dc0073",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "CTA hover background rgb(220, 0, 115); :root --dark-pink-color",
          "file": "raw/cta-hover.json"
        }
      }
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "CTA text rgb(255, 255, 255)",
          "file": "raw/home-readings.json"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": "#d9d9d9",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "login email field border rgb(217, 217, 217); :root --pebble-color",
          "file": "raw/login-readings.json"
        }
      }
    },
    "disabled": {
      "$type": "color",
      "$value": "#e7e7e7",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "empty login button background rgb(231, 231, 231)",
          "file": "raw/login-readings.json"
        }
      }
    },
    "drawer": {
      "$type": "color",
      "$value": "#313131",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "phone menu panel rgb(49, 49, 49) at 390px",
          "file": "raw/drawer-readings.json"
        }
      }
    },
    "on-drawer": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "phone menu link color rgb(255, 255, 255)",
          "file": "raw/drawer-readings.json"
        }
      }
    },
    "focus": {
      "$type": "color",
      "$value": "#005fcc",
      "$extensions": {
        "source": {
          "label": "Measured",
          "where": "skip link outline rgb(0, 95, 204) auto 1px after Tab",
          "file": "raw/home-readings.json"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
