{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "page": {
        "$value": "#FEFBFA",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(254, 251, 250) and --creme-light 254, 251, 250 on https://www.freepeople.com/ 2026-11-22" }
      },
      "promo": {
        "$value": "#EDE6E0",
        "$type": "color",
        "$extensions": { "source": "computed .c-pwa-global-banner background rgb(237, 230, 224) and --creme-dark" }
      },
      "creme": {
        "$value": "#FAF2ED",
        "$type": "color",
        "$extensions": { "source": "--creme 250, 242, 237" }
      },
      "ink": {
        "$value": "#252423",
        "$type": "color",
        "$extensions": { "source": "computed nav link and product title rgb(37, 36, 35) and --stone-dark" }
      },
      "ink-strong": {
        "$value": "#1A1A1A",
        "$type": "color",
        "$extensions": { "source": "computed promo heading color rgb(26, 26, 26)" }
      },
      "wordmark": {
        "$value": "#2D2D2D",
        "$type": "color",
        "$extensions": { "source": "fill on the public header SVG fp_shopTabLogo_web_251031.svg" }
      },
      "pink": {
        "$value": "#D52975",
        "$type": "color",
        "$extensions": { "source": "--pink-dark 213, 41, 117. Painted Add to Bag and GIFTS and SALE labels" }
      },
      "pink-soft": {
        "$value": "#FFAFAF",
        "$type": "color",
        "$extensions": { "source": "--pink 255, 175, 175" }
      },
      "on-pink": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed Add to Bag label rgb(255, 255, 255)" }
      },
      "stone": {
        "$value": "#998F8A",
        "$type": "color",
        "$extensions": { "source": "--stone 153, 143, 138" }
      },
      "stone-medium": {
        "$value": "#7C706E",
        "$type": "color",
        "$extensions": { "source": "--stone-medium 124, 112, 110" }
      },
      "stone-light": {
        "$value": "#D6D0CB",
        "$type": "color",
        "$extensions": { "source": "--stone-light 214, 208, 203" }
      },
      "green": {
        "$value": "#057555",
        "$type": "color",
        "$extensions": { "source": "--green 5, 117, 85. Declared. Not painted on the photographed pages" }
      },
      "red": {
        "$value": "#D01302",
        "$type": "color",
        "$extensions": { "source": "--red 208, 19, 2. Declared as --error. No error state was shown" }
      },
      "white": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "--white. Menu panel paints this" }
      },
      "on-hero": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed homepage tile heading rgb(255, 255, 255)" }
      }
    },
    "font": {
      "ui": {
        "$value": "Karla, Helvetica, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed nav, promo, price, and Add to Bag. --font-body. Karla was loaded. The file is not in this package" }
      },
      "heading": {
        "$value": "Karla, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed product title, category title, and homepage tile heading. --font-heading" }
      }
    },
    "typography": {
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "14px", "letterSpacing": "0.3px" },
        "$type": "typography",
        "$extensions": { "source": "computed primary nav link. text-transform uppercase" }
      },
      "promo": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 700, "lineHeight": "20.4px", "letterSpacing": "0.3px" },
        "$type": "typography",
        "$extensions": { "source": "computed .c-pwa-live-text-banner__heading" }
      },
      "product-title": {
        "$value": { "fontFamily": "{core.font.heading}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "0.3px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1 and category h1, both 18px" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed .c-pwa-product-price__current on the Atlas Boat Neck Top" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "1.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed Add to Bag. text-transform uppercase. Not clicked" }
      },
      "tile": {
        "$value": { "fontFamily": "{core.font.heading}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "normal", "letterSpacing": "normal" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage tile h3, white on the photo" }
      }
    },
    "space": {
      "promo-bar": { "$value": "44px", "$type": "dimension", "$extensions": { "source": "computed global banner height" } },
      "nav-row": { "$value": "60px", "$type": "dimension", "$extensions": { "source": "computed primary nav row height" } },
      "page-gutter": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "logo left edge at 24px on the 1440 viewport" } },
      "content-gutter": { "$value": "60px", "$type": "dimension", "$extensions": { "source": "product and about content left edge at 60px" } },
      "button-height": { "$value": "45px", "$type": "dimension", "$extensions": { "source": "computed Add to Bag height" } }
    },
    "radius": {
      "none": { "$value": "0px", "$type": "dimension", "$extensions": { "source": "computed Add to Bag, nav, and search border-radius" } }
    },
    "shadow": {
      "popover": {
        "$value": "5px 5px 10px rgba(0, 0, 0, 0.2)",
        "$type": "shadow",
        "$extensions": { "source": "--popover-shadow. Header bar itself had box-shadow none" }
      }
    }
  }
}
