{
 "core": {
  "font": {
   "family": {
    "app": {
     "type": "fontFamily",
     "var": "--font-app",
     "description": "the app face — the system sans stack (-apple-system first); body text and UI"
    },
    "inter": {
     "type": "fontFamily",
     "var": "--font-inter",
     "description": "Inter — the product face loaded through next/font (with its metrics-matched fallback); marketing/display text"
    },
    "code": {
     "type": "fontFamily",
     "var": "--font-mono",
     "description": "the mono face — ui-monospace stack; code blocks, install commands, inline code"
    },
    "systemSans": {
     "type": "fontFamily",
     "var": "--font-sans",
     "description": "Tailwind's default font-sans utility face — the same system stack as --font-app"
    },
    "sans": {
     "type": "fontFamily",
     "var": "--default-font-family",
     "description": "Tailwind's default body font chain — resolves to the --font-app stack"
    },
    "mono": {
     "type": "fontFamily",
     "var": "--default-mono-font-family",
     "description": "Tailwind's default code font chain — resolves to --font-mono"
    }
   },
   "weight": {
