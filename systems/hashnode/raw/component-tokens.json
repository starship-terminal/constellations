  "typography": {
   "articleTitle": {
    "$value": {
     "fontFamily": "-apple-system, system-ui, sans-serif, \"Apple Color Emoji\"",
     "fontSize": "36px",
     "fontWeight": 600,
     "lineHeight": "44px",
     "letterSpacing": "-0.54px"
    },
    "$type": "typography",
    "$description": "the blog article title — text-article-title",
    "$extensions": {
     "source": "measured th-prose-h1 on /why-diy-qa-doesnt-work-anymore-a-2025-guide-to-e2e-testing-for-modern-web-apps (default state)"
    }
   },
   "h2": {
    "$value": {
     "fontFamily": "-apple-system, system-ui, sans-serif, \"Apple Color Emoji\"",
     "fontSize": "24px",
     "fontWeight": 600,
     "lineHeight": "32px",
     "letterSpacing": "-0.24px"
    },
    "$type": "typography",
    "$description": "an in-article section heading",
    "$extensions": {
     "source": "measured th-prose-h2 on /why-diy-qa-doesnt-work-anymore-a-2025-guide-to-e2e-testing-for-modern-web-apps (default state)"
    }
   },
   "body": {
    "$value": {
     "fontFamily": "-apple-system, system-ui, sans-serif, \"Apple Color Emoji\"",
     "fontSize": "18px",
     "fontWeight": 400,
     "lineHeight": "28px"
    },
    "$type": "typography",
    "$description": "article body text — text-reading",
    "$extensions": {
     "source": "measured th-prose-p on /why-diy-qa-doesnt-work-anymore-a-2025-guide-to-e2e-testing-for-modern-web-apps (default state)"
    }
   },
   "bodyLink": {
    "$value": {
     "fontFamily": "-apple-system, system-ui, sans-serif, \"Apple Color Emoji\"",
     "fontSize": "18px",
     "fontWeight": 500,
     "lineHeight": "28px"
    },
    "$type": "typography",
    "$description": "a body-text link inside the article",
    "$extensions": {
     "source": "measured th-prose-link on /why-diy-qa-doesnt-work-anymore-a-2025-guide-to-e2e-testing-for-modern-web-apps (default state)"
    }
   },
   "cardTitle": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "a feed card's post title",
    "$extensions": {
     "source": "measured post-title-link on / (default state)"
    }
   },
   "navLink": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
     "fontSize": "14px",
     "fontWeight": 400,
     "lineHeight": "20px"
    },
    "$type": "typography",
    "$description": "a sidebar nav label",
    "$extensions": {
     "source": "measured app-nav-link on / (default state)"
    }
   },
   "button": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
     "fontSize": "16px",
     "fontWeight": 600,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "the primary CTA label",
    "$extensions": {
     "source": "measured app-cta on / (default state)"
    }
   },
   "input": {
    "$value": {
     "fontFamily": "Inter, \"Inter Fallback\", \"Segoe UI\", Roboto, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Noto Color Emoji\"",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "the Ctrl-K search field",
    "$extensions": {
     "source": "measured app-search-input on / (default state)"
    }
   },
   "faqQuestion": {
    "$value": {
     "fontFamily": "-apple-system, system-ui, sans-serif, \"Apple Color Emoji\"",
     "fontSize": "16px",
     "fontWeight": 600,
     "lineHeight": "24px"
    },
    "$type": "typography",
    "$description": "a /pro FAQ question",
    "$extensions": {
     "source": "measured faq-question on /pro (default state)"
    }
   }
  }
 },
