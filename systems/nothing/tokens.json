{
  "core": {
    "color": {
      "accent": {
        "red": {
          "$value": "#c8102e",
          "$type": "color",
          "$extensions": {
            "source": "css-var --accent-red (light); declared on :root"
          }
        },
        "yellow": {
          "$value": "#ffc700",
          "$type": "color",
          "$extensions": {
            "source": "css-var --accent-yellow (light); declared on :root"
          }
        },
        "blue": {
          "$value": "#002f6c",
          "$type": "color",
          "$extensions": {
            "source": "css-var --accent-blue (light); declared on :root"
          }
        }
      },
      "greyscale": {
        "100": {
          "$value": "#f4f4f4",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-100 (light)"
          }
        },
        "150": {
          "$value": "#ededed",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-150 (light)"
          }
        },
        "200": {
          "$value": "#d8d9d9",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-200 (light)"
          }
        },
        "300": {
          "$value": "#cbcccc",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-300 (light)"
          }
        },
        "400": {
          "$value": "#bec0c0",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-400 (light)"
          }
        },
        "default": {
          "$value": "#b1b3b3",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-default (light)"
          }
        },
        "600": {
          "$value": "#9b9d9d",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-600 (light)"
          }
        },
        "700": {
          "$value": "#858787",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-700 (light)"
          }
        },
        "800": {
          "$value": "#6f7070",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-800 (light)"
          }
        },
        "900": {
          "$value": "#595a5a",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-900 (light)"
          }
        },
        "1000": {
          "$value": "#3c3c3c",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-1000 (light)"
          }
        },
        "black": {
          "$value": "#040404",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-black (light)"
          }
        },
        "white": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-white (light)"
          }
        },
        "dm-light": {
          "$value": "#181818",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-dm-light (light)"
          }
        },
        "dm-dark": {
          "$value": "#040404",
          "$type": "color",
          "$extensions": {
            "source": "css-var --greyscale-dm-dark (light)"
          }
        }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-dark (light)"
        }
      },
      "paper": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-light (light)"
        }
      }
    },
    "font": {
      "family": {
        "body": {
          "$value": "NType82-Regular, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of promo-bar default (raw/components-computed.json)"
          }
        },
        "headline": {
          "$value": "NType82-Headline, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face NType82-Headline 400 in raw/css-vars.json fonts"
          }
        },
        "dot": {
          "$value": "Ndot-Regular, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face Ndot-Regular weight 55 in raw/css-vars.json fonts"
          }
        },
        "dot-bold": {
          "$value": "Ndot-Bold, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face Ndot-Bold weight 57 in raw/css-vars.json fonts"
          }
        },
        "mono": {
          "$value": "\"Geist Mono Variable\", ui-monospace, monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face Geist Mono Variable in raw/css-vars.json fonts"
          }
        },
        "geist": {
          "$value": "\"Geist Variable\", sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face Geist Variable in raw/css-vars.json fonts"
          }
        },
        "lattera": {
          "$value": "LatteraMonoLL, ui-monospace, monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "font face LatteraMonoLL 400 in raw/css-vars.json fonts"
          }
        }
      }
    },
    "space": {
      "header": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --header-height (light); declared on :root"
        }
      },
      "header-space": {
        "$value": "4rem",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --header-space (light); declared on body"
        }
      },
      "aside": {
        "$value": "400px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --aside-width (light); declared on :root"
        }
      },
      "grid-item": {
        "$value": "355px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --grid-item-width (light); declared on :root"
        }
      },
      "cart-summary": {
        "$value": "250px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --cart-aside-summary-height (light); declared on :root"
        }
      },
      "cart-summary-discount": {
        "$value": "300px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --cart-aside-summary-height-with-discount (light); declared on :root"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderRadius of promo-bar default"
        }
      },
      "control": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderRadius of hero-cta default"
        }
      },
      "field": {
        "$value": "800px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderRadius of text-field default (pill)"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{color.greyscale.100}",
        "$type": "color",
        "$extensions": {
          "source": "body class bg-grey-lightest maps to greyscale-100; sampled page fill on phones collection"
        }
      },
      "surface": {
        "$value": "{color.greyscale.white}",
        "$type": "color",
        "$extensions": {
          "source": "header and card fill"
        }
      },
      "text": {
        "$value": "{color.greyscale.black}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of promo-bar and hero-cta"
        }
      },
      "promo": {
        "$value": "{color.accent.yellow}",
        "$type": "color",
        "$extensions": {
          "source": "yellow announcement bar fill, accent-yellow"
        }
      },
      "on-promo": {
        "$value": "{color.greyscale.black}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of promo-bar text"
        }
      },
      "field": {
        "$value": "#e9ecef",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of text-field default rgb(233, 236, 239)"
        }
      }
    },
    "component": {
      "promo-bar": {
        "text": {
          "$value": "{color.greyscale.black}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of promo-bar default"
          }
        },
        "font-size": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of promo-bar default"
          }
        },
        "height": {
          "$value": "29.75px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of promo-bar default"
          }
        }
      },
      "hero-cta": {
        "background": {
          "$value": "{color.greyscale.white}",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of hero-cta default"
          }
        },
        "text": {
          "$value": "{color.greyscale.black}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-cta default"
          }
        },
        "radius": {
          "$value": "4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderRadius of hero-cta default"
          }
        },
        "height": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of hero-cta default"
          }
        },
        "padding": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paddingTop of hero-cta default"
          }
        }
      },
      "text-field": {
        "background": {
          "$value": "#e9ecef",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of text-field default"
          }
        },
        "text": {
          "$value": "{color.ink}",
          "$type": "color",
          "$extensions": {
            "source": "computed color of text-field default rgb(0, 0, 0)"
          }
        },
        "radius": {
          "$value": "800px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderRadius of text-field default"
          }
        },
        "height": {
          "$value": "44px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of text-field default"
          }
        },
        "font-size": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of text-field default"
          }
        }
      },
      "cart-button": {
        "size": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed width of cart-button default"
          }
        }
      }
    }
  },
  "dark": {
    "color": {
      "page": {
        "$value": "{color.greyscale.dm-dark}",
        "$type": "color",
        "$extensions": {
          "source": "html.dark on Headphone (1) Pro; --greyscale-dm-dark"
        }
      },
      "surface": {
        "$value": "{color.greyscale.dm-light}",
        "$type": "color",
        "$extensions": {
          "source": "--greyscale-dm-light, dark surface step"
        }
      },
      "text": {
        "$value": "{color.greyscale.white}",
        "$type": "color",
        "$extensions": {
          "source": "dark product page paints light type on a dark canvas"
        }
      },
      "promo": {
        "$value": "{color.accent.yellow}",
        "$type": "color",
        "$extensions": {
          "source": "same accent-yellow; CSS variable sheet does not change under html.dark"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    },
    {
      "id": "dark",
      "name": "Dark",
      "selectedTokenSets": {
        "core": "source",
        "dark": "enabled"
      }
    }
  ]
}
