{
  "core": {
    "fontFamily": {
      "sans": {
        "$value": "Charlie Text, -apple-system, system-ui, Segoe UI, Roboto, sans-serif",
        "$type": "fontFamily",
        "$extensions": {"source": "computed body on https://www.atlassian.com/software/confluence"}
      },
      "display": {
        "$value": "Charlie Display, -apple-system, system-ui, Segoe UI, Roboto, sans-serif",
        "$type": "fontFamily",
        "$extensions": {"source": "computed h1 on https://www.atlassian.com/software/confluence"}
      },
      "account": {
        "$value": "Atlassian Sans, ui-sans-serif, -apple-system, system-ui, Segoe UI, sans-serif",
        "$type": "fontFamily",
        "$extensions": {"source": "computed Continue on https://id.atlassian.com/login"}
      }
    },
    "radius": {
      "pill": {"$value": "10000px", "$type": "dimension", "$extensions": {"source": "header Get it free"}},
      "field": {"$value": "25px", "$type": "dimension", "$extensions": {"source": "homepage work-email wrapper"}},
      "continue": {"$value": "3px", "$type": "dimension", "$extensions": {"source": "login Continue"}},
      "signup": {"$value": "6px", "$type": "dimension", "$extensions": {"source": "signup Sign up"}}
    }
  },
  "light": {
    "background": {
      "page": {"$value": "#ffffff", "$type": "color", "$extensions": {"source": "homepage screenshot sample and computed footer"}},
      "banner": {"$value": "#e9f2fe", "$type": "color", "$extensions": {"source": "computed Gartner banner"}},
      "field": {"$value": "#f8f8f8", "$type": "color", "$extensions": {"source": "homepage work-email wrapper"}},
      "login": {"$value": "#fafbfc", "$type": "color", "$extensions": {"source": "login screenshot sample"}},
      "wordmark": {"$value": "#1868db", "$type": "color", "$extensions": {"source": "homepage screenshot sample of the Atlassian mark"}}
    },
    "text": {
      "primary": {"$value": "#292a2e", "$type": "color", "$extensions": {"source": "computed body"}},
      "heading": {"$value": "#101214", "$type": "color", "$extensions": {"source": "computed h1"}},
      "onAccent": {"$value": "#ffffff", "$type": "color", "$extensions": {"source": "Get it free label"}},
      "signin": {"$value": "#101214", "$type": "color", "$extensions": {"source": "header Sign in"}}
    },
    "action": {
      "primary": {"$value": "#1868db", "$type": "color", "$extensions": {"source": "computed Get it free, hero Sign up, and login Continue"}}
    }
  },
  "$themes": [
    {"id": "light", "name": "light", "selectedTokenSets": {"core": "source", "light": "enabled"}}
  ]
}
