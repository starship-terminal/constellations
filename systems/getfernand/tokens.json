  "light": {
    "page": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "measured body backgroundColor rgb(255, 255, 255); meta theme-color #ffffff"
      }
    },
    "surface": {
      "$value": "{color.grey-light}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --grey-light, the pale band used for raised marketing surfaces"
      }
    },
    "text": {
      "$value": "#1a2035",
      "$type": "color",
      "$extensions": {
        "source": "measured h1 color rgb(26, 32, 53) on https://getfernand.com/"
      }
    },
    "muted": {
      "$value": "#6f7b96",
      "$type": "color",
      "$extensions": {
        "source": "measured nav link color rgb(111, 123, 150) on https://getfernand.com/"
      }
    },
    "accent": {
      "$value": "{color.blue}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --blue, painted as Start for free background rgb(0, 160, 255)"
      }
    },
    "border": {
      "$value": "{color.border}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --border"
      }
    },
    "ink": {
      "$value": "{color.black}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --black, measured body color rgb(19, 30, 64)"
      }
    },
    "on-accent": {
      "$value": "{color.white}",
      "$type": "color",
      "$extensions": {
        "source": "measured Start for free color rgb(255, 255, 255)"
      }
    },
    "success": {
      "$value": "{color.green}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --green; not seen as a status chip on the public homepage"
      }
    },
    "warning": {
      "$value": "{color.orange}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --orange; declared, not used as a status chip on the captured homepage"
      }
    },
    "danger": {
      "$value": "{color.red}",
      "$type": "color",
      "$extensions": {
        "source": "css-var --red; declared, not used as a status chip on the captured homepage"
      }
    },
    "focus": {
      "$value": "#3b84d8",
      "$type": "color",
      "$extensions": {
        "source": "measured Start for free outlineColor rgb(59, 132, 216) on focus"
      }
    },
    "component": {
      "button-height": {
        "$value": "30px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured Start for free height on https://getfernand.com/"
        }
      },
      "button-radius": {
        "$value": "{radius.control}",
        "$type": "dimension",
        "$extensions": {
          "source": "measured Start for free borderRadius"
        }
      },
      "button-font-size": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured Start for free fontSize"
        }
      },
      "hero-size": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured h1 fontSize on https://getfernand.com/"
        }
      },
      "hero-line": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured h1 lineHeight on https://getfernand.com/"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme getfernand.com paints on the public site. No dark theme switch was found."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
