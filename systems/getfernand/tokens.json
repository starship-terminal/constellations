          "$extensions": {
            "source": "computed fontFamily of hero-h1 default (raw/components-computed.json); the self-hosted Inter @font-face faces in raw/css-vars.json"
          },
          "$description": "Inter — the self-hosted family every surface sets (weights 300–700 plus italics; the docs and app use a narrower weight band)."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
