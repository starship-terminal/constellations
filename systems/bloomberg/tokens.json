{
  "core": {
    "font": {
      "family": {
        "headline": {
          "$value": "BWHaasHead, \"Helvetica Neue\", Helvetica, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-headline default (raw/components-computed.json)"
          },
          "$description": "The news/headline stack (BWHaasGroteskWeb first)."
        },
        "ui": {
          "$value": "BWHaasGroteskWeb, BWHaasGroteskWeb-fallback, Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of nav-link default (raw/components-computed.json)"
          },
          "$description": "The UI/label stack (AvenirNextPForBBG first)."
        },
        "body": {
          "$value": "BWHaasGroteskWeb, BWHaasGroteskWeb-fallback, Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of dek default (raw/components-computed.json)"
          },
          "$description": "The body-text stack."
        }
      },
      "size": {
        "hero": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-headline default (raw/components-computed.json)"
          },
          "$description": "The lead headline size."
        },
        "title": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of section-title default (raw/components-computed.json)"
          },
          "$description": "A front-page module title."
        },
        "body": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of dek default (raw/components-computed.json)"
          },
          "$description": "Story dek size."
        },
        "label": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav label size."
        },
        "caption": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of byline default (raw/components-computed.json)"
          },
          "$description": "Byline/caption size."
        },
        "ticker": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of ticker-item default (raw/components-computed.json)"
          },
          "$description": "Ticker quote size."
        }
      },
      "lineHeight": {
        "hero": {
          "$value": "33.6px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-headline default (raw/components-computed.json)"
          },
          "$description": "Lead headline line height."
        },
        "body": {
          "$value": "18.2px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of dek default (raw/components-computed.json)"
          },
          "$description": "Story dek line height."
        }
      },
      "weight": {
        "hero": {
          "$value": 500,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of hero-headline default (raw/components-computed.json)"
          },
          "$description": "Lead headline weight."
        },
        "label": {
          "$value": 500,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav label weight."
        }
      }
    },
    "color": {
      "neutral": {
        "ink": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-headline default (raw/components-computed.json)"
          },
          "$description": "Headline text."
        },
        "body": {
          "$value": "#3c3c3c",
          "$type": "color",
          "$extensions": {
            "source": "computed color of dek default (raw/components-computed.json)"
          },
          "$description": "Body text."
        },
        "line": {
          "$value": "#e5e7eb",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of story-secondary default (raw/components-computed.json)"
          },
          "$description": "The hairline between story blocks."
        },
        "line-strong": {
          "$value": "#b3b3b3",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of plan-card default (raw/components-computed.json)"
          },
          "$description": "The stronger utility/card border grey."
        },
        "paper": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of plan-card default (raw/components-computed.json)"
          },
          "$description": "The white surface (page and cards)."
        },
        "ticker": {
          "$value": "#1c1c1c",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of ticker-pill default (raw/components-computed.json)"
          },
          "$description": "The near-black ticker chip fill."
        },
        "chrome": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "painted fill inside/under logo-bar default (raw/components-computed.json)"
          },
          "$description": "The black logo-bar / section-nav chrome."
        }
      },
      "brand": {
        "paywall": {
          "$value": "#1c1c1c",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of paywall default (raw/components-computed.json)"
          },
          "$description": "The paywall band's dark fill."
        },
        "accent": {
          "$value": "#3523ff",
          "$type": "color",
          "$extensions": {
            "source": "painted fill inside offer-cta default (raw/components-computed.json)"
          },
          "$description": "The Bloomberg CTA blue (offer Continue)."
        },
        "accent-hover": {
          "$value": "#4f4fff",
          "$type": "color",
          "$extensions": {
            "source": "painted fill inside offer-cta hover (raw/components-computed.json)"
          },
          "$description": "CTA blue on hover."
        }
      }
    },
    "measured": {
      "gutter": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of hero-story default (raw/components-computed.json)"
        },
        "$description": "The front grid's gutter."
      },
      "block-gap": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed marginTop of story-secondary default (raw/components-computed.json)"
        },
        "$description": "Gap between story blocks."
      },
      "focus-outline": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of nav-link focus-visible (raw/components-computed.json)"
        },
        "$description": "The keyboard-focus ring on nav items."
      },
      "button-hover": {
        "$value": "#1c1c1c",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of subscribe-nav hover (raw/components-computed.json)"
        },
        "$description": "The Subscribe button's hover fill."
      }
    }
  },
  "light": {
    "text": {
      "primary": {
        "$value": "{color.neutral.ink}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Body and headline text."
      }
    },
    "surface": {
      "chrome": {
        "$value": "{color.neutral.chrome}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The black header chrome."
      },
      "page": {
        "$value": "{color.neutral.paper}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The page background."
      }
    },
    "border": {
      "hairline": {
        "$value": "{color.neutral.line}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Story-block hairlines."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.accent}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Primary CTAs (Continue, checkout)."
      }
    },
    "component": {
      "control": {
        "height": {
          "$value": "30px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of subscribe-nav default (raw/components-computed.json)"
          },
          "$description": "The Subscribe button height."
        },
        "radius": {
          "$value": "4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of subscribe-nav default (raw/components-computed.json)"
          },
          "$description": "Button corner radius."
        }
      },
      "ticker": {
        "height": {
          "$value": "31.5px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of ticker-item default (raw/components-computed.json)"
          },
          "$description": "Ticker chip height."
        }
      },
      "header": {
        "height": {
          "$value": "52px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of logo-bar default (raw/components-computed.json)"
          },
          "$description": "The black logo bar height."
        }
      },
      "nav": {
        "height": {
          "$value": "120px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of section-nav default (raw/components-computed.json)"
          },
          "$description": "The section nav strip height."
        }
      },
      "paywall": {
        "padding": {
          "$value": "0px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed paddingTop of paywall default (raw/components-computed.json)"
          },
          "$description": "Paywall band vertical padding."
        }
      },
      "plan-card": {
        "radius": {
          "$value": "0px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of plan-card default (raw/components-computed.json)"
          },
          "$description": "Plan card corner radius."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme bloomberg.com paints; no dark theme is offered on any captured surface."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
