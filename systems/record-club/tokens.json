      }
    },
    "shadow": {
      "elevated": {
        "$type": "shadow",
        "$value": [
          {"color": "#000000", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0.5px"},
          {"color": "#000000", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"},
          {"color": "#000000", "offsetX": "0px", "offsetY": "4px", "blur": "8px", "spread": "0px"},
          {"color": "#000000", "offsetX": "0px", "offsetY": "12px", "blur": "24px", "spread": "0px"},
          {"color": "#000000", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "0px"}
