        "disabled-text": {"$type": "color", "$value": "#808080", "$description": "The disabled primary rule's light colour is the keyword gray.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json buttonRules .btn--primary[disabled]"}}},
        "brand": {"$type": "color", "$value": "#6e36ff", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json customProperties.--color-brand"}}},
        "outline": {"$type": "color", "$value": "#e5e5e5", "$description": "Light side of --color-line-default. Outline buttons paint their edge with currentColor, not this line.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json customProperties.--color-line-default"}}}
