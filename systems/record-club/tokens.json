{
  "core": {
    "font": {
      "family": {
        "brand": {
          "$type": "fontFamily",
          "$value": "GT America, -apple-system, system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
          "$description": "Computed font-family on body and on buttons.",
          "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home"}}
        },
        "display": {
          "$type": "fontFamily",
          "$value": "GTFAdieu, GT America, sans-serif",
          "$description": "Computed font-family on h1.heading-main. The second name is the body face, used only as a fallback the page itself does not declare on the heading.",
          "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.h1"}}
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "GT America Mono, ui-monospace, SFMono-Regular, Menlo, monospace",
          "$description": "Declared @font-face family. No computed element used it on the captured pages.",
          "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json fonts.faces"}}
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.display}", "fontSize": "44px", "fontWeight": "700", "lineHeight": "48.4px", "letterSpacing": "-0.44px"},
        "$description": "About and help heading-main. Home hero is 50px/55px/-0.5px, recorded on the home reading.",
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.about.headingMain"}}
      },
      "display-hero": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.display}", "fontSize": "50px", "fontWeight": "700", "lineHeight": "55px", "letterSpacing": "-0.5px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.h1"}}
      },
      "title": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.display}", "fontSize": "37px", "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.02em"},
        "$description": "Releases heading-secondary is 37px / 700. Line height and tracking were not read on that element, so those two fields are the 1.2 and -0.02em the display headings compute to (44px/48.4px, -0.44px).",
        "$extensions": {"source": {"evidence": "Derived", "capture": "raw/computed.json pages.releases.h1"}}
      },
      "release": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "35px", "fontWeight": "500", "lineHeight": "42px", "letterSpacing": "-0.35px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.release.heading"}}
      },
      "section": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "24px", "fontWeight": "500", "lineHeight": "28.8px", "letterSpacing": "-0.48px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json home h2 heading-medium"}}
      },
      "lede": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "20px", "fontWeight": "400", "lineHeight": "28.88px", "letterSpacing": "0px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.lede"}}
      },
      "button-large": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "17px", "fontWeight": "400", "lineHeight": "25.5px", "letterSpacing": "-0.238px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.heroPrimary"}}
      },
      "body": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "15px", "fontWeight": "400", "lineHeight": "22.5px", "letterSpacing": "0px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json rootComputed.light"}}
      },
      "label": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "1.5", "letterSpacing": "0px"},
        "$description": "Email label is 14px/400. Line height was not read on the label, so 1.5 is the declared .heading line-height, not a label measurement.",
        "$extensions": {"source": {"evidence": "Derived", "capture": "raw/computed.json pages.register.label"}}
      },
      "meta": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "13px", "fontWeight": "400", "lineHeight": "19.5px", "letterSpacing": "0px"},
        "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.footer"}}
      },
      "badge": {
        "$type": "typography",
        "$value": {"fontFamily": "{font.family.brand}", "fontSize": "10.5px", "fontWeight": "500", "lineHeight": "1.2", "letterSpacing": "0px"},
        "$description": "badge--new is 10.5px/500. Line height was not read.",
        "$extensions": {"source": {"evidence": "Derived", "capture": "raw/computed.json pages.browse.dark.badgeNew"}}
      }
    },
    "radius": {
      "artwork": {"$type": "dimension", "$value": "4px", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.releases.artworkInner"}}},
      "control": {"$type": "dimension", "$value": "7px", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.navLink"}}},
      "button": {"$type": "dimension", "$value": "8px", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.heroPrimary"}}},
      "card": {"$type": "dimension", "$value": "9px", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.browse.dark.card"}}},
      "modal": {"$type": "dimension", "$value": "12px", "$description": "Declared --modal-radius is 1.2rem. html font-size is 10px, so 1.2rem is 12px.", "$extensions": {"source": {"evidence": "Derived", "capture": "raw/computed.json customProperties.--modal-radius"}}},
      "bento": {"$type": "dimension", "$value": "16px", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.bento"}}},
      "pill": {"$type": "dimension", "$value": "999px", "$description": "Icon-only buttons compute border-radius 100%. Stored as a pill length so DESIGN.md can export it.", "$extensions": {"source": {"evidence": "Derived", "capture": "raw/computed.json pages.home.iconButton"}}}
    },
    "spacing": {
      "2": {"$type": "dimension", "$value": "4px", "$description": "Button column-gap on small buttons is 4px.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json button gap"}}},
      "3": {"$type": "dimension", "$value": "8px", "$description": "Large button gap is 8px. Also the chip radius.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.heroPrimary.gap"}}},
      "4": {"$type": "dimension", "$value": "10px", "$description": "Small button horizontal padding and release column gap.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.navLink"}}},
      "5": {"$type": "dimension", "$value": "14px", "$description": "Filter chip horizontal padding.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.releases.chipActive"}}},
      "6": {"$type": "dimension", "$value": "18px", "$description": "Auth button and field horizontal padding.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.login.dark.oauth"}}},
      "7": {"$type": "dimension", "$value": "24px", "$description": "Large button horizontal padding.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.heroPrimary"}}},
      "8": {"$type": "dimension", "$value": "28px", "$description": "Logged-out header inner horizontal padding.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.headerInner"}}},
      "9": {"$type": "dimension", "$value": "30px", "$description": "Header inner gap.", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json pages.home.headerInner"}}}
    },
    "motion": {
      "duration": {
        "button": {"$type": "duration", "$value": "180ms", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json motion.button"}}},
        "logo": {"$type": "duration", "$value": "300ms", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json motion.logoMark"}}},
        "reduced": {"$type": "duration", "$value": "0.01ms", "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json motion.reducedMotion"}}}
      },
      "easing": {
        "button": {"$type": "cubicBezier", "$value": [0.59, 0.01, 0.28, 1], "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json motion.button"}}},
        "logo": {"$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$extensions": {"source": {"evidence": "Measured", "capture": "raw/computed.json motion.logoMark"}}}
      },
      "$extensions": {
        "reducedMotion": "honours",
        "note": "A universal prefers-reduced-motion: reduce rule sets transition-duration and animation-duration to 0.01ms and scroll-behavior to auto."
      }
    }
  },
  "light": {
