{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "color": {
      "ink": {
        "$type": "color",
        "$value": "#1a1c1f",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "CSS custom property --e-global-color-586eaa9 (#1A1C1F) and computed body background rgb(26, 28, 31) on https://wandb.ai/site, 2026-11-21"
          }
        }
      },
      "paper": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "CSS custom property --e-global-color-primary (#FFFFFF) and computed body text rgb(255, 255, 255) on https://wandb.ai/site"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#00afc2",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "CSS custom property --e-global-color-accent (#00AFC2) and computed Docs link rgb(0, 175, 194) on https://wandb.ai/site"
          }
        }
      },
      "gold": {
        "$type": "color",
        "$value": "#ffcc33",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "CSS custom property --e-global-color-secondary (#FFCC33) on https://wandb.ai/site"
          }
        }
      },
      "amber": {
        "$type": "color",
        "$value": "#ffad33",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(255, 173, 51) on the SIGN UP link while hovered, https://wandb.ai/site"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#adb0b5",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "CSS custom property --e-global-color-text (#ADB0B5) on https://wandb.ai/site"
          }
        }
      },
      "gradientStart": {
        "$type": "color",
        "$value": "#10bfcc",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-image stop rgb(16, 191, 204) on #homepage-weave-cta"
          }
        }
      },
      "gradientEnd": {
        "$type": "color",
        "$value": "#0097ab",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background-image stop rgb(0, 151, 171) on #homepage-weave-cta"
          }
        }
      },
      "field": {
        "$type": "color",
        "$value": "#45494f",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background rgb(69, 73, 79) on the Contact Us First Name field"
          }
        }
      },
      "fieldBorder": {
        "$type": "color",
        "$value": "#666666",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-top-color rgb(102, 102, 102) on the Contact Us First Name field"
          }
        }
      },
      "cobalt": {
        "$type": "color",
        "$value": "#0541e9",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background rgb(5, 65, 233) on the Log in button at https://id.coreweave.com/login"
          }
        }
      },
      "forgeInk": {
        "$type": "color",
        "$value": "#1a1d24",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(26, 29, 36) on Continue with Google at https://id.coreweave.com/login"
          }
        }
      },
      "forgeText": {
        "$type": "color",
        "$value": "#2b3038",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(43, 48, 56) on the Forge login page body"
          }
        }
      },
      "forgeMuted": {
        "$type": "color",
        "$value": "#3f464f",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(63, 70, 79) on Forgot your password? at https://id.coreweave.com/login"
          }
        }
      },
      "forgePage": {
        "$type": "color",
        "$value": "#f8f8f8",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background rgb(248, 248, 248) on the left panel of https://id.coreweave.com/login"
          }
        }
      },
      "forgeBorder": {
        "$type": "color",
        "$value": "#dfe0e2",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-top-color rgb(223, 224, 226) on the Email field at https://id.coreweave.com/login"
          }
        }
      },
      "provider": {
        "$type": "color",
        "$value": "#fdfdfd",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed background rgb(253, 253, 253) on Continue with Google at https://id.coreweave.com/login"
          }
        }
      },
      "focus": {
        "$type": "color",
        "$value": "#1b67bc",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed outline rgb(27, 103, 188) auto 1px on the focused SIGN UP link, https://wandb.ai/site"
          }
        }
      }
    },
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Source Sans 3, sans-serif",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-family on body and --e-global-typography-primary-font-family on https://wandb.ai/site"
          }
        }
      },
      "serif": {
        "$type": "fontFamily",
        "$value": "Source Serif 4, serif",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-family on the home h1, https://wandb.ai/site"
          }
        }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--e-global-typography-primary-font-weight 400 on https://wandb.ai/site"
          }
        }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-weight 500 on the Forge Log in button"
          }
        }
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-weight 600 on the home h1 and on #homepage-weave-cta"
          }
        }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-weight 700 on the Forge login h1"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.serif}",
          "fontSize": "72px",
          "fontWeight": "{fontWeight.semibold}",
          "lineHeight": "72px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed style of the home h1: Source Serif 4, 72px, weight 600, line-height 72px"
          }
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "44.8px",
          "fontWeight": "{fontWeight.bold}",
          "lineHeight": "60.48px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed style of the Forge login h1"
          }
        }
      },
      "ui": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "20px",
          "fontWeight": "{fontWeight.regular}",
          "lineHeight": "28px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--e-global-typography-primary-font-size 20px, weight 400, line-height 28px"
          }
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "20px",
          "fontWeight": "{fontWeight.regular}",
          "lineHeight": "30px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed style of the Docs nav link"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "16px",
          "fontWeight": "{fontWeight.semibold}",
          "lineHeight": "18px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed font-size 16px and weight 600 on #homepage-weave-cta. Line height 18px is --e-global-typography-accent-line-height, not the button's own computed line height."
          }
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{fontFamily.sans}",
          "fontSize": "14px",
          "fontWeight": "{fontWeight.regular}",
          "lineHeight": "28px"
        },
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "--e-global-typography-text-font-size 14px, weight 400, line-height 28px"
          }
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "3px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 3px on the Contact Us First Name field"
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 4px on the Forge Email field and Log in button"
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 8px on #homepage-weave-cta and on Continue with Google"
          }
        }
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "{color.ink}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Body background rgb(26, 28, 31) on https://wandb.ai/site" } }
        },
        "raised": {
          "$type": "color",
          "$value": "{color.field}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Contact field background rgb(69, 73, 79)" } }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.paper}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Body color rgb(255, 255, 255) on https://wandb.ai/site" } }
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.muted}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "--e-global-color-text #ADB0B5" } }
        },
        "accent": {
          "$type": "color",
          "$value": "{color.accent}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Docs link rgb(0, 175, 194)" } }
        },
        "onAccent": {
          "$type": "color",
          "$value": "{color.ink}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Computed color rgb(26, 28, 31) on #homepage-weave-cta" } }
        },
        "link": {
          "$type": "color",
          "$value": "{color.accent}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Docs and Pricing links rgb(0, 175, 194)" } }
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{color.muted}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "REQUEST DEMO border rgb(173, 176, 181)" } }
        },
        "strong": {
          "$type": "color",
          "$value": "{color.fieldBorder}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Contact field border rgb(102, 102, 102)" } }
        },
        "focus": {
          "$type": "color",
          "$value": "{color.focus}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "SIGN UP focus outline rgb(27, 103, 188)" } }
        }
      },
      "action": {
        "primary": {
          "$type": "color",
          "$value": "{color.gradientEnd}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "End stop of the Weave CTA gradient. The fill is a gradient, not this flat colour." } }
        }
      }
    },
    "component": {
      "button": {
        "weave": {
          "height": { "$type": "dimension", "$value": "60px", "$extensions": { "source": { "evidence": "Measured", "capture": "#homepage-weave-cta bounding box height 60" } } },
          "radius": { "$type": "dimension", "$value": "{radius.lg}", "$extensions": { "source": { "evidence": "Measured", "capture": "#homepage-weave-cta border-radius 8px" } } },
          "padding": { "$type": "dimension", "$value": "21px", "$extensions": { "source": { "evidence": "Measured", "capture": "#homepage-weave-cta padding 21px 35px. Horizontal 35px is recorded in raw/readings.json." } } }
        },
        "demo": {
          "height": { "$type": "dimension", "$value": "50px", "$extensions": { "source": { "evidence": "Measured", "capture": "REQUEST DEMO bounding box height 50" } } },
          "radius": { "$type": "dimension", "$value": "{radius.lg}", "$extensions": { "source": { "evidence": "Measured", "capture": "REQUEST DEMO border-radius 8px" } } }
        }
      },
      "field": {
        "height": { "$type": "dimension", "$value": "42px", "$extensions": { "source": { "evidence": "Measured", "capture": "Contact First Name field height 42" } } },
        "radius": { "$type": "dimension", "$value": "{radius.sm}", "$extensions": { "source": { "evidence": "Measured", "capture": "Contact field border-radius 3px" } } }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "{color.forgePage}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Left panel rgb(248, 248, 248) on https://id.coreweave.com/login" } }
        },
        "surface": {
          "$type": "color",
          "$value": "{color.paper}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Page wrapper rgb(255, 255, 255) on the Forge login" } }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{color.forgeText}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Body color rgb(43, 48, 56) on the Forge login" } }
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.forgeMuted}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Forgot your password? rgb(63, 70, 79)" } }
        },
        "onAccent": {
          "$type": "color",
          "$value": "{color.paper}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Log in button color rgb(255, 255, 255)" } }
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "{color.forgeBorder}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Email field border rgb(223, 224, 226)" } }
        }
      },
      "action": {
        "primary": {
          "$type": "color",
          "$value": "{color.cobalt}",
          "$extensions": { "source": { "evidence": "Measured", "capture": "Log in button background rgb(5, 65, 233)" } }
        }
      }
    },
    "component": {
      "button": {
        "login": {
          "height": { "$type": "dimension", "$value": "32px", "$extensions": { "source": { "evidence": "Measured", "capture": "Forge Log in button height 32" } } },
          "radius": { "$type": "dimension", "$value": "{radius.md}", "$extensions": { "source": { "evidence": "Measured", "capture": "Forge Log in button radius 4px" } } }
        },
        "provider": {
          "height": { "$type": "dimension", "$value": "46px", "$extensions": { "source": { "evidence": "Measured", "capture": "Continue with Google height 46" } } },
          "radius": { "$type": "dimension", "$value": "{radius.lg}", "$extensions": { "source": { "evidence": "Measured", "capture": "Continue with Google radius 8px" } } }
        }
      },
      "field": {
        "height": { "$type": "dimension", "$value": "32px", "$extensions": { "source": { "evidence": "Measured", "capture": "Forge Email field height 32" } } },
        "radius": { "$type": "dimension", "$value": "{radius.md}", "$extensions": { "source": { "evidence": "Measured", "capture": "Forge Email field radius 4px" } } }
      }
    }
  },
  "$themes": [
    { "id": "dark", "name": "Marketing", "selectedTokenSets": { "core": "source", "dark": "enabled" } },
    { "id": "light", "name": "Forge signed-out", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
