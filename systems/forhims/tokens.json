 "light": {
  "background": {
   "page": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "page canvas is --b-color-white on the captured marketing pages"
    }
   },
   "surface": {
    "$value": "#f4f1ee",
    "$type": "color",
    "$extensions": {
     "source": "css-var --colors-canvas-grayPink; the cream card fill on the home treatment cards"
    }
   },
   "menu": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "Sex menu computed backgroundColor rgb(255, 255, 255)"
    }
   },
   "scrim": {
    "$value": "rgba(0, 0, 0, 0.4)",
    "$type": "color",
    "$extensions": {
     "source": "Observed on home-light-account-menu.png. The exact scrim token was not isolated, so this is the visible overlay, labelled from the screenshot review rather than a named variable."
    }
   }
  },
  "text": {
   "primary": {
    "$value": "rgba(0, 0, 0, 0.89)",
    "$type": "color",
    "$extensions": {
     "source": "computed color on nav-link/default, 1440x900. Nearest declared step is --b-color-neutral-dark-900 at rgba(0,0,0,0.83); they are not the same value."
    }
   },
   "onAccent": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "LOGIN and primary button labels compute to white or near-white on dark fills"
    }
   },
   "brand": {
    "$value": "{color.brand}",
    "$type": "color",
    "$extensions": {
     "source": "css-var --colors-brand-default; the copper 'for you' and the hims wordmark"
    }
   },
   "muted": {
    "$value": "rgba(0, 0, 0, 0.46)",
    "$type": "color",
    "$extensions": {
     "source": "css-var --b-color-neutral-dark-500. Used as the muted ink step. A dedicated muted text role was not separately computed."
    }
   }
  },
  "border": {
   "default": {
    "$value": "rgba(0, 0, 0, 0.07)",
    "$type": "color",
    "$extensions": {
     "source": "css-var --b-color-neutral-dark-100"
    }
   }
  },
  "action": {
   "primary": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "declared --colors-button-primary is #000000. The Explore treatments pill is black in screenshots/home-light-default.png. Computed backgroundColor on the button node was transparent, so the fill was not isolated to that node."
    }
   },
   "primaryText": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "computed color rgb(255, 255, 255) on the primary button label"
    }
   },
   "quiet": {
    "$value": "rgba(0, 0, 0, 0.07)",
    "$type": "color",
    "$extensions": {
     "source": "LOGIN computes to background rgba(0, 0, 0, 0.06), the neutral-dark-100 step"
    }
   }
  },
  "status": {
