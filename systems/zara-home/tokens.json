   "button": {
    "$type": "dimension",
    "$value": "12px",
    "$extensions": {
     "source": "raw/readings.json computed.worldwideGo.fontSize and footerHeading.fontSize"
    }
   },
   "body": {
    "$type": "dimension",
    "$value": "14px",
    "$extensions": {
