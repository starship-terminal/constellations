    }
   },
   "body": {
    "$type": "dimension",
    "$value": "18px",
    "$extensions": {
     "source": "raw/readings.json body.lineHeight"
    }
   },
   "description": {
    "$type": "dimension",
    "$value": "20px",
    "$extensions": {
     "source": "raw/readings.json computed.description.lineHeight"
    }
   },
   "header": {
    "$type": "dimension",
    "$value": "22px",
    "$extensions": {
     "source": "raw/readings.json computed.headerSearch.lineHeight and productPrice.lineHeight"
    }
   },
   "product": {
    "$type": "dimension",
    "$value": "24px",
    "$extensions": {
