{
 "core": {
  "$description": "Scales read from zarahome.com public pages on 2026-11-19. One light theme.",
  "color": {
   "ink": {
    "$type": "color",
    "$value": "#1e1e1e",
    "$extensions": {
     "source": "raw/readings.json computed.worldwideGo.backgroundColor and --primary-color"
    },
    "$description": "House ink. Buttons, prices, footer headings."
   },
   "ink87": {
    "$type": "color",
    "$value": "#000000de",
    "$extensions": {
     "source": "raw/readings.json computed.productTitle.color and --mat-app-text-color"
    },
    "$description": "Material body ink on product titles and the search field."
   },
   "black": {
    "$type": "color",
    "$value": "#000000",
    "$extensions": {
     "source": "raw/readings.json body.color and computed.marketButton.color"
    },
    "$description": "Body and the market switch. Not the filled-button ink."
   },
   "white": {
    "$type": "color",
    "$value": "#ffffff",
    "$extensions": {
     "source": "raw/readings.json body.backgroundColor and computed.headerCategory.backgroundColor"
    },
    "$description": "Page and category header."
   },
   "white80": {
    "$type": "color",
    "$value": "#ffffffcc",
    "$extensions": {
     "source": "raw/readings.json computed.addOnCard.backgroundColor"
    },
    "$description": "Add control sitting on a product photo."
   },
   "muted": {
    "$type": "color",
    "$value": "#8e8e93",
    "$extensions": {
     "source": "raw/readings.json computed.sku.color and --primary-darker-color"
    },
    "$description": "SKU and product description."
   },
   "mutedLight": {
    "$type": "color",
    "$value": "#d1d1d6",
    "$extensions": {
     "source": "raw/readings.json customProperties.--primary-lighter-color"
    },
    "$description": "Declared lighter primary. Not seen as a fill."
   },
   "rule": {
    "$type": "color",
    "$value": "#d8d8dc",
    "$extensions": {
     "source": "raw/readings.json customProperties.--footer-v2-rule"
    },
    "$description": "Footer rule, declared, not a computed border on a measured element."
   },
   "focus": {
    "$type": "color",
    "$value": "#2684ff",
    "$extensions": {
     "source": "raw/readings.json computed.focusVisible.outline and --footer-v2-focus"
    },
    "$description": "Focus outline. Stylesheet rule, not a live focus."
   },
   "accentBlue": {
    "$type": "color",
    "$value": "#007aff",
    "$extensions": {
     "source": "raw/readings.json customProperties.--accent-darker-color"
    },
    "$description": "Declared accent darker. Swiper theme uses the same hex. Not a button fill."
   },
   "sale": {
    "$type": "color",
    "$value": "#cf0a2c",
    "$extensions": {
     "source": "raw/readings.json customProperties.--accent-lighter-color"
    },
    "$description": "Declared accent lighter. No sale price used it on the captured pages."
   },
   "warn": {
    "$type": "color",
    "$value": "#b32624",
    "$extensions": {
     "source": "raw/readings.json customProperties.--warn-color"
    },
    "$description": "Material warn and filled-button token. Zara Home buttons on these pages used ink."
   },
   "warnWash": {
    "$type": "color",
    "$value": "#ffd8d6",
    "$extensions": {
     "source": "raw/readings.json customProperties.--warn-lighter-color"
    },
    "$description": "Declared warn wash. Not seen as a fill."
   },
   "hover": {
    "$type": "color",
    "$value": "#3a3a3c",
    "$extensions": {
     "source": "raw/readings.json computed.buttonHover.backgroundColor"
    },
    "$description": "button.mdc-button:hover. Stylesheet, not a live hover."
   },
   "hairline": {
    "$type": "color",
    "$value": "#0000001f",
    "$extensions": {
     "source": "raw/readings.json computed.chooseSize.border"
    },
    "$description": "Choose a size outline."
   }
  },
  "fontFamily": {
   "sans": {
    "$type": "fontFamily",
    "$value": "ZH-Sans, Arial, \"Lucida Sans Unicode\", sans-serif",
    "$extensions": {
     "source": "raw/readings.json body.fontFamily and fonts.stack"
    },
    "$description": "ZH-Sans is ZaraAPPSans, served as woff2. Proprietary. Not committed."
   }
  },
  "fontWeight": {
