   },
   "fab": {
    "$type": "shadow",
    "$value": "0px 3px 5px -1px rgba(0, 0, 0, 0.2), 0px 6px 10px 0px rgba(0, 0, 0, 0.14), 0px 1px 18px 0px rgba(0, 0, 0, 0.12)",
    "$extensions": {
     "source": "raw/readings.json computed.chatFab.boxShadow"
    },
    "$description": "The only measured elevation. A round white control on the product page."
   }
