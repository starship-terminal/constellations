    "$value": {
     "fontFamily": "{fontFamily.sans}",
     "fontWeight": "{fontWeight.semibold}",
     "fontSize": "{fontSize.header}",
     "lineHeight": "{lineHeight.header}",
     "letterSpacing": "{letterSpacing.body}"
    },
    "$extensions": {
