        "$value": "448px",
        "$extensions": {
          "source": "Measured. .max-w-md{max-width:28rem} and getComputedStyle of the sunset column, width 448px."
        }
      },
      "sunset-padding-inline": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": "Measured. main padding 0px 24px from .px-6{padding-left:1.5rem;padding-right:1.5rem}."
        }
      }
    }
