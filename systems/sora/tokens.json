    "motion": {
      "duration": {
        "pulse": {
          "$type": "duration",
          "$value": "2000ms",
          "$extensions": {
            "source": "Measured. .animate-pulse{animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite}"
          }
        },
        "spin": {
          "$type": "duration",
          "$value": "1000ms",
          "$extensions": {
            "source": "Measured. .animate-spin{animation:spin 1s linear infinite}"
          }
        },
        "progress": {
          "$type": "duration",
          "$value": "1200ms",
          "$extensions": {
            "source": "Measured. .progress-bar-indeterminate{animation:progress-bar-indeterminate 1.2s linear infinite}"
          }
        },
        "card-fade": {
          "$type": "duration",
          "$value": "3000ms",
          "$extensions": {
            "source": "Measured. .placeholderCard{animation:cardFade 3s cubic-bezier(.45,0,.4,1) infinite both}"
          }
        },
        "caret": {
          "$type": "duration",
          "$value": "1000ms",
          "$extensions": {
            "source": "Measured. .animate-caret-blink{animation:caret-blink 1s step-end infinite}"
          }
        },
        "firework": {
          "$type": "duration",
          "$value": "600ms",
          "$extensions": {
            "source": "Measured. .emoji-firework-center{animation:emoji-firework-center .6s ease-out forwards}"
          }
        }
      },
      "easing": {
        "pulse": {
          "$type": "cubicBezier",
          "$value": [
            0.4,
            0,
            0.6,
            1
          ],
          "$extensions": {
            "source": "Measured. .animate-pulse cubic-bezier(.4,0,.6,1)"
          }
        },
        "card-fade": {
          "$type": "cubicBezier",
          "$value": [
            0.45,
            0,
            0.4,
            1
          ],
          "$extensions": {
            "source": "Measured. .placeholderCard cubic-bezier(.45,0,.4,1)"
          }
        },
        "ease-out": {
          "$type": "cubicBezier",
          "$value": [
            0,
            0,
            0.2,
            1
          ],
          "$extensions": {
            "source": "Derived. .emoji-firework-center animation timing keyword ease-out, expanded to the CSS ease-out control points. The keyword itself was measured.",
            "keyword": "ease-out"
          }
        },
        "linear": {
          "$type": "cubicBezier",
          "$value": [
            0,
            0,
            1,
            1
          ],
          "$extensions": {
            "source": "Derived. .animate-spin and .progress-bar-indeterminate timing keyword linear, expanded to the CSS linear control points. The keyword itself was measured.",
            "keyword": "linear"
          }
        }
      },
      "$extensions": {
        "source": "Declared in 4f834fecb0689d51.css. None of these animations were running on the sunset page.",
        "reducedMotion": "Two @media (prefers-reduced-motion: reduce) rules set animation:none on .placeholderCard and on .emoji-firework-center, .emoji-firework-particle. Other animations have no reduce rule in the fetched sheets."
      }
    },
    "layout": {
      "sidebar-width": {
        "$type": "dimension",
        "$value": "196px",
        "$extensions": {
          "source": "Measured. :root --sidebar-width: 196px. Not painted on the sunset page."
        }
      },
      "sidebar-gap": {
        "$type": "dimension",
        "$value": "21px",
        "$extensions": {
          "source": "Measured. :root --sidebar-gap: 21px. .dark sets --sidebar-gap: 0px in one later rule; the computed dark value on the sunset page was 21px, so the live value is recorded under dark.layout."
        }
      },
      "mobile-tab-bar-height": {
        "$type": "dimension",
        "$value": "54px",
        "$extensions": {
          "source": "Measured. :root --mobile-tab-bar-height: 54px. Not painted on the sunset page."
        }
      },
      "sunset-column": {
