{
  "$description": "Sora sunset page tokens, measured 2026-11-19 from https://sora.chatgpt.com/sunset.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji",
          "$extensions": {
            "source": "Measured. .font-sans and getComputedStyle(body).fontFamily on the sunset page. OpenAI Sans is declared in @font-face but was not the computed family."
          }
        },
        "openai-sans": {
          "$type": "fontFamily",
          "$value": "OpenAI Sans",
          "$extensions": {
            "source": "Measured. @font-face font-family: OpenAI Sans in eda963f33b3839f5.css, weights 400, 500, 600, 700, normal and italic. Not the computed family on the sunset page."
          }
        }
      }
    },
