{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "paper": { "$value": "#FBFAF6", "$type": "color", "$extensions": { "source": "css-var --background declared #FBFAF6" } },
      "ink": { "$value": "#000000", "$type": "color", "$extensions": { "source": "css-var --black declared #000000" } },
      "white": { "$value": "#F8F8F8", "$type": "color", "$extensions": { "source": "css-var --white declared #F8F8F8" } },
      "grey": { "$value": "#D9D9D9", "$type": "color", "$extensions": { "source": "css-var --grey declared #D9D9D9" } },
      "blue": { "$value": "#0358F7", "$type": "color", "$extensions": { "source": "css-var --blue declared #0358F7" } },
      "pink": { "$value": "#FD02F5", "$type": "color", "$extensions": { "source": "css-var --pink declared #FD02F5" } },
      "red": { "$value": "#FA3D1D", "$type": "color", "$extensions": { "source": "css-var --red declared #FA3D1D" } },
      "yellow": { "$value": "#FFB005", "$type": "color", "$extensions": { "source": "css-var --yellow declared #FFB005" } },
      "brown": { "$value": "#340B05", "$type": "color", "$extensions": { "source": "css-var --brown declared #340B05" } },
      "hero": { "$value": "#DCB017", "$type": "color", "$extensions": { "source": "sampled flat pixel rgb(220, 169, 23) on the home hero, before quantize" } }
    },
    "font": {
      "family": {
        "display": { "$value": "\"Exposure VAR\", serif", "$type": "fontFamily", "$extensions": { "source": "computed font-family on the home h1" } },
        "ui": { "$value": "\"ABC Oracle\", Helvetica, sans-serif", "$type": "fontFamily", "$extensions": { "source": "computed font-family on body" } },
        "mono": { "$value": "\"ABC Favorit Mono\", monospace", "$type": "fontFamily", "$extensions": { "source": "computed font-family on footer column labels" } }
      }
    },
    "radius": {
      "button": { "$value": "20px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the menu Download Dia button" } },
      "pill": { "$value": "9999px", "$type": "dimension", "$extensions": { "source": "computed border-radius on the home Download Dia for free button" } }
    },
    "space": {
      "button-x": { "$value": "24px", "$type": "dimension", "$extensions": { "source": "computed horizontal padding on the menu Download Dia button" } }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.family.display}", "fontSize": "39px", "fontWeight": "500", "lineHeight": "43px", "letterSpacing": "-1.55px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the home h1 at 1440" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "19px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the What's New nav link" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.family.ui}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "16px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on the menu Download Dia button" }
      },
      "label": {
        "$value": { "fontFamily": "{core.font.family.mono}", "fontSize": "13px", "fontWeight": "400", "letterSpacing": "1.3px" },
        "$type": "typography",
        "$extensions": { "source": "computed style on footer column labels" }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": { "$value": "{core.color.paper}", "$type": "color", "$extensions": { "source": "computed body background rgb(251, 250, 246)" } },
        "nav": { "$value": "{core.color.white}", "$type": "color", "$extensions": { "source": "sampled nav pill rgb(248, 248, 248)" } },
        "hero": { "$value": "{core.color.hero}", "$type": "color", "$extensions": { "source": "sampled home hero band" } }
      },
      "text": {
        "primary": { "$value": "rgba(0, 0, 0, 0.85)", "$type": "color", "$extensions": { "source": "css-var --primary and computed body color" } },
        "secondary": { "$value": "rgba(0, 0, 0, 0.60)", "$type": "color", "$extensions": { "source": "css-var --secondary" } },
        "tertiary": { "$value": "rgba(0, 0, 0, 0.45)", "$type": "color", "$extensions": { "source": "css-var --tertiary" } },
        "on-hero": { "$value": "#FFFFFF", "$type": "color", "$extensions": { "source": "computed color on the home h1" } },
        "on-action": { "$value": "{core.color.white}", "$type": "color", "$extensions": { "source": "computed color on the menu Download Dia button" } }
      },
      "action": {
        "fill": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "computed background on the menu Download Dia button, rgb(0, 0, 0)" } },
        "fill-secondary": { "$value": "rgba(0, 0, 0, 0.08)", "$type": "color", "$extensions": { "source": "css-var --fill-secondary" } },
        "hover": { "$value": "rgba(0, 0, 0, 0.90)", "$type": "color", "$extensions": { "source": "css-var --get-dia-button-hover, declared, not hovered" } }
      },
      "border": {
        "light": { "$value": "rgba(0, 0, 0, 0.06)", "$type": "color", "$extensions": { "source": "css-var --stroke-light" } },
        "medium": { "$value": "rgba(0, 0, 0, 0.12)", "$type": "color", "$extensions": { "source": "css-var --stroke-medium" } }
      },
      "link": { "$value": "{core.color.blue}", "$type": "color", "$extensions": { "source": "css-var --blue, seen on security sidebar links" } }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
