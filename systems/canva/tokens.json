{
  "core": {
    "font": {
      "family": {
        "sans": {
          "$value": "\"Canva Sans\", \"IBM Plex Sans Arabic\", \"Noto Sans Variable\", \"Noto Sans\", -apple-system, \"system-ui\", \"Segoe UI\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of plan-cta default (raw/components-computed.json); the @font-face blocks are served from static.canva.com (raw/css-vars.json fonts)"
          },
          "$description": "The one family the styled surface paints: Canva Sans, falling back to system sans."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Body and display weight (400)."
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of m-nav-item default (raw/components-computed.json)"
          },
          "$description": "The 500 weight on menu rows, footer links and plan prices."
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The 600 weight on every button, nav label and section label."
        }
      },
      "size": {
        "display-hero": {
          "$value": "80px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The 80px hero display (home)."
        },
        "display": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of pricing-h1 default (raw/components-computed.json)"
          },
          "$description": "The 64px page-title display (pricing, templates)."
        },
        "display-mobile": {
          "$value": "45px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-hero default (raw/components-computed.json)"
          },
          "$description": "The 45px display at 390 wide."
        },
        "h2": {
          "$value": "56px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of section-h2 default (raw/components-computed.json)"
          },
          "$description": "The 56px section heading."
        },
        "card-title": {
          "$value": "28px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of tool-panel default (raw/components-computed.json)"
          },
          "$description": "The 28px card/panel title (tool panel, feature card)."
        },
        "price": {
          "$value": "28.8px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "The ~29px plan price figure."
        },
        "lede": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The 24px hero lede / card titles."
        },
        "menu-item": {
          "$value": "21px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-nav-item default (raw/components-computed.json)"
          },
          "$description": "The 21px mobile-menu rows."
        },
        "section-label": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of feature-accordion default (raw/components-computed.json)"
          },
          "$description": "The 18px comparison-row / tab label."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The 16px body/button size."
        },
        "control": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The 14px control/nav text."
        },
        "meta": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-card default (raw/components-computed.json)"
          },
          "$description": "The 12px plan-card meta text."
        }
      },
      "lineHeight": {
        "display-hero": {
          "$value": "88px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Hero display leading (88px on 80px)."
        },
        "display": {
          "$value": "70.4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of pricing-h1 default (raw/components-computed.json)"
          },
          "$description": "Page-title leading (70.4px on 64px)."
        },
        "h2": {
          "$value": "61.6px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of section-h2 default (raw/components-computed.json)"
          },
          "$description": "Heading leading (61.6px on 56px)."
        },
        "card-title": {
          "$value": "35px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of tool-panel default (raw/components-computed.json)"
          },
          "$description": "Card-title leading (35px on 28px)."
        },
        "lede": {
          "$value": "33.6px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Lede leading (33.6px on 24px)."
        },
        "control": {
          "$value": "22px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of plan-cta default (raw/components-computed.json)"
          },
          "$description": "Control leading (22px on 14px)."
        },
        "meta": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of plan-card default (raw/components-computed.json)"
          },
          "$description": "Meta leading (20px on 12px)."
        }
      }
    },
    "color": {
      "brand": {
        "purple": {
          "$value": "#8b3dff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --8jnd6g (light); computed backgroundColor of plan-cta default (raw/components-computed.json); css-var --8jnd6g"
          },
          "$description": "The Canva purple #8b3dff: the Sign up pill, every plan CTA, the billing switch and the mobile Log in fill."
        },
        "purple-hover": {
          "$value": "#7630d7",
          "$type": "color",
          "$extensions": {
            "source": "css-var ---2QwGw (light); computed backgroundColor of plan-cta hover (raw/components-computed.json); css-var ---2QwGw"
          },
          "$description": "The #7630d7 hover step every purple button takes."
        },
        "purple-pressed": {
          "$value": "#612dae",
          "$type": "color",
          "$extensions": {
            "source": "css-var --KgLrHA (light); computed backgroundColor of plan-cta pressed (raw/components-computed.json); css-var --KgLrHA"
          },
          "$description": "The #612dae pressed step."
        },
        "purple-deep": {
          "$value": "#4a2e7e",
          "$type": "color",
          "$extensions": {
            "source": "css-var --GhUolA (light); css-var --GhUolA resolved light (raw/css-vars.json)"
          },
          "$description": "The declared deep purple #4a2e7e in the StyleX layer."
        },
        "gradient": {
          "$value": [
            {
              "color": "#00c4cc",
              "position": 0
            },
            {
              "color": "#7d2ae8",
              "position": 1
            }
          ],
          "$type": "gradient",
          "$extensions": {
            "source": "css-var --9v5PLg resolved light (raw/css-vars.json): the #00c4cc -> #7d2ae8 brand gradient the Canva logo mark carries"
          },
          "$description": "The teal-to-purple Canva brand gradient."
        }
      },
      "status": {
        "error": {
          "$value": "#db142c",
          "$type": "color",
          "$extensions": {
            "source": "css-var --43wRQw (light); css-var --43wRQw resolved light (raw/css-vars.json)"
          },
          "$description": "The declared error red #db142c."
        },
        "warning-text": {
          "$value": "#ad5a00",
          "$type": "color",
          "$extensions": {
            "source": "css-var --Am6Phw (light); css-var --Am6Phw resolved light (raw/css-vars.json)"
          },
          "$description": "The declared warning text #ad5a00."
        },
        "info": {
          "$value": "#3d8bff",
          "$type": "color",
          "$extensions": {
            "source": "css-var --4DkvNQ (light); css-var --4DkvNQ resolved light (raw/css-vars.json)"
          },
          "$description": "The declared info blue #3d8bff."
        }
      },
      "neutral": {
        "ink": {
          "$value": "#0f1015",
          "$type": "color",
          "$extensions": {
            "source": "computed color of oauth-button default (raw/components-computed.json)"
          },
          "$description": "The #0f1015 ink: all body text, button labels on white fills, field borders' colour base."
        },
        "white": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed ancestor-white of search-field default (raw/components-computed.json)"
          },
          "$description": "The #ffffff surface: page field, plan cards, flyout panel, auth card, the switch thumb."
        },
        "muted": {
          "$value": "rgba(16, 18, 25, 0.698)",
          "$type": "color",
          "$extensions": {
            "source": "computed muted-text of plan-card default (raw/components-computed.json)"
          },
          "$description": "The rgba(16,18,25,0.698) secondary text (plan card labels, flyout description)."
        },
        "footer-fade": {
          "$value": "#f6f7f8",
          "$type": "color",
          "$extensions": {
            "source": "computed footer-bg of footer default (raw/components-computed.json)"
          },
          "$description": "The #f6f7f8 the footer fades to."
        },
        "wash-hover": {
          "$value": "rgba(64, 79, 109, 0.06)",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of oauth-button hover (raw/components-computed.json)"
          },
          "$description": "The rgba(64,79,109,0.06) hover wash on secondary actions and tabs."
        },
        "wash-pressed": {
          "$value": "rgba(57, 70, 96, 0.14)",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of oauth-button pressed (raw/components-computed.json)"
          },
          "$description": "The rgba(57,70,96,0.14) pressed wash on secondary actions and accordion rows."
        },
        "hairline": {
          "$value": "rgba(53, 65, 90, 0.2)",
          "$type": "color",
          "$extensions": {
            "source": "computed hairline of oauth-button default (raw/components-computed.json)"
          },
          "$description": "The rgba(53,65,90,0.2) 1px inset ring secondary buttons and fields carry instead of a border."
        },
        "scrim": {
          "$value": "rgba(19, 22, 32, 0.6)",
          "$type": "color",
          "$extensions": {
            "source": "css-var --6Hmmng (light); css-var --6Hmmng resolved light (raw/css-vars.json)"
          },
          "$description": "The rgba(19,22,32,0.6) overlay the StyleX layer declares for scrims."
        }
      }
    },
    "radius": {
      "button": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of plan-cta default (raw/components-computed.json)"
        },
        "$description": "The 12px radius on buttons, links, fields and cards."
      },
      "header-control": {
        "$value": "10px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of signup-cta default (raw/components-computed.json)"
        },
        "$description": "The 10px radius on header actions."
      },
      "cta": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The 20px radius on the hero CTA."
      },
      "row": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of feature-accordion default (raw/components-computed.json)"
        },
        "$description": "The 14px radius on comparison rows."
      },
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of tool-tab default (raw/components-computed.json)"
        },
        "$description": "The 9999px pill on tabs and the billing switch."
      },
      "flyout-panel": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted layer radius inside nav-dropdown (raw/components-computed.json): '32px 0px 0px 32px'"
        },
        "$description": "The 32px radius the mega-menu's white column paints on its left corners."
      }
    },
    "measured": {
      "focus-ring-dark": {
        "$value": "#99c8ff",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of signup-cta focus-visible (raw/components-computed.json)"
        },
        "$description": "The #99c8ff light-blue keyboard ring on the dark band (1-2px auto)."
      },
      "focus-ring-light": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of plan-cta focus-visible (raw/components-computed.json)"
        },
        "$description": "The #005fcc blue keyboard ring on light surfaces (1px auto)."
      },
      "focus-ring-mobile": {
        "$value": "#e59700",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of m-nav-item focus-visible (raw/components-computed.json)"
        },
        "$description": "The #e59700 amber keyboard ring inside the mobile menu (1px auto)."
      },
      "hairline": {
        "$value": [
          {
            "color": "rgba(53, 65, 90, 0.2)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px",
            "inset": true
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of oauth-button default (raw/components-computed.json)"
        },
        "$description": "The inset 1px rgba(53,65,90,0.2) ring secondary buttons and fields draw instead of a border."
      },
      "switch-thumb-shadow": {
        "$value": [
          {
            "color": "rgba(64, 79, 109, 0.06)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0.5px",
            "inset": false
          },
          {
            "color": "rgba(21, 30, 130, 0.12)",
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "2px",
            "spread": "0px",
            "inset": false
          },
          {
            "color": "rgba(21, 30, 130, 0.06)",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "painted layer shadow inside billing-switch default (raw/components-computed.json)"
        },
        "$description": "The layered elevation the switch thumb paints."
      },
      "control-transition": {
        "$value": "100ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The 0.1s control transition (background-color, box-shadow, color) with a 0.07s transform. (background-color, box-shadow, color, transform)"
      },
      "pressed-scale": {
        "$value": 0.99,
        "$type": "number",
        "$extensions": {
          "source": "pressed rect / default rect of hero-cta (raw/components-computed.json)"
        },
        "$description": "The ~0.99 scale a pressed button takes."
      }
    }
  },
  "light": {
