{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "body": {
        "$value": "Figtree, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of body and the Get started control on https://buffer.com/"
        }
      },
      "display": {
        "$value": "Stolzl, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of the hero heading Your social media workspace"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "75.8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the hero h2 at 1440"
        }
      },
      "body": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of body"
        }
      },
      "nav": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the Log in link"
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "1440px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius of the brand button span and the email field"
        }
      }
    },
    "spacing": {
      "field-x": {
        "$value": "27px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding of the homepage email field"
        }
      },
      "field-y": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed vertical padding of the homepage email field"
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{font.display}",
          "fontSize": "{fontSize.hero}",
          "fontWeight": "400",
          "lineHeight": "83.38px",
          "letterSpacing": "-1.516px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of the hero h2 on https://buffer.com/"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.body}",
          "fontWeight": "400",
          "lineHeight": "25.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of body"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#fefdfb",
      "$type": "color",
      "$extensions": {
        "source": "computed background-color of body, rgb(254, 253, 251)"
      }
    },
    "surface": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": {
        "source": "computed background-color of the homepage email field"
      }
    },
    "text": {
      "$value": "#213130",
      "$type": "color",
      "$extensions": {
        "source": "computed color of body and the hero, rgb(33, 49, 48)"
      }
    },
    "muted": {
      "$value": "#6e6e68",
      "$type": "color",
      "$extensions": {
        "source": "computed color of the creator-count heading, rgb(110, 110, 104)"
      }
    },
    "accent": {
      "$value": "#b0ec9c",
      "$type": "color",
      "$extensions": {
        "source": "computed background-color of span.ButtonBrand_buttonContent, rgb(176, 236, 156)"
      }
    },
    "border": {
      "field": {
        "$value": "#6e6e68",
        "$type": "color",
        "$extensions": {
          "source": "computed border of the email field wrapper, 1px solid rgb(110, 110, 104)"
        }
      }
    },
    "footer": {
      "$value": "#213130",
      "$type": "color",
      "$extensions": {
        "source": "computed background-color of footer"
      }
    },
    "on-accent": {
      "$value": "#213130",
      "$type": "color",
      "$extensions": {
        "source": "computed color of the brand button text"
      }
    },
    "shadow": {
      "field": {
        "$value": "0 4px 12px -2px rgba(23, 23, 23, 0.1), 0 0 1px 1px rgba(23, 23, 23, 0.05)",
        "$type": "shadow",
        "$extensions": {
          "source": "computed box-shadow of the email field wrapper"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
