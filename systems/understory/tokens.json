 "$themes": [
  {
   "id": "light",
   "name": "Light",
   "selectedTokenSets": {
    "core": "source",
    "light": "enabled"
   },
   "$description": "The only theme understory.io paints on the public marketing site. developer.understory.io has its own light/dark toggle; those values were not tokenised."
  }
 ],
 "$metadata": {
  "tokenSetOrder": [
   "core",
   "light"
  ]
 }
