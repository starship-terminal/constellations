{
  "core": {
    "font": {
      "family": {
        "marketing": {
          "$value": "Nista, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json)"
          },
          "$description": "The marketing stack (Nista first)."
        },
        "app": {
          "$value": "NistaFonts, \"NistaFonts Fallback\", \"Helvetica Neue\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of course-title default (raw/components-computed.json)"
          },
          "$description": "The app-page stack (NistaFonts first)."
        },
        "body": {
          "$value": "Nista, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Body/nav text (Nista first)."
        }
      },
      "size": {
        "display": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of course-title default (raw/components-computed.json)"
          },
          "$description": "The course-page display size."
        },
        "hero": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The home hero size."
        },
        "title": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of register-title default (raw/components-computed.json)"
          },
          "$description": "The signup/page title size."
        },
        "subtitle": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of premium-title default (raw/components-computed.json)"
          },
          "$description": "The Premium page title."
        },
        "price": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan price size."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Body/lede size."
        },
        "nav": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-dropdown default (raw/components-computed.json)"
          },
          "$description": "Nav link size."
        },
        "meta": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of footer-link default (raw/components-computed.json)"
          },
          "$description": "Footer/meta size."
        },
        "cta": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of cta-signup default (raw/components-computed.json)"
          },
          "$description": "CTA label size."
        },
        "mobile-display": {
          "$value": "30px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-hero default (raw/components-computed.json)"
          },
          "$description": "The hero at 390px."
        }
      },
      "lineHeight": {},
      "weight": {}
    },
    "color": {
      "neutral": {
        "ink": {
          "$value": "#252b2f",
          "$type": "color",
          "$extensions": {
            "source": "computed color of register-title default (raw/components-computed.json)"
          },
          "$description": "The near-black body ink (#252b2f)."
        },
        "muted": {
          "$value": "#666e7e",
          "$type": "color",
          "$extensions": {
            "source": "computed color of flag-card default (raw/components-computed.json)"
          },
          "$description": "The grey meta text (#666e7e)."
        },
        "line": {
          "$value": "#d6dee6",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of the footer language select (raw/components-computed.json footer paint)"
          },
          "$description": "The footer select hairline sibling (#d6dee6 measured on the select)."
        },
        "paper": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "body backgroundColor computes transparent; the canvas paints white (verified against the screenshots)"
          },
          "$description": "The white page field."
        }
      },
      "brand": {
        "green": {
          "$value": "#11ee92",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of cta-signup default (raw/components-computed.json)"
          },
          "$description": "The Busuu green on every Learn-for-free CTA."
        },
        "green-hover": {
          "$value": "#41f1a8",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of cta-signup hover (raw/components-computed.json)"
          },
          "$description": "The green's lighter hover."
        },
        "blue": {
          "$value": "#116eee",
          "$type": "color",
          "$extensions": {
            "source": "computed color of course-cta default and hero-cta default; language-item hover borderTopColor (raw/components-computed.json)"
          },
          "$description": "The action/link blue #116eee (Course CTAs are ghost buttons: the blue rides on text and borders, not on a fill)."
        },
        "purple": {
          "$value": "#5438dc",
          "$type": "color",
          "$extensions": {
            "source": "computed color of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The Premium purple #5438dc on button text/borders."
        },
        "indigo": {
          "$value": "#221658",
          "$type": "color",
          "$extensions": {
            "source": "painted fill of plan-card default (raw/components-computed.json)"
          },
          "$description": "The deep indigo #221658 plan-card fill."
        },
        "mist": {
          "$value": "#f2f7fd",
          "$type": "color",
          "$extensions": {
            "source": "the footer band's painted fill, sampled in screenshots/home-light-full.png and components/crops/footer-default.png (the footer root computes transparent; the band paints #f2f7fd)"
          },
          "$description": "The pale blue #f2f7fd footer fill. The #a7b0b7 social-icon circles inside it are a separate paint."
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "45.04px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of cta-signup default (raw/components-computed.json)"
        },
        "$description": "The ~45px pill on the green CTAs."
      },
      "button": {
        "$value": "26px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of plan-cta default (raw/components-computed.json)"
        },
        "$description": "The ~26px pill on Premium buttons."
      },
      "card": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of flag-card default (raw/components-computed.json)"
        },
        "$description": "The 16px language-card radius."
      },
      "panel": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of plan-card default (raw/components-computed.json)"
        },
        "$description": "The 8px plan-card radius."
      }
    },
    "shadow": {
      "cta": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.3)",
            "offsetX": "0px",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "0px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of cta-signup (raw/components-computed.json)"
        },
        "$description": "The green CTA's resting shadow."
      }
    },
    "measured": {
      "focus-outline": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of footer-link focus-visible (raw/components-computed.json)"
        },
        "$description": "The 1px keyboard-focus ring."
      },
      "option-hover-fill": {
        "$value": "#f3f8fe",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of language-item hover's painted label child (raw/components-computed.json; the option's own box stays transparent)"
        },
        "$description": "The pale-blue hover fill inside a language option."
      },
      "option-hover-border": {
        "$value": "#116eee",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of language-item hover (raw/components-computed.json)"
        },
        "$description": "The blue border a language option takes on hover."
      },
      "cta-transition": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of cta-signup default (raw/components-computed.json)"
        },
        "$description": "The green CTA's 0.2s transition. (all)"
      },
      "card-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of flag-card default (raw/components-computed.json)"
        },
        "$description": "The language card's 0.15s transition. (background-color)"
      }
    }
  },
  "light": {
    "text": {
      "primary": {
        "$value": "{color.neutral.ink}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Body and heading ink."
      },
      "muted": {
        "$value": "{color.neutral.muted}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Meta and secondary text."
      },
      "accent": {
        "$value": "{color.brand.blue}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Links and inline accents."
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.paper}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The white page field."
      },
      "mist": {
        "$value": "{color.brand.mist}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The pale-blue footer field."
      },
      "inverse": {
        "$value": "{color.brand.indigo}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The indigo plan-card fill."
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.green}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The green Learn-for-free CTAs."
      }
    },
    "border": {
      "field": {
        "$value": "{color.neutral.line}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The form field hairline."
      },
      "hover": {
        "$value": "{color.brand.blue}",
        "$type": "color",
        "$extensions": {
          "source": "the measured 1px hover border on language options"
        },
        "$description": "The blue border a selectable option takes on hover."
      }
    },
    "component": {
      "control": {
        "height": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of cta-signup default (raw/components-computed.json)"
          },
          "$description": "The Learn-for-free CTA height."
        },
        "radius": {
          "$value": "45.04px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of cta-signup default (raw/components-computed.json)"
          },
          "$description": "CTA pill radius."
        }
      },
      "button": {
        "height": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The Get Premium button height."
        }
      },
      "card": {
        "radius": {
          "$value": "8px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of plan-card default (raw/components-computed.json)"
          },
          "$description": "Plan-card corner radius."
        }
      },
      "option": {
        "height": {
          "$value": "147px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of language-item default (raw/components-computed.json)"
          },
          "$description": "A language option's height."
        }
      },
      "header": {
        "height": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of nav-dropdown default (raw/components-computed.json)"
          },
          "$description": "The nav bar height."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme busuu.com paints; no dark theme is offered on the captured surface."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
