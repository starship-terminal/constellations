{
  "core": {
    "palette": {
      "blue": {
        "$value": "#0000ff",
        "$type": "color",
        "$extensions": {
          "source": "measured backgroundColor of scroll-down / pack-download / trial-download / login-submit / newsletter-submit / cookie-accept; color of nav-trial-cta / collapse-toggle border"
        },
        "$description": "#0000ff, the signature Ableton blue: every primary button, text links, the scroll-down chevron, category badges' companion. The site's one accent."
      },
      "blue-deep": {
        "$value": "#0032e6",
        "$type": "color",
        "$extensions": {
          "source": "measured backgroundColor of btn-buy; color of anchor-link"
        },
        "$description": "#0032e6, the deeper blue of the boxed Buy-now button and feature anchor links"
      },
      "blue-hover": {
        "$value": "#042b9f",
        "$type": "color",
        "$extensions": {
          "source": "measured borderTopColor/backgroundColor of btn-buy at hover and pressed"
        },
        "$description": "#042b9f, the hover state of the deep-blue buttons"
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "measured color of nav-link / footer-link / blog-teaser-title and backgroundColor of cookie-bar"
        },
        "$description": "#000: all body and display text, the consent card fill"
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "measured backgroundColor of footer / collapse-toggle and color of hero-title / btn-buy / cookie text"
        },
        "$description": "#fff: the page and card ground, text on blue buttons and on photo tiles, the outline buttons' border on the black consent card"
      },
      "field-gray": {
        "$value": "#eeeeee",
        "$type": "color",
        "$extensions": {
          "source": "measured backgroundColor of newsletter-field / login-field / register-field"
        },
        "$description": "#eee, the form-field fill"
      },
      "salmon": {
        "$value": "#ff8389",
        "$type": "color",
        "$extensions": {
          "source": "measured backgroundColor of blog-teaser-tag / blog-category-badge"
        },
        "$description": "#ff8389, the pink-salmon of the blog category badges"
      },
      "packs-green": {
        "$value": "#00ffaf",
        "$type": "color",
        "$extensions": {
          "source": "measured color of packs-title and textStyle of pack-card (default and hover)"
        },
        "$description": "#00ffaf, the Packs catalogue's accent: the banner title and the pack card's name"
      },
      "note-lime": {
        "$value": "#d6ff00",
        "$type": "color",
        "$extensions": {
          "source": "measured textStyle color of note-title"
        },
        "$description": "#d6ff00, the Note product accent its page title carries"
      },
      "jobs-cyan": {
        "$value": "#00ffff",
        "$type": "color",
        "$extensions": {
          "source": "measured color of jobs-title"
        },
        "$description": "#00ffff, the jobs page's accent"
      },
      "focus-orange": {
        "$value": "#ff764d",
        "$type": "color",
        "$extensions": {
          "source": "measured outlineColor of btn-try at focus-visible (solid 2px)"
        },
        "$description": "#ff764d, the focus ring the boxed buttons draw for keyboard focus"
      },
      "focus-blue": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "measured outlineColor of nav-link / footer-link / pack-download at focus-visible (auto 1px)"
        },
        "$description": "#005fcc, the auto-style focus ring on text links"
      },
      "lime-stripe": {
        "$value": "#d9f24f",
        "$type": "color",
        "$extensions": {
          "source": "read off the home promo card's striped background (home-promo-card painted layers) — approximate; the stripes alternate with pale blue"
        },
        "$description": "the lime of the rent-to-own promo stripes (a patterned cell, not a flat fill)"
      }
    },
    "font": {
      "family": {
        "futura": {
          "$value": "futura-pt, \"Futura PT\", Arial, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "measured fontFamily of every component (futura-pt on most; \"Futura PT\" on the boxed buttons)"
          },
          "$description": "Futura PT (Adobe Typekit) is the single face of the site — nav, body, display, buttons"
        }
      },
      "size": {
        "display": {
          "$value": "60px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of hero-title / live-title / live-section-title"
          },
          "$description": "60px, the display step (abl-type-60) for hero and section headlines at desktop"
        },
        "section": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of panel-title"
          },
          "$description": "40px, panel and section headlines on the home/blog index"
        },
        "lead": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of hero-cta / collapse-toggle"
          },
          "$description": "24px, lead links and feature-collapse rows"
        },
        "body": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of nav-link / footer-link / newsletter-field / login-field / cookie-accept / btn-buy"
          },
          "$description": "20px, the working size: nav links, body copy, fields, all buttons"
        },
        "small": {
          "$value": "18px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of anchor-link"
          },
          "$description": "18px, feature anchor links"
        },
        "meta": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of nav-login / cookie-bar body copy"
          },
          "$description": "16px, secondary nav text and the consent card's copy"
        },
        "badge": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured fontSize of blog-teaser-tag / blog-category-badge"
          },
          "$description": "14px, category badges"
        }
      },
      "leading": {
        "display-tight": {
          "$value": "66px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of hero-title"
          },
          "$description": "66px on the home hero (1.1)"
        },
        "display": {
          "$value": "78px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of live-title / live-section-title"
          },
          "$description": "78px on the product pages' display step (1.3)"
        },
        "section": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of panel-title"
          }
        },
        "lead": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of hero-cta / collapse-toggle"
          }
        },
        "body": {
          "$value": "30px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of nav-link / footer-link / buttons"
          },
          "$description": "30px on 20px text (1.5) — the everywhere line height"
        },
        "small": {
          "$value": "27px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of anchor-link"
          }
        },
        "meta": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of nav-login / cookie-bar"
          }
        },
        "badge": {
          "$value": "21px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured lineHeight of blog-teaser-tag / blog-category-badge"
          }
        }
      },
      "weight": {
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "measured fontWeight of nav-link / every headline / every button / badge"
          },
          "$description": "700 — headlines, buttons, nav links, badges: almost the whole interface"
        },
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "measured fontWeight of cookie-bar copy / add-to-cart link / body text"
          },
          "$description": "400 — long copy, the consent card, footer body"
        }
      },
      "tracking": {
        "normal": {
          "$value": "0px",
          "$type": "dimension",
          "$extensions": {
            "source": "measured letterSpacing of every component (all 'normal')"
          },
          "$description": "the site letter-spaces nothing"
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured borderRadius of every component — buttons, fields, cards and badges are all square"
        },
        "$description": "Ableton's signature: no rounded corners anywhere on the marketing site"
      }
    },
    "duration": {
      "fast": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "measured transitionDuration on nav/footer links and buttons (the common colour/fade step)"
        },
        "$description": "the standard link and button transition"
      }
    },
    "layout": {
      "nav-height": {
        "$value": "69px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured rect height of nav-bar"
        },
        "$description": "the top bar's height"
      },
      "content-width": {
        "$value": "1200px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured rect width of panel-title / packs-title / collapse-toggle"
        },
        "$description": "the content column's max width"
      },
      "button-height": {
        "$value": "47px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured rect height of trial-download / cookie-accept / newsletter-submit (48px on btn-buy)"
        },
        "$description": "the standard button height, 47-48px"
      },
      "button-pad-x": {
        "$value": "30px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured paddingRight/Left of every abl-button (30px flanks)"
        },
        "$description": "horizontal padding inside every button"
      },
      "field-height": {
        "$value": "46px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured rect height of login-field / register-field / newsletter-field (42px on the footer field)"
        },
        "$description": "the form-field height, 42-46px"
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.futura}",
          "fontSize": "{font.size.display}",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{font.leading.display}",
          "letterSpacing": "{font.tracking.normal}"
        },
        "$type": "typography",
        "$extensions": {
          "source": "composite of hero-title / live-title measurements"
        },
        "$description": "the display step: 60/78 bold"
      },
      "section-title": {
        "$value": {
          "fontFamily": "{font.family.futura}",
          "fontSize": "{font.size.section}",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{font.leading.section}",
          "letterSpacing": "{font.tracking.normal}"
        },
        "$type": "typography",
        "$extensions": {
          "source": "composite of panel-title"
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{font.family.futura}",
          "fontSize": "{font.size.body}",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{font.leading.body}",
          "letterSpacing": "{font.tracking.normal}"
        },
        "$type": "typography",
        "$extensions": {
          "source": "composite of every abl-button measurement"
        },
        "$description": "the button and nav-link style: 20/30 bold"
      },
      "badge": {
        "$value": {
          "fontFamily": "{font.family.futura}",
          "fontSize": "{font.size.badge}",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "{font.leading.badge}",
          "letterSpacing": "{font.tracking.normal}"
        },
        "$type": "typography",
        "$extensions": {
          "source": "composite of blog-category-badge"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "{palette.white}",
      "$type": "color",
      "$extensions": {
        "source": "footer / page background"
      },
      "$description": "#fff page background"
    },
    "surface": {
      "$value": "{palette.white}",
      "$type": "color",
      "$extensions": {
        "source": "cards and the collapse row fill"
      }
    },
    "surface-inverse": {
      "$value": "{palette.black}",
      "$type": "color",
      "$extensions": {
        "source": "cookie-bar fill and dark photo bands"
      }
    },
    "text": {
      "$value": "{palette.black}",
      "$type": "color",
      "$extensions": {
        "source": "nav-link / footer-link / body text"
      }
    },
    "text-inverse": {
      "$value": "{palette.white}",
      "$type": "color",
      "$extensions": {
        "source": "hero-title / button text on blue and on photo tiles"
      }
    },
    "accent": {
      "$value": "{palette.blue}",
      "$type": "color",
      "$extensions": {
        "source": "the primary blue of every CTA and text link"
      },
      "$description": "the signature Ableton blue"
    },
    "accent-deep": {
      "$value": "{palette.blue-deep}",
      "$type": "color",
      "$extensions": {
        "source": "boxed Buy button and anchor links"
      }
    },
    "accent-hover": {
      "$value": "{palette.blue-hover}",
      "$type": "color",
      "$extensions": {
        "source": "deep-blue buttons at hover"
      }
    },
    "badge": {
      "$value": "{palette.salmon}",
      "$type": "color",
      "$extensions": {
        "source": "category badges"
      }
    },
    "field": {
      "$value": "{palette.field-gray}",
      "$type": "color",
      "$extensions": {
        "source": "form-field fill"
      }
    },
    "focus": {
      "$value": "{palette.focus-orange}",
      "$type": "color",
      "$extensions": {
        "source": "boxed-button focus ring"
      }
    },
    "focus-link": {
      "$value": "{palette.focus-blue}",
      "$type": "color",
      "$extensions": {
        "source": "link focus ring"
      }
    },
    "border": {
      "$value": "{palette.blue}",
      "$type": "color",
      "$extensions": {
        "source": "the only visible borders: 2px blue on the collapse row, 1px deep blue on the boxed Buy button (forms and cards are borderless)"
      },
      "$description": "borders appear only on outlined controls; the default 'border' is the accent"
    },
    "component": {
      "button-primary-bg": {
        "$value": "{palette.blue}",
        "$type": "color",
        "$extensions": {
          "source": "scroll-down / pack-download / trial-download / login-submit / newsletter-submit backgroundColor"
        },
        "$description": "#0000ff fill on every primary button"
      },
      "button-primary-fg": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "same buttons' color"
        }
      },
      "button-deep-bg": {
        "$value": "{palette.blue-deep}",
        "$type": "color",
        "$extensions": {
          "source": "btn-buy backgroundColor"
        },
        "$description": "the boxed Buy button's deeper blue"
      },
      "button-deep-hover-bg": {
        "$value": "{palette.blue-hover}",
        "$type": "color",
        "$extensions": {
          "source": "btn-buy borderTopColor/backgroundColor at hover and pressed"
        }
      },
      "button-outline-border": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "cookie-close / cookie-more-info borderColor"
        },
        "$description": "2px outline on dark surfaces (the consent card)"
      },
      "field-bg": {
        "$value": "{palette.field-gray}",
        "$type": "color",
        "$extensions": {
          "source": "newsletter-field / login-field backgroundColor"
        }
      },
      "badge-bg": {
        "$value": "{palette.salmon}",
        "$type": "color",
        "$extensions": {
          "source": "blog-teaser-tag / blog-category-badge backgroundColor"
        }
      },
      "card-dark-bg": {
        "$value": "{palette.black}",
        "$type": "color",
        "$extensions": {
          "source": "cookie-bar backgroundColor"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme painted"
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
