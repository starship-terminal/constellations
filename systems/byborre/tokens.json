{
 "$description": "BYBORRE public site, measured 2026-11-21 from byborre.com. One light theme.",
 "core": {
  "$description": "Measured scales from the public byborre.com pages. One theme.",
  "color": {
   "cream": {
    "$value": "#f5f5f0",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of body and header on / (raw/components-computed.json, live reading body)"
    }
   },
   "creamDeep": {
    "$value": "#ccccc4",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of login-email and contact field, and backgroundColor of cart-button hover"
    }
   },
   "ink": {
    "$value": "#1b1b1b",
    "$type": "color",
    "$extensions": {
     "source": "computed color of body and backgroundColor of footer, login-submit and order-sample"
    }
   },
   "white": {
    "$value": "#ffffff",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of login-email and contact field, and color of footer text"
    }
   },
   "yellow": {
    "$value": "#fae210",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of the New badge and of hero-cta and order-sample on hover"
    }
   },
   "muted": {
    "$value": "#646e69",
    "$type": "color",
    "$extensions": {
     "source": "computed color of the contact select placeholder"
    }
   },
   "focusBlue": {
    "$value": "#005fcc",
    "$type": "color",
    "$extensions": {
     "source": "computed outlineColor of cart-button focus-visible (browser default on the icon button)"
    }
   },
   "primary500": {
    "$value": "#00e606",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-primary-500 on :root (raw/css-vars.json). Not the fill of any measured public control"
    }
   }
  },
  "font": {
   "sans": {
    "$value": "Helvetica Neue",
    "$type": "fontFamily",
    "$extensions": {
     "source": "@font-face family on the live home page, computed fontFamily of body"
    }
   },
   "fallback": {
    "$value": "Arial, ui-sans-serif, system-ui, sans-serif",
    "$type": "fontFamily",
    "$extensions": {
     "source": "computed fontFamily stack after Helvetica Neue on body"
    }
   }
  },
  "typography": {
   "display": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "80px",
     "fontWeight": 500,
     "lineHeight": "84px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of h1 Textile Room on /collection"
    }
   },
   "hero": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "80px",
     "fontWeight": 500,
     "lineHeight": "84px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the home hero headline (two lines, 168px box)"
    }
   },
   "error": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "128px",
     "fontWeight": 700,
     "lineHeight": "128px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the 404 numeral"
    }
   },
   "dialogTitle": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "40px",
     "fontWeight": 400,
     "lineHeight": "42px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of Log in to continue"
    }
   },
   "productTitle": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "40px",
     "fontWeight": 400,
     "lineHeight": "40px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the Blink heading"
    }
   },
   "body": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "13px",
     "fontWeight": 400,
     "lineHeight": "19.5px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of body"
    }
   },
   "nav": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the Textile Room header link"
    }
   },
   "button": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "16px",
     "fontWeight": 500,
     "lineHeight": "24px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of Explore samples and Login"
    }
   },
   "label": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "12px",
     "fontWeight": 500,
     "lineHeight": "16px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the Pattern filter and Get in touch with sales"
    }
   },
   "marquee": {
    "$value": {
     "fontFamily": "{font.sans}",
     "fontSize": "11px",
     "fontWeight": 500,
     "lineHeight": "12px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed style of the sample marquee"
    }
   }
  },
  "radius": {
   "none": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed border radius of body and page titles"
    }
   },
   "sm": {
    "$value": "8px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed border radius of the New badge and header links"
    }
   },
   "md": {
    "$value": "10px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed border radius of buttons, fields and the order bar"
    }
   },
   "footer": {
    "$value": "24px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed borderTopLeftRadius of footer"
    }
   },
   "pill": {
    "$value": "9999px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed border radius of the cart icon button"
    }
   }
  },
  "space": {
   "headerPad": {
    "$value": "16px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed paddingLeft of header"
    }
   },
   "controlX": {
    "$value": "16px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed paddingLeft of the pop-up store button and login fields"
    }
   },
   "badgeX": {
    "$value": "8px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed paddingLeft of the New badge"
    }
   },
   "badgeY": {
    "$value": "4px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed paddingTop of the New badge"
    }
   }
  },
  "size": {
   "header": {
    "$value": "57px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of header at 1440"
    }
   },
   "control": {
    "$value": "48px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of buttons and text fields"
    }
   },
   "controlSm": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of the Pattern filter, sales link and icon buttons"
    }
   },
   "icon": {
    "$value": "32px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed width and height of the cart and account icon buttons"
    }
   },
   "textarea": {
    "$value": "104px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of the contact textarea"
    }
   },
   "dialog": {
    "$value": "648px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of the login dialog panel"
    }
   },
   "cart": {
    "$value": "380px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed width of the empty cart drawer"
    }
   }
  },
  "border": {
   "hairline": {
    "$value": "1px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed borderTopWidth of fields, buttons and the Pattern filter"
    }
   },
   "focus": {
    "$value": "2px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed outlineWidth of nav-link, hero-cta and login-email on focus-visible"
    }
   }
  }
 },
 "light": {
  "background": {
   "page": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of body"
    }
   },
   "surface": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of the login dialog and text fields"
    }
   },
   "inverse": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of footer and the 404 panel"
    }
   }
  },
  "text": {
   "primary": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of body"
    }
   },
   "onInverse": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of footer"
    }
   },
   "onAccent": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of login-submit (cream on ink)"
    }
   },
   "muted": {
    "$value": "{color.muted}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of the contact select"
    }
   }
  },
  "border": {
   "default": {
    "$value": "{color.creamDeep}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of login-email"
    }
   },
   "strong": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of login-submit"
    }
   }
  },
  "action": {
   "primary": {
    "$value": "{color.ink}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of login-submit and order-sample default"
    }
   },
   "primaryText": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of login-submit"
    }
   },
   "hover": {
    "$value": "{color.yellow}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of hero-cta and order-sample on hover"
    }
   },
   "quiet": {
    "$value": "{color.cream}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of Explore samples at rest"
    }
   }
  },
  "focus": {
   "width": {
    "$value": "2px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed outlineWidth of nav-link, hero-cta and login-email on focus-visible. outlineColor computed as transparent on those controls"
    }
   },
   "offset": {
    "$value": "4px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed box-shadow spread of the Material accordion on focus-visible: rgb(245, 245, 240) 0px 0px 0px 4px"
    }
   }
  },
  "$description": "Semantic roles for the one painted theme. Aliases point at core."
 },
 "$themes": [
  {
   "name": "light",
   "selectedTokenSets": {
    "core": "source",
    "light": "enabled"
   }
  }
 ]
}
