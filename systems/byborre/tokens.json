          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The 48px primary/secondary button height."
        }
      },
      "field": {
        "height": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of text-field default (raw/components-computed.json)"
          },
          "$description": "The 48px field height."
        }
      },
      "tab": {
        "height": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of view-tab default (raw/components-computed.json)"
          },
          "$description": "The 36px view-tab height."
        }
      },
      "dropdown": {
        "height": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of pattern-dropdown default (raw/components-computed.json)"
          },
          "$description": "The 32px dropdown-trigger height."
        }
      },
      "chip": {
        "size": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of colour-chip default (raw/components-computed.json)"
          },
          "$description": "The 32px colour-chip circle."
        }
      },
