        "$type": "color",
        "$extensions": {
          "source": "role alias over the core palette"
        },
        "$description": "The 1px field/tab/dropdown border."
      },
      "hairline": {
        "$value": "{color.neutral.hairline}",
        "$type": "color",
        "$extensions": {
