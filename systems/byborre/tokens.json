{
  "core": {
    "font": {
      "family": {
        "sans": {
          "$value": "\"Helvetica Neue\", Arial, ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-cta default (raw/components-computed.json); @font-face 'Helvetica Neue' 400/500/700 declared in raw/css-vars.json"
          },
          "$description": "The one stack the whole site paints: Helvetica Neue first, Arial and the system sans fallbacks."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of nav-link default (raw/components-computed.json)"
          },
          "$description": "Body/nav weight (400)."
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of page-title default (raw/components-computed.json)"
          },
          "$description": "Display and button-label weight (500)."
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "@font-face 'Helvetica Neue' weight 700 in raw/css-vars.json"
          },
          "$description": "The declared bold face; nothing on the captured surface paints it."
        }
      },
      "size": {
        "display": {
          "$value": "80px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of page-title default (raw/components-computed.json)"
          },
          "$description": "The 80px display (Textile Room, FAQ, Contact titles)."
        },
        "display-mobile": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-hero default (raw/components-computed.json)"
          },
          "$description": "The 48px display at 390px."
        },
        "h2": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of section-h2 default (raw/components-computed.json)"
          },
          "$description": "The 48px section heading."
        },
        "title": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of textile-title default (raw/components-computed.json)"
          },
          "$description": "The 48px textile-detail title."
        },
        "lede": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The 24px hero lede."
        },
        "name": {
          "$value": "40px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of person-card default (raw/components-computed.json)"
          },
          "$description": "The 40px contact-name size."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The 16px body/button/nav size."
        },
        "small": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of filter-bar default (raw/components-computed.json)"
          },
          "$description": "The 13px small text (filter bar, cards, spec rows, FAQ rows)."
        },
        "meta": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of pattern-dropdown default (raw/components-computed.json)"
          },
          "$description": "The 12px meta size (dropdown trigger, card labels, nav badge)."
        },
        "micro": {
          "$value": "11px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of marquee default (raw/components-computed.json)"
          },
          "$description": "The 11px marquee text."
        },
        "foot": {
          "$value": "10px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of footer-link default (raw/components-computed.json)"
          },
          "$description": "The 10px footer links."
        }
      },
      "lineHeight": {
        "display": {
          "$value": "84px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of page-title default (raw/components-computed.json)"
          },
          "$description": "Display leading (84px on 80px type)."
        },
        "h2": {
          "$value": "53px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of section-h2 default (raw/components-computed.json)"
          },
          "$description": "Heading leading."
        },
        "lede": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Lede leading."
        },
        "body": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-cta default (raw/components-computed.json)"
          },
          "$description": "Body/button leading."
        },
        "small": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of filter-bar default (raw/components-computed.json)"
          },
          "$description": "Small-text leading."
        },
        "micro": {
          "$value": "12px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of marquee default (raw/components-computed.json)"
          },
          "$description": "Marquee leading."
        }
      }
    },
    "color": {
      "neutral": {
        "ink": {
          "$value": "#1b1b1b",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The black-BRAND ink #1b1b1b: all text, the dark button fill, the footer/marquee panels and the focus ring."
        },
        "cream": {
          "$value": "#f5f5f0",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of filter-bar default (raw/components-computed.json)"
          },
          "$description": "The cream #f5f5f0 canvas — page field, filter bar, secondary buttons, view tabs and the mobile menu."
        },
        "field": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of text-field default (raw/components-computed.json)"
          },
          "$description": "The white #ffffff fill inside the 1px field border."
        },
        "line": {
          "$value": "#ccccc4",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of text-field default (raw/components-computed.json)"
          },
          "$description": "The cream-300 #ccccc4 on every field, tab, dropdown, colour-chip ring and mobile-menu row border."
        },
        "muted": {
          "$value": "#646e69",
          "$type": "color",
          "$extensions": {
            "source": "computed placeholder of text-field default (raw/components-computed.json)"
          },
          "$description": "The cream-500 #646e69 on field placeholders and text-link hover."
        },
        "hairline": {
          "$value": "#e5e5e1",
          "$type": "color",
          "$extensions": {
            "source": "painted layer border of filter-bar default (raw/components-computed.json)"
          },
          "$description": "The cream-200 #e5e5e1 hairline painted inside the collection filter bar."
        },
        "icon-muted": {
          "$value": "#999993",
          "$type": "color",
          "$extensions": {
            "source": "painted layer bg of view-tab default (raw/components-computed.json)"
          },
          "$description": "The cream-400 #999993 on the tabs' + icon, the Collaboration badge outline and the colour-chip hover ring."
        },
        "divider-dark": {
          "$value": "#454542",
          "$type": "color",
          "$extensions": {
            "source": "painted layer border of footer default (raw/components-computed.json)"
          },
          "$description": "The cream-600 #454542 divider inside the ink footer panel."
        },
        "grey": {
          "$value": "#7c7c7c",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-gray-DEFAULT (light)"
          },
          "$description": "The declared --color-gray-DEFAULT channel triplet #7c7c7c."
        }
      },
      "brand": {
        "primary-50": {
          "$value": "#e7ffe4",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-50 (light)"
          },
          "$description": "The declared primary 50 channel triplet (Tailwind rgb(var(--color-primary-50) / a))."
        },
        "primary-100": {
          "$value": "#c9ffc4",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-100 (light)"
          },
          "$description": "The declared primary 100 channel triplet (Tailwind rgb(var(--color-primary-100) / a))."
        },
        "primary-200": {
          "$value": "#98ff90",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-200 (light)"
          },
          "$description": "The declared primary 200 channel triplet (Tailwind rgb(var(--color-primary-200) / a))."
        },
        "primary-300": {
          "$value": "#94cf96",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-300 (light)"
          },
          "$description": "The declared primary 300 channel triplet (Tailwind rgb(var(--color-primary-300) / a))."
        },
        "primary-400": {
          "$value": "#00ff00",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-400 (light)"
          },
          "$description": "The declared primary 400 channel triplet (Tailwind rgb(var(--color-primary-400) / a))."
        },
        "primary-500": {
          "$value": "#00e606",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-500 (light)"
          },
          "$description": "The declared primary 500 channel triplet (Tailwind rgb(var(--color-primary-500) / a))."
        },
        "primary-600": {
          "$value": "#00b809",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-600 (light)"
          },
          "$description": "The declared primary 600 channel triplet (Tailwind rgb(var(--color-primary-600) / a))."
        },
        "primary-700": {
          "$value": "#008b07",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-700 (light)"
          },
          "$description": "The declared primary 700 channel triplet (Tailwind rgb(var(--color-primary-700) / a))."
        },
        "primary-800": {
          "$value": "#076d0d",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-800 (light)"
          },
          "$description": "The declared primary 800 channel triplet (Tailwind rgb(var(--color-primary-800) / a))."
        },
        "primary-900": {
          "$value": "#0b5c11",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-900 (light)"
          },
          "$description": "The declared primary 900 channel triplet (Tailwind rgb(var(--color-primary-900) / a))."
        },
        "primary-950": {
          "$value": "#003406",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-950 (light)"
          },
          "$description": "The declared primary 950 channel triplet (Tailwind rgb(var(--color-primary-950) / a))."
        },
        "primary": {
          "$value": "#00e606",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-primary-DEFAULT (light)"
          },
          "$description": "primary DEFAULT: 500 in light, 400 under .dark."
        },
        "accent": {
          "$value": "#fae210",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of order-cta hover (raw/components-computed.json)"
          },
          "$description": "The #fae210 yellow every ink button and the hero CTA takes on hover — the site's signature accent."
        },
        "accent-border": {
          "$value": "#c8b50d",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of order-cta hover (raw/components-computed.json)"
          },
          "$description": "The deeper #c8b50d edge the yellow hover keeps."
        }
      }
    },
    "radius": {
      "control": {
        "$value": "10px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The 10px radius on buttons, fields, tabs and the dropdown trigger."
      },
      "link": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of nav-link default (raw/components-computed.json)"
        },
        "$description": "The 8px radius on nav links, flyout links, swatches and menu rows."
      },
      "panel": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of footer default (raw/components-computed.json)"
        },
        "$description": "The 24px top radius on the ink footer panel."
      },
      "chip": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted layer radius of colour-chip (raw/components-computed.json)"
        },
        "$description": "The 9999px pill on colour chips, the card badge and the card's circle actions."
      },
      "card": {
        "$value": "10px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted layer radius of textile-card (raw/components-computed.json)"
        },
        "$description": "The 10px radius on the textile-card image tile."
      }
    },
    "measured": {
      "focus-ring": {
        "$value": [
          {
            "color": "#ffffff",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px",
            "inset": true
          },
          {
            "color": "#1b1b1b",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "2px",
            "inset": true
          },
          {
            "color": "rgba(0, 0, 0, 0)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px",
            "inset": false
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of nav-link focus-visible (raw/components-computed.json)"
        },
        "$description": "The keyboard-focus ring on links/buttons/fields: a white 0-spread layer plus a 2px ink ring drawn inset — the outline itself is 2px rgba(0,0,0,0) offset 2px."
      },
      "focus-accent": {
        "$value": "#00e606",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of textile-card focus-visible (raw/components-computed.json)"
        },
        "$description": "The #00e606 primary outline links and cards take on keyboard focus (1px auto)."
      },
      "focus-fallback": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of faq-question focus-visible (raw/components-computed.json)"
        },
        "$description": "The #005fcc UA fallback outline the FAQ rows and view tabs get — the site styles no ring on them."
      },
      "chip-hover-border": {
        "$value": "#999993",
        "$type": "color",
        "$extensions": {
          "source": "painted layer border of colour-chip hover (raw/components-computed.json)"
        },
        "$description": "The #999993 ring a colour chip takes on hover (was #ccccc4)."
      },
      "dropdown-hover": {
        "$value": "rgba(0, 0, 0, 0.1)",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of pattern-dropdown hover (raw/components-computed.json)"
        },
        "$description": "The 10%-black wash the Pattern dropdown gets on hover."
      },
      "card-scrim": {
        "$value": "rgba(0, 0, 0, 0.3)",
        "$type": "color",
        "$extensions": {
          "source": "painted scrim layer of textile-card default (raw/components-computed.json)"
        },
        "$description": "The 30%-black scrim over textile-card imagery."
      },
      "chip-blue": {
        "$value": "#0e4c92",
        "$type": "color",
        "$extensions": {
          "source": "painted swatch fill of colour-chip default (raw/components-computed.json)"
        },
        "$description": "The #0e4c92 fill the BLUE colour chip paints — a textile colour, not a UI role."
      },
      "control-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The 0.15s control transition (colour/background). (all)"
      },
      "link-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of nav-link default (raw/components-computed.json)"
        },
        "$description": "The nav link's 0.15s transition. (color, background-color, border-color, text-decoration-color, fill, stroke)"
      },
      "pressed-scale": {
        "$value": 0.98,
        "$type": "number",
        "$extensions": {
          "source": "pressed rect / default rect of hero-cta (raw/components-computed.json)"
        },
        "$description": "The 0.98 scale a pressed button takes."
      },
      "marquee-duration": {
        "$value": "10000ms",
        "$type": "duration",
        "$extensions": {
          "source": "animation 'marquee-063d6d2b' 10s linear infinite in the readable stylesheet (raw/css-vars.json) and the reducedMotion probe in raw/components-computed.json"
        },
        "$description": "The top ticker's 10s linear scroll; it keeps running under prefers-reduced-motion."
      },
      "fade-300": {
        "$value": "300ms",
        "$type": "duration",
        "$extensions": {
          "source": "transition declarations in the readable sheets (raw/components-computed.json _meta.sheets)"
        },
        "$description": "The 0.3s cubic-bezier(0.4,0,0.2,1) opacity/transform/max-height the site's toggles declare."
      },
      "ease-default": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "transition declarations in the readable sheets (raw/components-computed.json _meta.sheets)"
        },
        "$description": "The cubic-bezier(0.4,0,0.2,1) easing on the 0.3s toggles."
      }
    }
  },
  "light": {
    "text": {
      "primary": {
        "$value": "{color.neutral.ink}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the core palette"
        },
        "$description": "Body and display ink."
      },
      "muted": {
        "$value": "{color.neutral.muted}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the core palette"
        },
        "$description": "Placeholders and text-link hover."
      },
      "on": {
