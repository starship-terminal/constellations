{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(51, 51, 51) on https://kith.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "painted page and interior header. Sampled from category-light-1440.png and about-light-1440.png" }
      },
      "footer": {
        "$value": "#f2f2f2",
        "$type": "color",
        "$extensions": { "source": "computed footer background rgb(242, 242, 242)" }
      },
      "buy": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "painted product buy column. Sampled from product-light-1440.png. getComputedStyle on .product__information reports transparent" }
      },
      "image": {
        "$value": "#ebebeb",
        "$type": "color",
        "$extensions": { "source": "painted product image well, sampled rgb(235, 235, 235)" }
      },
      "muted": {
        "$value": "#828282",
        "$type": "color",
        "$extensions": { "source": "computed Select a size background rgb(130, 130, 130), confirmed in the PNG" }
      },
      "on-muted": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Select a size label rgb(255, 255, 255)" }
      },
      "chip-border": {
        "$value": "#d9d9d9",
        "$type": "color",
        "$extensions": { "source": "computed size chip border rgb(217, 217, 217). Painted light on the black buy column" }
      },
      "hero-on": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed homepage header and Shop now label rgb(255, 255, 255) over the hero" }
      }
    },
    "font": {
      "ui": {
        "$value": "proxima-nova, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily. File is not in this package" }
      },
      "display": {
        "$value": "Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed hero h2, product h1, and About h1" }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "28px", "fontWeight": 400, "lineHeight": "37.324px", "letterSpacing": "1.4px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage hero h2 and About h1" }
      },
      "title": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "23.994px", "letterSpacing": "0.9px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1 and collection h1" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "15px", "letterSpacing": "3px" },
        "$type": "typography",
        "$extensions": { "source": "computed desktop nav button, uppercase" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "15px", "letterSpacing": "1.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed Shop now and Select a size, uppercase" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 300, "lineHeight": "15px", "letterSpacing": "0.6px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "footer-heading": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "10px", "fontWeight": 700, "lineHeight": "15px", "letterSpacing": "0.5px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer column heading, uppercase" }
      }
    },
    "size": {
      "header": {
        "$value": "66px",
        "$type": "dimension",
        "$extensions": { "source": "computed s-header height, padding 18px 24px" }
      },
      "logo": {
        "$value": "54px",
        "$type": "dimension",
        "$extensions": { "source": "computed logo link width. Height 23px" }
      },
      "button": {
        "$value": "41px",
        "$type": "dimension",
        "$extensions": { "source": "computed Shop now and Select a size height" }
      },
      "size-chip": {
        "$value": "79px",
        "$type": "dimension",
        "$extensions": { "source": "computed size chip width. Height 41px" }
      }
    },
    "radius": {
      "control": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed Shop now, size chip, and Select a size border-radius" }
      }
    }
  }
}
