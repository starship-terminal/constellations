{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "page": {
        "$value": "#FBFBFB",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(251, 251, 251) on https://poshmark.com/ 2026-11-22" }
      },
      "header": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed header background rgb(255, 255, 255)" }
      },
      "ink": {
        "$value": "#121212",
        "$type": "color",
        "$extensions": { "source": "computed body and nav link rgb(18, 18, 18)" }
      },
      "burgundy": {
        "$value": "#610722",
        "$type": "color",
        "$extensions": { "source": "fill on the public header SVG poshmark-redesign-logo-web" }
      },
      "burgundy-icon": {
        "$value": "#7F0353",
        "$type": "color",
        "$extensions": { "source": "majority pixel of the 180px apple touch icon, rgb(127, 3, 83). The wordmark SVG is #610722" }
      },
      "on-ink": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed Log in / Sign up label rgb(255, 255, 255) on the ink button" }
      },
      "live": {
        "$value": "#BA4E41",
        "$type": "color",
        "$extensions": { "source": "computed Posh Live link rgb(186, 78, 65)" }
      },
      "muted": {
        "$value": "#717171",
        "$type": "color",
        "$extensions": { "source": "computed About sidebar links rgb(113, 113, 113) on /what_is_poshmark" }
      },
      "muted-soft": {
        "$value": "#999999",
        "$type": "color",
        "$extensions": { "source": "computed footer Canada link and About Poshmark heading rgb(153, 153, 153)" }
      },
      "footer": {
        "$value": "#121212",
        "$type": "color",
        "$extensions": { "source": "computed footer background rgb(18, 18, 18)" }
      },
      "on-hero": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$extensions": { "source": "computed FREE SHIPPING heading rgb(255, 255, 255)" }
      },
      "chip": {
        "$value": "#F6F6F6",
        "$type": "color",
        "$extensions": { "source": "Women category title band, read from the category photograph. Not a computed style" }
      }
    },
    "font": {
      "ui": {
        "$value": "Graphik, \"Helvetica Neue\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body, nav, price, and Log in. Graphik was loaded. The file is not in this package" }
      },
      "display": {
        "$value": "NantesWeb, Nantes, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed FREE SHIPPING, category h1, and footer heading. The file is not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0.15px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0.15px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women department link" }
      },
      "login": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0.15px" },
        "$type": "typography",
        "$extensions": { "source": "computed Log in / Sign up. Not clicked" }
      },
      "search": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 400, "lineHeight": "26px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed search input. Not submitted" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 600, "lineHeight": "20px", "letterSpacing": "0.15px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage price $149" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "52px", "fontWeight": 600, "lineHeight": "62px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h2 FREE SHIPPING, white on the photo" }
      },
      "category-title": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "26px", "fontWeight": 600, "lineHeight": "42px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed category h1 on /category/Women" }
      },
      "footer-heading": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "40px", "fontWeight": 600, "lineHeight": "42px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer heading Real finds, real inspiration, every day" }
      },
      "sign-up": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "15px", "fontWeight": 500, "lineHeight": "20px", "letterSpacing": "0.15px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage Sign Up. Not clicked" }
      }
    },
    "space": {
      "header": { "$value": "116px", "$type": "dimension", "$extensions": { "source": "computed header height, utility 73 plus department 44" } },
      "utility": { "$value": "73px", "$type": "dimension", "$extensions": { "source": "computed header--fixed nav" } },
      "department": { "$value": "44px", "$type": "dimension", "$extensions": { "source": "computed department nav row" } },
      "logo-inset": { "$value": "26px", "$type": "dimension", "$extensions": { "source": "logo left edge on the 1440 viewport" } },
      "menu": { "$value": "415px", "$type": "dimension", "$extensions": { "source": "computed Women dropdown height while open" } },
      "footer": { "$value": "608px", "$type": "dimension", "$extensions": { "source": "computed footer height on the homepage" } }
    },
    "radius": {
      "search": { "$value": "60px", "$type": "dimension", "$extensions": { "source": "computed .search-box-con border-radius" } },
      "login": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "computed Log in / Sign up" } },
      "sign-up": { "$value": "3px", "$type": "dimension", "$extensions": { "source": "computed homepage Sign Up" } },
      "start-selling": { "$value": "14px", "$type": "dimension", "$extensions": { "source": "computed Start Selling on /what_is_poshmark. Not clicked" } },
      "nav": { "$value": "0px", "$type": "dimension", "$extensions": { "source": "department links" } }
    },
    "shadow": {
      "header": { "$value": "none", "$type": "shadow", "$extensions": { "source": "computed header box-shadow none" } }
    }
  }
}
