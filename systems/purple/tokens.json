{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": {
        "$value": "#181831",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Body, nav, and primary button color rgb(24, 24, 49) on the 18 November 2026 mattresses archive at 1440 CSS pixels."
        }
      },
      "promo": {
        "$value": "#ca2b16",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Black Friday Sale nav link color rgb(202, 43, 22). On sale badge uses the same fill."
        }
      },
      "promo-bar": {
        "$value": "#0f0f3a",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Promo banner backgroundColor rgb(15, 15, 58) on the mattresses archive."
        }
      },
      "page": {
        "$value": "#f8f5ef",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Header top strip and footer backgroundColor rgb(248, 245, 239). Homepage screenshot corner matches."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Primary button and On sale badge color rgb(255, 255, 255). October hero type is the same."
        }
      },
      "wordmark": {
        "$value": "#1f1a5e",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Header SVG path fill #1F1A5E in a.site-logo."
        }
      }
    },
    "font": {
      "text": {
        "$value": "Graphik, arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. Body, nav, hero, and buttons. Graphik woff2 files are preloaded and are not in this package."
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Primary button, Shop sale, and Hide Filters borderRadius."
        }
      },
      "promo": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Promo banner borderRadius."
        }
      },
      "badge": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. On sale badge borderRadius."
        }
      },
      "field": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Footer email wrap borderRadius. The form was not submitted."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "text": { "$value": "{core.color.ink}", "$type": "color" },
      "accent": { "$value": "{core.color.promo}", "$type": "color" },
      "on-accent": { "$value": "{core.color.on-ink}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
