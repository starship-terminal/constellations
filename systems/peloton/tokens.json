{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": {
        "$value": "#181a1d",
        "$type": "color",
        "$extensions": { "source": "Measured. Nav bar background rgb(24, 26, 29) on https://www.onepeloton.com/ 2026-11-22. Body color is the same ink." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo copy and homepage h1 rgb(255, 255, 255). Wordmark paths fill #FFFFFF." }
      },
      "red": {
        "$value": "#df1c2f",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo bar fill rgb(223, 28, 47). Bike page Shop now fill and border are the same red." }
      },
      "deals": {
        "$value": "#ff5a5a",
        "$type": "color",
        "$extensions": { "source": "Measured. Deals nav label color rgb(255, 90, 90)." }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Bike page Shop deals pill on the homepage is white rgb(255, 255, 255). The bike page surface reads white in the screenshot. Body and html backgrounds are transparent." }
      }
    },
    "font": {
      "body": {
        "$value": "Inter, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body, nav, h1, and Shop now fontFamily. Files are not in this package." }
      }
    },
    "radius": {
      "pill": {
        "$value": "28px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage Shop deals border-radius 28px. Bike page primary Shop now is also 28px." }
      },
      "pill-sticky": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Sticky Shop now on the bike page border-radius 20px, height 40px." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "Alias of core.color.page." } },
      "ink": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "Alias of core.color.ink." } },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color", "$extensions": { "source": "Alias of core.color.on-ink." } },
      "red": { "$value": "{core.color.red}", "$type": "color", "$extensions": { "source": "Alias of core.color.red." } },
      "deals": { "$value": "{core.color.deals}", "$type": "color", "$extensions": { "source": "Alias of core.color.deals." } }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
