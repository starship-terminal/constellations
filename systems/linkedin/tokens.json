{
  "core": {
    "font": {
      "family": {
        "sans": {
          "$value": "-apple-system",
          "$type": "fontFamily",
          "$extensions": {
            "source": "css-var --artdeco-reset-typography-font-family-sans (light)",
            "stack": "-apple-system,system-ui,BlinkMacSystemFont,Segoe UI,Roboto,Helvetica Neue,Fira Sans,Ubuntu,Oxygen,Oxygen Sans,Cantarell,Droid Sans,Apple Color Emoji,Segoe UI Emoji,Segoe UI Emoji,Segoe UI Symbol,Lucida Grande,Helvetica,Arial,sans-serif"
          }
        }
      }
    },
    "fontSize": {
      "xs": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on footer-link/default (https://www.linkedin.com/), 1440x900, 2026-11-18"
        }
      },
      "sm": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on filter-chip/default (https://www.linkedin.com/jobs/search/), 1440x900, 2026-11-18"
        }
      },
      "md": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on apply-cta/default (https://www.linkedin.com/jobs/search/), 1440x900, 2026-11-18"
        }
      },
      "lg": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "Reconstruction: entered by hand at capture time; no raw reading holds this value; the .text-lg step below the papabear breakpoint, which no capture measured"
        }
      },
      "xl": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on company-h1/default (https://www.linkedin.com/company/linkedin), 1440x900, 2026-11-18; text-lg papabear:text-xl at 1440"
        }
      },
      "display-sm": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on profile-h1/default (https://www.linkedin.com/in/reidhoffman), 1440x900, 2026-11-18"
        }
      },
      "display-md": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on section-heading/default (https://www.linkedin.com/), 1440x900, 2026-11-18"
        }
      },
      "display-lg": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "measured fontSize on hero-h1/default (https://www.linkedin.com/), 1440x900, 2026-11-18"
