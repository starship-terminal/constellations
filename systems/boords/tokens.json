          "$value": "rgba(18, 18, 18, 0.6)",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav/body text at 60% ink."
        },
        "muted": {
          "$value": "#7b7b7b",
