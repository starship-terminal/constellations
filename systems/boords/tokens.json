        "display": {
          "$value": 600,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Display weight."
        },
        "nav": {
          "$value": 400,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav label weight."
        },
        "price": {
          "$value": 400,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan price weight."
        }
      }
    },
    "color": {
