{
  "core": {
    "font": {
      "family": {
        "body": {
          "$value": "matter, ui-sans-serif, system-ui, -apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The single matter stack used everywhere."
        },
        "display": {
          "$value": "matter, ui-sans-serif, system-ui, -apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json)"
          },
          "$description": "The matter stack at display size."
        }
      },
      "size": {
        "display": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The page/hero display size."
        },
        "cta": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-cta default (raw/components-computed.json)"
          },
          "$description": "Hero CTA size."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of timer-field default (raw/components-computed.json)"
          },
          "$description": "Field/body size."
        },
        "nav": {
          "$value": "14.4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav/footer label size."
        },
        "meta": {
          "$value": "10.4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of footer-link default (raw/components-computed.json)"
          },
          "$description": "Small footer/meta size."
        },
        "price": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan price size."
        }
      },
      "lineHeight": {
        "display": {
          "$value": "66.56px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Display line height."
        }
      },
      "weight": {
        "display": {
          "$value": 600,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Display weight."
        },
        "nav": {
          "$value": 400,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav label weight."
        },
        "price": {
          "$value": 400,
          "$type": "number",
          "$extensions": {
            "source": "computed fontWeight of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan price weight."
        }
      }
    },
    "color": {
      "neutral": {
        "ink": {
          "$value": "#121212",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-title default (raw/components-computed.json)"
          },
          "$description": "Headline/button ink (#121212)."
        },
        "body": {
          "$value": "rgba(18, 18, 18, 0.6)",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav/body text at 60% ink."
        },
        "muted": {
          "$value": "#7b7b7b",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The grey lede/meta text."
        },
        "line": {
          "$value": "rgba(18, 18, 18, 0.15)",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of timer-toggle default (raw/components-computed.json)"
          },
          "$description": "The 1px hairline on toggles/cards."
        },
        "paper": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of plan-card default (raw/components-computed.json)"
          },
          "$description": "The white page/card field."
        },
        "cream": {
          "$value": "#f3f3e9",
          "$type": "color",
          "$extensions": {
            "source": "painted fill of feature-card (raw/components-computed.json)"
          },
          "$description": "The #f3f3e9 cream section/card fill."
        }
      },
      "brand": {
        "amber": {
          "$value": "#e8aa42",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The amber CTA border (the hero action)."
        },
        "amber-hover": {
          "$value": "#d89b3c",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of hero-cta hover (raw/components-computed.json)"
          },
          "$description": "Amber border on hover."
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of cta-demo default (raw/components-computed.json)"
        },
        "$description": "The 9999px pill on header buttons/CTAs."
      },
      "card": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of plan-card default (raw/components-computed.json)"
        },
        "$description": "The 24px card radius."
      },
      "media": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of timer-toggle default (raw/components-computed.json)"
        },
        "$description": "The 16px media/inner radius."
      }
    },
    "shadow": {
      "card": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.04)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of plan-card default (raw/components-computed.json)"
        },
        "$description": "A plan card's resting shadow."
      },
      "header": {
        "$value": [
          {
            "color": "#ffffff",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          },
          {
            "color": "rgba(18, 18, 18, 0.04)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px"
          },
          {
            "color": "rgba(0, 0, 0, 0)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of header default (raw/components-computed.json)"
        },
        "$description": "The floating header pill's shadow."
      }
    },
    "measured": {
      "focus-outline": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of nav-link focus-visible (raw/components-computed.json)"
        },
        "$description": "The keyboard-focus ring on nav/footer links."
      },
      "hover-dim": {
        "$value": "rgba(18, 18, 18, 0.05)",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of cta-demo hover (raw/components-computed.json)"
        },
        "$description": "The 5% ink hover fill on header buttons."
      },
      "toggle-border": {
        "$value": "rgba(18, 18, 18, 0.15)",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of timer-toggle default (raw/components-computed.json)"
        },
        "$description": "The toggle hairline."
      },
      "cta-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The CTA's 0.15s ease transition. (all)"
      },
      "nav-transition": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of nav-link default (raw/components-computed.json)"
        },
        "$description": "The nav's 0.2s ease transition. (color, background-color, border-color, text-decoration-color, fill, stroke)"
      }
    }
  },
  "light": {
    "text": {
      "primary": {
        "$value": "{color.neutral.ink}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Headline and button ink."
      },
      "secondary": {
        "$value": "{color.neutral.body}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Nav and body text."
      },
      "muted": {
        "$value": "{color.neutral.muted}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "Lede and meta text."
      }
    },
    "surface": {
      "page": {
        "$value": "{color.neutral.paper}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The white page field."
      },
      "card": {
        "$value": "{color.neutral.cream}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The cream section/card fill."
      }
    },
    "action": {
      "outline": {
        "$value": "{color.brand.amber}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The amber outlined-CTA border."
      }
    },
    "border": {
      "hairline": {
        "$value": "{color.neutral.line}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the measured core palette"
        },
        "$description": "The 1px toggle/card hairline."
      }
    },
    "component": {
      "control": {
        "height": {
          "$value": "30px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of cta-demo default (raw/components-computed.json)"
          },
          "$description": "The header CTA height."
        },
        "radius": {
          "$value": "9999px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of cta-demo default (raw/components-computed.json)"
          },
          "$description": "Header pill radius."
        }
      },
      "cta": {
        "height": {
          "$value": "56px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of hero-cta default (raw/components-computed.json)"
          },
          "$description": "The hero CTA height."
        }
      },
      "header": {
        "height": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of header default (raw/components-computed.json)"
          },
          "$description": "The floating header height."
        }
      },
      "field": {
        "radius": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopLeftRadius of timer-field default (raw/components-computed.json)"
          },
          "$description": "The script textarea radius."
        },
        "border": {
          "$value": "1px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed borderTopWidth of timer-toggle default (raw/components-computed.json)"
          },
          "$description": "Toggle border width."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme boords.com paints; no dark theme is offered on the captured surface."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
