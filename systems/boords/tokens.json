{
  "core": {
    "font": {
      "family": {
        "body": {
          "$value": "matter, ui-sans-serif, system-ui, -apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The single matter stack used everywhere."
        },
        "display": {
          "$value": "matter, ui-sans-serif, system-ui, -apple-system, \"system-ui\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json)"
          },
          "$description": "The matter stack at display size."
        }
      },
      "size": {
        "display": {
          "$value": "64px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The page/hero display size."
        },
        "cta": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-cta default (raw/components-computed.json)"
          },
          "$description": "Hero CTA size."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of timer-field default (raw/components-computed.json)"
          },
          "$description": "Field/body size."
        },
        "nav": {
          "$value": "14.4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of nav-link default (raw/components-computed.json)"
          },
          "$description": "Nav/footer label size."
        },
        "meta": {
          "$value": "10.4px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of footer-link default (raw/components-computed.json)"
          },
          "$description": "Small footer/meta size."
        },
        "price": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "Plan price size."
