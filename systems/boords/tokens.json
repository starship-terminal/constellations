        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of cta-demo default (raw/components-computed.json)"
        },
        "$description": "The 9999px pill on header buttons/CTAs."
      },
      "card": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of plan-card default (raw/components-computed.json)"
        },
        "$description": "The 24px card radius."
      },
      "media": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of timer-toggle default (raw/components-computed.json)"
        },
        "$description": "The 16px media/inner radius."
      }
    },
    "shadow": {
      "card": {
        "$value": [
          {
            "color": "rgba(0, 0, 0, 0.04)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of plan-card default (raw/components-computed.json)"
        },
        "$description": "A plan card's resting shadow."
      },
      "header": {
        "$value": [
          {
            "color": "#ffffff",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          },
          {
            "color": "rgba(18, 18, 18, 0.04)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "1px"
          },
          {
            "color": "rgba(0, 0, 0, 0)",
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "0px",
            "spread": "0px"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of header default (raw/components-computed.json)"
        },
        "$description": "The floating header pill's shadow."
      }
    },
    "measured": {
      "focus-outline": {
        "$value": "#005fcc",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of nav-link focus-visible (raw/components-computed.json)"
        },
        "$description": "The keyboard-focus ring on nav/footer links."
      },
      "hover-dim": {
        "$value": "rgba(18, 18, 18, 0.05)",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of cta-demo hover (raw/components-computed.json)"
        },
        "$description": "The 5% ink hover fill on header buttons."
      },
      "toggle-border": {
        "$value": "rgba(18, 18, 18, 0.15)",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of timer-toggle default (raw/components-computed.json)"
        },
        "$description": "The toggle hairline."
      },
      "cta-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of hero-cta default (raw/components-computed.json)"
        },
        "$description": "The CTA's 0.15s ease transition. (all)"
      },
      "nav-transition": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of nav-link default (raw/components-computed.json)"
        },
        "$description": "The nav's 0.2s ease transition. (color, background-color, border-color, text-decoration-color, fill, stroke)"
      }
    }
