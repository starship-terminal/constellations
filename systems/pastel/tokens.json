{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "Figtree, sans-serif",
          "$description": "Marketing body, headings, nav and buttons.",
          "$extensions": {"source": "Measured", "evidence": "getComputedStyle(body).fontFamily on https://usepastel.com/"}
        },
        "app": {
          "$type": "fontFamily",
          "$value": "Figtree, Helvetica, Arial, sans-serif",
          "$description": "Signed-out login and signup fields and headings.",
          "$extensions": {"source": "Measured", "evidence": "getComputedStyle on login h1 and email input"}
        },
        "mono": {
          "$type": "fontFamily",
          "$value": "Menlo, Monaco, monospace",
          "$description": "Declared on .code-box. Not sampled as a painted element on the pages opened.",
          "$extensions": {"source": "Measured", "evidence": "stylesheet .code-box font-family"}
        }
      }
    },
    "typography": {
      "body": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed body on https://usepastel.com/"}
      },
      "app-body": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.app}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed body on https://usepastel.com/login"}
      },
      "display": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "52.605px", "fontWeight": 400, "lineHeight": "57.8655px", "letterSpacing": "-0.8px"},
        "$extensions": {"source": "Measured", "evidence": "computed .main-h1 at 1169px on home and plans. Declared font-size is clamp(3em, 4.5vw, 5em), line-height 110%, letter-spacing -0.8px"}
      },
      "heading-2": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "45px", "fontWeight": 400, "lineHeight": "48.15px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .heading-2 on home. Declared line-height 107%"}
      },
      "heading-2-section": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "45px", "fontWeight": 400, "lineHeight": "56.25px", "letterSpacing": "-0.72px"},
        "$extensions": {"source": "Measured", "evidence": "computed .heading-2.section-heading on home"}
      },
      "heading-3": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "35px", "fontWeight": 400, "lineHeight": "35px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "stylesheet .heading-3 35px / line-height 100% / weight 400 / color #222"}
      },
      "quote": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "21px", "fontWeight": 400, "lineHeight": "27.93px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .quote-small-text.header on home. Declared line-height 133%"}
      },
      "plan-title": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "21px", "fontWeight": 600, "lineHeight": "21px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .plan-title.bold on /plans"}
      },
      "features-hero": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "36px", "fontWeight": 400, "lineHeight": "49.5px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .features-hero-heading on /features"}
      },
      "login-title": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.app}", "fontSize": "30px", "fontWeight": 500, "lineHeight": "36px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed h1 on https://usepastel.com/login"}
      },
      "nav": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "20px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .navbar-button"}
      },
      "button": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "16px", "fontWeight": 500, "lineHeight": "24px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .button Start a free trial"}
      },
      "button-pricing": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "18px", "fontWeight": 500, "lineHeight": "24px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .button.pricing on /plans"}
      },
      "announcement": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "15px", "fontWeight": 500, "lineHeight": "20px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "stylesheet .announcement-bar-text 15px / 500. Computed bar line-height was 20px"}
      },
      "name": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": "18px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "computed .quote-name.header"}
      },
      "footer-link": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "32px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured", "evidence": "stylesheet .footer-link"}
      }
    },
    "space": {
      "1": {"$type": "dimension", "$value": "6px", "$extensions": {"source": "Measured", "evidence": "announcement CTA margin-left 6px, declared"}},
      "2": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "Measured", "evidence": "FAQ accordion gap 8px, declared .faq-accordion-wrapper"}},
      "3": {"$type": "dimension", "$value": "10px", "$extensions": {"source": "Measured", "evidence": "announcement bar padding-block 10px"}},
      "4": {"$type": "dimension", "$value": "11px", "$extensions": {"source": "Measured", "evidence": "primary and outline button padding-block 11px"}},
      "5": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured", "evidence": "nav link padding-inline 12px; login field padding-block 12px"}},
      "6": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured", "evidence": "signup button padding-inline 16px; login field padding-inline 16px"}},
      "7": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured", "evidence": "announcement bar padding-inline 20px"}},
      "8": {"$type": "dimension", "$value": "22px", "$extensions": {"source": "Measured", "evidence": "primary button padding-inline 22px; login button padding-inline 22px"}},
      "9": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured", "evidence": "login card padding-inline 24px; navbar container padding-block 24px declared"}},
      "10": {"$type": "dimension", "$value": "30px", "$extensions": {"source": "Measured", "evidence": "computed .main-h1 margin-bottom 30px from the declared rule"}},
      "11": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured", "evidence": "login card parent padding-block 40px; plan column padding-bottom 40px"}}
    },
    "radius": {
      "nav": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured", "evidence": "computed .navbar-button border-radius 4px"}},
      "field": {"$type": "dimension", "$value": "6px", "$extensions": {"source": "Measured", "evidence": "computed login field wrapper border-radius 6px; features signup button 6px"}},
      "control": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "Measured", "evidence": "computed login submit border-radius 8px"}},
      "quote": {"$type": "dimension", "$value": "9px", "$extensions": {"source": "Measured", "evidence": "stylesheet .quote border-radius 9px"}},
      "button": {"$type": "dimension", "$value": "10px", "$extensions": {"source": "Measured", "evidence": "computed .button, login and signup nav buttons border-radius 10px"}},
      "card": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured", "evidence": "computed login card sm:rounded-xl 12px"}},
      "panel": {"$type": "dimension", "$value": "15px", "$extensions": {"source": "Measured", "evidence": "stylesheet .how-it-works.small and .pricing-comprison-card border-radius 15px"}},
      "switch": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured", "evidence": "computed .toggle-button border-radius 20px"}},
      "pill": {"$type": "dimension", "$value": "120px", "$extensions": {"source": "Measured", "evidence": "computed .section-heading-pill border-radius 120px"}},
      "knob": {"$type": "dimension", "$value": "100%", "$extensions": {"source": "Measured", "evidence": "computed .toggle-switch border-radius 100%"}}
    },
    "motion": {
      "duration": {
        "nav": {"$type": "duration", "$value": "120ms", "$extensions": {"source": "Measured", "evidence": "stylesheet .navbar-button transition background-color .12s, opacity .12s"}},
        "field": {"$type": "duration", "$value": "100ms", "$extensions": {"source": "Measured", "evidence": "computed login field wrapper transition-duration 0.1s"}},
        "primary": {"$type": "duration", "$value": "200ms", "$extensions": {"source": "Measured", "evidence": "stylesheet .button-primary transition all .2s. That class was not the painted marketing button"}}
      },
      "easing": {
        "standard": {"$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$extensions": {"source": "Measured", "evidence": "computed login field wrapper timing-function cubic-bezier(0.4, 0, 0.2, 1)"}}
      },
      "$extensions": {
        "reducedMotion": "not-emulated",
        "evidence": "matchMedia('(prefers-reduced-motion: reduce)') was false on /features. The preview tab cannot emulate the media query. No prefers-reduced-motion rule was extracted from the marketing sheet during the class pass."
      }
    }
  },
  "light": {
    "background": {
      "page": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured", "evidence": "computed body background rgb(255, 255, 255) on https://usepastel.com/"}},
      "app": {"$type": "color", "$value": "#f5f5f4", "$extensions": {"source": "Measured", "evidence": "computed body background rgb(245, 245, 244) on /login, class bg-gray-100; also .section-dark"}}
    },
    "surface": {
      "stone": {"$type": "color", "$value": "#f5f5f4", "$extensions": {"source": "Measured", "evidence": "computed .section-dark and .plan-container.grey"}},
      "pill": {"$type": "color", "$value": "#f4f4f4", "$extensions": {"source": "Measured", "evidence": "computed .section-heading-pill rgb(244, 244, 244)"}},
      "card": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured", "evidence": "computed login card rgb(255, 255, 255)"}},
      "plan-purple": {"$type": "color", "$value": "#e9e4ff", "$extensions": {"source": "Measured", "evidence": "computed .plan-container.purple rgb(233, 228, 255)"}},
      "sky": {"$type": "color", "$value": "#bae6fc", "$extensions": {"source": "Measured", "evidence": "computed .messages-section rgb(186, 230, 252)"}},
      "callout": {"$type": "color", "$value": "#dbeafe", "$extensions": {"source": "Measured", "evidence": "computed .features-callout-pill rgb(219, 234, 254)"}},
      "chip": {"$type": "color", "$value": "#e9e6e4", "$extensions": {"source": "Measured", "evidence": "stylesheet .card-pill background #e9e6e4"}},
      "code": {"$type": "color", "$value": "#222222", "$extensions": {"source": "Measured", "evidence": "stylesheet .code-box background #222"}}
    },
    "text": {
      "primary": {"$type": "color", "$value": "#111111", "$extensions": {"source": "Measured", "evidence": "computed body color rgb(17, 17, 17); stylesheet body color #111"}},
      "heading": {"$type": "color", "$value": "#222222", "$extensions": {"source": "Measured", "evidence": "computed .heading-2 rgb(34, 34, 34)"}},
      "stone": {"$type": "color", "$value": "#44403c", "$extensions": {"source": "Measured", "evidence": "computed login h1 rgb(68, 64, 60)"}},
      "ink": {"$type": "color", "$value": "#1c1917", "$extensions": {"source": "Measured", "evidence": "computed features h1 and field label rgb(28, 25, 23)"}},
      "muted": {"$type": "color", "$value": "#78716c", "$extensions": {"source": "Measured", "evidence": "computed login OR divider rgb(120, 113, 108)"}},
      "outline-label": {"$type": "color", "$value": "#45403c", "$extensions": {"source": "Measured", "evidence": "computed Watch demo color rgb(69, 64, 60); stylesheet .button.button-transparent color #45403c"}},
      "on-accent": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured", "evidence": "computed primary button and signup button color rgb(255, 255, 255)"}},
      "on-code": {"$type": "color", "$value": "#f5f5f4", "$extensions": {"source": "Measured", "evidence": "stylesheet .code-box color #f5f5f4"}}
    },
    "action": {
      "primary": {"$type": "color", "$value": "#165dfb", "$extensions": {"source": "Measured", "evidence": "computed announcement bar and Start a free trial rgb(22, 93, 251); stylesheet #165dfb"}},
      "signup": {"$type": "color", "$value": "#454745", "$extensions": {"source": "Measured", "evidence": "computed nav Sign up rgb(69, 71, 69)"}},
      "pricing": {"$type": "color", "$value": "#12b981", "$extensions": {"source": "Measured", "evidence": "computed .button.pricing rgb(18, 185, 129)"}},
      "app": {"$type": "color", "$value": "#4f77ff", "$extensions": {"source": "Measured", "evidence": "computed login and signup submit rgb(79, 119, 255)"}},
      "app-pressed": {"$type": "color", "$value": "#2e52cc", "$extensions": {"source": "Measured", "evidence": "computed .features-signup-button rgb(46, 82, 204)"}},
      "link": {"$type": "color", "$value": "#4f77ff", "$extensions": {"source": "Measured", "evidence": "computed login links rgb(79, 119, 255)"}},
      "callout-text": {"$type": "color", "$value": "#2563eb", "$extensions": {"source": "Measured", "evidence": "computed .features-callout-pill color rgb(37, 99, 235)"}}
    },
    "border": {
      "login": {"$type": "color", "$value": "#98989873", "$extensions": {"source": "Measured", "evidence": "computed login button border rgba(152, 152, 152, 0.45); stylesheet #98989873"}},
      "outline": {"$type": "color", "$value": "#d7d3d1", "$extensions": {"source": "Measured", "evidence": "computed Watch demo border rgb(215, 211, 209)"}},
      "plan": {"$type": "color", "$value": "#5050504d", "$extensions": {"source": "Measured", "evidence": "computed plan border rgba(80, 80, 80, 0.3); stylesheet #5050504d"}},
      "field": {"$type": "color", "$value": "#d6d3d1", "$extensions": {"source": "Measured", "evidence": "login field rest ring rgb(214, 211, 209)"}},
      "focus": {"$type": "color", "$value": "#335dec", "$extensions": {"source": "Measured", "evidence": "login email field focused ring rgb(51, 93, 236)"}},
      "quote": {"$type": "color", "$value": "#d1dee8", "$extensions": {"source": "Measured", "evidence": "stylesheet .quote border 1.1px solid #d1dee8"}}
    },
    "elevation": {
      "field": {"$type": "shadow", "$value": "0px 0px 0px 1px #d6d3d1, 0px 1px 3px 0px #0000001a, 0px 1px 2px 0px #0000000f", "$extensions": {"source": "Derived", "evidence": "computed login field rest box-shadow, white 0px ring dropped"}},
      "quote": {"$type": "shadow", "$value": "0px 11px 16.5px -3.3px #0000001a, 0px 4.4px 6.6px -4.4px #0000001a", "$extensions": {"source": "Measured", "evidence": "stylesheet .quote box-shadow"}}
    }
  },
  "$themes": [
    {"id": "light", "name": "Light", "selectedTokenSets": {"core": "enabled", "light": "enabled"}}
  ]
}
