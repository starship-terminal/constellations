{
  "_about": "The token tree build_tokens.py turns into tokens.json. A leaf with \"var\" takes its value from that flutterflow.io custom property in raw/css-vars.json (themed leaves resolve per light/dark pass); a leaf with \"value\" carries a measured value and names the measurement in \"source\". \"themed\" expands into both the light and dark sets; \"light\"/\"dark\" hold set-only extras.",
  "core": {
    "fontFamily": {
      "sans": {
        "var": "--ff-font-sans",
        "type": "fontFamily",
        "description": "Inter (variable, self-hosted via @font-face) then the system stack"
      },
      "mono": {
        "var": "--ff-font-mono",
        "type": "fontFamily",
        "description": "the ui-monospace stack used by the label/kbd roles"
      }
    },
    "fontWeight": {
      "regular": {
        "value": 400,
        "type": "fontWeight",
        "source": "declared in the --ff-text-* font shorthands (raw/css-vars.json)"
      },
      "medium": {
        "value": 500,
        "type": "fontWeight",
        "source": "declared --ff-text-label; measured raw/measurements.md#composer-key"
      },
      "semibold": {
        "value": 510,
        "type": "fontWeight",
        "source": "declared in most --ff-text-* shorthands and measured on every button (Inter variable wght 510): raw/measurements.md#plan-cta, #submit"
      },
      "bold": {
