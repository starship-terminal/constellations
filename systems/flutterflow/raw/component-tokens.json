      },
      "ui": {
        "var": "--ff-ease-ui",
        "type": "cubicBezier"
      },
      "spring": {
        "var": "--ff-ease-spring",
        "type": "spring",
        "description": "a linear() spring curve; not expressible as cubicBezier so the raw function is kept"
      }
    },
