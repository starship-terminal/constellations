        "$type": "color",
        "$value": "#1b1917",
        "$description": "Display and plan-name ink. Computed on h1.nineties_80 and the pricing plan names.",
        "$extensions": {"source": "Measured"}
      },
      "body": {
        "$type": "color",
        "$value": "#2c2936",
        "$description": "About-page paragraph. Computed on the vision paragraph under the h1.",
        "$extensions": {"source": "Measured"}
      },
      "muted": {
        "$type": "color",
        "$value": "#9894a8",
        "$description": "Nav links, ledes, footer links, FAQ answers. Computed on header a.font-md_16 and h2.font-md_20.",
        "$extensions": {"source": "Measured"}
      },
      "menu": {
        "$type": "color",
        "$value": "#666666",
        "$description": "Open Solutions menu item. Computed on the Travelers link.",
        "$extensions": {"source": "Measured"}
      },
      "placeholder": {
        "$type": "color",
        "$value": "#8f8f8f",
        "$description": "Hero prompt placeholder. Computed on the cycling placeholder span.",
        "$extensions": {"source": "Measured"}
      },
      "field": {
        "$type": "color",
        "$value": "#222222",
        "$description": "Hero prompt input text. Computed on the input.",
        "$extensions": {"source": "Measured"}
      },
      "secondary-label": {
        "$type": "color",
        "$value": "#8a8a8a",
        "$description": "Secondary button label. Computed on the Try it for free face.",
        "$extensions": {"source": "Measured"}
      },
      "login-muted": {
        "$type": "color",
        "$value": "#808080",
        "$description": "Login subtitle, legal line, and footer. Computed on /login.",
