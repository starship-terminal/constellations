        "$extensions": {"source": "Measured"}
      },
      "success": {
        "$type": "color",
        "$value": "#00a917",
        "$description": "Save 37% label. Computed colour on the pricing badge.",
        "$extensions": {"source": "Measured"}
      },
      "success-fill": {
        "$type": "color",
        "$value": "#e5ffe8",
        "$description": "Save badge fill. Computed background on the same h4.",
        "$extensions": {"source": "Measured"}
      },
      "switch-on": {
        "$type": "color",
        "$value": "#006e0b",
        "$description": "Yearly billing switch, on. Inline style on the track while Pay yearly is selected.",
        "$extensions": {"source": "Measured"}
      }
    },
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "nineties, \"nineties Fallback\", Arial, sans-serif",
