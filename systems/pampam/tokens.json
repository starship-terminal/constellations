          "$extensions": {"source": "Measured"}
        },
        "sans": {
          "$type": "fontFamily",
          "$value": "inter, \"inter Fallback\", sans-serif",
          "$description": "Variable Inter, weight 100-900, /_next/static/media/ff710c092db72df4-s.p.woff2. Fallback is local(Arial).",
          "$extensions": {"source": "Measured"}
        }
      },
      "weight": {
        "regular": {"$type": "fontWeight", "$value": "400", "$extensions": {"source": "Measured"}},
        "medium": {"$type": "fontWeight", "$value": "550", "$description": "Computed font-weight on Inter UI text (nav, ledes, buttons).", "$extensions": {"source": "Measured"}},
        "semibold": {"$type": "fontWeight", "$value": "600", "$description": "Pay monthly label and the Startup Maps card title.", "$extensions": {"source": "Measured"}},
        "bold": {"$type": "fontWeight", "$value": "700", "$description": "Login title and the $0 price.", "$extensions": {"source": "Measured"}}
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "80px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "86.4px"
        },
        "$description": "Home h1 at 1440. Class nineties_80. Phone computed size is 48px.",
        "$extensions": {"source": "Measured"}
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "48px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "51.84px"
        },
        "$description": "Section h2. Class nineties_44. Computed size 48px, not 44.",
        "$extensions": {"source": "Measured"}
      },
      "feature": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "28px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "30.24px"
        },
        "$description": "Feature names and FAQ questions. Class nineties_28.",
        "$extensions": {"source": "Measured"}
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "24px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "25.92px"
        },
        "$description": "As seen on the internet. Class nineties_28, computed 24px.",
        "$extensions": {"source": "Measured"}
      },
      "login-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "28px",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "36px",
          "letterSpacing": "-0.42px"
        },
        "$description": "Welcome to PamPam on /login. Class font-em_30, computed 28px.",
        "$extensions": {"source": "Measured"}
      },
      "price": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "32px",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "24px"
        },
        "$description": "$0, $5, $20, $82. Class fs_32.",
        "$extensions": {"source": "Measured"}
      },
      "lede": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "19px",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "28px"
        },
        "$description": "Home lede and plan buttons. Class font-md_20, computed 19px.",
        "$extensions": {"source": "Measured"}
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "19px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "28px"
        },
        "$description": "About paragraph. Inter 400, colour body.",
        "$extensions": {"source": "Measured"}
      },
      "ui": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "24px"
        },
        "$description": "Nav, prompt, footer links. Class font-md_16.",
        "$extensions": {"source": "Measured"}
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "20px"
        },
        "$description": "Type-card titles, billing labels, blog dates, Save badge.",
        "$extensions": {"source": "Measured"}
      },
      "legal": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "12px",
          "fontWeight": "{font.weight.medium}",
          "lineHeight": "28px"
        },
        "$description": "Login terms line.",
        "$extensions": {"source": "Measured"}
      }
    },
    "radius": {
      "menu": {"$type": "dimension", "$value": "6px", "$description": "Solutions menu panel.", "$extensions": {"source": "Measured"}},
      "control": {"$type": "dimension", "$value": "8px", "$description": "Make map button and type cards.", "$extensions": {"source": "Measured"}},
      "field": {"$type": "dimension", "$value": "12px", "$description": "Prompt field and plan buttons.", "$extensions": {"source": "Measured"}},
      "card": {"$type": "dimension", "$value": "16px", "$description": "Use-case cards and plan cards.", "$extensions": {"source": "Measured"}},
      "pill": {"$type": "dimension", "$value": "24px", "$description": "Billing switch track. Thumb radius is 18px.", "$extensions": {"source": "Measured"}}
    },
    "space": {
      "4": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured"}},
      "8": {"$type": "dimension", "$value": "8px", "$description": "Nav item padding block, menu padding, switch padding.", "$extensions": {"source": "Measured"}},
      "12": {"$type": "dimension", "$value": "12px", "$description": "Nav padding inline, type-card padding, nav gap.", "$extensions": {"source": "Measured"}},
      "16": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured"}},
      "20": {"$type": "dimension", "$value": "20px", "$description": "Plan button padding block and plan-card gap.", "$extensions": {"source": "Measured"}},
      "24": {"$type": "dimension", "$value": "24px", "$description": "Use-case and plan card padding. FAQ row padding.", "$extensions": {"source": "Measured"}},
      "32": {"$type": "dimension", "$value": "32px", "$description": "Plan button padding inline.", "$extensions": {"source": "Measured"}},
      "64": {"$type": "dimension", "$value": "64px", "$description": "Cream band padding block, and the plan button height.", "$extensions": {"source": "Measured"}}
    },
    "size": {
      "logo-width": {"$type": "dimension", "$value": "67px", "$extensions": {"source": "Measured"}},
      "logo-height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured"}},
      "nav-item": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured"}},
      "button-sm": {"$type": "dimension", "$value": "40px", "$description": "Make map button height.", "$extensions": {"source": "Measured"}},
      "google": {"$type": "dimension", "$value": "44px", "$description": "Google Identity button iframe height. Width 204px on the header.", "$extensions": {"source": "Measured"}},
      "field": {"$type": "dimension", "$value": "66px", "$description": "Hero prompt shell height.", "$extensions": {"source": "Measured"}},
      "button": {"$type": "dimension", "$value": "64px", "$description": "Plan and tutorial buttons.", "$extensions": {"source": "Measured"}},
      "header": {"$type": "dimension", "$value": "100px", "$description": "Fixed header box height at 1440.", "$extensions": {"source": "Measured"}},
      "switch-track-width": {"$type": "dimension", "$value": "56px", "$extensions": {"source": "Measured"}},
      "switch-track": {"$type": "dimension", "$value": "36px", "$extensions": {"source": "Measured"}},
      "switch-thumb": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured"}}
    },
    "shadow": {
      "prompt": {
        "$type": "shadow",
        "$value": "rgba(0, 0, 0, 0.05) 0px 1px 0px -1px, rgba(0, 0, 0, 0.05) 0px 1px 1px -1px, rgba(0, 0, 0, 0.05) 0px 1px 2px -1px, rgba(0, 0, 0, 0.05) 0px 2px 4px -2px, rgba(0, 0, 0, 0.05) 0px 3px 6px -3px",
        "$description": "Computed box-shadow on the hero prompt shell.",
        "$extensions": {"source": "Measured"}
      },
      "button-secondary": {
        "$type": "shadow",
        "$value": "rgba(0, 0, 0, 0.1) 0px 1px 3px 0px",
        "$description": "Computed box-shadow on Try it for free.",
        "$extensions": {"source": "Measured"}
      },
      "button-accent": {
        "$type": "shadow",
        "$value": "rgba(0, 0, 0, 0.3) 0px 1px 2px 0px, rgb(99, 135, 244) 0px 2px 0px 0px inset",
        "$description": "Computed box-shadow on Get Explorer. The inset lip is #6387f4.",
        "$extensions": {"source": "Measured"}
      },
      "menu": {
        "$type": "shadow",
        "$value": "rgba(14, 18, 22, 0.2) 0px 6px 20px -10px",
        "$description": "Computed box-shadow on the Solutions panel.",
        "$extensions": {"source": "Measured"}
      },
      "type-card": {
        "$type": "shadow",
        "$value": "rgba(0, 0, 0, 0.08) 0px 0px 0px 1px, rgba(0, 0, 0, 0.1) 0px 1px 4px 0px",
        "$description": "Computed box-shadow on the Interactive Map card.",
        "$extensions": {"source": "Measured"}
      },
      "switch": {
        "$type": "shadow",
        "$value": "rgba(0, 0, 0, 0.18) 0px 0px 2px 0px inset",
        "$description": "Inset shadow on the billing track.",
        "$extensions": {"source": "Measured"}
      }
    },
    "motion": {
      "duration": {
        "card": {"$type": "duration", "$value": "150ms", "$description": "Use-case card transition, declared 0.15s ease on transform, background and border-color.", "$extensions": {"source": "Measured"}}
      },
      "easing": {
        "ease": {"$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1], "$description": "CSS ease, the timing on the use-case card transition.", "$extensions": {"source": "Derived"}}
      },
      "$extensions": {
        "reducedMotion": "no authored prefers-reduced-motion rule in the page stylesheets",
        "panda": "Panda preset durations and easings are declared on :where(:root, :host) and were not seen on a painted control, so they are not tokens."
      }
    }
  },
  "light": {
    "color": {
      "page": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}},
      "surface": {"$type": "color", "$value": "#faf2ec", "$extensions": {"source": "Measured"}},
      "text": {"$type": "color", "$value": "#1b1917", "$extensions": {"source": "Measured"}},
      "muted": {"$type": "color", "$value": "#9894a8", "$extensions": {"source": "Measured"}},
      "accent": {"$type": "color", "$value": "#4b72f3", "$extensions": {"source": "Measured"}},
      "border": {"$type": "color", "$value": "#dde1f1", "$description": "2px border on the Business plan card.", "$extensions": {"source": "Measured"}},
      "on-accent": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}},
      "action": {"$type": "color", "$value": "#000000", "$description": "Make map face.", "$extensions": {"source": "Measured"}},
      "on-action": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}}
    },
    "component": {
      "button-primary": {
        "bg": {"$type": "color", "$value": "#000000", "$extensions": {"source": "Measured"}},
        "text": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.control}", "$extensions": {"source": "Measured"}},
        "height": {"$type": "dimension", "$value": "{size.button-sm}", "$extensions": {"source": "Measured"}},
        "padding": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured"}}
      },
      "button-accent": {
        "bg": {"$type": "color", "$value": "#4b72f3", "$extensions": {"source": "Measured"}},
        "text": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.field}", "$extensions": {"source": "Measured"}},
        "height": {"$type": "dimension", "$value": "{size.button}", "$extensions": {"source": "Measured"}}
      },
      "button-secondary": {
        "bg": {"$type": "color", "$value": "#fefefe", "$extensions": {"source": "Measured"}},
        "text": {"$type": "color", "$value": "#8a8a8a", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.field}", "$extensions": {"source": "Measured"}},
        "height": {"$type": "dimension", "$value": "{size.button}", "$extensions": {"source": "Measured"}}
      },
      "field": {
        "bg": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured"}},
        "text": {"$type": "color", "$value": "#222222", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.field}", "$extensions": {"source": "Measured"}},
        "height": {"$type": "dimension", "$value": "{size.field}", "$extensions": {"source": "Measured"}}
      },
      "nav-link": {
        "text": {"$type": "color", "$value": "#9894a8", "$extensions": {"source": "Measured"}},
        "height": {"$type": "dimension", "$value": "{size.nav-item}", "$extensions": {"source": "Measured"}}
      },
      "badge": {
        "bg": {"$type": "color", "$value": "#e5ffe8", "$extensions": {"source": "Measured"}},
        "text": {"$type": "color", "$value": "#00a917", "$extensions": {"source": "Measured"}}
      },
      "plan-card": {
        "bg": {"$type": "color", "$value": "#fbfcfd", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.card}", "$extensions": {"source": "Measured"}},
        "padding": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured"}}
      },
      "use-case-card": {
        "bg": {"$type": "color", "$value": "#faf2ec", "$extensions": {"source": "Measured"}},
        "radius": {"$type": "dimension", "$value": "{radius.card}", "$extensions": {"source": "Measured"}},
        "padding": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured"}}
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {"core": "source", "light": "enabled"}
    }
  ]
}
