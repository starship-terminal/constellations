      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$description": "Page, prompt field, menu panel, text on the black and accent buttons.",
        "$extensions": {"source": "Measured"}
      },
      "off-white": {
        "$type": "color",
        "$value": "#fefefe",
        "$description": "Secondary button face. Computed on the Try it for free div.",
        "$extensions": {"source": "Measured"}
      },
      "cream": {
        "$type": "color",
        "$value": "#faf2ec",
        "$description": "Use-case cards and the cream band. Computed background on those links.",
        "$extensions": {"source": "Measured"}
      },
      "plan": {
        "$type": "color",
        "$value": "#fbfcfd",
        "$description": "Pricing card face. Computed on the plan columns.",
        "$extensions": {"source": "Measured"}
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Make map button face, and body text where a class does not set a colour.",
        "$extensions": {"source": "Measured"}
      },
      "accent": {
        "$type": "color",
        "$value": "#4b72f3",
        "$description": "Get Explorer and Get Business face. Computed background.",
        "$extensions": {"source": "Measured"}
      },
      "accent-border": {
        "$type": "color",
        "$value": "#2b3ea7",
        "$description": "1px border on the accent button.",
        "$extensions": {"source": "Measured"}
      },
      "accent-lip": {
        "$type": "color",
        "$value": "#6387f4",
        "$description": "Inset top lip on the accent button shadow.",
        "$extensions": {"source": "Measured"}
      },
      "focus": {
        "$type": "color",
        "$value": "#ff9a50",
