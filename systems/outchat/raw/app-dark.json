{
  "app": {
    "background": {
      "$value": "#0a0a0a",
      "$type": "color",
      "$extensions": {
        "source": "Canvas-resolved .dark --background oklch(14.5% 0 0). Declared in the app stylesheet. The marketing site has no dark theme, and the login form was not rendered."
      }
    },
    "foreground": {
      "$value": "#fafafa",
      "$type": "color",
      "$extensions": {
        "source": "Canvas-resolved .dark --foreground oklch(98.5% 0 0)."
      }
    },
    "primary": {
