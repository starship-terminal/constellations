{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "family": {
        "display-bulky": {
          "$type": "fontFamily",
          "$value": "PolySans Bulky Wide, sans-serif",
          "$description": "Hero and page titles. Computed as PolySans Bulky Wide, then PolySans Bulky Wide Placeholder, then sans-serif. The replay reported the face status as error, so the family name is measured and the file did not load.",
          "$extensions": {"source": "Measured. raw/computed-home.json h1.fontFamily, Wayback 20240506015935."}
        },
        "display-slim": {
          "$type": "fontFamily",
          "$value": "PolySans Slim Wide, sans-serif",
          "$description": "Section titles and the blog post title.",
          "$extensions": {"source": "Measured. raw/computed-home.json h2.fontFamily."}
        },
        "display-neutral": {
          "$type": "fontFamily",
          "$value": "PolySans Neutral Wide, sans-serif",
          "$description": "Feature titles and the footer eyebrow.",
          "$extensions": {"source": "Measured. raw/computed-home.json h3.fontFamily."}
        },
        "text": {
          "$type": "fontFamily",
          "$value": "Inter, sans-serif",
          "$description": "Button labels, lede, body. Computed as Inter, then Inter Placeholder, then sans-serif.",
          "$extensions": {"source": "Measured. raw/computed-home.json buttons.primary.labelFont."}
        },
        "nav": {
          "$type": "fontFamily",
          "$value": "Inter Soft Medium, sans-serif",
          "$description": "Nav links and the funding chip. Face status on the replay was error.",
          "$extensions": {"source": "Measured. raw/computed-home.json nav.link.fontFamily."}
        },
        "wordmark": {
          "$type": "fontFamily",
          "$value": "Allotrope Variable Compressed Thin, sans-serif",
          "$description": "Giant footer wordmark. Computed family string was Allotrope Variable Compressed Thin Compressed Thin. Face status error.",
          "$extensions": {"source": "Measured. raw/computed-home.json footerWordmark.fontFamily."}
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display-bulky}",
          "fontSize": "64px",
          "fontWeight": 400,
          "lineHeight": "72px",
          "letterSpacing": "0px"
        },
        "$description": "Home h1 at 1440 CSS px. At 390 CSS px the same h1 computed to 40px / 48px.",
        "$extensions": {"source": "Measured. raw/computed-home.json h1, viewport innerWidth 1440."}
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display-slim}",
          "fontSize": "56px",
          "fontWeight": 400,
          "lineHeight": "64px",
          "letterSpacing": "0px"
        },
        "$description": "Home h2, text Save hours.",
        "$extensions": {"source": "Measured. raw/computed-home.json h2."}
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display-neutral}",
          "fontSize": "20px",
          "fontWeight": 400,
          "lineHeight": "24px",
          "letterSpacing": "0px"
        },
        "$description": "Feature h3s such as Text to Image and Video.",
        "$extensions": {"source": "Measured. raw/computed-home.json h3."}
      },
      "lede": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.text}",
          "fontSize": "18px",
          "fontWeight": 500,
          "lineHeight": "32px",
          "letterSpacing": "0px"
        },
        "$description": "Hero subcopy and the blog intro.",
        "$extensions": {"source": "Measured. raw/computed-home.json lede."}
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.text}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px",
          "letterSpacing": "0px"
        },
        "$description": "Section body and the blog date.",
        "$extensions": {"source": "Measured. raw/computed-home.json bodyMuted and raw/computed-blog.json date."}
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.text}",
          "fontSize": "14px",
          "fontWeight": 600,
          "lineHeight": "20px",
          "letterSpacing": "-0.14px"
        },
        "$description": "Primary, secondary and tertiary button labels.",
        "$extensions": {"source": "Measured. raw/computed-home.json buttons.primary label fields."}
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.nav}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "16.8px",
          "letterSpacing": "0px"
        },
        "$description": "Home, Blog, Careers, Login.",
        "$extensions": {"source": "Measured. raw/computed-home.json nav.link."}
      },
      "tag": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.text}",
          "fontSize": "12px",
          "fontWeight": 500,
          "lineHeight": "14px",
          "letterSpacing": "-0.12px"
        },
        "$description": "Prompt chips such as Robot sleeping in bed.",
        "$extensions": {"source": "Measured. raw/computed-home.json tag."}
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display-neutral}",
          "fontSize": "10px",
          "fontWeight": 400,
          "lineHeight": "12px",
          "letterSpacing": "4px"
        },
        "$description": "Footer column label USEFUL.",
        "$extensions": {"source": "Measured. raw/computed-home.json eyebrow."}
      }
    },
    "radius": {
      "chip": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Funding announcement chip.",
        "$extensions": {"source": "Measured. raw/computed-home.json chip.borderRadius."}
      },
      "panel": {
        "$type": "dimension",
        "$value": "8px",
        "$description": "Comment panel in the product demo.",
        "$extensions": {"source": "Measured. raw/computed-home.json surfaces.commentPanel.borderRadius."}
      },
      "card": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "Feature cards and the demo colour tiles.",
        "$extensions": {"source": "Measured. raw/computed-home.json surfaces.featureCard.borderRadius."}
      },
      "hero": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "Hero frame.",
        "$extensions": {"source": "Measured. raw/computed-home.json hero.borderRadius."}
      },
      "pill": {
        "$type": "dimension",
        "$value": "100px",
        "$description": "Buttons and prompt tags. Computed 100px, a pill.",
        "$extensions": {"source": "Measured. raw/computed-home.json buttons.primary.borderRadius."}
      },
      "band": {
        "$type": "dimension",
        "$value": "200px",
        "$description": "Closing blue band.",
        "$extensions": {"source": "Measured. raw/computed-home.json surfaces.closingBand.borderRadius."}
      }
    },
    "spacing": {
      "1": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured. Gap on Compose and Tag, and chip padding 4px 8px."}},
      "2": {"$type": "dimension", "$value": "6px", "$extensions": {"source": "Measured. Gap on Primary, Secondary and Tertiary."}},
      "3": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "Measured. Gap on Buttons and Text. Button vertical padding 8px."}},
      "4": {"$type": "dimension", "$value": "14px", "$extensions": {"source": "Measured. Primary horizontal padding 14px."}},
      "5": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured. Nav horizontal padding 16px. Gap on Text and Description."}},
      "6": {"$type": "dimension", "$value": "22px", "$extensions": {"source": "Measured. Secondary and tertiary horizontal padding 22px."}},
      "7": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured. Gap on Title and Useful."}},
      "8": {"$type": "dimension", "$value": "32px", "$extensions": {"source": "Measured. Gap on Nav and Content."}},
      "9": {"$type": "dimension", "$value": "64px", "$extensions": {"source": "Measured. Closing band padding 64px."}}
    },
    "shadow": {
      "control": {
        "$type": "shadow",
        "$value": {
          "color": "rgba(54, 92, 251, 0.08)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        "$description": "First layer of the button shadow. The computed value also has an inset highlight rgba(255, 255, 255, 0.4) 0px 0px 6px 0px.",
        "$extensions": {"source": "Measured. raw/computed-home.json buttons.primary.boxShadow. Inset layer recorded in the description because this token holds one shadow."}
      }
    }
  },
  "dark": {
    "page": {
      "$type": "color",
      "$value": "#000000",
      "$description": "Page fill. The marketing page is one dark theme. No light theme was on the page.",
      "$extensions": {"source": "Measured. getComputedStyle of #main > div backgroundColor rgb(0, 0, 0)."}
    },
    "surface": {
      "$type": "color",
      "$value": "#121314",
      "$description": "Comment panel in the hero demo.",
      "$extensions": {"source": "Measured. raw/computed-home.json surfaces.commentPanel.background."}
    },
    "surface-raised": {
      "$type": "color",
      "$value": "#17191b",
      "$description": "Compose strip at the bottom of the comment panel.",
      "$extensions": {"source": "Measured. raw/computed-home.json surfaces.compose.background."}
    },
    "surface-tabs": {
      "$type": "color",
      "$value": "#1c1d20",
      "$description": "All / Resolved tab bar in the demo.",
      "$extensions": {"source": "Measured. raw/computed-home.json surfaces.tabs.background."}
    },
    "text": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Headings, nav, button labels.",
      "$extensions": {"source": "Measured. h1 color rgb(255, 255, 255)."}
    },
    "text-muted": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.72)",
      "$description": "Section body and footer eyebrow.",
      "$extensions": {"source": "Measured. raw/computed-home.json bodyMuted.color."}
    },
    "accent": {
      "$type": "color",
      "$value": "#1f78ff",
      "$description": "Primary button and the closing band. rgb(31, 120, 255).",
      "$extensions": {"source": "Measured. raw/computed-home.json buttons.primary.background."}
    },
    "hero": {
      "$type": "color",
      "$value": "#4224ff",
      "$description": "Hero frame fill at 1440 CSS px. rgb(66, 36, 255). A 1280 read of the same node was rgb(6, 86, 226); that value is not the token.",
      "$extensions": {"source": "Measured. raw/computed-home.json hero.background at innerWidth 1440."}
    },
    "nav": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.48)",
      "$description": "Nav bar. backdrop-filter blur(10px) sat on the same node.",
      "$extensions": {"source": "Measured. raw/computed-home.json nav.background."}
    },
    "button-secondary": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.08)",
      "$description": "Watch Trailer.",
      "$extensions": {"source": "Measured. raw/computed-home.json buttons.secondary.background."}
    },
    "chip": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.32)",
      "$description": "Funding announcement chip.",
      "$extensions": {"source": "Measured. raw/computed-home.json chip.background."}
    },
    "tag": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.08)",
      "$description": "Prompt tags on the black feature cards.",
      "$extensions": {"source": "Measured. raw/computed-home.json tag.background."}
    },
    "border": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.08)",
      "$description": "No 1px stroke was measured on the nav, buttons or cards (border-top-width 0). This is the secondary button fill, the nearest hairline colour on the page, used so the catalog has a border swatch. It is not a measured border.",
      "$extensions": {"source": "Gap. No border colour was computed on the captured controls. Value copied from dark.button-secondary so the swatch is a colour that was on the page."}
    },
    "on-accent": {
      "$type": "color",
      "$value": "#ffffff",
      "$description": "Label on the primary button.",
      "$extensions": {"source": "Measured. Primary label color rgb(255, 255, 255). The anchor's own computed color was rgb(0, 0, 238), the browser default for an unstyled link, not the visible label."}
    },
    "wordmark": {
      "$type": "color",
      "$value": "#003180",
      "$description": "First sampled colour of the giant footer wordmark, rgb(0, 49, 128). Neighbouring repeats were rgb(0, 53, 138) and rgb(0, 57, 148).",
      "$extensions": {"source": "Measured. raw/computed-home.json footerWordmark.colorsSampled."}
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "Dark",
      "selectedTokenSets": {
        "core": "enabled",
        "dark": "source"
      }
    }
  ]
}
