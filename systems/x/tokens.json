{
  "core": {
    "font": {
      "family": {
        "chirp": {
          "$type": "fontFamily",
          "$value": "TwitterChirp, -apple-system, system-ui, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": "Computed font-family on https://x.com/ body, T3 preview, 2026-11-19. TwitterChirp is proprietary and is not shipped."
          }
        },
        "legal": {
          "$type": "fontFamily",
          "$value": "\"Helvetica Neue LT\", -apple-system, system-ui, sans-serif",
          "$extensions": {
            "source": "Computed font-family on the h1 at https://x.com/en/tos. Helvetica Neue LT is not shipped."
          }
        },
        "about": {
          "$type": "fontFamily",
          "$value": "xVF, \"xVF Fallback\", Arial, sans-serif",
          "$extensions": {
            "source": "Computed font-family on https://about.x.com/en body. xVF is self-hosted and is not shipped."
          }
        }
      }
    },
    "typography": {
      "login-display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "64px",
          "fontWeight": 600,
          "lineHeight": "57.6px",
          "letterSpacing": "-1px"
        },
        "$extensions": {
          "source": "h1 'Happening now.' on https://x.com/, computed at innerWidth 1169."
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "15px",
          "fontWeight": 400,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": "Computed font-size and line-height on the x.com body and the login 'or' divider."
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "15px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": "Painted 'Continue with phone' label on https://x.com/."
        }
      },
      "field": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "17px",
          "fontWeight": 400,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": "Email or username input on https://x.com/. Nothing was typed."
        }
      },
      "legal-copy": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "12px",
          "fontWeight": 500,
          "lineHeight": "18px"
        },
        "$extensions": {
          "source": "Terms of Service link under the login form."
        }
      },
      "footer": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "11px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "About / Get App / Help footer links on https://x.com/."
        }
      },
      "shell-heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "17px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": "h2 'Log in or sign up for X' on the missing-route shell."
        }
      },
      "shell-button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.chirp}",
          "fontSize": "13px",
          "fontWeight": 700,
          "lineHeight": "16.25px"
        },
        "$extensions": {
          "source": "Continue with phone pill on the missing-route shell."
        }
      },
      "legal-display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.legal}",
          "fontSize": "144px",
          "fontWeight": 700,
          "lineHeight": "144px",
          "letterSpacing": "-4px"
        },
        "$extensions": {
          "source": "h1 on https://x.com/en/tos at innerWidth 1440. At 390 the same element is 72px / 72px / -0.5px."
        }
      },
      "legal-section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.legal}",
          "fontSize": "36px",
          "fontWeight": 700,
          "lineHeight": "36px",
          "letterSpacing": "-0.5px"
        },
        "$extensions": {
          "source": "h2 'Summary of our Terms' on https://x.com/en/tos."
        }
      },
      "legal-body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.legal}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "Paragraphs on https://x.com/en/tos computed 15.96px, recorded as 16px. Column width 822px at 1440."
        }
      },
      "about-display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.about}",
          "fontSize": "48px",
          "fontWeight": 500,
          "lineHeight": "52px",
          "letterSpacing": "-0.48px"
        },
        "$extensions": {
          "source": "h1 'Happening now.' on https://about.x.com/en at innerWidth 1169."
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": "border-radius of the painted Continue with phone control on https://x.com/."
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "source": "border-radius of the Email or username label on https://x.com/."
        }
      },
      "google": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "border-radius of the Google Identity Services button. Third-party chrome."
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "22px",
        "$extensions": {
          "source": "Scan to get the app card computed 21.6px, recorded as 22px."
        }
      },
      "show-more": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "Show more link on the missing-route shell computed 14.4px, recorded as 14px."
        }
      },
      "legal-button": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Download PDF pill on https://x.com/en/tos."
        }
      }
    },
    "spacing": {
      "2": { "$type": "dimension", "$value": "8px", "$extensions": { "source": "Field padding on the login label." } },
      "3": { "$type": "dimension", "$value": "12px", "$extensions": { "source": "Phone pill horizontal padding, missing-route shell." } },
      "4": { "$type": "dimension", "$value": "16px", "$extensions": { "source": "QR card padding and the headline's padding-bottom." } },
      "5": { "$type": "dimension", "$value": "20px", "$extensions": { "source": "Missing-route Search label padding, 0 20px, and body line-height." } },
      "6": { "$type": "dimension", "$value": "24px", "$extensions": { "source": "Phone pill horizontal padding on the login page, 12px 24px." } },
      "8": { "$type": "dimension", "$value": "32px", "$extensions": { "source": "Login headline margin-bottom." } }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "#000000",
          "$extensions": { "source": "document.body backgroundColor on https://x.com/ and the missing-route shell. bg-primary resolves to rgb(0, 0, 0)." }
        },
        "modal": {
          "$type": "color",
          "$value": "#141414",
          "$extensions": { "source": "bg-modal class and the Scan to get the app card, rgb(20, 20, 20)." }
        },
        "continue": {
          "$type": "color",
          "$value": "#262626",
          "$extensions": { "source": "Empty Continue control background, rgb(38, 38, 38), on https://x.com/." }
        },
        "pill": {
          "$type": "color",
          "$value": "#f8fafc",
          "$extensions": { "source": "Painted Continue with phone and Continue with Apple fill, rgb(248, 250, 252)." }
        },
        "inverted": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": { "source": "bg-btn-primary on the missing-route shell, rgb(255, 255, 255)." }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": { "source": "text-primary and body color on the dark surfaces, rgb(255, 255, 255)." }
        },
        "muted": {
          "$type": "color",
          "$value": "#999999",
          "$extensions": { "source": "Footer links and text-secondary, rgb(153, 153, 153)." }
        },
        "disabled": {
          "$type": "color",
          "$value": "#78716c",
          "$extensions": { "source": "Empty Continue label, rgb(120, 113, 108)." }
        },
        "on-pill": {
          "$type": "color",
          "$value": "#000000",
          "$extensions": { "source": "Label color on the painted light pills, rgb(0, 0, 0)." }
        },
        "brand": {
          "$type": "color",
          "$value": "#1d9bf0",
          "$extensions": { "source": "--color-brand on the missing-route documentElement, and text-brand / Show more, rgb(29, 155, 240)." }
        },
        "focus": {
          "$type": "color",
          "$value": "#0ea5e9",
          "$extensions": { "source": "Login field border and floating label, rgb(14, 165, 233). Already painted on load." }
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "#ffffff26",
          "$extensions": { "source": "border-normal, rgba(255, 255, 255, 0.15)." }
        },
        "divider": {
          "$type": "color",
          "$value": "#3f3f46",
          "$extensions": { "source": "The 1px lines beside 'or' on the login form, rgb(63, 63, 70)." }
        },
        "apple": {
          "$type": "color",
          "$value": "#ffffff1a",
          "$extensions": { "source": "Sign In border on about.x.com, rgba(255, 255, 255, 0.1)." }
        }
      },
      "action": {
        "fill": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": { "source": "bg-btn-primary. The primary action on the dark shell is a white pill." }
        }
      },
      "shadow": {
        "popup": {
          "$type": "shadow",
          "$value": {
            "color": "#00000066",
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "20px",
            "spread": "0px"
          },
          "$extensions": { "source": "Scan to get the app card, rgba(0, 0, 0, 0.4) 0px 4px 20px 0px." }
        }
      }
    },
    "component": {
      "button-primary": {
        "bg": { "$type": "color", "$value": "{color.bg.pill}", "$extensions": { "source": "Painted Continue with phone fill." } },
        "text": { "$type": "color", "$value": "{color.text.on-pill}", "$extensions": { "source": "Painted Continue with phone label." } },
        "radius": { "$type": "dimension", "$value": "{radius.pill}", "$extensions": { "source": "Same control." } },
        "height": { "$type": "dimension", "$value": "46px", "$extensions": { "source": "Painted control height on https://x.com/." } },
        "padding": { "$type": "dimension", "$value": "12px", "$extensions": { "source": "Vertical padding 12px. Horizontal is 24px, recorded on core.spacing.6." } }
      },
      "button-continue": {
        "bg": { "$type": "color", "$value": "{color.bg.continue}", "$extensions": { "source": "Empty Continue control." } },
        "text": { "$type": "color", "$value": "{color.text.disabled}", "$extensions": { "source": "Empty Continue label." } },
        "radius": { "$type": "dimension", "$value": "{radius.pill}", "$extensions": { "source": "Empty Continue control." } },
        "height": { "$type": "dimension", "$value": "48px", "$extensions": { "source": "Empty Continue control height." } }
      },
      "field": {
        "bg": { "$type": "color", "$value": "{color.bg.page}", "$extensions": { "source": "Email or username label background." } },
        "text": { "$type": "color", "$value": "{color.text.focus}", "$extensions": { "source": "Floating label color. The input text itself is white." } },
        "radius": { "$type": "dimension", "$value": "{radius.field}", "$extensions": { "source": "Field border-radius." } },
        "height": { "$type": "dimension", "$value": "62px", "$extensions": { "source": "Field box height." } },
        "padding": { "$type": "dimension", "$value": "8px", "$extensions": { "source": "Field padding." } }
      },
      "card": {
        "bg": { "$type": "color", "$value": "{color.bg.modal}", "$extensions": { "source": "Scan to get the app card." } },
        "radius": { "$type": "dimension", "$value": "{radius.card}", "$extensions": { "source": "Same card." } },
        "padding": { "$type": "dimension", "$value": "16px", "$extensions": { "source": "Same card." } }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": { "source": "document.body backgroundColor on https://x.com/en/tos and https://x.com/en/privacy." }
        },
        "band": {
          "$type": "color",
          "$value": "#14171a",
          "$extensions": { "source": "Date band sampled from the 1440 terms screenshot, centre pixel rgb(20, 23, 26)." }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#14171a",
          "$extensions": { "source": "Headline and body color on the legal pages, rgb(20, 23, 26)." }
        },
        "body": {
          "$type": "color",
          "$value": "#0f1419",
          "$extensions": { "source": "document.body color on the legal pages, rgb(15, 20, 25)." }
        },
        "muted": {
          "$type": "color",
          "$value": "#314351",
          "$extensions": { "source": "Nav links and Download PDF, rgb(49, 67, 81)." }
        },
        "link": {
          "$type": "color",
          "$value": "#067acc",
          "$extensions": { "source": "Inline links on https://x.com/en/tos, rgb(6, 122, 204)." }
        }
      },
      "border": {
        "default": {
          "$type": "color",
          "$value": "#e8eff3",
          "$extensions": { "source": "Download PDF border, rgb(232, 239, 243)." }
        }
      },
      "action": {
        "fill": {
          "$type": "color",
          "$value": "#14171a",
          "$extensions": { "source": "The date band is the darkest filled region on the legal page. There is no filled primary button on that page." }
        }
      }
    },
    "component": {
      "button-download": {
        "text": { "$type": "color", "$value": "{color.text.muted}", "$extensions": { "source": "Download PDF label." } },
        "radius": { "$type": "dimension", "$value": "{radius.legal-button}", "$extensions": { "source": "Download PDF radius." } },
        "height": { "$type": "dimension", "$value": "48px", "$extensions": { "source": "Download PDF height." } },
        "padding": { "$type": "dimension", "$value": "16px", "$extensions": { "source": "Download PDF padding 16px 18px. Vertical recorded here." } }
      }
    }
  },
  "$themes": [
    { "id": "dark", "name": "Dark", "selectedTokenSets": { "core": "source", "dark": "enabled" } },
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
