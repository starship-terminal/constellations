{
  "$schema": "https://design-tokens.org/schemas/tokens.json",
  "core": {
    "fontFamily": {
      "sans": {
        "$value": "Not captured",
        "$type": "fontFamily",
        "$extensions": { "source": { "evidence": "Not captured", "from": "pixel capture cannot name the face; the painted text is a system sans" } }
      }
    },
    "size": {
      "window": { "$value": "1512px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "window bounds 1512 by 949 points, capture 3024 by 1898 at scale 2" } } },
      "sidebar": { "$value": "242px", "$type": "dimension", "$extensions": { "source": { "evidence": "Derived", "from": "sidebar edge at image x 483, divided by scale 2" } } }
    }
  },
  "dark": {
    "color": {
      "page": { "$value": "#191b26", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "thread column mode, 88% of an 600 by 500 region, dark-shell.png" } } },
      "surface": { "$value": "#191923", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "settings content, 100% of a 200 by 24 region, dark-settings-general.png" } } },
      "text": { "$value": "#dadbdf", "$type": "color", "$extensions": { "source": { "evidence": "Sampled (text)", "from": "brightest sidebar title pixel (218,219,223), dark-shell.png" } } },
      "muted": { "$value": "#9a9a9e", "$type": "color", "$extensions": { "source": { "evidence": "Sampled (text)", "from": "composer placeholder mode (154,154,158), dark-shell.png" } } },
      "accent": { "$value": "#395291", "$type": "color", "$extensions": { "source": { "evidence": "Sampled (text)", "from": "switch cluster (57,82,145) on the Environments row; the switch is not a flat fill" } } },
      "border": { "$value": "#2b2c37", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "1px sidebar edge at image x 483, y 400, dark-shell.png" } } },
      "composer": { "$value": "#171721", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "composer mode, 88% of the composer region, dark-shell.png" } } }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "#e6e7ee", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "thread column mode, 88%, light-shell.png" } } },
      "surface": { "$value": "#e0e1e8", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "settings card region, 85%, light-settings-environments.png" } } },
      "text": { "$value": "#2c324d", "$type": "color", "$extensions": { "source": { "evidence": "Sampled (text)", "from": "darkest heading pixel (44,50,77), light-settings-environments.png" } } },
      "muted": { "$value": "#5c5e6b", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "a mid grey in the light settings nav; not a held text specimen" } } },
      "accent": { "$value": "#436cb3", "$type": "color", "$extensions": { "source": { "evidence": "Sampled (text)", "from": "switch cluster (67,108,179), light-settings-environments.png" } } },
      "border": { "$value": "#d7d8e0", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "settings nav mode, light-settings-environments.png" } } },
      "composer": { "$value": "#dadbe3", "$type": "color", "$extensions": { "source": { "evidence": "Sampled", "from": "composer mode, 88% of the composer region, light-shell.png" } } }
    }
  },
  "$themes": [
    { "name": "dark", "selectedTokenSets": { "core": "enabled", "dark": "enabled" } },
    { "name": "light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
