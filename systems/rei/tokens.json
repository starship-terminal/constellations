{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "body color rgb(0, 0, 0) on https://www.rei.com/" } }
      },
      "charcoal": {
        "$value": "#292929",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "header .unav background rgb(41, 41, 41)" } }
      },
      "stone": {
        "$value": "#4b4a48",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "category link and price color rgb(75, 74, 72)" } }
      },
      "ink-soft": {
        "$value": "#2e2e2b",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "search field color rgb(46, 46, 43)" } }
      },
      "paper": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "body background rgb(255, 255, 255)" } }
      },
      "cream": {
        "$value": "#f4f2ed",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "header .gnav background rgb(244, 242, 237); stylesheet --cdr-color-background-primary" } }
      },
      "sand": {
        "$value": "#958e83",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "search inset ring rgb(149, 142, 131); stylesheet --cdr-color-border-primary" } }
      },
      "promo": {
        "$value": "#c7370f",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "promo bar and Shop the sale button rgb(199, 55, 15)" } }
      },
      "on-dark": {
        "$value": "#fafafa",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "utility link color rgb(250, 250, 250)" } }
      },
      "on-promo": {
        "$value": "#fafbf9",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "promo bar color rgb(250, 251, 249)" } }
      },
      "link": {
        "$value": "#406eb5",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "from": "product title link color rgb(64, 110, 181)" } }
      }
    },
    "font": {
      "sans": {
        "$value": "Graphik, \"Graphik fallback\", \"Helvetica Neue\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": { "label": "Exact", "from": "body font-family" } }
      },
      "serif": {
        "$value": "Stuart, \"Stuart fallback\", Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": { "label": "Exact", "from": "Shop word and section titles" } }
      }
    },
    "radius": {
      "control": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": { "source": { "label": "Exact", "from": "search, Shop the sale, footer email" } }
      }
    },
    "space": {
      "utility-bar": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": { "label": "Exact", "from": "header .unav height" } }
      },
      "main-bar": {
        "$value": "128px",
        "$type": "dimension",
        "$extensions": { "source": { "label": "Exact", "from": "header .gnav height" } }
      },
      "search": {
        "$value": "46px",
        "$type": "dimension",
        "$extensions": { "source": { "label": "Exact", "from": "search input height" } }
      },
      "button": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": { "source": { "label": "Exact", "from": "Shop the sale height" } }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "16px", "fontWeight": "400", "lineHeight": "24px", "letterSpacing": "-0.16px" },
        "$type": "typography",
        "$extensions": { "source": { "label": "Exact", "from": "body" } }
      },
      "utility": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": "400", "lineHeight": "20px" },
        "$type": "typography",
        "$extensions": { "source": { "label": "Exact", "from": "Shop REI utility link" } }
      },
      "word": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "24px", "fontWeight": "600", "lineHeight": "30px" },
        "$type": "typography",
        "$extensions": { "source": { "label": "Exact", "from": "Shop word beside the mark" } }
      },
      "section": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "32px", "fontWeight": "500", "lineHeight": "40px" },
        "$type": "typography",
        "$extensions": { "source": { "label": "Exact", "from": "Deals on top brands" } }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "16px", "fontWeight": "500", "lineHeight": "22px" },
        "$type": "typography",
        "$extensions": { "source": { "label": "Exact", "from": "Shop the sale" } }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.paper}", "$type": "color" },
      "surface": { "$value": "{core.color.cream}", "$type": "color" },
      "header": { "$value": "{core.color.charcoal}", "$type": "color" },
      "text": { "$value": "{core.color.ink}", "$type": "color" },
      "muted": { "$value": "{core.color.stone}", "$type": "color" },
      "accent": { "$value": "{core.color.promo}", "$type": "color" },
      "on-accent": { "$value": "{core.color.paper}", "$type": "color" },
      "border": { "$value": "{core.color.sand}", "$type": "color" },
      "link": { "$value": "{core.color.link}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
