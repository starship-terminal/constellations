{
  "$schema": "https://design-tokens.org/schemas/latest/tokens.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "\"Fira Sans\", sans-serif",
          "$extensions": {
            "source": "Measured. h1.section__title__title computed font-family on https://www.vectary.com/ at preview innerWidth 1169, 2026-11-19. Fira Sans loaded as a document font. The file is not committed."
          }
        },
        "body": {
          "$type": "fontFamily",
          "$value": "Inter, sans-serif",
          "$extensions": {
            "source": "Measured. body.vctr-app computed font-family on the same page. Inter weights 400, 500, 600 and 700 were loaded."
          }
        },
        "app": {
          "$type": "fontFamily",
          "$value": "Inter, system-ui, sans-serif",
          "$extensions": {
            "source": "Measured. --font-sans and document.body on https://www.vectary.com/login-email/?next=/dashboard/&useEmail=1."
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "60px",
          "fontWeight": 300,
          "lineHeight": "60px",
          "letterSpacing": "-2px"
        },
        "$extensions": {
          "source": "Measured. h1.section__title__title on https://www.vectary.com/ and on https://www.vectary.com/pricing/."
        }
      },
      "section": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "36px",
          "fontWeight": 300,
          "lineHeight": "45px",
          "letterSpacing": "-0.96px"
        },
        "$extensions": {
          "source": "Measured. h2.vctr-h2 on https://www.vectary.com/."
        }
      },
      "price": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "36px",
          "fontWeight": 600,
          "lineHeight": "40px",
          "letterSpacing": "-0.1px"
        },
        "$extensions": {
          "source": "Measured. .pricing__item__price on https://www.vectary.com/pricing/."
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.app}",
          "fontSize": "24px",
          "fontWeight": 600,
          "lineHeight": "32px",
          "letterSpacing": "-0.6px"
        },
        "$extensions": {
          "source": "Measured. h1.signupin-title on the email login page."
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": 300,
          "lineHeight": "24px",
          "letterSpacing": "-0.54px"
        },
        "$extensions": {
          "source": "Measured. .section__subtitle on https://www.vectary.com/."
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "27px",
          "letterSpacing": "-0.54px"
        },
        "$extensions": {
          "source": "Measured. .navbar__link__dropdown-toggle on https://www.vectary.com/."
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "21px",
          "letterSpacing": "-0.42px"
        },
        "$extensions": {
          "source": "Measured. a.btn--primary on https://www.vectary.com/."
        }
      },
      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "14px",
          "fontWeight": 700,
          "lineHeight": "21px",
          "letterSpacing": "-0.54px"
        },
        "$extensions": {
          "source": "Measured. .section__category on https://www.vectary.com/."
        }
      },
      "banner": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "12px",
          "fontWeight": 400,
          "lineHeight": "27px",
          "letterSpacing": "-0.54px"
        },
        "$extensions": {
          "source": "Measured. .text-block-36 inside the yellow announcement bar. Line height is the inherited 27px."
        }
      }
    },
    "radius": {
      "button": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured. a.btn--primary border-radius. Also --radius on the login page."
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "Measured. input[name=email] and the login submit button border-radius."
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "Measured. .pricing__item border-radius on https://www.vectary.com/pricing/."
        }
      },
      "page": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured. body border-radius 16px 16px 0px 0px on the home page."
        }
      },
      "checkbox": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Measured. input.signupin-checkbox on the signup form, which was not submitted."
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": "Measured. .section__category-pill and .pricing__offer-pill border-radius."
        }
      }
    },
    "spacing": {
      "button-x": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured. a.btn--primary padding-inline."
        }
      },
      "button-y": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "source": "Measured. a.btn--primary padding-block."
        }
      },
      "outline-x": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "Measured. a.btn--outline padding-inline."
        }
      },
      "card": {
        "$type": "dimension",
        "$value": "24px",
        "$extensions": {
          "source": "Measured. .pricing__item and .signupin-card padding."
        }
      },
      "nav-x": {
        "$type": "dimension",
        "$value": "30px",
        "$extensions": {
          "source": "Measured. nav.navbar__container padding-inline and the nav link padding-block."
        }
      },
      "footer-y": {
        "$type": "dimension",
        "$value": "60px",
        "$extensions": {
          "source": "Measured. .vctr-footer padding-block."
        }
      },
      "actions": {
        "$type": "dimension",
        "$value": "15px",
        "$extensions": {
          "source": "Measured. .section__title__actions gap."
        }
      },
      "field-x": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "Measured. input[name=email] padding-inline."
        }
      }
    },
    "motion": {
      "duration": {
        "link": {
          "$type": "duration",
          "$value": "200ms",
          "$extensions": {
            "source": "Measured. .vctr-footer__link transition color 0.2s, declared in the marketing stylesheet."
          }
        },
        "button": {
          "$type": "duration",
          "$value": "500ms",
          "$extensions": {
            "source": "Measured. .btn--outline.btn--outline--black--stroke transition includes opacity 0.5s."
          }
        },
        "faq": {
          "$type": "duration",
          "$value": "350ms",
          "$extensions": {
            "source": "Measured. .faq-link transition color 0.35s."
          }
        }
      },
      "easing": {
        "ease": {
          "$type": "cubicBezier",
          "$value": [0.215, 0.61, 0.355, 1],
          "$extensions": {
            "source": "Measured. .faq-link transition-timing cubic-bezier(0.215, 0.61, 0.355, 1)."
          }
        },
        "standard": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1],
          "$extensions": {
            "source": "Measured. .animate-top-menu-chrome-fade-in on the login stylesheet, 0.5s."
          }
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "#f0f0f0",
        "$extensions": {
          "source": "Measured. body.vctr-app background-color rgb(240, 240, 240) on https://www.vectary.com/."
        }
      },
      "pricing": {
        "$type": "color",
        "$value": "#fcfcfc",
        "$extensions": {
          "source": "Measured. body background-color rgb(252, 252, 252) on https://www.vectary.com/pricing/. Matches --almost-white-2."
        }
      },
      "login": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Measured. body.signupin-route background-color rgb(255, 255, 255)."
        }
      },
      "surface": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Measured. a.btn--outline and .signupin-card background-color rgb(255, 255, 255)."
        }
      },
      "action": {
        "$type": "color",
        "$value": "#222222",
        "$extensions": {
          "source": "Measured. a.btn--primary background-color rgb(34, 34, 34). Matches --blue."
        }
      },
      "login-button": {
        "$type": "color",
        "$value": "#313131",
        "$extensions": {
          "source": "Measured. the Login link background-color rgb(49, 49, 49). Matches --black."
        }
      },
      "field": {
        "$type": "color",
        "$value": "#f1f1f1",
        "$extensions": {
          "source": "Measured. input[name=email] background-color rgb(241, 241, 241). Matches --color-grey-1."
        }
      },
      "footer": {
        "$type": "color",
        "$value": "#0b0b0b",
        "$extensions": {
          "source": "Measured. .vctr-footer background-color rgb(11, 11, 11). Matches --black-3."
        }
      },
      "banner": {
        "$type": "color",
        "$value": "#fbd302",
        "$extensions": {
          "source": "Measured. .div-block-74 background-color rgb(251, 211, 2) on https://www.vectary.com/. Same fill on .pricing__offer-pill and .section__category-pill."
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#6100ff",
        "$extensions": {
          "source": "Measured. --color-main on the login page. Not used as a fill on the buttons that were measured."
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#252525",
        "$extensions": {
          "source": "Measured. body and h1 color rgb(37, 37, 37). Matches --almost-black."
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#595959",
        "$extensions": {
          "source": "Measured. .section__subtitle color rgb(89, 89, 89). Matches --dim-grey."
        }
      },
      "on-action": {
        "$type": "color",
        "$value": "#f7f7f7",
        "$extensions": {
          "source": "Measured. a.btn--primary color rgb(247, 247, 247). Matches --white-smoke."
        }
      },
      "footer": {
        "$type": "color",
        "$value": "#949494",
        "$extensions": {
          "source": "Measured. .vctr-footer color rgb(148, 148, 148). Matches --dark-grey."
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#737373",
        "$extensions": {
          "source": "Derived. oklch(0.556 0 0) computed on .signupin-subtitle, drawn to a canvas and read as #737373."
        }
      }
    },
    "border": {
      "stroke": {
        "$type": "color",
        "$value": "#949494",
        "$extensions": {
          "source": "Measured. a.btn--outline border-color rgb(148, 148, 148)."
        }
      },
      "card": {
        "$type": "color",
        "$value": "#d0d0d0",
        "$extensions": {
          "source": "Measured. .pricing__item border-color rgb(208, 208, 208). Matches --light-grey."
        }
      },
      "checkbox": {
        "$type": "color",
        "$value": "#a4a4a4",
        "$extensions": {
          "source": "Measured. input.signupin-checkbox border-color rgb(164, 164, 164). Matches --color-grey-2."
        }
      }
    },
    "focus": {
      "ring": {
        "$type": "color",
        "$value": "#a1a1a1",
        "$extensions": {
          "source": "Derived. --ring oklch(0.708 0 0) on the login page, drawn to a canvas and read as #a1a1a1. Focus-visible uses a 2px ring at 50% of that colour."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
