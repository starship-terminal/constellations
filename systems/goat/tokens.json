{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed interior body color rgb(0, 0, 0) on https://www.goat.com/sneakers 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed interior body background rgb(255, 255, 255). Sampled from category-light-1440.png" }
      },
      "home": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed homepage body background rgb(0, 0, 0). Sampled from home-light-1440.png" }
      },
      "on-home": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed homepage body and header color rgb(255, 255, 255)" }
      },
      "hairline": {
        "$value": "#515151",
        "$type": "color",
        "$extensions": { "source": "sampled header hairline rgb(81, 81, 81) on category-light-1440.png. Computed border is 1px solid rgba(0, 0, 0, 0.7)" }
      },
      "hairline-home": {
        "$value": "#aeaeae",
        "$type": "color",
        "$extensions": { "source": "sampled homepage header hairline rgb(174, 174, 174). Computed border is 1px solid rgba(255, 255, 255, 0.7)" }
      },
      "field-border": {
        "$value": "#bfbfbf",
        "$type": "color",
        "$extensions": { "source": "computed email wrapper border 1px solid rgba(0, 0, 0, 0.25), which paints near rgb(191, 191, 191) on white" }
      },
      "signup": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed Sign Up background rgb(0, 0, 0) on the interior footer. Not clicked" }
      },
      "on-signup": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Sign Up label rgb(255, 255, 255)" }
      }
    },
    "font": {
      "ui": {
        "$value": "GOATProductVariableVF, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body and nav fontFamily. File is not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11.5px", "fontWeight": 400, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the homepage and on Sneakers" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11.5px", "fontWeight": 300, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed desktop nav link, padding 12px 8px" }
      },
      "menu-heading": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "9.5px", "fontWeight": 400, "lineHeight": "14.25px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed shop menu h4 Categories" }
      },
      "category": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11.5px", "fontWeight": 700, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Sneakers h1, uppercase" }
      },
      "product": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11.5px", "fontWeight": 300, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1" }
      },
      "about": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11.5px", "fontWeight": 600, "lineHeight": "16px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed About Us h1, uppercase" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12px", "fontWeight": 300, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed size price on the product page" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "12.5px", "fontWeight": 300, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer column label About" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11px", "fontWeight": 300, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Sign Up. Not clicked" }
      }
    },
    "size": {
      "header": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": { "source": "computed header height. Inner padding 12px 32px 0px" }
      },
      "nav": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": { "source": "computed nav link height, padding 12px 8px" }
      },
      "menu": {
        "$value": "564px",
        "$type": "dimension",
        "$extensions": { "source": "computed shop menu width. Height 311px, padding 20px 24px" }
      },
      "signup": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": "computed Sign Up height. Width 77px, padding 7px 18px" }
      },
      "field": {
        "$value": "49px",
        "$type": "dimension",
        "$extensions": { "source": "computed email wrapper height. Width 358px" }
      }
    },
    "radius": {
      "control": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": { "source": "computed Sign Up and email wrapper border-radius" }
      }
    }
  }
}
