{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "body": {
        "$value": "CircularXX, ui-sans-serif, system-ui, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "computed font-family of body on https://ritual.com/"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$value": "66px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the homepage h1 at 1440"
        }
      },
      "body": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of body"
        }
      },
      "nav": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed font-size of the Our Standards link"
        }
      }
    },
    "radius": {
      "xs": {
        "$value": "0.125rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --radius-xs on https://ritual.com/"
        }
      },
      "xl": {
        "$value": "0.75rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --radius-xl"
        }
      },
      "2xl": {
        "$value": "1rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --radius-2xl"
        }
      },
      "3xl": {
        "$value": "1.5rem",
        "$type": "dimension",
        "$extensions": {
          "source": "declared --radius-3xl"
        }
      }
    },
    "typography": {
      "hero": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.hero}",
          "fontWeight": "450",
          "lineHeight": "72.6px",
          "letterSpacing": "-1.32px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of the homepage h1 on https://ritual.com/"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.body}",
          "fontSize": "{fontSize.body}",
          "fontWeight": "400",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style of body"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-background, resolved on :root"
        }
      },
      "page-secondary": {
        "$value": "#fef6eb",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-background-secondary"
        }
      },
      "text": {
        "$value": "#142b6f",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-foreground. Computed body color rgb(20, 43, 111)"
        }
      },
      "text-secondary": {
        "$value": "#717171",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-foreground-secondary"
        }
      },
      "accent": {
        "$value": "#ab4824",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-accent-01"
        }
      },
      "border": {
        "$value": "#b3b2b1",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-border-01"
        }
      },
      "link": {
        "$value": "#142b6f",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-link"
        }
      },
      "button": {
        "$value": "#142b6f",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-bg"
        }
      },
      "button-text": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-color"
        }
      },
      "button-hover": {
        "$value": "#ffd600",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-hover-bg. Hover was not photographed"
        }
      },
      "button-focus": {
        "$value": "#a1aac5",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-focus-color. Focus was not photographed"
        }
      },
      "button-disabled": {
        "$value": "#eaeef0",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-disabled-bg"
        }
      },
      "button-disabled-text": {
        "$value": "#a1aac5",
        "$type": "color",
        "$extensions": {
          "source": "declared --button-primary-disabled-color"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
