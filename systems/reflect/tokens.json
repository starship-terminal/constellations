{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "AeonikPro, system-ui, -apple-system, system-ui, Segoe UI, Roboto, sans-serif",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "h1 computed font-family on https://reflect.app/ at 1440",
              "file": "raw/controls.json"
            }
          }
        },
        "ui": {
          "$type": "fontFamily",
          "$value": "Inter V, system-ui, -apple-system, system-ui, Segoe UI, Roboto, sans-serif",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "body and nav computed font-family",
              "file": "raw/home-measured.json"
            }
          }
        },
        "auth": {
          "$type": "fontFamily",
          "$value": "Inter, ui-sans-serif, system-ui, sans-serif",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "email field on https://reflect.app/auth",
              "file": "raw/auth-wall.json"
            }
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "AeonikPro",
          "fontSize": "72px",
          "fontWeight": 500,
          "lineHeight": "80px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "h1 Think better with Reflect at 1440x900",
            "file": "raw/controls.json"
          }
        }
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "AeonikPro",
          "fontSize": "56px",
          "fontWeight": 500,
          "lineHeight": "64px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "h2 on the homepage",
            "file": "raw/home-measured.json"
          }
        }
      },
      "blog-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "48px",
          "fontWeight": 700,
          "lineHeight": "48px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "h1 Reflect Blog",
            "file": "raw/blog-controls.json"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter V",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "hero subcopy",
            "file": "raw/controls.json"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter V",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "nav link Product",
            "file": "raw/controls.json"
          }
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter V",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "Download for Mac",
            "file": "raw/controls.json"
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "Download button and auth email field",
            "file": "raw/controls.json"
          }
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "Meet Reflect Open pill",
            "file": "raw/controls.json"
          }
        }
      },
      "tag": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "blog All Tags chip",
            "file": "raw/blog-controls.json"
          }
        }
      }
    },
    "space": {
      "button-x": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "button padding 8px 16px",
            "file": "raw/controls.json"
          }
        }
      },
      "button-y": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "button padding 8px 16px",
            "file": "raw/controls.json"
          }
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "36px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "Download for Mac height",
            "file": "raw/controls.json"
          }
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "50px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "auth email field height",
            "file": "raw/auth-wall.json"
          }
        }
      },
      "continue": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": "auth Continue button height",
            "file": "raw/auth-buttons.json"
          }
        }
      }
    },
    "motion": {
      "button": {
        "$type": "other",
        "$value": "opacity 0.2s cubic-bezier(0.6, 0.6, 0, 1)",
        "$extensions": {
          "source": {
            "label": "Measured",
            "where": ".button::before and ::after transition",
            "file": "raw/button-rules.json"
          }
        }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "#030014",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "body background-color rgb(3, 0, 20)",
              "file": "raw/home-measured.json"
            }
          }
        },
        "menu": {
          "$type": "color",
          "$value": "#030014e6",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "mobile .header-nav background rgba(3, 0, 20, 0.9)",
              "file": "raw/mobile-menu.json"
            }
          }
        },
        "field": {
          "$type": "color",
          "$value": "#0f172a80",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "auth email field rgba(15, 23, 42, 0.5)",
              "file": "raw/auth-wall.json"
            }
          }
        },
        "legal": {
          "$type": "color",
          "$value": "#f9fafb",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "privacy page body, a light document surface",
              "file": "raw/auth-buttons.json"
            }
          }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "#ffffff",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "h1 color",
              "file": "raw/controls.json"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "#efedfd99",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "hero subcopy rgba(239, 237, 253, 0.6)",
              "file": "raw/controls.json"
            }
          }
        },
        "nav": {
          "$type": "color",
          "$value": "#ffffffe6",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "nav link rgba(255, 255, 255, 0.9)",
              "file": "raw/controls.json"
            }
          }
        },
        "on-button": {
          "$type": "color",
          "$value": "#f4f0ff",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": ".button color rgb(244, 240, 255)",
              "file": "raw/button-rules.json"
            }
          }
        },
        "legal": {
          "$type": "color",
          "$value": "#020817",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "privacy and auth document ink rgb(2, 8, 23)",
              "file": "raw/auth-buttons.json"
            }
          }
        }
      },
      "action": {
        "primary-wash": {
          "$type": "color",
          "$value": "#712fff1f",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": ".button-primary::before rgba(113, 47, 255, 0.12)",
              "file": "raw/button-rules.json"
            }
          }
        },
        "primary-hover": {
          "$type": "color",
          "$value": "#712fff3d",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": ".button-primary::after rgba(113, 47, 255, 0.24)",
              "file": "raw/button-rules.json"
            }
          }
        },
        "trial": {
          "$type": "color",
          "$value": "#a855f7",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "blog Start Free Trial background",
              "file": "raw/blog-controls.json"
            }
          }
        },
        "continue": {
          "$type": "color",
          "$value": "#7c3aed",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "auth Continue background",
              "file": "raw/auth-buttons.json"
            }
          }
        },
        "tag": {
          "$type": "color",
          "$value": "#1e3a8a",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "blog All Tags selected chip",
              "file": "raw/blog-controls.json"
            }
          }
        }
      },
      "border": {
        "field": {
          "$type": "color",
          "$value": "#1e293b",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": "auth email field 1px solid rgb(30, 41, 59)",
              "file": "raw/auth-wall.json"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "#f3eeff14",
          "$extensions": {
            "source": {
              "label": "Measured",
              "where": ".button-secondary border rgba(243, 238, 255, 0.08)",
              "file": "raw/button-rules.json"
            }
          }
        }
      }
    },
    "component": {
      "button": {
        "primary": {
          "background": {
            "$type": "color",
            "$value": "#712fff1f",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": ".button-primary::before wash",
                "file": "raw/button-rules.json"
              }
            }
          },
          "text": {
            "$type": "color",
            "$value": "#f4f0ff",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": ".button color",
                "file": "raw/button-rules.json"
              }
            }
          },
          "radius": {
            "$type": "dimension",
            "$value": "8px",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": ".button border-radius",
                "file": "raw/button-rules.json"
              }
            }
          },
          "padding": {
            "$type": "other",
            "$value": "8px 16px",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": ".button padding",
                "file": "raw/button-rules.json"
              }
            }
          },
          "height": {
            "$type": "dimension",
            "$value": "36px",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": "Download for Mac bounding box",
                "file": "raw/controls.json"
              }
            }
          }
        },
        "trial": {
          "background": {
            "$type": "color",
            "$value": "#a855f7",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": "Start Free Trial",
                "file": "raw/blog-controls.json"
              }
            }
          },
          "text": {
            "$type": "color",
            "$value": "#ece5ff",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": "Start Free Trial text",
                "file": "raw/blog-controls.json"
              }
            }
          },
          "radius": {
            "$type": "dimension",
            "$value": "8px",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": "Start Free Trial radius",
                "file": "raw/blog-controls.json"
              }
            }
          },
          "height": {
            "$type": "dimension",
            "$value": "40px",
            "$extensions": {
              "source": {
                "label": "Measured",
                "where": "Start Free Trial height",
                "file": "raw/blog-controls.json"
              }
            }
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
