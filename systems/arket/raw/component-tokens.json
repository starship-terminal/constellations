   "type": "color",
   "description": "The darker hairline (#b4b4b4) used on stronger dividers."
  },
  "ink": {
   "var": "--color-black",
   "type": "color",
   "description": "Primary button fill (consent CTAs, filter hover, continue)."
  },
  "on-ink": {
   "var": "--color-white",
   "type": "color",
   "description": "Text on the black buttons."
  },
  "danger": {
   "var": "--color-red",
   "type": "color",
   "description": "Sale/error red (#d80404)."
  },
  "success": {
   "var": "--color-green",
   "type": "color",
   "description": "Confirmation green (#389d47), e.g. the location notice check."
  },
  "info": {
   "var": "--color-blue",
   "type": "color",
   "description": "Informational blue."
  },
  "focus-ring": {
   "value": "#005fcc",
   "type": "color",
   "source": "computed outlineColor on keyboard focus (raw/components-computed.json); arket.com declares no :focus-visible style of its own, so this is the browser's default 1px auto ring, not a product token",
   "description": "The browser-default 1px #005fcc auto outline every measured control shows on keyboard focus."
  },
  "overlay": {
   "var": "--color-overlay-beige",
   "type": "color",
   "description": "The warm dimmer behind drawers and dialogs (rgba(164,155,112,0.2))."
  },
  "sale": {
   "var": "--color-alert-red",
   "type": "color",
   "description": "Alert red (#c12d0d) alongside --color-red."
  }
 },
