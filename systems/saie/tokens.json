{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "core": {
    "color": {
      "ink": {
        "$value": "#1b2121",
        "$type": "color",
        "$extensions": {
          "source": "Measured. :root --color-black-main on https://saiehello.com/ on 22 November 2026. Body color rgb(27, 33, 33). Announcement bar background."
        }
      },
      "page": {
        "$value": "#f2f2f2",
        "$type": "color",
        "$extensions": {
          "source": "Measured. :root --color-bg. Body background rgb(242, 242, 242) on the homepage."
        }
      },
      "lilac": {
        "$value": "#c0c0da",
        "$type": "color",
        "$extensions": {
          "source": "Measured. :root --color-purple. Announcement bar text rgb(192, 192, 218)."
        }
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Product add-to-bag label rgb(255, 255, 255) on https://saiehello.com/products/glossybounce."
        }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Collection card outline button border rgb(0, 0, 0) on https://saiehello.com/collections/lip."
        }
      }
    },
    "font": {
      "display": {
        "$value": "Ordinary-Display, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. document.body font-family on the homepage. Ordinary-Display 400 and 500 were loaded. Arial is the declared fallback."
        }
      }
    },
    "typography": {
      "body": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "20.8px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured. Body computed style on the homepage."
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "16.9px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured. Header SHOP link. text-transform uppercase."
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "25px",
          "fontWeight": 500,
          "lineHeight": "26.25px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured. Product h1 GLOSSYBOUNCE and collection h1 LIP. text-transform uppercase."
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{core.font.display}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "19.5px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "Measured. Visible ADD TO MAKEUP BAG on the Glossybounce product page. text-transform uppercase."
        }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. SHOP NOW, collection card button, and product add button border-radius 0px."
        }
      }
    },
    "spacing": {
      "bar": {
        "$value": "34px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Announcement bar height on the homepage at 1440 CSS pixels."
        }
      },
      "header": {
        "$value": "91px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. :root --header-height and the fixed header box height."
        }
      },
      "button-y": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Collection card ADD TO MAKEUP BAG padding 12px."
        }
      },
      "button-x": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Homepage SHOP NOW padding 12px 40px. Product add button padding 20px 40px."
        }
      },
      "button-product-y": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Visible product ADD TO MAKEUP BAG padding-block 20px."
        }
      }
    },
    "size": {
      "logo-w": {
        "$value": "186px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Homepage wordmark link box width."
        }
      },
      "logo-h": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Homepage wordmark link box height."
        }
      },
      "hero-cta-h": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Homepage SHOP NOW height."
        }
      },
      "card-button-h": {
        "$value": "46px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Lip collection card ADD TO MAKEUP BAG height."
        }
      },
      "product-button-h": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Visible Glossybounce ADD TO MAKEUP BAG height."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color"
      },
      "surface": {
        "$value": "{core.color.white}",
        "$type": "color",
        "$extensions": {
          "source": "Sampled from the product page field. The buy column sits on white against the #f2f2f2 page."
        }
      },
      "text": {
        "$value": "{core.color.ink}",
        "$type": "color"
      },
      "muted": {
        "$value": "{core.color.lilac}",
        "$type": "color",
        "$extensions": {
          "source": "Announcement copy on the ink bar. Not a body muted color. Body secondary type was not separately measured."
        }
      },
      "accent": {
        "$value": "{core.color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "The filled product button and the announcement bar use ink. There is no separate brand accent."
        }
      },
      "border": {
        "$value": "{core.color.ink}",
        "$type": "color"
      },
      "on-accent": {
        "$value": "{core.color.white}",
        "$type": "color"
      },
      "announcement": {
        "$value": "{core.color.lilac}",
        "$type": "color"
      }
    },
    "component": {
      "button-primary": {
        "bg": {
          "$value": "{core.color.ink}",
          "$type": "color"
        },
        "text": {
          "$value": "{core.color.white}",
          "$type": "color"
        },
        "radius": {
          "$value": "{core.radius.none}",
          "$type": "dimension"
        },
        "height": {
          "$value": "{core.size.product-button-h}",
          "$type": "dimension"
        }
      },
      "button-outline": {
        "bg": {
          "$value": "transparent",
          "$type": "color",
          "$extensions": {
            "source": "Measured. Homepage SHOP NOW background rgba(0, 0, 0, 0). Border 2px solid rgb(0, 0, 0)."
          }
        },
        "text": {
          "$value": "{core.color.black}",
          "$type": "color"
        },
        "radius": {
          "$value": "{core.radius.none}",
          "$type": "dimension"
        },
        "height": {
          "$value": "{core.size.hero-cta-h}",
          "$type": "dimension"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
