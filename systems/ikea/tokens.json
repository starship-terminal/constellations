{
 "$description": "IKEA Singapore public storefront (www.ikea.com/sg/en), captured 2026-11-19 signed out. Skapa --colour-* layer, one light theme. The global country picker at www.ikea.com is a separate page.",
 "core": {
  "font": {
   "family": {
    "sans": {
     "$type": "fontFamily",
     "$value": [
      "Noto IKEA",
      "Noto Sans",
      "system-ui",
      "sans-serif"
     ],
     "$extensions": {
      "source": "Reconstruction \u2014 abridged by hand from the computed font-family on body, www.ikea.com/sg/en/ 2026-11-19 (raw/css-vars.json computed.bodyFont). The live stack leads with currency-symbol faces (\"Omani Rial\", \"Emirati Dirham\", \"Saudi Riyal\"), then Noto IKEA and per-script Noto faces. Noto IKEA is proprietary and is not loaded here."
     }
    }
   }
  },
  "typography": {
   "display-xl": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "72px",
     "fontWeight": 700,
     "lineHeight": "80px"
    },
    "$extensions": {
     "source": "declared --skapa-display-xl (raw/css-vars.json); fontWeight and lineHeight: Reconstruction \u2014 entered by hand at capture time, no raw reading behind it"
    }
   },
   "display-l": {
    "$type": "typography",
