{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "midnight": {
        "$value": "#03143b",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(3, 20, 59); --dna-color-midnight on https://rothys.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed header and footer background rgb(255, 255, 255)" }
      },
      "roth": {
        "$value": "#9a1b2c",
        "$type": "color",
        "$extensions": { "source": "computed .announcement-bar background rgb(154, 27, 44); wordmark path fill #9A1B2C" }
      },
      "sale": {
        "$value": "#da3522",
        "$type": "color",
        "$extensions": { "source": "computed sale price $119 color rgb(218, 53, 34) on the product page" }
      },
      "line": {
        "$value": "#dcdbdd",
        "$type": "color",
        "$extensions": { "source": "computed header border-bottom rgb(220, 219, 221); --dna-color-light-grey" }
      },
      "sandstone": {
        "$value": "#f4f2ef",
        "$type": "color",
        "$extensions": { "source": "--dna-color-sandstone, declared on :root" }
      },
      "subdued": {
        "$value": "#666666",
        "$type": "color",
        "$extensions": { "source": "--dna-color-subdued, declared on :root" }
      },
      "reflex": {
        "$value": "#092dc5",
        "$type": "color",
        "$extensions": { "source": "--dna-color-reflex-blue, declared on :root. Used on the about hero type in the screenshot." }
      }
    },
    "font": {
      "sans": {
        "$value": "Maison Neue Book, Arial, Helvetica, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily. Maison Neue Book was loaded. Arial is the style-guide fallback, not the page fallback." }
      },
      "sans-medium": {
        "$value": "Maison Neue Medium, Arial, Helvetica, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed nav label fontFamily. Maison Neue Medium was loaded." }
      },
      "serif": {
        "$value": "Grifo S Light, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed product title and --dna-font-serif. Georgia is the declared fallback." }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "40px", "fontWeight": 300, "lineHeight": "40px" },
        "$type": "typography",
        "$extensions": { "source": "computed product title and collection h1, Grifo S Light 40px. The declared --dna-h1-font is 56px and was not the title on these pages." }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.sans-medium}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px", "letterSpacing": "2px" },
        "$type": "typography",
        "$extensions": { "source": "computed .desktop-nav__link, uppercase" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0.5px" },
        "$type": "typography",
        "$extensions": { "source": "computed body, matches --dna-body-p2-font" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px" },
        "$type": "typography",
        "$extensions": { "source": "computed sale price span" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "16px" },
        "$type": "typography",
        "$extensions": { "source": "computed announcement bar 12px" }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed header, nav, and docked size control border-radius 0px" }
      },
      "s": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": { "source": "--dna-border-radius-s, declared. Not measured on a painted control in this pass." }
      }
    },
    "spacing": {
      "announcement": {
        "$value": "37px",
        "$type": "dimension",
        "$extensions": { "source": ".announcement-bar height" }
      },
      "header": {
        "$value": "71px",
        "$type": "dimension",
        "$extensions": { "source": "header.header height" }
      },
      "logo": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "wordmark left inset" }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "alias" } },
      "text": { "$value": "{core.color.midnight}", "$type": "color", "$extensions": { "source": "alias" } },
      "muted": { "$value": "{core.color.subdued}", "$type": "color", "$extensions": { "source": "declared subdued, not measured on a painted label" } },
      "accent": { "$value": "{core.color.roth}", "$type": "color", "$extensions": { "source": "announcement bar and wordmark" } },
      "sale": { "$value": "{core.color.sale}", "$type": "color", "$extensions": { "source": "sale price" } },
      "border": { "$value": "{core.color.line}", "$type": "color", "$extensions": { "source": "alias" } },
      "surface": { "$value": "{core.color.sandstone}", "$type": "color", "$extensions": { "source": "declared sandstone. Product gallery ground in the screenshot is this family." } },
      "on-accent": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "announcement type on roth" } }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
