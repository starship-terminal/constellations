{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Shop surfaces read white on https://www.nordstrom.com/ 2026-11-22. Body and html backgrounds are transparent." }
      },
      "ink": {
        "$value": "#191a1b",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(25, 26, 27). Promo bar fill, Add to Bag fill, and product title are the same ink." }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo bar text and Add to Bag text rgb(255, 255, 255)." }
      },
      "sale": {
        "$value": "#b80009",
        "$type": "color",
        "$extensions": { "source": "Measured. Black Friday & Sale nav label color rgb(184, 0, 9)." }
      },
      "price": {
        "$value": "#d82508",
        "$type": "color",
        "$extensions": { "source": "Measured. Sale price SGD 132.64 color rgb(216, 37, 8) on the cashmere sweater page." }
      },
      "search": {
        "$value": "#f0f3f5",
        "$type": "color",
        "$extensions": { "source": "Measured. Search field backgroundColor rgb(240, 243, 245)." }
      }
    },
    "font": {
      "body": {
        "$value": "\"Brandon Text\", Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body, nav, search, promo, product title, and Add to Bag fontFamily. Files are not in this package." }
      }
    },
    "radius": {
      "bag": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Add to Bag border-radius 4px." }
      },
      "search": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search field border-radius 0px." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "ink": { "$value": "{core.color.ink}", "$type": "color" },
      "on-ink": { "$value": "{core.color.on-ink}", "$type": "color" },
      "sale": { "$value": "{core.color.sale}", "$type": "color" },
      "price": { "$value": "{core.color.price}", "$type": "color" },
      "search": { "$value": "{core.color.search}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
