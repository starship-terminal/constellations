          0.88,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-sine-out"
        }
      },
      "sine-in-out": {
        "$value": [
          0.37,
          0,
          0.63,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-sine-in-out"
        },
        "$description": "The measured 0.2s chip transition uses this"
      },
      "snappy": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-snappy"
        },
        "$description": "Drawers and takeovers slide on this"
