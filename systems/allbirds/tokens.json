    "easing": {
      "default": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --default-transition-timing-function"
        },
        "$description": "Tailwind's default, and what buttons use"
      },
      "out": {
        "$value": [
          0,
          0,
          0.2,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-out"
        }
      },
      "in-out": {
        "$value": [
          0.4,
          0,
          0.2,
          1
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-in-out"
        }
      },
      "sine-in": {
        "$value": [
          0.12,
          0,
          0.39,
          0
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "css-var --ease-sine-in"
        }
      },
      "sine-out": {
        "$value": [
