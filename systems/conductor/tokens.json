{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": ["ui-sans-serif", "system-ui", "sans-serif"],
          "$description": "Computed --marketing-font-sans on the homepage. The stylesheet names Geist as the intended face; the capture browser resolved the generic stack.",
          "$extensions": {
            "source": {
              "evidence": "computed",
              "where": "https://www.conductor.build/ getComputedStyle(documentElement) --marketing-font-sans, 2026-11-22"
            }
          }
        },
        "mono": {
          "$type": "fontFamily",
          "$value": ["ui-monospace", "SFMono-Regular", "SF Mono", "Menlo", "Consolas", "Liberation Mono", "monospace"],
          "$description": "Body face on the marketing homepage. Computed --marketing-font-mono.",
          "$extensions": {
            "source": {
              "evidence": "computed",
              "where": "https://www.conductor.build/ body font-family, 2026-11-22"
            }
          }
        },
        "login": {
          "$type": "fontFamily",
          "$value": ["Geist", "ui-sans-serif", "system-ui", "sans-serif"],
          "$description": "Computed body face on the signed-out login wall.",
          "$extensions": {
            "source": {
              "evidence": "computed",
              "where": "https://app.conductor.build/users/log_in body font-family, 2026-11-22"
            }
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "36px",
          "fontWeight": 600,
          "lineHeight": "40px",
          "letterSpacing": "-0.9px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage h1 at 1440, 2026-11-22"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.mono}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "homepage body, 2026-11-22"
          }
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "14px",
          "fontWeight": 400,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "header Changelog link, 2026-11-22"
          }
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "14px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "header Download button, 2026-11-22"
          }
        }
      },
      "banner": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "15px",
          "fontWeight": 500,
          "lineHeight": "22.5px"
        },
        "$extensions": {
          "source": {
            "evidence": "computed",
            "where": "announcement banner link, 2026-11-22"
          }
        }
      }
    },
    "radius": {
      "xs": {
        "$type": "dimension",
        "$value": "0.125rem",
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--radius-xs"}}
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--radius-sm"}}
      },
      "md": {
        "$type": "dimension",
        "$value": "0.375rem",
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--radius-md"}}
      },
      "lg": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$extensions": {"source": {"evidence": "computed", "where": "--radius and --radius-lg on html.dark"}}
      },
      "xl": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--radius-xl"}}
      },
      "control": {
        "$type": "dimension",
        "$value": "6px",
        "$description": "Download button and Get Conductor link.",
        "$extensions": {"source": {"evidence": "computed", "where": "header Download button border-radius"}}
      }
    },
    "space": {
      "banner": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {"source": {"evidence": "computed", "where": "announcement banner height"}}
      },
      "header": {
        "$type": "dimension",
        "$value": "57px",
        "$extensions": {"source": {"evidence": "computed", "where": "header getBoundingClientRect height"}}
      },
      "button-sm": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {"source": {"evidence": "computed", "where": "Download button height"}}
      },
      "button": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {"source": {"evidence": "computed", "where": "Get Conductor height"}}
      },
      "content": {
        "$type": "dimension",
        "$value": "56.25rem",
        "$extensions": {"source": {"evidence": "computed", "where": "--site-content-width"}}
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "$value": "150ms",
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--default-transition-duration .15s"}}
      },
      "ease": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 0.2, 1],
        "$extensions": {"source": {"evidence": "stylesheet", "where": "--default-transition-timing-function"}}
      }
    }
  },
  "dark": {
    "page": {
      "$type": "color",
      "$value": "#141110",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --background, body background rgb(20, 17, 16)"}}
    },
    "surface": {
      "$type": "color",
      "$value": "#211e1c",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --muted and --secondary"}}
    },
    "text": {
      "$type": "color",
      "$value": "#eae8e6",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --foreground, body color rgb(234, 232, 230)"}}
    },
    "text-strong": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {"source": {"evidence": "computed", "where": "homepage h1 color"}}
    },
    "muted": {
      "$type": "color",
      "$value": "#a5a09c",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --muted-foreground"}}
    },
    "accent": {
      "$type": "color",
      "$value": "#f3f2f1",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --primary. Download button fill is #eae8e6."}}
    },
    "accent-text": {
      "$type": "color",
      "$value": "#141110",
      "$extensions": {"source": {"evidence": "computed", "where": "Download button label rgb(20, 17, 16)"}}
    },
    "border": {
      "$type": "color",
      "$value": "#ffffff1a",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --border"}}
    },
    "highlight": {
      "$type": "color",
      "$value": "#2a1e1d",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --highlight"}}
    },
    "positive": {
      "$type": "color",
      "$value": "#16a249",
      "$extensions": {"source": {"evidence": "computed", "where": "html.dark --positive"}}
    },
    "docs-card": {
      "$type": "color",
      "$value": "#191919",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ".dark --color-fd-card"}}
    },
    "docs-popover": {
      "$type": "color",
      "$value": "#1e1e1e",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ".dark --color-fd-popover"}}
    }
  },
  "light": {
    "page": {
      "$type": "color",
      "$value": "#ffffff",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --background #fff. Body background rgb(255, 255, 255) under prefers-color-scheme light."}}
    },
    "surface": {
      "$type": "color",
      "$value": "#fafaf9",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --muted and --secondary"}}
    },
    "text": {
      "$type": "color",
      "$value": "#2c2826",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --foreground. Body color rgb(44, 40, 38) under light."}}
    },
    "muted": {
      "$type": "color",
      "$value": "#756f6c",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --muted-foreground"}}
    },
    "accent": {
      "$type": "color",
      "$value": "#413030",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --primary. The light Get Conductor fill computed as white, so this is the token, not that button."}}
    },
    "accent-text": {
      "$type": "color",
      "$value": "#f3f2f1",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --primary-foreground"}}
    },
    "border": {
      "$type": "color",
      "$value": "#eae8e6",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --border"}}
    },
    "highlight": {
      "$type": "color",
      "$value": "#faf7f5",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --highlight"}}
    },
    "positive": {
      "$type": "color",
      "$value": "#16a249",
      "$extensions": {"source": {"evidence": "stylesheet", "where": ":root --positive"}}
    }
  },
  "$themes": [
    {"id": "dark", "name": "dark", "selectedTokenSets": {"core": "enabled", "dark": "enabled"}},
    {"id": "light", "name": "light", "selectedTokenSets": {"core": "enabled", "light": "enabled"}}
  ]
}
