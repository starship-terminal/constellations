{
  "core": {
    "fontFamily": {
      "brilliant": {
        "$value": "CoFo Brilliant, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
        }
      },
      "robert": {
        "$value": "CoFo Robert, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
        }
      },
      "code": {
        "$value": "Source Code Pro, monospace",
        "$type": "fontFamily",
        "$extensions": {
          "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
        }
      }
    },
    "radius": {
      "field": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed #id_login border-radius on /login/"
        }
      },
      "pill": {
        "$value": "60px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed style of the painted span, signed-out homepage, 2026-11-21, learner face"
        }
      },
      "sign-in": {
        "$value": "54px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed Sign in button border-radius"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Body background."
    },
    "oat": {
      "$value": "#F5F3F1",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Homepage hero surface."
    },
    "text": {
      "$value": "#000000",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Homepage h1."
    },
    "accent": {
      "$value": "#456DFF",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Link colour."
    },
    "learner": {
      "$value": "#29CC57",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "I'm a learner face."
    },
    "learner-lip": {
      "$value": "#15B441",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "3D lip under the learner face."
    },
    "border-oat": {
      "$value": "#E4E4E4",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Sign in outline."
    },
    "login-page": {
      "$value": "#141414",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "/login/ page background rgb(20, 20, 20)."
    },
    "login-button": {
      "$value": "#E5E5E5",
      "$type": "color",
      "$extensions": {
        "source": "css-var, computed on :root at brilliant.org, signed out, data-theme light, 2026-11-21"
      },
      "$description": "Login Sign in face rgb(229, 229, 229)."
    }
  },
  "$themes": [
    {
      "name": "light",
      "selectedColor": "#29CC57"
    }
  ]
}
