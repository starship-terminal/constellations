        "$type": "fontFamily",
        "$extensions": {
          "source": "--font-family-monospace on :root. No measured element used it on the public pages."
        }
      },
      "super": {
        "$value": "\"PolySans\", Roboto, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "--font-family-super-title on :root. No measured marketing heading used it."
