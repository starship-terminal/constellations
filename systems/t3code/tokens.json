{
  "$schema": "https://design-tokens.org/schemas/tokens.json",
  "core": {
    "fontFamily": {
      "sans": {
        "$value": ["-apple-system", "BlinkMacSystemFont", "Inter Variable", "Segoe UI", "system-ui", "sans-serif"],
        "$type": "fontFamily",
        "$extensions": { "source": { "evidence": "Measured", "from": "getComputedStyle(documentElement) --font-sans, dark, 2026-11-22" } }
      },
      "mono": {
        "$value": ["ui-monospace", "SF Mono", "SFMono-Regular", "Menlo", "Consolas", "Liberation Mono", "monospace"],
        "$type": "fontFamily",
        "$extensions": { "source": { "evidence": "Measured", "from": "getComputedStyle(documentElement) --font-mono, dark, 2026-11-22" } }
      }
    },
    "fontSize": {
      "2xs": { "$value": "11px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-2xs" } } },
      "xs": { "$value": "12px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-xs" } } },
      "sm": { "$value": "14px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-sm and composer computed font-size" } } },
      "base": { "$value": "16px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-base" } } },
      "lg": { "$value": "18px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-lg" } } },
      "xl": { "$value": "20px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-xl" } } },
      "2xl": { "$value": "24px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--text-2xl" } } },
      "3xl": { "$value": "30px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "h1 computed font-size on the new-thread draft" } } }
    },
    "fontWeight": {
      "normal": { "$value": 400, "$type": "fontWeight", "$extensions": { "source": { "evidence": "Measured", "from": "--font-weight-normal and h1" } } },
      "medium": { "$value": 500, "$type": "fontWeight", "$extensions": { "source": { "evidence": "Measured", "from": "--font-weight-medium and thread title" } } },
      "semibold": { "$value": 600, "$type": "fontWeight", "$extensions": { "source": { "evidence": "Measured", "from": "--font-weight-semibold" } } },
      "bold": { "$value": 700, "$type": "fontWeight", "$extensions": { "source": { "evidence": "Measured", "from": "--font-weight-bold" } } }
    },
    "lineHeight": {
      "tight": { "$value": 1.25, "$type": "number", "$extensions": { "source": { "evidence": "Measured", "from": "--leading-tight" } } },
      "snug": { "$value": 1.375, "$type": "number", "$extensions": { "source": { "evidence": "Measured", "from": "--leading-snug" } } },
      "normal": { "$value": 1.5, "$type": "number", "$extensions": { "source": { "evidence": "Measured", "from": "--leading-normal" } } },
      "relaxed": { "$value": 1.625, "$type": "number", "$extensions": { "source": { "evidence": "Measured", "from": "--leading-relaxed" } } }
    },
    "letterSpacing": {
      "tighter": { "$value": "-0.05em", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--tracking-tighter" } } },
      "tight": { "$value": "-0.025em", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--tracking-tight; h1 computed -0.75px at 30px" } } },
      "normal": { "$value": "0em", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--tracking-normal" } } }
    },
    "radius": {
      "xs": { "$value": "2px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius-xs" } } },
      "sm": { "$value": "4px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius-sm = calc(.5rem - 4px)" } } },
      "md": { "$value": "6px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius-md and settle-row computed radius" } } },
      "lg": { "$value": "8px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius .5rem and icon-button computed radius" } } },
      "xl": { "$value": "12px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius-xl" } } },
      "2xl": { "$value": "16px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--radius-2xl" } } }
    },
    "spacing": {
      "1": { "$value": "4px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--spacing .25rem" } } },
      "2": { "$value": "8px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "2 * --spacing" } } },
      "3": { "$value": "12px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--workspace-titlebar-control-gap .75rem" } } },
      "4": { "$value": "16px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--command-content-inset" } } },
      "5": { "$value": "20px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--workspace-gutter 1.25rem" } } }
    },
    "size": {
      "iconButton": { "$value": "28px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "sidebar icon button bounding box" } } },
      "footerButton": { "$value": "32px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "settings footer button bounding box" } } },
      "sidebar": { "$value": "256px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "[data-slot=sidebar] getBoundingClientRect at 1440" } } },
      "topbar": { "$value": "52px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--workspace-topbar-height" } } },
      "composerMax": { "$value": "736px", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "new-thread composer bounding box" } } },
      "chatMax": { "$value": "46rem", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--chat-content-max-width" } } },
      "detailsPanel": { "$value": "17.5rem", "$type": "dimension", "$extensions": { "source": { "evidence": "Measured", "from": "--thread-details-panel-width" } } }
    },
    "motion": {
      "duration": { "$value": "150ms", "$type": "duration", "$extensions": { "source": { "evidence": "Measured", "from": "--default-transition-duration" } } },
      "easing": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)", "$type": "cubicBezier", "$extensions": { "source": { "evidence": "Measured", "from": "--default-transition-timing-function" } } }
    },
    "focusRing": {
      "color": { "$value": "{dark.color.ring}", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--ring" } } },
      "width": { "$value": "Not captured", "$type": "dimension", "$extensions": { "source": { "evidence": "Not captured", "from": "focus-visible ring width was not held long enough to measure" } } }
    }
  },
  "dark": {
    "color": {
      "page": { "$value": "#000000", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--background and main computed background" } } },
      "surface": { "$value": "#111111", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--card color-mix(in srgb, oklch(14.5% 0 none) 97%, #fff); oklch(14.5% 0 0) is #0a0a0a, mixed 97% toward white is #111111" } } },
      "raised": { "$value": "#1e1e1e", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--message-surface color-mix(in srgb, oklch(14.5% 0 none) 92%, #fff); oklch(14.5% 0 0) is #0a0a0a, mixed 92% is #1e1e1e" } } },
      "text": { "$value": "#f5f5f5", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "main computed color; --foreground is oklch(97% 0 none)" } } },
      "muted": { "$value": "#a1a1a1", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--muted-foreground oklch(70.8% 0 none)" } } },
      "accent": { "$value": "#346bf1", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--primary oklch(57.1% .21 264) converted to sRGB" } } },
      "accentForeground": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--primary-foreground" } } },
      "border": { "$value": "#ffffff14", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--border color-mix(in oklab, #fff 8%, transparent)" } } },
      "input": { "$value": "#ffffff1c", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--input color-mix(in oklab, #fff 11%, transparent)" } } },
      "ring": { "$value": "{dark.color.accent}", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--ring equals --primary" } } },
      "destructive": { "$value": "#fb414a", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--destructive color-mix(in srgb, oklch(63.7% .237 25.331) 90%, #fff); the oklch converts to #fb2c36, mixed 90% is #fb414a" } } },
      "success": { "$value": "#00bc7d", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--success oklch(69.6% .17 162.48) converted to sRGB" } } },
      "warning": { "$value": "#fe9a00", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--warning oklch(76.9% .188 70.08) converted to sRGB" } } },
      "info": { "$value": "#2b7fff", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--info oklch(62.3% .214 259.815) converted to sRGB" } } },
      "wash": { "$value": "#ffffff0a", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--accent and --sidebar-row-hover, white at 4%" } } }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "#fcfcfc", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--background oklch(99.2% 0 0) after removing .dark" } } },
      "surface": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--card #fff in light" } } },
      "raised": { "$value": "#fafafa", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--sidebar and --muted oklch(98.5% 0 none)" } } },
      "text": { "$value": "#18181b", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--foreground oklch(21% .006 285.885) converted to sRGB" } } },
      "muted": { "$value": "#71717b", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--muted-foreground oklch(55.2% .016 285.938) converted to sRGB" } } },
      "accent": { "$value": "#1b4ed8", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--primary oklch(48.8% .217 264) converted to sRGB" } } },
      "accentForeground": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--primary-foreground" } } },
      "border": { "$value": "#e4e4e7", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--border oklch(92% .004 286.32)" } } },
      "input": { "$value": "#d4d4d8", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--input oklch(87.1% .006 286.286)" } } },
      "ring": { "$value": "{light.color.accent}", "$type": "color", "$extensions": { "source": { "evidence": "Measured", "from": "--ring equals --primary in light" } } },
      "destructive": { "$value": "#fb2c36", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--destructive oklch(63.7% .237 25.331) converted to sRGB" } } },
      "success": { "$value": "#00bc7d", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--success oklch(69.6% .17 162.48) converted to sRGB, same token as dark" } } },
      "warning": { "$value": "#fe9a00", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--warning oklch(76.9% .188 70.08) converted to sRGB, same token as dark" } } },
      "info": { "$value": "#2b7fff", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "--info oklch(62.3% .214 259.815) converted to sRGB, same token as dark" } } },
      "wash": { "$value": "#f4f4f5", "$type": "color", "$extensions": { "source": { "evidence": "Derived", "from": "light muted surface used for hover rows" } } }
    }
  },
  "$themes": [
    { "id": "dark", "name": "dark", "selectedTokenSets": { "core": "source", "dark": "enabled" } },
    { "id": "light", "name": "light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
