   "$type": "color",
   "$value": "#181d25",
   "$extensions": {
    "source": "css-var --_apps---colors--border; the Book a Demo outline paints #000000 instead"
   }
  },
  "link": {
   "$type": "color",
   "$value": "#333333",
   "$extensions": {
    "source": "measured computed color on the Pricing nav link"
   }
  },
  "destructive": {
   "$value": "{color.app.destructive}",
