     "$value": "#0061fe",
     "$extensions": {
      "source": "measured a.nav_start_button backgroundColor"
     }
    },
    "text": {
     "$type": "color",
     "$value": "#ffffff",
     "$extensions": {
      "source": "measured a.nav_start_button color"
     }
    },
    "radius": {
     "$type": "dimension",
     "$value": "10px",
     "$extensions": {
      "source": "measured a.nav_start_button borderRadius"
     }
    },
    "height": {
     "$type": "dimension",
     "$value": "40px",
     "$extensions": {
      "source": "measured a.nav_start_button height, 1440"
     }
    }
   },
   "button-quiet": {
    "bg": {
     "$type": "color",
     "$value": "rgba(0, 0, 0, 0)",
     "$extensions": {
      "source": "measured Book a Demo backgroundColor"
     }
    },
    "text": {
     "$type": "color",
     "$value": "#000000",
     "$extensions": {
      "source": "measured Book a Demo color"
     }
    },
    "border": {
     "$type": "color",
     "$value": "#000000",
     "$extensions": {
      "source": "measured Book a Demo borderTopColor"
     }
    },
    "radius": {
     "$type": "dimension",
     "$value": "10px",
     "$extensions": {
      "source": "measured Book a Demo borderRadius"
     }
    }
   }
  }
