     "fontWeight": 500,
     "lineHeight": "90px",
     "letterSpacing": "-2px"
    },
    "$extensions": {
     "source": "measured computed style on h1._26_h1, home, 1440"
    }
   },
   "heading": {
    "$type": "typography",
    "$value": {
     "fontFamily": "Sharp Grotesk DB Book 20",
     "fontSize": "48px",
     "fontWeight": 400,
     "lineHeight": "57.6px",
     "letterSpacing": "0px"
    },
    "$extensions": {
     "source": "measured computed style on h2._25_h2, home, 1440"
    }
   },
   "body": {
    "$type": "typography",
    "$value": {
