    "source": "measured computed backgroundColor on body; card token --_apps---colors--card is also #fff"
   }
  },
  "text": {
   "$type": "color",
   "$value": "#181d25",
   "$extensions": {
    "source": "measured computed color on body, home, 1440"
   }
  },
  "muted": {
   "$type": "color",
   "$value": "#7d797a",
   "$extensions": {
    "source": "css-var --_apps---colors--muted-foreground; not sampled from a muted label this pass"
   }
