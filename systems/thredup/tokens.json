{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(0, 0, 0) on https://www.thredup.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(255, 255, 255)" }
      },
      "header": {
        "$value": "#e9e9e9",
        "$type": "color",
        "$extensions": { "source": "computed header background rgb(233, 233, 233). CSS variable --root-background-color is #e9e9e9" }
      },
      "promo": {
        "$value": "#daefc6",
        "$type": "color",
        "$extensions": { "source": "computed promo bar background rgb(218, 239, 198), class bg-brand-300" }
      },
      "chip": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed promo code chip background rgb(255, 255, 255) on the promo bar" }
      },
      "sand": {
        "$value": "#f3f2ee",
        "$type": "color",
        "$extensions": { "source": "computed Shop/Sell pill and footer background rgb(243, 242, 238)" }
      },
      "field-border": {
        "$value": "#b6b5b2",
        "$type": "color",
        "$extensions": { "source": "computed search and email border 0.5px solid rgb(182, 181, 178)" }
      },
      "burgundy": {
        "$value": "#83211d",
        "$type": "color",
        "$extensions": { "source": "computed Holiday Shop and sale price rgb(131, 33, 29). Hero panel background is rgb(131, 33, 30)" }
      },
      "cream": {
        "$value": "#fffedc",
        "$type": "color",
        "$extensions": { "source": "computed hero type rgb(255, 254, 220) on the burgundy panel" }
      },
      "muted": {
        "$value": "#3d3d3c",
        "$type": "color",
        "$extensions": { "source": "computed struck price rgb(61, 61, 60)" }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Add to Cart label rgb(255, 255, 255) on rgb(0, 0, 0)" }
      }
    },
    "font": {
      "sans": {
        "$value": "Season Sans, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily Season Sans, Season Sans Fallback, sans-serif. File is not in this package" }
      },
      "serif": {
        "$value": "Season Serif, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed hero, category title, and brand fontFamily Season Serif, Season Serif Fallback, serif. File is not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "22.4px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "20px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women nav link, padding 16px 0px 14px" }
      },
      "toggle": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px", "letterSpacing": "1px" },
        "$type": "typography",
        "$extensions": { "source": "computed Shop and Sell, uppercase" }
      },
      "kicker": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "16px", "letterSpacing": "1px" },
        "$type": "typography",
        "$extensions": { "source": "computed Thousands of new items added, uppercase" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "12px", "fontWeight": 500, "lineHeight": "22px", "letterSpacing": "2px" },
        "$type": "typography",
        "$extensions": { "source": "computed Shop the Sale and Add to Cart. Neither was clicked" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "36px", "fontWeight": 400, "lineHeight": "50.4px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage h2 and Women h1" }
      },
      "brand": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "28px", "fontWeight": 400, "lineHeight": "39.2px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed product brand link" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "20px", "fontWeight": 500, "lineHeight": "24px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed sale price on the product page" }
      }
    },
    "size": {
      "header": {
        "$value": "176px",
        "$type": "dimension",
        "$extensions": { "source": "computed header height, promo plus logo row plus nav" }
      },
      "promo": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": { "source": "computed promo bar height" }
      },
      "nav": {
        "$value": "52px",
        "$type": "dimension",
        "$extensions": { "source": "computed nav row height" }
      },
      "control": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "computed search, Shop/Sell pill, Shop the Sale, and Add to Cart height" }
      },
      "search": {
        "$value": "334px",
        "$type": "dimension",
        "$extensions": { "source": "computed search width" }
      },
      "cart": {
        "$value": "556px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to Cart width. Not clicked" }
      }
    },
    "radius": {
      "control": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": { "source": "computed search, Shop the Sale, Add to Cart, and code chip border-radius" }
      },
      "pill": {
        "$value": "999px",
        "$type": "dimension",
        "$extensions": { "source": "computed Shop/Sell track border-radius" }
      }
    }
  }
}
