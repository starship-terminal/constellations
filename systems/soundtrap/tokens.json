        "$extensions": {
          "source": "Measured .st-heading-3 probe. Pricing segment labels also compute 21px / 700."
        }
      },
      "title-large": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "18px",
          "fontWeight": 500,
          "lineHeight": "23px"
        },
        "$extensions": {
          "source": "Measured .st-title-large probe and the login signup line."
        }
      },
      "title-standard": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "15px",
          "fontWeight": 500,
          "lineHeight": "20px"
        },
        "$extensions": {
          "source": "Measured .st-title-standard probe."
        }
      },
      "body-standard": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
