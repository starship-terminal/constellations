      "control-field": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "source": "Measured email and password field height on /login."
        }
      },
      "control-submit": {
        "$type": "dimension",
        "$value": "41px",
        "$extensions": {
          "source": "Measured Log in submit and header Get started height."
        }
