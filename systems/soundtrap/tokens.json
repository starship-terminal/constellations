        "$extensions": {
          "source": "Measured .st-body-small. Declared .8125rem / 1.0625rem."
        }
      },
      "label-standard": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "17px"
        },
        "$extensions": {
          "source": "Measured .st-label-standard on login labels. Declared .8125rem / 1.0625rem / 500."
        }
      },
      "label-small": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "11px",
          "fontWeight": 500,
          "lineHeight": "15px"
