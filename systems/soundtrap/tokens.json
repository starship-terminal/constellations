{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "font": {
      "family": {
        "matter": {
          "$type": "fontFamily",
          "$value": [
            "Matter",
            "sans-serif"
          ],
          "$extensions": {
            "source": "Measured @font-face and computed font-family on body, h1, buttons. Matter is loaded from static.soundtrap.com. Proprietary; the package does not ship the font files."
          }
        }
      }
    },
    "typography": {
      "headline-hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "80px",
          "fontWeight": 700,
          "lineHeight": "96px",
          "letterSpacing": "-1.28px"
        },
        "$extensions": {
          "source": "Measured .st-headline-hero on the live h1 at 1440."
        }
      },
      "display-1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "37px",
          "fontWeight": 600,
          "lineHeight": "41px",
          "letterSpacing": "-0.99px"
        },
        "$extensions": {
          "source": "Measured .st-display-1 probe and live h2."
        }
      },
      "display-2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "33px",
          "fontWeight": 600,
          "lineHeight": "38px",
          "letterSpacing": "-0.84px"
        },
        "$extensions": {
          "source": "Measured .st-display-2 probe."
        }
      },
      "heading-1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "29px",
          "fontWeight": 600,
          "lineHeight": "35px",
          "letterSpacing": "-0.5px"
        },
        "$extensions": {
          "source": "Measured .st-heading-1 probe."
        }
      },
      "heading-2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "25px",
          "fontWeight": 600,
          "lineHeight": "30px",
          "letterSpacing": "-0.5px"
        },
        "$extensions": {
          "source": "Measured .st-heading-2 probe and live h2."
        }
      },
      "heading-3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.matter}",
          "fontSize": "21px",
          "fontWeight": 600,
          "lineHeight": "25px",
          "letterSpacing": "-0.42px"
