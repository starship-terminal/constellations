          "source": "Measured live nav height 90px at 1440 and 390. Declared html { --nav-height: 90px }."
        }
      },
      "control-oauth": {
        "$type": "dimension",
        "$value": "44px",
        "$extensions": {
          "source": "Measured OAuth button height on /login."
        }
