    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Derived from declared .rounded-sm { border-radius: .125rem } at the page's 16px root."
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Derived from declared .rounded { border-radius: .25rem }."
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "source": "Derived from declared .rounded-md { border-radius: .375rem }."
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured 8px on login fields, OAuth buttons, language summary, and plan cards. Declared .rounded-lg { border-radius: .5rem }."
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": "Measured border-radius 9999px on marketing pills and the pricing Try it free button. Declared .rounded-full."
        }
      },
      "toggle": {
        "$type": "dimension",
        "$value": "25px",
        "$extensions": {
          "source": "Measured on the pricing billing st-toggle track."
        }
      }
    },
