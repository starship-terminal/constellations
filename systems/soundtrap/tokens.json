    "motion": {
      "duration": {
        "colors": {
          "$type": "duration",
          "$value": "100ms",
          "$extensions": {
            "source": "Measured --transition-colors-time: 0.1s."
          }
        },
        "nav": {
          "$type": "duration",
          "$value": "300ms",
          "$extensions": {
            "source": "Measured Tailwind duration-300 on the marketing nav and header items."
          }
        },
        "enter": {
          "$type": "duration",
          "$value": "150ms",
          "$extensions": {
            "source": "Declared animation-duration: .15s on data-state open/closed."
          }
        }
      },
      "easing": {
        "ease-out": {
          "$type": "cubicBezier",
          "$value": [
            0,
            0,
            0.58,
            1
          ],
          "$extensions": {
            "source": "Derived from the keyword ease-out in --transition-colors-easing. Control points are the CSS keyword, not a custom bezier the page declared."
          }
        }
      }
    },
    "palette": {
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Measured --white"
        }
