{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "button-blue": {
        "$value": "#4f91fb",
        "$type": "color",
        "$extensions": { "source": "computed background-color of Back Home on the 404 page, rgb(79, 145, 251), 2026-11-22. The same rgb is the Subscribe control." }
      },
      "link-blue": {
        "$value": "#5c9cf5",
        "$type": "color",
        "$extensions": { "source": "computed color of Watch Introduction Video, rgb(92, 156, 245). A full-colour pixel in that label was (92, 156, 245)." }
      },
      "badge-gray": {
        "$value": "#b6b9be",
        "$type": "color",
        "$extensions": { "source": "computed background-color of the 404 badge, rgb(182, 185, 190)" }
      }
    },
    "font": {
      "family": {
        "body": {
          "$value": "ui-sans-serif, -apple-system, system-ui, Roboto, sans-serif",
          "$type": "fontFamily",
          "$extensions": { "source": "computed font-family on body at 1440. The site does not ship a custom family." }
        },
        "mono": {
          "$value": "ui-monospace, ui-sans-serif, -apple-system, system-ui, Roboto, sans-serif",
          "$type": "fontFamily",
          "$extensions": { "source": "computed font-family of the 404 badge" }
        }
      }
    },
    "typography": {
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "18px",
          "fontWeight": "400",
          "lineHeight": "25.2px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of body on https://culturedcode.com/things/ at 1440" }
      },
      "hero-description": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "23.994px",
          "fontWeight": "400",
          "lineHeight": "29.9925px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of .hero-description at 1440. The wordmark Things is an image, not type." }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "15px",
          "fontWeight": "600",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of the Features nav link at 1440" }
      },
      "button": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16.56px",
          "fontWeight": "700",
          "lineHeight": "normal"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of Back Home on the 404 page" }
      },
      "section": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "36px",
          "fontWeight": "700",
          "lineHeight": "36px"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of h1.fancysection-heading on /things/pricing/ at 1440" }
      },
      "search": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "23.9062px",
          "fontWeight": "400",
          "lineHeight": "normal"
        },
        "$type": "typography",
        "$extensions": { "source": "computed style of the support search field at 1440. Placeholder Type…, left empty." }
      }
    },
    "radius": {
      "button": {
        "$value": "7.452px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of Back Home" }
      },
      "nav": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of a nav link" }
      },
      "field": {
        "$value": "6.4px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of the homepage newsletter email field" }
      },
      "search": {
        "$value": "9.5625px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of the support search field" }
      },
      "card": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of a support article card" }
      },
      "badge": {
        "$value": "5.4px",
        "$type": "dimension",
        "$extensions": { "source": "computed border-radius of the 404 badge" }
      }
    }
  },
  "light": {
    "page": {
      "$value": "#f2f5f7",
      "$type": "color",
      "$extensions": { "source": "computed background-color of body, rgb(242, 245, 247), confirmed by pixel (10, 10) on the full-colour homepage PNG" }
    },
    "page-white": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": { "source": "computed background-color of body on /things/support/ and /things/cloud/, rgb(255, 255, 255)" }
    },
    "text": {
      "$value": "#303336",
      "$type": "color",
      "$extensions": { "source": "computed color of body, rgb(48, 51, 54)" }
    },
    "text-soft": {
      "$value": "#44474b",
      "$type": "color",
      "$extensions": { "source": "computed color of .hero-description, rgb(68, 71, 75). A full-colour pixel in that paragraph was (68, 71, 75)." }
    },
    "nav": {
      "$value": "#26344a80",
      "$type": "color",
      "$extensions": { "source": "computed color of a nav link, rgba(38, 52, 74, 0.5)" }
    },
    "accent": {
      "$value": "{core.color.button-blue}",
      "$type": "color",
      "$extensions": { "source": "Back Home fill" }
    },
    "on-accent": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": { "source": "computed color of Back Home, rgb(255, 255, 255)" }
    },
    "field": {
      "$value": "#ffffff",
      "$type": "color",
      "$extensions": { "source": "computed background-color of the newsletter email field, rgb(255, 255, 255), border rgb(223, 227, 232)" }
    },
    "search": {
      "$value": "#001d4708",
      "$type": "color",
      "$extensions": { "source": "computed background-color of the support search field, rgba(0, 29, 71, 0.08)" }
    },
    "card": {
      "$value": "#00347e0a",
      "$type": "color",
      "$extensions": { "source": "computed background-color of a support article card, rgba(0, 52, 126, 0.04)" }
    }
  }
}
