{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "ui": {
          "$value": "ui-sans-serif, -apple-system, \"system-ui\", Roboto, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body"
          }
        }
      }
    },
    "typography": {
      "heading": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "36px",
          "fontWeight": "700",
          "lineHeight": "36px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the homepage h2 at 1440"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "18px",
          "fontWeight": "400",
          "lineHeight": "25.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on body"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "15px",
          "fontWeight": "600",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on a header nav link"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "7.632px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on Subscribe"
        }
      },
      "card": {
        "$value": "18px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on a product card"
        }
      },
      "field": {
        "$value": "6.4px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on the newsletter email field"
        }
      },
      "nav": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on a header nav link"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "rgb(242, 245, 247)",
        "$type": "color",
        "$extensions": {
          "source": "computed background-color on body"
        }
      },
      "page-features": {
        "$value": "rgb(251, 252, 254)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on the features slice"
        }
      },
      "page-get": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on the get slice"
        }
      },
      "ink": {
        "$value": "rgb(48, 51, 54)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on body"
        }
      },
      "heading": {
        "$value": "rgb(44, 49, 56)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the homepage h2"
        }
      },
      "muted": {
        "$value": "rgb(68, 71, 75)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the hero lede"
        }
      },
      "nav": {
        "$value": "rgba(38, 52, 74, 0.5)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on a header nav link"
        }
      },
      "link": {
        "$value": "rgb(92, 156, 245)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on See features"
        }
      },
      "button": {
        "$value": "rgb(79, 145, 251)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on Subscribe"
        }
      },
      "on-button": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on Subscribe"
        }
      },
      "field": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on the newsletter email field"
        }
      },
      "field-border": {
        "$value": "rgb(223, 227, 232)",
        "$type": "color",
        "$extensions": {
          "source": "computed border-color on the newsletter email field"
        }
      },
      "footer": {
        "$value": "rgba(0, 15, 36, 0.46)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on a footer link"
        }
      },
      "card": {
        "$value": "rgb(242, 245, 247)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on a product card"
        }
      },
      "focus": {
        "$value": "rgb(229, 151, 0)",
        "$type": "color",
        "$extensions": {
          "source": "computed outline-color on a focused header nav link"
        }
      }
    }
  }
}
