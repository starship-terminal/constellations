{
  "_readme": "Token tree for build_tokens.py. Measured on adidas.com.cn (China flagship storefront) on 2026-11-10; every value traced to raw/components-computed.json.",
  "core": {
    "$description": "adidas China's palette is strict monochrome: black on white with grey steps.",
    "color": {
      "black": { "type": "color", "value": "rgb(0, 0, 0)", "source": "computed color/borderColor/outlineColor of nearly every measured component", "description": "The one ink: text, keylines, icon glyphs." },
      "white": { "type": "color", "value": "rgb(255, 255, 255)", "source": "computed backgroundColor of header, hero-cta", "description": "Page ground and control fills." },
      "greyDark": { "type": "color", "value": "rgb(154, 155, 155)", "source": "computed color on muted/disabled text nodes", "description": "Muted grey for secondary text." },
      "grey": { "type": "color", "value": "rgb(200, 203, 204)", "source": "computed color/borderTopColor of add-to-cart default (disabled CTA) and hairline edges", "description": "The disabled/disabled-border grey; hairlines." },
      "greyLight": { "type": "color", "value": "rgb(236, 239, 241)", "source": "computed fill of interior surfaces", "description": "Cool light-grey surface." },
      "offWhite": { "type": "color", "value": "rgb(249, 249, 249)", "source": "computed backgroundColor of promo-tag", "description": "Near-white strip fill under the nav." }
    },
    "font": {
      "family": {
        "din": { "type": "fontFamily", "value": "\"AdihausDIN\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif", "source": "computed fontFamily of most measured text", "description": "Adihaus DIN carries the storefront; PingFang SC falls back for CJK." },
        "neue": { "type": "fontFamily", "value": "\"adineuePRO\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif", "source": "computed fontFamily of display headings", "description": "adineuePRO on large display type." },
        "icon": { "type": "fontFamily", "value": "iconfont", "source": "computed fontFamily of icon glyphs", "description": "Glyphs are iconfont codepoints, not SVGs." }
      },
      "scale": {
        "11": { "type": "dimension", "value": "11px", "source": "footer-link fontSize" },
        "13": { "type": "dimension", "value": "13px", "source": "small body / utility text" },
        "14": { "type": "dimension", "value": "14px", "source": "hero-cta, add-to-cart button label" },
        "15": { "type": "dimension", "value": "15px", "source": "nav-item fontSize" },
        "16": { "type": "dimension", "value": "16px", "source": "header, promo-tag body text" },
        "18": { "type": "dimension", "value": "18px", "source": "pdp-price fontSize" },
        "24": { "type": "dimension", "value": "24px", "source": "heading level (24/30 700)" },
        "40": { "type": "dimension", "value": "40px", "source": "iconfont glyph on the mobile search-bar icon (measured 40px); large display" }
      },
      "weight": {
        "regular": { "type": "fontWeight", "value": 400, "source": "computed fontWeight of body text" },
        "bold": { "type": "fontWeight", "value": 700, "source": "computed fontWeight of nav-item, hero-cta, add-to-cart, pdp-price" }
      },
      "lineHeight": {
        "tight": { "type": "dimension", "value": "16px", "source": "11px small text" },
        "snug": { "type": "dimension", "value": "18px", "source": "13px text" },
        "body": { "type": "dimension", "value": "20px", "source": "14-15px controls" },
        "loose": { "type": "dimension", "value": "24px", "source": "16px body" },
        "display": { "type": "dimension", "value": "30px", "source": "24px headings" }
      }
    },
    "typography": {
      "navLabel": { "$value": { "fontFamily": "{font.family.din}", "fontSize": "{font.scale.15}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.body}", "letterSpacing": "0.5px" }, "$type": "typography", "$extensions": { "source": "nav-item, footer column title (letterSpacing 0.5px measured)" }, "$description": "15/20 bold nav labels." },
      "buttonLabel": { "$value": { "fontFamily": "{font.family.din}", "fontSize": "{font.scale.14}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.body}", "letterSpacing": "2px" }, "$type": "typography", "$extensions": { "source": "hero-cta, add-to-cart (letterSpacing 2px measured)" }, "$description": "14/20 bold on buttons." },
      "body": { "$value": { "fontFamily": "ui-sans-serif, system-ui, -apple-system, sans-serif", "fontSize": "{font.scale.16}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.loose}", "letterSpacing": "0px" }, "$type": "typography", "$extensions": { "source": "computed font of the page containers (header, footer, hero wrappers); the shell's inherited base — no 16/24 text node was captured" }, "$description": "16/24 shell base font." },
      "bodySmall": { "$value": { "fontFamily": "{font.family.din}", "fontSize": "{font.scale.13}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "0.5px" }, "$type": "typography", "$extensions": { "source": "utility-link, filter-row, promo-tag text nodes (letterSpacing 0.5px measured)" }, "$description": "13/18 small body." },
      "micro": { "$value": { "fontFamily": "{font.family.din}", "fontSize": "{font.scale.11}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.lineHeight.tight}", "letterSpacing": "0.5px" }, "$type": "typography", "$extensions": { "source": "footer-link (letterSpacing 0.5px measured)" }, "$description": "11/16 footer small print." },
      "price": { "$value": { "fontFamily": "{font.family.neue}", "fontSize": "{font.scale.18}", "fontWeight": "{font.weight.bold}", "lineHeight": "22px", "letterSpacing": "0.5px" }, "$type": "typography", "$extensions": { "source": "pdp-price (adineuePRO, letterSpacing 0.5px measured)" }, "$description": "18/22 bold ¥ prices." },
      "heading": { "$value": { "fontFamily": "{font.family.neue}", "fontSize": "{font.scale.24}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.lineHeight.display}", "letterSpacing": "1px" }, "$type": "typography", "$extensions": { "source": "pdp-title (letterSpacing 1px measured)" }, "$description": "24/30 bold display in adineuePRO." }
    },
    "radius": {
      "none": { "type": "dimension", "value": "0px", "source": "borderTopLeftRadius of every measured component", "description": "Every corner measured is square." }
    },
    "border": {
      "hairline": { "type": "dimension", "value": "1px", "source": "borderTopWidth where present", "description": "Edges are 1px greys where a line shows at all." }
    },
    "size": {
      "header": { "type": "dimension", "value": "124px", "source": "rendered height of header at 1440" },
      "control": {
        "button": { "type": "dimension", "value": "48px", "source": "hero-cta, add-to-cart height" },
        "buttonX": { "type": "dimension", "value": "16px", "source": "paddingLeft of hero-cta, add-to-cart" }
      },
      "tile": { "type": "dimension", "value": "454.5px", "source": "product-card height at 1440" },
      "footer": { "type": "dimension", "value": "360px", "source": "footer height" }
    },
    "focusRing": {
      "color": { "type": "color", "value": "{color.black}", "source": "computed outlineColor on focused controls; no painted ring observed", "description": "Browser default focus only." },
      "width": { "type": "dimension", "value": "0px", "source": "computed outlineWidth on focused buttons and nav items; text links instead take the browser's 1px auto #005fcc outline (footer-link focus-visible)" }
    },
    "motion": {
      "instant": { "type": "duration", "value": "0ms", "source": "computed transitionDuration of measured controls" }
    },
    "breakpoint": {
      "medium": { "type": "dimension", "value": "720px", "source": "Tailwind md: rules in raw/css-vars.json" },
      "large": { "type": "dimension", "value": "1440px", "source": "Tailwind lg: rules in raw/css-vars.json" }
    }
  },
  "light": {
    "$description": "The only theme adidas.com.cn paints; semantic roles alias core.",
    "background": {
      "page": { "type": "color", "value": "{color.white}", "source": "computed backgroundColor of header and hero-cta" },
      "surface": { "type": "color", "value": "{color.offWhite}", "source": "computed backgroundColor of promo-tag strip" },
      "inset": { "type": "color", "value": "{color.greyLight}", "source": "computed fill of interior surfaces" }
    },
    "text": {
      "primary": { "type": "color", "value": "{color.black}", "source": "computed color of every measured text node" },
      "muted": { "type": "color", "value": "{color.greyDark}", "source": "computed color of muted text" },
      "disabled": { "type": "color", "value": "{color.grey}", "source": "computed color of add-to-cart default (disabled CTA)" },
      "onDark": { "type": "color", "value": "{color.white}", "source": "text on inverted fills" }
    },
    "action": {
      "primary": { "type": "color", "value": "{color.black}", "source": "the dark fill state of purchase buttons; this capture's add-to-cart showed the disabled white-with-grey state" },
      "primaryText": { "type": "color", "value": "{color.white}", "source": "text on the black button fill" },
      "disabled": { "type": "color", "value": "{color.grey}", "source": "computed color/borderTopColor of add-to-cart default" }
    },
    "border": {
      "default": { "type": "color", "value": "{color.black}", "source": "computed borderTopColor where edges show" },
      "soft": { "type": "color", "value": "{color.grey}", "source": "computed borderTopColor of disabled controls / hairlines" }
    },
    "focus": {
      "ring": { "type": "color", "value": "{color.black}", "source": "computed outlineColor on focused controls" }
    }
  }
}
