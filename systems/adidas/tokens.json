{
 "core": {
  "$description": "adidas China's palette is strict monochrome: black on white with grey steps.",
  "color": {
   "black": {
    "$value": "#000000",
    "$type": "color",
    "$extensions": {
     "source": "computed color/borderColor/outlineColor of nearly every measured component"
    },
    "$description": "The one ink: text, keylines, icon glyphs."
   },
   "white": {
    "$value": "#ffffff",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of header, hero-cta"
    },
    "$description": "Page ground and control fills."
   },
   "greyDark": {
    "$value": "#9a9b9b",
    "$type": "color",
    "$extensions": {
     "source": "computed color on muted/disabled text nodes"
    },
    "$description": "Muted grey for secondary text."
   },
   "grey": {
    "$value": "#c8cbcc",
    "$type": "color",
    "$extensions": {
     "source": "computed color/borderTopColor of add-to-cart default (disabled CTA) and hairline edges"
    },
    "$description": "The disabled/disabled-border grey; hairlines."
   },
   "greyLight": {
    "$value": "#eceff1",
    "$type": "color",
    "$extensions": {
     "source": "computed fill of interior surfaces"
    },
    "$description": "Cool light-grey surface."
   },
   "offWhite": {
    "$value": "#f9f9f9",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of promo-tag"
    },
    "$description": "Near-white strip fill under the nav."
   }
  },
  "font": {
   "family": {
    "din": {
     "$value": "\"AdihausDIN\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of most measured text"
     },
     "$description": "Adihaus DIN carries the storefront; PingFang SC falls back for CJK."
    },
    "neue": {
     "$value": "\"adineuePRO\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of display headings"
     },
     "$description": "adineuePRO on large display type."
    },
    "icon": {
     "$value": "iconfont",
     "$type": "fontFamily",
     "$extensions": {
      "source": "computed fontFamily of icon glyphs"
     },
     "$description": "Glyphs are iconfont codepoints, not SVGs."
    }
   },
   "scale": {
    "11": {
     "$value": "11px",
     "$type": "dimension",
     "$extensions": {
      "source": "footer-link fontSize"
     }
    },
    "13": {
     "$value": "13px",
     "$type": "dimension",
     "$extensions": {
      "source": "small body / utility text"
     }
    },
    "14": {
     "$value": "14px",
     "$type": "dimension",
     "$extensions": {
      "source": "hero-cta, add-to-cart button label"
     }
    },
    "15": {
     "$value": "15px",
     "$type": "dimension",
     "$extensions": {
      "source": "nav-item fontSize"
     }
    },
    "16": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "header, promo-tag body text"
     }
    },
    "18": {
     "$value": "18px",
     "$type": "dimension",
     "$extensions": {
      "source": "pdp-price fontSize"
     }
    },
    "24": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "heading level (24/30 700)"
     }
    },
    "40": {
     "$value": "40px",
     "$type": "dimension",
     "$extensions": {
      "source": "m-burger icon glyph / large display"
     }
    }
   },
   "weight": {
    "regular": {
     "$value": 400,
     "$type": "fontWeight",
     "$extensions": {
      "source": "computed fontWeight of body text"
     }
    },
    "bold": {
     "$value": 700,
     "$type": "fontWeight",
     "$extensions": {
      "source": "computed fontWeight of nav-item, hero-cta, add-to-cart, pdp-price"
     }
    }
   },
   "lineHeight": {
    "tight": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "11px small text"
     }
    },
    "snug": {
     "$value": "18px",
     "$type": "dimension",
     "$extensions": {
      "source": "13px text"
     }
    },
    "body": {
     "$value": "20px",
     "$type": "dimension",
     "$extensions": {
      "source": "14-15px controls"
     }
    },
    "loose": {
     "$value": "24px",
     "$type": "dimension",
     "$extensions": {
      "source": "16px body"
     }
    },
    "display": {
     "$value": "30px",
     "$type": "dimension",
     "$extensions": {
      "source": "24px headings"
     }
    }
   }
  },
  "typography": {
   "navLabel": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.15}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "{font.lineHeight.body}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "nav-item"
    },
    "$description": "15/20 bold nav labels."
   },
   "buttonLabel": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.14}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "{font.lineHeight.body}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "hero-cta, add-to-cart"
    },
    "$description": "14/20 bold on buttons."
   },
   "body": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.16}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.loose}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "header, promo-tag"
    },
    "$description": "16/24 body."
   },
   "bodySmall": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.13}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.snug}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "small text nodes"
    },
    "$description": "13/18 small body."
   },
   "micro": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.11}",
     "fontWeight": "{font.weight.regular}",
     "lineHeight": "{font.lineHeight.tight}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "footer-link"
    },
    "$description": "11/16 footer small print."
   },
   "price": {
    "$value": {
     "fontFamily": "{font.family.din}",
     "fontSize": "{font.scale.18}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "22px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "pdp-price"
    },
    "$description": "18/22 bold ¥ prices."
   },
   "heading": {
    "$value": {
     "fontFamily": "{font.family.neue}",
     "fontSize": "{font.scale.24}",
     "fontWeight": "{font.weight.bold}",
     "lineHeight": "{font.lineHeight.display}",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "heading nodes"
    },
    "$description": "24/30 bold display in adineuePRO."
   }
  },
  "radius": {
   "none": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "borderTopLeftRadius of every measured component"
    },
    "$description": "Every corner measured is square."
   }
  },
  "border": {
   "hairline": {
    "$value": "1px",
    "$type": "dimension",
    "$extensions": {
     "source": "borderTopWidth where present"
    },
    "$description": "Edges are 1px greys where a line shows at all."
   }
  },
  "size": {
   "header": {
    "$value": "124px",
    "$type": "dimension",
    "$extensions": {
     "source": "rendered height of header at 1440"
    }
   },
   "control": {
    "button": {
     "$value": "48px",
     "$type": "dimension",
     "$extensions": {
      "source": "hero-cta, add-to-cart height"
     }
    },
    "buttonX": {
     "$value": "16px",
     "$type": "dimension",
     "$extensions": {
      "source": "paddingLeft of hero-cta, add-to-cart"
     }
    }
   },
   "tile": {
    "$value": "454.5px",
    "$type": "dimension",
    "$extensions": {
     "source": "product-card height at 1440"
    }
   },
   "footer": {
    "$value": "360px",
    "$type": "dimension",
    "$extensions": {
     "source": "footer height"
    }
   }
  },
  "focusRing": {
   "color": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "computed outlineColor on focused controls; no painted ring observed"
    },
    "$description": "Browser default focus only."
   },
   "width": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed outlineWidth on focus-visible states"
    }
   }
  },
  "motion": {
   "instant": {
    "$value": "0ms",
    "$type": "duration",
    "$extensions": {
     "source": "computed transitionDuration of measured controls"
    }
   }
  },
  "breakpoint": {
   "medium": {
    "$value": "720px",
    "$type": "dimension",
    "$extensions": {
     "source": "Tailwind md: rules in raw/css-vars.json"
    }
   },
   "large": {
    "$value": "1440px",
    "$type": "dimension",
    "$extensions": {
     "source": "Tailwind lg: rules in raw/css-vars.json"
    }
   }
  }
 },
 "light": {
  "$description": "The only theme adidas.com.cn paints; semantic roles alias core.",
  "background": {
   "page": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of header and hero-cta"
    }
   },
   "surface": {
    "$value": "{color.offWhite}",
    "$type": "color",
    "$extensions": {
     "source": "computed backgroundColor of promo-tag strip"
    }
   },
   "inset": {
    "$value": "{color.greyLight}",
    "$type": "color",
    "$extensions": {
     "source": "computed fill of interior surfaces"
    }
   }
  },
  "text": {
   "primary": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of every measured text node"
    }
   },
   "muted": {
    "$value": "{color.greyDark}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of muted text"
    }
   },
   "disabled": {
    "$value": "{color.grey}",
    "$type": "color",
    "$extensions": {
     "source": "computed color of add-to-cart default (disabled CTA)"
    }
   },
   "onDark": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "text on inverted fills"
    }
   }
  },
  "action": {
   "primary": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "the dark fill state of purchase buttons; this capture's add-to-cart showed the disabled white-with-grey state"
    }
   },
   "primaryText": {
    "$value": "{color.white}",
    "$type": "color",
    "$extensions": {
     "source": "text on the black button fill"
    }
   },
   "disabled": {
    "$value": "{color.grey}",
    "$type": "color",
    "$extensions": {
     "source": "computed color/borderTopColor of add-to-cart default"
    }
   }
  },
  "border": {
   "default": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor where edges show"
    }
   },
   "soft": {
    "$value": "{color.grey}",
    "$type": "color",
    "$extensions": {
     "source": "computed borderTopColor of disabled controls / hairlines"
    }
   }
  },
  "focus": {
   "ring": {
    "$value": "{color.black}",
    "$type": "color",
    "$extensions": {
     "source": "computed outlineColor on focused controls"
    }
   }
  }
 },
 "$themes": [
  {
   "id": "light",
   "name": "Light",
   "selectedTokenSets": {
    "core": "source",
    "light": "enabled"
   },
   "$description": "The only theme adidas.com.cn paints. There is no dark or high-contrast variant; every measurement was taken on the single light scheme."
  }
 ],
 "$metadata": {
  "tokenSetOrder": [
   "core",
   "light"
  ]
 }
}
