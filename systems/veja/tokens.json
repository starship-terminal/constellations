{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#212529",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(33, 37, 41) on https://www.veja-store.com/en_us/ 2026-11-22" }
      },
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed nav link color and Add to cart background rgb(0, 0, 0)" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed body and header background rgb(255, 255, 255)" }
      },
      "promo": {
        "$value": "#4d4d4d",
        "$type": "color",
        "$extensions": { "source": "computed .preheader-push__message background rgb(77, 77, 77)" }
      },
      "on-promo": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "painted promo label, white on #4d4d4d" }
      },
      "gift": {
        "$value": "#065a21",
        "$type": "color",
        "$extensions": { "source": "inline style color #065a21 on the Gift card nav link" }
      },
      "muted": {
        "$value": "#888888",
        "$type": "color",
        "$extensions": { "source": "computed Subscribe button color rgb(136, 136, 136)" }
      },
      "on-accent": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Add to cart label rgb(255, 255, 255)" }
      }
    },
    "font": {
      "ui": {
        "$value": "Helvetica, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily" }
      }
    },
    "typography": {
      "title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "30px", "fontWeight": 700, "lineHeight": "36px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1, uppercase" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "25px", "fontWeight": 400, "lineHeight": "29px" },
        "$type": "typography",
        "$extensions": { "source": "computed product .current price, 25px" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "20.7px" },
        "$type": "typography",
        "$extensions": { "source": "computed Add to cart, uppercase" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "18.4px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "16.1px" },
        "$type": "typography",
        "$extensions": { "source": "computed nav link, uppercase" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "11px", "fontWeight": 400, "lineHeight": "13.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed breadcrumb h1 MEN, 11px uppercase" }
      }
    },
    "radius": {
      "control": {
        "$value": "5px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to cart, size chip, and Filters border-radius" }
      }
    },
    "spacing": {
      "promo": {
        "$value": "38px",
        "$type": "dimension",
        "$extensions": { "source": ".header__push height" }
      },
      "header": {
        "$value": "134px",
        "$type": "dimension",
        "$extensions": { "source": "header height, promo plus nav row" }
      },
      "nav": {
        "$value": "26px",
        "$type": "dimension",
        "$extensions": { "source": "department row height" }
      },
      "logo": {
        "$value": "65px",
        "$type": "dimension",
        "$extensions": { "source": "header logo box" }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "alias" } },
      "text": { "$value": "{core.color.ink}", "$type": "color", "$extensions": { "source": "alias" } },
      "muted": { "$value": "{core.color.muted}", "$type": "color", "$extensions": { "source": "Subscribe ink" } },
      "accent": { "$value": "{core.color.black}", "$type": "color", "$extensions": { "source": "Add to cart face" } },
      "border": { "$value": "{core.color.black}", "$type": "color", "$extensions": { "source": "header border and size chip border" } },
      "surface": { "$value": "{core.color.page}", "$type": "color", "$extensions": { "source": "header and page are the same white" } },
      "on-accent": { "$value": "{core.color.on-accent}", "$type": "color", "$extensions": { "source": "alias" } }
    },
    "component": {
      "button": {
        "primary": {
          "bg": { "$value": "{core.color.black}", "$type": "color", "$extensions": { "source": "Add to cart" } },
          "text": { "$value": "{core.color.on-accent}", "$type": "color", "$extensions": { "source": "Add to cart" } },
          "radius": { "$value": "{core.radius.control}", "$type": "dimension", "$extensions": { "source": "alias" } },
          "height": { "$value": "40px", "$type": "dimension", "$extensions": { "source": "Add to cart height" } }
        }
      }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "source", "light": "enabled" } }
  ]
}
