{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "ink": { "$value": "#191918", "$type": "color", "$extensions": { "source": "css-var --tatami-color-gray-900 #191918, computed primary button fill rgb(25, 25, 24)" } },
      "paper": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed body backgroundColor rgb(255, 255, 255) on /product/calendar" } },
      "ink-text": { "$value": "#000000f2", "$type": "color", "$extensions": { "source": "computed body color rgba(0, 0, 0, 0.95)" } },
      "heading": { "$value": "#000000e5", "$type": "color", "$extensions": { "source": "computed h1 color rgba(0, 0, 0, 0.898)" } },
      "on-accent": { "$value": "#ffffff", "$type": "color", "$extensions": { "source": "computed color on Get Notion Calendar free" } },
      "blue": { "$value": "#097fe8", "$type": "color", "$extensions": { "source": "css-var --tatami-color-blue-500 #097fe8" } },
      "gray-100": { "$value": "#f9f9f8", "$type": "color", "$extensions": { "source": "css-var --tatami-color-gray-100" } },
      "gray-300": { "$value": "#dfdcd9", "$type": "color", "$extensions": { "source": "css-var --tatami-color-gray-300" } },
      "gray-500": { "$value": "#78736f", "$type": "color", "$extensions": { "source": "css-var --tatami-color-gray-500" } }
    },
    "font": {
      "family": {
        "ui": { "$value": "NotionInter, Inter, -apple-system, system-ui, sans-serif", "$type": "fontFamily", "$extensions": { "source": "computed body and h1 fontFamily on /product/calendar" } }
      }
    },
    "radius": {
      "500": { "$value": "8px", "$type": "dimension", "$extensions": { "source": "css-var --tatami-border-radius-500 .5rem, computed primary button borderRadius 8px" } },
      "200": { "$value": "4px", "$type": "dimension", "$extensions": { "source": "css-var --tatami-border-radius-200 .25rem" } }
    },
    "typography": {
      "display": { "$value": { "fontFamily": "NotionInter, Inter, sans-serif", "fontSize": "64px", "fontWeight": "700", "lineHeight": "64px" }, "$type": "typography", "$extensions": { "source": "computed h1 on /product/calendar at 1440" } },
      "body": { "$value": { "fontFamily": "NotionInter, Inter, sans-serif", "fontSize": "16px" }, "$type": "typography", "$extensions": { "source": "computed body on /product/calendar" } }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.paper}", "$type": "color" },
      "text": { "$value": "{core.color.ink-text}", "$type": "color" },
      "accent": { "$value": "{core.color.ink}", "$type": "color" },
      "on-accent": { "$value": "{core.color.on-accent}", "$type": "color" },
      "link": { "$value": "{core.color.blue}", "$type": "color" }
    }
  }
}
