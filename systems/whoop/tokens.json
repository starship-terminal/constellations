{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.whoop.com/sg/en/ 2026-11-22."
        }
      },
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured. header backgroundColor rgb(0, 0, 0). html background is the same black. Join now text is the same ink."
        }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured. nav label, promo text, and hero headline color rgb(255, 255, 255). Join now fill is the same white."
        }
      },
      "steel": {
        "$value": "#3b526c",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Promo bar, Gift WHOOP, and Cyber Sale share linear-gradient(90deg, rgb(59, 82, 108), rgb(92, 127, 168)). Start stop."
        }
      },
      "steel-end": {
        "$value": "#5c7fa8",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Same gradient, end stop rgb(92, 127, 168)."
        }
      },
      "compare": {
        "$value": "#808080",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Struck membership price S$349 color rgb(128, 128, 128) on https://www.whoop.com/sg/en/peak/."
        }
      },
      "card": {
        "$value": "#f3f5f9",
        "$type": "color",
        "$extensions": {
          "source": "Measured. Homepage carousel card backgroundColor rgb(243, 245, 249)."
        }
      }
    },
    "font": {
      "body": {
        "$value": "proxima-nova, \"Readex Pro\", Arial, Helvetica, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured. body, nav, promo, hero, and buttons. Font files are not in this package."
        }
      }
    },
    "radius": {
      "join": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. JOIN NOW border-radius 16px. Gift WHOOP is the same 16px."
        }
      },
      "cyber": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. CYBER SALE badge border-radius 8px. START WITH PEAK is 8px."
        }
      },
      "card": {
        "$value": "30px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Homepage carousel card border-radius 30px."
        }
      }
    },
    "size": {
      "promo": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Promo bar height 50px, full 1440 width."
        }
      },
      "header": {
        "$value": "122px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. header height 122px, including the 50px promo."
        }
      },
      "gift": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Gift WHOOP control height 40px, width 181px."
        }
      },
      "join": {
        "$value": "61px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. JOIN NOW height 61px, width 171px."
        }
      },
      "display": {
        "$value": "96px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured. Hero headline font-size 96px, line-height 106.56px, letter-spacing -3.6px."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "{core.color.page}",
        "$type": "color"
      },
      "ink": {
        "$value": "{core.color.ink}",
        "$type": "color"
      },
      "on-ink": {
        "$value": "{core.color.on-ink}",
        "$type": "color"
      },
      "steel": {
        "$value": "{core.color.steel}",
        "$type": "color"
      },
      "steel-end": {
        "$value": "{core.color.steel-end}",
        "$type": "color"
      },
      "compare": {
        "$value": "{core.color.compare}",
        "$type": "color"
      },
      "card": {
        "$value": "{core.color.card}",
        "$type": "color"
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
