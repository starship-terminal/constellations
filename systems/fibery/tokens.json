{
  "core": {
    "palette": {
      "ink": {
        "$value": "#251d1a",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-black"
        },
        "$description": "Page text and the filled signup button"
      },
      "soup": {
        "$value": "#faebd6",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-soup"
        },
        "$description": "Page background"
      },
      "cream": {
        "$value": "#fdf7ef",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-cream"
        },
        "$description": "Quiet button and light page wash"
      },
      "milk": {
        "$value": "#fffdfa",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-milk"
        },
        "$description": "Text on the filled button, and the login control face"
      },
      "menu": {
        "$value": "#fff5e8",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-menu-bg-color"
        }
      },
      "peach-soup": {
        "$value": "#eed0bf",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-peach-soup"
        }
      },
      "tea": {
        "$value": "#f6d3a0",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-tea"
        }
      },
      "rusty": {
        "$value": "#c17b58",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-rusty"
        }
      },
      "terracotta": {
        "$value": "#e89469",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-terracotta"
        }
      },
      "architect-rust": {
        "$value": "#cb5800",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-architect-rust"
        }
      },
      "website-blue": {
        "$value": "#3b758c",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-website-blue"
        },
        "$description": "Named page accent; also the form-button blue"
      },
      "mint": {
        "$value": "#309fb6",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-mint"
        }
      },
      "green": {
        "$value": "#66753d",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-green"
        }
      },
      "red": {
        "$value": "#d74242",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-red"
        }
      },
      "yellow": {
        "$value": "#fc9f28",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-yellow"
        }
      },
      "blue": {
        "$value": "#5171a2",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-blue"
        }
      },
      "pink": {
        "$value": "#cd5872",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-pink"
        }
      },
      "orange": {
        "$value": "#d27133",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-orange"
        }
      },
      "violet": {
        "$value": "#916fbe",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-violet"
        }
      },
      "chat-accent": {
        "$value": "#bd5f00",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --chat-accent"
        }
      },
      "focus": {
        "$value": "rgb(0, 95, 204)",
        "$type": "color",
        "$extensions": {
          "source": "computed outline on the first Tab stop, https://fibery.com/ 2026-11-21; browser default, not a product token"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "Suisse Intl, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body, https://fibery.com/ 2026-11-21"
          }
        }
      }
    },
    "typography": {
      "display": {
        "fontFamily": "{core.font.family.sans}",
        "fontSize": "64px",
        "fontWeight": "800",
        "lineHeight": "64px",
        "$type": "typography",
        "$extensions": {
          "source": "computed h1, https://fibery.com/"
        }
      },
      "heading": {
        "fontFamily": "{core.font.family.sans}",
        "fontSize": "48px",
        "fontWeight": "800",
        "lineHeight": "48px",
        "$type": "typography",
        "$extensions": {
          "source": "computed h2, https://fibery.com/"
        }
      },
      "title": {
        "fontFamily": "{core.font.family.sans}",
        "fontSize": "36px",
        "fontWeight": "700",
        "lineHeight": "36px",
        "$type": "typography",
        "$extensions": {
          "source": "computed h3, https://fibery.com/"
        }
      },
      "body": {
        "fontFamily": "{core.font.family.sans}",
        "fontSize": "16px",
        "fontWeight": "400",
        "lineHeight": "19.2px",
        "$type": "typography",
        "$extensions": {
          "source": "computed body, https://fibery.com/"
        }
      },
      "button": {
        "fontFamily": "{core.font.family.sans}",
        "fontSize": "16px",
        "fontWeight": "600",
        "lineHeight": "40px",
        "$type": "typography",
        "$extensions": {
          "source": "computed header a[href=/sign-up]"
        }
      }
    },
    "radius": {
      "control": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on header signup link"
        }
      },
      "pill": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on TabPillButton"
        }
      },
      "composer": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --chat-composer-radius"
        }
      }
    },
    "space": {
      "control-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on header signup link"
        }
      },
      "control-y": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-block on header signup link"
        }
      },
      "login-x": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on Continue with Email, https://fibery.io/login"
        }
      },
      "login-y": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-block on Continue with Email"
        }
      },
      "pill-x": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-inline on TabPillButton"
        }
      },
      "pill-y": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding-block on TabPillButton"
        }
      },
      "header": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed padding on header"
        }
      }
    },
    "size": {
      "button": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of header signup link"
        }
      },
      "login-button": {
        "$value": "36px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of Continue with Email"
        }
      },
      "pill": {
        "$value": "34px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of TabPillButton"
        }
      },
      "header": {
        "$value": "88px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of header at 1440"
        }
      }
    },
    "shadow": {
      "m": {
        "$value": "0 10px 16px -3px rgba(20,21,26,.08),0 1px 2px 0 rgba(20,21,26,.05)",
        "$type": "shadow",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-shadow-m"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$value": "{core.palette.soup}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-page-body-color matches --fibery-soup"
        }
      },
      "surface": {
        "$value": "{core.palette.cream}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-page-body-color-light matches --fibery-cream"
        }
      },
      "menu": {
        "$value": "{core.palette.menu}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-menu-bg-color"
        }
      },
      "action": {
        "$value": "{core.palette.ink}",
        "$type": "color",
        "$extensions": {
          "source": "computed background of header a[href=/sign-up]"
        }
      },
      "quiet": {
        "$value": "{core.palette.cream}",
        "$type": "color",
        "$extensions": {
          "source": "computed background of header a[href=/login]"
        }
      },
      "pill": {
        "$value": "rgb(240, 215, 200)",
        "$type": "color",
        "$extensions": {
          "source": "computed background of TabPillButton; no matching custom property"
        }
      }
    },
    "text": {
      "primary": {
        "$value": "{core.palette.ink}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-text-default-color"
        }
      },
      "on-action": {
        "$value": "{core.palette.soup}",
        "$type": "color",
        "$extensions": {
          "source": "computed color of header signup link; matches page soup"
        }
      },
      "opposite": {
        "$value": "{core.palette.milk}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-text-opposite-color"
        }
      },
      "secondary": {
        "$value": "color-mix(in oklab,#251d1a 50%,transparent 50%)",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-text-secondary-color"
        }
      },
      "muted": {
        "$value": "#9f8b7f",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-mud-text"
        }
      }
    },
    "border": {
      "default": {
        "$value": "color-mix(in oklab,#251d1a 10%,transparent 90%)",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-light-gray-border-color"
        }
      },
      "strong": {
        "$value": "{core.palette.ink}",
        "$type": "color",
        "$extensions": {
          "source": "computed text colour used as the hairline on ink controls"
        }
      }
    },
    "accent": {
      "default": {
        "$value": "{core.palette.website-blue}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-page-main-color and --fibery-website-blue"
        }
      }
    },
    "status": {
      "danger": {
        "$value": "{core.palette.red}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-red"
        }
      },
      "warning": {
        "$value": "{core.palette.yellow}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-yellow"
        }
      },
      "success": {
        "$value": "{core.palette.green}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-green"
        }
      },
      "info": {
        "$value": "{core.palette.mint}",
        "$type": "color",
        "$extensions": {
          "source": "css-var on https://fibery.com/ 2026-11-21; --fibery-basic-mint"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{core.palette.focus}",
        "$type": "color",
        "$extensions": {
          "source": "computed outline on first Tab stop; browser default"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
