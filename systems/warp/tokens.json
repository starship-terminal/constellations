{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$value": "azeretSemiMono, \"azeretSemiMono Fallback\", \"Azeret SemiMono\", ui-monospace, monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on the homepage h1"
          }
        },
        "body": {
          "$value": "Matter, system-ui, sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on body"
          }
        },
        "ui": {
          "$value": "azeretSemiMono, \"azeretSemiMono Fallback\", \"Azeret SemiMono\", ui-monospace, monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed font-family on the Products nav button"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "54px",
          "fontWeight": "400",
          "lineHeight": "63.72px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the homepage h1 at 1440"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{core.font.family.body}",
          "fontSize": "16px",
          "lineHeight": "24px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on body"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{core.font.family.ui}",
          "fontSize": "12px",
          "fontWeight": "500",
          "lineHeight": "16.8px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed style on the Products nav button"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on request early access"
        }
      },
      "pill": {
        "$value": "999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed border-radius on Book a demo"
        }
      }
    },
    "space": {
      "button-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed horizontal padding on request early access"
        }
      },
      "button-y": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed vertical padding on request early access"
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$value": "rgb(254, 253, 254)",
        "$type": "color",
        "$extensions": {
          "source": "sampled homepage page fill before quantize; html background is oklch(0.992495 0.00178735 220)"
        }
      },
      "ink": {
        "$value": "rgb(26, 21, 34)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the homepage h1"
        }
      },
      "muted": {
        "$value": "rgba(26, 21, 34, 0.7)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on the homepage lede"
        }
      },
      "nav": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on the primary nav"
        }
      },
      "cta": {
        "$value": "rgb(26, 21, 34)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on request early access"
        }
      },
      "on-cta": {
        "$value": "rgb(255, 255, 255)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on request early access"
        }
      },
      "demo": {
        "$value": "rgb(237, 248, 114)",
        "$type": "color",
        "$extensions": {
          "source": "computed background on Book a demo"
        }
      },
      "on-demo": {
        "$value": "rgb(0, 0, 0)",
        "$type": "color",
        "$extensions": {
          "source": "computed color on Book a demo"
        }
      },
      "banner": {
        "$value": "rgb(8, 9, 10)",
        "$type": "color",
        "$extensions": {
          "source": "sampled top announcement bar before quantize"
        }
      },
      "accent-declared": {
        "$value": "#00c2ff",
        "$type": "color",
        "$extensions": {
          "source": "declared --color-theme-accent, not the painted demo pill"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "enabled",
        "light": "enabled"
      }
    }
  ]
}
