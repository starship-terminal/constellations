    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "MoMA Sans, Helvetica, sans-serif",
          "$extensions": {
            "source": "Derived. computed font-family on body: \"MoMA Sans\", \"MoMA Sans\", Helvetica, sans-serif. @font-face src is /dist/dist/moma-sans/*.woff2. Proprietary. Token stack drops the duplicate family name."
          }
        },
        "sans-condensed": {
          "$type": "fontFamily",
          "$value": "MoMA Sans Condensed, Helvetica, sans-serif",
          "$extensions": {
            "source": "Measured. @font-face in sol.css. Not the computed body family on the captured pages."
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "60px",
          "fontWeight": 900,
          "lineHeight": "60px",
          "letterSpacing": "-1.2px"
        },
        "$extensions": {
          "source": "Measured. h1 Welcome, class $typography/size:extra-extra-large, computed 1440px"
        }
      },
      "title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "40px",
          "fontWeight": 900,
          "lineHeight": "40px",
          "letterSpacing": "-0.8px"
        },
        "$extensions": {
          "source": "Measured. h2 Exhibitions, class $typography/size:extra-large, computed"
        }
      },
      "card-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "30px",
          "fontWeight": 900,
          "lineHeight": "30px",
          "letterSpacing": "-0.6px"
        },
        "$extensions": {
          "source": "Measured. exhibition card title, class $typography/size:medium-large, computed"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "18px",
          "letterSpacing": "normal"
        },
        "$extensions": {
          "source": "Measured. body copy 'The museum is open', weight 400, computed"
        }
      },
      "ui": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "18px",
          "letterSpacing": "normal"
        },
        "$extensions": {
          "source": "Measured. $typography/size:medium is --typography--size 16 times 0.1rem; line-height measured 18px on truncated card text"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "13.333px",
          "fontWeight": 400,
          "lineHeight": "normal",
          "letterSpacing": "normal"
        },
        "$extensions": {
          "source": "Measured. Visit button, computed font-size 13.3333px, weight 400"
        }
      },
      "chrome": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "10px",
          "fontWeight": 400,
          "lineHeight": "10px",
          "letterSpacing": "normal"
        },
        "$extensions": {
          "source": "Measured. Tickets and Donate links, computed 10px. Matches html font-size from --typography--size 10"
        }
      }
    },
    "spacing": {
      "page": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "source": "Measured. computed --page-spacing 3.2rem at 10px root on www.moma.org 1440px"
        }
      },
      "page-fixed": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Measured. computed --page-spacing--fixed 4.8rem at 10px root"
        }
      },
      "header": {
        "$type": "dimension",
        "$value": "166px",
        "$extensions": {
          "source": "Measured. computed --header-height 16.6rem and header.getBoundingClientRect().height 166"
        }
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Measured. --focus-thickness 0.2rem"
        }
      },
      "control-pad": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": {
          "source": "Measured. computed padding 8px on Visit, Tickets, Donate"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "Measured. computed border-radius 0px on header, cards, Tickets, Donate, Join"
        }
      },
      "focus": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Measured. --focus-radius 0.4rem"
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": "Reconstruction. A stand-in for a full pill: the Help chip on the login card is one. No radius was read for it."
        }
      }
    },
    "motion": {
      "duration": {
        "100": {
          "$type": "duration",
          "$value": "100ms",
          "$extensions": {
            "source": "Measured. sol.css --motion--transition--duration 100ms"
          }
        },
        "200": {
          "$type": "duration",
          "$value": "200ms",
          "$extensions": {
            "source": "Measured. sol.css --motion--transition--color--duration 200ms"
          }
        },
        "4000": {
          "$type": "duration",
          "$value": "4000ms",
          "$extensions": {
            "source": "Measured. sol.css --motion--animation--duration 4000ms"
          }
        }
      },
      "easing": {
        "in": {
          "$type": "cubicBezier",
          "$value": [
            0.42,
            0,
            1,
            1
          ],
          "$extensions": {
            "source": "Derived. --motion--transition--curve ease-in expanded to control points."
          }
        },
        "in-out": {
          "$type": "cubicBezier",
          "$value": [
            0.42,
            0,
            0.58,
            1
          ],
          "$extensions": {
            "source": "Derived. --motion--transition--transform--curve ease-in-out."
          }
        }
      }
    }
  },
