{
  "core": {
    "color": {
      "blue": {
        "$type": "color",
        "$value": "#0067e5",
        "$extensions": {
          "source": "measured button.tocart backgroundColor on shop.dopper.com/dopper-original-pacific-blue, 2026-11-21"
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#000f2e",
        "$extensions": {
          "source": "measured body color on shop.dopper.com, 2026-11-21"
        }
      },
      "paper": {
        "$type": "color",
        "$value": "#fcfaf2",
        "$extensions": {
          "source": "measured body backgroundColor on www.dopper.com and shop.dopper.com; meta theme-color #fcfaf2"
        }
      },
      "cream": {
        "$type": "color",
        "$value": "#f6ecc8",
        "$extensions": {
          "source": "measured h1 color on www.dopper.com hero, 2026-11-21"
        }
      },
      "cream-deep": {
        "$type": "color",
        "$value": "#f9f3df",
        "$extensions": {
          "source": "measured dopper-navigation button.nav-link color (cream on blue hero) and button.tocart text color"
        }
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "measured body color on www.dopper.com, 2026-11-21"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#0abeaa",
        "$extensions": {
          "source": "sampled Filters pill fill (10, 190, 170) from shop-bottles-light-filters.png before quantize; no CSS custom property"
        }
      },
      "focus-ring": {
        "$type": "color",
        "$value": "#000f2e",
        "$extensions": {
          "source": "measured button.tocart :focus-visible outline color, 2026-11-21"
        }
      },
      "focus-gap": {
        "$type": "color",
        "$value": "#fcfaf2",
        "$extensions": {
          "source": "measured button.tocart :focus-visible box-shadow color, 2026-11-21"
        }
      }
    },
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "Dopper, Georgia, serif",
        "$extensions": {
          "source": "document.fonts family Dopper on www.dopper.com h1"
        }
      },
      "sans": {
        "$type": "fontFamily",
        "$value": "Gilroy, sans-serif",
        "$extensions": {
          "source": "computed fontFamily on shop body and dopper-navigation button.nav-link"
        }
      }
    },
    "fontSize": {
      "hero": {
        "$type": "dimension",
        "$value": "72px",
        "$extensions": {
          "source": "measured h1 fontSize on www.dopper.com"
        }
      },
      "story": {
        "$type": "dimension",
        "$value": "58px",
        "$extensions": {
          "source": "measured h1 fontSize on www.dopper.com/en/mission/story"
        }
      },
      "shop-body": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "measured body fontSize on shop.dopper.com"
        }
      },
      "nav": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "measured dopper-navigation button.nav-link fontSize"
        }
      },
      "price": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "measured .price fontSize on product page"
        }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400,
        "$extensions": {
          "source": "measured body and h1 fontWeight"
        }
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600,
        "$extensions": {
          "source": "measured a.level-top and button.tocart fontWeight"
        }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$extensions": {
          "source": "measured dopper-navigation button.nav-link fontWeight"
        }
      }
    },
    "lineHeight": {
      "hero": {
        "$type": "dimension",
        "$value": "72px",
        "$extensions": {
          "source": "measured h1 lineHeight on www.dopper.com"
        }
      },
      "shop-body": {
        "$type": "dimension",
        "$value": "26px",
        "$extensions": {
          "source": "measured body lineHeight on shop.dopper.com"
        }
      },
      "nav": {
        "$type": "dimension",
        "$value": "25px",
        "$extensions": {
          "source": "measured a.level-top lineHeight"
        }
      }
    },
    "radius": {
      "button": {
        "$type": "dimension",
        "$value": "20px",
        "$extensions": {
          "source": "measured button.tocart borderTopLeftRadius"
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": "observed shop Filters control and cart icon; exact radius not read from CSS"
        }
      }
    },
    "size": {
      "button-height": {
        "$type": "dimension",
        "$value": "54px",
        "$extensions": {
          "source": "measured button.tocart height"
        }
      },
      "header": {
        "$type": "dimension",
        "$value": "110px",
        "$extensions": {
          "source": "measured .page-header height on shop.dopper.com and dopper-nav height in shadow CSS"
        }
      },
      "nav-link": {
        "$type": "dimension",
        "$value": "25px",
        "$extensions": {
          "source": "measured a.level-top height"
        }
      }
    },
    "space": {
      "button-x": {
        "$type": "dimension",
        "$value": "25px",
        "$extensions": {
          "source": "measured button.tocart paddingLeft"
        }
      },
      "button-y": {
        "$type": "dimension",
        "$value": "13px",
        "$extensions": {
          "source": "measured button.tocart paddingTop"
        }
      }
    },
    "border": {
      "hairline": {
        "$type": "dimension",
        "$value": "1px",
        "$extensions": {
          "source": "measured button.tocart borderTopWidth"
        }
      },
      "focus": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "measured button.tocart :focus-visible outline 2px"
        }
      }
    },
    "focus": {
      "offset": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "measured button.tocart :focus-visible box-shadow 0 0 0 4px"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{color.paper}",
        "$extensions": {
          "source": "alias of measured page background"
        }
      },
      "surface": {
        "$type": "color",
        "$value": "{color.paper}",
        "$extensions": {
          "source": "alias of measured page background"
        }
      },
      "hero": {
        "$type": "color",
        "$value": "{color.blue}",
        "$extensions": {
          "source": "alias of measured accent; hero field is a photograph on blue"
        }
      },
      "raised": {
        "$type": "color",
        "$value": "#cce2ff",
        "$extensions": {
          "source": "sampled filter sheet ground (204, 226, 255) on shop-bottles-light-filters.png before quantize"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{color.ink}",
        "$extensions": {
          "source": "alias of measured shop body color"
        }
      },
      "on-hero": {
        "$type": "color",
        "$value": "{color.cream}",
        "$extensions": {
          "source": "alias of measured hero h1 color"
        }
      },
      "on-accent": {
        "$type": "color",
        "$value": "{color.cream-deep}",
        "$extensions": {
          "source": "alias of measured add-to-cart text"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{color.blue}",
        "$extensions": {
          "source": "alias of measured a.level-top color"
        }
      }
    },
    "action": {
      "primary": {
        "$type": "color",
        "$value": "{color.blue}",
        "$extensions": {
          "source": "alias of measured button.tocart background"
        }
      },
      "ink": {
        "$type": "color",
        "$value": "{color.black}",
        "$extensions": {
          "source": "alias of measured marketing primary button fill, observed on home hero"
        }
      }
    },
    "border": {
      "focus": {
        "$type": "color",
        "$value": "{color.focus-ring}",
        "$extensions": {
          "source": "alias of measured focus outline"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
