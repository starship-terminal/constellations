{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "color": {
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "Named --colors-black, and computed body color rgb(0, 0, 0) on https://www.stradivarius.com/us/, 2026-11-22."
        }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Named --colors-white. Page sections sit on white. FILTERS button text computed rgb(255, 255, 255)."
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#1d1d1d",
        "$extensions": {
          "source": "Product h1 SHORT NECKLINE DRESS computed color rgb(29, 29, 29) on https://www.stradivarius.com/us/short-neckline-dress-l06306325. Close to --colors-grey-dark #151515, not the same."
        }
      },
      "grey-dark": {
        "$type": "color",
        "$value": "#151515",
        "$extensions": {
          "source": "Named --colors-grey-dark on the US storefront stylesheets, 2026-11-22."
        }
      },
      "grey-dim": {
        "$type": "color",
        "$value": "#707070",
        "$extensions": {
          "source": "Named --colors-grey-dim. Used as secondary text."
        }
      },
      "grey-medium": {
        "$type": "color",
        "$value": "#c4c4c4",
        "$extensions": {
          "source": "Named --colors-grey-medium."
        }
      },
      "grey-light": {
        "$type": "color",
        "$value": "#e7e7e7",
        "$extensions": {
          "source": "Named --colors-grey-light. Used as a divider."
        }
      },
      "grey-clear": {
        "$type": "color",
        "$value": "#f5f5f5",
        "$extensions": {
          "source": "Named --colors-grey-clear. Search pill background uses rgba(245, 245, 245, 0.3), the same grey at 30%."
        }
      },
      "grey-photo": {
        "$type": "color",
        "$value": "#ebebeb",
        "$extensions": {
          "source": "Named --colors-grey-photo #EBEBEB."
        }
      },
      "red-dark": {
        "$type": "color",
        "$value": "#d0024c",
        "$extensions": {
          "source": "Named --colors-red-dark. Special prices in the menu are this red. Sales price alias."
        }
      },
      "red-clear": {
        "$type": "color",
        "$value": "#ffebf2",
        "$extensions": {
          "source": "Named --colors-red-clear."
        }
      },
      "blue-dark": {
        "$type": "color",
        "$value": "#1879bf",
        "$extensions": {
          "source": "Named --colors-blue-dark."
        }
      },
      "green-dark": {
        "$type": "color",
        "$value": "#008020",
        "$extensions": {
          "source": "Named --colors-green-dark."
        }
      },
      "search": {
        "$type": "color",
        "$value": "#333333",
        "$extensions": {
          "source": "Search pill computed color rgb(51, 51, 51) on the US homepage."
        }
      },
      "inditex": {
        "$type": "color",
        "$value": "#171d2d",
        "$extensions": {
          "source": "Named --indmaincolor on the storefront stylesheets."
        }
      }
    },
    "font": {
      "family": {
        "web": {
          "$type": "fontFamily",
          "$value": "\"STRADIVARIUS WEB 2025\", sans-serif",
          "$extensions": {
            "source": "Computed font-family on body, category h1, and product h1. Loaded as STRADIVARIUSWEB2025-Bold.otf. Files are not in this package."
          }
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400",
        "$extensions": {
          "source": "Body computed font-weight 400. Category h1 and FILTERS button also 400."
        }
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "600",
        "$extensions": {
          "source": "Menu NEW IN, category price, product h1, and product price computed font-weight 600."
        }
      }
    },
    "size": {
      "body": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "source": "Body computed font-size 10px on the US storefront."
        }
      },
      "menu-index": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "Menu number 01 computed 12px."
        }
      },
      "tile-price": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "Category tile price $89.90 computed 12px."
        }
      },
      "size-chip": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "Product size chip XS computed 14px."
        }
      },
      "menu": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Menu label NEW IN computed 16px. FILTERS button computed 16px."
        }
      },
      "product-price": {
        "$type": "dimension",
        "$value": "22px",
        "$extensions": {
          "source": "Product price $45.90 computed 22px."
        }
      },
      "product-title": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "source": "Product h1 computed 28px, line-height 38px."
        }
      },
      "category-title": {
        "$type": "dimension",
        "$value": "32px",
        "$extensions": {
          "source": "Category h1 Dresses computed 32px, line-height 44px."
        }
      }
    },
    "radius": {
      "filters": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "FILTERS button computed border-radius 2px."
        }
      },
      "square": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": "Named corner-radius-square 4px. Search pill computed border-radius 4px."
        }
      },
      "rounded": {
        "$type": "dimension",
        "$value": "80px",
        "$extensions": {
          "source": "Named corner-radius-rounded 80px."
        }
      }
    },
    "spacing": {
      "s0": { "$type": "dimension", "$value": "0px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s2": { "$type": "dimension", "$value": "2px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s4": { "$type": "dimension", "$value": "4px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s8": { "$type": "dimension", "$value": "8px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s16": { "$type": "dimension", "$value": "16px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s24": { "$type": "dimension", "$value": "24px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s32": { "$type": "dimension", "$value": "32px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s40": { "$type": "dimension", "$value": "40px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s48": { "$type": "dimension", "$value": "48px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s56": { "$type": "dimension", "$value": "56px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } },
      "s64": { "$type": "dimension", "$value": "64px", "$extensions": { "source": "Named --numbers-pixels scale on the storefront." } }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": { "source": "Semantic page background alias --colors-white." }
        },
        "card": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": { "source": "Semantic card background alias --colors-white." }
        },
        "overlay": {
          "$type": "color",
          "$value": "#0000004d",
          "$extensions": { "source": "Named --colors-alpha-dark rgba(0, 0, 0, 0.30196), written as #0000004d." }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{core.color.black}",
          "$extensions": { "source": "Body and prices computed rgb(0, 0, 0)." }
        },
        "product": {
          "$type": "color",
          "$value": "{core.color.ink}",
          "$extensions": { "source": "Product title computed rgb(29, 29, 29)." }
        },
        "secondary": {
          "$type": "color",
          "$value": "{core.color.grey-dim}",
          "$extensions": { "source": "Semantic secondary text alias --colors-grey-dim." }
        },
        "sale": {
          "$type": "color",
          "$value": "{core.color.red-dark}",
          "$extensions": { "source": "Semantic sales price alias --colors-red-dark." }
        }
      },
      "border": {
        "divider": {
          "$type": "color",
          "$value": "{core.color.grey-light}",
          "$extensions": { "source": "Semantic divider alias --colors-grey-light." }
        }
      },
      "button": {
        "primary-bg": {
          "$type": "color",
          "$value": "{core.color.black}",
          "$extensions": { "source": "FILTERS button computed background rgb(0, 0, 0). Primary button alias is black." }
        },
        "primary-text": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": { "source": "FILTERS button computed color rgb(255, 255, 255)." }
        },
        "secondary-bg": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": { "source": "Semantic secondary button background --colors-white." }
        },
        "secondary-text": {
          "$type": "color",
          "$value": "{core.color.black}",
          "$extensions": { "source": "Semantic secondary button text --colors-black." }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
