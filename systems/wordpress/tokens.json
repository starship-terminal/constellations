{
  "$schema": "https://design-tokens.org/schemas/2025.10/tokens.json",
  "core": {
    "color": {
      "blue": {
        "$type": "color",
        "$value": "#3858e9",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-blue-50",
            "note": "Automattic Studio blue, declared on wordpress.com on 2026-11-22. Get started and login Continue compute to rgb(56, 88, 233), the same value."
          }
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#101517",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-gray-100",
            "note": "Body text on the homepage computed to rgb(16, 21, 23)."
          }
        }
      },
      "gray": {
        "$type": "color",
        "$value": "#646970",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-gray-50"
          }
        }
      },
      "paper": {
        "$type": "color",
        "$value": "#f6f7f7",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-gray-0"
          }
        }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-white"
          }
        }
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-black"
          }
        }
      },
      "green": {
        "$type": "color",
        "$value": "#008a20",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-green-50",
            "note": "Pricing 'up to 58% off' uses this green. Not isolated as a status role."
          }
        }
      },
      "red": {
        "$type": "color",
        "$value": "#d63638",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-red-50",
            "note": "Declared. Not seen on a public control in this pass."
          }
        }
      },
      "yellow": {
        "$type": "color",
        "$value": "#9d6e00",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-yellow-50"
          }
        }
      },
      "pink": {
        "$type": "color",
        "$value": "#c9356e",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--studio-pink-50"
          }
        }
      }
    },
    "font": {
      "ui": {
        "$type": "fontFamily",
        "$value": "inter-variable-web, -apple-system, system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
        "$extensions": {
          "source": {
            "label": "Measured",
            "file": "raw/css-vars.json",
            "name": "--lp-font-stack-default",
            "note": "Computed on the homepage body as inter-variable-web. Login wall computed to the system sans stack, without the Inter name."
          }
        }
      },
      "display": {
        "$type": "fontFamily",
        "$value": "recoleta-web, Georgia, serif",
        "$extensions": {
          "source": {
            "label": "Measured",
            "file": "raw/css-vars.json",
            "name": "--lp-font-stack-brand",
            "note": "Homepage h1 computed to recoleta-web at 80px / 80px, weight 400. Login h1 computed to Recoleta at 44px."
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "SF Mono, Menlo, Consolas, Monaco, monospace",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--lp-font-stack-mono",
            "note": "Declared. Not seen on a public control in this pass."
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--lp-radius",
            "note": "Homepage Get started pill computed to 4px. Login Continue computed to 2px."
          }
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "999px",
        "$extensions": {
          "source": {
            "label": "Declared",
            "file": "raw/css-vars.json",
            "name": "--lp-radius-circular"
          }
        }
      }
    },
    "size": {
      "nav": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "note": "Homepage nav links computed to 64px tall, 13px, weight 500."
          }
        }
      },
      "button": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "note": "Homepage hero Get started computed to 48px tall, 16px, weight 500, padding 11.5px 36px 12.5px. Login Continue computed to 40px."
          }
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "note": "Login email field computed to 40px, 14px, 1px border, 2px radius."
          }
        }
      },
      "display": {
        "$type": "dimension",
        "$value": "80px",
        "$extensions": {
          "source": {
            "label": "Measured",
            "note": "Homepage h1 computed to 80px / 80px. Pricing h1 computed to 72px."
          }
        }
      }
    }
  }
}
