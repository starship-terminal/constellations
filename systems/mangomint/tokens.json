{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "core": {
    "palette": {
      "ink": {
        "$type": "color",
        "$value": "#191e49",
        "$extensions": {
          "source": "Measured: computed color of button.desktopNavbarDropdown (Features) on www.mangomint.com, 1440x900, 2026-11-21"
        }
      },
      "inkSoft": {
        "$type": "color",
        "$value": "#474f7b",
        "$extensions": {
          "source": "Measured: computed color of carousel Slide 2 button on the homepage"
        }
      },
      "cream": {
        "$type": "color",
        "$value": "#fcfafa",
        "$extensions": {
          "source": "Measured: computed background-color of body on www.mangomint.com"
        }
      },
      "creamText": {
        "$type": "color",
        "$value": "#fcfafa",
        "$extensions": {
          "source": "Measured: computed color of the Try it now link (text on the filled button)"
        }
      },
      "magenta": {
        "$type": "color",
        "$value": "#bc269b",
        "$extensions": {
          "source": "Measured: computed background-color of a[href='/trial/'] (Try it now)"
        }
      },
      "magentaPressed": {
        "$type": "color",
        "$value": "#921185",
        "$extensions": {
          "source": "Measured: computed background-color of Try it now under :hover and CSS.forcePseudoState hover+active"
        }
      },
      "footerLink": {
        "$type": "color",
        "$value": "#bec5ff",
        "$extensions": {
          "source": "Measured: computed color of footer a[href='/blog/'] on the pricing page"
        }
      },
      "loginNavy": {
        "$type": "color",
        "$value": "#191e49",
        "$extensions": {
          "source": "Measured: computed background-color of body on app.mangomint.com/login (wall, no credentials entered)"
        }
      },
      "loginField": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.1)",
        "$extensions": {
          "source": "Measured: computed background-color of #login-page-email"
        }
      },
      "loginPlaceholder": {
        "$type": "color",
        "$value": "#afb8ce",
        "$extensions": {
          "source": "Measured: computed color of #login-page-email placeholder text"
        }
      },
      "loginButton": {
        "$type": "color",
        "$value": "#b28eff",
        "$extensions": {
          "source": "Measured: computed background-color of the Log In button"
        }
      },
      "loginButtonHover": {
        "$type": "color",
        "$value": "#c1a5ff",
        "$extensions": {
          "source": "Measured: computed background-color of Log In under :hover"
        }
      },
      "loginInk": {
        "$type": "color",
        "$value": "#191e49",
        "$extensions": {
          "source": "Measured: computed color of the Log In button label"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "tt-commons-pro, sans-serif",
          "$extensions": {
            "source": "Measured: computed font-family of body on www.mangomint.com; @font-face tt-commons-pro weight 100 900 in the page CSS"
          }
        },
        "login": {
          "$type": "fontFamily",
          "$value": "Muli, sans-serif",
          "$extensions": {
            "source": "Measured: computed font-family of body on app.mangomint.com/login"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-pro",
          "fontSize": "54px",
          "fontWeight": 620,
          "lineHeight": "60px"
        },
        "$extensions": {
          "source": "Measured: computed style of h1 on www.mangomint.com",
          "letterSpacing": "-1.62px"
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-pro",
          "fontSize": "16px",
          "fontWeight": 400,
          "lineHeight": "22.4px"
        },
        "$extensions": {
          "source": "Measured: computed style of body on www.mangomint.com"
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-pro",
          "fontSize": "17px",
          "fontWeight": 540,
          "lineHeight": "24px"
        },
        "$extensions": {
          "source": "Measured: computed style of the Features nav button",
          "letterSpacing": "-0.17px"
        }
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-pro",
          "fontSize": "16px",
          "fontWeight": 540,
          "lineHeight": "18px"
        },
        "$extensions": {
          "source": "Measured: computed style of the Try it now link",
          "letterSpacing": "-0.08px"
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-mono",
          "fontSize": "13px",
          "fontWeight": 400,
          "lineHeight": "18.2px"
        },
        "$extensions": {
          "source": "Measured: computed style of the carousel Slide 2 button",
          "letterSpacing": "0.39px"
        }
      },
      "announcement": {
        "$type": "typography",
        "$value": {
          "fontFamily": "tt-commons-pro",
          "fontSize": "14px",
          "fontWeight": 540,
          "lineHeight": "17px"
        },
        "$extensions": {
          "source": "Measured: computed style of the Meet Mira link in the top banner",
          "letterSpacing": "-0.1px"
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "Measured: computed border-radius of the Features nav button"
        }
      },
      "menuItem": {
        "$type": "dimension",
        "$value": "10px",
        "$extensions": {
          "source": "Measured: computed border-radius of a feature-menu link"
        }
      },
      "pill": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Measured: computed border-radius of the Try it now link"
        }
      },
      "login": {
        "$type": "dimension",
        "$value": "5px",
        "$extensions": {
          "source": "Measured: computed border-radius of the Log In button (5px); the email field is 5px 5px 0 0"
        }
      }
    },
    "size": {
      "buttonHeight": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "Measured: bounding-box height of the Try it now link, 1440x900"
        }
      },
      "navItemHeight": {
        "$type": "dimension",
        "$value": "40px",
        "$extensions": {
          "source": "Measured: bounding-box height of the Features nav button"
        }
      },
      "headerHeight": {
        "$type": "dimension",
        "$value": "80px",
        "$extensions": {
          "source": "Measured: bounding-box height of the header logo link (the bar row)"
        }
      },
      "loginFieldHeight": {
        "$type": "dimension",
        "$value": "50px",
        "$extensions": {
          "source": "Measured: bounding-box height of #login-page-email"
        }
      }
    },
    "space": {
      "buttonX": {
        "$type": "dimension",
        "$value": "30px",
        "$extensions": {
          "source": "Measured: computed padding-left of the Try it now link (16px 30px)"
        }
      },
      "buttonY": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "Measured: computed padding-top of the Try it now link"
        }
      }
    },
    "border": {
      "secondary": {
        "$type": "dimension",
        "$value": "2px",
        "$extensions": {
          "source": "Measured: inset box-shadow width of the Book a demo link, rgb(188, 38, 155) 0px 0px 0px 2px inset"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{palette.cream}",
        "$extensions": {
          "source": "Derived: alias of palette.cream, measured on body"
        }
      },
      "banner": {
        "$type": "color",
        "$value": "#191e49",
        "$extensions": {
          "source": "Measured: the top announcement bar paints the same navy as the login body (rgb(25, 30, 73)); read from the login body because the bar element was not isolated"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{palette.ink}",
        "$extensions": {
          "source": "Derived: alias of palette.ink"
        }
      },
      "muted": {
        "$type": "color",
        "$value": "{palette.inkSoft}",
        "$extensions": {
          "source": "Derived: alias of palette.inkSoft, the carousel tab colour"
        }
      },
      "onAccent": {
        "$type": "color",
        "$value": "{palette.creamText}",
        "$extensions": {
          "source": "Derived: alias of palette.creamText"
        }
      },
      "link": {
        "$type": "color",
        "$value": "{palette.magenta}",
        "$extensions": {
          "source": "Derived: alias of palette.magenta; the video-tour button uses this colour for its label"
        }
      },
      "inverse": {
        "$type": "color",
        "$value": "{palette.creamText}",
        "$extensions": {
          "source": "Derived: alias of palette.creamText, text on the navy banner"
        }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "{palette.magenta}",
        "$extensions": {
          "source": "Derived: alias of palette.magenta"
        }
      },
      "hover": {
        "$type": "color",
        "$value": "{palette.magentaPressed}",
        "$extensions": {
          "source": "Derived: alias of palette.magentaPressed"
        }
      }
    },
    "border": {
      "accent": {
        "$type": "color",
        "$value": "{palette.magenta}",
        "$extensions": {
          "source": "Derived: the Book a demo outline is a 2px inset shadow in palette.magenta"
        }
      }
    },
    "component": {
      "button": {
        "bg": {
          "$type": "color",
          "$value": "{palette.magenta}",
          "$extensions": {
            "source": "Derived: Try it now fill"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{palette.creamText}",
          "$extensions": {
            "source": "Derived: Try it now label"
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.pill}",
          "$extensions": {
            "source": "Derived: alias of radius.pill"
          }
        },
        "height": {
          "$type": "dimension",
          "$value": "{size.buttonHeight}",
          "$extensions": {
            "source": "Derived: alias of size.buttonHeight"
          }
        }
      }
    }
  },
  "login": {
    "background": {
      "page": {
        "$type": "color",
        "$value": "{palette.loginNavy}",
        "$extensions": {
          "source": "Derived: alias of palette.loginNavy. This is the login wall, not a theme toggle."
        }
      },
      "field": {
        "$type": "color",
        "$value": "{palette.loginField}",
        "$extensions": {
          "source": "Derived: alias of palette.loginField"
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{palette.loginInk}",
        "$extensions": {
          "source": "Derived: Log In label colour, also close to the login body text rgb(29, 33, 65)"
        }
      },
      "placeholder": {
        "$type": "color",
        "$value": "{palette.loginPlaceholder}",
        "$extensions": {
          "source": "Derived: alias of palette.loginPlaceholder"
        }
      },
      "onPage": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "Measured: computed color of the Forgot password link"
        }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "{palette.loginButton}",
        "$extensions": {
          "source": "Derived: alias of palette.loginButton"
        }
      },
      "hover": {
        "$type": "color",
        "$value": "{palette.loginButtonHover}",
        "$extensions": {
          "source": "Derived: alias of palette.loginButtonHover"
        }
      }
    }
  },
  "$themes": [
    {
      "name": "light",
      "group": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    },
    {
      "name": "login",
      "group": "login",
      "selectedTokenSets": {
        "core": "source",
        "login": "enabled"
      }
    }
  ],
  "$extensions": {
    "notTokenised": [
      "Marketing CSS custom properties are layout helpers (--section-gap, --pill-w, --gradient-color-1..4, --swoosh-stop-*). They are not a colour role system. Listed in raw/css-vars.json. Not promoted to tokens.",
      "pp-editorial-old and geist and tt-commons-mono are declared as @font-face in the page CSS (raw/css-vars.json fonts). No captured element used them as its computed font-family, so they are not type tokens.",
      "Focus ring: keyboard focus on the measured buttons recolours the label or the fill. No outline or box-shadow focus ring was computed. Not tokenised.",
      "Dark theme: the marketing site has color-scheme normal and no theme switch. Not present.",
      "Elevation: measured controls have box-shadow none, except the Book a demo 2px inset outline. No shadow scale.",
      "Motion durations: not isolated per control. Not captured."
    ]
  }
}
