{
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "computed color of nav-link default on overflow.io"
        }
      },
      "paper": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of product-menu default on overflow.io"
        }
      },
      "hero-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "computed color of hero-title default on overflow.io"
        }
      },
      "ink-soft": {
        "$value": "#161637",
        "$type": "color",
        "$extensions": {
          "source": "computed color of menu-link default on overflow.io"
        }
      },
      "link": {
        "$value": "#0085e4",
        "$type": "color",
        "$extensions": {
          "source": "computed color of logo default on overflow.io"
        }
      },
      "link-hover": {
        "$value": "#259aef",
        "$type": "color",
        "$extensions": {
          "source": "computed color of nav-link hover on overflow.io"
        }
      },
      "link-pressed": {
        "$value": "#124b74",
        "$type": "color",
        "$extensions": {
          "source": "computed color of nav-link pressed on overflow.io"
        }
      },
      "muted": {
        "$value": "rgba(0, 0, 0, 0.6)",
        "$type": "color",
        "$extensions": {
          "source": "computed color of blog-card default on overflow.io"
        }
      },
      "grey": {
        "$value": "rgba(240, 240, 242, 0.498)",
        "$type": "color",
        "$extensions": {
          "source": "computed backgroundColor of nav-signin pressed on overflow.io"
        }
      },
      "grey-2": {
        "$value": "#f0f0f2",
        "$type": "color",
        "$extensions": {
          "source": "declared .btn-secondary background-color in public-site-homepage.min.css; the Sign In control computes transparent until :active"
        }
      },
      "hairline": {
        "$value": "#dadce0",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of product-menu default on overflow.io"
        }
      },
      "chip-border": {
        "$value": "#f5f5f7",
        "$type": "color",
        "$extensions": {
          "source": "computed borderTopColor of blog-card default on overflow.io"
        }
      },
      "swiper": {
        "$value": "#007aff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --swiper-theme-color on :root; the only custom property the homepage stylesheet declares. Not painted on the captured controls."
        }
      },
      "theme": {
        "$value": "#232d41",
        "$type": "color",
        "$extensions": {
          "source": "meta name=theme-color on https://overflow.io/"
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "Inter, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of body, read on hero-title"
          }
        },
        "mono": {
          "$value": "SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared font-family in public-site-homepage.min.css; no code specimen was on the captured pages"
          }
        },
        "icons": {
          "$value": "icomoon",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared @font-face icomoon in public-site-homepage.min.css"
          }
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of nav-link default"
          }
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of logo"
          }
        },
        "button": {
          "$value": 550,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-cta .btn-primary"
          }
        },
        "bold": {
          "$value": 700,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of m-nav-item"
          }
        },
        "display": {
          "$value": 800,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-title"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "56px",
          "fontWeight": "{font.weight.display}",
          "lineHeight": "63.84px",
          "letterSpacing": "-1.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of hero-title and pricing-h1 (.intro-section__title)"
        }
      },
      "heading": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "48px",
          "fontWeight": "{font.weight.display}",
          "lineHeight": "55.68px",
          "letterSpacing": "-0.8px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of section-h2 (.headline-block__title)"
        }
      },
      "nav": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "15px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "26.25px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of nav-link default"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "28px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of product-menu and faq-item"
        }
      },
      "button": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": "{font.weight.button}",
          "lineHeight": "16px",
          "letterSpacing": "0.2px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of hero-cta"
        }
      },
      "menu-item": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "14px",
          "fontWeight": "{font.weight.regular}",
          "lineHeight": "22px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of menu-link"
        }
      },
      "phone-nav": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "24px",
          "fontWeight": "{font.weight.bold}",
          "lineHeight": "42px",
          "letterSpacing": "0px"
        },
        "$type": "typography",
        "$extensions": {
          "source": "computed type of m-nav-item at 390x844"
        }
      }
    },
    "radius": {
      "button": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted borderRadius of hero-cta .btn-primary"
        }
      },
      "menu-link": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted borderRadius of menu-link"
        }
      },
      "card": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted borderRadius of plan-card"
        }
      },
      "chip": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "painted borderRadius of blog-card pill"
        }
      }
    },
    "space": {
      "button-x": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of hero-cta default on overflow.io"
        }
      },
      "button-y": {
        "$value": "19px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingTop of hero-cta default on overflow.io"
        }
      },
      "nav-x": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of nav-link default on overflow.io"
        }
      },
      "nav-y": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingTop of nav-link default on overflow.io"
        }
      },
      "menu-x": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingLeft of menu-link default on overflow.io"
        }
      },
      "menu-y": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingTop of menu-link default on overflow.io"
        }
      },
      "faq-y": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed paddingTop of faq-item default on overflow.io"
        }
      }
    },
    "size": {
      "button-height": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of hero-cta default on overflow.io"
        }
      },
      "nav-button-height": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of nav-cta default on overflow.io"
        }
      },
      "nav-link-height": {
        "$value": "42.25px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of nav-link default on overflow.io"
        }
      },
      "menu-height": {
        "$value": "393px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of product-menu default on overflow.io"
        }
      },
      "menu-link-height": {
        "$value": "98.969px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of menu-link default on overflow.io"
        }
      },
      "logo-height": {
        "$value": "27px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of logo default on overflow.io"
        }
      },
      "faq-opener-height": {
        "$value": "88px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of faq-item default on overflow.io"
        }
      },
      "phone-toggle": {
        "$value": "22px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed width of m-menu-button default on overflow.io"
        }
      },
      "phone-nav-item": {
        "$value": "58px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed height of m-nav-item default on overflow.io"
        }
      }
    },
    "shadow": {
      "card": {
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "4px",
            "blur": "16px",
            "spread": "-8px",
            "color": "rgba(0, 0, 0, 0.08)"
          }
        ],
        "$type": "shadow",
        "$extensions": {
          "source": "computed boxShadow of plan-card"
        }
      }
    },
    "motion": {
      "button": {
        "$value": "400ms",
        "$type": "duration",
        "$extensions": {
          "source": "declared transition transform .4s on .btn-primary"
        }
      },
      "link": {
        "$value": "350ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transitionDuration of nav-link"
        }
      },
      "menu": {
        "$value": "200ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transitionDuration of product-menu"
        }
      },
      "lift": {
        "$value": [
          0.3,
          0.86,
          0.36,
          0.95
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "declared cubic-bezier(.3,.86,.36,.95) on .navbar-nav__subnav in public-site-homepage.min.css"
        }
      }
    },
    "layout": {
      "desktop": {
        "$value": "1440px",
        "$type": "dimension",
        "$extensions": {
          "source": "requested and measured window.innerWidth of the desktop captures"
        }
      },
      "phone": {
        "$value": "390px",
        "$type": "dimension",
        "$extensions": {
          "source": "requested phone viewport width"
        }
      },
      "desktop-height": {
        "$value": "900px",
        "$type": "dimension",
        "$extensions": {
          "source": "requested and measured window.innerHeight of the desktop captures"
        }
      },
      "phone-height": {
        "$value": "844px",
        "$type": "dimension",
        "$extensions": {
          "source": "requested phone viewport height"
        }
      }
    }
  },
  "light": {
    "page": {
      "$value": "{color.paper}",
      "$type": "color",
      "$extensions": {
        "source": "alias of computed product-menu and body background"
      }
    },
    "surface": {
      "$value": "{color.paper}",
      "$type": "color",
      "$extensions": {
        "source": "alias of plan-card background"
      }
    },
    "text": {
      "$value": "{color.ink}",
      "$type": "color",
      "$extensions": {
        "source": "alias of nav-link color"
      }
    },
    "muted": {
      "$value": "{color.muted}",
      "$type": "color",
      "$extensions": {
        "source": "alias of blog-card color"
      }
    },
    "accent": {
      "$value": "{color.link}",
      "$type": "color",
      "$extensions": {
        "source": "alias of logo color, the painted blue"
      }
    },
    "border": {
      "$value": "{color.hairline}",
      "$type": "color",
      "$extensions": {
        "source": "alias of product-menu borderTopColor"
      }
    },
    "on-accent": {
      "$value": "{color.hero-ink}",
      "$type": "color",
      "$extensions": {
        "source": "alias of hero-cta text, white on the black button"
      }
    },
    "hero-text": {
      "$value": "{color.hero-ink}",
      "$type": "color",
      "$extensions": {
        "source": "alias of hero-title color on the gradient"
      }
    },
    "component": {
      "button": {
        "background": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of hero-cta default on overflow.io"
          }
        },
        "text": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed color of hero-cta default on overflow.io"
          }
        },
        "radius": {
          "$value": "{radius.button}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        },
        "height": {
          "$value": "{size.button-height}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        },
        "padding": {
          "$value": "{space.button-x}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias of hero-cta paddingLeft"
          }
        }
      },
      "nav-link": {
        "text": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link default on overflow.io"
          }
        },
        "hover": {
          "$value": "#259aef",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link hover on overflow.io"
          }
        },
        "pressed": {
          "$value": "#124b74",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link pressed on overflow.io"
          }
        }
      },
      "card": {
        "background": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of plan-card default on overflow.io"
          }
        },
        "radius": {
          "$value": "{radius.card}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        }
      },
      "menu": {
        "background": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of product-menu default on overflow.io"
          }
        },
        "border": {
          "$value": "#dadce0",
          "$type": "color",
          "$extensions": {
            "source": "computed borderTopColor of product-menu default on overflow.io"
          }
        },
        "height": {
          "$value": "{size.menu-height}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      },
      "$description": "The only theme overflow.io paints on the public pages captured 2026-11-21. No dark toggle was found."
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "light"
    ]
  }
}
