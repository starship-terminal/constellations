{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "gray-100": {
        "$type": "color",
        "$value": "#fbfbfb",
        "$extensions": {
          "source": "css-var --Curater-gray-100 on :root, computed"
        }
      },
      "gray-200": {
        "$type": "color",
        "$value": "#f9f6f6",
        "$extensions": {
          "source": "css-var --Curater-gray-200 on :root, computed"
        }
      },
      "gray-dark": {
        "$type": "color",
        "$value": "#333333",
        "$extensions": {
          "source": "css-var --Curater-gray-dark on :root, computed"
        }
      },
      "gray-medium": {
        "$type": "color",
        "$value": "#7c7c7c",
        "$extensions": {
          "source": "css-var --Curater-gray-medium on :root, computed"
        }
      },
      "gray-light": {
        "$type": "color",
        "$value": "#afafaf",
        "$extensions": {
          "source": "css-var --Curater-gray-light on :root, computed"
        }
      },
      "gray-muted": {
        "$type": "color",
        "$value": "#d4d4d4",
        "$extensions": {
          "source": "css-var --Curater-gray-muted on :root, computed"
        }
      },
      "background": {
        "$type": "color",
        "$value": "#f2f2f2",
        "$extensions": {
          "source": "css-var --Curater-background on :root, computed"
        }
      },
      "yellow-light": {
        "$type": "color",
        "$value": "#fff296",
        "$extensions": {
          "source": "css-var --Curater-yellow-light on :root, computed"
        }
      },
      "yellow": {
        "$type": "color",
        "$value": "#b26200",
        "$extensions": {
          "source": "css-var --Curater-yellow on :root, computed"
        }
      },
      "cyan-light": {
        "$type": "color",
        "$value": "#5cf4ff",
        "$extensions": {
          "source": "css-var --Curater-cyan-light on :root, computed"
        }
      },
      "red": {
        "$type": "color",
        "$value": "#e20000",
        "$extensions": {
          "source": "css-var --Curater-red on :root, computed"
        }
      },
      "red-light": {
        "$type": "color",
        "$value": "oklch(from #e20000 l c h / .2)",
        "$extensions": {
          "source": "css-var --Curater-red-light on :root, computed"
        }
      },
      "red-dark": {
        "$type": "color",
        "$value": "oklch(from #e20000 calc(l*.8) c h / .8)",
        "$extensions": {
          "source": "css-var --Curater-red-dark on :root, computed"
        }
      },
      "pink": {
        "$type": "color",
        "$value": "#d83acb",
        "$extensions": {
          "source": "css-var --Curater-pink on :root, computed"
        }
      },
      "pink-light": {
        "$type": "color",
        "$value": "#ffeefd",
        "$extensions": {
          "source": "css-var --Curater-pink-light on :root, computed"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#22c55e",
        "$extensions": {
          "source": "css-var --Curater-green on :root, computed"
        }
      },
      "green-dark": {
        "$type": "color",
        "$value": "oklch(from #22c55e calc(l*.8) c h / .8)",
        "$extensions": {
          "source": "css-var --Curater-green-dark on :root, computed"
        }
      },
      "green-background": {
        "$type": "color",
        "$value": "oklch(from #22c55e l c h / .15)",
        "$extensions": {
          "source": "css-var --Curater-green-background on :root, computed"
        }
      },
      "selection-green": {
        "$type": "color",
        "$value": "#85FF6F",
        "$extensions": {
          "source": "css-var --Curater-selection-green on :root, computed"
        }
      },
      "selection-blue": {
        "$type": "color",
        "$value": "#86EBFF",
        "$extensions": {
          "source": "css-var --Curater-selection-blue on :root, computed"
        }
      },
      "selection-aqua": {
        "$type": "color",
        "$value": "#96FFE0",
        "$extensions": {
          "source": "css-var --Curater-selection-aqua on :root, computed"
        }
      },
      "selection-lightblue": {
        "$type": "color",
        "$value": "#AFCFFF",
        "$extensions": {
          "source": "css-var --Curater-selection-lightblue on :root, computed"
        }
      },
      "selection-lavender": {
        "$type": "color",
        "$value": "#BEAAFF",
        "$extensions": {
          "source": "css-var --Curater-selection-lavender on :root, computed"
        }
      },
      "selection-red": {
        "$type": "color",
        "$value": "#FF4144",
        "$extensions": {
          "source": "css-var --Curater-selection-red on :root, computed"
        }
      },
      "selection-orange": {
        "$type": "color",
        "$value": "#ff8746",
        "$extensions": {
          "source": "css-var --Curater-selection-orange on :root, computed"
        }
      },
      "selection-pink": {
        "$type": "color",
        "$value": "#FF7CF8",
        "$extensions": {
          "source": "css-var --Curater-selection-pink on :root, computed"
        }
      },
      "selection-yellow": {
        "$type": "color",
        "$value": "#FFFD6F",
        "$extensions": {
          "source": "css-var --Curater-selection-yellow on :root, computed"
        }
      }
    },
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "ABCDiatype, -apple-system, system-ui, Segoe UI, Roboto, Oxygen, Ubuntu, Cantarell, Fira Sans, Droid Sans, Helvetica Neue, sans-serif",
        "$extensions": {
          "source": "computed font-family on the Sign in button, home, 1440x900"
        }
      },
      "sansDeclared": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif,system-ui,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\",\"Segoe UI Symbol\",\"Noto Color Emoji\"",
        "$extensions": {
          "source": "css-var --font-sans on :root; the painted UI uses ABCDiatype instead"
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,\"Liberation Mono\",\"Courier New\",monospace",
        "$extensions": {
          "source": "css-var --font-mono on :root; no public code sample was measured"
        }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "number",
        "$value": 400,
        "$extensions": {
          "source": "computed font-weight on body text, home"
        }
      },
      "medium": {
        "$type": "number",
        "$value": 500,
        "$extensions": {
          "source": "css-var --font-weight-medium; also the Sign in button"
        }
      },
      "semibold": {
        "$type": "number",
        "$value": 600,
        "$extensions": {
          "source": "css-var --font-weight-semibold; not observed on a public control"
        }
      },
      "bold": {
        "$type": "number",
        "$value": 700,
        "$extensions": {
          "source": "css-var --font-weight-bold"
        }
      }
    },
    "fontSize": {
      "xs": {
        "$type": "dimension",
        "$value": ".75rem",
        "$extensions": {
          "source": "css-var --text-xs"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": ".875rem",
        "$extensions": {
          "source": "css-var --text-sm"
        }
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem",
        "$extensions": {
          "source": "css-var --text-base"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$extensions": {
          "source": "css-var --text-lg"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$extensions": {
          "source": "css-var --text-xl"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$extensions": {
          "source": "css-var --text-2xl"
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": "1.875rem",
        "$extensions": {
          "source": "css-var --text-3xl"
        }
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.25rem",
        "$extensions": {
          "source": "css-var --text-4xl"
        }
      },
      "5xl": {
        "$type": "dimension",
        "$value": "3rem",
        "$extensions": {
          "source": "css-var --text-5xl"
        }
      }
    },
    "lineHeight": {
      "xs": {
        "$type": "number",
        "$value": "calc(1/.75)",
        "$extensions": {
          "source": "css-var --text-xs--line-height"
        }
      },
      "sm": {
        "$type": "number",
        "$value": "calc(1.25/.875)",
        "$extensions": {
          "source": "css-var --text-sm--line-height"
        }
      },
      "base": {
        "$type": "number",
        "$value": "1.5",
        "$extensions": {
          "source": "css-var --text-base--line-height"
        }
      },
      "lg": {
        "$type": "number",
        "$value": "calc(1.75/1.125)",
        "$extensions": {
          "source": "css-var --text-lg--line-height"
        }
      },
      "xl": {
        "$type": "number",
        "$value": "calc(1.75/1.25)",
        "$extensions": {
          "source": "css-var --text-xl--line-height"
        }
      },
      "2xl": {
        "$type": "number",
        "$value": "calc(2/1.5)",
        "$extensions": {
          "source": "css-var --text-2xl--line-height"
        }
      },
      "3xl": {
        "$type": "number",
        "$value": "1.2",
        "$extensions": {
          "source": "css-var --text-3xl--line-height"
        }
      },
      "4xl": {
        "$type": "number",
        "$value": "calc(2.5/2.25)",
        "$extensions": {
          "source": "css-var --text-4xl--line-height"
        }
      },
      "5xl": {
        "$type": "number",
        "$value": "1",
        "$extensions": {
          "source": "css-var --text-5xl--line-height"
        }
      }
    },
    "spacing": {
      "1": {
        "$type": "dimension",
        "$value": ".25rem",
        "$extensions": {
          "source": "css-var --space-1"
        }
      },
      "2": {
        "$type": "dimension",
        "$value": ".5rem",
        "$extensions": {
          "source": "css-var --space-2"
        }
      },
      "3": {
        "$type": "dimension",
        "$value": ".75rem",
        "$extensions": {
          "source": "css-var --space-3"
        }
      },
      "4": {
        "$type": "dimension",
        "$value": "1rem",
        "$extensions": {
          "source": "css-var --space-4"
        }
      },
      "5": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$extensions": {
          "source": "css-var --space-5"
        }
      },
      "6": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$extensions": {
          "source": "css-var --space-6"
        }
      },
      "8": {
        "$type": "dimension",
        "$value": "2rem",
        "$extensions": {
          "source": "css-var --space-8"
        }
      },
      "10": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$extensions": {
          "source": "css-var --space-10"
        }
      },
      "12": {
        "$type": "dimension",
        "$value": "3rem",
        "$extensions": {
          "source": "css-var --space-12"
        }
      },
      "unit": {
        "$type": "dimension",
        "$value": ".25rem",
        "$extensions": {
          "source": "css-var --spacing, the 4px base"
        }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": ".375rem",
        "$extensions": {
          "source": "css-var --radius-sm"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": ".5rem",
        "$extensions": {
          "source": "css-var --radius-md"
        }
      },
      "default": {
        "$type": "dimension",
        "$value": ".625rem",
        "$extensions": {
          "source": "css-var --radius"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": ".75rem",
        "$extensions": {
          "source": "css-var --radius-lg"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "1rem",
        "$extensions": {
          "source": "css-var --radius-xl"
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$extensions": {
          "source": "css-var --radius-2xl"
        }
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": "css-var --radius-full"
        }
      },
      "menu": {
        "$type": "dimension",
        "$value": "12px",
        "$extensions": {
          "source": "computed border-radius on [role=menu], settings menu, home"
        }
      }
    },
    "shadow": {
      "sm": {
        "$type": "shadow",
        "$value": "0 1px 2px 0 rgba(0, 0, 0, .05)",
        "$extensions": {
          "source": "css-var --shadow-sm"
        }
      },
      "md": {
        "$type": "shadow",
        "$value": "0 4px 6px -1px rgba(0, 0, 0, .1)",
        "$extensions": {
          "source": "css-var --shadow-md"
        }
      },
      "lg": {
        "$type": "shadow",
        "$value": "0 4px 14px 0 rgba(0, 0, 0, .03)",
        "$extensions": {
          "source": "css-var --shadow-lg"
        }
      },
      "xl": {
        "$type": "shadow",
        "$value": "0 2px 4px -1px rgba(0, 0, 0, .04), 0 12px 32px -4px rgba(0, 0, 0, .12)",
        "$extensions": {
          "source": "css-var --shadow-xl"
        }
      }
    },
    "motion": {
      "durationFast": {
        "$type": "other",
        "$value": ".15s cubic-bezier(.19, 1, .22, 1)",
        "$extensions": {
          "source": "css-var --transition-fast"
        }
      },
      "durationNormal": {
        "$type": "other",
        "$value": ".2s cubic-bezier(.19, 1, .22, 1)",
        "$extensions": {
          "source": "css-var --transition-normal"
        }
      },
      "durationSlow": {
        "$type": "other",
        "$value": ".3s cubic-bezier(.19, 1, .22, 1)",
        "$extensions": {
          "source": "css-var --transition-slow"
        }
      },
      "durationSlower": {
        "$type": "other",
        "$value": ".5s cubic-bezier(.19, 1, .22, 1)",
        "$extensions": {
          "source": "css-var --transition-slower"
        }
      },
      "easeOutExpo": {
        "$type": "other",
        "$value": "cubic-bezier(.19, 1, .22, 1)",
        "$extensions": {
          "source": "css-var --ease-out-expo"
        }
      },
      "defaultDuration": {
        "$type": "other",
        "$value": ".15s",
        "$extensions": {
          "source": "css-var --default-transition-duration on :root"
        }
      },
      "defaultEasing": {
        "$type": "other",
        "$value": "cubic-bezier(.4,0,.2,1)",
        "$extensions": {
          "source": "css-var --default-transition-timing-function on :root"
        }
      }
    },
    "layout": {
      "sidebarWidth": {
        "$type": "dimension",
        "$value": "5rem",
        "$extensions": {
          "source": "css-var --sidebar-width"
        }
      },
      "headerHeight": {
        "$type": "dimension",
        "$value": "3.5rem",
        "$extensions": {
          "source": "css-var --header-height"
        }
      },
      "mobileBarHeight": {
        "$type": "dimension",
        "$value": "3.5rem",
        "$extensions": {
          "source": "css-var --mobile-bar-height"
        }
      },
      "contentWidth": {
        "$type": "dimension",
        "$value": "35rem",
        "$extensions": {
          "source": "css-var --centered-content-width"
        }
      },
      "contentWidthMobile": {
        "$type": "other",
        "$value": "100%",
        "$extensions": {
          "source": "css-var --centered-content-width-mobile"
        }
      },
      "containerSm": {
        "$type": "dimension",
        "$value": "24rem",
        "$extensions": {
          "source": "css-var --container-sm"
        }
      },
      "containerMd": {
        "$type": "dimension",
        "$value": "28rem",
        "$extensions": {
          "source": "css-var --container-md"
        }
      },
      "container2xl": {
        "$type": "dimension",
        "$value": "42rem",
        "$extensions": {
          "source": "css-var --container-2xl"
        }
      },
      "container4xl": {
        "$type": "dimension",
        "$value": "56rem",
        "$extensions": {
          "source": "css-var --container-4xl"
        }
      },
      "container6xl": {
        "$type": "dimension",
        "$value": "72rem",
        "$extensions": {
          "source": "css-var --container-6xl"
        }
      }
    },
    "z": {
      "base": {
        "$type": "number",
        "$value": 0,
        "$extensions": {
          "source": "css-var --z-base"
        }
      },
      "dropdown": {
        "$type": "number",
        "$value": 10,
        "$extensions": {
          "source": "css-var --z-dropdown"
        }
      },
      "sticky": {
        "$type": "number",
        "$value": 20,
        "$extensions": {
          "source": "css-var --z-sticky"
        }
      },
      "fixed": {
        "$type": "number",
        "$value": 30,
        "$extensions": {
          "source": "css-var --z-fixed"
        }
      },
      "sidebar": {
        "$type": "number",
        "$value": 40,
        "$extensions": {
          "source": "css-var --z-sidebar"
        }
      },
      "overlay": {
        "$type": "number",
        "$value": 50,
        "$extensions": {
          "source": "css-var --z-overlay"
        }
      },
      "modal": {
        "$type": "number",
        "$value": 60,
        "$extensions": {
          "source": "css-var --z-modal"
        }
      },
      "popover": {
        "$type": "number",
        "$value": 70,
        "$extensions": {
          "source": "css-var --z-popover"
        }
      },
      "tooltip": {
        "$type": "number",
        "$value": 80,
        "$extensions": {
          "source": "css-var --z-tooltip"
        }
      }
    }
  },
  "light": {
    "page": {
      "$type": "color",
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "source": "css-var --background, computed on :root; body paints the same oklch(1 0 0)"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "source": "css-var --card"
      }
    },
    "raised": {
      "$type": "color",
      "$value": "oklch(1 0 0)",
      "$extensions": {
        "source": "css-var --popover; settings menu paints oklch(1 0 0)"
      }
    },
    "overlay": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.5)",
      "$extensions": {
        "source": "computed background-color of the sign-in dialog scrim, home"
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "rgba(0, 0, 0, 0.5)",
      "$extensions": {
        "source": "same scrim as overlay; one painted value"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "oklch(.141 .005 285.823)",
        "$extensions": {
          "source": "css-var --foreground"
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "oklch(.552 .016 285.938)",
        "$extensions": {
          "source": "css-var --muted-foreground"
        }
      },
      "disabled": {
        "$type": "other",
        "$value": "Not captured",
        "$extensions": {
          "source": "no disabled text colour was isolated from a painted disabled control"
        }
      },
      "onAccent": {
        "$type": "color",
        "$value": "oklch(.985 0 0)",
        "$extensions": {
          "source": "css-var --primary-foreground"
        }
      },
      "link": {
        "$type": "other",
        "$value": "Not captured",
        "$extensions": {
          "source": "public links paint as foreground; no separate link colour was measured"
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": "oklch(.95 .004 286.32)",
        "$extensions": {
          "source": "css-var --border"
        }
      },
      "strong": {
        "$type": "color",
        "$value": "oklch(.92 .004 286.32)",
        "$extensions": {
          "source": "css-var --input"
        }
      },
      "focus": {
        "$type": "color",
        "$value": "oklch(.871 .006 286.286)",
        "$extensions": {
          "source": "css-var --ring; a visible focus ring width was not isolated"
        }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": "oklch(.21 .006 285.885)",
        "$extensions": {
          "source": "css-var --primary; the filled Search button on phone paints near-black"
        }
      },
      "hover": {
        "$type": "other",
        "$value": "Not captured",
        "$extensions": {
          "source": "hover on the pill button did not change its computed background"
        }
      },
      "pressed": {
        "$type": "other",
        "$value": "Not captured",
        "$extensions": {
          "source": "a held pressed state was not measured"
        }
      }
    },
    "status": {
      "success": {
        "$type": "color",
        "$value": "#22c55e",
        "$extensions": {
          "source": "css-var --Curater-green"
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#b26200",
        "$extensions": {
          "source": "css-var --Curater-yellow"
