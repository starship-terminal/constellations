{
 "$description": "Kickstarter public design system (KDS), captured 2026-11-18 from kickstarter.com signed out. One light theme.",
 "core": {
  "font": {
   "family": {
    "sans": {
     "$type": "fontFamily",
     "$value": [
      "Inter",
      "sans-serif"
     ],
     "$extensions": {
      "source": "computed font-family on body, https://www.kickstarter.com/ 2026-11-18; Inter loaded from fonts.googleapis.com. Effra is declared in one @font-face and was not the computed body family."
     }
    }
   }
  },
  "fontSize": {
   "caption": {
    "$type": "dimension",
    "$value": "12px",
    "$extensions": {
     "source": "Derived caption step of the Inter scale used on the public site."
    }
   },
   "label": {
    "$type": "dimension",
    "$value": "14px",
    "$extensions": {
     "source": "Derived label / meta step."
    }
   },
   "body": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "Computed body size on kickstarter.com, 2026-11-18."
    }
   },
   "heading-sm": {
    "$type": "dimension",
    "$value": "18px",
    "$extensions": {
     "source": "Derived card-title step."
    }
   },
   "heading-md": {
    "$type": "dimension",
    "$value": "22px",
    "$extensions": {
     "source": "Derived section-heading step."
    }
   },
   "heading-lg": {
    "$type": "dimension",
    "$value": "28px",
    "$extensions": {
     "source": "kds-type-heading-lg on the editorial banner."
    }
   },
   "display": {
    "$type": "dimension",
    "$value": "48px",
    "$extensions": {
     "source": "Measured home h1, 2026-11-18."
    }
   }
  },
  "typography": {
   "display": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "48px",
     "fontWeight": 500,
     "lineHeight": "56px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. home hero h1, measured"
    }
   },
   "heading-lg": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "28px",
     "fontWeight": 500,
     "lineHeight": "36px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. kds-type-heading-lg, editorial banner"
    }
   },
   "heading-md": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "22px",
     "fontWeight": 500,
     "lineHeight": "28px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. section headings"
    }
   },
   "heading-sm": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "18px",
     "fontWeight": 500,
     "lineHeight": "24px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. card titles"
    }
   },
   "body": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. body, header category"
    }
   },
   "body-sm": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "14px",
     "fontWeight": 400,
     "lineHeight": "20px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. meta, funding line"
    }
   },
   "label": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. buttons, kds-button"
    }
   },
   "caption": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{core.font.family.sans}",
     "fontSize": "12px",
     "fontWeight": 400,
     "lineHeight": "16px"
    },
    "$extensions": {
     "source": "Derived from computed styles on the public home and project pages, 2026-11-18. fine print"
    }
   }
  },
  "radius": {
   "small": {
    "$type": "dimension",
    "$value": "4px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-small"
    }
   },
   "medium": {
    "$type": "dimension",
    "$value": "8px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-medium"
    }
   },
   "large": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-large"
    }
   }
  },
  "spacing": {
   "0": {
    "$type": "dimension",
    "$value": "0px",
    "$extensions": {
     "source": "Derived zero step of the 4px module."
    }
   },
   "2": {
    "$type": "dimension",
    "$value": "2px",
    "$extensions": {
     "source": "Derived from --kds-elevation-1-y (2px)."
    }
   },
   "4": {
    "$type": "dimension",
    "$value": "4px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-small (the 4px module base)."
    }
   },
   "8": {
    "$type": "dimension",
    "$value": "8px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-medium."
    }
   },
   "12": {
    "$type": "dimension",
    "$value": "12px",
    "$extensions": {
     "source": "Derived 3 x 4px module."
    }
   },
   "16": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-large."
    }
   },
   "24": {
    "$type": "dimension",
    "$value": "24px",
    "$extensions": {
     "source": "Derived 6 x 4px module, the header and card padding step."
    }
   },
   "32": {
    "$type": "dimension",
    "$value": "32px",
    "$extensions": {
     "source": "Derived 8 x 4px module."
    }
   },
   "40": {
    "$type": "dimension",
    "$value": "40px",
    "$extensions": {
     "source": "Derived. Control height of the header search (measured 48 includes padding)."
    }
   },
   "48": {
    "$type": "dimension",
    "$value": "48px",
    "$extensions": {
     "source": "Measured search field height on the home header, 2026-11-18."
    }
   },
   "64": {
    "$type": "dimension",
    "$value": "64px",
    "$extensions": {
     "source": "Derived 16 x 4px module, section gap."
    }
   }
  },
  "borderWidth": {
   "hairline": {
    "$type": "dimension",
    "$value": "1px",
    "$extensions": {
     "source": "Measured 1px borders on cards, inputs and the focus ring, 2026-11-18."
    }
   },
   "none": {
    "$type": "dimension",
    "$value": "0px",
    "$extensions": {
     "source": "Derived zero border."
    }
   }
  },
  "motion": {
   "duration": {
    "fast": {
     "$type": "duration",
     "$value": "100ms",
     "$extensions": {
      "source": "Declared .1s on .project-card-root and .expandable-background in the atomic sheet."
     }
    },
    "nav": {
     "$type": "duration",
     "$value": "150ms",
     "$extensions": {
      "source": "Declared --creator-nav-transition-duration: 150ms under prefers-reduced-motion: no-preference."
     }
    },
    "enter": {
     "$type": "duration",
     "$value": "300ms",
     "$extensions": {
      "source": "Declared 300ms translate on .creator-nav__submenu when open."
     }
    }
   },
   "easing": {
    "out": {
     "$type": "cubicBezier",
     "$value": [
      0,
      0,
      0.2,
      1
     ],
     "$extensions": {
      "source": "Derived from the ease-out keyword on .project-card-root__extra-info-container."
     }
    },
    "nav": {
     "$type": "cubicBezier",
     "$value": [
      0,
      1,
      1,
      1
     ],
     "$extensions": {
      "source": "Declared cubic-bezier(0, 1, 1, 1) on .creator-nav__submenu."
     }
    }
   }
  },
  "elevation": {
   "0": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "0px",
     "blur": "0px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-0"
    }
   },
   "1": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "2px",
     "blur": "4px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.18)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-1",
     "use": "card"
    }
   },
   "2": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "6px",
     "blur": "16px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.118)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-2",
     "use": "popover"
    }
   },
   "3": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "6px",
     "blur": "20px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.2)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-3",
     "use": "dialog"
    }
   },
   "4": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "8px",
     "blur": "28px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.278)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-4",
     "use": "toast"
    }
   }
  }
 },
