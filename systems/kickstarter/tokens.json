{
 "$description": "Kickstarter public design system (KDS), captured 2026-11-18 from kickstarter.com signed out. One light theme.",
 "core": {
  "font": {
   "family": {
    "sans": {
     "$type": "fontFamily",
     "$value": [
      "Inter",
      "sans-serif"
     ],
     "$extensions": {
      "source": "computed font-family on body, https://www.kickstarter.com/ 2026-11-18 (raw/css-vars.json fontBody); Inter loaded from fonts.googleapis.com. Effra is declared in one @font-face and was not the computed body family."
     }
    }
   }
  },
  "fontSize": {
   "caption": {
    "$type": "dimension",
    "$value": "12px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The caption step of the Inter scale."
    }
   },
   "label": {
    "$type": "dimension",
    "$value": "14px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The label and meta step."
    }
   },
   "body": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The body size."
    }
   },
   "heading-sm": {
    "$type": "dimension",
    "$value": "18px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The card-title step."
    }
   },
   "heading-md": {
    "$type": "dimension",
    "$value": "22px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The section-heading step."
    }
   },
   "heading-lg": {
    "$type": "dimension",
    "$value": "28px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Named after the kds-type-heading-lg class on the editorial banner."
    }
   },
   "display": {
    "$type": "dimension",
    "$value": "34px",
    "$extensions": {
     "source": "computed fontSize of hero-h1 default on https://www.kickstarter.com/, 2026-11-18 (raw/components-computed.json): the home hero h1"
    }
   }
  },
  "typography": {
   "display": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "34px",
     "fontWeight": 400,
     "lineHeight": "42px"
    },
    "$extensions": {
     "source": "computed fontSize, lineHeight and fontWeight of hero-h1 default on https://www.kickstarter.com/, 2026-11-18 (raw/components-computed.json): the home hero h1"
    }
   },
   "heading-lg": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "28px",
     "fontWeight": 500,
     "lineHeight": "36px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for kds-type-heading-lg, editorial banner."
    }
   },
   "heading-md": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "22px",
     "fontWeight": 500,
     "lineHeight": "28px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for section headings."
    }
   },
   "heading-sm": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "18px",
     "fontWeight": 500,
     "lineHeight": "24px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for card titles."
    }
   },
   "body": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "16px",
     "fontWeight": 400,
     "lineHeight": "24px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for body, header category."
    }
   },
   "body-sm": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "14px",
     "fontWeight": 400,
     "lineHeight": "20px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for meta, funding line."
    }
   },
   "label": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "14px",
     "fontWeight": 500,
     "lineHeight": "20px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for buttons, kds-button."
    }
   },
   "caption": {
    "$type": "typography",
    "$value": {
     "fontFamily": "{font.family.sans}",
     "fontSize": "12px",
     "fontWeight": 400,
     "lineHeight": "16px"
    },
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Intended for fine print."
    }
   }
  },
  "radius": {
   "small": {
    "$type": "dimension",
    "$value": "4px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-small"
    }
   },
   "medium": {
    "$type": "dimension",
    "$value": "8px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-medium"
    }
   },
   "large": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "css-var --kds-dimension-corner-radius-large"
    }
   }
  },
  "spacing": {
   "0": {
    "$type": "dimension",
    "$value": "0px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The zero step of the 4px module."
    }
   },
   "2": {
    "$type": "dimension",
    "$value": "2px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Equals the declared --kds-elevation-1-y (2px), which is not a spacing value."
    }
   },
   "4": {
    "$type": "dimension",
    "$value": "4px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The 4px module base. Equals the declared --kds-dimension-corner-radius-small (4px), which is not a spacing value."
    }
   },
   "8": {
    "$type": "dimension",
    "$value": "8px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Equals the declared --kds-dimension-corner-radius-medium (8px), which is not a spacing value."
    }
   },
   "12": {
    "$type": "dimension",
    "$value": "12px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. 3 x the 4px module."
    }
   },
   "16": {
    "$type": "dimension",
    "$value": "16px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Equals the declared --kds-dimension-corner-radius-large (16px), which is not a spacing value."
    }
   },
   "24": {
    "$type": "dimension",
    "$value": "24px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. 6 x the 4px module, used as the header and card padding step."
    }
   },
   "32": {
    "$type": "dimension",
    "$value": "32px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. 8 x the 4px module."
    }
   },
   "40": {
    "$type": "dimension",
    "$value": "40px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. A control height; the measured header search is 48px including padding."
    }
   },
   "48": {
    "$type": "dimension",
    "$value": "48px",
    "$extensions": {
     "source": "measured height of search default on https://www.kickstarter.com/, 2026-11-18 (raw/components-computed.json): the home header search field"
    }
   },
   "64": {
    "$type": "dimension",
    "$value": "64px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. 16 x the 4px module, used as the section gap."
    }
   }
  },
  "borderWidth": {
   "hairline": {
    "$type": "dimension",
    "$value": "1px",
    "$extensions": {
     "source": "computed borderTopWidth of banner-cta default, 2026-11-18 (raw/components-computed.json); the same 1px on creator-avatar, filter-toggle, login-apple, login-continue, m-login, nav-creators, nav-login, pledge-btn, start-next"
    }
   },
   "none": {
    "$type": "dimension",
    "$value": "0px",
    "$extensions": {
     "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. The zero border."
    }
   }
  },
  "motion": {
   "duration": {
    "fast": {
     "$type": "duration",
     "$value": "100ms",
     "$extensions": {
      "source": "declared transition `0.1s ease-in` on .expandable-background in the atomic sheet (raw/motion.json)"
     }
    },
    "nav": {
     "$type": "duration",
     "$value": "150ms",
     "$extensions": {
      "source": "declared --creator-nav-transition-duration under prefers-reduced-motion: no-preference (raw/css-vars.json)"
     }
    },
    "enter": {
     "$type": "duration",
     "$value": "300ms",
     "$extensions": {
      "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Typed from the 300ms translate on .creator-nav__submenu when open."
     }
    }
   },
   "easing": {
    "out": {
     "$type": "cubicBezier",
     "$value": [
      0,
      0,
      0.58,
      1
     ],
     "$extensions": {
      "source": "the ease-out keyword as CSS defines it, cubic-bezier(0, 0, 0.58, 1); declared on .category-menu__popover:where(:not([data-rac])) (`opacity var(--_duration) ease-out 0s,transform var(--_duration) ease-out 0s,visibility 0s linear calc(0s + var(--_duration)),pointer-events 0s linear calc(0s + `) and other kds rules in raw/motion.json"
     }
    },
    "nav": {
     "$type": "cubicBezier",
     "$value": [
      0,
      1,
      1,
      1
     ],
     "$extensions": {
      "source": "Reconstruction: entered by hand at capture time; no reading in raw/ holds it. Typed from cubic-bezier(0, 1, 1, 1) on .creator-nav__submenu."
     }
    }
   }
  },
  "elevation": {
   "0": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "0px",
     "blur": "0px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-0"
    }
   },
   "1": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "2px",
     "blur": "4px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.18)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-1",
     "use": "card"
    }
   },
   "2": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "6px",
     "blur": "16px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.118)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-2",
     "use": "popover"
    }
   },
   "3": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "6px",
     "blur": "20px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.2)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-3",
     "use": "dialog"
    }
   },
   "4": {
    "$type": "shadow",
    "$value": {
     "offsetX": "0px",
     "offsetY": "8px",
     "blur": "28px",
     "spread": "0px",
     "color": "rgba(0, 0, 0, 0.278)"
    },
    "$extensions": {
     "source": "css-var --kds-shadow-4",
     "use": "toast"
    }
   }
  }
 },
