{
  "core": {
    "palette": {
      "black": {
        "$value": "#000",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-black",
          "label": "Measured"
        },
        "$description": "Ink and primary button fill"
      },
      "white": {
        "$value": "#fff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-white",
          "label": "Measured"
        },
        "$description": "Page and button label on black"
      },
      "shade": {
        "10": {
          "$value": "#f4f4f5",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-10",
            "label": "Measured"
          }
        },
        "20": {
          "$value": "#e4e4e7",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-20",
            "label": "Measured"
          }
        },
        "30": {
          "$value": "#d4d4d8",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-30",
            "label": "Measured"
          }
        },
        "40": {
          "$value": "#a1a1aa",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-40",
            "label": "Measured"
          }
        },
        "50": {
          "$value": "#71717a",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-50",
            "label": "Measured"
          }
        },
        "60": {
          "$value": "#52525b",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-60",
            "label": "Measured"
          }
        },
        "70": {
          "$value": "#3f3f46",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-70",
            "label": "Measured"
          }
        },
        "90": {
          "$value": "#18181b",
          "$type": "color",
          "$extensions": {
            "source": "css-var --color-shade-90",
            "label": "Measured"
          }
        }
      }
    },
    "font": {
      "family": {
        "sans": {
          "$value": "Shopify-Inter,Helvetica,Arial,sans-serif",
          "$type": "fontFamily",
          "$extensions": {
            "source": "css-var --font-sans",
            "label": "Measured"
          }
        },
        "mono": {
          "$value": "ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,\"Liberation Mono\",\"Courier New\",monospace",
          "$type": "fontFamily",
          "$extensions": {
            "source": "css-var --font-mono",
            "label": "Measured"
          }
        }
      }
    },
    "typography": {
      "display": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "64px",
          "fontWeight": 330,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t1 and --font-weight-t1; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "heading-1": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "56px",
          "fontWeight": 330,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t2 and --font-weight-t2; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "heading-2": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "44px",
          "fontWeight": 330,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t3 and --font-weight-t3; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "heading-3": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "34px",
          "fontWeight": 330,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t4 and --font-weight-t4; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "heading-4": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "28px",
          "fontWeight": 360,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t5 and --font-weight-t5; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "heading-5": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "24px",
          "fontWeight": 400,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t6 and --font-weight-t6; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "body-large": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "20px",
          "fontWeight": 450,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t7 and --font-weight-t7; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      },
      "body": {
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "fontWeight": 450,
          "lineHeight": 1.2
        },
        "$type": "typography",
        "$extensions": {
          "source": "css-var --font-size-t8 and --font-weight-t8; lineHeight 1.2 is Derived from a 16px root conversion, not a declared line-height token",
          "label": "Derived"
        }
      }
    },
    "space": {
      "xs": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-xs (.5rem at 16px root)",
          "label": "Derived",
          "raw": ".5rem"
        }
      },
      "sm": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-sm (1rem at 16px root)",
          "label": "Derived",
          "raw": "1rem"
        }
      },
      "md": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-md (1.5rem at 16px root)",
          "label": "Derived",
          "raw": "1.5rem"
        }
      },
      "lg": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-lg (2rem at 16px root)",
          "label": "Derived",
          "raw": "2rem"
        }
      },
      "xl": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-xl (2.5rem at 16px root)",
          "label": "Derived",
          "raw": "2.5rem"
        }
      },
      "2xl": {
        "$value": "64px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-2xl (4rem at 16px root)",
          "label": "Derived",
          "raw": "4rem"
        }
      },
      "3xl": {
        "$value": "80px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-3xl (5rem at 16px root)",
          "label": "Derived",
          "raw": "5rem"
        }
      },
      "4xl": {
        "$value": "128px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-4xl (8rem at 16px root)",
          "label": "Derived",
          "raw": "8rem"
        }
      },
      "5xl": {
        "$value": "160px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --space-5xl (10rem at 16px root)",
          "label": "Derived",
          "raw": "10rem"
        }
      }
    },
    "radius": {
      "md": {
        "$value": "6px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --radius-md (.375rem at 16px root)",
          "label": "Derived",
          "raw": ".375rem"
        }
      },
      "lg": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --radius-lg (.5rem at 16px root)",
          "label": "Derived",
          "raw": ".5rem"
        }
      },
      "xl": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --radius-xl (.75rem at 16px root)",
          "label": "Derived",
          "raw": ".75rem"
        }
      },
      "2xl": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --radius-2xl (1rem at 16px root)",
          "label": "Derived",
          "raw": "1rem"
        }
      }
    },
    "motion": {
      "duration": {
        "default": {
          "$value": "150ms",
          "$type": "duration",
          "$extensions": {
            "source": "derived from css-var --default-transition-duration (.15s)",
            "label": "Derived"
          }
        }
      },
      "easing": {
        "in": {
          "$value": [
            0.4,
            0.0,
            1.0,
            1.0
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": "css-var --ease-in",
            "label": "Measured"
          }
        },
        "out": {
          "$value": [
            0.0,
            0.0,
            0.2,
            1.0
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": "css-var --ease-out",
            "label": "Measured"
          }
        },
        "in-out": {
          "$value": [
            0.4,
            0.0,
            0.2,
            1.0
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": "css-var --ease-in-out",
            "label": "Measured"
          }
        },
        "uc": {
          "$value": [
            0.22,
            1.0,
            0.36,
            1.0
          ],
          "$type": "cubicBezier",
          "$extensions": {
            "source": "css-var --ease-uc",
            "label": "Measured"
          }
        }
      }
    },
    "size": {
      "header": {
        "$value": "72px",
        "$type": "dimension",
        "$extensions": {
          "source": "derived from css-var --header-height (4.5rem at 16px root)",
          "label": "Derived",
          "raw": "4.5rem"
        }
      }
    }
  },
  "light": {
    "background": {
      "page": {
        "$value": "{palette.black}",
        "$type": "color",
        "$extensions": {
          "source": "computed body backgroundColor rgb(0, 0, 0) on the home hero",
          "label": "Measured"
        }
      },
      "surface": {
        "$value": "{palette.shade.10}",
        "$type": "color",
        "$extensions": {
          "source": "alias of --color-shade-10, the light band under the hero",
          "label": "Derived"
        }
      },
      "inverse": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "alias of --color-white",
          "label": "Derived"
        }
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "header color computed rgb(255, 255, 255) on the home hero",
          "label": "Measured"
        }
      },
      "muted": {
        "$value": "{palette.shade.40}",
        "$type": "color",
        "$extensions": {
          "source": "alias of --color-shade-40 for secondary copy on black",
          "label": "Derived"
        }
      },
      "on-accent": {
        "$value": "{palette.black}",
        "$type": "color",
        "$extensions": {
          "source": "Start for free label computed rgb(0, 0, 0)",
          "label": "Measured"
        }
      },
      "link": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "Log in computed rgb(255, 255, 255) in the header",
          "label": "Measured"
        }
      }
    },
    "border": {
      "default": {
        "$value": "{palette.shade.70}",
        "$type": "color",
        "$extensions": {
          "source": "alias of --color-shade-70",
          "label": "Derived"
        }
      },
      "strong": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "alias of --color-white",
          "label": "Derived"
        }
      }
    },
    "action": {
      "primary": {
        "$value": "{palette.white}",
        "$type": "color",
        "$extensions": {
          "source": "Start for free fill computed rgb(255, 255, 255); hover computed rgb(212, 212, 216) which is --color-shade-30",
          "label": "Measured"
        }
      },
      "primary-hover": {
        "$value": "#d4d4d8",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-shade-30",
          "label": "Measured"
        },
        "$description": "Hover fill of the white pill button"
      }
    },
    "focus": {
      "ring": {
        "$value": "#fff",
        "$type": "color",
        "$extensions": {
          "source": "css-var --color-link-dark-focus",
          "label": "Measured"
        },
        "$description": "Declared focus colour. Public controls often show no painted ring."
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ],
  "$extensions": {
    "notCaptured": [
      "Dark theme: the public marketing site exposes color-scheme normal and no dark token set.",
      "Status colours (success, warning, danger, info) are not declared as semantic roles on the marketing pages.",
      "Elevation shadows are not a named scale in the captured custom properties.",
      "Focus ring width and offset: Not captured as tokens. --color-link-dark-focus is the only focus colour read.",
      "Line heights are not custom properties; typography lineHeight is a derived stand-in."
    ]
  }
}
