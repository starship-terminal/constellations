{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "everlane": {
    "core": {
      "font": {
        "ui": {
          "$value": "\"Maison Neue Book\", sans-serif",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "getComputedStyle on body and department links at https://www.everlane.com/",
              "date": "2026-11-22"
            }
          }
        },
        "hero": {
          "$value": "\"Maison Neue\", sans-serif",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "getComputedStyle on the homepage BLACK FRIDAY paragraph",
              "date": "2026-11-22"
            }
          }
        },
        "size": {
          "nav": {
            "$value": "12px",
            "$extensions": {
              "source": {
                "label": "Exact",
                "method": "getComputedStyle on WOMEN and PRICED BETTER",
                "date": "2026-11-22"
              }
            }
          },
          "body": {
            "$value": "16px",
            "$extensions": {
              "source": {
                "label": "Exact",
                "method": "getComputedStyle on body and the product h1",
                "date": "2026-11-22"
              }
            }
          },
          "hero": {
            "$value": "20px",
            "$extensions": {
              "source": {
                "label": "Exact",
                "method": "getComputedStyle on the homepage BLACK FRIDAY paragraph",
                "date": "2026-11-22"
              }
            }
          }
        },
        "tracking": {
          "nav": {
            "$value": "0.24px",
            "$extensions": {
              "source": {
                "label": "Exact",
                "method": "getComputedStyle letter-spacing on department and mega links",
                "date": "2026-11-22"
              }
            }
          }
        }
      },
      "radius": {
        "control": {
          "$value": "0px",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "border-radius on style pills, Sold Out, the email field, and --buttons-radius",
              "date": "2026-11-22"
            }
          }
        }
      },
      "header": {
        "height": {
          "$value": "73px",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "--header-height on :root. The wordmark row measured 40px and the department row 33px.",
              "date": "2026-11-22"
            }
          }
        }
      }
    },
    "light": {
      "color": {
        "page": {
          "$value": "#ffffff",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "body backgroundColor rgb(255, 255, 255)",
              "date": "2026-11-22"
            }
          }
        },
        "ink": {
          "$value": "#000000",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "body and department link color rgb(0, 0, 0)",
              "date": "2026-11-22"
            }
          }
        },
        "ink-soft": {
          "$value": "#121212",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "--color-foreground 18,18,18 and announcement text rgb(18, 18, 18)",
              "date": "2026-11-22"
            }
          }
        },
        "muted": {
          "$value": "#737373",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "product breadcrumb color rgb(115, 115, 115)",
              "date": "2026-11-22"
            }
          }
        },
        "header": {
          "$value": "#ffffff",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "header.header backgroundColor",
              "date": "2026-11-22"
            }
          }
        },
        "announcement": {
          "$value": "#c8c0b8",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": ".announcement-bar-section backgroundColor rgb(200, 192, 184) on the product page. The homepage PNG top row was #12344b while a different slide was visible.",
              "date": "2026-11-22"
            }
          }
        },
        "sale": {
          "$value": "#d0021b",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "SALE mega-menu link color rgb(208, 2, 27)",
              "date": "2026-11-22"
            }
          }
        },
        "button": {
          "$value": "#262626",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "NO POCKET and SOLD OUT backgroundColor rgb(38, 38, 38). --color-button is 18,18,18 and was not the visible control.",
              "date": "2026-11-22"
            }
          }
        },
        "button-text": {
          "$value": "#ffffff",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "SOLD OUT and NO POCKET color",
              "date": "2026-11-22"
            }
          }
        },
        "field-border": {
          "$value": "#dedede",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "login email wrapper border rgb(222, 222, 222)",
              "date": "2026-11-22"
            }
          }
        },
        "shop": {
          "$value": "#5433eb",
          "$extensions": {
            "source": {
              "label": "Exact",
              "method": "Continue with Shop button in the shop-login shadow root, rgb(84, 51, 235). Not clicked.",
              "date": "2026-11-22"
            }
          }
        }
      }
    }
  }
}
