  "light": {
    "page": {
      "$value": "{core.color.gray.0}",
      "$type": "color",
      "$extensions": {
        "source": "alias of core.color.gray.0; marketing page is white (screenshot home-light-default)"
      }
    },
    "surface": {
      "$value": "{core.color.quiet}",
      "$type": "color",
      "$extensions": {
        "source": "alias of measured quiet button fill"
      }
    },
    "text": {
      "DEFAULT": {
        "$value": "{core.color.ink}",
        "$type": "color",
        "$extensions": {
          "source": "alias of measured nav ink"
        }
      },
      "muted": {
        "$value": "{core.color.menu-muted}",
        "$type": "color",
        "$extensions": {
          "source": "alias of measured menu-trigger resting colour"
        }
      },
      "on-accent": {
        "$value": "{core.color.hero-on-media}",
        "$type": "color",
        "$extensions": {
          "source": "alias of white on the filled CTA"
        }
      }
    },
    "border": {
      "DEFAULT": {
        "$value": "rgba(0, 0, 0, 0.1)",
        "$type": "color",
        "$extensions": {
          "source": "class border-black/10 on the open Creative menu divider (menus-and-crops.mjs hover log)"
        }
      }
    },
    "accent": {
      "$value": "{core.color.interactive.primary}",
      "$type": "color",
      "$extensions": {
        "source": "alias of --interactive-primary. Focus ring on the hero CTA is Tailwind ring-blue-500; the exact ring colour was not read as a computed outline."
      }
    },
    "danger": {
      "$value": "{core.color.danger}",
      "$type": "color",
      "$extensions": {
        "source": "alias of --rw-danger. Not seen painted on the captured marketing pages."
      }
    },
    "focus": {
      "ring": {
        "$value": "{core.color.interactive.primary}",
        "$type": "color",
        "$extensions": {
          "source": "Not captured as a computed outline. The hero CTA class names focus-visible:ring-blue-500. Marked as the declared interactive primary, not a held focus-visible reading."
        }
      }
    },
    "component": {
      "button": {
        "bg": {
          "$value": "{core.color.cta}",
          "$type": "color",
          "$extensions": {
            "source": "alias of nav-cta background"
          }
        },
        "text": {
          "$value": "{core.color.hero-on-media}",
          "$type": "color",
          "$extensions": {
            "source": "alias of nav-cta text"
          }
        },
        "radius": {
          "$value": "{core.radius.sm}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias of nav-cta radius"
          }
        },
        "height": {
          "$value": "{core.size.nav-cta}",
          "$type": "dimension",
          "$extensions": {
            "source": "alias of nav-cta height"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
