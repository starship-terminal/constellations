{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "cotopaxi": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle(document.body).backgroundColor rgb(255, 255, 255)", "date": "2026-11-22" } }
      },
      "ink": {
        "$value": "#25282a",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle(document.body).color rgb(37, 40, 42) and :root --bs-body-color", "date": "2026-11-22" } }
      },
      "announcement": {
        "$value": "#ebdbff",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle on .main-banner.coto_container rgb(235, 219, 255)", "date": "2026-11-22" } }
      },
      "search": {
        "$value": "#f2f2f2",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle on the search box rgb(242, 242, 242)", "date": "2026-11-22" } }
      },
      "primary": {
        "$value": "#e03100",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-primary", "date": "2026-11-22" } }
      },
      "sale": {
        "$value": "#8a0010",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle on the Black Friday nav link rgb(138, 0, 16)", "date": "2026-11-22" } }
      },
      "gifts": {
        "$value": "#005f9e",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle on the Gifts nav link rgb(0, 95, 158)", "date": "2026-11-22" } }
      },
      "footer": {
        "$value": "#25282a",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle(footer).backgroundColor rgb(37, 40, 42)", "date": "2026-11-22" } }
      },
      "secondary": {
        "$value": "#f1f0eb",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-secondary", "date": "2026-11-22" } }
      },
      "border": {
        "$value": "#bdbdbd",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-border-color", "date": "2026-11-22" } }
      },
      "muted": {
        "$value": "#828282",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-gray-400", "date": "2026-11-22" } }
      },
      "info": {
        "$value": "#385cad",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-info", "date": "2026-11-22" } }
      },
      "warning": {
        "$value": "#ffb612",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-warning", "date": "2026-11-22" } }
      },
      "success": {
        "$value": "#d4d771",
        "$type": "color",
        "$extensions": { "source": { "label": "Exact", "method": ":root --bs-success", "date": "2026-11-22" } }
      }
    },
    "font": {
      "body": {
        "$value": "Gotham, HelveticaNeue, Helvetica Neue, Helvetica, Arial, sans-serif",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle(document.body).fontFamily", "date": "2026-11-22" } }
      },
      "nav": {
        "$value": "Mont, Gotham, HelveticaNeue, Helvetica Neue, Helvetica, Arial, sans-serif",
        "$extensions": { "source": { "label": "Exact", "method": "getComputedStyle on the Black Friday nav link", "date": "2026-11-22" } }
      },
      "size": {
        "body": { "$value": "16px", "$extensions": { "source": { "label": "Exact", "method": "body font-size", "date": "2026-11-22" } } },
        "nav": { "$value": "14px", "$extensions": { "source": { "label": "Exact", "method": "nav link font-size", "date": "2026-11-22" } } },
        "announcement": { "$value": "12px", "$extensions": { "source": { "label": "Exact", "method": "announcement bar font-size", "date": "2026-11-22" } } },
        "cta": { "$value": "14px", "$extensions": { "source": { "label": "Exact", "method": "Shop Packs link font-size", "date": "2026-11-22" } } }
      }
    },
    "size": {
      "announcement": { "$value": "34px", "$extensions": { "source": { "label": "Exact", "method": "getBoundingClientRect on .main-banner", "date": "2026-11-22" } } },
      "logo": { "$value": "114px 37px", "$extensions": { "source": { "label": "Exact", "method": "getBoundingClientRect on the home link", "date": "2026-11-22" } } },
      "search": { "$value": "300px 30px", "$extensions": { "source": { "label": "Exact", "method": "getBoundingClientRect on the search box", "date": "2026-11-22" } } },
      "nav": { "$value": "40px", "$extensions": { "source": { "label": "Exact", "method": "getBoundingClientRect on the Black Friday link", "date": "2026-11-22" } } },
      "cta": { "$value": "41px", "$extensions": { "source": { "label": "Exact", "method": "getBoundingClientRect on Shop Packs", "date": "2026-11-22" } } }
    },
    "radius": {
      "control": { "$value": "0px", "$extensions": { "source": { "label": "Exact", "method": ":root --bs-border-radius and the Shop Packs link", "date": "2026-11-22" } } },
      "search": { "$value": "99px", "$extensions": { "source": { "label": "Exact", "method": "search box border-radius", "date": "2026-11-22" } } }
    }
  }
}
