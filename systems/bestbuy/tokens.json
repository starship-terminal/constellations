      "on-header": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Header wordmark fill #fff. Login Continue color rgb(255, 255, 255)." }
      },
      "tag": {
        "$value": "#fff200",
        "$type": "color",
        "$extensions": { "source": "Measured. Header wordmark tag path fill #fff200." }
      },
      "ink": {
        "$value": "#1d252c",
        "$type": "color",
        "$extensions": { "source": "Measured. Tag price-dot path fill #1d252c." }
      },
      "surface": {
        "$value": "#f3f4f6",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage deal band backgroundColor rgb(243, 244, 246)." }
      },
      "hero-yellow": {
        "$value": "#fff200",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage h2 color rgb(255, 242, 0). Same hex as the tag." }
      },
      "cart": {
        "$value": "#ffe200",
        "$type": "color",
