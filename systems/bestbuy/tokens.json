        "$extensions": { "source": "Measured. body backgroundColor rgb(255, 255, 255) on https://www.bestbuy.com/?intl=nosplash 2026-11-22." }
      },
      "text": {
        "$value": "#040c13",
        "$type": "color",
        "$extensions": { "source": "Measured. body color rgb(4, 12, 19)." }
      },
      "header": {
        "$value": "#0046be",
