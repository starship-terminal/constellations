        "$type": "dimension",
        "$extensions": { "source": "Measured. Login field and Continue borderRadius." }
      }
    },
    "size": {
      "body": {
        "$value": "13px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. body fontSize." }
      },
      "search": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Search field height." }
      },
      "display": {
        "$value": "68px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage h2 fontSize, weight 700." }
      }
