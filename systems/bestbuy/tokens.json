      },
      "field-border": {
        "$value": "#90959e",
        "$type": "color",
        "$extensions": { "source": "Measured. Login email field borderColor rgb(144, 149, 158)." }
      },
      "wall": {
        "$value": "#f1f2f4",
        "$type": "color",
