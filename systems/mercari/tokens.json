{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#222222",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(34, 34, 34) on https://www.mercari.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(255, 255, 255)" }
      },
      "navy": {
        "$value": "#252b60",
        "$type": "color",
        "$extensions": { "source": "computed homepage header and footer background rgb(37, 43, 96). Sampled #262b5d on home-light-1440.png" }
      },
      "on-navy": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed logo fill and Log in label rgb(255, 255, 255) on the homepage header" }
      },
      "primary": {
        "$value": "#5356ee",
        "$type": "color",
        "$extensions": { "source": "computed category label and About hero rgb(83, 86, 238). CSS variable --color-primary is #5356ee" }
      },
      "on-primary": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed About title and List an item label rgb(255, 255, 255)" }
      },
      "field": {
        "$value": "#f5f5f6",
        "$type": "color",
        "$extensions": { "source": "computed search background rgb(245, 245, 246). Sampled #f5f5f6 on home-light-1440.png" }
      },
      "field-border": {
        "$value": "#ecedf1",
        "$type": "color",
        "$extensions": { "source": "computed search border 1px solid rgb(236, 237, 241)" }
      },
      "muted": {
        "$value": "#6b6b6b",
        "$type": "color",
        "$extensions": { "source": "computed struck price and legal link rgb(107, 107, 107)" }
      },
      "mark": {
        "$value": "#6877f5",
        "$type": "color",
        "$extensions": { "source": "sampled apple-touch icon fill rgb(104, 119, 245). icon.png is that file resized to 128 px" }
      }
    },
    "font": {
      "ui": {
        "$value": "Averta, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body fontFamily. File is not in this package" }
      }
    },
    "typography": {
      "body": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "18.4px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed body on the homepage" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "16px", "fontWeight": 600, "lineHeight": "22px", "letterSpacing": "-0.24px" },
        "$type": "typography",
        "$extensions": { "source": "computed Download app, Sign up, and Log in on the homepage header" }
      },
      "category": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "16.1px", "letterSpacing": "-0.16px" },
        "$type": "typography",
        "$extensions": { "source": "computed Women category label on the homepage" }
      },
      "section": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "20px", "fontWeight": 600, "lineHeight": "22px", "letterSpacing": "-0.64px" },
        "$type": "typography",
        "$extensions": { "source": "computed h2 Top brands" }
      },
      "page-title": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "26px", "fontWeight": 600, "lineHeight": "32px", "letterSpacing": "-1px" },
        "$type": "typography",
        "$extensions": { "source": "computed Electronics h1" }
      },
      "hero": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "65px", "fontWeight": 600, "lineHeight": "65px", "letterSpacing": "-1.24px" },
        "$type": "typography",
        "$extensions": { "source": "computed About h1" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "14px", "fontWeight": 600, "lineHeight": "32px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Sell on the homepage. Not clicked" }
      },
      "legal": {
        "$value": { "fontFamily": "{core.font.ui}", "fontSize": "10px", "fontWeight": 400, "lineHeight": "14px", "letterSpacing": "0px" },
        "$type": "typography",
        "$extensions": { "source": "computed Privacy Policy in the legal bar" }
      }
    },
    "radius": {
      "pill": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "computed search border-radius" }
      },
      "button": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": { "source": "computed Sell and List an item border-radius" }
      }
    },
    "size": {
      "header": {
        "$value": "77px",
        "$type": "dimension",
        "$extensions": { "source": "measured header height. CSS variable --main-header-height was 76px" }
      },
      "category-bar": {
        "$value": "92px",
        "$type": "dimension",
        "$extensions": { "source": "measured homepage category nav height" }
      },
      "search": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "measured search field height" }
      },
      "sell": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": "measured Sell button height. Width 64px, padding 0 16px" }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": { "core": "enabled" }
    }
  ]
}
