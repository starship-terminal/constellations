{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed body, nav, and Add to Bag face rgb(0, 0, 0) on https://www.mrporter.com/en-sg/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed header background rgb(255, 255, 255)" }
      },
      "promo": {
        "$value": "#cbcbcb",
        "$type": "color",
        "$extensions": { "source": "computed .Ribbon2 background rgb(203, 203, 203)" }
      },
      "muted": {
        "$value": "#656565",
        "$type": "color",
        "$extensions": { "source": "computed footer link and category chip rgb(101, 101, 101)" }
      },
      "line": {
        "$value": "#cbcbcb",
        "$type": "color",
        "$extensions": { "source": "computed email field and filter border rgb(203, 203, 203)" }
      },
      "line-soft": {
        "$value": "#e5e5e5",
        "$type": "color",
        "$extensions": { "source": "computed size chip border rgb(229, 229, 229)" }
      },
      "unavailable": {
        "$value": "#838383",
        "$type": "color",
        "$extensions": { "source": "computed unavailable size chip color rgb(131, 131, 131)" }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed Add to Bag label and hero title rgb(255, 255, 255)" }
      }
    },
    "font": {
      "serif": {
        "$value": "Georgia, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed nav, product designer, price, and buttons. Georgia is the loaded UI face. SackersGothicStd is the display face and is not in this package." }
      },
      "display": {
        "$value": "SackersGothicStd, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed homepage hero and footer headings. SackersGothicStd 400 was loaded. The file is not in this package." }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "32px", "fontWeight": 500, "lineHeight": "40px", "textTransform": "uppercase" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage hero EXCLUSIVE: THOM BROWNE" }
      },
      "designer": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "32px", "fontWeight": 400, "lineHeight": "40px" },
        "$type": "typography",
        "$extensions": { "source": "computed .ProductInformation89__designer and category h1" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "0.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed product price" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "18px", "letterSpacing": "0.2px" },
        "$type": "typography",
        "$extensions": { "source": "computed .CategoryMenu2__title" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "22px" },
        "$type": "typography",
        "$extensions": { "source": "computed Add to Bag .Button10--primary" }
      },
      "product-name": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "18px" },
        "$type": "typography",
        "$extensions": { "source": "computed .ProductInformation89__name" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.display}", "fontSize": "10px", "fontWeight": 400, "lineHeight": "16px", "textTransform": "uppercase" },
        "$type": "typography",
        "$extensions": { "source": "computed footer heading SackersGothicStd 10px" }
      },
      "footer-link": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "12px", "fontWeight": 400, "lineHeight": "18px" },
        "$type": "typography",
        "$extensions": { "source": "computed footer link" }
      }
    },
    "radius": {
      "control": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to Bag, Wish List, size chip, email field, and hero Shop now" }
      }
    },
    "space": {
      "promo": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": { "source": "computed .Ribbon2 height" }
      },
      "header": {
        "$value": "183px",
        "$type": "dimension",
        "$extensions": { "source": "computed header height, promo plus logo row plus nav" }
      },
      "nav": {
        "$value": "52px",
        "$type": "dimension",
        "$extensions": { "source": "computed department link height" }
      },
      "button": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to Bag and size chip height" }
      }
    }
  }
}
