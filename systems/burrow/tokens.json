      "on-coral": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. 35% OFF badge color rgb(255, 255, 255)." }
      },
      "compare": {
        "$value": "#a5a7a8",
        "$type": "color",
        "$extensions": { "source": "Measured. Compare-at price color rgb(165, 167, 168) on /seating." }
      },
      "quick": {
        "$value": "#2a5b84",
        "$type": "color",
        "$extensions": { "source": "Measured. Quick ship badge backgroundColor rgb(42, 91, 132) on the Mercer product page." }
      },
      "button": {
        "$value": "#262626",
        "$type": "color",
        "$extensions": { "source": "Measured. Add to cart backgroundColor rgb(38, 38, 38). Not clicked." }
