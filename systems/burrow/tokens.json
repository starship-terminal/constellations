        "$extensions": { "source": "Measured. SMARTER BY DESIGN fontSize." }
      },
      "heading": {
        "$value": "40px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Homepage h1 fontSize." }
      },
      "display": {
        "$value": "68px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. UP TO 40% OFF fontSize." }
      },
      "card": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Mercer card title fontSize on /seating." }
      },
      "price": {
        "$value": "14px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Sale price fontSize on /seating." }
      }
    },
    "fontWeight": {
      "nav": {
        "$value": "400",
        "$type": "fontWeight",
        "$extensions": { "source": "Measured. Department link fontWeight." }
      },
      "heading": {
        "$value": "500",
        "$type": "fontWeight",
        "$extensions": { "source": "Measured. Homepage h1 and hero title fontWeight." }
      },
      "card": {
        "$value": "450",
        "$type": "fontWeight",
        "$extensions": { "source": "Measured. Product card title fontWeight on /seating." }
      }
    },
    "size": {
      "promo": {
        "$value": "41px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Promotions nav height." }
      },
      "header": {
        "$value": "106px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Header height, promo bar plus main bar." }
      },
      "button": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Shop Sale height." }
      },
      "cart": {
        "$value": "45px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Add to cart height. Not clicked." }
      },
      "badge": {
        "$value": "34px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. 35% OFF badge height." }
      },
      "wordmark": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Header wordmark SVG height." }
      }
    },
    "radius": {
      "button": {
        "$value": "3px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Shop Sale borderRadius." }
      },
      "cart": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. Add to cart borderRadius." }
      },
      "badge": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": { "source": "Measured. 35% OFF badge borderRadius." }
      }
