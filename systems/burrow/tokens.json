{
  "$schema": "https://design-tokens.org/schema.json",
  "core": {
    "color": {
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Header backgroundColor rgb(255, 255, 255) on https://burrow.com/ 2026-11-22. Body computed background is transparent; the painted page behind the header is white." }
      },
      "ink": {
        "$value": "#262626",
        "$type": "color",
        "$extensions": { "source": "Measured. body color and department link color rgb(38, 38, 38)." }
      },
      "heading": {
        "$value": "#202020",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage h1 color rgb(32, 32, 32)." }
      },
      "wordmark": {
        "$value": "#383633",
        "$type": "color",
        "$extensions": { "source": "Measured. Header SVG fill #383633, aria-label Burrow, height 20." }
      },
      "promo": {
        "$value": "#c0d1e4",
        "$type": "color",
        "$extensions": { "source": "Measured. Promotions nav backgroundColor rgb(192, 209, 228)." }
      },
      "promo-ink": {
        "$value": "#533a39",
        "$type": "color",
        "$extensions": { "source": "Measured. Promo link color rgb(83, 58, 57)." }
      },
      "sale": {
        "$value": "#883d2a",
        "$type": "color",
        "$extensions": { "source": "Measured. Warehouse Sale nav link color rgb(136, 61, 42)." }
