      "cream": {
        "$value": "#f7eee3",
        "$type": "color",
        "$extensions": { "source": "Measured. Favicon tile fill #F7EEE3 from the site icon SVG." }
      }
    },
    "font": {
      "text": {
        "$value": "\"Suisse Intl\", Helvetica, \"Helvetica Neue\", Arial, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. body fontFamily Suisse Intl. Files are not in this package." }
      },
      "mono": {
        "$value": "\"DM Mono\", ui-monospace, monospace",
        "$type": "fontFamily",
        "$extensions": { "source": "Measured. Homepage eyebrow and hero kicker fontFamily DM Mono. Files are not in this package." }
      }
    },
    "fontSize": {
      "body": {
        "$value": "16px",
