      "on-button": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Add to cart color rgb(255, 255, 255)." }
      },
      "hero": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "Measured. Homepage hero title color rgb(255, 255, 255)." }
