{
  "$schema": "https://www.w3.org/community/design-tokens/",
  "core": {
    "color": {
      "black": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": {
          "source": "Measured body background on the marketing homepage"
        }
      },
      "white": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": {
          "source": "Measured h1 color on the marketing homepage"
        }
      },
      "red": {
        "$value": "#e50914",
        "$type": "color",
        "$extensions": {
          "source": "Measured Sign In and Get Started backgroundColor"
        }
      },
      "red-hover": {
        "$value": "#c11119",
        "$type": "color",
        "$extensions": {
          "source": "Measured Get Started backgroundColor while hovered"
        }
      },
      "field": {
        "$value": "rgba(22, 22, 22, 0.7)",
        "$type": "color",
        "$extensions": {
          "source": "Measured email field painted shell backgroundColor"
        }
      },
      "grey-border": {
        "$value": "rgba(128, 128, 128, 0.7)",
        "$type": "color",
        "$extensions": {
          "source": "Measured email field painted shell border-top-color"
        }
      },
      "faq": {
        "$value": "#2d2d2d",
        "$type": "color",
        "$extensions": {
          "source": "Measured FAQ question row backgroundColor"
        }
      },
      "card": {
        "$value": "#232323",
        "$type": "color",
        "$extensions": {
          "source": "Measured trending title button backgroundColor"
        }
      },
      "dialog": {
        "$value": "#161616",
        "$type": "color",
        "$extensions": {
          "source": "Measured title-modal backgroundColor"
        }
      },
      "scrim": {
        "$value": "rgba(0, 0, 0, 0.7)",
        "$type": "color",
        "$extensions": {
          "source": "Measured title-modal background scrim"
        }
      },
      "text-muted": {
        "$value": "rgba(255, 255, 255, 0.7)",
        "$type": "color",
        "$extensions": {
          "source": "Measured footer link color"
        }
      },
      "help-ink": {
        "$value": "#221f1f",
        "$type": "color",
        "$extensions": {
          "source": "Measured help.netflix.com body color"
        }
      },
      "cookie-ink": {
        "$value": "#333333",
        "$type": "color",
        "$extensions": {
          "source": "Measured OneTrust preference heading color"
        }
      }
    },
    "font": {
      "family": {
        "$value": "Netflix Sans, Helvetica Neue, Segoe UI, Roboto, Ubuntu, sans-serif",
        "$type": "fontFamily",
        "$extensions": {
          "source": "Measured h1 fontFamily on the marketing homepage. Netflix Sans is proprietary and is not committed."
        }
      }
    },
    "typography": {
      "display": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "56px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured marketing h1 fontSize"
          }
        },
        "fontWeight": {
          "$value": "700",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured marketing h1 fontWeight"
          }
        },
        "lineHeight": {
          "$value": "70px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured marketing h1 lineHeight"
          }
        }
      },
      "heading": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured login h1 fontSize"
          }
        },
        "fontWeight": {
          "$value": "700",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured login h1 fontWeight"
          }
        },
        "lineHeight": {
          "$value": "32px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured login h1 fontSize used as line height; computed line-height was not a separate length"
          }
        }
      },
      "section": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured h2 Trending now fontSize"
          }
        },
        "fontWeight": {
          "$value": "500",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured h2 fontWeight"
          }
        },
        "lineHeight": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured h2 fontSize; computed line-height was normal, Not captured as a separate length"
          }
        }
      },
      "body": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured email input fontSize"
          }
        },
        "fontWeight": {
          "$value": "400",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured email input fontWeight"
          }
        },
        "lineHeight": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured email input lineHeight"
          }
        }
      },
      "label": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured Sign In fontSize"
          }
        },
        "fontWeight": {
          "$value": "500",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured Sign In fontWeight"
          }
        },
        "lineHeight": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured Sign In lineHeight"
          }
        }
      },
      "caption": {
        "fontFamily": "{core.font.family}",
        "fontSize": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured footer link fontSize"
          }
        },
        "fontWeight": {
          "$value": "400",
          "$type": "fontWeight",
          "$extensions": {
            "source": "Measured footer link fontWeight"
          }
        },
        "lineHeight": {
          "$value": "21px",
          "$type": "dimension",
          "$extensions": {
            "source": "Measured footer link lineHeight"
          }
        }
      }
    },
    "radius": {
      "button": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Sign In and Get Started borderRadius"
        }
      },
      "field": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured email field painted shell borderRadius"
        }
      },
      "card": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured trending title button borderRadius"
        }
      },
      "dialog": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured title-modal borderRadius"
        }
      },
      "help-field": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured help search input borderRadius"
        }
      }
    },
    "spacing": {
      "4": {
        "$value": "4px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Sign In padding-top"
        }
      },
      "8": {
        "$value": "8px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured email input padding-bottom"
        }
      },
      "12": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Get Started padding-top"
        }
      },
      "16": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Sign In padding-left and email padding-left"
        }
      },
      "24": {
        "$value": "24px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Get Started padding-left and FAQ padding"
        }
      }
    },
    "size": {
      "button-sm": {
        "$value": "32px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Sign In height"
        }
      },
      "button-md": {
        "$value": "48px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured login Continue height"
        }
      },
      "button-lg": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Get Started height"
        }
      },
      "field": {
        "$value": "56px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured email field painted shell height"
        }
      },
      "focus": {
        "$value": "2px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured Get Started focus outline-width"
        }
      }
    },
    "border": {
      "field": {
        "$value": "1px",
        "$type": "dimension",
        "$extensions": {
          "source": "Measured email field painted shell border-top-width"
        }
      }
    },
    "shadow": {
      "dialog": {
        "$value": {
          "color": "rgba(0, 0, 0, 0.8)",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px"
        },
        "$type": "shadow",
        "$extensions": {
          "source": "Measured title-modal boxShadow"
        }
      }
    },
    "motion": {
      "button": {
        "$value": "250ms",
        "$type": "duration",
        "$extensions": {
          "source": "Measured Get Started transitionDuration 0.25s"
        }
      },
      "button-ease": {
        "$value": [
          0.4,
          0,
          0.68,
          0.06
        ],
        "$type": "cubicBezier",
        "$extensions": {
          "source": "Measured Get Started transitionTimingFunction"
        }
      }
    }
  },
  "dark": {
    "color": {
      "bg": {
        "page": {
          "$value": "{core.color.black}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured body background"
          }
        },
        "surface": {
          "$value": "{core.color.faq}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured FAQ row"
          }
        },
        "raised": {
          "$value": "{core.color.card}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured title card"
          }
        },
        "overlay": {
          "$value": "{core.color.dialog}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured title-modal"
          }
        },
        "scrim": {
          "$value": "{core.color.scrim}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured title-modal scrim"
          }
        }
      },
      "text": {
        "primary": {
          "$value": "{core.color.white}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured h1"
          }
        },
        "secondary": {
          "$value": "{core.color.text-muted}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured footer link"
          }
        },
        "on-accent": {
          "$value": "{core.color.white}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured button label"
          }
        }
      },
      "border": {
        "default": {
          "$value": "{core.color.grey-border}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured field border"
          }
        },
        "focus": {
          "$value": "{core.color.white}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured focus outline"
          }
        }
      },
      "accent": {
        "default": {
          "$value": "{core.color.red}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured button fill"
          }
        },
        "hover": {
          "$value": "{core.color.red-hover}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured hover fill"
          }
        }
      }
    },
    "component": {
      "button": {
        "background": {
          "$value": "{core.color.red}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured Get Started"
          }
        },
        "text": {
          "$value": "{core.color.white}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured button label"
          }
        },
        "radius": {
          "$value": "{core.radius.button}",
          "$type": "dimension",
          "$extensions": {
            "source": "Derived alias of measured button radius"
          }
        },
        "height": {
          "$value": "{core.size.button-lg}",
          "$type": "dimension",
          "$extensions": {
            "source": "Derived alias of measured Get Started height"
          }
        }
      },
      "field": {
        "background": {
          "$value": "{core.color.field}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured field shell"
          }
        },
        "text": {
          "$value": "{core.color.white}",
          "$type": "color",
          "$extensions": {
            "source": "Derived alias of measured field color"
          }
        },
        "radius": {
          "$value": "{core.radius.field}",
          "$type": "dimension",
          "$extensions": {
            "source": "Derived alias of measured field radius"
          }
        },
        "height": {
          "$value": "{core.size.field}",
          "$type": "dimension",
          "$extensions": {
            "source": "Derived alias of measured field height"
          }
        }
      }
    }
  },
  "light": {
    "color": {
      "bg": {
        "page": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "Measured help.netflix.com body backgroundColor"
          }
        },
        "surface": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "Measured help search input backgroundColor"
          }
        }
      },
      "text": {
        "primary": {
          "$value": "#221f1f",
          "$type": "color",
          "$extensions": {
            "source": "Measured help.netflix.com body color"
          }
        },
        "secondary": {
          "$value": "rgba(0, 0, 0, 0.7)",
          "$type": "color",
          "$extensions": {
            "source": "Measured help Plans and Pricing link color"
          }
        }
      },
      "accent": {
        "default": {
          "$value": "{core.color.red}",
          "$type": "color",
          "$extensions": {
            "source": "Derived. Help pages reuse the same red brand; the help home did not paint a red control in the sampled nodes"
          }
        }
      },
      "border": {
        "default": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "Measured help search input border-top-color; width was 0px"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "core": "source",
        "dark": "enabled"
      }
    },
    {
      "id": "light",
      "name": "light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ],
  "$metadata": {
    "tokenSetOrder": [
      "core",
      "dark",
      "light"
    ]
  },
  "$extensions": {
    "notTokenised": [
      "Accent pressed, disabled, loading, and error fills: not shown on the public pages.",
      "Status success, warning, danger, and info: not shown.",
      "Text disabled and a distinct link colour on the marketing page: footer links use text.secondary.",
      "Border strong: not a separate computed colour.",
      "Reduced motion: not read.",
      "Breakpoints: captures were taken at 1440 and 390; the CSS breakpoint values were not read.",
      "Code type role: not present on the public marketing pages."
    ]
  }
}
