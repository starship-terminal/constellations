{
  "$description": "Product Hunt public signed-out surfaces, measured 2026-11-18 from computed styles on producthunt.com. Light was on screen. Dark tokens are declared custom properties, not computed on a painted dark page.",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": ["-apple-system", "system-ui", "Segoe UI", "Helvetica", "Arial", "sans-serif"],
          "$extensions": {"source": "Measured. getComputedStyle(body).fontFamily on https://www.producthunt.com/ at 1440px."}
        }
      }
    },
    "fontSize": {
      "caption": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured. NEW badge and leaderboard day numeral."}},
      "label": {"$type": "dimension", "$value": "14px", "$extensions": {"source": "Measured. nav menu item, vote count, newsletter field, View all link."}},
      "body": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured. body, nav link, primary button, product title."}},
      "heading-sm": {"$type": "dimension", "$value": "18px", "$extensions": {"source": "Measured. product tagline h2 on /products/s-space."}},
      "heading-md": {"$type": "dimension", "$value": "20px", "$extensions": {"source": "Measured. home h1 at 390px."}},
      "heading-lg": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Measured. home h1 and login h1 at 1440px."}},
      "title": {"$type": "dimension", "$value": "30px", "$extensions": {"source": "Measured. About h1 and story title."}},
      "display": {"$type": "dimension", "$value": "48px", "$extensions": {"source": "Measured. category h1 on /categories/productivity."}}
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "48px", "fontWeight": 600, "lineHeight": "56px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. category h1."}
      },
      "title": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "30px", "fontWeight": 700, "lineHeight": "38px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. About h1 and story title."}
      },
      "heading-lg": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "24px", "fontWeight": 600, "lineHeight": "32px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. home h1 at 1440px."}
      },
      "heading-md": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "20px", "fontWeight": 600, "lineHeight": "30px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. home h1 at 390px."}
      },
      "heading-sm": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "18px", "fontWeight": 400, "lineHeight": "28px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. product tagline."}
      },
      "body": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "24px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. nav link line height. Body itself computed 18.4px."}
      },
      "label": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "14px", "fontWeight": 600, "lineHeight": "24px", "letterSpacing": "0px"},
        "$extensions": {"source": "Measured. vote count and nav menu item."}
      },
      "caption": {
        "$type": "typography",
        "$value": {"fontFamily": "{core.font.family.sans}", "fontSize": "12px", "fontWeight": 600, "lineHeight": "20px", "letterSpacing": "0.3px"},
        "$extensions": {"source": "Measured. NEW badge."}
      }
    },
    "radius": {
      "small": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured. nav menu item and category icon tile."}},
      "medium": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "Measured. product thumbnail."}},
      "large": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured. vote button and gallery image."}},
      "full": {"$type": "dimension", "$value": "9999px", "$extensions": {"source": "Measured. primary button, search, tabs, newsletter field."}}
    },
    "spacing": {
      "0": {"$type": "dimension", "$value": "0px", "$extensions": {"source": "Measured. header padding."}},
      "2": {"$type": "dimension", "$value": "2px", "$extensions": {"source": "Measured. header and vote border width, used as a step."}},
      "4": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "Measured. nav link gap and menu item vertical padding."}},
      "8": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "Measured. menu item horizontal padding and badge padding."}},
      "12": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "Measured. newsletter field horizontal padding and filter horizontal padding."}},
      "16": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured. primary button horizontal padding."}},
      "24": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "Derived. 16px plus 8px, both measured. No 24px padding was read on a component."}},
      "32": {"$type": "dimension", "$value": "32px", "$extensions": {"source": "Measured. heading line height, used as the step."}},
      "40": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured. logo, search height, primary button height."}},
      "48": {"$type": "dimension", "$value": "48px", "$extensions": {"source": "Measured. login OAuth button height."}},
      "56": {"$type": "dimension", "$value": "56px", "$extensions": {"source": "Declared. :root --header-height at the base breakpoint."}}
    },
    "borderWidth": {
      "hairline": {"$type": "dimension", "$value": "1px", "$extensions": {"source": "Measured. search border and login OAuth border."}},
      "thick": {"$type": "dimension", "$value": "2px", "$extensions": {"source": "Measured. header bottom border, vote border, secondary button border."}}
    },
    "motion": {
      "duration": {
        "fast": {"$type": "duration", "$value": "150ms", "$extensions": {"source": "Measured. declared fade-in 150ms."}},
        "nav": {"$type": "duration", "$value": "300ms", "$extensions": {"source": "Measured. header nav link transition-duration 0.3s."}},
        "enter": {"$type": "duration", "$value": "300ms", "$extensions": {"source": "Measured. .animate-modal-in, .animate-pop-in, .animate-rise-in."}}
      },
      "easing": {
        "standard": {"$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1], "$extensions": {"source": "Measured. header nav link transition-timing-function."}},
        "out": {"$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$extensions": {"source": "Derived. ease-out keyword on fade-in 150ms, expanded to control points."}},
        "enter": {"$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1], "$extensions": {"source": "Measured. rise-in and fade-in 200ms."}},
        "pop": {"$type": "cubicBezier", "$value": [0.34, 1.56, 0.64, 1], "$extensions": {"source": "Measured. .animate-pop-in."}}
      }
    }
  },
  "light": {
    "color": {
      "brand": {"$type": "color", "$value": "#ff6154", "$extensions": {"source": "Measured. Sign in button background rgb(255, 97, 84). Logo disc #FF6154. Tailwind bg-brand-500."}},
      "brand-hover": {"$type": "color", "$value": "#db5246", "$extensions": {"source": "Measured. Tailwind bg-brand-600 and NEW badge text rgb(219, 82, 70). Hover itself was not forced."}},
      "brand-subtle": {"$type": "color", "$value": "#ffe8e6", "$extensions": {"source": "Measured. NEW badge background rgb(255, 232, 230). Tailwind bg-brand-25."}},
      "background": {
        "surface": {
          "primary": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured. body and header background. --background-primary #fff."}},
          "secondary": {"$type": "color", "$value": "#f9fafb", "$extensions": {"source": "Measured. --background-secondary. Tailwind gray-50."}},
          "tertiary": {"$type": "color", "$value": "#f2f4f7", "$extensions": {"source": "Measured. search background and --background-tertiary. Tailwind gray-100."}},
          "inverse": {"$type": "color", "$value": "#101828", "$extensions": {"source": "Measured. footer background rgb(16, 24, 40). Tailwind gray-900."}}
        },
        "action": {"$type": "color", "$value": "#ff6154", "$extensions": {"source": "Measured. primary button."}},
        "selected": {"$type": "color", "$value": "#eaecf0", "$extensions": {"source": "Measured. selected product tab Overview."}}
      },
      "text": {
        "primary": {"$type": "color", "$value": "#101828", "$extensions": {"source": "Measured. h1 color rgb(16, 24, 40). --text-primary."}},
        "secondary": {"$type": "color", "$value": "#344054", "$extensions": {"source": "Measured. nav link rgb(52, 64, 84). --text-secondary."}},
        "tertiary": {"$type": "color", "$value": "#475467", "$extensions": {"source": "Measured. --text-tertiary. Newsletter field color rgb(71, 84, 103) is gray-600, recorded separately."}},
        "placeholder": {"$type": "color", "$value": "#4b587c", "$extensions": {"source": "Measured. search input color rgb(75, 88, 124). Class text-light-gray."}},
        "inverse": {"$type": "color", "$value": "#ffffff", "$extensions": {"source": "Measured. primary button and footer link."}},
        "brand": {"$type": "color", "$value": "#ff6154", "$extensions": {"source": "Measured. View all and Keep reading links."}},
        "disabled": {"$type": "color", "$value": "#98a2b3", "$extensions": {"source": "Measured. footer heading and idle product tab rgb(102, 112, 133) is gray-500. gray-400 #98a2b3 is the quieter step."}}
      },
      "border": {
        "subtle": {"$type": "color", "$value": "#eaecf0", "$extensions": {"source": "Measured. --border-primary and header border rgb(234, 236, 240)."}},
        "input": {"$type": "color", "$value": "#d9e1ec", "$extensions": {"source": "Measured. login OAuth button border rgb(217, 225, 236)."}},
        "focus": {"$type": "color", "$value": "#ff6154", "$extensions": {"source": "Measured. newsletter email border on focus."}},
        "bold": {"$type": "color", "$value": "#d0d5dd", "$extensions": {"source": "Measured. Tailwind border-gray-300. Not painted on the controls read."}}
      },
      "status": {
        "success": {"$type": "color", "$value": "#17b26a", "$extensions": {"source": "Measured. live-dot class bg-success-500, computed rgb(23, 178, 106)."}},
        "error": {"$type": "color", "$value": "#f04438", "$extensions": {"source": "Measured. Tailwind bg-error-500. The newsletter error message did not change the field border."}},
        "warning": {"$type": "color", "$value": "#f79009", "$extensions": {"source": "Measured. Tailwind bg-warning-500. No warning control was on screen."}}
      },
      "focus": {
        "ring": {"$type": "color", "$value": "#005ef61a", "$extensions": {"source": "Measured. newsletter focus box-shadow rgba(0, 94, 246, 0.1)."}}
      }
    },
    "component": {
      "button": {
        "primary": {
          "bg": {"$type": "color", "$value": "{light.color.brand}", "$extensions": {"source": "Measured. Sign in button."}},
          "text": {"$type": "color", "$value": "{light.color.text.inverse}", "$extensions": {"source": "Measured. Sign in button."}},
          "radius": {"$type": "dimension", "$value": "{core.radius.full}", "$extensions": {"source": "Measured. 9999px."}},
          "height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured. Sign in button."}},
          "padding": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "Measured. horizontal padding. Vertical padding was 0."}}
        },
        "secondary": {
          "bg": {"$type": "color", "$value": "{light.color.background.surface.primary}", "$extensions": {"source": "Measured. Visit website was white. Header Subscribe was transparent over white."}},
          "text": {"$type": "color", "$value": "{light.color.text.secondary}", "$extensions": {"source": "Measured."}},
          "radius": {"$type": "dimension", "$value": "{core.radius.full}", "$extensions": {"source": "Measured."}}
        }
      },
      "field": {
        "search": {
          "bg": {"$type": "color", "$value": "{light.color.background.surface.tertiary}", "$extensions": {"source": "Measured."}},
          "text": {"$type": "color", "$value": "{light.color.text.placeholder}", "$extensions": {"source": "Measured."}},
          "radius": {"$type": "dimension", "$value": "{core.radius.full}", "$extensions": {"source": "Measured."}},
          "height": {"$type": "dimension", "$value": "40px", "$extensions": {"source": "Measured."}}
        }
      }
    }
  },
  "dark": {
    "color": {
      "background": {
        "surface": {
          "primary": {"$type": "color", "$value": "#161b26", "$extensions": {"source": "Declared. --background-primary on :is(.dark, :has(.dark:not(.theme-isolate)) .theme-mirror). Not computed on a painted element."}},
          "secondary": {"$type": "color", "$value": "#1f242f", "$extensions": {"source": "Declared. --background-secondary on the dark selector."}},
          "tertiary": {"$type": "color", "$value": "#333741", "$extensions": {"source": "Declared. --background-tertiary on the dark selector."}}
        }
      },
      "text": {
        "primary": {"$type": "color", "$value": "#f9fafb", "$extensions": {"source": "Declared. --text-primary on the dark selector."}},
        "secondary": {"$type": "color", "$value": "#d0d5dd", "$extensions": {"source": "Declared. --text-secondary on the dark selector."}},
        "tertiary": {"$type": "color", "$value": "#98a2b3", "$extensions": {"source": "Declared. --text-tertiary on the dark selector."}}
      },
      "border": {
        "subtle": {"$type": "color", "$value": "#1f242f", "$extensions": {"source": "Declared. --border-primary on the dark selector."}}
      },
      "nav": {
        "icon": {"$type": "color", "$value": "#98a2b3", "$extensions": {"source": "Declared. --nav-icon-color on the dark selector."}},
        "highlight": {"$type": "color", "$value": "#1f242f", "$extensions": {"source": "Declared. --nav-menu-highlight-bg on the dark selector."}}
      }
    }
  },
  "$themes": [
    {"id": "light", "name": "Light", "selectedTokenSets": {"core": "source", "light": "enabled"}},
    {"id": "dark", "name": "Dark", "selectedTokenSets": {"core": "source", "dark": "enabled"}}
  ]
}
