{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "core": {
    "color": {
      "ink": {
        "$value": "#000000",
        "$type": "color",
        "$extensions": { "source": "computed body color rgb(0, 0, 0) on https://birdies.com/ 2026-11-22" }
      },
      "page": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed body background rgb(255, 255, 255)" }
      },
      "warm": {
        "$value": "#f6f4f1",
        "$type": "color",
        "$extensions": { "source": "computed footer background rgb(246, 244, 241); same as --nav-warm and Shop all face" }
      },
      "ink-soft": {
        "$value": "#222222",
        "$type": "color",
        "$extensions": { "source": "computed product title color rgb(34, 34, 34)" }
      },
      "line": {
        "$value": "#d9d9d9",
        "$type": "color",
        "$extensions": { "source": "custom property --nav-rule" }
      },
      "gold": {
        "$value": "#c9a66b",
        "$type": "color",
        "$extensions": { "source": "custom property --home-gold and --nav-tan" }
      },
      "on-ink": {
        "$value": "#ffffff",
        "$type": "color",
        "$extensions": { "source": "computed announcement color and Shop the crystal collection label rgb(255, 255, 255)" }
      },
      "sale": {
        "$value": "#e32c2b",
        "$type": "color",
        "$extensions": { "source": "custom property --on-sale-text 227 44 43" }
      }
    },
    "font": {
      "sans": {
        "$value": "\"Sofia Pro\", \"Sofia Pro Regular\", sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed nav, buttons, and announcement. Sofia Pro 400 and 500 were loaded. Files are not in this package." }
      },
      "serif": {
        "$value": "calluna, Georgia, serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed homepage h1 and collection h1. calluna 400 was loaded. Files are not in this package." }
      },
      "body": {
        "$value": "Nunito, sans-serif",
        "$type": "fontFamily",
        "$extensions": { "source": "computed body and --text-font-family. Nunito 400 was loaded." }
      }
    },
    "typography": {
      "display": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "50px", "fontWeight": 400, "lineHeight": "60px" },
        "$type": "typography",
        "$extensions": { "source": "computed homepage .home-spotlight__title" }
      },
      "collection": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "60px", "fontWeight": 500, "lineHeight": "73px" },
        "$type": "typography",
        "$extensions": { "source": "computed collection h1 on /collections/new-arrivals" }
      },
      "product": {
        "$value": { "fontFamily": "{core.font.serif}", "fontSize": "40px", "fontWeight": 400, "lineHeight": "48px" },
        "$type": "typography",
        "$extensions": { "source": "computed product h1" }
      },
      "price": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "24px", "fontWeight": 400, "lineHeight": "28px" },
        "$type": "typography",
        "$extensions": { "source": "computed product sale-price .h4" }
      },
      "nav": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "16px", "fontWeight": 400, "lineHeight": "22px" },
        "$type": "typography",
        "$extensions": { "source": "computed header department link" }
      },
      "button": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "16px", "fontWeight": 700, "lineHeight": "24px", "letterSpacing": "0", "textTransform": "uppercase" },
        "$type": "typography",
        "$extensions": { "source": "computed .home-btn--primary" }
      },
      "body": {
        "$value": { "fontFamily": "{core.font.body}", "fontSize": "14px", "fontWeight": 400, "lineHeight": "21px" },
        "$type": "typography",
        "$extensions": { "source": "computed body" }
      },
      "meta": {
        "$value": { "fontFamily": "{core.font.sans}", "fontSize": "11px", "fontWeight": 400, "lineHeight": "16.5px" },
        "$type": "typography",
        "$extensions": { "source": "computed .announcement-bar" }
      }
    },
    "radius": {
      "none": {
        "$value": "0px",
        "$type": "dimension",
        "$extensions": { "source": "computed buttons, Shop all, size chips, and --button-border-radius 0.0rem" }
      }
    },
    "space": {
      "announcement": {
        "$value": "44px",
        "$type": "dimension",
        "$extensions": { "source": "computed announcement bar height" }
      },
      "header": {
        "$value": "88px",
        "$type": "dimension",
        "$extensions": { "source": "computed header height" }
      },
      "button": {
        "$value": "50px",
        "$type": "dimension",
        "$extensions": { "source": "computed Shop the crystal collection height" }
      },
      "add-to-bag": {
        "$value": "58px",
        "$type": "dimension",
        "$extensions": { "source": "computed Add to bag height. The button was not clicked." }
      }
    }
  },
  "light": {
    "color": {
      "page": { "$value": "{core.color.page}", "$type": "color" },
      "text": { "$value": "{core.color.ink}", "$type": "color" },
      "surface": { "$value": "{core.color.warm}", "$type": "color" },
      "border": { "$value": "{core.color.line}", "$type": "color" },
      "accent": { "$value": "{core.color.ink}", "$type": "color" },
      "on-accent": { "$value": "{core.color.on-ink}", "$type": "color" },
      "muted": { "$value": "{core.color.gold}", "$type": "color" },
      "sale": { "$value": "{core.color.sale}", "$type": "color" }
    }
  },
  "$themes": [
    { "id": "light", "name": "Light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } }
  ]
}
