{
  "$schema": "https://tr.designtokens.org/format/dtcg.json",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "InterVariable, Inter, ui-sans-serif, system-ui, sans-serif",
          "$description": "Computed font-family on marketing buttons, nav, and body copy.",
          "$extensions": {"source": "computed on https://supercut.ai/ button Get started free, 2026-11-19"}
        },
        "display": {
          "$type": "fontFamily",
          "$value": "\"Inter Display\", InterVariable, Inter, ui-sans-serif, system-ui, sans-serif",
          "$description": "Computed font-family on the home h1 and pricing headings.",
          "$extensions": {"source": "computed on home h1, 2026-11-19"}
        },
        "root": {
          "$type": "fontFamily",
          "$value": "Geist, sans-serif",
          "$description": "Computed font-family on html and body. Marketing UI overrides it with Inter.",
          "$extensions": {"source": "computed on body, html.dark, 2026-11-19"}
        }
      },
      "weight": {
        "regular": {"$type": "fontWeight", "$value": 400, "$extensions": {"source": "computed body font-weight"}},
        "medium": {"$type": "fontWeight", "$value": 500, "$extensions": {"source": "computed button and heading font-weight"}}
      }
    },
    "typography": {
      "hero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "60px",
          "fontWeight": 500,
          "lineHeight": "66px",
          "letterSpacing": "-1.08px"
        },
        "$description": "Desktop title-web-l. Home h1 computed 55.2px fluid; the token is the CSS variable at min-width 1024px.",
        "$extensions": {"source": "--type-title-web-l-* computed on html at innerWidth 1169"}
      },
      "title-m": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "40px",
          "fontWeight": 500,
          "lineHeight": "46px",
          "letterSpacing": "-0.4px"
        },
        "$extensions": {"source": "--type-title-web-m-* and pricing h3 computed 40px/500"}
      },
      "title-s": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "32px",
          "fontWeight": 500,
          "lineHeight": "36px",
          "letterSpacing": "-0.32px"
        },
        "$extensions": {"source": "--type-title-web-s-* and pricing section h3 computed 32px"}
      },
      "title-xs": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.display}",
          "fontSize": "24px",
          "fontWeight": 500,
          "lineHeight": "30px",
          "letterSpacing": "-0.24px"
        },
        "$extensions": {"source": "--type-title-web-xs-* at min-width 1024px"}
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "18px",
          "fontWeight": 400,
          "lineHeight": "26px",
          "letterSpacing": "0px"
        },
        "$extensions": {"source": "--type-body-web-* and home h2 computed 18px/26px"}
      },
      "button": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "15px",
          "fontWeight": 500,
          "lineHeight": "20px",
          "letterSpacing": "0px"
        },
        "$extensions": {"source": "computed on Get started free, height 40px"}
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "13px",
          "fontWeight": 500,
          "lineHeight": "18px",
          "letterSpacing": "0px"
        },
        "$extensions": {"source": "--type-caption-* and nav link computed 13px/18px/500"}
      },
      "footnote": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{core.font.family.sans}",
          "fontSize": "11px",
          "fontWeight": 400,
          "lineHeight": "14px"
        },
        "$extensions": {"source": "--type-footnote-* on :root in tailwind_new.css"}
      }
    },
    "space": {
      "1": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "--spacing .25rem, root font 16px"}},
      "2": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "2 * --spacing"}},
      "3": {"$type": "dimension", "$value": "12px", "$extensions": {"source": "header Sign up vertical padding 11px and 12px, recorded as the 12px step"}},
      "4": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "primary button padding-inline 16px; menu item padding 16px"}},
      "6": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "--layout-content-padding-x-mobile 24px"}},
      "12": {"$type": "dimension", "$value": "48px", "$extensions": {"source": "--layout-content-padding-x-desktop 48px"}},
      "header": {"$type": "dimension", "$value": "64px", "$extensions": {"source": "--layout-header-height and header computed height 64px"}},
      "button-gap": {"$type": "dimension", "$value": "6px", "$extensions": {"source": "computed gap on marketing buttons"}}
    },
    "radius": {
      "xs": {"$type": "dimension", "$value": "2px", "$extensions": {"source": "--radius-xs .125rem"}},
      "sm": {"$type": "dimension", "$value": "4px", "$extensions": {"source": "--radius-sm calc(.5rem - 4px); FAQ button computed radius 4px"}},
      "md": {"$type": "dimension", "$value": "6px", "$extensions": {"source": "--radius-md calc(.5rem - 2px)"}},
      "lg": {"$type": "dimension", "$value": "8px", "$extensions": {"source": "--radius and --radius-lg .5rem"}},
      "xl": {"$type": "dimension", "$value": "10px", "$extensions": {"source": "--radius-xl calc(.5rem + 2px); ghost nav link computed radius 10px"}},
      "2xl": {"$type": "dimension", "$value": "14px", "$extensions": {"source": "product menu nav computed border-radius 14px"}},
      "3xl": {"$type": "dimension", "$value": "16px", "$extensions": {"source": "--radius-2xl 1rem"}},
      "4xl": {"$type": "dimension", "$value": "24px", "$extensions": {"source": "--radius-3xl 1.5rem"}},
      "5xl": {"$type": "dimension", "$value": "32px", "$extensions": {"source": "--radius-4xl 2rem"}},
      "pill": {"$type": "dimension", "$value": "9999px", "$extensions": {"source": "primary and secondary buttons computed border-radius as a pill (browser reported 1.67772e+07px)"}}
    },
    "layout": {
      "container": {"$type": "dimension", "$value": "1266px", "$extensions": {"source": "--layout-container-max-width"}},
      "breakout": {"$type": "dimension", "$value": "1392px", "$extensions": {"source": "--layout-breakout-max-width"}},
      "hero": {"$type": "dimension", "$value": "653px", "$extensions": {"source": "--layout-hero-headline-max-width; product menu width computed 653px"}}
    },
    "motion": {
      "duration": {
        "fast": {"$type": "duration", "$value": "150ms", "$extensions": {"source": "button transition-duration 0.15s"}},
        "menu": {"$type": "duration", "$value": "220ms", "$extensions": {"source": "menu class duration-[0.22s]"}}
      },
      "easing": {
        "standard": {"$type": "cubicBezier", "$value": [0, 0, 0.2, 1], "$extensions": {"source": "button transition-timing-function cubic-bezier(0, 0, 0.2, 1)"}}
      }
    }
  },
  "dark": {
    "color": {
      "page": {"$type": "color", "$value": "#100e0e", "$extensions": {"source": "--custom-color-background computed #100e0e; body background rgb(16, 14, 14)"}},
      "foreground": {"$type": "color", "$value": "#fdfff0", "$extensions": {"source": "--custom-color-foreground; body color rgb(253, 255, 240)"}},
      "muted": {"$type": "color", "$value": "#969692", "$extensions": {"source": "computed color on Log in, Pricing, and home h2 rgb(150, 150, 146). Token --custom-color-foregroundMuted is #858580 and was not the painted muted text."}},
      "muted-token": {"$type": "color", "$value": "#858580", "$extensions": {"source": "--custom-color-foregroundMuted computed #858580, unused by the measured nav text"}},
      "surface": {"$type": "color", "$value": "#181616", "$extensions": {"source": "product menu nav computed background rgb(24, 22, 22); class dark:bg-accent"}},
      "accent": {"$type": "color", "$value": "#1d1c1b", "$extensions": {"source": "--custom-color-accent computed #1d1c1b"}},
      "accent-foreground": {"$type": "color", "$value": "#fafafa", "$extensions": {"source": "--custom-color-accent-foreground"}},
      "card": {"$type": "color", "$value": "#0a0a0a", "$extensions": {"source": "--custom-color-card"}},
      "card-foreground": {"$type": "color", "$value": "#fafafa", "$extensions": {"source": "--custom-color-card-foreground"}},
      "popover": {"$type": "color", "$value": "#0a0a0a", "$extensions": {"source": "--custom-color-popover"}},
      "primary": {"$type": "color", "$value": "#ff0055", "$extensions": {"source": "--custom-color-primary #f05. Not used as the marketing button fill."}},
      "primary-foreground": {"$type": "color", "$value": "#fafafa", "$extensions": {"source": "--custom-color-primary-foreground"}},
      "ink": {"$type": "color", "$value": "#100e0e", "$extensions": {"source": "primary button text rgb(16, 14, 14)"}},
      "cream": {"$type": "color", "$value": "#fdfff0", "$extensions": {"source": "primary button background rgb(253, 255, 240)"}},
      "border": {"$type": "color", "$value": "#242424", "$extensions": {"source": "--custom-color-border computed #242424"}},
      "border-menu": {"$type": "color", "$value": "#212121", "$extensions": {"source": "product menu border computed rgb(33, 33, 33)"}},
      "input": {"$type": "color", "$value": "#333333", "$extensions": {"source": "--custom-color-input #333"}},
      "ring": {"$type": "color", "$value": "#d4d4d4", "$extensions": {"source": "--custom-color-ring"}},
      "destructive": {"$type": "color", "$value": "#7f1d1d", "$extensions": {"source": "--custom-color-destructive computed #7f1d1d"}},
      "destructive-foreground": {"$type": "color", "$value": "#fafafa", "$extensions": {"source": "--custom-color-destructive-foreground"}},
      "muted-surface": {"$type": "color", "$value": "#262626", "$extensions": {"source": "--custom-color-muted #262626"}},
      "secondary": {"$type": "color", "$value": "#808080", "$extensions": {"source": "--custom-color-secondary computed as the keyword gray"}},
      "header": {"$type": "color", "$value": "#100e0ee6", "$extensions": {"source": "header background oklab(0.166216 0.00322251 0.00101686 / 0.9), class bg-background/90. Hex is the page colour at 90 percent."}},
      "button-secondary-bg": {"$type": "color", "$value": "#fdfff00d", "$extensions": {"source": "Talk to us computed oklab(0.994451 -0.00763747 0.0181944 / 0.05), foreground at 5 percent"}},
      "button-secondary-border": {"$type": "color", "$value": "#fdfff01a", "$extensions": {"source": "Talk to us border oklab foreground at 10 percent"}},
      "button-secondary-text": {"$type": "color", "$value": "#fdfff0b3", "$extensions": {"source": "Talk to us text oklab foreground at 70 percent"}},
      "pro": {"$type": "color", "$value": "#4ade80", "$extensions": {"source": "PRO badge text lab(78.503 -64.9265 39.7492), canvas of Tailwind green-400"}},
      "enterprise": {"$type": "color", "$value": "#60a5fa", "$extensions": {"source": "ENTERPRISE badge text lab(65.0361 -1.42065 -56.9802), canvas of Tailwind blue-400"}},
      "focus": {"$type": "color", "$value": "#99c8ff", "$extensions": {"source": "Get started free outline-color rgb(153, 200, 255) while focused. outline-style was none."}}
    },
    "shadow": {
      "menu": {
        "$type": "shadow",
        "$value": {"color": "#000000cc", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px"},
        "$extensions": {"source": "product menu box-shadow rgba(0, 0, 0, 0.8) 0px 12px 40px 0px"}
      }
    },
    "component": {
      "button-primary": {
        "bg": {"$type": "color", "$value": "{dark.color.cream}"},
        "text": {"$type": "color", "$value": "{dark.color.ink}"},
        "radius": {"$type": "dimension", "$value": "{core.radius.pill}"},
        "padding": {"$type": "dimension", "$value": "16px"},
        "height": {"$type": "dimension", "$value": "40px"}
      },
      "button-header": {
        "bg": {"$type": "color", "$value": "{dark.color.cream}"},
        "text": {"$type": "color", "$value": "{dark.color.ink}"},
        "radius": {"$type": "dimension", "$value": "{core.radius.pill}"},
        "height": {"$type": "dimension", "$value": "32px"}
      },
      "button-auth": {
        "bg": {"$type": "color", "$value": "{dark.color.cream}"},
        "text": {"$type": "color", "$value": "{dark.color.ink}"},
        "radius": {"$type": "dimension", "$value": "{core.radius.pill}"},
        "height": {"$type": "dimension", "$value": "48px"},
        "width": {"$type": "dimension", "$value": "320px"}
      }
    }
  },
  "$themes": [
    {"id": "dark", "name": "dark", "selectedTokenSets": {"core": "enabled", "dark": "enabled"}}
  ]
}
