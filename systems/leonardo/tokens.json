{
  "core": {
    "color": {
      "page": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "measured body background rgb(0, 0, 0) on https://leonardo.ai/ and sampled #000000 from home-dark-default.png before quantise"
        }
      },
      "violet": {
        "$type": "color",
        "$value": "#6e60ee",
        "$extensions": {
          "source": "sampled flat fill from home-dark-default.png display type and not-found 404, confirmed rgb(110, 96, 238) on pricing tab selected"
        }
      },
      "white": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": "measured button-login/default backgroundColor rgb(255, 255, 255)"
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": "measured button-login/default color rgb(0, 0, 0)"
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#ededed",
        "$extensions": {
          "source": "measured price/default color rgb(237, 237, 237)"
        }
      },
      "menu": {
        "$type": "color",
        "$value": "#111111",
        "$extensions": {
          "source": "sampled menu panel fill from home-dark-create-menu.png before quantise"
        }
      },
      "green": {
        "$type": "color",
        "$value": "#03e65b",
        "$extensions": {
          "source": "sampled Support and billing pill on contact-dark-default.png before quantise"
        }
      },
      "yellow": {
        "$type": "color",
        "$value": "#f8c030",
        "$extensions": {
          "source": "sampled ESSENTIAL plan label on pricing-dark-default.png before quantise"
        }
      },
      "red": {
        "$type": "color",
        "$value": "#f85848",
        "$extensions": {
          "source": "sampled ULTIMATE plan label on pricing-dark-default.png before quantise"
        }
      },
      "tab-idle": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.1)",
        "$extensions": {
          "source": "measured tab/default backgroundColor oklab white at 0.1 alpha, recorded as the equivalent sRGB alpha"
        }
      },
      "text-secondary": {
        "$type": "color",
        "$value": "rgba(255, 255, 255, 0.7)",
        "$extensions": {
          "source": "measured billing-toggle/default color oklab white at 0.7 alpha"
        }
      }
    },
    "font": {
      "sans": {
        "$type": "fontFamily",
        "$value": "canvaSans, sans-serif",
        "$extensions": {
          "source": "measured button-login/default fontFamily on https://leonardo.ai/ 2026-11-21; computed family canvaSans. Proprietary Canva face, not redistributed"
        }
      },
      "display": {
        "$type": "fontFamily",
        "$value": "ufficioDisplay, sans-serif",
        "$extensions": {
          "source": "measured h1 fontFamily ufficioDisplay on https://leonardo.ai/ 2026-11-21, size 34.425px weight 500"
        }
      },
      "poster": {
        "$type": "fontFamily",
        "$value": "leoSans, sans-serif",
        "$extensions": {
          "source": "measured hero poster spans fontFamily leoSans, size 76px, weight 900, on https://leonardo.ai/ 2026-11-21"
        }
      }
    },
    "fontWeight": {
      "medium": {
        "$type": "fontWeight",
        "$value": 500,
        "$extensions": {
          "source": "measured h1 fontWeight 500 and button-login fontWeight 500"
        }
      },
      "black": {
        "$type": "fontWeight",
        "$value": 900,
        "$extensions": {
          "source": "measured hero poster span fontWeight 900"
        }
      }
    },
    "fontSize": {
      "nav": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": "measured wordmark/default fontSize on https://leonardo.ai/ 2026-11-21 14px"
        }
      },
      "button": {
        "$type": "dimension",
        "$value": "16px",
        "$extensions": {
          "source": "measured button-login/default fontSize on https://leonardo.ai/ 2026-11-21 16px"
        }
      },
      "hero": {
        "$type": "dimension",
        "$value": "34.425px",
        "$extensions": {
          "source": "measured h1 fontSize 34.425px on https://leonardo.ai/"
        }
      },
      "price": {
        "$type": "dimension",
        "$value": "40.5px",
        "$extensions": {
          "source": "measured price/default fontSize on https://leonardo.ai/ 2026-11-21 40.5px"
        }
      },
      "poster": {
        "$type": "dimension",
        "$value": "76px",
        "$extensions": {
          "source": "measured hero poster span fontSize 76px on https://leonardo.ai/"
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "9999px",
        "$extensions": {
          "source": "Derived: computed borderRadius on button-login and pricing tabs is 3.35544e+07px, the browser's expansion of a full pill"
        }
      },
      "none": {
        "$type": "dimension",
        "$value": "0px",
        "$extensions": {
          "source": "measured display/default borderRadius on https://leonardo.ai/ 2026-11-21 0px"
        }
      }
    },
    "size": {
      "login-height": {
        "$type": "dimension",
        "$value": "35px",
        "$extensions": {
          "source": "measured button-login/default rect.h on https://leonardo.ai/ 2026-11-21 34.8px"
        }
      },
      "hero-button-height": {
        "$type": "dimension",
        "$value": "48px",
        "$extensions": {
          "source": "measured button-subscribe/default rect.h on https://leonardo.ai/ 2026-11-21 48.3px"
        }
      },
      "tab-height": {
        "$type": "dimension",
        "$value": "61px",
        "$extensions": {
          "source": "measured tab/selected rect.h on https://leonardo.ai/ 2026-11-21 60.7px"
        }
      }
    }
  },
  "dark": {
    "page": {
      "$type": "color",
      "$value": "{core.color.page}",
      "$extensions": {
        "source": "alias of measured page black"
      }
    },
    "surface": {
      "$type": "color",
      "$value": "{core.color.menu}",
      "$extensions": {
        "source": "alias of sampled menu surface"
      }
    },
    "text": {
      "$type": "color",
      "$value": "{core.color.white}",
      "$extensions": {
        "source": "alias of measured white text and login fill"
      }
    },
    "muted": {
      "$type": "color",
      "$value": "{core.color.muted}",
      "$extensions": {
        "source": "alias of measured price colour"
      }
    },
    "accent": {
      "$type": "color",
      "$value": "{core.color.violet}",
      "$extensions": {
        "source": "alias of measured violet"
      }
    },
    "border": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.16)",
      "$extensions": {
        "source": "Observed hairline on pricing cards and the Developer API pill; exact computed border was not isolated, so this is the visible white alpha. Labelled Observed, not a CSS variable."
      }
    },
    "button": {
      "login": {
        "background": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": {
            "source": "measured button-login/default backgroundColor on https://leonardo.ai/ 2026-11-21"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{core.color.ink}",
          "$extensions": {
            "source": "measured button-login/default color on https://leonardo.ai/ 2026-11-21"
          }
        }
      },
      "subscribe": {
        "background": {
          "$type": "color",
          "$value": "{core.color.violet}",
          "$extensions": {
            "source": "measured button-subscribe/default backgroundColor on https://leonardo.ai/ 2026-11-21 rgb(110, 96, 238)"
          }
        },
        "text": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": {
            "source": "measured button-subscribe/default color on https://leonardo.ai/ 2026-11-21"
          }
        }
      },
      "tutorial": {
        "text": {
          "$type": "color",
          "$value": "{core.color.white}",
          "$extensions": {
            "source": "measured button-tutorial/default color on https://leonardo.ai/ 2026-11-21"
          }
        }
      }
    },
    "tab": {
      "selected": {
        "$type": "color",
        "$value": "{core.color.violet}",
        "$extensions": {
          "source": "measured tab/selected backgroundColor on https://leonardo.ai/ 2026-11-21"
        }
      },
      "idle": {
        "$type": "color",
        "$value": "{core.color.tab-idle}",
        "$extensions": {
          "source": "measured tab/default backgroundColor on https://leonardo.ai/ 2026-11-21"
        }
      }
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "dark",
      "selectedTokenSets": {
        "core": "source",
        "dark": "enabled"
      }
    }
  ]
}
