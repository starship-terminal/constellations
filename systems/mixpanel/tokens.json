{
  "$schema": "https://schemas.design/tokens.json",
  "core": {
    "font": {
      "family": {
        "display": {
          "$type": "fontFamily",
          "$value": "Garnett Medium, sans-serif",
          "$extensions": {
            "source": "Computed font-family on the homepage h1 at https://mixpanel.com/home/, 2026-11-22, 1440 CSS px."
          }
        },
        "body": {
          "$type": "fontFamily",
          "$value": "Garnett Regular, sans-serif",
          "$extensions": {
            "source": "Computed font-family on the homepage lead paragraph, 2026-11-22."
          }
        },
        "app": {
          "$type": "fontFamily",
          "$value": "Garnett, Helvetica, Segoe UI, Arial, sans-serif",
          "$extensions": {
            "source": "Computed font-family on the login heading and email field at https://mixpanel.com/login/, 2026-11-22."
          }
        }
      }
    },
    "typography": {
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "48px",
          "fontWeight": "400",
          "lineHeight": "57.6px",
          "letterSpacing": "-0.96px"
        },
        "$extensions": {
          "source": "Computed style of the homepage h1, 'Build like your customers are right beside you', 2026-11-22."
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.body}",
          "fontSize": "16px",
          "fontWeight": "400",
          "lineHeight": "25.6px"
        },
        "$extensions": {
          "source": "Computed style of the homepage lead, 2026-11-22."
        }
      },
      "nav": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.display}",
          "fontSize": "14px",
          "fontWeight": "400",
          "lineHeight": "16.8px",
          "letterSpacing": "0.28px"
        },
        "$extensions": {
          "source": "Computed style of the Platform label in the header, 2026-11-22."
        }
      },
      "login-heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.app}",
          "fontSize": "28px",
          "fontWeight": "500",
          "lineHeight": "33.6px"
        },
        "$extensions": {
          "source": "Computed style of 'Log in to your account' at https://mixpanel.com/login/, 2026-11-22."
        }
      }
    }
  },
  "light": {
    "color": {
      "page": {
        "$type": "color",
        "$value": "#fafafa",
        "$extensions": {
          "source": "Computed body background at https://mixpanel.com/home/, rgb(250, 250, 250), 2026-11-22."
        }
      },
      "text": {
        "$type": "color",
        "$value": "#1f2023",
        "$extensions": {
          "source": "Computed color of the homepage h1, rgb(31, 32, 35), 2026-11-22."
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#797979",
        "$extensions": {
          "source": "Computed color of the header Log In label, rgb(121, 121, 121), 2026-11-22."
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#7856ff",
        "$extensions": {
          "source": "Computed background of the login Continue button, rgb(120, 86, 255), 2026-11-22."
        }
      },
      "ink": {
        "$type": "color",
        "$value": "#1f2023",
        "$extensions": {
          "source": "Computed background of the header Get Started Free pill, rgb(31, 32, 35), 2026-11-22."
        }
      },
      "login-heading": {
        "$type": "color",
        "$value": "#1b0b3b",
        "$extensions": {
          "source": "Computed color of the login h1, rgb(27, 11, 59), 2026-11-22."
        }
      },
      "link": {
        "$type": "color",
        "$value": "#5028c0",
        "$extensions": {
          "source": "Computed color of Sign up on the login wall, rgb(80, 40, 192), 2026-11-22."
        }
      }
    },
    "radius": {
      "pill": {
        "$type": "dimension",
        "$value": "100px",
        "$extensions": {
          "source": "Computed border-radius of Contact Sales and Get Started Free, 2026-11-22."
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "96px",
        "$extensions": {
          "source": "Computed border-radius of the login email field and Continue button, 2026-11-22."
        }
      }
    },
    "size": {
      "header-pill": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "source": "Measured height of the header Contact Sales and Get Started Free pills, 2026-11-22."
        }
      },
      "login-field": {
        "$type": "dimension",
        "$value": "52px",
        "$extensions": {
          "source": "Measured height of the empty login email field, 2026-11-22."
        }
      },
      "login-button": {
        "$type": "dimension",
        "$value": "46px",
        "$extensions": {
          "source": "Measured height of Continue on the login wall, 2026-11-22."
        }
      }
    }
  },
  "$themes": [
    {
      "id": "light",
      "name": "Light",
      "selectedTokenSets": {
        "core": "source",
        "light": "enabled"
      }
    }
  ]
}
