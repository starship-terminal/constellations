{
  "$schema": "https://tr.designtokens.org/format/",
  "core": {
    "font": {
      "family": {
        "sans": {
          "$type": "fontFamily",
          "$value": "-apple-system, \"SF Pro\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
          "$extensions": {
            "source": {
              "evidence": "Measured",
              "capture": "Computed fontFamily on body at https://tv.apple.com/, 2026-11-22. The stack names SF Pro. The font files are not in this package."
            }
          }
        }
      }
    },
    "radius": {
      "control": {
        "$type": "dimension",
        "$value": "6px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 6px on the header Sign In button at https://tv.apple.com/"
          }
        }
      },
      "field": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 4px on the header search input at https://tv.apple.com/"
          }
        }
      },
      "poster": {
        "$type": "dimension",
        "$value": "14px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border-radius 14px on a homepage show link at https://tv.apple.com/"
          }
        }
      }
    },
    "space": {
      "nav": {
        "$type": "dimension",
        "$value": "52px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed height 52px on .header at 1440px on https://tv.apple.com/"
          }
        }
      },
      "control": {
        "$type": "dimension",
        "$value": "28px",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed height 28px on the header Sign In button and the search field at https://tv.apple.com/"
          }
        }
      }
    }
  },
  "dark": {
    "color": {
      "page": {
        "$type": "color",
        "$value": "#1f1f1f",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed body backgroundColor rgb(31, 31, 31) on https://tv.apple.com/"
          }
        }
      },
      "header": {
        "$type": "color",
        "$value": "#000000",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed backgroundColor rgb(0, 0, 0) on .header at https://tv.apple.com/"
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": "#ffffffeb",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed body color rgba(255, 255, 255, 0.92) on https://tv.apple.com/"
          }
        }
      },
      "muted": {
        "$type": "color",
        "$value": "#ffffffa3",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgba(255, 255, 255, 0.64) on the inactive Formula 1 and MLS nav links at https://tv.apple.com/"
          }
        }
      },
      "accent": {
        "$type": "color",
        "$value": "#0a84ff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed backgroundColor rgb(10, 132, 255) on the header Sign In button at https://tv.apple.com/"
          }
        }
      },
      "onAccent": {
        "$type": "color",
        "$value": "#ffffff",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed color rgb(255, 255, 255) on the header Sign In button at https://tv.apple.com/"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "#ffffffeb",
        "$extensions": {
          "source": {
            "evidence": "Measured",
            "capture": "Computed border 1px solid rgba(255, 255, 255, 0.92) on the search input at https://tv.apple.com/"
          }
        }
      }
    }
  },
  "$themes": [
    {
      "id": "dark",
      "name": "Dark",
      "selectedTokenSets": { "core": "enabled", "dark": "enabled" }
    }
  ]
}
