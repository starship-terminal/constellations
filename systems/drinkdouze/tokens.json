{
 "core": {
  "$description": "Douze primitives read from drinkdouze.com :root and computed styles, 2026-11-21. One light theme.",
  "color": {
   "dusk": {
    "$value": "#301816",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-dusk on :root (raw/root-vars.json); matches computed color rgb(48, 24, 22) of body, nav and add-to-cart background (raw/measurements.json)"
    }
   },
   "sable": {
    "$value": "#f6f2e9",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-sable and --secondary-background 246, 242, 233 on :root (raw/root-vars.json); matches computed footer background"
    }
   },
   "paper": {
    "$value": "#ffffff",
    "$type": "color",
    "$extensions": {
     "source": "declared --background 255, 255, 255 and computed html background rgb(255, 255, 255) (raw/root-vars.json)"
    }
   },
   "onAccent": {
    "$value": "#ffffff",
    "$type": "color",
    "$extensions": {
     "source": "declared --primary-button-text-color 255, 255, 255; computed color of .button and .product-form__add-button (raw/measurements.json)"
    }
   },
   "border": {
    "$value": "#321a18",
    "$type": "color",
    "$extensions": {
     "source": "declared --border-color 50, 26, 24 on :root (raw/root-vars.json)"
    }
   },
   "borderStrong": {
    "$value": "#aca3a2",
    "$type": "color",
    "$extensions": {
     "source": "declared --border-color-darker 172, 163, 162 on :root (raw/root-vars.json)"
    }
   },
   "soldOut": {
    "$value": "#5b5b5b",
    "$type": "color",
    "$extensions": {
     "source": "declared --product-sold-out-accent 91, 91, 91 on :root (raw/root-vars.json)"
    }
   },
   "sage": {
    "$value": "#c7ddc2",
    "$type": "color",
    "$extensions": {
     "source": "declared --success-color and --product-custom-label-2-background 199, 221, 194 on :root (raw/root-vars.json)"
    }
   },
   "sageWash": {
    "$value": "#f4f8f3",
    "$type": "color",
    "$extensions": {
     "source": "declared --success-background 244, 248, 243 on :root (raw/root-vars.json)"
    }
   },
   "errorWash": {
    "$value": "#fbfdfb",
    "$type": "color",
    "$extensions": {
     "source": "declared --error-background 251, 253, 251 on :root (raw/root-vars.json). --error-color is the same triplet as --success-color; recorded as not a distinct danger role"
    }
   },
   "lowStock": {
    "$value": "#df6464",
    "$type": "color",
    "$extensions": {
     "source": "declared --product-low-stock-text-color 223, 100, 100 on :root (raw/root-vars.json)"
    }
   },
   "inStock": {
    "$value": "#2e9e7b",
    "$type": "color",
    "$extensions": {
     "source": "declared --product-in-stock-text-color 46, 158, 123 on :root (raw/root-vars.json)"
    }
   },
   "flavorApricot": {
    "$value": "#f4a765",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-flavor-abricot-zaatar on :root (raw/root-vars.json)"
    }
   },
   "flavorPear": {
    "$value": "#f3eea7",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-flavor-poire-anis on :root (raw/root-vars.json)"
    }
   },
   "flavorOrange": {
    "$value": "#f26554",
    "$type": "color",
    "$extensions": {
     "source": "declared --color-flavor-orange-piment on :root (raw/root-vars.json)"
    }
   },
   "heroInk": {
    "$value": "#f6f2e9",
    "$type": "color",
    "$extensions": {
     "source": "computed color of .image-hero__heading on the home hero (raw/measurements.json)"
    }
   }
  },
  "font": {
   "display": {
    "$value": "Boogy, sans-serif",
    "$type": "fontFamily",
    "$extensions": {
     "source": "declared --heading-font-family on :root; computed font of .heading.h1 (raw/measurements.json)"
    }
   },
   "displayItalic": {
    "$value": "\"Boogy Italic\", sans-serif",
    "$type": "fontFamily",
    "$extensions": {
     "source": "declared --heading-font-family-italic on :root (raw/root-vars.json). @font-face Boogy and Boogy Italic, font-display swap (raw/css-vars.json)"
    }
   },
   "body": {
    "$value": "\"Robin Regular\", sans-serif",
    "$type": "fontFamily",
    "$extensions": {
     "source": "declared --text-font-family on :root; computed font of body (raw/measurements.json)"
    }
   },
   "label": {
    "$value": "\"Robin Semibold\", sans-serif",
    "$type": "fontFamily",
    "$extensions": {
     "source": "declared --text-font-family-semibold on :root; computed font of .header__linklist-link and .button (raw/measurements.json)"
    }
   }
  },
  "typography": {
   "display": {
    "$value": {
     "fontFamily": "{font.display}",
     "fontSize": "72px",
     "fontWeight": 300,
     "lineHeight": "64.8px",
     "letterSpacing": "-0.72px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "declared --heading-h1-font-size 72px and --heading-font-weight 300; computed size/weight/line-height/letter-spacing of .heading.h1 Our spritzes (raw/measurements.json)"
    }
   },
   "heading2": {
    "$value": {
     "fontFamily": "{font.display}",
     "fontSize": "52px",
     "fontWeight": 300,
     "lineHeight": "52px",
     "letterSpacing": "-0.52px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "declared --heading-h2-font-size 52px; computed .heading.h2 (raw/measurements.json)"
    }
   },
   "heading4": {
    "$value": {
     "fontFamily": "{font.display}",
     "fontSize": "35px",
     "fontWeight": 300,
     "lineHeight": "39.2px",
     "letterSpacing": "0.35px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "declared --heading-h4-font-size 35px; computed .heading.h4 (raw/measurements.json)"
    }
   },
   "body": {
    "$value": {
     "fontFamily": "{font.body}",
     "fontSize": "16px",
     "fontWeight": 500,
     "lineHeight": "19.2px",
     "letterSpacing": "0px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "declared --base-font-size 16px and --text-font-weight 500; computed body (raw/measurements.json)"
    }
   },
   "nav": {
    "$value": {
     "fontFamily": "{font.label}",
     "fontSize": "12px",
     "fontWeight": 500,
     "lineHeight": "13.2px",
     "letterSpacing": "1.2px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed .header__linklist-link, text-transform uppercase (raw/measurements.json)"
    }
   },
   "button": {
    "$value": {
     "fontFamily": "{font.label}",
     "fontSize": "12px",
     "fontWeight": 500,
     "lineHeight": "14.4px",
     "letterSpacing": "0.96px"
    },
    "$type": "typography",
    "$extensions": {
     "source": "computed .button and .product-form__add-button, text-transform uppercase (raw/measurements.json)"
    }
   }
  },
  "radius": {
   "none": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --button-border-radius 0px (raw/root-vars.json); computed border-radius of .button"
    }
   },
   "pill": {
    "$value": "999px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed border-radius of .tabs-nav__item (raw/measurements.json)"
    }
   },
   "block": {
    "$value": "45px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --block-border-radius and --section-border-radius 45px; computed footer border-radius (raw/measurements.json)"
    }
   },
   "blockReduced": {
    "$value": "16px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --block-border-radius-reduced 16px (raw/root-vars.json)"
    }
   }
  },
  "space": {
   "gutter": {
    "$value": "73px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --container-gutter 73px on :root at 1440 (raw/root-vars.json)"
    }
   },
   "buttonX": {
    "$value": "15px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed padding of .button 0px 15px (raw/measurements.json)"
    }
   },
   "buttonXWide": {
    "$value": "20px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed padding of .product-form__add-button 0px 20px (raw/measurements.json)"
    }
   }
  },
  "size": {
   "button": {
    "$value": "52px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --button-height 52px (raw/root-vars.json)"
    }
   },
   "buttonSmall": {
    "$value": "44px",
    "$type": "dimension",
    "$extensions": {
     "source": "declared --button-small-height 44px; computed height of .tabs-nav__item (raw/measurements.json)"
    }
   },
   "header": {
    "$value": "57px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of store-header at 1440 (raw/measurements.json)"
    }
   },
   "announcement": {
    "$value": "36px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of the announcement bar at 1440 (raw/measurements.json)"
    }
   },
   "logo": {
    "$value": "70px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed width of .header__logo-link (raw/measurements.json). Height was 23px"
    }
   },
   "navLink": {
    "$value": "13px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed height of .header__linklist-link (raw/measurements.json)"
    }
   }
  },
  "layout": {
   "desktop": {
    "$value": "1440px",
    "$type": "dimension",
    "$extensions": {
     "source": "measured window.innerWidth on desktop captures (screenshots/*.png.capture.json, kept beside the raw shots)"
    }
   },
   "phone": {
    "$value": "390px",
    "$type": "dimension",
    "$extensions": {
     "source": "measured window.innerWidth on mobile-* captures"
    }
   }
  },
  "focus": {
   "ring": {
    "$value": "0px",
    "$type": "dimension",
    "$extensions": {
     "source": "computed outline of .product-form__add-button after focus was rgb(255, 255, 255) none 0px (raw/measurements.json). Not captured as a painted ring"
    }
   }
  }
 },
 "light": {
  "$description": "Semantic roles for the single light storefront. Aliases of core.",
  "background": {
   "page": {
    "$value": "{color.paper}",
    "$type": "color",
    "$extensions": {
     "source": "html background is the declared --background paper"
    }
   },
   "surface": {
    "$value": "{color.sable}",
    "$type": "color",
    "$extensions": {
     "source": "footer, header bubble and login card use --secondary-background / --color-sable"
    }
   },
   "inverse": {
    "$value": "{color.dusk}",
    "$type": "color",
    "$extensions": {
     "source": "primary button and selected filter fill"
    }
   }
  },
  "text": {
   "primary": {
    "$value": "{color.dusk}",
    "$type": "color",
    "$extensions": {
     "source": "body and nav computed color"
    }
   },
   "onAccent": {
    "$value": "{color.onAccent}",
    "$type": "color",
    "$extensions": {
     "source": "button label color"
    }
   },
   "onHero": {
    "$value": "{color.heroInk}",
    "$type": "color",
    "$extensions": {
     "source": "hero heading over the product photograph"
    }
   },
   "muted": {
    "$value": "{color.soldOut}",
    "$type": "color",
    "$extensions": {
     "source": "declared sold-out accent; the only muted grey on :root"
    }
   },
   "link": {
    "$value": "{color.dusk}",
    "$type": "color",
    "$extensions": {
     "source": "nav and footer links use the same dusk ink"
    }
   }
  },
  "border": {
   "default": {
    "$value": "{color.border}",
    "$type": "color",
    "$extensions": {
     "source": "declared --border-color"
    }
   },
   "strong": {
    "$value": "{color.borderStrong}",
    "$type": "color",
    "$extensions": {
     "source": "declared --border-color-darker"
    }
   }
  },
  "accent": {
   "default": {
    "$value": "{color.dusk}",
    "$type": "color",
    "$extensions": {
     "source": "primary button background; there is no second brand accent"
    }
   }
  },
  "status": {
   "success": {
    "$value": "{color.sage}",
    "$type": "color",
    "$extensions": {
     "source": "declared --success-color"
    }
   },
   "inStock": {
    "$value": "{color.inStock}",
    "$type": "color",
    "$extensions": {
     "source": "declared --product-in-stock-text-color"
    }
   },
   "lowStock": {
    "$value": "{color.lowStock}",
    "$type": "color",
    "$extensions": {
     "source": "declared --product-low-stock-text-color"
    }
   }
  },
  "component": {
   "button": {
    "bg": {
     "$value": "{color.dusk}",
     "$type": "color",
     "$extensions": {
      "source": "computed background of .button and .product-form__add-button"
     }
    },
    "text": {
     "$value": "{color.onAccent}",
     "$type": "color",
     "$extensions": {
      "source": "computed color of those buttons"
     }
    },
    "radius": {
     "$value": "{radius.none}",
     "$type": "dimension",
     "$extensions": {
      "source": "declared --button-border-radius"
     }
    },
    "height": {
     "$value": "{size.buttonSmall}",
     "$type": "dimension",
     "$extensions": {
      "source": "computed height of the small button; --button-height is 52px"
     }
    }
   },
   "field": {
    "bg": {
     "$value": "{color.paper}",
     "$type": "color",
     "$extensions": {
      "source": "login fields sit on the paper page inside the sable card"
     }
    },
    "text": {
     "$value": "{color.dusk}",
     "$type": "color",
     "$extensions": {
      "source": "field label and placeholder ink"
     }
    },
    "radius": {
     "$value": "{radius.blockReduced}",
     "$type": "dimension",
     "$extensions": {
      "source": "computed border-radius of the login email and password fields is 16px (raw/measurements.json login.email and login.password); matches declared --block-border-radius-reduced"
     }
    }
   }
  }
 },
 "$themes": [
  {
   "id": "light",
   "name": "Light",
   "selectedColor": "#301816",
   "group": "light"
  }
 ]
}
