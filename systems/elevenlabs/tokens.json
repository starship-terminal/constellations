          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of nav default (raw/components-computed.json)"
          },
          "$description": "The desktop nav height."
        },
        "height-mobile": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed height of m-header default (raw/components-computed.json)"
          },
          "$description": "The mobile header height."
        }
