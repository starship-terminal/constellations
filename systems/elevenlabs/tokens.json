{
  "core": {
    "font": {
      "family": {
        "display": {
          "$value": "Waldenburg, \"Waldenburg Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of hero-title default (raw/components-computed.json); the @font-face blocks are served from eleven-public-cdn.elevenlabs.io (raw/css-vars.json fonts)"
          },
          "$description": "The Waldenburg display family on the hero headline and headings."
        },
        "sans": {
          "$value": "Inter, \"Inter Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "computed fontFamily of nav-trigger default (raw/components-computed.json); the @font-face blocks are served from eleven-public-cdn.elevenlabs.io (raw/css-vars.json fonts)"
          },
          "$description": "The UI sans the nav, buttons and body text paint (Inter/Waldenburg as the page serves it)."
        },
        "mono": {
          "$value": "\"Geist Mono\",\"Geist Mono Fallback\"",
          "$type": "fontFamily",
          "$extensions": {
            "source": "declared --font-geist-mono on .__variable_7e8bea (raw/css-vars.json theme rules)"
          },
          "$description": "The monospace stack (Geist Mono) for code."
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The regular body/lede weight."
        },
        "medium": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of nav-trigger default (raw/components-computed.json)"
          },
          "$description": "The medium weight on nav items and controls."
        },
        "semibold": {
          "$value": 400,
          "$type": "fontWeight",
          "$extensions": {
            "source": "computed fontWeight of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The semibold weight on button labels."
        }
      },
      "size": {
        "display-hero": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-title default (raw/components-computed.json)"
          },
          "$description": "The hero display size."
        },
        "display": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of pricing-h1 default (raw/components-computed.json)"
          },
          "$description": "The page-title display (pricing)."
        },
        "display-tts": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of tts-display default (raw/components-computed.json)"
          },
          "$description": "The product-page display (text-to-speech)."
        },
        "display-mobile": {
          "$value": "36px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-hero default (raw/components-computed.json)"
          },
          "$description": "The display size at 390 wide."
        },
        "h2": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of section-h2 default (raw/components-computed.json)"
          },
          "$description": "The section heading."
        },
        "page-title": {
          "$value": "48px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of api-h1 default (raw/components-computed.json)"
          },
          "$description": "The API page title."
        },
        "lede": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of hero-sub default (raw/components-computed.json)"
          },
          "$description": "The hero lede."
        },
        "body": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of tts-textarea default (raw/components-computed.json)"
          },
          "$description": "The playground textarea/body size."
        },
        "menu-item": {
          "$value": "14px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of m-nav-item default (raw/components-computed.json)"
          },
          "$description": "The mobile-menu rows."
        },
        "control": {
          "$value": "16px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-cta default (raw/components-computed.json)"
          },
          "$description": "The control/button text."
        },
        "meta": {
          "$value": "13px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-badge default (raw/components-computed.json)"
          },
          "$description": "The small meta/badge text."
        },
        "price": {
          "$value": "20px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed fontSize of plan-price default (raw/components-computed.json)"
          },
          "$description": "The plan price figure."
        }
      },
      "lineHeight": {
        "display-hero": {
          "$value": "52px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-title default (raw/components-computed.json)"
          },
          "$description": "Hero display leading."
        },
        "display": {
          "$value": "52px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of pricing-h1 default (raw/components-computed.json)"
          },
          "$description": "Page-title leading."
        },
        "h2": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of section-h2 default (raw/components-computed.json)"
          },
          "$description": "Heading leading."
        },
        "lede": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of hero-sub default (raw/components-computed.json)"
          },
          "$description": "Lede leading."
        },
        "body": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of tts-textarea default (raw/components-computed.json)"
          },
          "$description": "Body leading."
        },
        "control": {
          "$value": "24px",
          "$type": "dimension",
          "$extensions": {
            "source": "computed lineHeight of plan-cta default (raw/components-computed.json)"
          },
          "$description": "Control leading."
        }
      }
    },
    "color": {
      "brand": {
        "ink": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of signup-cta default (raw/components-computed.json)"
          },
          "$description": "The near-black action fill: the Sign up pill, every plan CTA, the playground Play button."
        },
        "ink-hover": {
          "$value": "#44403b",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of signup-cta hover (raw/components-computed.json)"
          },
          "$description": "The hover step the black pills take."
        },
        "ink-pressed": {
          "$value": "#44403b",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of signup-cta pressed (raw/components-computed.json)"
          },
          "$description": "The pressed step."
        },
        "accent": {
          "$value": "#2b7fff",
          "$type": "color",
          "$extensions": {
            "source": "declared caret-color #2b7fff on the Tailwind utility class .caret-focus (raw/css-vars.json palette); the blue of the gradients and links"
          },
          "$description": "The blue accent (Tailwind blue-500) the gradients, links and interactive UI paint."
        },
        "destructive": {
          "$value": "#ef4444",
          "$type": "color",
          "$extensions": {
            "source": "css-var --shadcn-destructive resolved light (raw/css-vars.json): an 'H S% L%' channel triplet converted here"
          },
          "$description": "The declared destructive red (hsl 0 84.2% 60.2%)."
        },
        "ring": {
          "$value": "#0a0a0a",
          "$type": "color",
          "$extensions": {
            "source": "css-var --shadcn-ring resolved light (raw/css-vars.json): an 'H S% L%' channel triplet converted here"
          },
          "$description": "The declared focus-ring colour (hsl 0 0% 3.9% — near-black)."
        }
      },
      "neutral": {
        "ink": {
          "$value": "#000000",
          "$type": "color",
          "$extensions": {
            "source": "computed color of nav-link default (raw/components-computed.json)"
          },
          "$description": "The near-black ink on nav text, headings and button labels."
        },
        "muted": {
          "$value": "#777169",
          "$type": "color",
          "$extensions": {
            "source": "computed color of menu-link default (raw/components-computed.json); menu-link: read from the wrong element (its default and pressed states caught a same-href link far down the page, not the flyout's); recapture needed"
          },
          "$description": "The warm grey on flyout links, the product pill, the billing select and secondary text."
        },
        "white": {
          "$value": "#ffffff",
          "$type": "color",
          "$extensions": {
            "source": "computed backgroundColor of signin-card default (raw/components-computed.json)"
          },
          "$description": "The #ffffff surface: cards, the flyout panel, the auth card."
        },
        "wash-hover": {
          "$value": "rgba(41, 37, 36, 0.05)",
          "$type": "color",
          "$extensions": {
            "source": "painted bg of nav-link hover's inner layer (raw/components-computed.json paint)"
          },
          "$description": "The 5% warm-ink wash a nav item's inner chip takes on hover."
        },
        "wash-pressed": {
          "$value": "rgba(0, 0, 0, 0.043)",
          "$type": "color",
          "$extensions": {
            "source": "painted bg of oauth-google pressed's inner layer (raw/components-computed.json paint)"
          },
          "$description": "The deeper wash a ghost/OAuth button takes on pressed (nav items keep the hover wash)."
        },
        "eggshell": {
          "$value": "#fdfcfc",
          "$type": "color",
          "$extensions": {
            "source": "css-var --eggshell (light); css-var --eggshell resolved light (raw/css-vars.json)"
          },
          "$description": "The #FDFCFC eggshell page field."
        },
        "page-bg": {
          "$value": "#fdfcfc",
          "$type": "color",
          "$extensions": {
            "source": "css-var --page-background-color (light); css-var --page-background-color resolved light (raw/css-vars.json)"
          },
          "$description": "The page background role, bound to --eggshell."
        },
        "border": {
          "$value": "#e5e5e5",
          "$type": "color",
          "$extensions": {
            "source": "css-var --shadcn-border resolved light (raw/css-vars.json): an 'H S% L%' channel triplet converted here"
          },
          "$description": "The declared hairline border grey (hsl 0 0% 89.8%)."
        }
      }
    },
    "radius": {
      "pill": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of signup-cta default (raw/components-computed.json)"
        },
        "$description": "The pill radius on buttons and CTAs (likely 9999px)."
      },
      "button-ghost": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of contact-sales default (raw/components-computed.json)"
        },
        "$description": "The ghost-button radius."
      },
      "field": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of email-field default (raw/components-computed.json)"
        },
        "$description": "The auth-field radius."
      },
      "tab": {
        "$value": "9999px",
        "$type": "dimension",
        "$extensions": {
          "source": "computed borderTopLeftRadius of tool-tab default (raw/components-computed.json)"
        },
        "$description": "The showcase-tab radius."
      },
      "card": {
        "$value": "16px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --rounded-card (light); css-var --rounded-card resolved light (raw/css-vars.json)"
        },
        "$description": "The declared card radius."
      },
      "card-sm": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --rounded-card-sm (light); css-var --rounded-card-sm resolved light (raw/css-vars.json)"
        },
        "$description": "The declared small-card radius."
      }
    },
    "space": {
      "inset": {
        "$value": "20px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --spacing-inset (light); css-var --spacing-inset resolved light (raw/css-vars.json)"
        },
        "$description": "The declared inset padding (1.25rem)."
      },
      "gutter": {
        "$value": "12px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --spacing-gutter (light); css-var --spacing-gutter resolved light (raw/css-vars.json)"
        },
        "$description": "The declared content gutter."
      },
      "section-md": {
        "$value": "80px",
        "$type": "dimension",
        "$extensions": {
          "source": "css-var --section-py-md (light); css-var --section-py-md resolved light (raw/css-vars.json)"
        },
        "$description": "The declared medium section vertical padding (5rem at desktop)."
      }
    },
    "measured": {
      "focus-ring-light": {
        "$value": "#2b7fff",
        "$type": "color",
        "$extensions": {
          "source": "computed outlineColor of signup-cta focus-visible (raw/components-computed.json)"
        },
        "$description": "The keyboard focus ring on light surfaces."
      },
      "focus-ring-nav": {
        "$value": "#2b7fff",
        "$type": "color",
        "$extensions": {
          "source": "painted outline of nav-trigger focus-visible's inner layer (raw/components-computed.json paint): 1px solid rgb(43, 127, 255) offset 2px"
        },
        "$description": "The keyboard ring on nav controls — drawn on the inner chip, not the root (whose 2px outline stays transparent)."
      },
      "control-transition": {
        "$value": "150ms",
        "$type": "duration",
        "$extensions": {
          "source": "computed transition of plan-cta default (raw/components-computed.json)"
        },
        "$description": "The control transition (background-color etc.). (background-color, color, box-shadow, border-color)"
      },
      "pressed-scale": {
        "$value": 0.98,
        "$type": "number",
        "$extensions": {
          "source": "pressed rect / default rect of plan-cta (raw/components-computed.json)"
        },
        "$description": "The scale a pressed button takes."
      }
    }
  },
  "light": {
    "text": {
      "primary": {
        "$value": "{color.neutral.ink}",
        "$type": "color",
        "$extensions": {
          "source": "role alias over the core palette"
        },
