# Local secrets for this checkout. Copy to .env and fill in real values;
# .env is gitignored. refero_media.py loads .env on import, so every tool
# under tools/refero/ (and anything importing it, like tools/catalog.py)
# picks these up automatically. Variables already set in the shell win.

# StatiCrypt password used when the built site is encrypted.
STATICRYPT_PASSWORD=

# Anthropic API key for tools/refero/classify.py.
ANTHROPIC_API_KEY=

# Cloudflare R2 credentials for tools/refero/upload_r2.py. Create an R2 API
# token (R2 -> Manage R2 API Tokens) with Object Read & Write on the bucket,
# then copy the Access Key ID and Secret Access Key it shows.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=design-systems-media

# Where mirrored refero media lives on this machine. Defaults to
# ~/services/design-systems/media/refero.
# DESIGN_SYSTEMS_MEDIA=

# Base URL the emitted refero JSON carries as mediaBase; the app prepends it
# to /refero-media/... paths. Defaults to the public R2 bucket. Set empty to
# serve media site-locally (local mirror or the deployed nginx alias).
# DESIGN_SYSTEMS_MEDIA_BASE=
