# Local secrets for this checkout. Copy to .env and fill in real values;
# .env is gitignored. refero_media.py loads .env on import, so tools that
# touch refero media (and anything importing it, like tools/catalog.py)
# pick these up automatically, as do server/ and web/, which read the root
# .env too. Variables already set in the shell win.

# Anthropic API key for tools/refero/classify.py. Also the gallery chat's
# fallback provider while no provider is saved under Settings > Model provider.
ANTHROPIC_API_KEY=

# Cloudflare R2 credentials for tools/refero/upload_r2.py. Create an R2 API
# token (R2 -> Manage R2 API Tokens) with Object Read & Write on the bucket,
# then copy the Access Key ID and Secret Access Key it shows.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=design-systems-media

# Where mirrored refero media lives on this machine. Defaults to
# ~/services/design-systems/media/refero.
# DESIGN_SYSTEMS_MEDIA=

# Base URL the emitted refero JSON carries as mediaBase; the app prepends it
# to /refero-media/... paths. Defaults to the public R2 bucket. Set empty to
# serve media site-locally (local mirror or the deployed nginx alias).
# DESIGN_SYSTEMS_MEDIA_BASE=

# Extra Host names the Python /api/ server (server/api.py) answers to, comma-
# separated, `name` or `name:port`. Loopback, IP literals and *.ts.net already
# pass; anything else is refused as possible DNS rebinding.
# DESIGN_SYSTEMS_ALLOWED_HOSTS=designs.example.test

# Extra model-provider hosts the chat and the provider test may call, comma-
# separated, read by server/chat.py and the web app. The known model APIs
# (api.anthropic.com, api.openai.com, Gemini, xAI, OpenRouter, ...) already
# pass. A name also covers its subdomains; a loopback name or IP address must
# be listed exactly, which is how a self-hosted model on this machine is
# allowed, e.g. localhost,127.0.0.1 for one on http://localhost:11434.
# DESIGN_SYSTEMS_PROVIDER_HOSTS=models.example.test,localhost

# Optional: the model the gallery chat calls with ANTHROPIC_API_KEY, while no
# provider is saved. Read by server/chat.py and the web app.
# DS_CHAT_MODEL=

# Optional: the folder that holds the provider saved under Settings > Model
# provider (provider.db, a one-row SQLite database, mode 0600, key included).
# Defaults to ~/.config/design-systems. It must be an absolute path outside
# the checkout; the app itself expands a leading ~/ (a .env file and systemd's
# Environment= do not). A relative path or a folder inside the checkout is
# refused and the chat reports why. The gallery app and the Python /api/
# server must see the same folder to share the saved key.
# DESIGN_SYSTEMS_CONFIG_DIR=~/.config/design-systems

# Optional: this checkout's path, when web/ cannot find it by itself.
# DESIGN_SYSTEMS_REPO=
