{
 "_note": "Pixel rectangles and UI-word keep lists for systems/notebooklm. Coordinates only; no private text. 2400x1594 is a 1200x797 window at 2x. Every OCR line outside the keep list is painted out.",
 "ocr": {
  "net": true,
  "emails": true,
  "email_allow": [
   "@example\\.com$",
   "@example\\.org$"
  ],
  "keep": [
   "^\\W*(Sources|Chat|Studio|Title|Created|Role|Owner|Settings|PRO|All|Discover|Collections|My notebooks|Most recent|Featured|Create new|Create notebook|App|Next|Save|Copy link|Cancel|Delete|Rename|Share|Remove|Edit|Reports?|Quiz|Flashcards|Infographic|Mind Map|Data Table|Slide Deck|Audio|Video|New!?|Try it|Add note|Add sources|Select all|Source guide|Restricted|Anyone with the link)\\W*$",
   "^\\W*(Audio|Video|Infograp|Slide)",
   "Gemini Notebook",
   "^\\d+ [Ss]ources?$",
   "\\b\\d+ sources?$",
   "Ask a question",
   "Search the web",
   "Add people and groups",
   "People with access",
   "Notebook Access",
   "Notify people",
   "Only people with access",
   "Good content",
   "Bad content",
   "View \\d+ sources",
   "View source",
   "^[A-Z][a-z]{2} \\d{1,2}, \\d{4}$",
   "^\\d+d ago$",
   "^\\W*(Configure|Customize|Notebook settings|Conversational style|Response length|Default|Longer|Shorter|Learning Guide|Analyst|Guide|Custom|Learn more|Continue|Got it|Dismiss)\\W*$",
   "^(Light|Dark|Device|Theme|Settings|Sort by|Title|Created|Last opened|Most recent|Select|Language)\\W*$",
   "My notebooks",
   "Discover",
   "Collections"
  ],
  "boost": [
   "screenshots/*.png"
  ]
 },
