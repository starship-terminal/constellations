# Keys can also be pasted in Settings > AI, where they save to the personal
# database and override these. Either way they remain server-side and are
# never returned to the UI. Copy to .env.local.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional source checkout and existing Refero media mirror.
# DESIGN_SYSTEMS_REPO=/absolute/path/to/design-systems
# DESIGN_SYSTEMS_MEDIA=/absolute/path/to/media/refero
# Personal database lives outside the checkout by default.
# DESIGN_RESEARCH_DATA_DIR=/absolute/path/to/personal-data
# Optional initial provider/model. Settings can override these without storing keys.
# DESIGN_RESEARCH_PROVIDER=openai
# DESIGN_RESEARCH_MODEL=gpt-4.1-mini
# DESIGN_RESEARCH_BASE_URL=https://your-compatible-endpoint/v1
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://your-compatible-endpoint/v1
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://your-anthropic-proxy
# Optional exact Tailscale Serve origin, with no trailing slash. Keep the
# listener on loopback and do not enable Funnel. Other non-loopback hosts fail.
# DESIGN_RESEARCH_PRIVATE_ORIGIN=https://your-host.your-tailnet.ts.net:8108
