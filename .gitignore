.DS_Store
node_modules/

# Proprietary web fonts a product's style guide can use locally. Not ours to commit.
systems/*/fonts/

# Capture working files. Raw page copies hold private account data and live outside the repo.
systems/*/tools/capture/winid
systems/*/tools/capture/dumps/
systems/*/tools/capture/out/
# shot.py's full-window grab, preview and window id; parse_css.py's downloaded
# stylesheets and scripts (the product's property) and the stats it writes from them.
systems/*/tools/capture/_raw.png
systems/*/tools/capture/_preview.png
systems/*/tools/capture/.wid
systems/duolingo/tools/capture/css/
systems/duolingo/tools/capture/js/
systems/duolingo/tools/capture/css-stats.json
systems/duolingo/tools/capture/css-stats.md

# Clones of public reference repos; only example/README.md is committed.
/example/*/

# The docs site. `make build` writes the app's data under web/data/ and the
# scorecard pages under docs/scorecard/; `make docs` builds docs/ into site/.
/site/
/web/data/
docs/scorecard/
/.venv
# Local secrets (API keys, R2 credentials); see .env.example. `.env*` also
# covers web/.env.local and app/.env.local, which Next loads.
.env*
!.env.example
# The chat's saved provider key (web/lib/provider-store.ts, server/
# provider_store.py). Both refuse a folder inside the checkout; this is the
# second line of defence.
provider.db*
*.key
secrets/
__pycache__/
systems/*/raw/*.partial.json
# Full-colour page captures a capture run writes before quantizing. AGENTS.md keeps
# raw page copies outside the repo; the package wave deleted the committed ones.
systems/*/raw/full/
systems/*/raw/signed-in/*.png

# Refero fetch working files (result JSONs are also stored in refero.db).
/refero/.work/

# wrangler CLI local state (account cache)
.wrangler/

# Compiled capture helpers (swiftc output of the .swift sources beside them).
/systems/zed-desktop/tools/capture/zwin
/systems/zed-desktop/tools/capture/mouse
/systems/zed-desktop/tools/capture/wins
