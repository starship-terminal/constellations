    "html": "<style>\n  :root {\n    --color-death-black: #000000;\n    --color-bone-white: #ffffff;\n    --color-off-black: #151515;\n    --color-ash-gray: #e3e3e3;\n    --color-gravel-gray: #727272;\n    --color-light-ash: #f5f5f5;\n    --color-charcoal: #232323;\n    --color-input-border: #999999;\n    --color-polished-gold: #d2ac5a;\n    --color-antique-gold: #8a6d35;\n    --font-acumin-pro: 'Inter', 'Roboto', sans-serif;\n    --font-acumin-pro-condensed: 'Roboto Condensed', sans-serif;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n</style>\n<div style=\"width:600px;font-family:var(--font-acumin-pro);\">\n\n  <!-- Email Capture Banner -->\n  <div style=\"background:var(--color-ash-gray);padding:36px 40px;text-align:center;\">\n    <div style=\"font-family:var(--font-acumin-pro);font-size:22px;font-weight:700;color:var(--color-off-black);text-transform:uppercase;letter-spacing:0.031em;line-height:1.13;margin-bottom:8px;\">Wanna Cheat On Your Other<br>Beverage Company?</div>\n    <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:400;color:var(--color-off-black);line-height:1.67;max-width:400px;margin:0 auto 24px auto;\">\n      Let us hit you up sometime to make you laugh and shower you with special deals. We'll even gift you <strong>2 FREE Liquid Death Can Coolers</strong> to keep your beverages ice-cold.\n    </div>\n    <div style=\"display:flex;gap:0;max-width:440px;margin:0 auto;\">\n      <input\n        type=\"email\"\n        placeholder=\"EMAIL\"\n        style=\"flex:1;background:var(--color-bone-white);color:var(--color-death-black);border:1px solid var(--color-input-border);border-right:none;font-family:var(--font-acumin-pro);font-size:14px;font-weight:400;letter-spacing:0.056em;padding:14px 16px;border-radius:0;outline:none;\"\n      />\n      <button style=\"background:var(--color-death-black);color:var(--color-bone-white);border:none;font-family:var(--font-acumin-pro);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:0.063em;padding:14px 22px;border-radius:0;cursor:pointer;white-space:nowrap;\">Hell Yes</button>\n    </div>\n  </div>\n\n  <!-- Join the Club Banner -->\n  <a href=\"#\" style=\"display:flex;align-items:center;justify-content:space-between;background:var(--color-death-black);color:var(--color-bone-white);padding:24px 36px;text-decoration:none;border-bottom:1px solid var(--color-charcoal);\">\n    <span style=\"font-family:var(--font-acumin-pro);font-size:22px;font-weight:700;text-transform:uppercase;letter-spacing:0.031em;color:var(--color-bone-white);\">Join the Club</span>\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M9 18L15 12L9 6\" stroke=\"#ffffff\" stroke-width=\"2.5\" stroke-linecap=\"square\" stroke-linejoin=\"miter\"/>\n    </svg>\n  </a>\n\n  <!-- Sell Liquid Death Banner -->\n  <a href=\"#\" style=\"display:flex;align-items:center;justify-content:space-between;background:var(--color-death-black);color:var(--color-bone-white);padding:24px 36px;text-decoration:none;\">\n    <span style=\"font-family:var(--font-acumin-pro);font-size:22px;font-weight:700;text-transform:uppercase;letter-spacing:0.031em;color:var(--color-bone-white);\">Sell Liquid Death</span>\n    <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <path d=\"M9 18L15 12L9 6\" stroke=\"#ffffff\" stroke-width=\"2.5\" stroke-linecap=\"square\" stroke-linejoin=\"miter\"/>\n    </svg>\n  </a>\n\n  <!-- Free Shipping Announcement Bar -->\n  <div style=\"background:var(--color-bone-white);border-top:1px solid var(--color-ash-gray);padding:12px 24px;text-align:center;\">\n    <span style=\"font-family:var(--font-acumin-pro);font-size:13px;font-weight:400;color:var(--color-off-black);letter-spacing:0.02em;\">Free shipping to Espa\u00f1a on all orders above \u20ac120.00</span>\n  </div>\n\n</div>",
    "name": "Full-Width Banner CTAs + Email Capture",
    "role": "",
    "description": ""
