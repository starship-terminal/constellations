    "html": "<style>\n  :root {\n    --color-death-black: #000000;\n    --color-bone-white: #ffffff;\n    --color-off-black: #151515;\n    --color-ash-gray: #e3e3e3;\n    --color-gravel-gray: #727272;\n    --color-light-ash: #f5f5f5;\n    --color-charcoal: #232323;\n    --color-input-border: #999999;\n    --color-polished-gold: #d2ac5a;\n    --color-antique-gold: #8a6d35;\n    --font-acumin-pro: 'Inter', 'Roboto', sans-serif;\n    --font-acumin-pro-condensed: 'Roboto Condensed', sans-serif;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n</style>\n<div style=\"width:600px;background:var(--color-ash-gray);padding:40px 24px;font-family:var(--font-acumin-pro);\">\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:24px;\">\n\n    <!-- Card 1 -->\n    <div style=\"background:var(--color-ash-gray);display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"width:100%;height:220px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:16px;\">\n        <div style=\"width:70px;height:180px;background:linear-gradient(180deg,#e8a020 0%,#3a2d8c 60%,#1a1a5e 100%);border-radius:6px;position:relative;\">\n          <div style=\"position:absolute;top:10px;left:50%;transform:translateX(-50%);width:50px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:7px;font-weight:700;color:var(--color-bone-white);letter-spacing:0.05em;line-height:1.1;\">Liquid<br>Death</div>\n          </div>\n          <div style=\"position:absolute;bottom:18px;left:50%;transform:translateX(-50%);width:56px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:5px;font-weight:700;color:var(--color-bone-white);letter-spacing:0.04em;line-height:1.2;text-transform:uppercase;\">Sparkling<br>Energy</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"text-align:center;padding:0 4px;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:16px;font-weight:700;color:var(--color-off-black);text-transform:uppercase;letter-spacing:0.02em;margin-bottom:4px;\">Orange Horror</div>\n        <div style=\"font-family:var(--font-acumin-pro-condensed);font-size:13px;font-weight:400;color:var(--color-gravel-gray);letter-spacing:0.05em;margin-bottom:10px;\">Sparkling Energy</div>\n        <div style=\"display:inline-block;background:var(--color-death-black);color:var(--color-bone-white);font-family:var(--font-acumin-pro-condensed);font-size:11px;font-weight:700;letter-spacing:0.05em;padding:4px 10px;border-radius:0;\">5 Calories</div>\n      </div>\n    </div>\n\n    <!-- Card 2 -->\n    <div style=\"background:var(--color-ash-gray);display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"width:100%;height:220px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:16px;\">\n        <div style=\"width:70px;height:180px;background:linear-gradient(180deg,#b01010 0%,#8b0000 50%,#5a0000 100%);border-radius:6px;position:relative;\">\n          <div style=\"position:absolute;top:10px;left:50%;transform:translateX(-50%);width:50px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:7px;font-weight:700;color:var(--color-bone-white);letter-spacing:0.05em;line-height:1.1;\">Liquid<br>Death</div>\n          </div>\n          <div style=\"position:absolute;bottom:18px;left:50%;transform:translateX(-50%);width:56px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:5px;font-weight:700;color:var(--color-bone-white);letter-spacing:0.04em;line-height:1.2;text-transform:uppercase;\">Sparkling<br>Energy</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"text-align:center;padding:0 4px;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:16px;font-weight:700;color:var(--color-off-black);text-transform:uppercase;letter-spacing:0.02em;margin-bottom:4px;\">Murder Mystery</div>\n        <div style=\"font-family:var(--font-acumin-pro-condensed);font-size:13px;font-weight:400;color:var(--color-gravel-gray);letter-spacing:0.05em;margin-bottom:10px;\">Sparkling Energy</div>\n        <div style=\"display:inline-block;background:var(--color-death-black);color:var(--color-bone-white);font-family:var(--font-acumin-pro-condensed);font-size:11px;font-weight:700;letter-spacing:0.05em;padding:4px 10px;border-radius:0;\">5 Calories</div>\n      </div>\n    </div>\n\n    <!-- Card 3 -->\n    <div style=\"background:var(--color-ash-gray);display:flex;flex-direction:column;align-items:center;\">\n      <div style=\"width:100%;height:220px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:16px;\">\n        <div style=\"width:70px;height:180px;background:linear-gradient(180deg,#f0ede0 0%,#ddd8c0 50%,#c8c0a0 100%);border-radius:6px;position:relative;\">\n          <div style=\"position:absolute;top:10px;left:50%;transform:translateX(-50%);width:50px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:7px;font-weight:700;color:var(--color-death-black);letter-spacing:0.05em;line-height:1.1;\">Liquid<br>Death</div>\n          </div>\n          <div style=\"position:absolute;bottom:18px;left:50%;transform:translateX(-50%);width:56px;text-align:center;\">\n            <div style=\"font-family:var(--font-acumin-pro);font-size:5px;font-weight:700;color:var(--color-death-black);letter-spacing:0.04em;line-height:1.2;text-transform:uppercase;\">Sparkling<br>Water</div>\n          </div>\n        </div>\n      </div>\n      <div style=\"text-align:center;padding:0 4px;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:16px;font-weight:700;color:var(--color-off-black);text-transform:uppercase;letter-spacing:0.02em;margin-bottom:4px;\">Cherry Obituary</div>\n        <div style=\"font-family:var(--font-acumin-pro-condensed);font-size:13px;font-weight:400;color:var(--color-gravel-gray);letter-spacing:0.05em;margin-bottom:10px;\">Soda-Flavored Sparkling Water</div>\n        <div style=\"display:inline-block;background:var(--color-death-black);color:var(--color-bone-white);font-family:var(--font-acumin-pro-condensed);font-size:11px;font-weight:700;letter-spacing:0.05em;padding:4px 10px;border-radius:0;\">10 Calories</div>\n      </div>\n    </div>\n\n  </div>\n  <div style=\"margin-top:28px;text-align:center;\">\n    <button style=\"background:var(--color-death-black);color:var(--color-bone-white);font-family:var(--font-acumin-pro);font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:0.063em;padding:14px 40px;border:none;border-radius:0;cursor:pointer;\">Shop Now</button>\n  </div>\n</div>",
