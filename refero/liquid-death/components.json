    "html": "<style>\n  :root {\n    --color-death-black: #000000;\n    --color-bone-white: #ffffff;\n    --color-off-black: #151515;\n    --color-ash-gray: #e3e3e3;\n    --color-gravel-gray: #727272;\n    --color-light-ash: #f5f5f5;\n    --color-charcoal: #232323;\n    --color-input-border: #999999;\n    --color-polished-gold: #d2ac5a;\n    --font-acumin-pro: 'Inter', 'Roboto', sans-serif;\n    --font-acumin-pro-condensed: 'Roboto Condensed', sans-serif;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n</style>\n<div style=\"width:600px;background:var(--color-bone-white);padding:40px 24px;font-family:var(--font-acumin-pro);\">\n  <div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:20px;\">\n\n    <!-- Merch Card 1 -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"width:100%;height:190px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:14px;\">\n        <div style=\"width:70px;height:140px;background:linear-gradient(135deg,#d0d0d0 0%,#b0b0b0 100%);border-radius:4px;position:relative;display:flex;align-items:center;justify-content:center;\">\n          <div style=\"width:40px;height:70px;background:var(--color-gravel-gray);border-radius:3px;opacity:0.5;\"></div>\n          <div style=\"position:absolute;top:8px;left:50%;transform:translateX(-50%);font-family:var(--font-acumin-pro);font-size:6px;font-weight:700;color:var(--color-bone-white);text-transform:uppercase;letter-spacing:0.05em;text-align:center;\">The<br>Flasket</div>\n        </div>\n      </div>\n      <div style=\"flex:1;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:400;color:var(--color-off-black);margin-bottom:4px;\">The Flasket</div>\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:700;color:var(--color-off-black);margin-bottom:12px;\">\u20ac42,00</div>\n        <button style=\"width:100%;background:transparent;color:var(--color-death-black);border:1px solid var(--color-death-black);font-family:var(--font-acumin-pro);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.056em;padding:10px 8px;border-radius:0;cursor:pointer;\">Add to Cart</button>\n      </div>\n    </div>\n\n    <!-- Merch Card 2 -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"width:100%;height:190px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:14px;\">\n        <div style=\"width:110px;height:130px;background:#c8a86a;border-radius:4px;display:flex;align-items:center;justify-content:center;gap:6px;\">\n          <div style=\"width:36px;height:100px;background:#b8985a;border-radius:3px;\"></div>\n          <div style=\"width:36px;height:100px;background:#b8985a;border-radius:3px;\"></div>\n        </div>\n      </div>\n      <div style=\"flex:1;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:400;color:var(--color-off-black);margin-bottom:4px;\">Masked Death Can Cooler (2-Pack)</div>\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:700;color:var(--color-off-black);margin-bottom:12px;\">\u20ac11,00</div>\n        <button style=\"width:100%;background:transparent;color:var(--color-death-black);border:1px solid var(--color-death-black);font-family:var(--font-acumin-pro);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.056em;padding:10px 8px;border-radius:0;cursor:pointer;\">Add to Cart</button>\n      </div>\n    </div>\n\n    <!-- Merch Card 3 -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"width:100%;height:190px;background:var(--color-light-ash);border-radius:0;display:flex;align-items:center;justify-content:center;margin-bottom:14px;\">\n        <div style=\"width:110px;height:130px;background:#2a2a2a;border-radius:4px;display:flex;align-items:center;justify-content:center;\">\n          <div style=\"width:70px;height:80px;background:#3d3d3d;border-radius:2px;display:flex;align-items:center;justify-content:center;\">\n            <div style=\"width:50px;height:60px;background:#555;border-radius:1px;\"></div>\n          </div>\n        </div>\n      </div>\n      <div style=\"flex:1;\">\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:400;color:var(--color-off-black);margin-bottom:4px;\">Death Wave Tee</div>\n        <div style=\"font-family:var(--font-acumin-pro);font-size:14px;font-weight:700;color:var(--color-off-black);margin-bottom:12px;\">\u20ac42,00</div>\n        <button style=\"width:100%;background:transparent;color:var(--color-death-black);border:1px solid var(--color-death-black);font-family:var(--font-acumin-pro);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.056em;padding:10px 8px;border-radius:0;cursor:pointer;\">Add to Cart</button>\n      </div>\n    </div>\n\n  </div>\n</div>",
    "name": "Merch Product Card Row",
    "role": "",
    "description": ""
  },
