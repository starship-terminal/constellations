    "role": "Task counters (0, 4 in sidebar)",
    "description": "font: pplxSans 11px weight 400, color: #271a00, backgroundColor: transparent, borderRadius: 0px. Bare numerals, no container decoration."
  },
  {
    "name": "Serif Headline Block",
    "role": "Section declarations",
    "description": "font: pplxSerif 48-96px weight 300-400, lineHeight: 1.00-1.12, color: #271a00 or #121516. Massive weight 300 type set tight (1.00-1.12 leading) creates architectural presence."
  },
  {
    "name": "Sans Hero Headline",
    "role": "Primary page title",
    "description": "font: pplxSans 96px weight 300, lineHeight: 1.00, letterSpacing: -2.69px, color: #271a00. Display-scale sans at whisper-weight with aggressive negative tracking."
  },
  {
    "name": "Body Stack",
    "role": "Feature descriptions, workflow text",
    "description": "font: pplxSans 15-16px weight 400, lineHeight: 1.50, color: #271a00 or #7c7464. Comfortable 1.5 leading creates breathing room in dense content."
  },
  {
    "name": "Nav Pill",
    "role": "Top navigation items",
    "description": "font: pplxSans 15px weight 400, color: #271a00, backgroundColor: transparent, borderRadius: 40px when active, padding: 20px vertical. Morphs into pill shape on hover/active."
  }
