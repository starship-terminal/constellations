[
  {
    "html": "<style>\n  :root {\n    --color-studio-black: #000000;\n    --color-pure-white: #ffffff;\n    --color-deep-ink: #0b1215;\n    --color-graphite-stroke: #394649;\n    --color-fog-border: #e0e0e0;\n    --color-ash-mid: #757575;\n    --color-charcoal-surface: #232424;\n    --color-skill-green: #55da9b;\n    --color-neon-pulse: #00ff84;\n    --color-electric-cyan: #24c2f2;\n    --color-creator-violet: #6927ef;\n    --color-facebook-blue: #1877f2;\n    --color-google-red: #ea4335;\n    --color-warning-amber: #f6b60b;\n    --font-gt-walsheim-pro: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .reg-wrapper {\n    background: var(--color-studio-black);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 48px 24px;\n    font-family: var(--font-gt-walsheim-pro);\n  }\n\n  .reg-panel {\n    background: var(--color-pure-white);\n    width: 100%;\n    max-width: 380px;\n    padding: 32px 28px 24px;\n    border-radius: 4px;\n  }\n\n  .reg-heading {\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 22px;\n    font-weight: 700;\n    color: var(--color-deep-ink);\n    text-align: center;\n    line-height: 1.25;\n    margin: 0 0 4px;\n  }\n\n  .reg-heading span {\n    text-decoration: underline;\n    text-decoration-color: var(--color-skill-green);\n    text-underline-offset: 3px;\n  }\n\n  .reg-buttons {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-top: 24px;\n  }\n\n  .auth-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    width: 100%;\n    padding: 11px 15px;\n    background: var(--color-pure-white);\n    border: 1px solid var(--color-graphite-stroke);\n    border-radius: 4px;\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 15px;\n    font-weight: 500;\n    color: var(--color-deep-ink);\n    cursor: pointer;\n    text-align: center;\n    box-sizing: border-box;\n    text-decoration: none;\n    transition: background 0.15s;\n  }\n\n  .auth-btn:hover {\n    background: #f5f5f5;\n  }\n\n  .auth-btn svg {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n  }\n\n  .email-link {\n    display: block;\n    margin-top: 16px;\n    text-align: center;\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--color-creator-violet);\n    text-decoration: none;\n    background: transparent;\n    border: none;\n    cursor: pointer;\n  }\n\n  .email-link:hover {\n    text-decoration: underline;\n  }\n\n  .reg-fine {\n    margin-top: 20px;\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 11px;\n    color: var(--color-ash-mid);\n    line-height: 1.45;\n    text-align: center;\n  }\n\n  .reg-fine a {\n    color: var(--color-deep-ink);\n    font-weight: 600;\n    text-decoration: none;\n  }\n</style>\n<div class=\"reg-wrapper\">\n  <div class=\"reg-panel\">\n    <h2 class=\"reg-heading\">Disfruta <span>7 d\u00edas gratis</span> de Skillshare</h2>\n    <div class=\"reg-buttons\">\n      <a href=\"#\" class=\"auth-btn\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\" fill=\"#4285F4\"/>\n          <path d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\" fill=\"#34A853\"/>\n          <path d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z\" fill=\"#FBBC05\"/>\n          <path d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\" fill=\"#EA4335\"/>\n        </svg>\n        Continuar con Google\n      </a>\n      <a href=\"#\" class=\"auth-btn\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z\" fill=\"#1877F2\"/>\n        </svg>\n        Continuar con Facebook\n      </a>\n      <a href=\"#\" class=\"auth-btn\">\n        <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z\" fill=\"#000000\"/>\n        </svg>\n        Continuar con Apple\n      </a>\n    </div>\n    <a href=\"#\" class=\"email-link\">Continuar con correo electr\u00f3nico</a>\n    <p class=\"reg-fine\">\n      Cuando te registras, aceptas los <a href=\"#\">T\u00e9rminos de servicio</a> y\n      <a href=\"#\">Pol\u00edtica de privacidad de Skillshare</a> y aceptas recibir\n      comunicaciones de marketing de Skillshare en la direcci\u00f3n de correo electr\u00f3nico\n      proporcionada. Esta p\u00e1gina est\u00e1 protegida por reCAPTCHA y est\u00e1 sujeta a los\n      <a href=\"#\">T\u00e9rminos de Servicio</a> y <a href=\"#\">Pol\u00edtica de privacidad</a> de Google.\n    </p>\n  </div>\n</div>",
    "name": "Registration Panel \u2014 Auth Buttons",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-studio-black: #000000;\n    --color-pure-white: #ffffff;\n    --color-deep-ink: #0b1215;\n    --color-charcoal-surface: #232424;\n    --color-ash-mid: #757575;\n    --color-warning-amber: #f6b60b;\n    --font-gt-walsheim-pro: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .stats-section {\n    background: var(--color-studio-black);\n    padding: 64px 24px;\n    font-family: var(--font-gt-walsheim-pro);\n    box-sizing: border-box;\n  }\n\n  .stats-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n    max-width: 560px;\n    margin: 0 auto;\n  }\n\n  .stat-card {\n    background: var(--color-charcoal-surface);\n    border-radius: 8px;\n    padding: 24px 20px;\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 6px;\n    box-sizing: border-box;\n  }\n\n  .stat-value {\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 36px;\n    font-weight: 700;\n    color: var(--color-pure-white);\n    line-height: 1.0;\n    margin: 0;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .stat-stars {\n    display: inline-flex;\n    gap: 1px;\n    align-items: center;\n  }\n\n  .stat-stars svg {\n    width: 20px;\n    height: 20px;\n    fill: var(--color-warning-amber);\n  }\n\n  .stat-label {\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 11px;\n    font-weight: 500;\n    color: var(--color-ash-mid);\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    margin: 0;\n  }\n</style>\n<div class=\"stats-section\">\n  <div class=\"stats-grid\">\n    <div class=\"stat-card\">\n      <div class=\"stat-value\">425k+</div>\n      <div class=\"stat-label\">Members</div>\n    </div>\n    <div class=\"stat-card\">\n      <div class=\"stat-value\">30k+</div>\n      <div class=\"stat-label\">Classes</div>\n    </div>\n    <div class=\"stat-card\">\n      <div class=\"stat-value\">9k+</div>\n      <div class=\"stat-label\">Teachers</div>\n    </div>\n    <div class=\"stat-card\">\n      <div class=\"stat-value\">\n        4.8\n        <span class=\"stat-stars\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n          <svg viewBox=\"0 0 24 24\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n        </span>\n      </div>\n      <div class=\"stat-label\">App Store Rating</div>\n    </div>\n  </div>\n</div>",
    "name": "Stat Counter Cards \u2014 Social Proof Metrics",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-studio-black: #000000;\n    --color-pure-white: #ffffff;\n    --color-neon-pulse: #00ff84;\n    --font-gt-walsheim-pro: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .feature-section {\n    background: var(--color-studio-black);\n    padding: 64px 32px;\n    font-family: var(--font-gt-walsheim-pro);\n    box-sizing: border-box;\n    max-width: 600px;\n    margin: 0 auto;\n  }\n\n  .feature-layout {\n    display: flex;\n    flex-direction: column;\n    gap: 40px;\n  }\n\n  .feature-heading {\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 46px;\n    font-weight: 700;\n    color: var(--color-pure-white);\n    line-height: 0.96;\n    margin: 0;\n    max-width: 280px;\n  }\n\n  .feature-list {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    list-style: none;\n    margin: 0;\n    padding: 0;\n  }\n\n  .feature-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n  }\n\n  .check-icon {\n    flex-shrink: 0;\n    width: 24px;\n    height: 24px;\n    background: var(--color-neon-pulse);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-top: 1px;\n  }\n\n  .check-icon svg {\n    width: 13px;\n    height: 13px;\n  }\n\n  .feature-text {\n    font-family: var(--font-gt-walsheim-pro);\n    font-size: 18px;\n    font-weight: 700;\n    color: var(--color-pure-white);\n    line-height: 1.35;\n    margin: 0;\n  }\n</style>\n<div class=\"feature-section\">\n  <div class=\"feature-layout\">\n    <h2 class=\"feature-heading\">Aprendizaje creativo m\u00e1s f\u00e1cil</h2>\n    <ul class=\"feature-list\">\n      <li class=\"feature-item\">\n        <div class=\"check-icon\">\n          <svg viewBox=\"0 0 13 13\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M2 6.5L5.5 10L11 3\" stroke=\"#000000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <p class=\"feature-text\">Miles de clases creativas. De principiante a profesional.</p>\n      </li>\n      <li class=\"feature-item\">\n        <div class=\"check-icon\">\n          <svg viewBox=\"0 0 13 13\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M2 6.5L5.5 10L11 3\" stroke=\"#000000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <p class=\"feature-text\">Impartidas por profesionales creativos e \u00edconos de la industria.</p>\n      </li>\n      <li class=\"feature-item\">\n        <div class=\"check-icon\">\n          <svg viewBox=\"0 0 13 13\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M2 6.5L5.5 10L11 3\" stroke=\"#000000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <p class=\"feature-text\">Rutas de aprendizaje para ayudarte a alcanzar tus metas.</p>\n      </li>\n      <li class=\"feature-item\">\n        <div class=\"check-icon\">\n          <svg viewBox=\"0 0 13 13\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M2 6.5L5.5 10L11 3\" stroke=\"#000000\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <p class=\"feature-text\">Certificados para celebrar tus logros.</p>\n      </li>\n    </ul>\n  </div>\n</div>",
    "name": "Feature Checklist \u2014 Dark Section",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button",
    "role": "Main registration and sign-up actions",
    "description": "Background #55da9b, text #0b1215 at weight 600, 14\u201316px GT Walsheim Pro. Border-radius 4px. Padding 5px 15px. No border. Appears in navbar and hero \u2014 the only consistent green element on any page section regardless of surrounding theme."
  },
  {
    "name": "White Outlined Auth Button",
    "role": "Social login options (Google, Facebook, Apple)",
    "description": "Background #ffffff, text #0b1215 at weight 500, 15px. Border 1px solid #394649, border-radius 4px. Padding 5px 15px. Contains 20px platform icon left-aligned. Full-width within registration panel. Stacked vertically with 8px gaps."
  },
  {
    "name": "Ghost Text Link Button",
    "role": "Email continuation, secondary navigation actions",
    "description": "Background transparent, text #6927ef at 500 weight, 14px. No border, no radius, no padding. Underlined on hover. Used as the 'Continuar con correo electr\u00f3nico' option below the social auth buttons."
  },
  {
    "name": "Instructor Portrait Card",
    "role": "Teacher browse grid \u2014 social proof section",
    "description": "Background #ffffff, border-radius 4px top, 8px bottom. Box-shadow rgba(0,0,0,0.1) 0px 2px 4px. Zero padding \u2014 photography fills 100% of card face. Overlaid at bottom: small 'CONOCE' label at 11px uppercase tracking 0.1em in #ffffff, followed by instructor name at 24px weight 700 #ffffff, title at 12px uppercase #ffffff. Gradient scrim from transparent to rgba(0,0,0,0.7) over bottom 40% of image."
  },
  {
    "name": "Category Browse Card",
    "role": "Full-bleed horizontal category slider",
    "description": "No card chrome \u2014 full-bleed photographic strip with category label at bottom-left, 18\u201322px weight 700 #ffffff, with a dark overlay. Cards are 150\u2013200px wide, full viewport height within the slider strip. No border radius \u2014 hard edges on left/right, categories run edge-to-edge."
  },
  {
    "name": "Stat Counter Card",
    "role": "Social proof metrics \u2014 Members, Classes, Teachers, Rating",
    "description": "Background #232424 on a #000000 section. Border-radius 8px. Padding 16px. No shadow. Stat value at 34\u201338px weight 700 #ffffff. Label below at 11px weight 500, uppercase, tracking 0.1em, #757575. Four cards in a 4-column horizontal grid."
  },
  {
    "name": "Feature Checklist Item",
    "role": "Benefit list on dark sections",
    "description": "Horizontal flex: #00ff84 filled checkmark icon (20px) + body text at 16px weight 400 #ffffff. Vertical gap 12px between items. No container \u2014 items float on pure black background."
  },
  {
    "name": "Search Input Bar",
    "role": "Global navigation search",
    "description": "Background transparent, border 1px solid #e0e0e0, border-radius 4px. Padding 0 38px on both sides (icon gutters). Placeholder text #757575 at 14px GT Walsheim Pro. Search icon 20px left-inset, clear/submit icon right-inset. Appears in white nav bar only."
  },
  {
    "name": "Navigation Bar",
    "role": "Sticky top navigation",
    "description": "Background #ffffff. Height ~56px. Logo left-aligned, 'Navegar' dropdown with chevron center-left. Search bar spans ~50% width. Right side: 'Iniciar sesi\u00f3n' text link in #0b1215 weight 500, then 'Reg\u00edstrate' green CTA button. No bottom border in hero section \u2014 relies on content separation."
  },
  {
    "name": "Dark Split Section",
    "role": "Feature/benefit alternating sections on black background",
    "description": "Full-width background #000000. Two-column layout: left column heading at 38\u201346px weight 700 #ffffff, right column feature checklist items. Section padding 80px vertical. Section headings use tight 0.96 line-height producing poster-stacked effect."
  },
  {
    "name": "Registration Panel",
    "role": "Right-half hero sign-up widget",
    "description": "Background #ffffff. Width ~380px. Heading 'Disfruta 7 d\u00edas gratis de Skillshare' at 22px weight 700 #0b1215 centered. Three stacked auth buttons with 8px gaps. 'Continuar con correo electr\u00f3nico' ghost link centered below. Fine print at 11px #757575. Panel sits on pure black hero background with no card chrome \u2014 the white block floats."
  }
]
