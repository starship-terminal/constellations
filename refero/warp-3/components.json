[
  {
    "html": "<div style=\"\n  --color-void-canvas: #121212;\n  --color-obsidian-deep: #090909;\n  --color-charcoal-surface: #1e1e1d;\n  --color-iron-surface: #353534;\n  --color-graphite-lift: #2f2f2f;\n  --color-slate-hover: #40403f;\n  --color-ash-text: #868684;\n  --color-fog-text: #afaeac;\n  --color-smoke-text: #e3e2e0;\n  --color-warm-white: #faf9f6;\n  --color-pure-white: #ffffff;\n  --color-terminal-sage: #799c92;\n  --font-matter: 'General Sans', 'Manrope', 'DM Sans', sans-serif;\n  --font-geist-mono: 'JetBrains Mono', 'Fira Code', monospace;\n  background: var(--color-void-canvas);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 60px 40px;\n  font-family: var(--font-matter);\n  box-sizing: border-box;\n  width: 600px;\n\">\n  <!-- Announcement Bar -->\n  <div style=\"\n    background: var(--color-obsidian-deep);\n    width: 100%;\n    padding: 10px 20px;\n    text-align: center;\n    margin-bottom: 40px;\n    border-radius: 4px;\n    box-sizing: border-box;\n  \">\n    <span style=\"font-family: var(--font-matter); font-size: 14px; color: var(--color-smoke-text); font-weight: 400; letter-spacing: -0.2px;\">Warp is now open-source.&nbsp;</span>\n    <a href=\"#\" style=\"font-family: var(--font-matter); font-size: 14px; color: var(--color-warm-white); font-weight: 400; text-decoration: underline;\">Learn more.</a>\n  </div>\n\n  <!-- Headline -->\n  <h1 style=\"\n    font-family: var(--font-matter);\n    font-size: 56px;\n    font-weight: 400;\n    color: var(--color-warm-white);\n    letter-spacing: -0.03em;\n    line-height: 1.0;\n    text-align: center;\n    margin: 0 0 16px 0;\n    padding: 0;\n  \">The best terminal to<br>build with agents</h1>\n\n  <!-- Subtitle -->\n  <p style=\"\n    font-family: var(--font-matter);\n    font-size: 16px;\n    font-weight: 400;\n    color: var(--color-fog-text);\n    letter-spacing: -0.19px;\n    line-height: 1.5;\n    text-align: center;\n    margin: 0 0 36px 0;\n    padding: 0;\n    max-width: 480px;\n  \">Ship faster in a modern terminal designed to help you go from prompt to production</p>\n\n  <!-- CTA Row -->\n  <div style=\"display: flex; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: center;\">\n    <!-- Primary Download Button -->\n    <button style=\"\n      background: var(--color-pure-white);\n      color: var(--color-void-canvas);\n      font-family: var(--font-matter);\n      font-size: 16px;\n      font-weight: 600;\n      border: none;\n      border-radius: 6px;\n      padding: 14px 24px;\n      cursor: pointer;\n      letter-spacing: -0.01em;\n      white-space: nowrap;\n    \">Download for Mac</button>\n\n    <!-- Code Snippet Block -->\n    <div style=\"\n      background: var(--color-iron-surface);\n      border-radius: 10px;\n      padding: 14px 16px;\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    \">\n      <span style=\"\n        font-family: var(--font-geist-mono);\n        font-size: 15px;\n        font-weight: 400;\n        color: var(--color-smoke-text);\n        letter-spacing: 0;\n        line-height: 1;\n        white-space: nowrap;\n      \">brew install --cask warp</span>\n      <!-- Copy Icon -->\n      <button style=\"\n        background: none;\n        border: none;\n        cursor: pointer;\n        padding: 0;\n        display: flex;\n        align-items: center;\n      \">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"5\" y=\"5\" width=\"9\" height=\"9\" rx=\"1.5\" stroke=\"#868684\" stroke-width=\"1.2\" fill=\"none\"/>\n          <path d=\"M11 5V3.5A1.5 1.5 0 0 0 9.5 2H3.5A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5\" stroke=\"#868684\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        </svg>\n      </button>\n    </div>\n  </div>\n\n  <!-- Agent support label -->\n  <p style=\"\n    font-family: var(--font-matter);\n    font-size: 12px;\n    font-weight: 400;\n    color: var(--color-ash-text);\n    letter-spacing: 1.2px;\n    margin: 28px 0 12px 0;\n    text-align: center;\n    text-transform: none;\n  \">Built-In Terminal Agent Support For</p>\n\n  <!-- Agent Icons Row -->\n  <div style=\"display: flex; align-items: center; gap: 8px;\">\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#c85c38; display:flex; align-items:center; justify-content:center;\">\n      <div style=\"width:18px; height:18px; border-radius:50%; background:rgba(255,255,255,0.85);\"></div>\n    </div>\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#1a1a1a; border:1px solid #353534; display:flex; align-items:center; justify-content:center;\">\n      <div style=\"width:16px; height:16px; border-radius:3px; background:#5f5f5f;\"></div>\n    </div>\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#2a2a2a; border:1px solid #353534; display:flex; align-items:center; justify-content:center;\">\n      <div style=\"width:18px; height:4px; background:#868684; border-radius:2px;\"></div>\n    </div>\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#1e1e1d; border:1px solid #353534; display:flex; align-items:center; justify-content:center;\">\n      <div style=\"width:16px; height:16px; border-radius:50%; border:2px solid #868684;\"></div>\n    </div>\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#2a2a2a; border:1px solid #353534; display:flex; align-items:center; justify-content:center;\">\n      <div style=\"width:14px; height:14px; background:#5a5a5a; border-radius:2px;\"></div>\n    </div>\n    <div style=\"width:36px; height:36px; border-radius:10px; background:#b83232; display:flex; align-items:center; justify-content:center;\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 7h10M7 2l5 5-5 5\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n  </div>\n</div>",
    "name": "Hero CTA Button Group with Code Snippet",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"\n  --color-void-canvas: #121212;\n  --color-charcoal-surface: #1e1e1d;\n  --color-iron-surface: #353534;\n  --color-graphite-lift: #2f2f2f;\n  --color-ash-text: #868684;\n  --color-fog-text: #afaeac;\n  --color-smoke-text: #e3e2e0;\n  --color-warm-white: #faf9f6;\n  --color-terminal-sage: #799c92;\n  --font-matter: 'General Sans', 'Manrope', 'DM Sans', sans-serif;\n  background: var(--color-void-canvas);\n  width: 600px;\n  padding: 60px 40px;\n  box-sizing: border-box;\n  font-family: var(--font-matter);\n\">\n  <!-- Section Eyebrow -->\n  <p style=\"\n    font-family: var(--font-matter);\n    font-size: 16px;\n    font-weight: 400;\n    color: var(--color-terminal-sage);\n    letter-spacing: 0.01em;\n    margin: 0 0 10px 0;\n    line-height: 1.4;\n  \">Prompt to shippable feature</p>\n\n  <!-- Section Heading -->\n  <h2 style=\"\n    font-family: var(--font-matter);\n    font-size: 40px;\n    font-weight: 400;\n    color: var(--color-warm-white);\n    letter-spacing: -0.02em;\n    line-height: 1.12;\n    margin: 0 0 40px 0;\n    padding: 0;\n    max-width: 400px;\n  \">The editor features you need to work with agents</h2>\n\n  <!-- Feature Item 1 \u2014 Active -->\n  <div style=\"\n    background: var(--color-charcoal-surface);\n    border-radius: 12px;\n    padding: 20px 24px;\n    margin-bottom: 12px;\n    box-sizing: border-box;\n  \">\n    <!-- Progress bar -->\n    <div style=\"\n      width: 100%;\n      height: 2px;\n      background: var(--color-iron-surface);\n      border-radius: 2px;\n      margin-bottom: 16px;\n      overflow: hidden;\n    \">\n      <div style=\"\n        width: 35%;\n        height: 100%;\n        background: var(--color-warm-white);\n        border-radius: 2px;\n      \"></div>\n    </div>\n    <div style=\"display: flex; align-items: flex-start; gap: 16px;\">\n      <span style=\"\n        font-family: var(--font-matter);\n        font-size: 14px;\n        font-weight: 400;\n        color: var(--color-ash-text);\n        min-width: 16px;\n        line-height: 1.5;\n        padding-top: 2px;\n      \">1</span>\n      <div>\n        <h3 style=\"\n          font-family: var(--font-matter);\n          font-size: 18px;\n          font-weight: 600;\n          color: var(--color-warm-white);\n          letter-spacing: -0.01em;\n          margin: 0 0 8px 0;\n          line-height: 1.3;\n        \">Prompt agents with rich context</h3>\n        <p style=\"\n          font-family: var(--font-matter);\n          font-size: 15px;\n          font-weight: 400;\n          color: var(--color-fog-text);\n          line-height: 1.55;\n          margin: 0;\n          letter-spacing: -0.15px;\n        \">Warp makes it easy to write good prompts. Reference files and images in your prompts and even use voice transcription from Wispr Flow.</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Feature Item 2 -->\n  <div style=\"\n    border-radius: 12px;\n    padding: 20px 24px;\n    margin-bottom: 12px;\n    box-sizing: border-box;\n  \">\n    <div style=\"display: flex; align-items: flex-start; gap: 16px;\">\n      <span style=\"\n        font-family: var(--font-matter);\n        font-size: 14px;\n        font-weight: 400;\n        color: var(--color-ash-text);\n        min-width: 16px;\n        line-height: 1.5;\n        padding-top: 2px;\n      \">2</span>\n      <div>\n        <h3 style=\"\n          font-family: var(--font-matter);\n          font-size: 18px;\n          font-weight: 400;\n          color: var(--color-ash-text);\n          letter-spacing: -0.01em;\n          margin: 0;\n          line-height: 1.3;\n        \">Edit agent output</h3>\n      </div>\n    </div>\n  </div>\n\n  <!-- Feature Item 3 -->\n  <div style=\"\n    border-radius: 12px;\n    padding: 20px 24px;\n    margin-bottom: 12px;\n    box-sizing: border-box;\n  \">\n    <div style=\"display: flex; align-items: flex-start; gap: 16px;\">\n      <span style=\"\n        font-family: var(--font-matter);\n        font-size: 14px;\n        font-weight: 400;\n        color: var(--color-ash-text);\n        min-width: 16px;\n        line-height: 1.5;\n        padding-top: 2px;\n      \">3</span>\n      <div>\n        <h3 style=\"\n          font-family: var(--font-matter);\n          font-size: 18px;\n          font-weight: 400;\n          color: var(--color-ash-text);\n          letter-spacing: -0.01em;\n          margin: 0;\n          line-height: 1.3;\n        \">Review diffs inline</h3>\n      </div>\n    </div>\n  </div>\n\n  <!-- Feature Item 4 -->\n  <div style=\"\n    border-radius: 12px;\n    padding: 20px 24px;\n    box-sizing: border-box;\n  \">\n    <div style=\"display: flex; align-items: flex-start; gap: 16px;\">\n      <span style=\"\n        font-family: var(--font-matter);\n        font-size: 14px;\n        font-weight: 400;\n        color: var(--color-ash-text);\n        min-width: 16px;\n        line-height: 1.5;\n        padding-top: 2px;\n      \">4</span>\n      <div>\n        <h3 style=\"\n          font-family: var(--font-matter);\n          font-size: 18px;\n          font-weight: 400;\n          color: var(--color-ash-text);\n          letter-spacing: -0.01em;\n          margin: 0;\n          line-height: 1.3;\n        \">Run and iterate on tasks</h3>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Feature Section \u2014 Numbered List Card",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"\n  --color-void-canvas: #121212;\n  --color-ash-text: #868684;\n  --color-fog-text: #afaeac;\n  --color-smoke-text: #e3e2e0;\n  --color-warm-white: #faf9f6;\n  --color-iron-surface: #353534;\n  --color-charcoal-surface: #1e1e1d;\n  --font-matter: 'General Sans', 'Manrope', 'DM Sans', sans-serif;\n  background: var(--color-void-canvas);\n  width: 600px;\n  padding: 48px 40px;\n  box-sizing: border-box;\n  font-family: var(--font-matter);\n\">\n  <!-- Label -->\n  <p style=\"\n    font-family: var(--font-matter);\n    font-size: 14px;\n    font-weight: 400;\n    color: var(--color-ash-text);\n    text-align: center;\n    margin: 0 0 32px 0;\n    letter-spacing: -0.2px;\n    line-height: 1.5;\n  \">Trusted by over 700,000 developers and thousands of engineering teams at leading companies</p>\n\n  <!-- Logo Row -->\n  <div style=\"\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    flex-wrap: wrap;\n    row-gap: 20px;\n  \">\n    <!-- Amazon -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"60\" height=\"18\" viewBox=\"0 0 60 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <text x=\"0\" y=\"14\" font-family=\"Arial, sans-serif\" font-size=\"15\" font-weight=\"700\" fill=\"#afaeac\" letter-spacing=\"-0.5\">amazon</text>\n      </svg>\n    </div>\n\n    <!-- Docker -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"14\" height=\"12\" viewBox=\"0 0 14 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"0\" y=\"4\" width=\"3\" height=\"3\" rx=\"0.5\" fill=\"#afaeac\"/>\n        <rect x=\"4\" y=\"4\" width=\"3\" height=\"3\" rx=\"0.5\" fill=\"#afaeac\"/>\n        <rect x=\"4\" y=\"0\" width=\"3\" height=\"3\" rx=\"0.5\" fill=\"#afaeac\"/>\n        <rect x=\"8\" y=\"4\" width=\"3\" height=\"3\" rx=\"0.5\" fill=\"#afaeac\"/>\n        <rect x=\"8\" y=\"0\" width=\"3\" height=\"3\" rx=\"0.5\" fill=\"#afaeac\"/>\n      </svg>\n      <span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 600; color: #afaeac; letter-spacing: -0.2px;\">docker</span>\n    </div>\n\n    <!-- GitHub -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"#afaeac\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z\"/>\n      </svg>\n      <span style=\"font-family: 'Georgia', serif; font-size: 15px; font-weight: 700; color: #afaeac; letter-spacing: -0.2px;\">GitHub</span>\n    </div>\n\n    <!-- Ramp -->\n    <div style=\"display:flex; align-items:center; gap:4px; opacity:0.55;\">\n      <span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 600; color: #afaeac; letter-spacing: -0.2px;\">ramp</span>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 12L12 2M12 2H6M12 2v6\" stroke=\"#afaeac\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </div>\n\n    <!-- Asana -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"16\" height=\"14\" viewBox=\"0 0 16 14\" fill=\"none\">\n        <circle cx=\"8\" cy=\"4\" r=\"3.5\" fill=\"#afaeac\"/>\n        <circle cx=\"3\" cy=\"10\" r=\"3\" fill=\"#afaeac\"/>\n        <circle cx=\"13\" cy=\"10\" r=\"3\" fill=\"#afaeac\"/>\n      </svg>\n      <span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 600; color: #afaeac; letter-spacing: -0.2px;\">asana</span>\n    </div>\n\n    <!-- DoorDash -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\">\n        <circle cx=\"8\" cy=\"8\" r=\"7\" stroke=\"#afaeac\" stroke-width=\"1.5\" fill=\"none\"/>\n        <circle cx=\"8\" cy=\"8\" r=\"2.5\" fill=\"#afaeac\"/>\n      </svg>\n      <span style=\"font-family: var(--font-matter); font-size: 13px; font-weight: 600; color: #afaeac; letter-spacing: 0.02em;\">DOORDASH</span>\n    </div>\n  </div>\n\n  <!-- Second Row -->\n  <div style=\"\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 40px;\n    margin-top: 24px;\n    flex-wrap: wrap;\n  \">\n    <!-- Retool -->\n    <div style=\"display:flex; align-items:center; gap:6px; opacity:0.55;\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n        <rect x=\"0\" y=\"0\" width=\"6\" height=\"6\" rx=\"1\" fill=\"#afaeac\"/>\n        <rect x=\"8\" y=\"0\" width=\"6\" height=\"6\" rx=\"1\" fill=\"#afaeac\"/>\n        <rect x=\"0\" y=\"8\" width=\"6\" height=\"6\" rx=\"1\" fill=\"#afaeac\"/>\n      </svg>\n      <span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 600; color: #afaeac; letter-spacing: -0.2px;\">Retool</span>\n    </div>\n\n    <!-- VMware -->\n    <div style=\"display:flex; align-items:center; gap:4px; opacity:0.55;\">\n      <span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 400; color: #afaeac; letter-spacing: -0.3px;\">vm</span><span style=\"font-family: var(--font-matter); font-size: 15px; font-weight: 700; color: #afaeac; letter-spacing: -0.3px;\">ware</span>\n    </div>\n  </div>\n</div>",
    "name": "Trust Logo Bar",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary Download Button",
    "role": "Highest-priority CTA \u2014 download action",
    "description": "Background #ffffff, text #121212 (or near-black), border-radius 6px, padding 12px 20px. Matter weight 600 at 16px. Appears in the nav and hero. The white fill on a near-black page makes this the only high-contrast interactive element visible at a glance."
  },
  {
    "name": "Dark Filled Button",
    "role": "Secondary actions within dark UI panels",
    "description": "Background #2f2f2f, text #faf9f6, no visible border, border-radius 4px, padding 8px 12px. Matter weight 400 at 14px. Used inside the terminal product UI for sub-actions. Subtle box-shadow: rgba(18,18,18,0.2) 0 0 16px."
  },
  {
    "name": "Ghost Surface Button",
    "role": "Tertiary actions on dark backgrounds",
    "description": "Background rgba(255,255,255,0.04), effectively invisible fill, border-radius 4px, padding 8px 12px. Text #faf9f6. Used for low-emphasis actions that need click target area without visual weight."
  },
  {
    "name": "Pill Icon Button",
    "role": "Toggle or mode-switch controls",
    "description": "Background #353534, text/icon #afaeac, border-radius 50px, padding 10px. Circular or tight-aspect buttons for UI chrome controls like view toggles. Monochrome icon at reduced brightness."
  },
  {
    "name": "Code Snippet Block",
    "role": "Inline command display in hero",
    "description": "Background #353534, text #e3e2e0, font Geist Mono 400 16px, border-radius 10px, padding 12px 16px. Displays 'brew install --cask warp' as a copyable command. Icon button for copy action at trailing edge."
  },
  {
    "name": "Primary Feature Card",
    "role": "Main content cards throughout feature sections",
    "description": "Background #121212, border-radius 16px, no border, no shadow, padding 0 (content inside handles its own padding). Used in 12+ instances. Content bleeds to card edges \u2014 imagery is contained by the radius, not inset padding."
  },
  {
    "name": "Elevated Content Card",
    "role": "Secondary raised container within a section",
    "description": "Background #353534, border-radius 20px, no shadow, no border. One step above the canvas in the surface stack \u2014 used for dropdown/panel containers in the product screenshot."
  },
  {
    "name": "Padded Inner Card",
    "role": "Text-content sub-container",
    "description": "Background #1e1e1d, border-radius 10px, padding 16px on all sides. Used for structured text blocks like 'Problem Statement' panels within the product screenshot interface."
  },
  {
    "name": "Announcement Bar",
    "role": "Top-of-page notification strip",
    "description": "Background #090909 (near pure black), text #e3e2e0 at 14px Matter weight 400, link in #faf9f6 with underline. Full-width, 40px height. The single horizontal line of text and link creates minimum footprint."
  },
  {
    "name": "Navigation Bar",
    "role": "Primary site navigation",
    "description": "Background #ffffff (scrolled) or transparent, height ~48px. Logo left, nav links center in Matter Medium 16px color #868684, CTA buttons right. Nav links use 'Book a demo' as ghost text and 'Download for Mac' as the white-fill primary. backdrop-filter: blur(20px) on scroll."
  },
  {
    "name": "Section Eyebrow Label",
    "role": "Feature section category marker",
    "description": "Text #799c92, Matter weight 400, 14-16px, letter-spacing 0.1em (wide-tracked). Placed above section headings. The only chromatic color in the system \u2014 acts like a terminal prompt cursor bleeding into copy."
  },
  {
    "name": "Trust Logo Bar",
    "role": "Social proof logos row",
    "description": "Background #121212 (canvas), logos in #868684 to #afaeac (desaturated, low-contrast fills). Full-width horizontal flex, logos centered, no borders or dividers. Density: compact, 12-16px gap between logos."
  }
]
