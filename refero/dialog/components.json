    "html": "<div style=\"--color-tangerine-tag:#f69251;--color-midnight-ink:#181825;--color-carbon:#000000;--color-stone:#636363;--color-pebble:#949494;--color-fog:#f7f7f7;--color-snow:#ffffff;--font-pp-radio-grotesk-light:'DM Sans',sans-serif;--font-inter:Inter,sans-serif;--spacing-8:8px;--spacing-12:12px;--spacing-16:16px;--spacing-24:24px;--spacing-32:32px;--spacing-48:48px;--spacing-64:64px;--shadow-subtle:rgba(24,24,37,0.12) 0px 2px 3px -2px;--shadow-subtle-2:rgba(0,0,0,0.04) 0px 1px 2px 0px,rgba(0,0,0,0.02) 0px 2px 4px 0px,rgba(0,0,0,0.02) 0px 4px 8px 0px;padding:var(--spacing-64) var(--spacing-24);background:var(--color-fog);font-family:var(--font-inter);text-align:center;\"><h1 style=\"font-family:var(--font-pp-radio-grotesk-light);font-weight:400;font-size:50px;line-height:1.2;letter-spacing:-0.5px;color:var(--color-carbon);margin:0 0 var(--spacing-16) 0;\">The AI shopping agent<br>that boosts your sales</h1><p style=\"font-family:var(--font-inter);font-size:18px;line-height:1.5;color:var(--color-stone);margin:0 0 var(--spacing-32) 0;font-weight:400;letter-spacing:-0.01em;\">Guide shoppers in real time, like you would in store.</p><div style=\"display:flex;align-items:center;justify-content:center;gap:var(--spacing-12);margin:0 auto var(--spacing-32) auto;max-width:460px;\"><input type=\"email\" placeholder=\"example@email.com\" style=\"flex:1;font-family:var(--font-inter);font-size:16px;padding:14px 20px;border:none;border-radius:0px;background:rgba(0,0,0,0.04);color:var(--color-midnight-ink);outline:none;letter-spacing:-0.01em;\"><a style=\"display:inline-flex;align-items:center;justify-content:center;background:var(--color-tangerine-tag);color:var(--color-carbon);font-family:var(--font-inter);font-size:15px;font-weight:500;padding:14px 24px;border-radius:28px;text-decoration:none;white-space:nowrap;box-shadow:var(--shadow-subtle-2);letter-spacing:-0.01em;cursor:pointer;\">Book a demo</a></div><div style=\"display:flex;align-items:center;justify-content:center;gap:var(--spacing-32);\"><div style=\"display:flex;align-items:center;gap:var(--spacing-8);\"><div style=\"width:24px;height:24px;background:var(--color-carbon);border-radius:4px;display:flex;align-items:center;justify-content:center;\"><span style=\"color:var(--color-snow);font-size:14px;font-weight:700;font-family:var(--font-inter);\">S</span></div><div style=\"display:flex;gap:2px;\"><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span></div></div><div style=\"display:flex;align-items:center;gap:var(--spacing-8);\"><div style=\"width:24px;height:24px;background:var(--color-carbon);border-radius:50%;display:flex;align-items:center;justify-content:center;\"><span style=\"color:var(--color-snow);font-size:14px;font-weight:700;font-family:var(--font-inter);\">G</span></div><div style=\"display:flex;gap:2px;\"><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span><span style=\"color:var(--color-tangerine-tag);font-size:16px;\">\u2605</span></div></div></div></div>",
    "name": "Email Input + CTA Inline Form with Star Ratings",
    "role": "",
    "description": ""
