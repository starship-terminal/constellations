  {
    "name": "Primary CTA Button",
    "role": "The main action on a page, like 'Sign Up'.",
    "description": "Solid Ink (#171717) background with Paper White (#ffffff) text. Font is 14px GeistSans at 500 weight. Padding is ~8px vertically and 12px horizontally, with an 8px border radius."
  },
  {
    "name": "Ghost Navigation Link",
    "role": "Secondary navigation actions like 'Sign In'.",
    "description": "Transparent background with Subtext (#666666) text. No border in its default state. Font is 14px GeistSans at 400 weight."
  },
  {
    "name": "Prompt Suggestion Chip",
    "role": "Clickable suggestions below the main input.",
    "description": "Transparent background with a 1px Line (#eaeaea) border. Text is Subtext (#666666) at ~13px. Padding is 4px vertically and 8px horizontally, with a 6px border radius."
  },
  {
    "name": "Filter Pill Button",
    "role": "Filtering content categories like 'Landing Pages'.",
    "description": "A pill-shaped button (9999px radius) with a Paper White (#ffffff) background and Ink (#171717) text. Features a faint 1px border of `rgba(0, 0, 0, 0.08)`."
  },
  {
    "name": "Main Prompt Input",
    "role": "The primary interaction point for user queries.",
    "description": "A large input field with a 12px border radius and a subtle 1px Line (#eaeaea) border. Placeholder text is Subtext (#666666). On focus, it gets a subtle outer glow."
  },
  {
    "name": "Header Divider",
    "role": "Separates the sticky header from page content.",
    "description": "A full-width 1px solid border using the Line color (#eaeaea)."
  }
