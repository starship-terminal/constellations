[
  {
    "html": "<style>\n  :root {\n    --color-signal-violet: #5e51f8;\n    --color-soft-amethyst: #cfcbfd;\n    --color-carbon: #111111;\n    --color-pure-white: #ffffff;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  .hero-cta-wrapper {\n    background: radial-gradient(50% 200% at 50% -100%, rgb(119, 107, 255) 0%, rgb(94, 81, 248) 100%), linear-gradient(rgb(94, 81, 248) 0%, rgb(39, 21, 76) 100%);\n    width: 600px;\n    box-sizing: border-box;\n    padding: 64px 40px 72px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    font-family: var(--font-inter);\n  }\n\n  .hero-headline-primary {\n    font-family: 'Georgia', 'Times New Roman', serif;\n    font-weight: 700;\n    font-size: 72px;\n    line-height: 1.10;\n    letter-spacing: -0.054em;\n    color: var(--color-pure-white);\n    text-align: center;\n    margin: 0 0 0 0;\n    padding: 0;\n    font-style: normal;\n  }\n\n  .hero-headline-secondary {\n    font-family: 'Georgia', 'Times New Roman', serif;\n    font-weight: 700;\n    font-size: 72px;\n    line-height: 1.10;\n    letter-spacing: -0.054em;\n    color: var(--color-soft-amethyst);\n    text-align: center;\n    margin: 0 0 24px 0;\n    padding: 0;\n  }\n\n  .hero-subtext {\n    font-family: var(--font-inter);\n    font-size: 18px;\n    font-weight: 500;\n    line-height: 1.5;\n    color: var(--color-pure-white);\n    text-align: center;\n    margin: 0 0 36px 0;\n    opacity: 0.92;\n  }\n\n  .hero-cta-btn {\n    display: inline-block;\n    background: var(--color-carbon);\n    color: var(--color-pure-white);\n    font-family: var(--font-inter);\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1;\n    padding: 18px 48px;\n    border-radius: 40px;\n    border: none;\n    cursor: pointer;\n    text-decoration: none;\n    margin-bottom: 16px;\n    box-shadow: 0 4px 0 0 #1a1a1a;\n    letter-spacing: 0;\n  }\n\n  .hero-trial-copy {\n    font-family: var(--font-inter);\n    font-size: 13px;\n    font-weight: 400;\n    color: var(--color-soft-amethyst);\n    text-align: center;\n    margin: 0;\n    opacity: 0.8;\n  }\n</style>\n<div class=\"hero-cta-wrapper\">\n  <div class=\"hero-headline-primary\">Record</div>\n  <div class=\"hero-headline-secondary\">incredible videos</div>\n  <p class=\"hero-subtext\">Tella is the screen recorder that edits videos for you.</p>\n  <a href=\"#\" class=\"hero-cta-btn\">Get started</a>\n  <p class=\"hero-trial-copy\">7-day Free trial \u2014 no credit card required</p>\n</div>",
    "name": "Hero CTA Section",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --color-signal-violet: #5e51f8;\n    --color-powder-violet: #d7d3fd;\n    --color-soft-amethyst: #cfcbfd;\n    --color-periwinkle-glow: #867dfa;\n    --color-ink: #0f172a;\n    --color-slate: #475569;\n    --color-ash-border: #e5e7eb;\n    --color-pure-white: #ffffff;\n    --color-chalk: #f8fafc;\n    --shadow-xl: rgba(0, 0, 0, 0.15) 0px 8px 32px 4px;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n\n  .feature-cards-wrapper {\n    background: var(--color-chalk);\n    width: 600px;\n    box-sizing: border-box;\n    padding: 40px 24px;\n    font-family: var(--font-inter);\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n\n  .feature-card {\n    background: var(--color-pure-white);\n    border: 1px solid var(--color-ash-border);\n    border-radius: 32px;\n    padding: 28px 28px 0 28px;\n    box-shadow: var(--shadow-xl);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .feature-card-header {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 10px;\n  }\n\n  .feature-card-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--color-periwinkle-glow);\n    flex-shrink: 0;\n  }\n\n  .feature-card-title {\n    font-family: var(--font-inter);\n    font-size: 18px;\n    font-weight: 700;\n    color: var(--color-ink);\n    margin: 0;\n    letter-spacing: -0.01em;\n  }\n\n  .feature-card-body {\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 400;\n    color: var(--color-slate);\n    line-height: 1.6;\n    margin: 0 0 24px 0;\n  }\n\n  .feature-card-illustration {\n    height: 120px;\n    border-radius: 16px 16px 0 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    position: relative;\n    margin: 0 -4px;\n  }\n\n  .illustration-silences {\n    background: linear-gradient(180deg, #faf9ff 0%, #f0eeff 100%);\n    gap: 8px;\n    padding: 16px;\n  }\n\n  .trash-group {\n    display: flex;\n    gap: 14px;\n    opacity: 0.5;\n  }\n\n  .trash-icon-svg {\n    color: var(--color-powder-violet);\n  }\n\n  .illustration-filler {\n    background: linear-gradient(180deg, #faf9ff 0%, #f0eeff 100%);\n    flex-direction: column;\n    justify-content: flex-end;\n    padding: 0 24px;\n    gap: 0;\n  }\n\n  .filler-text {\n    font-family: var(--font-inter);\n    font-weight: 700;\n    color: var(--color-powder-violet);\n    line-height: 1;\n    text-align: left;\n    width: 100%;\n  }\n</style>\n<div class=\"feature-cards-wrapper\">\n\n  <!-- Card 1: Delete silences -->\n  <div class=\"feature-card\">\n    <div class=\"feature-card-header\">\n      <span class=\"feature-card-icon\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polygon points=\"11 5 6 9 2 9 2 15 6 15 11 19 11 5\"/>\n          <line x1=\"23\" y1=\"9\" x2=\"17\" y2=\"15\"/>\n          <line x1=\"17\" y1=\"9\" x2=\"23\" y2=\"15\"/>\n        </svg>\n      </span>\n      <h3 class=\"feature-card-title\">Delete silences</h3>\n    </div>\n    <p class=\"feature-card-body\">No moment of silence needed. Chuck all the quiet bits in the bin \u2014 instantly.</p>\n    <div class=\"feature-card-illustration illustration-silences\">\n      <div class=\"trash-group\">\n        <svg width=\"28\" height=\"36\" viewBox=\"0 0 28 36\" fill=\"none\" stroke=\"#d7d3fd\" stroke-width=\"1.5\">\n          <rect x=\"4\" y=\"10\" width=\"20\" height=\"24\" rx=\"2\"/>\n          <line x1=\"0\" y1=\"10\" x2=\"28\" y2=\"10\"/>\n          <line x1=\"10\" y1=\"10\" x2=\"10\" y2=\"6\"/>\n          <line x1=\"18\" y1=\"10\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"6\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"16\" x2=\"10\" y2=\"28\"/>\n          <line x1=\"14\" y1=\"16\" x2=\"14\" y2=\"28\"/>\n          <line x1=\"18\" y1=\"16\" x2=\"18\" y2=\"28\"/>\n        </svg>\n        <svg width=\"28\" height=\"36\" viewBox=\"0 0 28 36\" fill=\"none\" stroke=\"#cfcbfd\" stroke-width=\"1.5\">\n          <rect x=\"4\" y=\"10\" width=\"20\" height=\"24\" rx=\"2\"/>\n          <line x1=\"0\" y1=\"10\" x2=\"28\" y2=\"10\"/>\n          <line x1=\"10\" y1=\"10\" x2=\"10\" y2=\"6\"/>\n          <line x1=\"18\" y1=\"10\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"6\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"16\" x2=\"10\" y2=\"28\"/>\n          <line x1=\"14\" y1=\"16\" x2=\"14\" y2=\"28\"/>\n          <line x1=\"18\" y1=\"16\" x2=\"18\" y2=\"28\"/>\n        </svg>\n        <svg width=\"28\" height=\"36\" viewBox=\"0 0 28 36\" fill=\"none\" stroke=\"#d7d3fd\" stroke-width=\"1.5\">\n          <rect x=\"4\" y=\"10\" width=\"20\" height=\"24\" rx=\"2\"/>\n          <line x1=\"0\" y1=\"10\" x2=\"28\" y2=\"10\"/>\n          <line x1=\"10\" y1=\"10\" x2=\"10\" y2=\"6\"/>\n          <line x1=\"18\" y1=\"10\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"6\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"16\" x2=\"10\" y2=\"28\"/>\n          <line x1=\"14\" y1=\"16\" x2=\"14\" y2=\"28\"/>\n          <line x1=\"18\" y1=\"16\" x2=\"18\" y2=\"28\"/>\n        </svg>\n        <svg width=\"28\" height=\"36\" viewBox=\"0 0 28 36\" fill=\"none\" stroke=\"#cfcbfd\" stroke-width=\"1.5\">\n          <rect x=\"4\" y=\"10\" width=\"20\" height=\"24\" rx=\"2\"/>\n          <line x1=\"0\" y1=\"10\" x2=\"28\" y2=\"10\"/>\n          <line x1=\"10\" y1=\"10\" x2=\"10\" y2=\"6\"/>\n          <line x1=\"18\" y1=\"10\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"6\" x2=\"18\" y2=\"6\"/>\n          <line x1=\"10\" y1=\"16\" x2=\"10\" y2=\"28\"/>\n          <line x1=\"14\" y1=\"16\" x2=\"14\" y2=\"28\"/>\n          <line x1=\"18\" y1=\"16\" x2=\"18\" y2=\"28\"/>\n        </svg>\n      </div>\n    </div>\n  </div>\n\n  <!-- Card 2: Remove filler words -->\n  <div class=\"feature-card\">\n    <div class=\"feature-card-header\">\n      <span class=\"feature-card-icon\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z\"/>\n        </svg>\n      </span>\n      <h3 class=\"feature-card-title\">Remove filler words</h3>\n    </div>\n    <p class=\"feature-card-body\">You can um and ah all you like, no one will ever know. Cut every filler word with just a click.</p>\n    <div class=\"feature-card-illustration illustration-filler\" style=\"height:110px; background: linear-gradient(180deg, #faf9ff 0%, #f0eeff 100%); display:flex; flex-direction:column; justify-content:flex-end; padding: 0 20px; overflow:hidden; border-radius: 16px 16px 0 0; margin: 0 -4px;\">\n      <div class=\"filler-text\" style=\"font-size:22px; opacity:0.55;\">um</div>\n      <div class=\"filler-text\" style=\"font-size:30px; opacity:0.7;\">ahh</div>\n      <div class=\"filler-text\" style=\"font-size:36px; opacity:0.85; margin-bottom:0;\">ehhh</div>\n    </div>\n  </div>\n\n  <!-- Card 3: Edit with text -->\n  <div class=\"feature-card\">\n    <div class=\"feature-card-header\">\n      <span class=\"feature-card-icon\">\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"/>\n          <path d=\"M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z\"/>\n        </svg>\n      </span>\n      <h3 class=\"feature-card-title\">Edit with text</h3>\n    </div>\n    <p class=\"feature-card-body\">Time's up for the timeline. The transcript era is here. Edit your video just like a document.</p>\n    <div style=\"background: #ffffff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 14px 16px; margin-bottom: 24px; font-family: 'Inter', sans-serif; font-size: 13px; line-height: 1.7; color: #475569;\">\n      Using custom layouts can be a little bit tricky. <span style=\"text-decoration: line-through; color: #d7d3fd;\">We need to make this better,</span> but I'll show you the way that I like to use them, which I think makes it a bit easier. <span style=\"color: #5e51f8;\">something</span> similar to what you did, <span style=\"color: #d7d3fd; text-decoration: line-through;\">which is like this. And then we</span> put the camera bubble, <span style=\"color: #d7d3fd;\">like</span> here.\n    </div>\n  </div>\n\n</div>",
    "name": "Feature Cards Grid",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --color-signal-violet: #5e51f8;\n    --color-soft-amethyst: #cfcbfd;\n    --color-pure-white: #ffffff;\n    --color-ink: #0f172a;\n    --color-slate: #475569;\n    --color-carbon: #111111;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n\n  .tab-demo-wrapper {\n    background: radial-gradient(50% 200% at 50% -100%, rgb(119, 107, 255) 0%, rgb(94, 81, 248) 100%), linear-gradient(rgb(94, 81, 248) 0%, rgb(39, 21, 76) 100%);\n    width: 600px;\n    box-sizing: border-box;\n    padding: 40px 32px 48px;\n    font-family: var(--font-inter);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 32px;\n  }\n\n  /* Tab Selector */\n  .tab-selector {\n    display: flex;\n    align-items: center;\n    gap: 4px;\n    background: rgba(255,255,255,0.1);\n    border-radius: 40px;\n    padding: 4px;\n  }\n\n  .tab-item {\n    font-family: var(--font-inter);\n    font-size: 14px;\n    font-weight: 600;\n    padding: 8px 22px;\n    border-radius: 40px;\n    cursor: pointer;\n    text-decoration: none;\n    letter-spacing: 0;\n    transition: all 0.15s ease;\n  }\n\n  .tab-item--inactive {\n    color: rgba(255,255,255,0.6);\n    background: transparent;\n  }\n\n  .tab-item--active {\n    background: var(--color-pure-white);\n    color: var(--color-ink);\n    box-shadow: rgba(0, 0, 0, 0.16) 0px 2px 4px 0px, rgba(0, 0, 0, 0.16) 0px 4px 8px 0px, rgba(255, 255, 255, 0.25) 0px 1px 1px 0px inset;\n  }\n\n  /* Video Demo Card */\n  .video-demo-card {\n    background: rgba(255,255,255,0.13);\n    border: 1px solid rgba(255,255,255,0.18);\n    border-radius: 24px;\n    padding: 16px;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    width: 100%;\n    box-sizing: border-box;\n    box-shadow: rgba(0,0,0,0.15) 0px 8px 32px 0px;\n  }\n\n  .video-thumbnail {\n    width: 148px;\n    height: 88px;\n    border-radius: 12px;\n    background: #2a1d3e;\n    flex-shrink: 0;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .video-thumbnail-bg {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(135deg, #3d2960 0%, #1e1230 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .play-btn {\n    width: 36px;\n    height: 36px;\n    background: rgba(255,255,255,0.92);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 1;\n    position: relative;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.3);\n  }\n\n  .play-btn svg {\n    margin-left: 3px;\n  }\n\n  .video-demo-text {\n    display: flex;\n    flex-direction: column;\n    gap: 6px;\n  }\n\n  .video-demo-title {\n    font-family: var(--font-inter);\n    font-size: 18px;\n    font-weight: 700;\n    color: var(--color-pure-white);\n    line-height: 1.25;\n    margin: 0;\n  }\n\n  .video-demo-link {\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 500;\n    color: var(--color-soft-amethyst);\n    text-decoration: none;\n    margin: 0;\n  }\n\n  /* Social proof row */\n  .social-proof {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 14px;\n    width: 100%;\n  }\n\n  .social-proof-label {\n    font-family: var(--font-inter);\n    font-size: 13px;\n    font-weight: 500;\n    color: var(--color-soft-amethyst);\n    opacity: 0.8;\n    text-align: center;\n  }\n\n  .avatar-row {\n    display: flex;\n    align-items: center;\n  }\n\n  .avatar {\n    width: 40px;\n    height: 40px;\n    border-radius: 9999px;\n    border: 2.5px solid rgba(94, 81, 248, 0.6);\n    margin-left: -10px;\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    font-weight: 600;\n    color: #fff;\n    overflow: hidden;\n  }\n\n  .avatar:first-child { margin-left: 0; }\n\n  .avatar-a { background: linear-gradient(135deg, #f97316, #ef4444); }\n  .avatar-b { background: linear-gradient(135deg, #8b5cf6, #6366f1); }\n  .avatar-c { background: linear-gradient(135deg, #06b6d4, #3b82f6); }\n  .avatar-d { background: linear-gradient(135deg, #10b981, #059669); }\n  .avatar-e { background: linear-gradient(135deg, #f59e0b, #f97316); }\n  .avatar-f { background: linear-gradient(135deg, #ec4899, #a855f7); }\n  .avatar-g { background: linear-gradient(135deg, #14b8a6, #0ea5e9); }\n  .avatar-h { background: linear-gradient(135deg, #6366f1, #8b5cf6); }\n  .avatar-i { background: #fbbf24; color: #111; }\n  .avatar-j { background: linear-gradient(135deg, #ef4444, #f97316); }\n  .avatar-more { background: rgba(255,255,255,0.15); color: var(--color-soft-amethyst); font-size: 12px; }\n</style>\n\n<div class=\"tab-demo-wrapper\">\n\n  <!-- Tab Selector -->\n  <div class=\"tab-selector\">\n    <a href=\"#\" class=\"tab-item tab-item--inactive\">Demos</a>\n    <a href=\"#\" class=\"tab-item tab-item--active\">Tutorials</a>\n    <a href=\"#\" class=\"tab-item tab-item--inactive\">Courses</a>\n  </div>\n\n  <!-- Video Demo Card -->\n  <div class=\"video-demo-card\">\n    <div class=\"video-thumbnail\">\n      <div class=\"video-thumbnail-bg\"></div>\n      <div class=\"play-btn\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n          <path d=\"M3 2L12 7L3 12V2Z\" fill=\"#111111\"/>\n        </svg>\n      </div>\n    </div>\n    <div class=\"video-demo-text\">\n      <p class=\"video-demo-title\">Make a Tella Video In Under 60 Seconds! \u26a1</p>\n      <a href=\"#\" class=\"video-demo-link\">Watch the demo</a>\n    </div>\n  </div>\n\n  <!-- Social Proof Avatar Row -->\n  <div class=\"social-proof\">\n    <p class=\"social-proof-label\">Join thousands of entrepreneurs creating videos with Tella</p>\n    <div class=\"avatar-row\">\n      <div class=\"avatar avatar-a\">A</div>\n      <div class=\"avatar avatar-b\">M</div>\n      <div class=\"avatar avatar-c\">J</div>\n      <div class=\"avatar avatar-d\">S</div>\n      <div class=\"avatar avatar-e\">R</div>\n      <div class=\"avatar avatar-f\">K</div>\n      <div class=\"avatar avatar-g\">T</div>\n      <div class=\"avatar avatar-h\">L</div>\n      <div class=\"avatar avatar-i\">\ud83d\ude0a</div>\n      <div class=\"avatar avatar-j\">P</div>\n      <div class=\"avatar avatar-more\">+</div>\n    </div>\n  </div>\n\n</div>",
    "name": "Tab Selector + Video Demo Card",
    "role": "",
    "description": ""
  },
  {
    "name": "Hero Primary CTA Button",
    "role": "Main conversion action on the violet hero",
    "description": "40px border-radius pill, #111111 background, #ffffff text, Inter 600 16px. Sits inside a fully saturated violet hero \u2014 the deliberate darkness makes it recede into urgency rather than compete with the background. Padding approximately 16px 32px. No border."
  },
  {
    "name": "Lavender Accent Pill Button",
    "role": "Secondary or decorative CTA variant",
    "description": "40px border-radius pill, #d5a8f5 background, #000000 text, #000000 border. Inter 600 14-16px. Used as a visual counterpoint \u2014 warm pastel against violet \u2014 creates a softer entry point alongside the hard dark CTA."
  },
  {
    "name": "Ghost Navigation Link",
    "role": "Top nav links (Features, Resources, Pricing)",
    "description": "No background, no border. Inter 500 16px, #475569 text color on white nav, #ffffff on dark sections. Hover state likely adds #5e51f8 color. Letter-spacing normal."
  },
  {
    "name": "Outlined Sign Up Button",
    "role": "Nav bar secondary action",
    "description": "40px border-radius pill, transparent background, #000000 border 1px solid, #000000 text on light nav. Inter 600 14px. Padding 8px 20px. On dark hero sections, border becomes #ffffff."
  },
  {
    "name": "Feature Card",
    "role": "Individual feature showcase in the horizontal scrolling card grid",
    "description": "32px border-radius, #ffffff background, #e5e7eb border 1px solid, shadow rgba(0,0,0,0.15) 0px 8px 32px 4px. Padding 24px. Interior contains an icon (16px, #5e51f8 or #867dfa fill), Inter 700 18px heading in #0f172a, Inter 400 16px body in #475569. Feature illustration in the lower half uses #d7d3fd and #cfcbfd tints on white \u2014 brand-colored at low saturation."
  },
  {
    "name": "Tab Selector (Demo/Tutorials/Courses)",
    "role": "Content filter tabs beneath the hero product screenshot",
    "description": "Active state: 40px radius pill, #ffffff background, Inter 600 14px #0f172a text, shadow rgba(0,0,0,0.16) 0px 2px 4px, rgba(0,0,0,0.16) 0px 4px 8px, rgba(255,255,255,0.25) 0px 1px 1px inset. Inactive: no background, #ffffff text at reduced opacity. Container: semi-transparent violet surface."
  },
  {
    "name": "Video Demo Card",
    "role": "Inline video teaser with play button",
    "description": "24px border-radius card, #ffffff background, shadow rgba(0,0,0,0.15) 0px 8px 32px 0px. Contains thumbnail image at 16px radius left side, Inter 700 20px headline #0f172a, Inter 500 16px link text in #5e51f8 ('Watch the demo'). Positioned floating over the violet-to-white transition band."
  },
  {
    "name": "Product Screenshot Frame",
    "role": "Showcasing the Tella app UI within the hero",
    "description": "16px border-radius on the inner screen content, dark bezel (#111111) at ~8-12px around the screen. Shadow: rgba(238,217,253,0.25) 0px 16px 64px 4px + rgba(0,0,0,0.1) 0px 8px 32px 0px. The lavender-tinted outer glow is the signature \u2014 elevation feels brand-colored, not neutral."
  },
  {
    "name": "Social Proof Avatar Row",
    "role": "Trust signal showing user community",
    "description": "Horizontally scrolling row of circular avatars (40px diameter, 9999px radius). Overlapping arrangement with 16px negative margin between each. Centered below the hero. Caption text Inter 500 14px #475569 centered above."
  },
  {
    "name": "Gear List / Content Card",
    "role": "Embedded product content card (within app screenshot)",
    "description": "24px border-radius, #ffffff background, border #e5e7eb 1px. Internal layout: image left (product photo at 16px radius), text right with Inter 700 16px title #0f172a, body Inter 400 14px #475569. CTA pill button '#5e51f8 background, #ffffff text, 40px radius' inside the card."
  },
  {
    "name": "Footnote / Trial Copy",
    "role": "De-emphasised trust copy beneath primary CTA",
    "description": "Inter 400 12px, #cfcbfd color on dark violet, centered. No background. Used for '7-day Free trial \u2014 no credit card required' messaging."
  }
]
