[
  {
    "html": "<style>\n  :root {\n    --color-teams-violet: #5d5bd4;\n    --color-teams-midnight: #333275;\n    --color-teams-deep: #424197;\n    --color-microsoft-blue: #0067b8;\n    --color-ink-navy: #17253d;\n    --color-abyss-navy: #0e1726;\n    --color-steel: #616161;\n    --color-graphite: #262626;\n    --color-cloud: #ffffff;\n    --color-frost: #f2f2f2;\n    --color-mist: #bdc5d2;\n    --color-near-white: #fefefe;\n    --font-segoe-ui-variable-text: 'Inter Variable', 'Inter', system-ui, sans-serif;\n    --font-segoe-ui-variable-display: 'Inter Variable', 'Inter', system-ui, sans-serif;\n    --shadow-subtle: rgba(0,0,0,0.12) 0px 0px 2px 0px, rgba(0,0,0,0.14) 0px 2px 4px 0px;\n  }\n  .btn-group-wrapper {\n    background: var(--color-cloud);\n    padding: 48px 40px;\n    font-family: var(--font-segoe-ui-variable-text);\n    display: flex;\n    flex-direction: column;\n    gap: 32px;\n    max-width: 600px;\n    box-sizing: border-box;\n  }\n  .btn-group-label {\n    font-size: 12px;\n    font-weight: 600;\n    color: var(--color-ink-navy);\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    margin: 0 0 4px 0;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .btn-group-row {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    flex-wrap: wrap;\n  }\n  .btn-primary {\n    background-color: var(--color-teams-violet);\n    color: var(--color-cloud);\n    border: none;\n    border-radius: 8px;\n    padding: 10px 20px;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: -0.025em;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-block;\n    line-height: 1.4;\n    transition: background 0.15s;\n  }\n  .btn-primary:hover {\n    background-color: var(--color-teams-deep);\n  }\n  .btn-outline {\n    background-color: transparent;\n    color: var(--color-graphite);\n    border: 1.5px solid var(--color-mist);\n    border-radius: 8px;\n    padding: 10px 20px;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: -0.025em;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-block;\n    line-height: 1.4;\n    transition: border-color 0.15s, color 0.15s;\n  }\n  .btn-outline:hover {\n    border-color: var(--color-ink-navy);\n    color: var(--color-ink-navy);\n  }\n  .btn-pill {\n    background-color: var(--color-teams-violet);\n    color: var(--color-cloud);\n    border: none;\n    border-radius: 200px;\n    padding: 10px 24px;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: -0.025em;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-block;\n    line-height: 1.4;\n    transition: background 0.15s;\n  }\n  .btn-pill:hover {\n    background-color: var(--color-teams-deep);\n  }\n  .btn-link {\n    background-color: transparent;\n    color: var(--color-microsoft-blue);\n    border: none;\n    border-radius: 0;\n    padding: 10px 0;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 15px;\n    font-weight: 400;\n    letter-spacing: -0.025em;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    line-height: 1.4;\n  }\n  .btn-link svg {\n    flex-shrink: 0;\n  }\n  .btn-icon-circle {\n    background-color: var(--color-teams-violet);\n    color: var(--color-cloud);\n    border: none;\n    border-radius: 8px;\n    width: 36px;\n    height: 36px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    flex-shrink: 0;\n  }\n  .btn-more-info {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    text-decoration: none;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .btn-more-info-text {\n    color: var(--color-microsoft-blue);\n    font-size: 15px;\n    font-weight: 400;\n    letter-spacing: -0.025em;\n  }\n  .section-divider {\n    height: 1px;\n    background: var(--color-mist);\n    border: none;\n    margin: 0;\n  }\n  .variant-title {\n    font-size: 11px;\n    color: var(--color-steel);\n    font-family: var(--font-segoe-ui-variable-text);\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    margin-bottom: 12px;\n    font-weight: 400;\n  }\n</style>\n<div class=\"btn-group-wrapper\">\n  <div>\n    <p class=\"btn-group-label\">Componentes de bot\u00f3n</p>\n  </div>\n  <div>\n    <div class=\"variant-title\">Primario \u00b7 Descarga y conversi\u00f3n</div>\n    <div class=\"btn-group-row\">\n      <a class=\"btn-primary\" href=\"#\">Descargar ahora</a>\n      <a class=\"btn-primary\" href=\"#\">Consultar planes y precios</a>\n    </div>\n  </div>\n  <hr class=\"section-divider\">\n  <div>\n    <div class=\"variant-title\">Secundario \u00b7 Acciones de apoyo</div>\n    <div class=\"btn-group-row\">\n      <a class=\"btn-outline\" href=\"#\">Descargar Teams</a>\n      <a class=\"btn-outline\" href=\"#\">Iniciar sesi\u00f3n</a>\n    </div>\n  </div>\n  <hr class=\"section-divider\">\n  <div>\n    <div class=\"variant-title\">Pill \u00b7 Variante para fondos de imagen</div>\n    <div class=\"btn-group-row\">\n      <a class=\"btn-pill\" href=\"#\">Probar gratis</a>\n    </div>\n  </div>\n  <hr class=\"section-divider\">\n  <div>\n    <div class=\"variant-title\">Enlace con icono \u00b7 Navegaci\u00f3n de contenido</div>\n    <div class=\"btn-group-row\">\n      <a class=\"btn-more-info\" href=\"#\">\n        <span class=\"btn-icon-circle\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M5 2.5L9.5 7L5 11.5\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n        <span class=\"btn-more-info-text\">M\u00e1s informaci\u00f3n</span>\n      </a>\n    </div>\n  </div>\n</div>",
    "name": "Primary CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-teams-violet: #5d5bd4;\n    --color-microsoft-blue: #0067b8;\n    --color-ink-navy: #17253d;\n    --color-abyss-navy: #0e1726;\n    --color-steel: #616161;\n    --color-graphite: #262626;\n    --color-cloud: #ffffff;\n    --color-frost: #f2f2f2;\n    --color-mist: #bdc5d2;\n    --color-near-white: #fefefe;\n    --color-lace: #fbf5fb;\n    --font-segoe-ui-variable-text: 'Inter Variable', 'Inter', system-ui, sans-serif;\n    --shadow-subtle: rgba(0,0,0,0.12) 0px 0px 2px 0px, rgba(0,0,0,0.14) 0px 2px 4px 0px;\n  }\n  .cards-section {\n    background: var(--color-lace);\n    padding: 48px 24px;\n    font-family: var(--font-segoe-ui-variable-text);\n    box-sizing: border-box;\n    max-width: 600px;\n  }\n  .section-eyebrow {\n    font-size: 12px;\n    font-weight: 600;\n    color: var(--color-ink-navy);\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    margin: 0 0 12px 0;\n    display: block;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .section-heading {\n    font-size: 32px;\n    font-weight: 600;\n    color: var(--color-abyss-navy);\n    letter-spacing: -0.015em;\n    line-height: 1.25;\n    margin: 0 0 32px 0;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .cards-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n  .article-card {\n    background: var(--color-near-white);\n    border-radius: 24px;\n    box-shadow: var(--shadow-subtle);\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n  .card-img-placeholder {\n    width: 100%;\n    height: 180px;\n    background: linear-gradient(135deg, #c8c6e8 0%, #a5a3d4 40%, #8683c4 100%);\n    flex-shrink: 0;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n  }\n  .card-img-placeholder-2 {\n    background: linear-gradient(135deg, #b8d4e8 0%, #8fb8d4 40%, #6696b8 100%);\n  }\n  .card-img-inner {\n    width: 80%;\n    height: 70%;\n    background: rgba(255,255,255,0.15);\n    border-radius: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .card-img-icon {\n    opacity: 0.5;\n  }\n  .card-body {\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    flex: 1;\n  }\n  .card-title {\n    font-size: 20px;\n    font-weight: 600;\n    color: var(--color-ink-navy);\n    letter-spacing: -0.025em;\n    line-height: 1.3;\n    margin: 0;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .card-body-text {\n    font-size: 14px;\n    font-weight: 400;\n    color: var(--color-steel);\n    letter-spacing: -0.03em;\n    line-height: 1.5;\n    margin: 0;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .card-footer {\n    padding: 0 24px 24px 24px;\n    margin-top: auto;\n  }\n  .card-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    text-decoration: none;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .card-link-icon {\n    background-color: var(--color-teams-violet);\n    border-radius: 8px;\n    width: 32px;\n    height: 32px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .card-link-text {\n    font-size: 15px;\n    font-weight: 400;\n    color: var(--color-microsoft-blue);\n    letter-spacing: -0.025em;\n  }\n</style>\n<div class=\"cards-section\">\n  <span class=\"section-eyebrow\">Noticias destacadas</span>\n  <h2 class=\"section-heading\">Descubre qu\u00e9 pasa con Teams</h2>\n  <div class=\"cards-grid\">\n    <div class=\"article-card\">\n      <div class=\"card-img-placeholder\">\n        <div class=\"card-img-inner\">\n          <svg class=\"card-img-icon\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <rect x=\"6\" y=\"10\" width=\"36\" height=\"28\" rx=\"4\" stroke=\"white\" stroke-width=\"2\" fill=\"none\"/>\n            <rect x=\"10\" y=\"14\" width=\"12\" height=\"8\" rx=\"2\" fill=\"white\" fill-opacity=\"0.6\"/>\n            <rect x=\"26\" y=\"14\" width=\"12\" height=\"8\" rx=\"2\" fill=\"white\" fill-opacity=\"0.6\"/>\n            <rect x=\"10\" y=\"26\" width=\"28\" height=\"2\" rx=\"1\" fill=\"white\" fill-opacity=\"0.4\"/>\n            <rect x=\"10\" y=\"30\" width=\"20\" height=\"2\" rx=\"1\" fill=\"white\" fill-opacity=\"0.4\"/>\n          </svg>\n        </div>\n      </div>\n      <div class=\"card-body\">\n        <h3 class=\"card-title\">De Hilos a Flujos de trabajo: caracter\u00edsticas de Microsoft Teams que aumentan la productividad de todos</h3>\n        <p class=\"card-body-text\">Las organizaciones buscan trabajar con mayor rapidez e inteligencia. Guiado por los comentarios de los clientes, Microsoft Teams est\u00e1 a\u00f1adiendo nuevas caracter\u00edsticas como hilos, m\u00faltiples reacciones con emojis y flujos de trabajo activados por emojis.</p>\n      </div>\n      <div class=\"card-footer\">\n        <a class=\"card-link\" href=\"#\">\n          <span class=\"card-link-icon\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M5 2.5L9.5 7L5 11.5\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </span>\n          <span class=\"card-link-text\">M\u00e1s informaci\u00f3n</span>\n        </a>\n      </div>\n    </div>\n    <div class=\"article-card\">\n      <div class=\"card-img-placeholder card-img-placeholder-2\">\n        <div class=\"card-img-inner\">\n          <svg class=\"card-img-icon\" width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <circle cx=\"24\" cy=\"18\" r=\"8\" stroke=\"white\" stroke-width=\"2\" fill=\"none\"/>\n            <path d=\"M10 38c0-7.732 6.268-14 14-14s14 6.268 14 14\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" fill=\"none\"/>\n          </svg>\n        </div>\n      </div>\n      <div class=\"card-body\">\n        <h3 class=\"card-title\">Crear indicaciones como un profesional con Microsoft 365 Copilot en Teams</h3>\n        <p class=\"card-body-text\">Descubre todo el potencial de toma de decisiones de tu equipo con indicaciones para Copilot en Teams. Simplifica y transforma tus reuniones para que todas las ideas se visualicen, eval\u00faen y hagan realidad.</p>\n      </div>\n      <div class=\"card-footer\">\n        <a class=\"card-link\" href=\"#\">\n          <span class=\"card-link-icon\">\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M5 2.5L9.5 7L5 11.5\" stroke=\"#ffffff\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n          </span>\n          <span class=\"card-link-text\">M\u00e1s informaci\u00f3n</span>\n        </a>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Article Preview Card Pair",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-teams-violet: #5d5bd4;\n    --color-teams-deep: #424197;\n    --color-microsoft-blue: #0067b8;\n    --color-ink-navy: #17253d;\n    --color-abyss-navy: #0e1726;\n    --color-steel: #616161;\n    --color-graphite: #262626;\n    --color-cloud: #ffffff;\n    --color-mist: #bdc5d2;\n    --color-near-white: #fefefe;\n    --font-segoe-ui-variable-text: 'Inter Variable', 'Inter', system-ui, sans-serif;\n    --shadow-subtle: rgba(0,0,0,0.12) 0px 0px 2px 0px, rgba(0,0,0,0.14) 0px 2px 4px 0px;\n  }\n  .tab-nav-wrapper {\n    background: var(--color-cloud);\n    border-bottom: 1px solid var(--color-mist);\n    font-family: var(--font-segoe-ui-variable-text);\n    max-width: 600px;\n    box-sizing: border-box;\n  }\n  .tab-nav-inner {\n    display: flex;\n    align-items: stretch;\n    justify-content: space-between;\n    height: 56px;\n    padding: 0 0 0 0;\n  }\n  .tab-nav-links {\n    display: flex;\n    align-items: stretch;\n    gap: 0;\n    overflow-x: auto;\n    scrollbar-width: none;\n    flex: 1;\n  }\n  .tab-nav-links::-webkit-scrollbar {\n    display: none;\n  }\n  .tab-link {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    padding: 0 16px;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 14px;\n    font-weight: 400;\n    color: var(--color-graphite);\n    letter-spacing: -0.03em;\n    text-decoration: none;\n    white-space: nowrap;\n    border-bottom: 2px solid transparent;\n    cursor: pointer;\n    transition: color 0.15s, border-color 0.15s;\n    box-sizing: border-box;\n    line-height: 1;\n    background: transparent;\n    border-top: none;\n    border-left: none;\n    border-right: none;\n    outline: none;\n  }\n  .tab-link:hover {\n    color: var(--color-ink-navy);\n  }\n  .tab-link.active {\n    color: var(--color-abyss-navy);\n    font-weight: 600;\n    border-bottom: 2px solid var(--color-abyss-navy);\n  }\n  .tab-nav-cta {\n    display: flex;\n    align-items: center;\n    padding: 0 0 0 16px;\n    flex-shrink: 0;\n  }\n  .tab-cta-btn {\n    background-color: var(--color-teams-violet);\n    color: var(--color-cloud);\n    border: none;\n    border-radius: 8px;\n    padding: 9px 16px;\n    font-family: var(--font-segoe-ui-variable-text);\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: -0.03em;\n    cursor: pointer;\n    text-decoration: none;\n    display: inline-block;\n    line-height: 1.4;\n    transition: background 0.15s;\n    white-space: nowrap;\n  }\n  .tab-cta-btn:hover {\n    background-color: var(--color-teams-deep);\n  }\n  .tab-content-preview {\n    background: var(--color-near-white);\n    padding: 32px 24px;\n    border-bottom: 1px solid var(--color-mist);\n  }\n  .tab-content-eyebrow {\n    font-size: 12px;\n    font-weight: 600;\n    color: var(--color-ink-navy);\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    display: block;\n    margin-bottom: 10px;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n  .tab-content-title {\n    font-size: 32px;\n    font-weight: 600;\n    color: var(--color-abyss-navy);\n    letter-spacing: -0.015em;\n    line-height: 1.25;\n    margin: 0;\n    font-family: var(--font-segoe-ui-variable-text);\n  }\n</style>\n<div style=\"background: var(--color-cloud); max-width:600px; font-family: var(--font-segoe-ui-variable-text);\">\n  <nav class=\"tab-nav-wrapper\">\n    <div class=\"tab-nav-inner\">\n      <div class=\"tab-nav-links\">\n        <a class=\"tab-link active\" href=\"#\">Noticias destacadas</a>\n        <a class=\"tab-link\" href=\"#\">Soluciones</a>\n        <a class=\"tab-link\" href=\"#\">Productos y servicios</a>\n        <a class=\"tab-link\" href=\"#\">Casos de clientes</a>\n        <a class=\"tab-link\" href=\"#\">Comenzar</a>\n      </div>\n      <div class=\"tab-nav-cta\">\n        <a class=\"tab-cta-btn\" href=\"#\">Consultar planes y precios</a>\n      </div>\n    </div>\n  </nav>\n  <div class=\"tab-content-preview\">\n    <span class=\"tab-content-eyebrow\">Noticias destacadas</span>\n    <h2 class=\"tab-content-title\">Reuniones y mensajer\u00eda m\u00e1s inteligentes con tecnolog\u00eda de IA</h2>\n  </div>\n</div>",
    "name": "Horizontal Section Tab Nav",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button",
    "role": "Main conversion action (Download, View Plans)",
    "description": "backgroundColor=#5d5bd4, color=#ffffff, borderRadius=8px, padding=8px 16px, font: Segoe UI Variable Text 500 15px. Hover darkens to #424197. The 8px radius is a hard corner relative to the 24px card radius \u2014 buttons feel precise, not soft."
  },
  {
    "name": "Ghost Navigation Button",
    "role": "Outline-style secondary actions in the top nav (Descargar Teams, Iniciar sesi\u00f3n)",
    "description": "backgroundColor=transparent, color=#262626, border=1px solid transparent (visual separation via spacing only), borderRadius=0px, padding=16px 30px 16px 12px. Zero border radius \u2014 purely typographic with no frame."
  },
  {
    "name": "Underline Navigation Button",
    "role": "Active tab/section indicator in horizontal content nav",
    "description": "backgroundColor=transparent, color=#0e1726, borderBottom=2px solid #0e1726, borderRadius=0px, padding=0 0 32px 0. Bottom border only \u2014 tab indicator with generous 32px bottom padding to position the underline at baseline distance."
  },
  {
    "name": "Pill Secondary Button",
    "role": "Decorative or secondary CTA overlaid on hero visual areas",
    "description": "backgroundColor=transparent, color=#ffffff, borderRadius=200px, padding=16px. Full pill shape reserved for white-text variants appearing over imagery \u2014 the only element with >24px radius, creating maximum contrast with sharp-cornered primary buttons."
  },
  {
    "name": "Transparent Content Card",
    "role": "Layout grouping without visual separation",
    "description": "backgroundColor=transparent, borderRadius=0px, boxShadow=none, padding=0. Used for grid cells that rely on surrounding whitespace rather than a surface for grouping."
  },
  {
    "name": "Labeled Badge",
    "role": "Section category labels (NOTICIAS DESTACADAS, SOLUCIONES)",
    "description": "backgroundColor=transparent, color=#17253d, borderRadius=0px, padding=0. Uppercase tracking at +0.08em (letterSpacing=0.08em via Segoe UI Variable Text), weight 600, 12px. Zero-padding text label \u2014 no visual container, relying on tracking and weight for distinction."
  },
  {
    "name": "Surface Badge",
    "role": "Tag chips on cards and content metadata",
    "description": "backgroundColor=#fefefe, color=#17253d, borderRadius=8px, padding=4px 8px. White card-colored surface with same 8px radius as buttons \u2014 system-consistent without hierarchical confusion."
  },
  {
    "name": "Top Navigation Bar",
    "role": "Global site header with Microsoft logo, product name, and nav links",
    "description": "backgroundColor=#ffffff, height=54px, borderBottom=1px solid #bdc5d2. Product name 'Teams' in Segoe UI Variable Text 600 at 15px. Nav items at 14px weight 400 #262626 with dropdown chevrons. Right-side CTAs use Ghost and Primary Button styles."
  },
  {
    "name": "Horizontal Section Tab Nav",
    "role": "In-page content navigation (Noticias destacadas, Soluciones, Productos y servicios)",
    "description": "backgroundColor=#ffffff, borderBottom=1px solid #bdc5d2, height=56px. Active item uses Underline Navigation Button style. Right-aligned CTA button uses Primary CTA Button style at #5d5bd4."
  },
  {
    "name": "Hero Section",
    "role": "Full-width page opener with headline, body, CTA, and product visual",
    "description": "backgroundColor=#ffffff (with #fbf5fb lilac tint at far right). Headline: Segoe UI Variable Display 600 48px tracking \u22120.01em, color=#0e1726. Body: 16px 400 #616161. CTA: Primary CTA Button. Right half: 3D product screenshot floating on illustrated background \u2014 image is contained, not full-bleed."
  },
  {
    "name": "Article Preview Card",
    "role": "News and blog post previews in card grid",
    "description": "Uses Elevated Content Card as container. Image fills top of card with no padding, borderRadius=24px 24px 0 0 clipping. Title: Segoe UI Variable Text 600 20px #17253d. Body: 14px 400 #616161. Footer: 'M\u00e1s informaci\u00f3n' link in Microsoft Blue (#0067b8) with right-arrow icon, 16px padding all sides."
  },
  {
    "name": "Floating Icon Bar",
    "role": "Fixed right-side quick-action icons (contact, mail, phone)",
    "description": "backgroundColor=#ffffff, borderRadius=24px 0 0 24px (left-side pill), boxShadow=rgba(0,0,0,0.12) 0px 0px 2px 0px, rgba(0,0,0,0.14) 0px 2px 4px 0px. Icon color #17253d. Positioned fixed right:0, vertically centered."
  }
]
