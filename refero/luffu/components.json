[
  {
    "html": "<div style=\"padding:40px;background:var(--color-parchment,#f5f5ee);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);max-width:600px;\">\n  <style>\n    :root {\n      --color-deep-ink:#192830;--color-parchment:#f5f5ee;--color-linen:#e4e7da;--color-pressed-cotton:#d7d7cb;--color-graphite:#2f3136;--color-slate:#535557;--color-dusk:#424e52;--color-white:#ffffff;--color-ink:#000000;--font-abc-arizona-sans:'Cormorant SC',Georgia,serif;--font-abc-arizona-flare:'Playfair Display','Cormorant Garamond',Georgia,serif;\n    }\n  </style>\n  <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;letter-spacing:-0.35px;line-height:1;color:var(--color-slate,#535557);margin:0 0 24px 0;text-transform:uppercase;\">Actions</p>\n\n  <div style=\"display:flex;flex-wrap:wrap;gap:16px;align-items:center;margin-bottom:32px;\">\n    <!-- Primary CTA Button -->\n    <a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:var(--color-deep-ink,#192830);color:var(--color-white,#ffffff);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:16px;font-weight:400;letter-spacing:-0.32px;line-height:1.2;padding:12px 20px;border-radius:4px;border:none;text-decoration:none;cursor:pointer;\">Join the Waitlist</a>\n\n    <!-- Ghost Navigation Button -->\n    <a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:var(--color-white,#ffffff);color:var(--color-deep-ink,#192830);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:16px;font-weight:400;letter-spacing:-0.32px;line-height:1.2;padding:4px 18px;border-radius:6px;border:1px solid var(--color-deep-ink,#192830);text-decoration:none;cursor:pointer;\">About</a>\n  </div>\n\n  <!-- Inline Waitlist Link-Button -->\n  <div style=\"margin-top:8px;\">\n    <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:12px;background:var(--color-white,#ffffff);color:var(--color-deep-ink,#192830);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:16px;font-weight:400;letter-spacing:-0.32px;line-height:1.2;padding:10px 18px;border-radius:6px;border:1px solid var(--color-deep-ink,#192830);text-decoration:none;cursor:pointer;\">\n      <span style=\"display:inline-flex;align-items:center;gap:8px;\">\n        <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\" style=\"flex-shrink:0;\"><circle cx=\"4\" cy=\"4\" r=\"4\" fill=\"var(--color-deep-ink,#192830)\"/></svg>\n        Join the waitlist\n      </span>\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" style=\"flex-shrink:0;\"><path d=\"M3 8h10M10 5l3 3-3 3\" stroke=\"var(--color-deep-ink,#192830)\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </a>\n  </div>\n</div>",
    "name": "Button Group (Primary CTA + Ghost + Inline Waitlist)",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"padding:60px 32px;background:var(--color-parchment,#f5f5ee);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);max-width:600px;\">\n  <style>\n    :root {\n      --color-deep-ink:#192830;--color-parchment:#f5f5ee;--color-linen:#e4e7da;--color-pressed-cotton:#d7d7cb;--color-graphite:#2f3136;--color-slate:#535557;--color-dusk:#424e52;--color-white:#ffffff;--color-ink:#000000;--font-abc-arizona-sans:'Cormorant SC',Georgia,serif;--font-abc-arizona-flare:'Playfair Display','Cormorant Garamond',Georgia,serif;\n    }\n  </style>\n\n  <!-- Floating question bubbles -->\n  <div style=\"display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-bottom:48px;\">\n    <span style=\"display:inline-block;font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;letter-spacing:-0.35px;line-height:1;color:var(--color-slate,#535557);padding:8px 16px;border:1px solid var(--color-pressed-cotton,#d7d7cb);border-radius:6px;background:var(--color-parchment,#f5f5ee);\">Is Dad's new meal plan affecting his blood pressure?</span>\n    <span style=\"display:inline-block;font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;letter-spacing:-0.35px;line-height:1;color:var(--color-slate,#535557);padding:8px 16px;border:1px solid var(--color-pressed-cotton,#d7d7cb);border-radius:6px;background:var(--color-parchment,#f5f5ee);\">Am I eating the right foods to manage PCOS?</span>\n    <span style=\"display:inline-block;font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;letter-spacing:-0.35px;line-height:1;color:var(--color-slate,#535557);padding:8px 16px;border:1px solid var(--color-pressed-cotton,#d7d7cb);border-radius:6px;background:var(--color-parchment,#f5f5ee);\">What happened at Grandpa's last doctor's visit?</span>\n    <span style=\"display:inline-block;font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;letter-spacing:-0.35px;line-height:1;color:var(--color-slate,#535557);padding:8px 16px;border:1px solid var(--color-pressed-cotton,#d7d7cb);border-radius:6px;background:var(--color-parchment,#f5f5ee);\">Is Grandma recovering from her surgery OK?</span>\n  </div>\n\n  <!-- Avatars row -->\n  <div style=\"display:flex;justify-content:center;gap:16px;margin-bottom:40px;\">\n    <div style=\"width:72px;height:72px;border-radius:9999px;background:var(--color-pressed-cotton,#d7d7cb);border:2px solid var(--color-linen,#e4e7da);\"></div>\n    <div style=\"width:72px;height:72px;border-radius:9999px;background:#a8b5a0;border:2px solid var(--color-linen,#e4e7da);\"></div>\n    <div style=\"width:72px;height:72px;border-radius:9999px;background:#c4b9a8;border:2px solid var(--color-linen,#e4e7da);\"></div>\n    <div style=\"width:72px;height:72px;border-radius:9999px;background:#b0bcc0;border:2px solid var(--color-linen,#e4e7da);\"></div>\n    <div style=\"width:72px;height:72px;border-radius:9999px;background:#c8c0b0;border:2px solid var(--color-linen,#e4e7da);\"></div>\n  </div>\n\n  <!-- Centered heading block -->\n  <div style=\"text-align:center;\">\n    <h2 style=\"font-family:var(--font-abc-arizona-flare,'Playfair Display','Cormorant Garamond',Georgia,serif);font-size:48px;font-weight:400;letter-spacing:-2.02px;line-height:1;color:var(--color-graphite,#2f3136);margin:0 0 24px 0;\">For the caregivers<br>who do it all</h2>\n    <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:16px;font-weight:400;letter-spacing:-0.32px;line-height:1.4;color:var(--color-slate,#535557);margin:0 auto;max-width:480px;\">Your mind's brimming with questions, concerns, and an ever-changing list of who-needs-what-when. Luffu learns your family's rhythms and stays on top of it all, so you can focus on caring.</p>\n  </div>\n</div>",
    "name": "Section Heading Block with Caregiver Questions",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"padding:48px 24px;background:var(--color-parchment,#f5f5ee);font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);max-width:600px;\">\n  <style>\n    :root {\n      --color-deep-ink:#192830;--color-parchment:#f5f5ee;--color-linen:#e4e7da;--color-pressed-cotton:#d7d7cb;--color-graphite:#2f3136;--color-slate:#535557;--color-dusk:#424e52;--color-white:#ffffff;--color-ink:#000000;--font-abc-arizona-sans:'Cormorant SC',Georgia,serif;--font-abc-arizona-flare:'Playfair Display','Cormorant Garamond',Georgia,serif;\n    }\n  </style>\n\n  <!-- Section heading -->\n  <div style=\"text-align:center;margin-bottom:40px;\">\n    <h2 style=\"font-family:var(--font-abc-arizona-flare,'Playfair Display','Cormorant Garamond',Georgia,serif);font-size:40px;font-weight:400;letter-spacing:-1.24px;line-height:1;color:var(--color-graphite,#2f3136);margin:0 0 16px 0;\">Effortless health logging for everyone</h2>\n    <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:16px;font-weight:400;letter-spacing:-0.32px;line-height:1.4;color:var(--color-slate,#535557);margin:0 auto;max-width:480px;\">Use voice, text, photos, or connect to devices, apps, and medical portals to instantly record data\u2014from health records and medications to meals and vitals for you and your whole family.</p>\n  </div>\n\n  <!-- Cards grid -->\n  <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;\">\n    <!-- Card 1: Natural Language -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"background:#9bb8c8;border-radius:6px;height:220px;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;position:relative;overflow:hidden;\">\n        <div style=\"width:64px;height:64px;border-radius:9999px;background:#c4b9a8;border:3px solid var(--color-white,#ffffff);margin-bottom:8px;\"></div>\n        <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;color:var(--color-white,#ffffff);letter-spacing:-0.32px;\">Mom</span>\n        <div style=\"position:absolute;bottom:40px;left:20px;right:20px;border-top:1px dotted rgba(255,255,255,0.4);\"></div>\n        <div style=\"position:absolute;bottom:16px;left:20px;display:flex;align-items:center;gap:4px;\">\n          <span style=\"color:#c85c3a;font-family:var(--font-abc-arizona-flare,'Playfair Display',Georgia,serif);font-size:18px;font-weight:400;font-style:italic;\">/</span>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;color:rgba(255,255,255,0.7);letter-spacing:-0.32px;\">weigh</span>\n        </div>\n      </div>\n      <div style=\"padding:12px 0 0 0;text-align:center;\">\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:12px;font-weight:400;letter-spacing:0.5px;line-height:1;color:var(--color-graphite,#2f3136);margin:0 0 4px 0;text-transform:uppercase;\">Natural Language</p>\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;font-weight:400;letter-spacing:-0.32px;line-height:1.3;color:var(--color-slate,#535557);margin:0;\">Easily log with voice or text.</p>\n      </div>\n    </div>\n\n    <!-- Card 2: Vision -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"background:#8a9088;border-radius:6px;height:220px;display:flex;align-items:center;justify-content:center;padding:24px;position:relative;overflow:hidden;\">\n        <div style=\"width:100px;height:100px;border-radius:9999px;background:#6b7a5e;border:2px solid rgba(255,255,255,0.5);\"></div>\n        <!-- Viewfinder corners -->\n        <div style=\"position:absolute;top:40px;left:30px;width:20px;height:20px;border-left:2px solid rgba(255,255,255,0.6);border-top:2px solid rgba(255,255,255,0.6);\"></div>\n        <div style=\"position:absolute;top:40px;right:30px;width:20px;height:20px;border-right:2px solid rgba(255,255,255,0.6);border-top:2px solid rgba(255,255,255,0.6);\"></div>\n        <div style=\"position:absolute;bottom:40px;left:30px;width:20px;height:20px;border-left:2px solid rgba(255,255,255,0.6);border-bottom:2px solid rgba(255,255,255,0.6);\"></div>\n        <div style=\"position:absolute;bottom:40px;right:30px;width:20px;height:20px;border-right:2px solid rgba(255,255,255,0.6);border-bottom:2px solid rgba(255,255,255,0.6);\"></div>\n      </div>\n      <div style=\"padding:12px 0 0 0;text-align:center;\">\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:12px;font-weight:400;letter-spacing:0.5px;line-height:1;color:var(--color-graphite,#2f3136);margin:0 0 4px 0;text-transform:uppercase;\">Vision</p>\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;font-weight:400;letter-spacing:-0.32px;line-height:1.3;color:var(--color-slate,#535557);margin:0;\">Take photos to log meals, medications, and more.</p>\n      </div>\n    </div>\n\n    <!-- Card 3: Connect -->\n    <div style=\"display:flex;flex-direction:column;\">\n      <div style=\"background:var(--color-linen,#e4e7da);border-radius:6px;height:220px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:20px;gap:10px;\">\n        <div style=\"display:flex;align-items:center;gap:8px;opacity:0.5;\">\n          <div style=\"width:18px;height:18px;border-radius:4px;background:var(--color-pressed-cotton,#d7d7cb);\"></div>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;color:var(--color-slate,#535557);letter-spacing:-0.32px;\">Medical Records</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n          <div style=\"width:18px;height:18px;border-radius:4px;background:#c85c3a;\"></div>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;color:var(--color-graphite,#2f3136);letter-spacing:-0.35px;font-weight:400;\">Lab Test</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n          <div style=\"width:18px;height:18px;border-radius:4px;background:var(--color-graphite,#2f3136);\"></div>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:15px;color:var(--color-graphite,#2f3136);letter-spacing:-0.32px;font-weight:400;\">Apple Health</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;\">\n          <div style=\"width:18px;height:18px;border-radius:4px;background:#5a8a6a;\"></div>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:14px;color:var(--color-graphite,#2f3136);letter-spacing:-0.35px;\">Vaccine Records</span>\n        </div>\n        <div style=\"display:flex;align-items:center;gap:8px;margin-top:4px;opacity:0.4;\">\n          <div style=\"width:36px;height:16px;border-radius:3px;background:var(--color-dusk,#424e52);\"></div>\n          <span style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:12px;color:var(--color-slate,#535557);letter-spacing:-0.32px;\">fitbit</span>\n        </div>\n      </div>\n      <div style=\"padding:12px 0 0 0;text-align:center;\">\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:12px;font-weight:400;letter-spacing:0.5px;line-height:1;color:var(--color-graphite,#2f3136);margin:0 0 4px 0;text-transform:uppercase;\">Connect</p>\n        <p style=\"font-family:var(--font-abc-arizona-sans,'Cormorant SC',Georgia,serif);font-size:13px;font-weight:400;letter-spacing:-0.32px;line-height:1.3;color:var(--color-slate,#535557);margin:0;\">Integrate with apps and wearables.</p>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Feature Cards \u2014 Health Logging 3-Up Grid",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button (Dark Fill)",
    "role": "Main conversion action \u2014 waitlist signup",
    "description": "Background #192830, white text (#ffffff), 4px border-radius, 0px vertical padding with 20px horizontal padding. ABC Arizona Sans 16px weight 400, letter-spacing -0.32px. The minimal vertical padding makes this feel like an inline chip rather than a traditional button \u2014 compact and editorial."
  },
  {
    "name": "Ghost Navigation Button (Outlined)",
    "role": "Secondary actions in the navigation bar",
    "description": "Background white (#ffffff), text #192830, border 1px solid #192830, 6px border-radius, 4px top/bottom padding, 18px left/right padding. ABC Arizona Sans 16px. Sits next to ghost text links \u2014 the light border marks it as actionable without using color."
  },
  {
    "name": "Inline Waitlist Link-Button",
    "role": "In-text or body-section CTA",
    "description": "White background, #192830 text, border 1px solid #192830, 6px radius, 4px/18px padding. Small arrow glyph appended after text ('Join the waitlist \u2192'). Uses the same construction as the nav button but with arrow affordance for in-context placement."
  },
  {
    "name": "Hero Full-Bleed Section",
    "role": "Above-the-fold full-viewport visual anchor",
    "description": "Full-width lifestyle photography spanning 100vw, headline text in ABC Arizona Flare 48px weight 400, white (#ffffff), letterSpacing -2.02px, positioned top-left over the image. Oversized brand wordmark 'Luffu' at ~120px+ Arizona Flare overlaid at bottom-left, white, bleeding into the image. Dark gradient overlay implied left-side for text legibility. Navigation floats over image with white text links and outlined ghost button."
  },
  {
    "name": "Feature Card \u2014 App Screen Preview",
    "role": "Product feature illustration in 3-up grid",
    "description": "Rounded card at 6px radius, image fills the card top, 32px internal padding on text area. Three cards in a row with 20px column gap. Each card has a subdued-tone background (desaturated blue or warm cream) rather than white. Category label in ABC Arizona Sans 14px uppercase tracked, body copy in Sans 16px #535557."
  },
  {
    "name": "Floating Family Member Avatar",
    "role": "Caregiver network visualization in mid-page section",
    "description": "Circular photo crops at 9999px border-radius, approximately 80-100px diameter, on the #f5f5ee parchment background. Small question text labels in Arizona Sans 14px #535557 float adjacent. No card container \u2014 avatars scatter with negative-space arrangement around a centered heading block."
  },
  {
    "name": "Section Heading Block (Centered)",
    "role": "Mid-page section introductions",
    "description": "Arizona Flare 48px #2f3136 letterSpacing -2.02px centered, followed by Arizona Sans 20px #535557 letterSpacing -0.32px body paragraph, also centered. Max-width approximately 600px on the paragraph to preserve narrow measure. No decorative elements \u2014 pure typographic hierarchy."
  },
  {
    "name": "Navigation Bar",
    "role": "Global persistent header",
    "description": "Transparent/overlay over hero photography, left-anchored brand logomark (floral icon + 'luffu' wordmark in white Arizona Flare). Right side: 'About' text link in white Arizona Sans 16px, and outlined ghost button 'Join the Waitlist'. No background color \u2014 floats over hero image. Height approximately 70px."
  },
  {
    "name": "Footer Strip",
    "role": "Site footer with legal and social links",
    "description": "Background near #393e28 (dark olive-near-black), white text links in Arizona Sans 14px. Social platform links (Instagram, LinkedIn, X, Facebook) and Privacy Notice. Compact height approximately 50px, full-width. The warm dark-olive footer background echoes the #192830 button tone \u2014 the only two dark surfaces on the page."
  }
]
