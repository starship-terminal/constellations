  {
    "name": "Ember Gradient CTA Button",
    "role": "Primary call-to-action, top nav and hero section",
    "description": "Background: linear-gradient(30deg, rgb(253,137,37), rgb(255,12,0)). Text: #ffffff, geomanist 400 14\u201316px. Border-radius: 8px. Padding: 10\u201314px vertical, 20\u201324px horizontal. No border. On hover, the gradient intensifies. This is the only warm-chromatic element in the nav."
  },
  {
    "name": "Ghost Outline Button",
    "role": "Secondary action, hero section ('Talk to sales')",
    "description": "Background: rgba(0,0,0,0). Border: 1px solid rgb(229,231,235) (#e5e7eb). Text: #ffffff, geomanist 400. Border-radius: 6px. Padding: 24px all sides (generous equal padding creates a square-ratio for short labels). Shadow: none."
  },
  {
    "name": "Frosted Ghost Button",
    "role": "Tertiary actions and icon buttons over dark card surfaces",
    "description": "Background: rgba(13,10,25,0.28). Border: 1px solid rgba(255,255,255,0.1). Text: rgb(209,206,206). Border-radius: 8px. Padding: 14px all sides. Box-shadow: rgba(0,0,0,0.26) 0px 0px 8px 0px. Translucent panel-within-panel effect."
  },
  {
    "name": "Pill Tag Button",
    "role": "Use-case category pills and filter selectors",
    "description": "Background: rgba(163,163,163,0.2). Border: 1px solid rgb(229,231,235). Text: #ffffff. Border-radius: 8px. Padding: 0 20px. Height implicit from line-height. Flat matte surface, no gradient."
  },
  {
    "name": "Feature Card",
    "role": "Primary content panels in features section",
    "description": "Background: rgb(26,22,36) (#1a1624). Border-radius: 16px. Padding: 48px 44px. No box-shadow. The elevated surface sits 1 step above the #0e0918 page background through color alone \u2014 no drop shadow needed."
  },
  {
    "name": "Glowing Inset Card",
    "role": "Highlighted stats, testimonials, community proof cards",
    "description": "Background: rgba(0,0,0,0) \u2014 transparent so page bg shows through. Border: rgba(255,255,255,0.1) 0px 0px 0px 1px inset (white hairline) + rgba(255,142,93,0.3) 0px 1px 0px 0px inset (orange bottom-edge glow). Border-radius: 24px. The orange inset bottom line mimics a backlit indicator."
  },
  {
    "name": "Dark Feature Panel",
    "role": "Full-width section panels with workflow canvas previews",
    "description": "Background: rgb(27,23,40) (#1b1728). Border-radius: 24px. No padding on container (content bleeds). Used as viewport-wide dark stage for product screenshots."
  },
  {
    "name": "Hiring Badge",
    "role": "Status indicator tags (e.g., 'Hiring' label in footer nav)",
    "description": "Background: #ffffff. Text: rgb(72,85,106) (#48556a), geomanist 400 12px. Border-radius: 24px. Padding: 4px 10px. White pill on dark background \u2014 maximum contrast for status signaling."
  },
  {
    "name": "Workflow Node",
    "role": "Canvas node objects in workflow diagram illustrations",
    "description": "Background: #1a1624 or app-brand color. Border-radius: 12px. Connected by lines using Electric Current gradient (linear-gradient(141deg, #077ac7, #6b21ef)). Icons centered with 40\u201348px container. Appear in product screenshot sections."
  },
  {
    "name": "Nav Bar",
    "role": "Sticky top navigation",
    "description": "Background: #0e0918 (same as page, full-bleed). Border-bottom: 1px solid #3e3a46. Height: 66px. Left: n8n logo with chain-link icon. Center: nav links in geomanist 400 14px, color #d1cece. Right: GitHub star count (pill, frosted glass), 'Sign in' ghost, 'Get Started' Ember gradient button at 8px radius."
  },
  {
    "name": "Social Proof Row",
    "role": "Logo bar showing enterprise customers",
    "description": "Background: transparent, sits within dark section. Logos rendered in #d1cece (muted ash) \u2014 desaturated to prevent brand color competition. No card wrapper, pure horizontal flex layout with 32\u201348px columnGap."
  },
  {
    "name": "Footer Mega-Nav",
    "role": "Site-wide footer with multi-column link grid",
    "description": "Background: radial-gradient warm ember glow (rgba(175,106,140,0.46) \u2192 rgba(98,65,83,0.38) \u2192 transparent) overlaid on #0e0918. Column headers in geomanist 400 14px #ffffff. Links in geomanist 300 14px #9d9797. 5-column grid. Top section has logo + tagline + social icons in #d1cece at 24px size."
  }
]
