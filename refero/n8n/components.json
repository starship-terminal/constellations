  {
    "html": "<div style=\"--color-void-base:#0e0918;--color-elevated-surface:#1a1624;--color-deep-panel:#1b1728;--color-muted-shell:#2c2834;--color-border-smoke:#3e3a46;--color-ash-text:#d1cece;--color-fog-text:#9d9797;--color-cloud-white:#ffffff;--color-ember-scorch:#ff492c;--color-ember-cta:linear-gradient(30deg,rgb(253,137,37),rgb(255,12,0));--font-geomanist:'DM Sans',sans-serif;background:var(--color-void-base);padding:48px 32px;width:600px;box-sizing:border-box;font-family:var(--font-geomanist);\"><p style=\"margin:0 0 32px;font-family:var(--font-geomanist);font-weight:300;font-size:12px;line-height:1.5;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-fog-text);\">Who it's for</p><div style=\"display:flex;flex-direction:row;gap:0;width:100%;\"><div style=\"width:200px;flex-shrink:0;display:flex;flex-direction:column;gap:4px;border-left:1px solid var(--color-border-smoke);padding-left:0;\"><div style=\"display:flex;flex-direction:row;align-items:flex-start;gap:0;border-left:2px solid var(--color-ember-scorch);padding:14px 16px 14px 18px;cursor:pointer;\"><div><p style=\"margin:0 0 2px;font-family:var(--font-geomanist);font-weight:400;font-size:15px;line-height:1.3;color:var(--color-cloud-white);\"><strong style=\"font-weight:600;\">IT Ops</strong> can</p><p style=\"margin:0;font-family:var(--font-geomanist);font-weight:400;font-size:14px;line-height:1.4;color:var(--color-ash-text);\">On-board new employees</p></div></div><div style=\"display:flex;flex-direction:row;align-items:flex-start;border-left:2px solid transparent;padding:14px 16px 14px 18px;cursor:pointer;\"><div><p style=\"margin:0 0 2px;font-family:var(--font-geomanist);font-weight:400;font-size:15px;line-height:1.3;color:var(--color-fog-text);\"><strong style=\"font-weight:600;\">Dev Ops</strong> can</p><p style=\"margin:0;font-family:var(--font-geomanist);font-weight:400;font-size:14px;line-height:1.4;color:var(--color-fog-text);\">Convert natural language into API calls</p></div></div><div style=\"display:flex;flex-direction:row;align-items:flex-start;border-left:2px solid transparent;padding:14px 16px 14px 18px;cursor:pointer;\"><div><p style=\"margin:0 0 2px;font-family:var(--font-geomanist);font-weight:400;font-size:15px;line-height:1.3;color:var(--color-fog-text);\"><strong style=\"font-weight:600;\">Sales</strong> can</p><p style=\"margin:0;font-family:var(--font-geomanist);font-weight:400;font-size:14px;line-height:1.4;color:var(--color-fog-text);\">Generate customer insights from reviews</p></div></div><div style=\"display:flex;flex-direction:row;align-items:flex-start;border-left:2px solid transparent;padding:14px 16px 14px 18px;cursor:pointer;\"><div><p style=\"margin:0 0 2px;font-family:var(--font-geomanist);font-weight:400;font-size:15px;line-height:1.3;color:var(--color-fog-text);\"><strong style=\"font-weight:600;\">You</strong> can</p><p style=\"margin:0;font-family:var(--font-geomanist);font-weight:400;font-size:14px;line-height:1.4;color:var(--color-fog-text);\">Watch this video to hear our pitch</p></div></div></div><div style=\"flex:1;background:var(--color-deep-panel);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:16px;min-height:220px;\"><div style=\"display:flex;flex-direction:row;gap:10px;align-items:center;\"><div style=\"width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#077ac7,#6b21ef);display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M13 10V3L4 14h7v7l9-11h-7z\" fill=\"white\"/></svg></div><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:13px;color:var(--color-ash-text);\">AI Agent \u00b7 Tools Agent</span></div><div style=\"width:100%;height:1px;background:var(--color-border-smoke);\"></div><div style=\"display:flex;flex-direction:column;gap:8px;\"><div style=\"background:rgba(255,255,255,0.05);border-radius:8px;padding:10px 14px;\"><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:12px;color:var(--color-fog-text);\">On 'Create User' form submission</span></div><div style=\"display:flex;flex-direction:row;gap:8px;\"><div style=\"flex:1;background:rgba(255,255,255,0.05);border-radius:8px;padding:10px 14px;\"><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:12px;color:var(--color-fog-text);\">Chat Model</span></div><div style=\"flex:1;background:rgba(255,255,255,0.05);border-radius:8px;padding:10px 14px;\"><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:12px;color:var(--color-fog-text);\">Memory</span></div><div style=\"flex:1;background:rgba(255,255,255,0.05);border-radius:8px;padding:10px 14px;\"><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:12px;color:var(--color-fog-text);\">Is a manager?</span></div></div></div><div style=\"margin-top:auto;display:flex;flex-direction:row;gap:8px;align-items:center;\"><div style=\"width:28px;height:28px;border-radius:8px;background:#ff492c22;display:flex;align-items:center;justify-content:center;\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\"><path d=\"M13 10V3L4 14h7v7l9-11h-7z\" fill=\"#ff492c\"/></svg></div><span style=\"font-family:var(--font-geomanist);font-weight:400;font-size:12px;color:var(--color-fog-text);\">Update profile \u00b7 updateProfile: user</span></div></div></div></div>",
