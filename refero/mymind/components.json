[
  {
    "html": "<style>\n  :root {\n    --color-ember-orange: #ff5924;\n    --color-cobalt-link: #1573dd;\n    --color-midnight-ink: #000000;\n    --color-canvas-white: #f9fafc;\n    --color-pure-white: #ffffff;\n    --color-storm: #4a5465;\n    --font-louize: 'Playfair Display', 'Georgia', serif;\n    --font-nunito: 'Nunito', 'Helvetica Neue', sans-serif;\n  }\n\n  .hero-tagline {\n    background: var(--color-canvas-white);\n    padding: 48px 40px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0;\n    font-family: var(--font-nunito);\n    max-width: 600px;\n    box-sizing: border-box;\n  }\n\n  .hero-tagline__heading {\n    font-family: var(--font-louize);\n    font-weight: 400;\n    font-size: 60px;\n    line-height: 0.9;\n    letter-spacing: -0.04em;\n    color: var(--color-midnight-ink);\n    text-align: center;\n    margin: 0 0 28px 0;\n  }\n\n  .hero-tagline__body {\n    font-family: var(--font-nunito);\n    font-size: 18px;\n    line-height: 1.8;\n    color: var(--color-storm);\n    text-align: center;\n    margin: 0;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    align-items: center;\n    gap: 6px;\n    font-weight: 400;\n  }\n\n  .tag {\n    display: inline-flex;\n    align-items: center;\n    padding: 2px 14px;\n    border-radius: 36px;\n    border: 1px solid;\n    font-size: 17px;\n    line-height: 1.6;\n    font-family: var(--font-nunito);\n    font-weight: 400;\n    white-space: nowrap;\n  }\n\n  .tag--orange {\n    border-color: var(--color-ember-orange);\n    color: var(--color-ember-orange);\n  }\n\n  .tag--pink {\n    border-color: #e8729a;\n    color: #e8729a;\n  }\n\n  .tag--sky {\n    border-color: #5ab4d6;\n    color: #5ab4d6;\n  }\n\n  .tag--red {\n    border-color: #e05a5a;\n    color: #e05a5a;\n  }\n\n  .tag--yellow {\n    border-color: #c9a84c;\n    color: #c9a84c;\n  }\n\n  .plain-text {\n    color: var(--color-storm);\n    font-size: 18px;\n    font-family: var(--font-nunito);\n  }\n</style>\n\n<div class=\"hero-tagline\">\n  <h1 class=\"hero-tagline__heading\">Remember everything.<br>Organize nothing.</h1>\n  <p class=\"hero-tagline__body\">\n    <span class=\"plain-text\">All your</span>\n    <span class=\"tag tag--orange\">notes</span>\n    <span class=\"plain-text\">,</span>\n    <span class=\"tag tag--pink\">bookmarks</span>\n    <span class=\"plain-text\">,</span>\n    <span class=\"tag tag--sky\">inspiration</span>\n    <span class=\"plain-text\">,</span>\n    <span class=\"tag tag--red\">articles</span>\n    <span class=\"plain-text\">and</span>\n    <span class=\"tag tag--yellow\">images</span>\n    <span class=\"plain-text\">in one single, private place.</span>\n  </p>\n</div>",
    "name": "Content Category Tags (Hero Inline Pills)",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-slate: #748297;\n    --color-canvas-white: #f9fafc;\n    --color-ember-orange: #ff5924;\n    --font-nunito: 'Nunito', 'Helvetica Neue', sans-serif;\n  }\n\n  .platform-buttons {\n    background: var(--color-canvas-white);\n    padding: 48px 40px;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n    justify-content: center;\n    align-items: center;\n    max-width: 600px;\n    box-sizing: border-box;\n  }\n\n  .platform-btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 10px 20px;\n    border-radius: 100px;\n    border: 1px solid var(--color-slate);\n    background: transparent;\n    color: var(--color-slate);\n    font-family: var(--font-nunito);\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.4;\n    letter-spacing: 0.01em;\n    text-decoration: none;\n    cursor: pointer;\n    transition: border-color 0.2s, color 0.2s;\n    white-space: nowrap;\n  }\n\n  .platform-btn:hover {\n    border-color: #4a5465;\n    color: #4a5465;\n  }\n\n  .platform-btn__icon {\n    width: 20px;\n    height: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  /* Apple icon */\n  .icon-apple {\n    width: 18px;\n    height: 18px;\n    background: var(--color-slate);\n    border-radius: 3px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  /* Chrome icon \u2014 colored circles approximation */\n  .icon-chrome {\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    background: conic-gradient(#ea4335 0deg 120deg, #34a853 120deg 240deg, #4285f4 240deg 360deg);\n    position: relative;\n    overflow: hidden;\n  }\n  .icon-chrome::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 7px;\n    height: 7px;\n    background: white;\n    border-radius: 50%;\n  }\n\n  /* Play store icon */\n  .icon-play {\n    width: 18px;\n    height: 18px;\n    position: relative;\n  }\n\n  .platform-section-label {\n    width: 100%;\n    text-align: center;\n    font-family: var(--font-nunito);\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--color-slate);\n    margin-bottom: 8px;\n  }\n</style>\n\n<div class=\"platform-buttons\">\n  <div class=\"platform-section-label\">Available on all platforms</div>\n\n  <a class=\"platform-btn\" href=\"#\">\n    <span class=\"platform-btn__icon\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"#748297\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z\"/>\n      </svg>\n    </span>\n    iPhone app\n  </a>\n\n  <a class=\"platform-btn\" href=\"#\">\n    <span class=\"platform-btn__icon\">\n      <div class=\"icon-chrome\"></div>\n    </span>\n    Browser Extension\n  </a>\n\n  <a class=\"platform-btn\" href=\"#\">\n    <span class=\"platform-btn__icon\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M3.18 23.76c.3.17.64.24.99.2l13.1-7.57-2.83-2.83-11.26 10.2z\" fill=\"#EA4335\"/>\n        <path d=\"M20.93 9.86L17.4 7.81 14.28 10.6l3.13 3.13 3.52-2.06c1-.58 1-.2 1-1.04 0-.83 0-1.2-.9-1.77z\" fill=\"#FBBC04\"/>\n        <path d=\"M3.18.24c-.56.32-.88.9-.88 1.6v20.32c0 .7.33 1.27.88 1.6l.1.06 11.38-11.38v-.27L3.28.18l-.1.06z\" fill=\"#4285F4\"/>\n        <path d=\"M17.27 16.19L14.28 13.2 3.18 23.76c.38.24.9.27 1.44-.03l12.65-7.54z\" fill=\"#34A853\"/>\n      </svg>\n    </span>\n    Android app\n  </a>\n</div>",
    "name": "Platform Download Buttons (Ghost Slate Pills)",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-parchment-card: #f3f0e7;\n    --color-pure-white: #ffffff;\n    --color-deep-slate: #3a475a;\n    --color-chalk: #a6a8aa;\n    --color-storm: #4a5465;\n    --color-steel: #717286;\n    --color-mist: #e2e2e2;\n    --color-ember-orange: #ff5924;\n    --color-canvas-white: #f9fafc;\n    --shadow-sm: rgba(140, 142, 151, 0.32) 0px 4px 7px -4px;\n    --font-inter: 'Inter', 'Helvetica Neue', sans-serif;\n    --font-louize: 'Playfair Display', 'Georgia', serif;\n    --font-nunito: 'Nunito', 'Helvetica Neue', sans-serif;\n  }\n\n  .feature-section {\n    background: var(--color-canvas-white);\n    padding: 48px 32px;\n    max-width: 600px;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    gap: 24px;\n    align-items: flex-start;\n  }\n\n  .feature-section__eyebrow {\n    font-family: var(--font-nunito);\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--color-ember-orange);\n    margin: 0;\n  }\n\n  .feature-section__heading {\n    font-family: var(--font-louize);\n    font-weight: 400;\n    font-size: 42px;\n    line-height: 1.1;\n    letter-spacing: -0.03em;\n    color: var(--color-midnight-ink, #1a1a1a);\n    margin: 0;\n  }\n\n  .checklist-card {\n    background: var(--color-pure-white);\n    border-radius: 16px;\n    padding: 32px 36px;\n    width: 100%;\n    box-sizing: border-box;\n    box-shadow: var(--shadow-sm);\n  }\n\n  .checklist-card__title {\n    font-family: var(--font-inter);\n    font-size: 17px;\n    font-weight: 400;\n    line-height: 1.5;\n    color: var(--color-deep-slate);\n    margin: 0 0 20px 0;\n  }\n\n  .checklist-card__list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .checklist-item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    font-family: var(--font-inter);\n    font-size: 17px;\n    line-height: 1.4;\n    font-weight: 400;\n  }\n\n  .checklist-item--done {\n    color: var(--color-chalk);\n    text-decoration: line-through;\n    text-decoration-color: var(--color-chalk);\n  }\n\n  .checklist-item--active {\n    color: var(--color-deep-slate);\n  }\n\n  .checkbox {\n    width: 20px;\n    height: 20px;\n    border-radius: 50%;\n    border: 1.5px solid var(--color-mist);\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n  }\n\n  .checkbox--checked {\n    border-color: var(--color-chalk);\n    background: transparent;\n  }\n\n  .checkbox--checked::after {\n    content: '';\n    display: block;\n    width: 10px;\n    height: 10px;\n    border-radius: 50%;\n    background: var(--color-chalk);\n  }\n\n  .card-wrapper {\n    background: var(--color-parchment-card);\n    border-radius: 16px;\n    padding: 28px;\n    width: 100%;\n    box-sizing: border-box;\n  }\n</style>\n\n<div class=\"feature-section\">\n  <p class=\"feature-section__eyebrow\">Your Private Oasis</p>\n  <h2 class=\"feature-section__heading\">A treasure trove of ideas, inspiration &amp; references</h2>\n\n  <div class=\"card-wrapper\">\n    <div class=\"checklist-card\">\n      <p class=\"checklist-card__title\">Dinner with friends tonight, so remember to buy ingredients:</p>\n      <ul class=\"checklist-card__list\">\n        <li class=\"checklist-item checklist-item--done\">\n          <span class=\"checkbox checkbox--checked\"></span>\n          Rigatoni pasta\n        </li>\n        <li class=\"checklist-item checklist-item--active\">\n          <span class=\"checkbox\"></span>\n          Basil from Tom's garden\n        </li>\n        <li class=\"checklist-item checklist-item--done\">\n          <span class=\"checkbox checkbox--checked\"></span>\n          Tomatoes from Taylor's\n        </li>\n        <li class=\"checklist-item checklist-item--active\">\n          <span class=\"checkbox\"></span>\n          Olive oil\n        </li>\n        <li class=\"checklist-item checklist-item--active\">\n          <span class=\"checkbox\"></span>\n          Parmigiano reggiano\n        </li>\n        <li class=\"checklist-item checklist-item--done\">\n          <span class=\"checkbox checkbox--checked\"></span>\n          That nice porto wine\n        </li>\n      </ul>\n    </div>\n  </div>\n</div>",
    "name": "Inline Checklist Card (Pastel Parchment Feature Card)",
    "role": "",
    "description": ""
  },
  {
    "name": "Ember Outlined Pill Button",
    "role": "Primary brand action button \u2014 outlined, never filled",
    "description": "Background transparent, border 1px solid #ff5924, text #ff5924, border-radius 100px, padding 10px 24px. Nunito-SemiBold 15\u201316px, letter-spacing +0.053em uppercase. The absence of a filled CTA is deliberate \u2014 the brand never commands, only invites."
  },
  {
    "name": "Ghost Slate Pill Button",
    "role": "Secondary platform download buttons (iPhone app, Browser Extension, Android app)",
    "description": "Background transparent, border 1px solid #748297, text #748297, border-radius 100px, padding 10px 24px. Identical structure to Ember Outlined \u2014 differentiated only by Slate (#748297) replacing Ember Orange."
  },
  {
    "name": "White Outlined Pill Button",
    "role": "Dark-background section CTAs",
    "description": "Background transparent, border 1px solid #ffffff, text #ffffff, border-radius 120px, padding 10px 22px. Used exclusively over dark/black section backgrounds."
  },
  {
    "name": "Content Category Tag",
    "role": "Inline keyword tags within hero body text (notes, bookmarks, inspiration, articles, images)",
    "description": "Border-radius 36px, border 1px solid, each tag uses its own accent color matching the keyword category (Ember Orange for some, Cobalt #1573dd for links). Small pill form, inline with body text at 18px. Creates a 'tag cloud embedded in prose' pattern."
  },
  {
    "name": "Pastel Feature Card",
    "role": "Primary content feature card in 2-column feature grids",
    "description": "Background alternates: #e5eaf2 (blue), #f3f0e7 (parchment), or #dde9d3 (sage). Border-radius 16px. No shadow. Padding 50px all sides. No border. Color selection encodes content category \u2014 each card type has its own tinted surface."
  },
  {
    "name": "White Elevated Card",
    "role": "Hero product preview card / elevated demo surface",
    "description": "Background #ffffff, border-radius 12px, padding 100px top / 30px sides and bottom. Shadow: rgba(255,167,129,0.44) 0px 57px 60px -54px, rgba(255,128,36,0.27) 0px -27px 50px -40px. The warm orange-glow shadow is unique to this one card \u2014 it echoes the hero bloom."
  },
  {
    "name": "Navigation Bar",
    "role": "Persistent top navigation",
    "description": "Background #ffffff or transparent over hero. Logo at left. Nav links (What, Why, How, What's New) centered with small Ember Orange bullet dots preceding each item. 'Log in' as plain text link in #24272d. 'Sign up' as Ember Outlined Pill Button. Nunito/Inter at 16px. No border-bottom \u2014 separates via position only."
  },
  {
    "name": "Nav Bullet Link",
    "role": "Navigation items with decorative orange dot prefix",
    "description": "Each nav label preceded by a small filled circle in #ff5924. Text in #24272d at 16px Inter-Medium. No underline. The orange dots are the primary navigation affordance \u2014 brand identity woven into wayfinding."
  },
  {
    "name": "Section Eyebrow Label",
    "role": "Small uppercase category labels above section headings",
    "description": "Text #ff5924, Nunito-SemiBold or neue-haas-grotesk-display 15\u201316px, letter-spacing +0.063em to +0.125em uppercase. No background. Positioned directly above the Louize display heading. Example: 'YOUR PRIVATE OASIS'."
  },
  {
    "name": "Product Demo Screenshot Frame",
    "role": "Browser-frame wrapper showing app UI",
    "description": "Rounded rectangle at 12\u201316px radius, gray border (#e2e2e2) 1px solid, white interior. Contains a simulated browser/app UI inside. No shadow. Appears partially cropped at viewport edge \u2014 creates 'peek' effect suggesting more content below."
  },
  {
    "name": "Dark Manifesto Section",
    "role": "Full-bleed dark narrative section",
    "description": "Background linear-gradient from #000000 to #2f343c. White text (#ffffff) at Louize-Regular 52\u201380px, tightly tracked at -0.04em. White outlined pill buttons over dark. Creates stark contrast against the warm-white surrounding sections."
  },
  {
    "name": "Inline Checklist Card",
    "role": "Product feature demo \u2014 task list inside a pastel card",
    "description": "Parchment card (#f3f0e7) at 16px radius, 50px padding. List items at Inter-Regular 16\u201318px: checked items in #a6a8aa with strikethrough, active items in #3a475a. Minimal checkbox circles, no filled checkmarks except as gray circles."
  }
]
