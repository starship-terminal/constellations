[
  {
    "html": "<style>\n  :root {\n    --color-deep-cosmos: #201547;\n    --color-violet-mid: #5938b7;\n    --color-lavender-pulse: #a98df6;\n    --color-graphite: #1b1b1b;\n    --color-pure-white: #ffffff;\n    --color-warm-cream: #fffbf4;\n    --color-slate: #5f5f5f;\n    --color-bone: #dbdbdb;\n    --font-bagosscondensedfont: 'Inter', sans-serif;\n    --font-bagossstandardvf: 'Inter', sans-serif;\n    --font-inter: 'Inter', sans-serif;\n  }\n\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  .hero-panel {\n    background: var(--color-deep-cosmos);\n    border-radius: 24px;\n    padding: 48px;\n    width: 100%;\n    box-sizing: border-box;\n    font-family: var(--font-inter);\n  }\n\n  .hero-eyebrow {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: rgba(255,255,255,0.08);\n    border: 1px solid rgba(255,255,255,0.12);\n    border-radius: 200px;\n    padding: 6px 14px 6px 10px;\n    margin-bottom: 28px;\n  }\n\n  .hero-eyebrow-dot {\n    width: 20px;\n    height: 20px;\n    background: var(--color-violet-mid);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .hero-eyebrow-dot svg {\n    width: 10px;\n    height: 10px;\n  }\n\n  .hero-eyebrow-text {\n    font-family: var(--font-inter);\n    font-size: 13px;\n    font-weight: 500;\n    color: rgba(255,255,255,0.85);\n    letter-spacing: 0.01em;\n  }\n\n  .hero-eyebrow-arrow {\n    margin-left: 4px;\n    color: rgba(255,255,255,0.5);\n    font-size: 13px;\n  }\n\n  .hero-headline {\n    font-family: var(--font-bagosscondensedfont);\n    font-size: 56px;\n    font-weight: 700;\n    line-height: 1.05;\n    letter-spacing: -0.005em;\n    color: var(--color-pure-white);\n    margin: 0 0 12px 0;\n  }\n\n  .hero-headline-accent {\n    color: var(--color-lavender-pulse);\n  }\n\n  .hero-subtext {\n    font-family: var(--font-inter);\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.6;\n    color: rgba(255,255,255,0.65);\n    margin: 0 0 36px 0;\n    max-width: 360px;\n  }\n\n  .hero-cta-row {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    flex-wrap: wrap;\n  }\n\n  .btn-primary {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--color-violet-mid);\n    color: var(--color-pure-white);\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: 0.025em;\n    padding: 12px 22px;\n    border-radius: 200px;\n    border: none;\n    cursor: pointer;\n    text-decoration: none;\n    transition: background 0.18s;\n  }\n\n  .btn-primary:hover {\n    background: #6a44cc;\n  }\n\n  .btn-primary svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n  }\n\n  .btn-ghost-dark {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: transparent;\n    color: rgba(255,255,255,0.75);\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 500;\n    letter-spacing: 0.025em;\n    padding: 12px 4px;\n    border-radius: 0;\n    border: none;\n    cursor: pointer;\n    text-decoration: none;\n    transition: color 0.18s;\n  }\n\n  .btn-ghost-dark:hover {\n    color: var(--color-pure-white);\n  }\n</style>\n<div class=\"hero-panel\">\n  <div class=\"hero-eyebrow\">\n    <div class=\"hero-eyebrow-dot\">\n      <svg viewBox=\"0 0 10 10\" fill=\"none\">\n        <circle cx=\"5\" cy=\"5\" r=\"3\" fill=\"white\"/>\n      </svg>\n    </div>\n    <span class=\"hero-eyebrow-text\">Skip the sales call. Hire your first employee now.</span>\n    <span class=\"hero-eyebrow-arrow\">\u203a</span>\n  </div>\n  <h1 class=\"hero-headline\">Hire, manage, pay,<br>&amp; equip anyone,<br><span class=\"hero-headline-accent\">anywhere.</span></h1>\n  <p class=\"hero-subtext\">Payroll, HR, IT, and immigration for every worker type. All in one platform from one trusted partner.</p>\n  <div class=\"hero-cta-row\">\n    <a href=\"#\" class=\"btn-primary\">\n      Speak to sales\n      <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </a>\n    <a href=\"#\" class=\"btn-ghost-dark\">\n      Book a demo\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\">\n        <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"rgba(255,255,255,0.75)\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </a>\n  </div>\n</div>",
    "name": "Hero CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --color-warm-cream: #fffbf4;\n    --color-pure-white: #ffffff;\n    --color-graphite: #1b1b1b;\n    --color-slate: #5f5f5f;\n    --color-bone: #dbdbdb;\n    --color-near-black: #101828;\n    --color-ash: #a4a4a4;\n    --font-inter: 'Inter', sans-serif;\n  }\n\n  .section-wrap {\n    background: var(--color-warm-cream);\n    padding: 40px 24px;\n    box-sizing: border-box;\n    font-family: var(--font-inter);\n    width: 100%;\n  }\n\n  .section-eyebrow {\n    font-family: var(--font-inter);\n    font-size: 12px;\n    font-weight: 600;\n    letter-spacing: 0.06em;\n    color: var(--color-slate);\n    text-transform: uppercase;\n    margin: 0 0 12px 0;\n  }\n\n  .section-heading {\n    font-family: var(--font-inter);\n    font-size: 32px;\n    font-weight: 700;\n    color: var(--color-near-black);\n    margin: 0 0 28px 0;\n    line-height: 1.15;\n    letter-spacing: -0.01em;\n  }\n\n  .cards-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .product-card {\n    background: var(--color-warm-cream);\n    border: 1px solid var(--color-bone);\n    border-radius: 24px;\n    padding: 24px;\n    box-sizing: border-box;\n    overflow: hidden;\n  }\n\n  .card-label {\n    font-family: var(--font-inter);\n    font-size: 20px;\n    font-weight: 700;\n    color: var(--color-near-black);\n    margin: 0 0 6px 0;\n    letter-spacing: -0.005em;\n  }\n\n  .card-desc {\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 400;\n    color: var(--color-slate);\n    line-height: 1.5;\n    margin: 0 0 20px 0;\n  }\n\n  .card-ui-mock {\n    background: var(--color-pure-white);\n    border-radius: 12px;\n    padding: 16px;\n    border: 1px solid var(--color-bone);\n  }\n\n  .mock-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 6px 0;\n    border-bottom: 1px solid #f0ece6;\n  }\n\n  .mock-row:last-child {\n    border-bottom: none;\n  }\n\n  .mock-label {\n    font-size: 13px;\n    font-weight: 400;\n    color: var(--color-slate);\n    font-family: var(--font-inter);\n  }\n\n  .mock-value {\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--color-near-black);\n    font-family: var(--font-inter);\n  }\n\n  .mock-btn {\n    display: block;\n    width: 100%;\n    background: var(--color-near-black);\n    color: white;\n    font-family: var(--font-inter);\n    font-size: 14px;\n    font-weight: 600;\n    text-align: center;\n    padding: 10px 0;\n    border-radius: 200px;\n    margin-top: 14px;\n    border: none;\n    cursor: pointer;\n    box-sizing: border-box;\n  }\n\n  .mock-avatars {\n    display: flex;\n  }\n\n  .mock-avatar {\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    border: 2px solid white;\n    margin-left: -6px;\n    display: inline-block;\n  }\n\n  .mock-avatar:first-child { margin-left: 0; }\n\n  .mock-stat-row {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 10px;\n  }\n\n  .mock-stat-label {\n    font-size: 12px;\n    color: var(--color-slate);\n    font-family: var(--font-inter);\n  }\n\n  .mock-stat-value {\n    font-size: 20px;\n    font-weight: 700;\n    color: var(--color-near-black);\n    font-family: var(--font-inter);\n  }\n\n  .mock-progress {\n    height: 6px;\n    background: #e8e4de;\n    border-radius: 100px;\n    overflow: hidden;\n    margin-bottom: 14px;\n  }\n\n  .mock-progress-fill {\n    height: 100%;\n    background: #5938b7;\n    border-radius: 100px;\n    width: 72%;\n  }\n\n  .it-step {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    padding: 5px 0;\n  }\n\n  .it-step-dot {\n    width: 16px;\n    height: 16px;\n    border-radius: 50%;\n    border: 2px solid var(--color-bone);\n    background: white;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .it-step-dot.done {\n    background: var(--color-near-black);\n    border-color: var(--color-near-black);\n  }\n\n  .it-step-info {\n    flex: 1;\n  }\n\n  .it-step-title {\n    font-size: 13px;\n    font-weight: 600;\n    color: var(--color-near-black);\n    font-family: var(--font-inter);\n  }\n\n  .it-step-date {\n    font-size: 11px;\n    color: var(--color-ash);\n    font-family: var(--font-inter);\n  }\n</style>\n<div class=\"section-wrap\">\n  <p class=\"section-eyebrow\">What Deel Does</p>\n  <h2 class=\"section-heading\">The Global People Platform</h2>\n  <div class=\"cards-grid\">\n\n    <div class=\"product-card\">\n      <div class=\"card-label\">Deel Payroll</div>\n      <div class=\"card-desc\">Local and global payroll, your way.</div>\n      <div class=\"card-ui-mock\">\n        <div class=\"mock-row\">\n          <span class=\"mock-label\">Payroll funding</span>\n          <span class=\"mock-value\">$800,450.30</span>\n        </div>\n        <div class=\"mock-row\">\n          <span class=\"mock-label\">Payroll schedule</span>\n          <span class=\"mock-value\">Bi-weekly</span>\n        </div>\n        <div class=\"mock-row\">\n          <span class=\"mock-label\">Approvers</span>\n          <span class=\"mock-value\">\n            <div class=\"mock-avatars\">\n              <div class=\"mock-avatar\" style=\"background:#c4b1f9;\"></div>\n              <div class=\"mock-avatar\" style=\"background:#ffcf25;\"></div>\n              <div class=\"mock-avatar\" style=\"background:#53a945;\"></div>\n              <div class=\"mock-avatar\" style=\"background:#a98df6;\"></div>\n            </div>\n          </span>\n        </div>\n        <button class=\"mock-btn\">Submit</button>\n      </div>\n    </div>\n\n    <div class=\"product-card\">\n      <div class=\"card-label\">Deel HR</div>\n      <div class=\"card-desc\">One HR system for every worker.</div>\n      <div class=\"card-ui-mock\">\n        <div class=\"mock-stat-row\">\n          <span class=\"mock-stat-label\">Increase user retention rate</span>\n        </div>\n        <div class=\"mock-progress\"><div class=\"mock-progress-fill\"></div></div>\n        <div class=\"mock-stat-row\">\n          <div>\n            <div class=\"mock-stat-label\" style=\"margin-bottom:2px;\">Average feedback</div>\n            <div class=\"mock-stat-value\">72%</div>\n          </div>\n        </div>\n        <div style=\"display:flex;gap:8px;margin-top:8px;\">\n          <div style=\"flex:1;height:40px;background:#e8e4de;border-radius:8px;\"></div>\n          <div style=\"flex:1;height:52px;background:#c4b1f9;border-radius:8px;align-self:flex-end;\"></div>\n          <div style=\"flex:1;height:36px;background:#e8e4de;border-radius:8px;\"></div>\n          <div style=\"flex:1;height:44px;background:#ffcf25;border-radius:8px;\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"product-card\">\n      <div class=\"card-label\">Deel IT</div>\n      <div class=\"card-desc\">Devices and support, anywhere.</div>\n      <div class=\"card-ui-mock\">\n        <div class=\"it-step\">\n          <div class=\"it-step-dot done\">\n            <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\"><path d=\"M1.5 4l2 2 3-3\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <div class=\"it-step-info\">\n            <div class=\"it-step-title\">Ordered</div>\n            <div class=\"it-step-date\">Jun 16th</div>\n          </div>\n        </div>\n        <div class=\"it-step\">\n          <div class=\"it-step-dot done\">\n            <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\"><path d=\"M1.5 4l2 2 3-3\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <div class=\"it-step-info\">\n            <div class=\"it-step-title\">Shipped</div>\n            <div class=\"it-step-date\">Jun 17th</div>\n          </div>\n        </div>\n        <div class=\"it-step\">\n          <div class=\"it-step-dot done\">\n            <svg width=\"8\" height=\"8\" viewBox=\"0 0 8 8\" fill=\"none\"><path d=\"M1.5 4l2 2 3-3\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n          <div class=\"it-step-info\">\n            <div class=\"it-step-title\">Delivered</div>\n            <div class=\"it-step-date\">Jun 19th</div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </div>\n</div>",
    "name": "Feature Product Cards",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');\n\n  :root {\n    --color-obsidian: #141414;\n    --color-graphite: #1b1b1b;\n    --color-pure-white: #ffffff;\n    --color-linen: #d9d0ca;\n    --color-bone: #dbdbdb;\n    --color-slate: #5f5f5f;\n    --font-inter: 'Inter', sans-serif;\n  }\n\n  .dark-section {\n    background: var(--color-obsidian);\n    padding: 48px 32px;\n    box-sizing: border-box;\n    width: 100%;\n    border-radius: 24px;\n    font-family: var(--font-inter);\n  }\n\n  .dark-section-headline {\n    font-family: var(--font-inter);\n    font-size: 32px;\n    font-weight: 700;\n    color: var(--color-pure-white);\n    margin: 0 0 36px 0;\n    line-height: 1.1;\n    letter-spacing: -0.01em;\n  }\n\n  .stat-cols {\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n    border-top: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .stat-col {\n    padding: 28px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .stat-lead {\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 400;\n    color: var(--color-linen);\n    line-height: 1.6;\n    margin: 0 0 16px 0;\n  }\n\n  .stat-lead strong {\n    font-weight: 700;\n    color: var(--color-pure-white);\n  }\n\n  .stat-link {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    font-family: var(--font-inter);\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--color-pure-white);\n    text-decoration: none;\n    letter-spacing: 0.01em;\n    opacity: 0.75;\n    transition: opacity 0.15s;\n  }\n\n  .stat-link:hover {\n    opacity: 1;\n  }\n\n  .stat-link svg {\n    width: 14px;\n    height: 14px;\n  }\n\n  .currency-chips {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-top: 28px;\n  }\n\n  .currency-chip {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.1);\n    border-radius: 200px;\n    padding: 10px 16px;\n    width: fit-content;\n    min-width: 160px;\n  }\n\n  .currency-chip.active {\n    background: var(--color-pure-white);\n    border-color: var(--color-pure-white);\n  }\n\n  .currency-flag {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n  }\n\n  .currency-code {\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 500;\n    color: rgba(255,255,255,0.85);\n    letter-spacing: 0.01em;\n  }\n\n  .currency-chip.active .currency-code {\n    color: var(--color-graphite);\n  }\n\n  .currency-check {\n    margin-left: auto;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: #53a945;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n\n  .currency-check-inactive {\n    margin-left: auto;\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    border: 1.5px solid rgba(255,255,255,0.2);\n    flex-shrink: 0;\n  }\n\n  .currency-check-inactive.dark {\n    border-color: rgba(0,0,0,0.15);\n  }\n</style>\n<div class=\"dark-section\">\n  <h2 class=\"dark-section-headline\">One modern experience for today's workforce</h2>\n  <div class=\"stat-cols\">\n\n    <div class=\"stat-col\">\n      <p class=\"stat-lead\"><strong>150+ currencies supported,</strong> including crypto, for centralized compliant payroll.</p>\n      <a href=\"#\" class=\"stat-link\">\n        Learn more\n        <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n      <div class=\"currency-chips\">\n        <div class=\"currency-chip\" style=\"opacity:0.5;\">\n          <div class=\"currency-flag\">\ud83c\udde6\ud83c\uddf7</div>\n          <span class=\"currency-code\">ARS</span>\n          <div class=\"currency-check-inactive\"></div>\n        </div>\n        <div class=\"currency-chip\" style=\"opacity:0.75;\">\n          <div class=\"currency-flag\">\ud83c\udde8\ud83c\udde6</div>\n          <span class=\"currency-code\">CAD</span>\n          <div class=\"currency-check-inactive\"></div>\n        </div>\n        <div class=\"currency-chip active\">\n          <div class=\"currency-flag\" style=\"background:#1b1b1b;color:white;font-size:13px;font-weight:700;\">\u00a2</div>\n          <span class=\"currency-code\">Crypto</span>\n          <div class=\"currency-check\">\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2 6l3 3 5-5\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </div>\n        </div>\n        <div class=\"currency-chip\" style=\"opacity:0.75;\">\n          <div class=\"currency-flag\">\ud83c\uddfa\ud83c\uddf8</div>\n          <span class=\"currency-code\">USD</span>\n          <div class=\"currency-check-inactive\"></div>\n        </div>\n        <div class=\"currency-chip\" style=\"opacity:0.4;\">\n          <div class=\"currency-flag\">\ud83c\uddec\ud83c\udde7</div>\n          <span class=\"currency-code\">GBP</span>\n          <div class=\"currency-check-inactive\"></div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"stat-col\">\n      <p class=\"stat-lead\"><strong>Actionable AI</strong> for approving hiring, payroll, IT flows on Deel. More scaling, not headcount.</p>\n      <a href=\"#\" class=\"stat-link\">\n        Learn more\n        <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n\n    <div class=\"stat-col\">\n      <p class=\"stat-lead\"><strong>2,000+ local experts</strong> combined with in-house compliance logic and real-time AI.</p>\n      <a href=\"#\" class=\"stat-link\">\n        Book a demo\n        <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </a>\n    </div>\n\n  </div>\n</div>",
    "name": "Dark Stat Callout Row",
    "role": "",
    "description": ""
  },
  {
    "name": "Dark Hero CTA Button",
    "role": "Primary call-to-action within the dark hero panel",
    "description": "Pill-shaped button (200px radius), background #5938b7, white text, Inter or BagossStandardVF 15px weight 500, padding 8px 16px. Small right-facing arrow icon. On #201547 backgrounds only."
  },
  {
    "name": "Ghost Pill Navigation Button",
    "role": "Nav items with dropdown indicators",
    "description": "Transparent background, #1b1b1b text, 200px border-radius, padding 8px 12px, BagossStandardVF 15px weight 500, letter-spacing 0.025em. Includes chevron icon at 12px. No border in default state."
  },
  {
    "name": "Dark Filled Pill Button",
    "role": "'Book a demo' CTA in the top nav",
    "description": "Background #1b1b1b, white text, 200px border-radius, padding 8px 16px, BagossStandardVF 15px weight 500. The highest-contrast nav element \u2014 only solid-fill nav button."
  },
  {
    "name": "Ghost Underline Button",
    "role": "Text-level inline CTAs like 'Learn more \u2192'",
    "description": "Transparent background, #1b1b1b text, no border-radius (0px), padding 8px 0px, no horizontal padding. Arrow character appended. Signals navigation without visual weight."
  },
  {
    "name": "Pill Input with Search",
    "role": "Search and email capture fields",
    "description": "Background #ffffff, border rgba(27,27,27,0.16) 1px, border-radius 200px, padding 1px 54px 1px 24px. Right-side icon or button inset at 54px. Inter 14px weight 400 placeholder text in #767676."
  },
  {
    "name": "Feature Product Card",
    "role": "Product feature cards (Deel Payroll, Deel HR, Deel IT)",
    "description": "Background #fffbf4 (warm cream), border-radius 24px, no shadow, padding 24px. Contains a bold label in BagossCondensedFont 24px weight 500, descriptor in Inter 16px weight 400 #5f5f5f, and a product screenshot cropped at bottom. Border: 1px solid #dbdbdb."
  },
  {
    "name": "Dark Stats Panel",
    "role": "Stat callout panels on dark background sections",
    "description": "Background rgba(255,255,255,0.05) \u2014 frosted white tint at 5% on dark surfaces. Border-radius 24px. No shadow. Contains bold stat in BagossCondensedFont 44px weight 500, descriptor in Inter 15px #d9d0ca."
  },
  {
    "name": "Currency Selection Chip",
    "role": "Illustrative UI chips showing selectable options (ARS, CAD, USD, etc.)",
    "description": "Background #ffffff or rgba(255,255,255,0.9), border 1px solid #dbdbdb, border-radius 200px, padding 8px 16px. Flag emoji + currency code in Inter 16px weight 500 #1b1b1b. Active state adds green checkmark badge (#53a945)."
  },
