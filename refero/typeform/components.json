  {
    "html": "<div style=\"--color-aubergine-ink:#2a222b;--color-deep-plum:#3e3040;--color-violet-mist:#9454ab;--color-lavender-whisper:#ddb7f0;--color-cream-canvas:#faf9fb;--color-pure-white:#ffffff;--color-charcoal:#222222;--color-slate-mid:#564b58;--color-ash:#655d67;--color-fog:#837a85;--color-mist:#d4d1d5;--color-parchment:#f5f3f6;--font-tobias:'Playfair Display',Georgia,serif;--font-twk-lausanne:'Inter',system-ui,sans-serif;width:600px;box-sizing:border-box;font-family:var(--font-twk-lausanne);background:var(--color-pure-white);padding:56px 40px;\"><div style=\"text-align:center;margin-bottom:40px;\"><p style=\"margin:0 0 16px 0;font-family:var(--font-twk-lausanne);font-size:13px;font-weight:400;color:var(--color-violet-mist);text-transform:uppercase;letter-spacing:0.1em;font-feature-settings:'clig','liga','ss01','ss11';\">Integrations</p><h2 style=\"margin:0;font-family:var(--font-tobias);font-size:40px;font-weight:400;color:var(--color-aubergine-ink);line-height:1.08;letter-spacing:-1.2px;font-feature-settings:'clig','liga','ss01','ss11';\">Connect with hundreds of your business-critical tools</h2></div><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:10px;\"><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:700;color:var(--color-aubergine-ink);letter-spacing:-0.3px;\">CallRail</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:600;color:var(--color-aubergine-ink);\">\u2299 Calendly</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:600;color:var(--color-aubergine-ink);\">INTERCOM</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:700;color:var(--color-aubergine-ink);letter-spacing:-0.5px;\">klaviyo</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:600;color:var(--color-aubergine-ink);\">\u2726 slack</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:700;color:var(--color-aubergine-ink);\">Stripe</span></div></div><div style=\"display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:36px;\"><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:14px;font-weight:600;color:var(--color-aubergine-ink);\">ActiveCampaign \u203a</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:700;color:var(--color-aubergine-ink);\">\u2014Zapier</span></div><div style=\"background:var(--color-pure-white);border:1px solid var(--color-mist);border-radius:24px;padding:14px 20px;display:flex;align-items:center;justify-content:center;min-height:52px;\"><span style=\"font-family:var(--font-twk-lausanne);font-size:15px;font-weight:700;color:var(--color-aubergine-ink);\">Webflow</span></div></div><div style=\"text-align:center;\"><a href=\"#\" style=\"display:inline-block;background:var(--color-aubergine-ink);color:var(--color-cream-canvas);font-family:var(--font-twk-lausanne);font-size:16px;font-weight:400;padding:12px 28px;border-radius:12px;text-decoration:none;font-feature-settings:'clig','liga','ss01','ss11';\">See all integrations</a></div></div>",
