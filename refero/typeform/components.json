  {
    "name": "Primary CTA Button",
    "role": "Main call to action throughout the page",
    "description": "Background #2a222b, text #faf9fb, border-radius 12px, padding 8px 24px. TWK Lausanne 400 at 16px. The near-black fill with cream text is restrained \u2014 no color accent on CTAs, letting the form contrast with surrounding light sections do the work."
  },
  {
    "name": "Ghost Navigation Button",
    "role": "Secondary actions, nav-level text links with chevrons",
    "description": "Transparent background, text #222222, no border-radius (0px), minimal padding 0px 8px. Used for Platform/Solutions/Resources dropdown triggers. Invisible until needed \u2014 the nav reads as pure text."
  },
  {
    "name": "Section Eyebrow Label",
    "role": "Category identifier above section headings",
    "description": "TWK Lausanne 400 at 14px, uppercase, letter-spacing wide, color #9454ab (Violet Mist). No background, no pill, no border \u2014 pure typographic color accent. This is the only place saturated purple appears in content."
  },
  {
    "name": "Integration Logo Pill",
    "role": "Partner/integration logos in the integrations section",
    "description": "White (#ffffff) background, border #d4d1d5, border-radius 24px, padding 12px 24px. Logos rendered at grayscale/monochrome. The rounded-rectangle container unifies disparate brand marks into a cohesive grid."
  },
  {
    "name": "Dark Hero Section",
    "role": "Full-width page hero with dark background",
    "description": "Background #2a222b, full viewport width, centered content. Heading in Tobias 400 at 64-80px, color #faf9fb with negative tracking. Subheading in TWK Lausanne 400 at 20px, color #faf9fb. CTA button inherits primary button style but the border becomes #faf9fb on the dark surface."
  },
  {
    "name": "Light Content Section",
    "role": "Alternating content blocks in cream/white backgrounds",
    "description": "Background #faf9fb or #f5f3f6, padding 64px vertical. Headings in Tobias 400 at 64px, #2a222b. Two-column layout: text left, product visual right. Contains section eyebrow, heading, body copy at 16px, and CTA button."
  },
  {
    "name": "Product Preview Card",
    "role": "Embedded UI/screenshot previews in content sections",
    "description": "Border-radius 24px, background #f5f3f6 or light lavender tint (#f9f2fd from CSS tokens), no hard border visible. Acts as a contained viewport for product UI. Padding internal 24px. Shadow minimal or absent."
  },
  {
    "name": "Primary Navigation Bar",
    "role": "Top navigation with logo, links, and auth CTAs",
    "description": "Background #faf9fb, height ~72px. Logo left. Center nav links in TWK Lausanne 400 16px #2a222b. Right side: 'Log in' ghost text, 'Sign up' filled button (#2a222b, #faf9fb text, 12px radius, 8px 24px padding). Sticky on scroll."
  },
  {
    "name": "Trust Stat Block",
    "role": "Social proof number display",
    "description": "Background cream or white, centered. Stat value in Tobias 400 at 64px #2a222b with -1.98px tracking. Supporting text in TWK Lausanne 400 16px #655d67 (Ash). No card container \u2014 floats on section background."
  }
]
