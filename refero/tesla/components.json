  {
    "html": "<style>:root{--color-tesla-blue:#3e6ae1;--color-pure-white:#ffffff;--color-off-white:#eeeeee;--color-charcoal:#393c41;--color-onyx:#171a20;--color-steel:#5c5e62;--color-light-border:#cccccc;--shadow-sm:rgba(0,0,0,0.25) 0px 4px 4px 0px;--font-text:Inter,'SF Pro Text',sans-serif;}</style><div style=\"width:600px;box-sizing:border-box;font-family:var(--font-text);background:var(--color-pure-white);border-top:1px solid var(--color-light-border);padding:12px 16px;display:flex;gap:12px;align-items:center;\"><div style=\"flex:1;background:var(--color-off-white);border:1px solid var(--color-light-border);border-radius:4px;padding:10px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer;\"><div style=\"display:flex;align-items:center;gap:10px;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2 2h14a1 1 0 011 1v9a1 1 0 01-1 1H5l-4 3V3a1 1 0 011-1z\" stroke=\"#393c41\" stroke-width=\"1.4\" fill=\"none\" stroke-linejoin=\"round\"/></svg><span style=\"font-family:var(--font-text);font-size:14px;color:var(--color-charcoal);font-weight:400;\">Ask a Question</span></div><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 13L8 3l5 10\" stroke=\"#393c41\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M5.5 9h5\" stroke=\"#393c41\" stroke-width=\"1.4\" stroke-linecap=\"round\"/></svg></div><div style=\"flex:1;background:var(--color-off-white);border:1px solid var(--color-light-border);border-radius:4px;padding:10px 16px;display:flex;align-items:center;gap:10px;cursor:pointer;justify-content:center;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"9\" cy=\"9\" r=\"7\" stroke=\"#393c41\" stroke-width=\"1.4\"/><path d=\"M6 9a3 3 0 106 0 3 3 0 00-6 0z\" stroke=\"#393c41\" stroke-width=\"1.4\"/><path d=\"M9 2v2M9 14v2M2 9h2M14 9h2\" stroke=\"#393c41\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg><span style=\"font-family:var(--font-text);font-size:14px;color:var(--color-charcoal);font-weight:400;\">Schedule a Drive Today</span></div></div>",
