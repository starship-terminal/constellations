    "html": "<style>:root{--color-tesla-blue:#3e6ae1;--color-pure-white:#ffffff;--color-off-white:#eeeeee;--color-light-border:#cccccc;--color-charcoal:#393c41;--color-onyx:#171a20;--color-steel:#5c5e62;--shadow-sm:rgba(0,0,0,0.25) 0px 4px 4px 0px;--font-display:Inter,Manrope,sans-serif;--font-text:Inter,'SF Pro Text',sans-serif;}</style><div style=\"width:600px;min-height:220px;display:flex;align-items:center;justify-content:center;background:var(--color-off-white);padding:40px 24px;box-sizing:border-box;font-family:var(--font-text);\"><div style=\"background:var(--color-pure-white);border-radius:8px;box-shadow:var(--shadow-sm);padding:32px 28px 28px 28px;width:420px;position:relative;box-sizing:border-box;\"><button style=\"position:absolute;top:16px;right:16px;background:none;border:none;cursor:pointer;padding:4px;line-height:1;display:flex;align-items:center;justify-content:center;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2 2L14 14M14 2L2 14\" stroke=\"#393c41\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg></button><p style=\"font-family:var(--font-text);font-size:14px;line-height:1.43;color:var(--color-charcoal);margin:0 0 24px 0;padding-right:24px;\">Select the region to see content specific to your location</p><div style=\"display:flex;gap:12px;\"><button style=\"flex:1;background:var(--color-tesla-blue);color:var(--color-pure-white);border:none;border-radius:4px;padding:10px 24px;font-family:var(--font-text);font-size:14px;font-weight:500;cursor:pointer;line-height:1;\">United States</button><button style=\"flex:1;background:var(--color-off-white);color:var(--color-charcoal);border:1px solid var(--color-light-border);border-radius:4px;padding:10px 24px;font-family:var(--font-text);font-size:14px;font-weight:500;cursor:pointer;line-height:1;\">Spain</button></div></div></div>",
    "name": "Region Selector Modal",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>:root{--color-tesla-blue:#3e6ae1;--color-pure-white:#ffffff;--color-off-white:#eeeeee;--color-charcoal:#393c41;--color-onyx:#171a20;--color-steel:#5c5e62;--color-light-border:#cccccc;--shadow-sm:rgba(0,0,0,0.25) 0px 4px 4px 0px;--font-display:Inter,Manrope,sans-serif;--font-text:Inter,'SF Pro Text',sans-serif;}</style><div style=\"width:600px;background:var(--color-pure-white);padding:24px;box-sizing:border-box;font-family:var(--font-text);display:flex;gap:16px;\"><div style=\"flex:1;background:var(--color-off-white);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;\"><div style=\"padding:24px 24px 16px 24px;\"><h2 style=\"font-family:var(--font-display);font-size:20px;font-weight:500;color:var(--color-onyx);margin:0 0 8px 0;line-height:1.4;\">Current Offers</h2><p style=\"font-family:var(--font-text);font-size:14px;line-height:1.43;color:var(--color-charcoal);margin:0 0 20px 0;\">Explore limited-time offers on Tesla vehicles.</p><button style=\"width:100%;background:var(--color-pure-white);color:var(--color-onyx);border:1px solid var(--color-light-border);border-radius:4px;padding:10px 16px;font-family:var(--font-text);font-size:14px;font-weight:500;cursor:pointer;line-height:1;\">Learn More</button></div><div style=\"height:140px;background:linear-gradient(135deg,#c8d4e8 0%,#a8bcd4 50%,#dce8f0 100%);margin-top:auto;display:flex;align-items:center;justify-content:center;\"><div style=\"width:110px;height:44px;background:rgba(255,255,255,0.55);border-radius:6px;\"></div></div></div><div style=\"flex:1;background:var(--color-off-white);border-radius:8px;overflow:hidden;display:flex;flex-direction:column;\"><div style=\"padding:24px 24px 16px 24px;\"><h2 style=\"font-family:var(--font-display);font-size:20px;font-weight:500;color:var(--color-onyx);margin:0 0 8px 0;line-height:1.4;\">American Heroes</h2><p style=\"font-family:var(--font-text);font-size:14px;line-height:1.43;color:var(--color-charcoal);margin:0 0 20px 0;\">$500 off for military, first responders, healthcare, teachers and students.</p><button style=\"width:100%;background:var(--color-pure-white);color:var(--color-onyx);border:1px solid var(--color-light-border);border-radius:4px;padding:10px 16px;font-family:var(--font-text);font-size:14px;font-weight:500;cursor:pointer;line-height:1;\">Learn More</button></div><div style=\"height:140px;background:linear-gradient(135deg,#1a1f2e 0%,#2a3040 40%,#3a4560 100%);margin-top:auto;display:flex;align-items:center;justify-content:center;gap:8px;\"><div style=\"width:34px;height:22px;background:#e02020;border-radius:3px;\"></div><div style=\"width:34px;height:22px;background:#f0f0f0;border-radius:3px;\"></div><div style=\"width:34px;height:22px;background:#2040c0;border-radius:3px;\"></div></div></div></div>",
    "name": "Offer Cards \u2014 Current Offers & American Heroes",
