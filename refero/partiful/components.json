    "html": "<style>:root{--color-midnight-ink:#000000;--color-pure-canvas:#ffffff;--color-graphite:#333333;--color-slate:#666666;--color-warm-sand:#d9c58b;--color-party-pink:linear-gradient(rgb(248,196,255) 0%,rgb(240,182,224) 100%);--font-twk-lausanne-pan:'Inter',sans-serif;--font-partiful-display-medium:'Cabinet Grotesk','Satoshi',sans-serif;--spacing-8:8px;--spacing-12:12px;--spacing-16:16px;}</style><div style=\"width:100%;background:linear-gradient(rgb(248,196,255) 0%,rgb(240,182,224) 100%);padding:10px 0;display:flex;align-items:center;justify-content:center;box-sizing:border-box;\"><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:550;letter-spacing:-0.02em;color:var(--color-midnight-ink);display:flex;align-items:center;gap:8px;\"><span style=\"font-size:16px;\">\ud83c\udf88</span> Get $400 to throw your birthday party <span style=\"font-size:16px;\">\ud83c\udf88</span></span></div>",
    "name": "Announcement Banner",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>:root{--color-midnight-ink:#000000;--color-pure-canvas:#ffffff;--color-graphite:#333333;--color-slate:#666666;--color-ash:#999999;--shadow-sm:rgba(0,0,0,0.1) 0px 0px 6px 0px;--font-twk-lausanne-pan:'Inter',sans-serif;--font-partiful-display-medium:'Cabinet Grotesk','Satoshi',sans-serif;--spacing-8:8px;--spacing-12:12px;--spacing-16:16px;--spacing-24:24px;--spacing-40:40px;}</style><div style=\"width:100%;max-width:600px;margin:0 auto;padding:48px 24px;background:#ffffff;box-sizing:border-box;font-family:var(--font-twk-lausanne-pan);\"><div style=\"text-align:center;margin-bottom:32px;\"><h2 style=\"font-family:var(--font-partiful-display-medium);font-size:40px;font-weight:500;letter-spacing:-0.02em;line-height:1.1;color:var(--color-midnight-ink);margin:0 0 12px 0;padding:0;\">Fun, modern invites in 1-click</h2><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:18px;font-weight:400;letter-spacing:-0.02em;color:var(--color-slate);margin:0;padding:0;\">100% free, no paywalls. Customize the perfect invite.</p></div><div style=\"display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(0,0,0,0.05);border-radius:960px;padding:6px;width:fit-content;margin:0 auto;\"><button style=\"display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:960px;border:none;background:#ffffff;box-shadow:rgba(0,0,0,0.1) 0px 0px 6px 0px;cursor:pointer;font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:550;letter-spacing:-0.02em;color:var(--color-midnight-ink);white-space:nowrap;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"8\" cy=\"8\" r=\"6\" stroke=\"#000\" stroke-width=\"1.5\"/><path d=\"M5 8c0-1.5 1-3 3-3s3 1.5 3 3-1 3-3 3-3-1.5-3-3z\" fill=\"#000\" opacity=\"0.2\"/></svg>Backgrounds</button><button style=\"display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:960px;border:none;background:transparent;cursor:pointer;font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:550;letter-spacing:-0.02em;color:var(--color-graphite);white-space:nowrap;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><text x=\"2\" y=\"12\" font-family=\"serif\" font-size=\"11\" font-weight=\"bold\" fill=\"#333\">Aa</text></svg>Fonts</button><button style=\"display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:960px;border:none;background:transparent;cursor:pointer;font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:550;letter-spacing:-0.02em;color:var(--color-graphite);white-space:nowrap;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 13L8 3l5 10H3z\" stroke=\"#333\" stroke-width=\"1.5\" fill=\"none\" stroke-linejoin=\"round\"/></svg>Animations</button><button style=\"display:flex;align-items:center;gap:6px;padding:8px 16px;border-radius:960px;border:none;background:transparent;cursor:pointer;font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:550;letter-spacing:-0.02em;color:var(--color-graphite);white-space:nowrap;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"2\" y=\"2\" width=\"12\" height=\"12\" rx=\"2\" stroke=\"#333\" stroke-width=\"1.5\"/><path d=\"M5 6h6M5 9h4\" stroke=\"#333\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>Posters</button></div></div>",
    "name": "Feature Tab Selector",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>:root{--color-midnight-ink:#000000;--color-pure-canvas:#ffffff;--color-graphite:#333333;--color-slate:#666666;--shadow-sm:rgba(0,0,0,0.1) 0px 0px 6px 0px;--shadow-lg:rgba(0,0,0,0.1) 0px 0px 20px 0px;--font-twk-lausanne-pan:'Inter',sans-serif;--font-partiful-display-medium:'Cabinet Grotesk','Satoshi',sans-serif;}</style><div style=\"width:100%;max-width:600px;margin:0 auto;padding:48px 24px;background:linear-gradient(rgba(150,196,255,0.12) 0%,#ffffff 100%);box-sizing:border-box;font-family:var(--font-twk-lausanne-pan);\"><div style=\"background:#ffffff;border-radius:12px;box-shadow:rgba(0,0,0,0.05) 0px 0.8px 2.4px -0.6px,rgba(0,0,0,0.05) 0px 2.4px 7.2px -1.25px,rgba(0,0,0,0.05) 0px 6.4px 19.1px -1.875px,rgba(0,0,0,0.05) 0px 20px 60px -2.5px;padding:28px 24px 32px;box-sizing:border-box;\"><div style=\"margin-bottom:24px;\"><h2 style=\"font-family:var(--font-partiful-display-medium);font-size:40px;font-weight:500;letter-spacing:-0.02em;line-height:1.1;color:var(--color-midnight-ink);margin:0 0 4px 0;padding:0;\">26th Birthday Bash</h2><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:18px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);margin:0 0 2px 0;\">Friday, April 5</p><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:16px;font-weight:400;letter-spacing:-0.02em;color:var(--color-slate);margin:0 0 20px 0;\">6:00pm</p><div style=\"display:flex;align-items:center;gap:6px;margin-bottom:10px;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path d=\"M13 2H3L2 6l6 8 6-8-1-4z\" fill=\"#000\" opacity=\"0.15\" stroke=\"#000\" stroke-width=\"1.2\"/></svg><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);\">Hosted by <span style=\"font-weight:600;\">Jess</span></span></div><div style=\"display:flex;align-items:center;gap:6px;margin-bottom:16px;\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\"><path fill-rule=\"evenodd\" clip-rule=\"evenodd\" d=\"M8 2C5.8 2 4 3.8 4 6c0 3 4 8 4 8s4-5 4-8c0-2.2-1.8-4-4-4zm0 5.5a1.5 1.5 0 110-3 1.5 1.5 0 010 3z\" fill=\"#000\" opacity=\"0.4\"/></svg><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);\"><strong>RSVP</strong> to see location</span></div><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:400;letter-spacing:-0.02em;color:var(--color-slate);margin:0 0 20px 0;\">Celebrate the end of being on my parents health insurance!</p><div style=\"margin-bottom:4px;\"><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:14px;font-weight:700;letter-spacing:-0.04em;color:var(--color-midnight-ink);margin:0 0 6px 0;\">Guest List</p><p style=\"font-family:var(--font-twk-lausanne-pan);font-size:13px;font-weight:400;letter-spacing:-0.02em;color:var(--color-slate);margin:0 0 10px 0;\">16 Going \u00b7 2 Maybe</p><div style=\"display:flex;align-items:center;gap:-4px;\"><div style=\"display:flex;\"><div style=\"width:32px;height:32px;border-radius:50%;background:#c4a882;border:2px solid #fff;margin-right:-8px;overflow:hidden;\"><div style=\"width:100%;height:100%;background:linear-gradient(135deg,#c4a882,#a08060);\"></div></div><div style=\"width:32px;height:32px;border-radius:50%;background:#8b9dc4;border:2px solid #fff;margin-right:-8px;overflow:hidden;\"><div style=\"width:100%;height:100%;background:linear-gradient(135deg,#8b9dc4,#6b7db0);\"></div></div><div style=\"width:32px;height:32px;border-radius:50%;background:#d4b4a0;border:2px solid #fff;margin-right:-8px;overflow:hidden;\"><div style=\"width:100%;height:100%;background:linear-gradient(135deg,#d4b4a0,#c09080);\"></div></div><div style=\"width:32px;height:32px;border-radius:50%;background:#a4c4a0;border:2px solid #fff;margin-right:-8px;overflow:hidden;\"><div style=\"width:100%;height:100%;background:linear-gradient(135deg,#a4c4a0,#80a87c);\"></div></div><div style=\"width:32px;height:32px;border-radius:50%;background:#b8a4d4;border:2px solid #fff;margin-right:-8px;overflow:hidden;\"><div style=\"width:100%;height:100%;background:linear-gradient(135deg,#b8a4d4,#9880c0);\"></div></div><div style=\"width:32px;height:32px;border-radius:50%;background:rgba(0,0,0,0.08);border:2px solid #fff;display:flex;align-items:center;justify-content:center;\"><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:11px;font-weight:600;color:var(--color-graphite);\">+9</span></div></div></div></div></div><div style=\"display:flex;align-items:center;justify-content:center;gap:24px;margin-top:8px;\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;\"><button style=\"width:64px;height:64px;border-radius:960px;border:none;background:#ffffff;box-shadow:rgba(0,0,0,0.1) 0px 0px 6px 0px;cursor:pointer;font-size:28px;display:flex;align-items:center;justify-content:center;\">\ud83d\udc4d</button><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:12px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);\">Going</span></div><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;\"><button style=\"width:64px;height:64px;border-radius:960px;border:none;background:#ffffff;box-shadow:rgba(0,0,0,0.1) 0px 0px 6px 0px;cursor:pointer;font-size:28px;display:flex;align-items:center;justify-content:center;\">\ud83e\udd14</button><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:12px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);\">Maybe</span></div><div style=\"display:flex;flex-direction:column;align-items:center;gap:8px;\"><button style=\"width:64px;height:64px;border-radius:960px;border:none;background:#ffffff;box-shadow:rgba(0,0,0,0.1) 0px 0px 6px 0px;cursor:pointer;font-size:28px;display:flex;align-items:center;justify-content:center;\">\ud83d\ude41</button><span style=\"font-family:var(--font-twk-lausanne-pan);font-size:12px;font-weight:400;letter-spacing:-0.02em;color:var(--color-graphite);\">Can't go</span></div></div></div></div>",
    "name": "RSVP Response Buttons",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary Filled Button",
    "role": "Main page CTAs \u2014 Create invite, Create event",
    "description": "Background #000000, text #ffffff, border-radius 8px, padding 10px 24px. Font: TWK Lausanne Pan 700 at 14px, -0.04em letter-spacing. On dark/photo hero sections appears as white-filled with black text. No shadow in default state."
  },
  {
    "name": "Ghost Nav Button",
    "role": "Login / secondary header action",
    "description": "Background transparent, border 1px solid #000000, text #000000, border-radius 4px, padding 10px 24px. Sits in the navigation bar beside the filled Create button. Font: TWK Lausanne Pan 550 at 16px."
  },
  {
    "name": "Pill Badge / Rating Tag",
    "role": "Star rating display, count labels, RSVP status",
    "description": "Background rgba(0,0,0,0.05) or rgba(0,0,0,0.2), border-radius 960px (full pill), padding 6px 12px. Text #000000 at 12px TWK Lausanne Pan 700. Semantic variants: Leaf #31c431 background for Going, Amber #ffae00 for Maybe, Ember red for Can't go."
  },
  {
    "name": "Active Nav Link",
    "role": "Currently selected category in horizontal navigation",
    "description": "Text color #d9c58b (Warm Sand), border-bottom or border-color #d9c58b, border-radius 4px. Contrasts against the dark hero background to signal selection. All other nav links render in #ffffff on dark sections."
  },
  {
    "name": "Standard Content Card",
    "role": "Feature cards, testimonial cards, invite preview tiles",
    "description": "Background #ffffff, border-radius 12px, box-shadow rgba(0,0,0,0.1) 0px 0px 6px 0px, padding 12px 16px 16px 16px. Headline in TWK Lausanne Pan 700 at 18px, body text #666666 at 14px TWK Lausanne Pan 400."
  },
  {
    "name": "Event Preview Card",
    "role": "Live event page mockup shown in feature demos",
    "description": "Background #ffffff, border-radius 12px, multi-layer shadow (rgba(0,0,0,0.05) stack from 0.8px to 60px spread). Contains event title in Partiful Display Medium 40px, date/time in TWK Lausanne Pan 400 at 18px #333333, and a guest avatar row with a +N overflow indicator."
  },
  {
    "name": "Invitation Template Tile",
    "role": "Gallery of invitation design options in carousels",
    "description": "Aspect ratio roughly 3:4 portrait. Border-radius 12px. Each tile is a full-bleed image \u2014 photography, illustration, or typographic design \u2014 with no overlaid text labels. Displayed in horizontal scrolling rows or scattered at \u00b115\u00b0 rotation in feature sections."
  },
  {
    "name": "Feature Tab Selector",
    "role": "Tabbed navigation for Backgrounds / Fonts / Animations / Posters",
    "description": "Background rgba(0,0,0,0.05) pill container with active tab having #ffffff background and box-shadow rgba(0,0,0,0.1) 0px 0px 6px 0px. Border-radius 960px for container and individual tab items. Font: TWK Lausanne Pan 550 at 14px. Padding 8px 16px per tab."
  },
  {
    "name": "RSVP Response Button",
    "role": "Going / Maybe / Can't go response options on event pages",
    "description": "Circular shape (border-radius 960px), size ~56px, background #ffffff with box-shadow rgba(0,0,0,0.1) 0px 0px 6px 0px. Contains a single emoji. Label text in TWK Lausanne Pan 400 at 12px #333333 centered below the circle."
  },
  {
    "name": "Hero Section",
    "role": "Full-bleed page header with photography and gradient overlay",
    "description": "Full viewport width, ~420px tall. Background: full-bleed editorial photography with a linear-gradient overlay (Party Pink #f8c4ff to mauve at 0.4 opacity) layered over the image from left-to-right. White headline text at Partiful Display Medium 48px, subtext TWK Lausanne Pan 400 18px #ffffff, white ghost Create invite button. Backdrop blur 2px on text containers for legibility."
  },
  {
    "name": "Announcement Banner",
    "role": "Top-of-page promotional strip",
    "description": "Full width, ~32px tall, background: soft pink-to-mauve gradient (Party Pink gradient). Text #000000 TWK Lausanne Pan 550 at 14px, centered. Flanked by emoji decorators. No close button visible in default state."
  },
  {
    "name": "App Notification Preview",
    "role": "Mobile push notification widget shown floating over hero",
    "description": "Background #ffffff, border-radius 16px, box-shadow rgba(0,0,0,0.1) 0px 0px 20px 0px. Width ~240px. Contains app icon (32px, radius 8px), headline in .SFNSDisplay-Semibold 12px, subtext .SFNSText 11px #666666. Action button in #000000 background #ffffff text, border-radius 40px, padding 6px 16px."
  }
]
