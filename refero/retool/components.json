  {
    "html": "<div style=\"--color-obsidian-canvas: #151515; --color-void-black: #0e0e0e; --color-ember-surface: #242424; --color-charcoal-rim: #3f403d; --color-copper-wire: #8b867f; --color-ash-text: #94958e; --color-fog-text: #cbccc4; --color-limestone: #b6b8af; --color-parchment: #e9ebdf; --color-forest-deep: #185849; --color-midnight-moss: #0e352c; --font-saansfont: 'Inter', 'DM Sans', sans-serif; --font-pxgroteskfont: 'Space Grotesk', 'Geist', sans-serif; width: 600px; background: var(--color-obsidian-canvas); font-family: var(--font-saansfont); padding: 48px 32px 48px 32px; box-sizing: border-box;\"><style>*{box-sizing:border-box;}</style><!-- Eyebrow Label --><div style=\"display: inline-flex; align-items: center; padding: 4px 10px; border: 1px solid var(--color-charcoal-rim); border-radius: 4px; margin-bottom: 24px;\"><span style=\"color: var(--color-limestone); font-family: var(--font-pxgroteskfont); font-size: 12px; font-weight: 400; letter-spacing: 0.013em;\">AppGen for the enterprise</span></div><!-- Headline --><h2 style=\"color: var(--color-fog-text); font-family: var(--font-saansfont); font-size: 48px; font-weight: 300; line-height: 1.05; letter-spacing: -0.48px; margin: 0 0 24px 0;\">AI made building easy.<br><span style=\"color: var(--color-fog-text);\">Retool makes it safe.</span></h2><!-- Body Copy --><p style=\"color: var(--color-ash-text); font-family: var(--font-saansfont); font-size: 18px; font-weight: 380; line-height: 1.5; letter-spacing: -0.01em; margin: 0 0 36px 0; max-width: 480px;\">Build, launch, and scale internal tools on a governed platform that's enterprise-ready from the start.</p><!-- Image Placeholder --><div style=\"width: 100%; height: 200px; background: var(--color-ember-surface); border-radius: 12px; position: relative; overflow: hidden; margin-bottom: 32px;\"><div style=\"position: absolute; inset: 0; background: linear-gradient(135deg, #1a3a30 0%, #2a4a3a 30%, #3d2a20 60%, #2a1a10 100%); opacity: 0.8;\"></div><div style=\"position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;\"><div style=\"width: 80px; height: 80px; background: var(--color-forest-deep); border-radius: 12px; opacity: 0.6; transform: rotate(15deg); margin-right: -20px;\"></div><div style=\"width: 60px; height: 60px; background: #8b5e52; border-radius: 8px; opacity: 0.7; transform: rotate(-8deg);\"></div><div style=\"width: 40px; height: 40px; background: var(--color-limestone); border-radius: 6px; opacity: 0.3; transform: rotate(20deg); margin-left: -10px;\"></div></div></div><!-- CTA Row --><div style=\"display: flex; align-items: center; gap: 16px;\"><a href=\"#\" style=\"display: inline-flex; align-items: center; justify-content: center; background: var(--color-parchment); color: #151515; font-family: var(--font-saansfont); font-size: 15px; font-weight: 380; letter-spacing: -0.01em; padding: 10px 24px; border-radius: 9999px; border: none; text-decoration: none;\">Start building free</a><a href=\"#\" style=\"display: inline-flex; align-items: center; gap: 6px; color: var(--color-parchment); font-family: var(--font-pxgroteskfont); font-size: 13px; font-weight: 400; letter-spacing: 0.010em; text-decoration: none; opacity: 0.75;\">See how it works <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 7h8M7.5 4l3.5 3-3.5 3\" stroke=\"#e9ebdf\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></div>",
