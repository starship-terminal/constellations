  {
    "name": "Pill Button \u2014 Filled",
    "role": "Primary call-to-action (e.g. 'Book a demo', 'Get early access')",
    "description": "Background #e9ebdf (Parchment), text #151515 (Obsidian), border 1px solid #151515, border-radius 9999px. Font: saansFont 380 14-16px. Padding approximately 8px 20px. The warm off-white fill on near-black background reads as the brightest element on page \u2014 not an aggressive color CTA but a luminance CTA."
  },
  {
    "name": "Ghost Button \u2014 Square",
    "role": "Secondary actions, nav-level text links with visible border",
    "description": "Background transparent, text #e9ebdf, border 1px solid #e9ebdf, border-radius 0px. Font: saansFont 380 14px. Zero padding in data \u2014 inline with surrounding text flow. Used alongside filled pill for secondary pairing."
  },
  {
    "name": "Dark Surface Button \u2014 Square",
    "role": "Section-level actions embedded in dark content cards",
    "description": "Background #242424, text #e9ebdf, border 1px solid rgba(233,235,223,0.12), border-radius 0px, padding 40px 40px 32px 40px. Acts more as a content panel-button hybrid \u2014 large padding turns it into a tappable card area."
  },
  {
    "name": "Muted Ghost Button",
    "role": "Tertiary actions, low-emphasis interactive text",
    "description": "Background transparent, text #e9ebdf, border 1px solid #433e38 (Charcoal Rim variant), border-radius 0px. Lower border contrast than primary ghost \u2014 visually recedes to let content breathe."
  },
  {
    "name": "Raised Card",
    "role": "Feature cards, integration tiles, content panels",
    "description": "Background #242424, border-radius 12px for larger cards / 8px for standard cards, no box-shadow, padding 8px for image-topped cards. Elevation is purely colorimetric \u2014 the #242424 surface against #151515 canvas creates ~3% lightness lift with no shadow."
  },
  {
    "name": "Deep Card",
    "role": "Full-bleed content sections, testimonial panels",
    "description": "Background #0e0e0, border-radius 0px, no shadow, padding 24px 0 24px 12px. Darker than canvas \u2014 creates a recessed inset effect, used for large-area content blocks that should feel embedded rather than floating."
  },
  {
    "name": "Eyebrow Label",
    "role": "Section category labels above headlines (e.g. 'AppGen for the enterprise')",
    "description": "Text #b6b8af (Limestone), font pxGroteskFont 400 12-14px, letter-spacing +0.013em. No background. Positioned above headline in 8-16px gap. Functions as quiet organizational metadata."
  },
  {
    "name": "Beta Badge",
    "role": "Status tags, 'Public Beta' announcement strip",
    "description": "Background #0e352c (Midnight Moss), text #e9ebdf, border-radius 4px, padding 2px 6px. Sits in announcement bar at very top of page with a linked CTA alongside."
  },
  {
    "name": "Announcement Bar",
    "role": "Global top-of-page announcement strip",
    "description": "Background #151515 with teal gradient wash hint (#0e352c), full-width, height ~40px. Contains pxGroteskFont 400 14px text in #e9ebdf with a ghost arrow-linked label. Hairline border-bottom 1px #3f403d separates from nav."
  },
  {
    "name": "Navigation Bar",
    "role": "Sticky top navigation",
    "description": "Background #151515 with backdrop-filter blur(3-4px), height 60px. Logo left, nav links center in pxGroteskFont 400 14px at #94958 with #e9ebdf on hover. Right: 'Sign in' ghost text link, 'Book a demo' ghost pill button, 'Start for free' filled pill button. Hairline 1px solid #3f403d bottom border."
  },
  {
    "name": "Logo Grid Row",
    "role": "Social proof customer logo strip",
    "description": "Background #151515 or #242424 section. Logos rendered at #e9ebdf fill (desaturated to match Parchment). Horizontal scroll or flex-wrapped row. No borders, no card containers \u2014 logos float directly on surface."
  },
  {
    "name": "Integration Icon Bubble",
    "role": "Integration/connector showcase icons in hero grid",
    "description": "Circular container, background #242424 or white (for colorful third-party logos), border-radius 9999px, 56-64px diameter. Icons retain their native brand colors inside the circle. Grid arrangement with 8px gaps. Slight drop into dark background creates constellation-like product connectivity display."
  }
]
