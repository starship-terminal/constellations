  {
    "html": "<div style=\"--color-obsidian-canvas: #151515; --color-void-black: #0e0e0e; --color-ember-surface: #242424; --color-charcoal-rim: #3f403d; --color-copper-wire: #8b867f; --color-ash-text: #94958e; --color-fog-text: #cbccc4; --color-limestone: #b6b8af; --color-parchment: #e9ebdf; --color-forest-deep: #185849; --color-midnight-moss: #0e352c; --font-saansfont: 'Inter', 'DM Sans', sans-serif; --font-pxgroteskfont: 'Space Grotesk', 'Geist', sans-serif; width: 600px; background: var(--color-obsidian-canvas); font-family: var(--font-saansfont); padding: 40px 24px; box-sizing: border-box;\"><style>*{box-sizing:border-box;}</style><!-- Section Heading --><p style=\"color: var(--color-limestone); font-family: var(--font-pxgroteskfont); font-size: 13px; font-weight: 400; letter-spacing: 0.013em; margin: 0 0 16px 0; text-transform: none;\">Made for, and trusted by, businesses of all sizes</p><!-- Cards Grid --><div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 2px;\"><!-- Card 1 --><div style=\"background: var(--color-ember-surface); padding: 28px 24px 24px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 160px;\"><div style=\"color: var(--color-parchment); font-family: var(--font-saansfont); font-size: 22px; font-weight: 300; line-height: 1.2; letter-spacing: -0.020em; margin: 0 0 20px 0;\">Ramp saved $8M and 20,000+ hours</div><div style=\"color: var(--color-fog-text); font-family: var(--font-pxgroteskfont); font-size: 13px; font-weight: 400; letter-spacing: 0.010em;\">ramp <span style=\"font-size: 11px;\">\u2197</span></div></div><!-- Card 2 --><div style=\"background: var(--color-ember-surface); padding: 28px 24px 24px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 160px;\"><div style=\"color: var(--color-parchment); font-family: var(--font-saansfont); font-size: 22px; font-weight: 300; line-height: 1.2; letter-spacing: -0.020em; margin: 0 0 20px 0;\">10x reduction in dev time across 1600 studios</div><div style=\"color: var(--color-fog-text); font-family: var(--font-pxgroteskfont); font-size: 13px; font-weight: 400; letter-spacing: 0.010em;\">Orangetheory Fitness</div></div><!-- Card 3 --><div style=\"background: var(--color-ember-surface); padding: 28px 24px 24px 24px; display: flex; flex-direction: column; justify-content: space-between; min-height: 140px; border-top: 2px solid var(--color-obsidian-canvas);\"><div style=\"color: var(--color-parchment); font-family: var(--font-saansfont); font-size: 22px; font-weight: 300; line-height: 1.2; letter-spacing: -0.020em; margin: 0 0 20px 0;\">10x increase in patients treated</div><div style=\"color: var(--color-fog-text); font-family: var(--font-pxgroteskfont); font-size: 13px; font-weight: 400; letter-spacing: 0.010em;\">UTMB Health</div></div><!-- Card 4 CTA --><div style=\"background: var(--color-ember-surface); padding: 28px 24px 24px 24px; display: flex; flex-direction: column; justify-content: flex-end; min-height: 140px; border-top: 2px solid var(--color-obsidian-canvas);\"><a href=\"#\" style=\"display: flex; align-items: center; justify-content: space-between; color: var(--color-parchment); font-family: var(--font-pxgroteskfont); font-size: 12px; font-weight: 400; letter-spacing: 0.013em; text-decoration: none; text-transform: uppercase;\">For Financial Services Teams <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"#e9ebdf\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></div></div>",
