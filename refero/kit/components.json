    "html": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&display=swap');\n  :root {\n    --color-sky-marker: #44b1ff;\n    --color-near-black: #1e1e1e;\n    --color-parchment: #f2efe9;\n    --color-chalk: #ffffff;\n    --color-fog: #e3e3e3;\n    --color-amber-flag: #f2ba41;\n    --font-libre-franklin: 'Libre Franklin', sans-serif;\n  }\n  .feature-cards-wrapper {\n    background: var(--color-parchment);\n    padding: 24px;\n    font-family: var(--font-libre-franklin);\n    box-sizing: border-box;\n    width: 100%;\n  }\n  .feature-cards-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n  }\n  .feature-card {\n    background: var(--color-chalk);\n    border: 1px solid var(--color-fog);\n    border-radius: 12px;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n  .feature-card.active {\n    border-color: var(--color-sky-marker);\n    border-width: 1.5px;\n  }\n  .feature-card-icon {\n    width: 40px;\n    height: 40px;\n    margin-bottom: 12px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .feature-card-icon svg {\n    width: 40px;\n    height: 40px;\n  }\n  .feature-card-text {\n    font-size: 14px;\n    line-height: 1.5;\n    letter-spacing: -0.013em;\n    color: var(--color-near-black);\n  }\n  .feature-card-text strong {\n    font-weight: 700;\n  }\n</style>\n<div class=\"feature-cards-wrapper\">\n  <div class=\"feature-cards-grid\">\n    <div class=\"feature-card active\">\n      <div class=\"feature-card-icon\">\n        <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <circle cx=\"14\" cy=\"14\" r=\"7\" fill=\"#44b1ff\" opacity=\"0.25\"/>\n          <circle cx=\"14\" cy=\"14\" r=\"4\" fill=\"#44b1ff\"/>\n          <circle cx=\"26\" cy=\"14\" r=\"7\" fill=\"#44b1ff\" opacity=\"0.25\"/>\n          <circle cx=\"26\" cy=\"14\" r=\"4\" fill=\"#44b1ff\"/>\n          <rect x=\"8\" y=\"24\" width=\"24\" height=\"10\" rx=\"3\" fill=\"#f2ba41\" opacity=\"0.5\"/>\n          <rect x=\"10\" y=\"26\" width=\"20\" height=\"6\" rx=\"2\" fill=\"#f2ba41\"/>\n        </svg>\n      </div>\n      <p class=\"feature-card-text\"><strong>Get more subscribers</strong> with landing pages, forms, and creator recommendations.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-card-icon\">\n        <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"5\" y=\"10\" width=\"30\" height=\"20\" rx=\"4\" fill=\"#44b1ff\" opacity=\"0.2\"/>\n          <rect x=\"5\" y=\"10\" width=\"30\" height=\"20\" rx=\"4\" stroke=\"#44b1ff\" stroke-width=\"1.5\"/>\n          <path d=\"M5 16 L20 24 L35 16\" stroke=\"#44b1ff\" stroke-width=\"1.5\" fill=\"none\"/>\n          <circle cx=\"32\" cy=\"11\" r=\"5\" fill=\"#f2ba41\"/>\n        </svg>\n      </div>\n      <p class=\"feature-card-text\"><strong>Send beautiful emails</strong> that build relationships, not just revenue.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-card-icon\">\n        <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"5\" y=\"14\" width=\"20\" height=\"14\" rx=\"3\" fill=\"#44b1ff\" opacity=\"0.2\"/>\n          <rect x=\"5\" y=\"14\" width=\"20\" height=\"14\" rx=\"3\" stroke=\"#44b1ff\" stroke-width=\"1.5\"/>\n          <rect x=\"17\" y=\"20\" width=\"18\" height=\"12\" rx=\"3\" fill=\"#44b1ff\" opacity=\"0.4\"/>\n          <rect x=\"17\" y=\"20\" width=\"18\" height=\"12\" rx=\"3\" stroke=\"#44b1ff\" stroke-width=\"1.5\"/>\n          <path d=\"M22 26 L25 29 L30 23\" stroke=\"#f2ba41\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <p class=\"feature-card-text\"><strong>Automate your work</strong> with apps that connect your creator tools directly to Kit.</p>\n    </div>\n    <div class=\"feature-card\">\n      <div class=\"feature-card-icon\">\n        <svg viewBox=\"0 0 40 40\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"6\" y=\"8\" width=\"6\" height=\"24\" rx=\"2\" fill=\"#44b1ff\" opacity=\"0.3\"/>\n          <rect x=\"6\" y=\"18\" width=\"6\" height=\"14\" rx=\"2\" fill=\"#44b1ff\"/>\n          <rect x=\"17\" y=\"8\" width=\"6\" height=\"24\" rx=\"2\" fill=\"#44b1ff\" opacity=\"0.3\"/>\n          <rect x=\"17\" y=\"12\" width=\"6\" height=\"20\" rx=\"2\" fill=\"#44b1ff\"/>\n          <rect x=\"28\" y=\"8\" width=\"6\" height=\"24\" rx=\"2\" fill=\"#44b1ff\" opacity=\"0.3\"/>\n          <rect x=\"28\" y=\"8\" width=\"6\" height=\"16\" rx=\"2\" fill=\"#44b1ff\"/>\n          <circle cx=\"34\" cy=\"10\" r=\"5\" fill=\"#f2ba41\"/>\n          <path d=\"M32 10 L33.5 11.5 L36 8.5\" stroke=\"white\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n      <p class=\"feature-card-text\"><strong>Earn more on autopilot</strong> with your digital products, subscriptions, and Kit Ads.</p>\n    </div>\n  </div>\n</div>",
