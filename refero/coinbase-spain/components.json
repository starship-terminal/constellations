    "html": "<style>:root{--color-coinbase-blue:#0052ff;--color-interactive-blue:#578bfa;--color-pure-white:#ffffff;--color-midnight:#0a0b0d;--color-slate:#5b616e;--color-ash:#8a919e;--color-frost:#f7f8f9;--color-cloud:#eef0f3;--color-pewter:#dedfe2;--color-charcoal:#141519;--color-positive-green:#27ad75;--color-negative-red:#f0616d;--font-coinbasedisplay:'Manrope',sans-serif;--font-coinbasesans:'Inter',sans-serif;--font-coinbasetext:'Inter',sans-serif;}@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Manrope:wght@400;700&display=swap');</style><div style=\"background:var(--color-pure-white);padding:48px 40px;border-radius:24px;font-family:var(--font-coinbasesans),sans-serif;display:flex;flex-direction:column;gap:32px;max-width:600px;box-sizing:border-box;\"><div style=\"display:flex;flex-direction:column;gap:8px;\"><p style=\"font-family:var(--font-coinbasesans),sans-serif;font-size:13px;font-weight:600;color:var(--color-ash);letter-spacing:0.08em;text-transform:uppercase;margin:0;\">Button Components</p><h2 style=\"font-family:var(--font-coinbasedisplay),sans-serif;font-size:28px;font-weight:400;color:var(--color-midnight);margin:0;line-height:1.25;\">Get started with Coinbase</h2><p style=\"font-family:var(--font-coinbasetext),sans-serif;font-size:16px;color:var(--color-slate);margin:0;line-height:1.5;\">The world's safest and most trusted platform to buy, sell and manage crypto.</p></div><div style=\"display:flex;flex-wrap:wrap;gap:16px;align-items:center;\"><a href=\"#\" style=\"display:inline-block;background:var(--color-coinbase-blue);color:var(--color-pure-white);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:600;padding:16px 32px;border-radius:56px;text-decoration:none;line-height:1;\">Sign up</a><a href=\"#\" style=\"display:inline-block;background:var(--color-midnight);color:var(--color-pure-white);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:600;padding:16px 32px;border-radius:56px;text-decoration:none;line-height:1;\">Sign in</a><a href=\"#\" style=\"display:inline-block;background:transparent;color:var(--color-interactive-blue);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:400;text-decoration:none;line-height:1;\">Learn more \u2192</a></div><div style=\"background:var(--color-midnight);border-radius:24px;padding:32px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;\"><a href=\"#\" style=\"display:inline-block;background:var(--color-pure-white);color:var(--color-midnight);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:600;padding:16px 32px;border-radius:100000px;text-decoration:none;line-height:1;\">Explore staking options</a><a href=\"#\" style=\"display:inline-block;background:transparent;color:var(--color-interactive-blue);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:400;text-decoration:none;line-height:1;\">Learn more</a></div></div>",
