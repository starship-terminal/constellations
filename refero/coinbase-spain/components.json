    "html": "<style>:root{--color-coinbase-blue:#0052ff;--color-interactive-blue:#578bfa;--color-pure-white:#ffffff;--color-midnight:#0a0b0d;--color-slate:#5b616e;--color-ash:#8a919e;--color-frost:#f7f8f9;--color-cloud:#eef0f3;--color-pewter:#dedfe2;--color-charcoal:#141519;--color-positive-green:#27ad75;--color-negative-red:#f0616d;--font-coinbasedisplay:'Manrope',sans-serif;--font-coinbasesans:'Inter',sans-serif;--font-coinbasetext:'Inter',sans-serif;}@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Manrope:wght@400;700&display=swap');</style><div style=\"background:var(--color-pure-white);padding:32px;border-radius:24px;font-family:var(--font-coinbasesans),sans-serif;max-width:600px;box-sizing:border-box;\"><div style=\"display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;\"><h3 style=\"font-family:var(--font-coinbasesans),sans-serif;font-size:20px;font-weight:600;color:var(--color-midnight);margin:0;\">Prices</h3><div style=\"display:flex;gap:8px;\"><button style=\"background:var(--color-midnight);color:var(--color-pure-white);font-family:var(--font-coinbasesans),sans-serif;font-size:14px;font-weight:600;padding:10px 20px;border-radius:100000px;border:none;cursor:pointer;\">Tradable</button><button style=\"background:transparent;color:var(--color-slate);font-family:var(--font-coinbasesans),sans-serif;font-size:14px;font-weight:400;padding:10px 20px;border-radius:100000px;border:none;cursor:pointer;\">Top gainers</button><button style=\"background:transparent;color:var(--color-slate);font-family:var(--font-coinbasesans),sans-serif;font-size:14px;font-weight:400;padding:10px 20px;border-radius:100000px;border:none;cursor:pointer;\">New</button></div></div><div style=\"display:flex;flex-direction:column;gap:0;\"><div style=\"display:flex;justify-content:space-between;align-items:center;padding:16px 0;border-bottom:1px solid var(--color-cloud);\"><div style=\"display:flex;align-items:center;gap:12px;\"><