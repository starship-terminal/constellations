    "html": "<style>:root{--color-coinbase-blue:#0052ff;--color-interactive-blue:#578bfa;--color-pure-white:#ffffff;--color-midnight:#0a0b0d;--color-slate:#5b616e;--color-ash:#8a919e;--color-frost:#f7f8f9;--color-cloud:#eef0f3;--color-pewter:#dedfe2;--color-charcoal:#141519;--color-positive-green:#27ad75;--color-negative-red:#f0616d;--font-coinbasedisplay:'Manrope',sans-serif;--font-coinbasesans:'Inter',sans-serif;--font-coinbasetext:'Inter',sans-serif;}@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Manrope:wght@400;700&display=swap');</style><div style=\"background:var(--color-midnight);border-radius:24px;padding:0;overflow:hidden;max-width:600px;box-sizing:border-box;font-family:var(--font-coinbasesans),sans-serif;\"><div style=\"display:flex;flex-direction:column;padding:48px 40px;gap:24px;\"><div style=\"display:flex;align-items:center;justify-content:center;background:var(--color-charcoal);border-radius:20px;padding:32px;margin-bottom:8px;position:relative;overflow:hidden;\"><div style=\"position:absolute;bottom:0;left:0;width:120px;height:90px;background:linear-gradient(135deg,#27ad75 60%,transparent 100%);border-radius:0 20px 0 0;opacity:0.18;\"></div><div style=\"display:flex;flex-direction:column;align-items:flex-start;gap:4px;flex:1;\"><span style=\"font-family:var(--font-coinbasetext),sans-serif;font-size:13px;color:var(--color-ash);letter-spacing:0.05em;text-transform:uppercase;\">Annual yield</span><span style=\"font-family:var(--font-coinbasedisplay),sans-serif;font-size:64px;font-weight:400;color:var(--color-pure-white);line-height:1;\">14%</span><span style=\"font-family:var(--font-coinbasesans),sans-serif;font-size:16px;color:var(--color-positive-green);font-weight:600;\">APY on your crypto</span></div><div style=\"width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#27ad75,#0052ff);display:flex;align-items:center;justify-content:center;flex-shrink:0;\"><svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><path d=\"M18 6v24M10 14l8-8 8 8\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M8 28h20\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\"/></svg></div></div><div style=\"display:flex;flex-direction:column;gap:12px;\"><h2 style=\"font-family:var(--font-coinbasedisplay),sans-serif;font-size:36px;font-weight:400;color:var(--color-pure-white);margin:0;line-height:1.1;\">Earn up to 14% APY on your crypto</h2><p style=\"font-family:var(--font-coinbasetext),sans-serif;font-size:16px;color:var(--color-ash);margin:0;line-height:1.5;\">Put your crypto to work by staking with Coinbase and earn rewards of up to 14% APY on your holdings.</p></div><div style=\"display:flex;flex-direction:column;gap:16px;\"><a href=\"#\" style=\"display:inline-block;background:var(--color-pure-white);color:var(--color-midnight);font-family:var(--font-coinbasesans),sans-serif;font-size:16px;font-weight:600;padding:18px 32px;border-radius:100000px;text-decoration:none;line-height:1;text-align:center;\">Explore staking options</a><p style=\"font-family:var(--font-coinbasetext),sans-serif;font-size:13px;color:var(--color-ash);margin:0;line-height:1.5;\">Available for certain assets. APYs are indicative and not guaranteed and may vary over time. <a href=\"#\" style=\"color:var(--color-interactive-blue);text-decoration:none;\">Learn more</a>.</p></div></div></div>",
