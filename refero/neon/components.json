  {
    "name": "Primary Pill Button",
    "role": "The main call-to-action, e.g., 'Get started', 'Sign up'.",
    "description": "A pill-shaped button with a Whiteout (#ffffff) background and Graphite Deep (#151617) text. Uses Inter font. Padding is H: 28px, V: 12px. Radius is 9999px."
  },
  {
    "name": "Ghost Pill Button",
    "role": "Secondary actions, e.g., 'Read the docs', 'Log in'.",
    "description": "A pill-shaped button with a transparent background, Whiteout (#ffffff) text, and a 1px solid border in Graphite Light (#303236). Uses Inter font. Padding is H: 18px, V: 12px. Radius is 9999px."
  },
  {
    "name": "Feature List Item",
    "role": "Bulleted items in feature sections.",
    "description": "Whiteout (#ffffff) text using Inter. Preceded by a small dot or icon colored with Neon Glow (#34d59a)."
  },
  {
    "name": "Navigation Link",
    "role": "Links in the main site header.",
    "description": "Text in Ash (#797d86) using Inter font. On hover or active state, text becomes Whiteout (#ffffff)."
  },
  {
    "name": "Tag Badge",
    "role": "Small informational tags, like 'A DATABRICKS COMPANY'.",
    "description": "Small, all-caps text using GeistMono in Ash (#797d86) or a similar gray. Often preceded by a Neon Glow (#34d59a) icon or symbol."
  },
  {
    "name": "Announcement Bar",
    "role": "A persistent top bar for site-wide announcements.",
    "description": "Full-width bar with a Blackout (#000000) background. Text uses Inter font in a legible color like Whiteout (#ffffff) or Neon Glow (#34d59a)."
  },
  {
    "name": "Logo Bar",
    "role": "A section displaying logos of partner or client companies.",
