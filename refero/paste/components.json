[
  {
    "html": "<div style=\"--color-signal-blue: #0088ff; --color-bright-blue: #1c95ff; --color-ink: #101010; --color-smoke: #6e6e73; --color-pure-white: #ffffff; --color-snow-gray: #f5f5f7; --color-silver: #d0d0d3; --font-system-ui: system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif; background: var(--color-pure-white); padding: 48px 40px; display: flex; flex-direction: column; align-items: center; gap: 16px; border-radius: 24px; max-width: 560px; margin: 0 auto; font-family: var(--font-system-ui);\"><h2 style=\"font-family: var(--font-system-ui); font-size: 40px; font-weight: 700; color: var(--color-ink); letter-spacing: -0.24px; line-height: 44px; margin: 0 0 8px 0; text-align: center;\">Your clipboard,<br>supercharged and secure</h2><p style=\"font-family: var(--font-system-ui); font-size: 18px; font-weight: 400; color: var(--color-smoke); line-height: 1.5; margin: 0 0 24px 0; text-align: center; max-width: 420px;\">Paste keeps everything you copy organized and searchable. Lightweight, intuitive, and private by design.</p><div style=\"display: flex; gap: 12px; align-items: center; flex-wrap: wrap; justify-content: center;\"><a href=\"#\" style=\"display: inline-block; background: var(--color-signal-blue); color: var(--color-pure-white); font-family: var(--font-system-ui); font-size: 16px; font-weight: 600; padding: 12px 28px; border-radius: 100px; text-decoration: none; transition: background 0.2s; border: none; cursor: pointer;\">Try for free</a><a href=\"#\" style=\"display: inline-block; background: transparent; color: var(--color-signal-blue); font-family: var(--font-system-ui); font-size: 16px; font-weight: 500; padding: 11px 28px; border-radius: 100px; text-decoration: none; border: 1.5px solid var(--color-signal-blue); cursor: pointer;\">View pricing</a></div><div style=\"display: flex; align-items: center; gap: 24px; margin-top: 24px; flex-wrap: wrap; justify-content: center;\"><span style=\"font-family: var(--font-system-ui); font-size: 13px; color: var(--color-silver); font-weight: 400; display: flex; align-items: center; gap: 6px;\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" style=\"flex-shrink:0\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z\" fill=\"#d0d0d3\"/></svg>Free 14-day trial</span><span style=\"font-family: var(--font-system-ui); font-size: 13px; color: var(--color-silver); font-weight: 400; display: flex; align-items: center; gap: 6px;\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" style=\"flex-shrink:0\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z\" fill=\"#d0d0d3\"/></svg>No credit card required</span><span style=\"font-family: var(--font-system-ui); font-size: 13px; color: var(--color-silver); font-weight: 400; display: flex; align-items: center; gap: 6px;\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" style=\"flex-shrink:0\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14l-4-4 1.41-1.41L11 13.17l6.59-6.59L19 8l-8 8z\" fill=\"#d0d0d3\"/></svg>Mac, iPhone & iPad</span></div></div>",
