  {
    "html": "<div style=\"--color-pure-white: #ffffff; --color-snow-gray: #f5f5f7; --color-silver: #d0d0d3; --color-pewter: #ababb0; --color-smoke: #6e6e73; --color-ink: #101010; --color-honey-glow: #feab30; --font-system-ui: system-ui, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif; --font-inter: 'Inter', system-ui, sans-serif; background: var(--color-pure-white); padding: 32px 40px; border-radius: 24px; max-width: 560px; margin: 0 auto; box-sizing: border-box;\"><div style=\"display: flex; align-items: center; justify-content: center; gap: 0; flex-wrap: wrap; row-gap: 20px;\"><div style=\"display: flex; align-items: center; gap: 7px; padding: 0 20px; border-right: 1.5px solid var(--color-silver);\"><svg width=\"16\" height=\"18\" viewBox=\"0 0 814 1000\" fill=\"none\"><path d=\"M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-57.8-155.5-127.4C46 790.7 0 663 0 541.8c0-194.3 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z\" fill=\"#ababb0\"/></svg><span style=\"font-family: var(--font-inter); font-size: 13px; font-weight: 400; color: var(--color-pewter); letter-spacing: -0.41px; white-space: nowrap;\">Invaluable Utility</span></div><div style=\"display: flex; align-items: center; gap: 6px; padding: 0 20px; border-right: 1.5px solid var(--color-silver);\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\" fill=\"#feab30\"/></svg><div><span style=\"font-family: var(--font-inter); font-size: 13px; font-weight: 600; color: var(--color-pewter); letter-spacing: -0.41px;\">4.5</span><span style=\"font-family: var(--font-inter); font-size: 10px; font-weight: 400; color: var(--color-silver); letter-spacing: 0.5px; display: block; line-height: 1; text-transform: uppercase;\">100+ RATINGS</span></div></div><div style=\"padding: 0 20px; border-right: 1.5px solid var(--color-silver);\"><span style=\"font-family: var(--font-inter); font-size: 15px; font-weight: 700; color: var(--color-pewter); letter-spacing: -1px;\">TNW</span></div><div style=\"padding: 0 20px; border-right: 1.5px solid var(--color-silver);\"><span style=\"font-family: var(--font-inter); font-size: 13px; font-weight: 600; color: var(--color-pewter); letter-spacing: -0.3px;\">9to5Mac</span></div><div style=\"padding: 0 20px;\"><span style=\"font-family: var(--font-inter); font-size: 13px; font-weight: 400; color: var(--color-pewter); letter-spacing: 1px;\">life<strong style=\"font-weight:700;\">hacker</strong></span></div></div></div>",
