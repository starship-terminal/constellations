  {
    "html": "<div style=\"--color-coal-ink:#1c1a17;--color-ledger-white:#fafafa;--color-parchment:#f7f3eb;--color-ash:#f1f1f1;--color-slate-mid:#7e7d7b;--color-graphite:#5a5957;--color-stone:#969594;--color-fossil:#bab9b8;--color-smolder:#ff6020;--color-signal-violet:#777eff;--color-deep-violet:#731fff;--color-mint-pulse:#05933b;--font-mona-sans:'Plus Jakarta Sans',sans-serif;--font-inter:Inter,sans-serif;--spacing-4:4px;--spacing-8:8px;--spacing-12:12px;--spacing-16:16px;--spacing-24:24px;--spacing-32:32px;--spacing-40:40px;padding:40px;background:var(--color-ledger-white);font-family:var(--font-inter);max-width:600px;\"><div style=\"margin-bottom:var(--spacing-32);\"><p style=\"font-family:var(--font-inter);font-size:11px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-slate-mid);margin:0 0 var(--spacing-12) 0;\">Primary Actions</p><div style=\"display:flex;gap:var(--spacing-12);flex-wrap:wrap;align-items:center;\"><a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:var(--color-coal-ink);color:#ffffff;font-family:var(--font-inter);font-size:14px;font-weight:500;padding:10px 20px;border-radius:48px;text-decoration:none;border:none;letter-spacing:-0.01em;\">Get Started</a><a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:500;padding:9px 19px;border-radius:20px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);letter-spacing:-0.01em;\">Explore Marketplace</a><a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:500;padding:9px 19px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);letter-spacing:-0.01em;\">Sign in</a></div></div><div><p style=\"font-family:var(--font-inter);font-size:11px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;color:var(--color-slate-mid);margin:0 0 var(--spacing-12) 0;\">Publisher Directory</p><div style=\"display:flex;gap:var(--spacing-8);flex-wrap:wrap;align-items:center;\"><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:var(--color-coal-ink);color:#ffffff;font-family:var(--font-inter);font-size:14px;font-weight:500;padding:7px 14px;border-radius:999px;text-decoration:none;border:none;\">All <span style=\"font-weight:400;opacity:0.7;\">1291</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">Arts &amp; Entertainment <span style=\"color:var(--color-slate-mid);\">529</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">Books &amp; Literature <span style=\"color:var(--color-slate-mid);\">211</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">Music <span style=\"color:var(--color-slate-mid);\">193</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">Celebrity <span style=\"color:var(--color-slate-mid);\">58</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">Movies <span style=\"color:var(--color-slate-mid);\">40</span></a><a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;color:rgba(28,26,23,0.72);font-family:var(--font-inter);font-size:14px;font-weight:400;padding:7px 14px;border-radius:999px;text-decoration:none;border:1px solid rgba(0,0,0,0.12);\">AI Traffic <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" style=\"margin-left:2px;\"><path d=\"M3 4.5L6 7.5L9 4.5\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div></div></div>",
