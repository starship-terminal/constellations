  {
    "html": "<div style=\"--color-coal-ink:#1c1a17;--color-ledger-white:#fafafa;--color-parchment:#f7f3eb;--color-ash:#f1f1f1;--color-slate-mid:#7e7d7b;--color-graphite:#5a5957;--font-mona-sans:'Plus Jakarta Sans',sans-serif;--font-inter:Inter,sans-serif;--spacing-24:24px;--spacing-16:16px;--spacing-12:12px;padding:40px;background:#ffffff;font-family:var(--font-inter);max-width:600px;\"><div style=\"display:grid;grid-template-columns:1fr 1fr;gap:16px;\"><div style=\"background:radial-gradient(81% 66% at 1.8% 1.1%, #545454 0%, #1c1a17 100%);border-radius:10px;padding:var(--spacing-24);display:flex;flex-direction:column;justify-content:flex-end;min-height:220px;\"><p style=\"font-family:var(--font-mona-sans);font-size:24px;font-weight:700;color:#ffffff;margin:0;line-height:1.2;letter-spacing:-0.01em;\">Trusted by publishers monetizing AI</p><p style=\"font-family:var(--font-mona-sans);font-size:24px;font-weight:700;margin:0;line-height:1.2;letter-spacing:-0.01em;\"><span style=\"background:linear-gradient(90deg, #10b981 0%, #a855f7 50%, #f59e0b 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\">audiences at scale</span></p></div><div style=\"background:var(--color-ledger-white);border-radius:10px;padding:var(--spacing-24);display:flex;flex-direction:column;justify-content:space-between;min-height:220px;\"><p style=\"font-family:var(--font-inter);font-size:14px;font-weight:400;color:var(--color-slate-mid);margin:0;line-height:1.5;\">Paid to Publishers</p><p style=\"font-family:var(--font-mona-sans);font-size:48px;font-weight:700;color:var(--color-coal-ink);margin:0;line-height:1;letter-spacing:-1.44px;\">$4.2M+</p></div><div style=\"background:var(--color-ledger-white);border-radius:10px;padding:var(--spacing-24);display:flex;flex-direction:column;justify-content:space-between;min-height:220px;\"><p style=\"font-family:var(--font-inter);font-size:14px;font-weight:400;color:var(--color-slate-mid);margin:0;line-height:1.5;\">AI Reach</p><p style=\"font-family:var(--font-mona-sans);font-size:48px;font-weight:700;color:var(--color-coal-ink);margin:0;line-height:1;letter-spacing:-1.44px;\">850M+</p></div><div style=\"background:var(--color-ledger-white);border-radius:10px;padding:var(--spacing-24);display:flex;flex-direction:column;justify-content:space-between;min-height:220px;\"><p style=\"font-family:var(--font-inter);font-size:14px;font-weight:400;color:var(--color-slate-mid);margin:0;line-height:1.5;\">Active Publishers</p><p style=\"font-family:var(--font-mona-sans);font-size:48px;font-weight:700;color:var(--color-coal-ink);margin:0;line-height:1;letter-spacing:-1.44px;\">1,290+</p></div></div></div>",
