-color-coal-ink);line-height:1;\">100</span><span style=\"font-family:var(--font-inter);font-size:10px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-slate-mid);\">FIT SCORE</span><div style=\"width:100%;height:3px;background:var(--color-ash);border-radius:2px;margin-top:2px;\"><div style=\"width:100%;height:100%;background:var(--color-mint-pulse);border-radius:2px;\"></div></div></div></div></div><div style=\"background:var(--color-ledger-white);border-radius:10px;padding:var(--spacing-24);display:flex;flex-direction:column;gap:var(--spacing-16);\"><div style=\"display:flex;justify-content:space-between;align-items:flex-start;\"><div style=\"display:flex;align-items:center;gap:var(--spacing-12);\"><div style=\"width:40px;height:40px;background:#f5c518;border-radius:8px;display:flex;align-items:center;justify-content:center;\"><span style=\"font-family:var(--font-inter);font-size:11px;font-weight:900;color:var(--color-coal-ink);letter-spacing:-0.5px;\">IMDb</span></div><div><p style=\"font-family:var(--font-inter);font-size:15px;font-weight:600;color:var(--color-coal-ink);margin:0;line-height:1.3;\">imdb.com</p><p style=\"font-family:var(--font-inter);font-size:13px;font-weight:400;color:var(--color-slate-mid);margin:0;line-height:1.4;\">IMDb.com, Inc.</p></div></div><div style=\"width:20px;height:14px;background:linear-gradient(180deg,#b22234 0%,#b22234 15%,#fff 15%,#fff 23%,#b22234 23%,#b22234 38%,#fff 38%,#fff 46%,#b22234 46%,#b22234 61%,#fff 61%,#fff 69%,#b22234 69%,#b22234 84%,#fff 84%);border-radius:2px;position:relative;overflow:hidden;\"><div style=\"position:absolute;top:0;left:0;width:40%;height:53%;background:#3c3b6e;\"></div></div></div><p style=\"font-family:var(--font-inter);font-size:14px;font-weight:400;color:var(--color-graphite);margin:0;line-height:1.5;\">IMDb is the world's most popular and authoritative source for movie, TV, and...</p><div style=\"display:flex;gap:var(--spacing-4);flex-wrap:wrap;\"><span style=\"font-family:var(--font-inter);font-size:12px;font-weight:400;color:#52525b;background:var(--color-ledger-white);border:1px solid var(--color-ash);border-radius:6px;padding:4px 10px;\">Arts & Entertainment</span><span style=\"font-family:var(--font-inter);font-size:12px;font-weight:400;color:#52525b;background:var(--color-ledger-white);border:1px solid var(--color-ash);border-radius:6px;padding:4px 10px;\">en</span></div><div style=\"display:flex;gap:var(--spacing-24);align-items:flex-end;margin-top:auto;padding-top:var(--spacing-8);\"><div style=\"display:flex;flex-direction:column;gap:2px;\"><div style=\"display:flex;align-items:center;gap:4px;\"><span style=\"width:6px;height:6px;border-radius:50%;background:var(--color-mint-pulse);display:inline-block;\"></span><span style=\"font-family:var(--font-inter);font-size:14px;font-weight:600;color:var(--color-coal-ink);line-height:1;\">High</span></div><span style=\"font-family:var(--font-inter);font-size:10px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-slate-mid);\">AI TRAFFIC</span></div><div style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:var(--font-inter);font-size:14px;font-weight:600;color:var(--color-signal-violet);line-height:1;\">$100K+</span><span style=\"font-family:var(--font-inter);font-size:10px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-slate-mid);\">REVENUE EST.</span></div><div style=\"display:flex;flex-direction:column;gap:2px;\"><span style=\"font-family:var(--font-inter);font-size:14px;font-weight:700;color:var(--color-coal-ink);line-height:1;\">42</span><span style=\"font-family:var(--font-inter);font-size:10px;font-weight:600;letter-spacing:0.5px;text-transform:uppercase;color:var(--color-slate-mid);\">FIT SCORE</span><div style=\"width:100%;height:3px;background:var(--color-ash);border-radius:2px;margin-top:2px;\"><div style=\"width:42%;height:100%;background:var(--color-smolder);border-radius:2px;\"></div></div></div></div></div></div></div>",
