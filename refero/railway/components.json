[
  {
    "html": "<style>\n  :root {\n    --color-deep-space: #13111c;\n    --color-surface: #1a191f;\n    --color-crater: #33323e;\n    --color-black-hole: #0d0c14;\n    --color-starlight: #f7f7f8;\n    --color-starlight-dim: #d0cfd2;\n    --color-comet: #a1a0ab;\n    --color-asteroid: #868593;\n    --color-cosmic-lilac: #553f83;\n    --color-supernova: #a05fcf;\n    --color-nebula-haze: #bf92ec;\n    --font-ibm-plex-serif: 'IBM Plex Serif', Georgia, 'Times New Roman', serif;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n\n  .rw-cta-wrapper {\n    background: var(--color-deep-space);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 64px 32px;\n    font-family: var(--font-inter);\n    min-height: 260px;\n  }\n\n  .rw-headline {\n    font-family: var(--font-ibm-plex-serif);\n    font-size: 54px;\n    font-weight: 400;\n    line-height: 1.12;\n    letter-spacing: -1.94px;\n    color: var(--color-starlight);\n    text-align: center;\n    margin: 0 0 16px 0;\n  }\n\n  .rw-subline {\n    font-family: var(--font-inter);\n    font-size: 18px;\n    font-weight: 400;\n    line-height: 1.5;\n    letter-spacing: -0.09px;\n    color: var(--color-comet);\n    text-align: center;\n    margin: 0 0 40px 0;\n  }\n\n  .rw-subline u {\n    color: var(--color-starlight-dim);\n    text-underline-offset: 3px;\n  }\n\n  .rw-btn-group {\n    display: flex;\n    gap: 12px;\n    align-items: center;\n    flex-wrap: wrap;\n    justify-content: center;\n  }\n\n  .rw-btn-primary {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: var(--color-cosmic-lilac);\n    color: var(--color-starlight);\n    font-family: var(--font-inter);\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.5;\n    letter-spacing: -0.1px;\n    padding: 12px 24px;\n    border-radius: 8px;\n    border: 1px solid rgba(255, 255, 255, 0.15);\n    text-decoration: none;\n    cursor: pointer;\n    transition: background 0.15s ease;\n  }\n\n  .rw-btn-primary:hover {\n    background: #6b52a0;\n  }\n\n  .rw-btn-secondary {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: transparent;\n    color: var(--color-starlight);\n    font-family: var(--font-inter);\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.5;\n    letter-spacing: -0.1px;\n    padding: 12px 24px;\n    border-radius: 8px;\n    border: 1px solid var(--color-crater);\n    text-decoration: none;\n    cursor: pointer;\n    transition: border-color 0.15s ease;\n  }\n\n  .rw-btn-secondary:hover {\n    border-color: var(--color-asteroid);\n  }\n</style>\n\n<div class=\"rw-cta-wrapper\">\n  <h1 class=\"rw-headline\">Ship software peacefully</h1>\n  <p class=\"rw-subline\">With the all-in-one <u>intelligent</u> cloud provider</p>\n  <div class=\"rw-btn-group\">\n    <a href=\"#\" class=\"rw-btn-primary\">\n      Deploy\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"#f7f7f8\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </a>\n    <a href=\"#\" class=\"rw-btn-secondary\">Demo</a>\n  </div>\n</div>",
    "name": "CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-deep-space: #13111c;\n    --color-surface: #1a191f;\n    --color-crater: #33323e;\n    --color-black-hole: #0d0c14;\n    --color-starlight: #f7f7f8;\n    --color-starlight-dim: #d0cfd2;\n    --color-comet: #a1a0ab;\n    --color-asteroid: #868593;\n    --color-cosmic-lilac: #553f83;\n    --color-supernova: #a05fcf;\n    --color-success: #42946e;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n    --font-ui-monospace: ui-monospace, Menlo, Monaco, Consolas, monospace;\n  }\n\n  .rw-demo-wrapper {\n    background: var(--color-deep-space);\n    padding: 40px 32px;\n    font-family: var(--font-inter);\n    display: flex;\n    flex-direction: column;\n    gap: 32px;\n    align-items: center;\n  }\n\n  /* Toast */\n  .rw-toast {\n    display: flex;\n    align-items: flex-start;\n    gap: 12px;\n    background: #15231d;\n    border: 1px solid #26543f;\n    border-radius: 8px;\n    padding: 14px 16px;\n    width: 100%;\n    max-width: 360px;\n    box-sizing: border-box;\n    position: relative;\n  }\n\n  .rw-toast-icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    background: var(--color-success);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    margin-top: 1px;\n  }\n\n  .rw-toast-body {\n    flex: 1;\n    min-width: 0;\n  }\n\n  .rw-toast-title {\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--color-starlight);\n    line-height: 1.4;\n    letter-spacing: -0.14px;\n    margin: 0 0 2px 0;\n  }\n\n  .rw-toast-desc {\n    font-size: 12px;\n    font-weight: 400;\n    color: var(--color-comet);\n    line-height: 1.5;\n    letter-spacing: -0.12px;\n    margin: 0;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .rw-toast-close {\n    background: none;\n    border: none;\n    color: var(--color-asteroid);\n    cursor: pointer;\n    padding: 0;\n    font-size: 16px;\n    line-height: 1;\n    flex-shrink: 0;\n    margin-top: -1px;\n  }\n\n  /* Tab Bar */\n  .rw-tab-bar {\n    background: rgba(13, 12, 20, 0.7);\n    border: 1px solid var(--color-crater);\n    border-radius: 9999px;\n    padding: 6px 8px;\n    display: flex;\n    align-items: center;\n    gap: 2px;\n    width: 100%;\n    max-width: 520px;\n    box-sizing: border-box;\n    backdrop-filter: blur(12px);\n  }\n\n  .rw-tab-item {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    padding: 8px 16px;\n    border-radius: 9999px;\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: -0.14px;\n    line-height: 1.4;\n    color: var(--color-asteroid);\n    cursor: pointer;\n    border: none;\n    background: transparent;\n    text-decoration: none;\n    transition: color 0.15s ease;\n    white-space: nowrap;\n  }\n\n  .rw-tab-item.active {\n    background: var(--color-cosmic-lilac);\n    color: var(--color-starlight);\n  }\n\n  .rw-tab-item:not(.active):hover {\n    color: var(--color-starlight-dim);\n  }\n\n  .rw-tab-sep {\n    width: 1px;\n    height: 16px;\n    background: var(--color-crater);\n    flex-shrink: 0;\n  }\n</style>\n\n<div class=\"rw-demo-wrapper\">\n  <!-- Toast Notification -->\n  <div class=\"rw-toast\">\n    <div class=\"rw-toast-icon\">\n      <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M2 6l3 3 5-5\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </div>\n    <div class=\"rw-toast-body\">\n      <p class=\"rw-toast-title\">Deployment Successful!</p>\n      <p class=\"rw-toast-desc\">backend was deployed successfully...</p>\n    </div>\n    <button class=\"rw-toast-close\" aria-label=\"Close\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M2 2l10 10M12 2L2 12\" stroke=\"#868593\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n      </svg>\n    </button>\n  </div>\n\n  <!-- Tab Bar -->\n  <div class=\"rw-tab-bar\">\n    <a href=\"#\" class=\"rw-tab-item active\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"1\" y=\"4\" width=\"12\" height=\"8\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n        <path d=\"M4 4V3a3 3 0 016 0v1\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      </svg>\n      Deploy\n    </a>\n    <div class=\"rw-tab-sep\"></div>\n    <a href=\"#\" class=\"rw-tab-item\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"4\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n        <circle cx=\"10\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n        <path d=\"M6 7h2\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      </svg>\n      Network\n    </a>\n    <div class=\"rw-tab-sep\"></div>\n    <a href=\"#\" class=\"rw-tab-item\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M2 10V7m3 3V5m3 5V3m3 7V6\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"/>\n      </svg>\n      Scale\n    </a>\n    <div class=\"rw-tab-sep\"></div>\n    <a href=\"#\" class=\"rw-tab-item\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"7\" cy=\"7\" r=\"5.5\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n        <circle cx=\"7\" cy=\"7\" r=\"2\" stroke=\"currentColor\" stroke-width=\"1.3\"/>\n      </svg>\n      Monitor\n    </a>\n    <div class=\"rw-tab-sep\"></div>\n    <a href=\"#\" class=\"rw-tab-item\">\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M7 1l1.5 4H13l-3.5 2.5 1.5 4L7 9l-4 2.5 1.5-4L1 5h4.5L7 1z\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linejoin=\"round\"/>\n      </svg>\n      Evolve\n    </a>\n  </div>\n</div>",
    "name": "Deployment Success Toast + Tab Bar",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-deep-space: #13111c;\n    --color-surface: #1a191f;\n    --color-crater: #33323e;\n    --color-starlight: #f7f7f8;\n    --color-starlight-dim: #d0cfd2;\n    --color-comet: #a1a0ab;\n    --color-asteroid: #868593;\n    --color-cosmic-lilac: #553f83;\n    --font-ibm-plex-serif: 'IBM Plex Serif', Georgia, 'Times New Roman', serif;\n    --font-inter: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n\n  .rw-testimonials-section {\n    background: var(--color-deep-space);\n    padding: 64px 32px;\n    font-family: var(--font-inter);\n    box-sizing: border-box;\n    width: 100%;\n  }\n\n  .rw-testimonials-header {\n    text-align: center;\n    margin-bottom: 48px;\n  }\n\n  .rw-testimonials-title {\n    font-family: var(--font-ibm-plex-serif);\n    font-size: 36px;\n    font-weight: 400;\n    line-height: 1.2;\n    letter-spacing: -0.72px;\n    color: var(--color-starlight);\n    margin: 0 0 12px 0;\n  }\n\n  .rw-testimonials-sub {\n    font-size: 16px;\n    font-weight: 400;\n    line-height: 1.6;\n    letter-spacing: -0.1px;\n    color: var(--color-comet);\n    margin: 0 0 24px 0;\n    max-width: 480px;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  .rw-btn-ghost {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    background: transparent;\n    color: var(--color-starlight);\n    font-family: var(--font-inter);\n    font-size: 15px;\n    font-weight: 500;\n    padding: 10px 20px;\n    border-radius: 8px;\n    border: 1px solid var(--color-crater);\n    text-decoration: none;\n    cursor: pointer;\n  }\n\n  .rw-cards-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n\n  .rw-testimonial-card {\n    background: var(--color-surface);\n    border: 1px solid var(--color-crater);\n    border-radius: 12px;\n    padding: 32px;\n    box-sizing: border-box;\n    position: relative;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n\n  .rw-testimonial-card::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background-image:\n      linear-gradient(var(--color-crater) 1px, transparent 1px),\n      linear-gradient(90deg, var(--color-crater) 1px, transparent 1px);\n    background-size: 32px 32px;\n    opacity: 0.25;\n    pointer-events: none;\n  }\n\n  .rw-card-logo {\n    margin-bottom: 24px;\n    position: relative;\n    z-index: 1;\n  }\n\n  .rw-logo-text {\n    font-size: 22px;\n    font-weight: 700;\n    color: var(--color-starlight);\n    letter-spacing: -0.5px;\n    font-family: var(--font-inter);\n  }\n\n  .rw-card-quote {\n    font-size: 15px;\n    font-weight: 400;\n    line-height: 1.65;\n    letter-spacing: -0.1px;\n    color: var(--color-starlight-dim);\n    margin: 0 0 32px 0;\n    flex: 1;\n    position: relative;\n    z-index: 1;\n  }\n\n  .rw-card-author {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding-top: 24px;\n    border-top: 1px solid var(--color-crater);\n    position: relative;\n    z-index: 1;\n  }\n\n  .rw-author-avatar {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    flex-shrink: 0;\n    overflow: hidden;\n  }\n\n  .rw-author-avatar-placeholder {\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 16px;\n    font-weight: 600;\n    color: var(--color-starlight);\n  }\n\n  .rw-author-name {\n    font-size: 14px;\n    font-weight: 600;\n    color: var(--color-starlight);\n    line-height: 1.4;\n    letter-spacing: -0.14px;\n    margin: 0 0 2px 0;\n  }\n\n  .rw-author-role {\n    font-size: 13px;\n    font-weight: 400;\n    color: var(--color-asteroid);\n    line-height: 1.4;\n    letter-spacing: -0.13px;\n    margin: 0;\n  }\n</style>\n\n<div class=\"rw-testimonials-section\">\n  <div class=\"rw-testimonials-header\">\n    <h2 class=\"rw-testimonials-title\">Trusted by the best in business</h2>\n    <p class=\"rw-testimonials-sub\">Railway supports great software teams wherever they are. Hear from some of the teams building their products on Railway.</p>\n    <a href=\"#\" class=\"rw-btn-ghost\">\n      Read customer stories\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M2 7h10M8 3l4 4-4 4\" stroke=\"#f7f7f8\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      </svg>\n    </a>\n  </div>\n\n  <div class=\"rw-cards-grid\">\n    <!-- Card 1 -->\n    <div class=\"rw-testimonial-card\">\n      <div class=\"rw-card-logo\">\n        <span class=\"rw-logo-text\">BILT \u229e</span>\n      </div>\n      <p class=\"rw-card-quote\">\"On our previous rent day, we saw traffic of 1,500+ requests per second that were all being fulfilled in under 50 milliseconds, which is really great. Our technical team is really impressed with scale like that.\"</p>\n      <div class=\"rw-card-author\">\n        <div class=\"rw-author-avatar\">\n          <div class=\"rw-author-avatar-placeholder\" style=\"background: linear-gradient(135deg, #3a5a8a, #2a4a7a);\">K</div>\n        </div>\n        <div>\n          <p class=\"rw-author-name\">Kartik Aggarwal</p>\n          <p class=\"rw-author-role\">Tech Lead at Bilt</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Card 2 -->\n    <div class=\"rw-testimonial-card\">\n      <div class=\"rw-card-logo\">\n        <span class=\"rw-logo-text\" style=\"font-size:26px; letter-spacing: -1px;\">G2X</span>\n      </div>\n      <p class=\"rw-card-quote\">\"Services that took 1 week to configure elsewhere take 1 day to spin up in Railway. Messy networking like on other cloud platforms doesn't exist on Railway. If you understand basic TCP, you're all set.\"</p>\n      <div class=\"rw-card-author\">\n        <div class=\"rw-author-avatar\">\n          <div class=\"rw-author-avatar-placeholder\" style=\"background: linear-gradient(135deg, #4a6a5a, #3a5a4a);\">D</div>\n        </div>\n        <div>\n          <p class=\"rw-author-name\">Daniel Lobaton</p>\n          <p class=\"rw-author-role\">CTO at G2X</p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Card 3 -->\n    <div class=\"rw-testimonial-card\">\n      <div class=\"rw-card-logo\">\n        <span class=\"rw-logo-text\">\u25c6 Mappa</span>\n      </div>\n      <p class=\"rw-card-quote\">\"Railway streamlines and accelerates our entire operation. It gives us instant observability into our services and makes spinning up self-hosted third-party tools almost effortless. This reduces friction in experimentation and shortens our deployment cycles significantly.\"</p>\n      <div class=\"rw-card-author\">\n        <div class=\"rw-author-avatar\">\n          <div class=\"rw-author-avatar-placeholder\" style=\"background: linear-gradient(135deg, #8a6a2a, #7a5a1a);\">D</div>\n        </div>\n        <div>\n          <p class=\"rw-author-name\">Daniel Moretti</p>\n          <p class=\"rw-author-role\">Co-Founder &amp; CTO at Mappa</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Testimonial Cards",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button",
    "role": "The main call-to-action, like 'Deploy \u2192'.",
    "description": "Solid `Cosmic Lilac` (#553f83) background with `Starlight` (#f7f7f8) text. Padding is `12px 24px` with an `8px` border radius. Border is a subtle `rgba(255, 255, 255, 0.15)`. Font is Inter 500."
  },
  {
    "name": "Secondary Button",
    "role": "Secondary actions, like 'Demo'.",
    "description": "Transparent background with `Starlight` (#f7f7f8) text and a `1px` solid border of `Crater` (#33323e). Padding is `12px 24px` with an `8px` border radius. Font is Inter 500."
  },
  {
    "name": "Navigation Link",
    "role": "Header and footer navigation items.",
    "description": "Transparent background with `Comet` (#a1a0ab) text. On hover, text changes to `Starlight` (#f7f7f8). Padding is minimal, typically around `6px 12px`."
  },
  {
    "name": "Logo Grid Card",
    "role": "Container for customer logos in the 'Trusted by' section.",
    "description": "`Surface` (#1a191f) background with a `12px` border radius and `24px` padding. A `1px` `Crater` (#33323e) border defines the card. Displays a grayscale partner logo at its center."
  },
  {
    "name": "Product UI Tab",
    "role": "Navigation within the product UI demo.",
    "description": "Text label in `Asteroid` (#868593). The active tab has `Starlight` (#f7f7f8) text and a `2px` bottom border of `Supernova` (#a05fcf), providing a clear visual indicator."
  },
  {
    "name": "Success Toast",
    "role": "A small notification for successful operations.",
    "description": "Dark green background (`#15231d`) with `Success` (#42946e) text and a `4px` border radius. A `1px` border of muted green (`#26543f`) provides subtle definition."
  },
  {
    "name": "Log Line Item",
    "role": "A single line in the product's log viewer.",
    "description": "Uses `ui-monospace` font at 16px. Background is `Black Hole` (#0d0c14). Text color varies by log level, but defaults to `Comet` (#a1a0ab)."
  }
]
