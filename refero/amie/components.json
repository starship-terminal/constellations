  {
    "html": "<style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap'); :root { --color-pure-canvas: #ffffff; --color-fog-surface: #fafafa; --color-ash-border: #cdcdcd; --color-stone-divider: #ebebeb; --color-graphite-body: #5c5c5c; --color-silver-muted: #a0a0a0; --color-ink-primary: #000000; --color-sky-action: #11a8ff; --color-amber-highlight: #fbefaf; --color-mint-active: #01ca45; --color-violet-tag: #a050ff; --font-inter: 'Inter', sans-serif; } </style><div style='font-family: var(--font-inter); background: var(--color-fog-surface); padding: 48px 40px; width: 600px; box-sizing: border-box;'><div style='display: flex; flex-direction: column; gap: 24px;'><div><span style='display: inline-block; font-family: var(--font-inter); font-size: 15px; font-weight: 600; color: var(--color-ink-primary); background: var(--color-stone-divider); border-radius: 9999px; padding: 6px 16px; margin-bottom: 16px;'>Within 47 seconds:</span><h2 style='font-family: var(--font-inter); font-size: 36px; font-weight: 700; color: var(--color-ink-primary); margin: 0; line-height: 1.1; letter-spacing: -0.8px;'>Share summary. Keep CRM updated. Plan action items. Schedule next meeting.</h2></div><div style='display: flex; gap: 12px; flex-wrap: wrap;'><div style='background: var(--color-pure-canvas); border-radius: 12px; box-shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px, rgba(0,0,0,0.06) 0px 3px 3px -1.5px; padding: 20px; flex: 1; min-width: 140px;'><div style='display: flex; align-items: center; gap: 8px; margin-bottom: 8px;'><div style='width: 8px; height: 8px; border-radius: 9999px; background: var(--color-mint-active);'></div><span style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.06em;'>AI Notes</span></div><p style='font-family: var(--font-inter); font-size: 32px; font-weight: 700; color: var(--color-ink-primary); margin: 0 0 4px 0; letter-spacing: -0.8px;'>66%</p><p style='font-family: var(--font-inter); font-size: 13px; color: var(--color-graphite-body); margin: 0; line-height: 1.5;'>user retention rate</p></div><div style='background: var(--color-pure-canvas); border-radius: 12px; box-shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px, rgba(0,0,0,0.06) 0px 3px 3px -1.5px; padding: 20px; flex: 1; min-width: 140px;'><div style='display: flex; align-items: center; gap: 8px; margin-bottom: 8px;'><div style='width: 8px; height: 8px; border-radius: 9999px; background: var(--color-sky-action);'></div><span style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.06em;'>AI Chat</span></div><p style='font-family: var(--font-inter); font-size: 32px; font-weight: 700; color: var(--color-ink-primary); margin: 0 0 4px 0; letter-spacing: -0.8px;'>92%</p><p style='font-family: var(--font-inter); font-size: 13px; color: var(--color-graphite-body); margin: 0; line-height: 1.5;'>user retention rate</p></div><div style='background: var(--color-pure-canvas); border-radius: 12px; box-shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px, rgba(0,0,0,0.06) 0px 3px 3px -1.5px; padding: 20px; flex: 1; min-width: 140px;'><div style='display: flex; align-items: center; gap: 8px; margin-bottom: 8px;'><div style='width: 8px; height: 8px; border-radius: 9999px; background: var(--color-violet-tag);'></div><span style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.06em;'>MRR Growth</span></div><p style='font-family: var(--font-inter); font-size: 32px; font-weight: 700; color: var(--color-ink-primary); margin: 0 0 4px 0; letter-spacing: -0.8px;'>18%</p><p style='font-family: var(--font-inter); font-size: 13px; color: var(--color-graphite-body); margin: 0; line-height: 1.5;'>month-over-month</p></div></div><div style='padding-top: 4px;'><button style='font-family: var(--font-inter); font-size: 14px; font-weight: 600; color: #ffffff; background: var(--color-sky-action); border: none; border-radius: 12px; padding: 12px 28px; cursor: pointer; display: inline-block;'>Get started</button></div></div></div>",
