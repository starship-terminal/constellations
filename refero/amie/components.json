  {
    "name": "Primary CTA Button",
    "role": "Main conversion actions \u2014 'Get started', 'Start free trial'",
    "description": "Background #11a8ff, white text (#ffffff), 12px radius, 12px top/bottom padding, 28px left/right padding. Font Inter weight 600, 14px. No border. On dark sections, same treatment. The only filled chromatic button in the system."
  },
  {
    "name": "Ghost Secondary Button",
    "role": "'Request a demo' and secondary actions paired beside primary CTA",
    "description": "Background #ffffff, text #5c5c5c, 12px radius, 12px/28px padding, 1px border #cdcdcd via shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px. Inter weight 500, 14px. Sits beside primary CTA to create a binary choice."
  },
  {
    "name": "Text / Nav Ghost Button",
    "role": "Navigation links and low-priority actions like 'Features', 'Pricing', 'Login'",
    "description": "Transparent background, text #000000 or #5c5c5c, no border radius (0px), 20px padding all sides. Inter weight 400\u2013500, 14px. Appears in nav bar and inline contexts."
  },
  {
    "name": "Small Outline Button",
    "role": "Compact in-UI actions within product preview areas",
    "description": "Transparent background, black text, 8px radius, 6px/10px padding. 1px border via #cdcdcd. Inter weight 500, 13px. Used inside the product screenshot cards."
  },
  {
    "name": "Feature Card (White)",
    "role": "Primary content cards showcasing product features",
    "description": "Background #ffffff, 12px radius, no explicit padding (content determines), shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px, rgba(0,0,0,0.06) 0px 3px 3px -1.5px. The hairline shadow perimeter acts as a 1px border."
  },
  {
    "name": "Feature Card (Off-White)",
    "role": "Secondary feature cards with subtle background differentiation",
    "description": "Background #fafafa, 12px radius, same 3-layer shadow as white card variant. Padding 0 \u2014 inner content uses its own spacing."
  },
  {
    "name": "Highlight Chip",
    "role": "Inline text emphasis tags like 'Within 47 seconds:' label",
    "description": "Background #ebebeb, 16px radius, 8px/16px padding, no shadow. Inter weight 600, 14\u201316px, text #000000. Used to isolate a key statistic or phrase visually."
  },
  {
    "name": "Category Tag (Pill)",
    "role": "Feature category labels \u2014 'Meeting Notes', 'Shareable Pages'",
    "description": "9999px radius (full pill), background transparent or tinted per category, 1px border in category accent color (#01ca45 for Meeting Notes, #a050ff for Shareable Pages). Inter weight 500, 13px."
  },
  {
    "name": "Inline Text Highlight",
    "role": "Hero headline word-level emphasis like 'without a bot'",
    "description": "Background #fbefaf (amber), applied as backgroundColor to a span within the heading. No border, no radius. Creates a single warm contrast moment in an otherwise cool monochrome headline."
  },
  {
    "name": "Navigation Bar",
    "role": "Top-fixed site navigation",
    "description": "Background #ffffff with backdrop-filter blur(16px) when scrolled. Height ~60px, max-width 1200px centered. Logo left, nav links center (Inter 14px weight 500, color #000000), 'Login' as text link, 'Get started' as sky-blue filled button (12px radius, #11a8ff) right-aligned. Border-bottom 1px #cdcdcd."
  },
  {
    "name": "Product Preview Card",
    "role": "Large screenshot/demo card in hero section",
    "description": "Background #ffffff, radius 12px 12px 0px 0px (top-rounded, bottom flush), no shadow on outer container. Contains a full-bleed UI screenshot. Width spans most of content column. Topped with a grayscale(1) filter-treated inner UI, then full-color on hover/active."
  },
  {
    "name": "Social Proof Logo Strip",
    "role": "'Trusted by teams at' company logos",
    "description": "Logos rendered at grayscale(1), horizontally scrolling via 'scrollX' animation (70s linear). No card container \u2014 logos sit directly on white page background. Inter caption 12px #5c5c5c for label text."
  }
]
