    "html": "<style>@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap'); :root { --color-pure-canvas: #ffffff; --color-fog-surface: #fafafa; --color-ash-border: #cdcdcd; --color-stone-divider: #ebebeb; --color-graphite-body: #5c5c5c; --color-silver-muted: #a0a0a0; --color-ink-primary: #000000; --color-sky-action: #11a8ff; --color-amber-highlight: #fbefaf; --color-mint-active: #01ca45; --color-violet-tag: #a050ff; --font-inter: 'Inter', sans-serif; --shadow-subtle-2: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px, rgba(0,0,0,0.06) 0px 3px 3px -1.5px; } </style><div style='font-family: var(--font-inter); background: var(--color-pure-canvas); padding: 48px 40px; width: 600px; box-sizing: border-box; display: flex; flex-direction: column; gap: 32px;'><div style='display: flex; flex-direction: column; gap: 12px;'><p style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;'>Primary Action</p><div style='display: flex; align-items: center; gap: 12px; flex-wrap: wrap;'><button style='font-family: var(--font-inter); font-size: 14px; font-weight: 600; color: #ffffff; background: var(--color-sky-action); border: none; border-radius: 12px; padding: 12px 28px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; line-height: 1;'>Get started</button><button style='font-family: var(--font-inter); font-size: 14px; font-weight: 500; color: var(--color-graphite-body); background: var(--color-pure-canvas); border: none; border-radius: 12px; padding: 12px 28px; cursor: pointer; box-shadow: rgba(0,0,0,0.06) 0px 0px 0px 1px, rgba(0,0,0,0.06) 0px 1px 1px -0.5px; display: inline-flex; align-items: center; gap: 8px; line-height: 1;'><svg width='16' height='16' viewBox='0 0 16 16' fill='none' xmlns='http://www.w3.org/2000/svg'><circle cx='8' cy='8' r='6.5' stroke='#a0a0a0' stroke-width='1.2'/><circle cx='8' cy='8' r='2' fill='#a0a0a0'/></svg>Request a demo</button></div></div><div style='width: 100%; height: 1px; background: var(--color-stone-divider);'></div><div style='display: flex; flex-direction: column; gap: 12px;'><p style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;'>Button States</p><div style='display: flex; align-items: center; gap: 12px; flex-wrap: wrap;'><button style='font-family: var(--font-inter); font-size: 14px; font-weight: 600; color: #ffffff; background: var(--color-sky-action); border: none; border-radius: 12px; padding: 12px 28px; cursor: pointer; line-height: 1; opacity: 1;'>Start free trial</button><button style='font-family: var(--font-inter); font-size: 14px; font-weight: 600; color: #ffffff; background: var(--color-sky-action); border: none; border-radius: 12px; padding: 12px 28px; cursor: pointer; line-height: 1; opacity: 0.5;'>Disabled</button></div></div><div style='width: 100%; height: 1px; background: var(--color-stone-divider);'></div><div style='display: flex; flex-direction: column; gap: 12px;'><p style='font-family: var(--font-inter); font-size: 12px; font-weight: 500; color: var(--color-silver-muted); text-transform: uppercase; letter-spacing: 0.08em; margin: 0;'>Category Tags</p><div style='display: flex; align-items: center; gap: 8px; flex-wrap: wrap;'><span style='font-family: var(--font-inter); font-size: 13px; font-weight: 500; color: var(--color-mint-active); background: transparent; border: 1px solid var(--color-mint-active); border-radius: 9999px; padding: 4px 12px; display: inline-block;'>Meeting Notes</span><span style='font-family: var(--font-inter); font-size: 13px; font-weight: 500; color: var(--color-violet-tag); background: transparent; border: 1px solid var(--color-violet-tag); border-radius: 9999px; padding: 4px 12px; display: inline-block;'>Shareable Pages</span><span style='font-family: var(--font-inter); font-size: 13px; font-weight: 500; color: var(--color-graphite-body); background: transparent; border: 1px solid var(--color-ash-border); border-radius: 9999px; padding: 4px 12px; display: inline-block;'>Action Items</span><span style='font-family: var(--font-inter); font-size: 13px; font-weight: 500; color: var(--color-sky-action); background: transparent; border: 1px solid var(--color-sky-action); border-radius: 9999px; padding: 4px 12px; display: inline-block;'>AI Summary</span></div></div></div>",
