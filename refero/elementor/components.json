    "html": "<div style=\"--color-press-black:#000000;--color-charcoal-ink:#212121;--color-blank-canvas:#ffffff;--color-fog-sheet:#f6f6f6;--color-ash-border:#d1d1d1;--color-slate-text:#a6a6a6;--color-steel-gray:#69727d;--font-roobert:'Cabinet Grotesk','Plus Jakarta Sans','Satoshi',sans-serif;box-sizing:border-box;width:600px;background:var(--color-blank-canvas);padding:56px 40px;font-family:var(--font-roobert);\"><p style=\"font-family:var(--font-roobert);font-size:14px;font-weight:500;color:var(--color-slate-text);letter-spacing:0.04em;text-transform:uppercase;margin:0 0 40px 0;text-align:center;\">By the numbers</p><div style=\"display:flex;justify-content:space-between;align-items:flex-start;gap:16px;\"><div style=\"display:flex;flex-direction:column;align-items:center;flex:1;\"><span style=\"font-family:var(--font-roobert);font-size:56px;font-weight:900;color:var(--color-press-black);line-height:1.1;letter-spacing:-0.02em;font-feature-settings:'ss14';\">21M+</span><span style=\"font-family:var(--font-roobert);font-size:16px;font-weight:400;color:var(--color-steel-gray);margin-top:8px;text-align:center;line-height:1.5;\">Websites built</span></div><div style=\"width:1px;background:var(--color-ash-border);align-self:stretch;margin:8px 0;\"></div><div style=\"display:flex;flex-direction:column;align-items:center;flex:1;\"><span style=\"font-family:var(--font-roobert);font-size:56px;font-weight:900;color:var(--color-press-black);line-height:1.1;letter-spacing:-0.02em;font-feature-settings:'ss14';\">10M+</span><span style=\"font-family:var(--font-roobert);font-size:16px;font-weight:400;color:var(--color-steel-gray);margin-top:8px;text-align:center;line-height:1.5;\">Active users</span></div><div style=\"width:1px;background:var(--color-ash-border);align-self:stretch;margin:8px 0;\"></div><div style=\"display:flex;flex-direction:column;align-items:center;flex:1;\"><span style=\"font-family:var(--font-roobert);font-size:56px;font-weight:900;color:var(--color-press-black);line-height:1.1;letter-spacing:-0.02em;font-feature-settings:'ss14';\">159</span><span style=\"font-family:var(--font-roobert);font-size:16px;font-weight:400;color:var(--color-steel-gray);margin-top:8px;text-align:center;line-height:1.5;\">Countries worldwide</span></div></div></div>",
