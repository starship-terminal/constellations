  {
    "html": "<div style=\"--color-press-black:#000000;--color-charcoal-ink:#212121;--color-blank-canvas:#ffffff;--color-fog-sheet:#f6f6f6;--color-ash-border:#d1d1d1;--color-slate-text:#a6a6a6;--color-steel-gray:#69727d;--font-roobert:'Cabinet Grotesk','Plus Jakarta Sans','Satoshi',sans-serif;box-sizing:border-box;width:600px;background:var(--color-press-black);padding:56px 32px;font-family:var(--font-roobert);\"><p style=\"font-family:var(--font-roobert);font-size:14px;font-weight:500;color:var(--color-slate-text);letter-spacing:0.04em;text-transform:uppercase;margin:0 0 12px 0;\">What you get</p><h2 style=\"font-family:var(--font-roobert);font-size:40px;font-weight:900;color:var(--color-blank-canvas);line-height:1.1;letter-spacing:-0.02em;font-feature-settings:'ss14';margin:0 0 40px 0;\">Build anything.<br>Fast.</h2><div style=\"display:flex;flex-direction:column;gap:16px;\"><div style=\"background:var(--color-blank-canvas);border-radius:16px;padding:40px 32px;\"><div style=\"width:40px;height:40px;background:var(--color-press-black);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"3\" y=\"3\" width=\"6\" height=\"6\" rx=\"1\" fill=\"white\"/><rect x=\"11\" y=\"3\" width=\"6\" height=\"6\" rx=\"1\" fill=\"white\"/><rect x=\"3\" y=\"11\" width=\"6\" height=\"6\" rx=\"1\" fill=\"white\"/><rect x=\"11\" y=\"11\" width=\"6\" height=\"6\" rx=\"1\" fill=\"white\"/></svg></div><h3 style=\"font-family:var(--font-roobert);font-size:24px;font-weight:600;color:var(--color-press-black);line-height:1.2;letter-spacing:-0.01em;font-feature-settings:'ss14';margin:0 0 12px 0;\">Drag & Drop Editor</h3><p style=\"font-family:var(--font-roobert);font-size:16px;font-weight:400;color:var(--color-charcoal-ink);line-height:1.5;margin:0 0 20px 0;\">Design visually without touching a line of code. Pixel-perfect precision with real-time preview on every device.</p><a href=\"#\" style=\"font-family:var(--font-roobert);font-size:16px;font-weight:500;color:var(--color-press-black);text-decoration:none;display:inline-flex;align-items:center;gap:6px;font-feature-settings:'ss14';\">Explore the editor<svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a></div><div style=\"display:flex;gap:16px;\"><div style=\"background:var(--color-blank-canvas);border-radius:16px;padding:32px 24px;flex:1;\"><div style=\"width:36px;height:36px;background:var(--color-press-black);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"10\" cy=\"10\" r=\"7\" stroke=\"white\" stroke-width=\"1.5\"/><path d=\"M10 6v4l3 2\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg></div><h3 style=\"font-family:var(--font-roobert);font-size:20px;font-weight:600;color:var(--color-press-black);line-height:1.2;letter-spacing:-0.01em;font-feature-settings:'ss14';margin:0 0 10px 0;\">100+ Widgets</h3><p style=\"font-family:var(--font-roobert);font-size:15px;font-weight:400;color:var(--color-charcoal-ink);line-height:1.5;margin:0;\">Every element you need, ready to drop in.</p></div><div style=\"background:var(--color-blank-canvas);border-radius:16px;padding:32px 24px;flex:1;\"><div style=\"width:36px;height:36px;background:var(--color-press-black);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 4h12v8a2 2 0 01-2 2H6a2 2 0 01-2-2V4z\" stroke=\"white\" stroke-width=\"1.5\"/><path d=\"M8 16h4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg></div><h3 style=\"font-family:var(--font-roobert);font-size:20px;font-weight:600;color:var(--color-press-black);line-height:1.2;letter-spacing:-0.01em;font-feature-settings:'ss14';margin:0 0 10px 0;\">Responsive Design</h3><p style=\"font-family:var(--font-roobert);font-size:15px;font-weight:400;color:var(--color-charcoal-ink);line-height:1.5;margin:0;\">Looks perfect on every screen size.</p></div></div></div></div>",
