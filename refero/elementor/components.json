    "html": "<div style=\"--color-press-black:#000000;--color-charcoal-ink:#212121;--color-blank-canvas:#ffffff;--color-fog-sheet:#f6f6f6;--color-ash-border:#d1d1d1;--color-slate-text:#a6a6a6;--color-steel-gray:#69727d;--font-roobert:'Cabinet Grotesk','Plus Jakarta Sans','Satoshi',sans-serif;box-sizing:border-box;width:600px;background:var(--color-fog-sheet);padding:48px 40px;font-family:var(--font-roobert);display:flex;flex-direction:column;gap:32px;\"><style>*{box-sizing:border-box;}</style><p style=\"font-family:var(--font-roobert);font-size:14px;font-weight:500;color:var(--color-slate-text);letter-spacing:0.04em;text-transform:uppercase;margin:0 0 8px 0;\">Button Variants</p><div style=\"display:flex;flex-wrap:wrap;align-items:center;gap:16px;\"><button style=\"font-family:var(--font-roobert);font-size:16px;font-weight:600;color:var(--color-blank-canvas);background:var(--color-press-black);border:none;border-radius:8px;padding:14px 24px;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';\">Get started</button><button style=\"font-family:var(--font-roobert);font-size:16px;font-weight:500;color:var(--color-press-black);background:var(--color-blank-canvas);border:1.5px solid var(--color-press-black);border-radius:8px;padding:14px 24px;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';\">Learn more</button><button style=\"font-family:var(--font-roobert);font-size:16px;font-weight:500;color:var(--color-press-black);background:transparent;border:none;border-radius:0;padding:0;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';display:inline-flex;align-items:center;gap:6px;\">How to start building a website<svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div><div style=\"border-top:1px solid var(--color-ash-border);padding-top:24px;display:flex;flex-wrap:wrap;gap:16px;\"><button style=\"font-family:var(--font-roobert);font-size:16px;font-weight:600;color:var(--color-blank-canvas);background:var(--color-press-black);border:none;border-radius:8px;padding:10px 20px;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';font-size:14px;\">Start for free</button><button style=\"font-family:var(--font-roobert);font-size:14px;font-weight:500;color:var(--color-press-black);background:var(--color-blank-canvas);border:1.5px solid var(--color-press-black);border-radius:8px;padding:10px 20px;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';\">View pricing</button><button style=\"font-family:var(--font-roobert);font-size:14px;font-weight:500;color:var(--color-press-black);background:transparent;border:none;border-radius:0;padding:0;cursor:pointer;letter-spacing:-0.01em;font-feature-settings:'ss14';display:inline-flex;align-items:center;gap:5px;\">See all features<svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M3 8h10M9 4l4 4-4 4\" stroke=\"#000000\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button></div></div>",
