[
  {
    "html": "<div style=\"--color-press-black:#231e15;--color-voltage-yellow:#ffe01b;--color-teal-ink:#004e56;--color-graphite:#706d67;--color-pure-white:#ffffff;--color-ash-white:#f5f5f5;--color-silver-rule:#bcbab6;--font-graphik-web:'Inter',sans-serif;--font-means-web:'Georgia',serif; background:var(--color-ash-white);padding:48px 40px;display:flex;flex-direction:column;gap:32px;align-items:flex-start;font-family:var(--font-graphik-web);\">\n  <p style=\"margin:0;font-family:var(--font-graphik-web);font-size:11px;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;color:var(--color-graphite);\">\n    Botones del sistema\n  </p>\n\n  <div style=\"display:flex;flex-wrap:wrap;gap:16px;align-items:center;\">\n\n    <!-- Primary Pill Yellow -->\n    <button style=\"\n      background:var(--color-voltage-yellow);\n      color:var(--color-press-black);\n      font-family:var(--font-graphik-web);\n      font-size:16px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border:none;\n      border-radius:26px;\n      padding:13px 28px;\n      box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n      cursor:pointer;\n      line-height:1.2;\n      white-space:nowrap;\n    \">Iniciar gratis</button>\n\n    <!-- Ghost Button -->\n    <button style=\"\n      background:transparent;\n      color:var(--color-press-black);\n      font-family:var(--font-graphik-web);\n      font-size:14px;\n      font-weight:400;\n      letter-spacing:-0.013em;\n      border:none;\n      border-radius:26px;\n      padding:13px 24px;\n      box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n      cursor:pointer;\n      line-height:1.2;\n      white-space:nowrap;\n    \">Inicia sesi\u00f3n</button>\n\n    <!-- Arrow Link CTA -->\n    <a href=\"#\" style=\"\n      display:inline-flex;\n      align-items:center;\n      gap:12px;\n      text-decoration:none;\n      color:var(--color-press-black);\n      font-family:var(--font-graphik-web);\n      font-size:16px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n    \">\n      <span>Aprende sobre el marketing por SMS</span>\n      <span style=\"\n        display:inline-flex;\n        align-items:center;\n        justify-content:center;\n        width:28px;\n        height:28px;\n        border-radius:50%;\n        background:var(--color-voltage-yellow);\n        box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n        flex-shrink:0;\n      \">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M2 6h8M6.5 2.5L10 6l-3.5 3.5\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </span>\n    </a>\n\n  </div>\n\n  <div style=\"width:100%;height:1px;background:var(--color-silver-rule);\"></div>\n\n  <!-- Dark background variants -->\n  <div style=\"background:var(--color-press-black);border-radius:10px;padding:32px 28px;display:flex;flex-wrap:wrap;gap:16px;align-items:center;width:100%;box-sizing:border-box;\">\n\n    <button style=\"\n      background:var(--color-voltage-yellow);\n      color:var(--color-press-black);\n      font-family:var(--font-graphik-web);\n      font-size:16px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border:none;\n      border-radius:26px;\n      padding:13px 28px;\n      box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n      cursor:pointer;\n      line-height:1.2;\n      white-space:nowrap;\n    \">Iniciar prueba gratis</button>\n\n    <a href=\"#\" style=\"\n      display:inline-flex;\n      align-items:center;\n      gap:12px;\n      text-decoration:none;\n      color:var(--color-pure-white);\n      font-family:var(--font-graphik-web);\n      font-size:16px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n    \">\n      <span>Descubre todos los planes</span>\n      <span style=\"\n        display:inline-flex;\n        align-items:center;\n        justify-content:center;\n        width:28px;\n        height:28px;\n        border-radius:50%;\n        background:var(--color-voltage-yellow);\n        box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n        flex-shrink:0;\n      \">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M2 6h8M6.5 2.5L10 6l-3.5 3.5\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </span>\n    </a>\n\n  </div>\n\n  <!-- Dark badge -->\n  <div style=\"display:flex;gap:12px;align-items:center;flex-wrap:wrap;\">\n    <span style=\"\n      background:var(--color-press-black);\n      color:var(--color-pure-white);\n      font-family:var(--font-graphik-web);\n      font-size:13px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border-radius:8px;\n      padding:5px 13px;\n      display:inline-block;\n    \">Prueba sin riesgo</span>\n    <span style=\"\n      background:var(--color-press-black);\n      color:var(--color-pure-white);\n      font-family:var(--font-graphik-web);\n      font-size:13px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border-radius:8px;\n      padding:5px 13px;\n      display:inline-block;\n    \">Ahorra un 15%</span>\n  </div>\n\n</div>",
    "name": "Primary CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-press-black:#231e15;--color-voltage-yellow:#ffe01b;--color-teal-ink:#004e56;--color-graphite:#706d67;--color-warm-charcoal:#403b3b;--color-pure-white:#ffffff;--color-ash-white:#f5f5f5;--color-silver-rule:#bcbab6;--color-true-black:#000000;--font-graphik-web:'Inter',sans-serif;--font-means-web:'Georgia',serif; background:var(--color-ash-white);padding:48px 32px;font-family:var(--font-graphik-web);\">\n\n  <div style=\"\n    background:var(--color-pure-white);\n    border-radius:0px;\n    box-shadow:rgba(35,30,21,0.15) 0px 0px 20px 3px;\n    padding:32px 28px;\n    max-width:420px;\n    margin:0 auto;\n    box-sizing:border-box;\n  \">\n\n    <!-- Plan name -->\n    <h2 style=\"\n      font-family:var(--font-means-web);\n      font-size:32px;\n      font-weight:300;\n      letter-spacing:-0.012em;\n      color:var(--color-press-black);\n      margin:0 0 8px 0;\n      line-height:1.2;\n    \">Standard</h2>\n\n    <p style=\"\n      font-family:var(--font-graphik-web);\n      font-size:14px;\n      font-weight:400;\n      letter-spacing:-0.013em;\n      color:var(--color-graphite);\n      margin:0 0 24px 0;\n      line-height:1.5;\n    \">Env\u00eda hasta 6.000 correos electr\u00f3nicos cada mes.</p>\n\n    <!-- Contact selector -->\n    <div style=\"\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      border:1px solid var(--color-silver-rule);\n      padding:12px 16px;\n      border-radius:0px;\n      margin-bottom:16px;\n      cursor:pointer;\n    \">\n      <span style=\"font-family:var(--font-graphik-web);font-size:14px;font-weight:400;letter-spacing:-0.013em;color:var(--color-graphite);\">Contactos</span>\n      <div style=\"display:flex;align-items:center;gap:10px;\">\n        <span style=\"font-family:var(--font-graphik-web);font-size:14px;font-weight:500;letter-spacing:-0.013em;color:var(--color-press-black);\">0\u2013500</span>\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n          <path d=\"M3 5l4 4 4-4\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </svg>\n      </div>\n    </div>\n\n    <!-- Radio option: Free trial -->\n    <div style=\"\n      border:1.5px solid var(--color-press-black);\n      padding:16px 16px;\n      border-radius:0px;\n      margin-bottom:12px;\n      display:flex;\n      align-items:flex-start;\n      gap:12px;\n    \">\n      <div style=\"\n        width:18px;\n        height:18px;\n        border-radius:50%;\n        border:2px solid var(--color-press-black);\n        display:flex;\n        align-items:center;\n        justify-content:center;\n        flex-shrink:0;\n        margin-top:2px;\n        background:var(--color-pure-white);\n      \">\n        <div style=\"width:10px;height:10px;border-radius:50%;background:var(--color-press-black);\"></div>\n      </div>\n      <div style=\"flex:1;\">\n        <p style=\"margin:0 0 4px 0;font-family:var(--font-graphik-web);font-size:13px;font-weight:400;letter-spacing:-0.013em;color:var(--color-graphite);\">Probar gratis</p>\n        <div style=\"display:flex;align-items:baseline;gap:8px;\">\n          <span style=\"\n            font-family:var(--font-means-web);\n            font-size:36px;\n            font-weight:300;\n            letter-spacing:-1.01px;\n            color:var(--color-press-black);\n            line-height:1.1;\n          \">Gratis</span>\n          <span style=\"font-family:var(--font-graphik-web);font-size:13px;color:var(--color-graphite);letter-spacing:-0.013em;\">por 14 d\u00edas</span>\n        </div>\n        <p style=\"margin:6px 0 0 0;font-family:var(--font-graphik-web);font-size:12px;color:var(--color-graphite);letter-spacing:-0.013em;\">Despu\u00e9s, comienza desde: <strong style=\"color:var(--color-press-black);\">\u20ac17.22/mes\u2020</strong></p>\n      </div>\n    </div>\n\n    <!-- Radio option: Annual discount -->\n    <div style=\"\n      border:1px solid var(--color-silver-rule);\n      padding:16px 16px;\n      border-radius:0px;\n      margin-bottom:24px;\n      display:flex;\n      align-items:center;\n      gap:12px;\n    \">\n      <div style=\"\n        width:18px;\n        height:18px;\n        border-radius:50%;\n        border:2px solid var(--color-silver-rule);\n        background:var(--color-pure-white);\n        flex-shrink:0;\n      \"></div>\n      <p style=\"margin:0;font-family:var(--font-graphik-web);font-size:14px;font-weight:400;letter-spacing:-0.013em;color:var(--color-press-black);\">\n        <strong>Ahorra un 15%</strong> en 10 000+ contactos \u00f3 m\u00e1s\n      </p>\n    </div>\n\n    <!-- CTA Button -->\n    <button style=\"\n      width:100%;\n      background:var(--color-voltage-yellow);\n      color:var(--color-press-black);\n      font-family:var(--font-graphik-web);\n      font-size:16px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border:none;\n      border-radius:26px;\n      padding:16px 24px;\n      box-shadow:rgb(35,30,21) 0px 0px 0px 1px;\n      cursor:pointer;\n      line-height:1.2;\n      margin-bottom:12px;\n    \">Iniciar prueba gratis</button>\n\n    <!-- Trust badge -->\n    <div style=\"\n      background:var(--color-press-black);\n      color:var(--color-pure-white);\n      font-family:var(--font-graphik-web);\n      font-size:13px;\n      font-weight:500;\n      letter-spacing:-0.013em;\n      border-radius:8px;\n      padding:10px 16px;\n      text-align:center;\n      margin-bottom:20px;\n    \">Sin riesgo \u00b7 No se requiere tarjeta de cr\u00e9dito</div>\n\n    <!-- Fine print -->\n    <p style=\"\n      font-family:var(--font-graphik-web);\n      font-size:12px;\n      font-weight:400;\n      letter-spacing:-0.013em;\n      color:var(--color-graphite);\n      margin:0;\n      line-height:1.5;\n    \">\n      \u2020Consulta los <a href=\"#\" style=\"color:var(--color-teal-ink);text-decoration:underline;\">T\u00e9rminos de la prueba gratuita</a>. Se aplican <a href=\"#\" style=\"color:var(--color-teal-ink);text-decoration:underline;\">cargos adicionales</a> si superas el l\u00edmite de contactos o de env\u00edos de correo electr\u00f3nico. <a href=\"#\" style=\"color:var(--color-teal-ink);text-decoration:underline;\">M\u00e1s informaci\u00f3n</a>.\n    </p>\n\n  </div>\n</div>",
    "name": "Pricing Tier Widget",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-press-black:#231e15;--color-voltage-yellow:#ffe01b;--color-teal-ink:#004e56;--color-graphite:#706d67;--color-pure-white:#ffffff;--color-ash-white:#f5f5f5;--font-graphik-web:'Inter',sans-serif;--font-means-web:'Georgia',serif; background:var(--color-press-black);padding:48px 32px;font-family:var(--font-graphik-web);\">\n\n  <div style=\"display:flex;flex-direction:column;gap:40px;max-width:560px;margin:0 auto;\">\n\n    <!-- Card 1 -->\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <!-- Image placeholder -->\n      <div style=\"width:100%;height:180px;background:#1a2e3b;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center;\">\n        <div style=\"background:#0f1f2a;border-radius:8px;padding:16px 24px;display:flex;flex-direction:column;gap:10px;width:200px;\">\n          <div style=\"background:rgba(255,255,255,0.9);border-radius:4px;padding:10px 14px;display:flex;align-items:center;gap:10px;\">\n            <div style=\"width:22px;height:22px;border-radius:50%;border:1.5px solid #231e15;display:flex;align-items:center;justify-content:center;\">\n              <div style=\"width:0;height:0;border-top:5px solid transparent;border-bottom:5px solid transparent;border-left:8px solid #231e15;margin-left:2px;\"></div>\n            </div>\n            <span style=\"font-family:var(--font-graphik-web);font-size:12px;color:#231e15;font-weight:400;\">El cliente se registra</span>\n          </div>\n          <div style=\"display:flex;justify-content:center;\">\n            <div style=\"width:1px;height:16px;background:rgba(255,255,255,0.3);\"></div>\n          </div>\n          <div style=\"background:rgba(255,255,255,0.9);border-radius:4px;padding:10px 14px;display:flex;align-items:center;gap:10px;\">\n            <div style=\"width:22px;height:22px;border-radius:3px;border:1.5px solid #231e15;display:flex;align-items:center;justify-content:center;\">\n              <svg width=\"11\" height=\"9\" viewBox=\"0 0 11 9\" fill=\"none\"><rect x=\"0.5\" y=\"0.5\" width=\"10\" height=\"8\" rx=\"1\" stroke=\"#231e15\" stroke-width=\"1\"/><path d=\"M0.5 3h10\" stroke=\"#231e15\" stroke-width=\"1\"/></svg>\n            </div>\n            <span style=\"font-family:var(--font-graphik-web);font-size:12px;color:#231e15;font-weight:400;\">Enviar correo de bienvenida</span>\n          </div>\n        </div>\n      </div>\n      <div>\n        <h3 style=\"font-family:var(--font-means-web);font-size:24px;font-weight:300;letter-spacing:-0.012em;color:var(--color-pure-white);margin:0 0 10px 0;line-height:1.25;\">Ahorre tiempo en tareas repetitivas</h3>\n        <p style=\"font-family:var(--font-graphik-web);font-size:16px;font-weight:400;letter-spacing:-0.013em;color:rgba(255,255,255,0.65);margin:0 0 20px 0;line-height:1.5;\">Usa automatizaciones siempre activas para ayudar a convertir a los visitantes en clientes y hacer que vuelvan.</p>\n        <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:var(--color-pure-white);font-family:var(--font-graphik-web);font-size:16px;font-weight:500;letter-spacing:-0.013em;\">\n          <span>Aprende sobre automatizaciones</span>\n          <span style=\"display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--color-voltage-yellow);box-shadow:rgb(35,30,21) 0px 0px 0px 1px;flex-shrink:0;\">\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2 6h8M6.5 2.5L10 6l-3.5 3.5\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </span>\n        </a>\n      </div>\n    </div>\n\n    <!-- Divider -->\n    <div style=\"width:100%;height:1px;background:rgba(255,255,255,0.1);\"></div>\n\n    <!-- Card 2 -->\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <!-- Image placeholder -->\n      <div style=\"width:100%;height:180px;background:#1c3d3b;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center;\">\n        <div style=\"background:rgba(255,255,255,0.95);border-radius:6px;padding:16px 20px;min-width:200px;\">\n          <div style=\"display:flex;justify-content:space-between;align-items:baseline;margin-bottom:6px;\">\n            <span style=\"font-family:var(--font-graphik-web);font-size:11px;color:#706d67;\">Abierto</span>\n            <span style=\"font-family:var(--font-graphik-web);font-size:28px;font-weight:500;color:#231e15;\">3,296</span>\n          </div>\n          <div style=\"width:100%;height:1px;background:#e0e0e0;margin-bottom:6px;\"></div>\n          <div style=\"display:flex;justify-content:space-between;align-items:baseline;\">\n            <span style=\"font-family:var(--font-graphik-web);font-size:11px;color:#706d67;\">Clics</span>\n            <span style=\"font-family:var(--font-graphik-web);font-size:28px;font-weight:500;color:#231e15;\">14.1%</span>\n          </div>\n        </div>\n      </div>\n      <div>\n        <h3 style=\"font-family:var(--font-means-web);font-size:24px;font-weight:300;letter-spacing:-0.012em;color:var(--color-pure-white);margin:0 0 10px 0;line-height:1.25;\">Descubre nuevas formas de impulsar las ventas</h3>\n        <p style=\"font-family:var(--font-graphik-web);font-size:16px;font-weight:400;letter-spacing:-0.013em;color:rgba(255,255,255,0.65);margin:0 0 20px 0;line-height:1.5;\">Usa herramientas impulsadas por IA para crear correos electr\u00f3nicos efectivos y espec\u00edficos que conviertan a los compradores potenciales en clientes.</p>\n        <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:var(--color-pure-white);font-family:var(--font-graphik-web);font-size:16px;font-weight:500;letter-spacing:-0.013em;\">\n          <span>Aprende sobre c\u00f3mo impulsar las ventas</span>\n          <span style=\"display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--color-voltage-yellow);box-shadow:rgb(35,30,21) 0px 0px 0px 1px;flex-shrink:0;\">\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2 6h8M6.5 2.5L10 6l-3.5 3.5\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </span>\n        </a>\n      </div>\n    </div>\n\n    <!-- Divider -->\n    <div style=\"width:100%;height:1px;background:rgba(255,255,255,0.1);\"></div>\n\n    <!-- Card 3 -->\n    <div style=\"display:flex;flex-direction:column;gap:16px;\">\n      <!-- Image placeholder -->\n      <div style=\"width:100%;height:180px;background:#2a2260;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center;position:relative;\">\n        <div style=\"background:rgba(255,255,255,0.97);border-radius:6px;padding:12px 16px;min-width:190px;\">\n          <div style=\"font-family:var(--font-graphik-web);font-size:12px;color:#706d67;margin-bottom:8px;\">Elige un objetivo</div>\n          <div style=\"display:flex;flex-direction:column;gap:2px;\">\n            <div style=\"padding:7px 10px;border-radius:3px;font-family:var(--font-graphik-web);font-size:12px;color:#231e15;\">Anunciar una venta</div>\n            <div style=\"padding:7px 10px;border-radius:3px;font-family:var(--font-graphik-web);font-size:12px;color:#231e15;\">Promocionar un evento</div>\n            <div style=\"padding:7px 10px;border-radius:3px;font-family:var(--font-graphik-web);font-size:12px;color:white;background:#006059;\">Vender un producto</div>\n            <div style=\"padding:7px 10px;border-radius:3px;font-family:var(--font-graphik-web);font-size:12px;color:#231e15;\">Otro</div>\n          </div>\n        </div>\n      </div>\n      <div>\n        <h3 style=\"font-family:var(--font-means-web);font-size:24px;font-weight:300;letter-spacing:-0.012em;color:var(--color-pure-white);margin:0 0 10px 0;line-height:1.25;\">Env\u00eda contenido de alta calidad con facilidad</h3>\n        <p style=\"font-family:var(--font-graphik-web);font-size:16px;font-weight:400;letter-spacing:-0.013em;color:rgba(255,255,255,0.65);margin:0 0 20px 0;line-height:1.5;\">Con nuestro creador tipo arrastrar y soltar, herramientas impulsadas por IA y m\u00e1s de 300 plantillas atractivas, dise\u00f1ar correos electr\u00f3nicos es muy sencillo.</p>\n        <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:12px;text-decoration:none;color:var(--color-pure-white);font-family:var(--font-graphik-web);font-size:16px;font-weight:500;letter-spacing:-0.013em;\">\n          <span>Consulta nuestras herramientas de creaci\u00f3n</span>\n          <span style=\"display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--color-voltage-yellow);box-shadow:rgb(35,30,21) 0px 0px 0px 1px;flex-shrink:0;\">\n            <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><path d=\"M2 6h8M6.5 2.5L10 6l-3.5 3.5\" stroke=\"#231e15\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          </span>\n        </a>\n      </div>\n    </div>\n\n  </div>\n</div>",
    "name": "Feature Cards (Dark Section)",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button (Pill Yellow)",
    "role": "Main conversion actions \u2014 'Iniciar gratis', 'Iniciar prueba gratis'",
    "description": "Background #ffe01b, text #231e15, border 1px solid #231e15 (via box-shadow rgb(35,30,21) 0 0 0 1px), border-radius 26px, padding 12px 24px. Graphik Web 500 at 16px. The yellow fill with dark border creates a physical 'printed label' impression \u2014 the stroke is what makes it feel tactile rather than digital."
  },
  {
    "name": "Ghost Navigation Button",
    "role": "Secondary actions like 'Inicia sesi\u00f3n', dropdown triggers",
    "description": "Background transparent, text #231e15, border 1px solid #231e15 (via box-shadow), border-radius 3px, padding 8px. Graphik Web 400 at 14px. The near-zero radius and transparent fill make these nearly invisible alongside the yellow CTA \u2014 intentional hierarchy."
  },
  {
    "name": "Arrow Link (Inline CTA)",
    "role": "Section-level 'learn more' navigation \u2014 'Aprende sobre el marketing por SMS \u2192'",
    "description": "Text color #231e15 or #ffffff on dark backgrounds. Graphik Web 500 at 16px. Paired with a circular yellow arrow badge (26px diameter, #ffe01b background, border-radius 32px). On hover, background hint rgba(255,224,27,0.65) appears under text \u2014 a yellow wash rather than underline."
  },
  {
