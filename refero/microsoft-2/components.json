  {
    "html": "<div style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; background: #ffffff; padding: 40px 32px; width: 600px; box-sizing: border-box;\">\n  <style>\n    .ms-btn-primary { display: inline-block; background: #0067b8; color: #ffffff; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 15px; font-weight: 400; padding: 10px 16px; text-decoration: none; border-radius: 2px; border: none; cursor: pointer; line-height: 1.5; }\n    .ms-btn-primary:hover { background: #004a7f; }\n    .ms-btn-ghost { display: inline-block; background: transparent; color: #171717; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 15px; font-weight: 400; padding: 9px 16px; text-decoration: none; border-radius: 0px; border: 1px solid #171717; cursor: pointer; line-height: 1.5; }\n    .ms-btn-ghost:hover { background: #f2f2f2; }\n    .ms-link { color: #0067b8; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 15px; font-weight: 400; text-decoration: none; }\n    .ms-link:hover { color: #004a7f; text-decoration: underline; }\n  </style>\n\n  <!-- Section title -->\n  <p style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; font-weight: 400; color: #616161; margin: 0 0 24px 0; text-transform: uppercase; letter-spacing: 0;\">Componentes de interfaz \u2014 Microsoft.com</p>\n\n  <!-- Amber badge -->\n  <div style=\"margin-bottom: 28px;\">\n    <p style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; color: #616161; margin: 0 0 10px 0;\">Badge promocional</p>\n    <div style=\"display: flex; gap: 8px; flex-wrap: wrap; align-items: center;\">\n      <span style=\"display: inline-block; background: #ffb900; color: #000000; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; font-weight: 400; padding: 2px 8px; border-radius: 0px;\">Nuevo</span>\n      <span style=\"display: inline-block; background: #ffb900; color: #000000; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; font-weight: 400; padding: 2px 8px; border-radius: 0px;\">Oferta especial</span>\n      <span style=\"display: inline-block; background: #ffb900; color: #000000; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; font-weight: 400; padding: 2px 8px; border-radius: 0px;\">Copilot+ PC</span>\n    </div>\n  </div>\n\n  <!-- Primary buttons -->\n  <div style=\"margin-bottom: 28px;\">\n    <p style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; color: #616161; margin: 0 0 10px 0;\">Bot\u00f3n principal (filled)</p>\n    <div style=\"display: flex; gap: 12px; flex-wrap: wrap;\">\n      <a href=\"#\" class=\"ms-btn-primary\">Comprar ahora</a>\n      <a href=\"#\" class=\"ms-btn-primary\">Descargar ahora</a>\n      <a href=\"#\" class=\"ms-btn-primary\">Unirte ahora</a>\n    </div>\n  </div>\n\n  <!-- Ghost buttons -->\n  <div style=\"margin-bottom: 28px;\">\n    <p style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; color: #616161; margin: 0 0 10px 0;\">Bot\u00f3n secundario (ghost outline)</p>\n    <div style=\"display: flex; gap: 12px; flex-wrap: wrap;\">\n      <a href=\"#\" class=\"ms-btn-ghost\">Obt\u00e9n m\u00e1s informaci\u00f3n</a>\n      <a href=\"#\" class=\"ms-btn-ghost\">Ver todos los productos</a>\n    </div>\n  </div>\n\n  <!-- Link style -->\n  <div>\n    <p style=\"font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif; font-size: 11px; color: #616161; margin: 0 0 10px 0;\">Enlace de texto</p>\n    <div style=\"display: flex; gap: 24px; flex-wrap: wrap;\">\n      <a href=\"#\" class=\"ms-link\">Comprar port\u00e1tiles Surface</a>\n      <a href=\"#\" class=\"ms-link\">Elige tu Microsoft 365</a>\n    </div>\n  </div>\n</div>",
