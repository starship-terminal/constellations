  {
    "name": "Primary Filled Button",
    "role": "Main CTA across hero and product cards",
    "description": "backgroundColor #0067b8, color #ffffff, borderRadius 2px, padding 10px 12px, no border (transparent). 11 instances sitewide. The 2px radius is the only rounding in the entire system \u2014 just enough to soften without becoming pill-shaped. Font: Segoe UI 15px/400."
  },
  {
    "name": "Ghost Outline Button",
    "role": "Secondary actions, alternative CTAs",
    "description": "backgroundColor transparent, color #171717, border 1px solid #171717, borderRadius 0px, padding 0px 16px. Sharp-cornered, text-height-only padding \u2014 visually lighter than filled but still rigid. Font: Segoe UI 15px/400."
  },
  {
    "name": "Transparent Card \u2014 Zero State",
    "role": "Layout containers, hero content panels, image-backed sections",
    "description": "backgroundColor transparent, borderRadius 0px, boxShadow none, padding 0px. Acts as invisible structural grouping \u2014 content floats within without visual box. Used 41 times as the dominant card pattern."
  },
  {
    "name": "Global Navigation Bar",
    "role": "Primary site navigation, persistent header",
    "description": "White background, height 54px, contains Microsoft logo (SVG multicolor), text nav links at 13px/400 #616161, and right-aligned utility icons (Search, Cart, Sign In). 68 interactive elements. Flat \u2014 no shadow, no border-bottom. Divides into product nav (left) and utility nav (right)."
  },
  {
    "name": "Category Icon Link",
    "role": "Quick-shop shortcut links below hero carousel",
    "description": "Outlined SVG icon at ~24px above a link label at 13px/400 #0067b8. Transparent background, no border, no card surface. 5 items in a horizontal row. Icon stroke style matches #616161; label uses brand blue to signal clickability."
  },
  {
    "name": "Hero Carousel Panel",
    "role": "Full-width promotional banner with auto-advancing slides",
    "description": "Full-bleed background image (dark blue for tech products, landscape photography for lifestyle), overlaid white card panel at left (transparent background, no radius, 48px padding) containing headline 37px/600, body 15px/400, and a primary CTA button. Carousel nav uses pagination dots + previous/next arrow buttons + pause control below the slide area."
  },
  {
    "name": "Amber Notification Badge",
    "role": "Promotional label or new-feature callout",
    "description": "backgroundColor #ffb900, color #000000, borderRadius 0px, padding 2px 8px. Font Segoe UI 11px/400. Used sparingly as the only warm-colored element in the achromatic system \u2014 creates immediate visual contrast on white or gray surfaces."
  },
  {
    "name": "Footer Multi-Column Nav",
    "role": "Site-level footer with category link columns",
    "description": "backgroundColor #f2f2f2, 6-column grid, column headers at 13px/600 #000000, links at 13px/400 #616161 hover #0067b8. No borders between columns, 16px row gap. Social follow icons in a horizontal strip above footer nav."
  },
  {
    "name": "Carousel Pagination Control",
    "role": "Navigation for hero and mid-page carousels",
    "description": "Row of filled/outlined dot indicators (filled = active, outlined = inactive), flanked by left/right arrow buttons and a pause button. Controls appear below the carousel band on a white background. Arrow and pause buttons use 0px radius, transparent background, #171717 border, padding 15px 9px\u201316px 20px."
  }
]
