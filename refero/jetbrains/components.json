[
  {
    "html": "<div style=\"--color-obsidian-ground:#000000;--color-deep-charcoal:#19191c;--color-graphite:#343434;--color-iron:#474749;--color-ash:#757577;--color-silver:#a3a3a4;--color-fog:#bababb;--color-pure-white:#ffffff;--color-electric-blue:#18a3fa;--color-violet-pulse:#7b61ff;--color-iris:#6b57ff;--color-neon-pink:#f31199;--color-magenta-glow:#5a1fd0;--color-deep-violet:#2e106a;--font-jetbrains-sans:'Inter',sans-serif; background:var(--color-obsidian-ground); padding:40px 24px; font-family:var(--font-jetbrains-sans); font-feature-settings:'calt','kern','liga'; box-sizing:border-box; width:600px;\">\n\n  <!-- Tab Row -->\n  <div style=\"display:flex;justify-content:center;gap:4px;margin-bottom:40px;\">\n    <button style=\"background:transparent;color:var(--color-fog);border:none;border-radius:20px;padding:8px 20px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;cursor:pointer;\">For developers</button>\n    <button style=\"background:transparent;color:var(--color-fog);border:none;border-radius:20px;padding:8px 20px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;cursor:pointer;\">For teams</button>\n    <button style=\"background:transparent;color:var(--color-pure-white);border:1px solid var(--color-violet-pulse);border-radius:20px;padding:8px 20px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;cursor:pointer;\">For businesses</button>\n  </div>\n\n  <!-- Category Label -->\n  <div style=\"margin-bottom:16px;display:flex;align-items:center;gap:8px;\">\n    <span style=\"color:var(--color-neon-pink);font-size:20px;font-weight:500;\">For</span>\n    <span style=\"display:inline-block;width:28px;height:28px;background:var(--color-neon-pink);border-radius:6px;\"></span>\n    <span style=\"color:var(--color-neon-pink);font-size:20px;font-weight:500;\">businesses</span>\n  </div>\n\n  <!-- Headline -->\n  <h2 style=\"color:var(--color-pure-white);font-size:43px;font-weight:600;line-height:1.14;letter-spacing:-0.043px;margin:0 0 32px 0;\">Empower your team<br>and succeed as a business</h2>\n\n  <!-- Business Feature Card -->\n  <div style=\"position:relative;background:linear-gradient(130deg,rgba(90,31,208,0.85) 10%,rgba(46,16,106,0.4) 55%,rgba(20,5,50,0.6) 100%);border-radius:24px;padding:40px 40px 40px 40px;overflow:hidden;\">\n    <!-- Abstract blob shapes -->\n    <div style=\"position:absolute;right:-40px;top:-30px;width:260px;height:260px;background:radial-gradient(circle at 40% 40%,#d43a6a 0%,#a0205a 40%,rgba(80,10,80,0) 75%);border-radius:50%;opacity:0.85;\"></div>\n    <div style=\"position:absolute;right:20px;bottom:-40px;width:200px;height:200px;background:radial-gradient(circle at 50% 50%,#8b1a8a 0%,rgba(60,10,100,0) 70%);border-radius:50%;opacity:0.7;\"></div>\n\n    <!-- Card content -->\n    <div style=\"position:relative;z-index:1;max-width:340px;\">\n      <h3 style=\"color:var(--color-pure-white);font-size:29px;font-weight:600;line-height:1.34;letter-spacing:-0.029px;margin:0 0 16px 0;\">Professional AI Coding.<br>Better Results.</h3>\n      <p style=\"color:var(--color-fog);font-size:16px;font-weight:400;line-height:1.5;letter-spacing:0.032px;margin:0 0 32px 0;\">Improve your developer team's productivity, satisfaction, and ROI with established AI-powered IDEs.</p>\n      <button style=\"background:var(--color-pure-white);color:#19191c;border:none;border-radius:26px;padding:12px 32px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:500;letter-spacing:0.032px;cursor:pointer;\">Explore Business Solutions</button>\n    </div>\n  </div>\n\n</div>",
    "name": "Audience Segmentation Tab Row + Business Feature Card",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-obsidian-ground:#000000;--color-deep-charcoal:#19191c;--color-fog:#bababb;--color-pure-white:#ffffff;--color-violet-pulse:#7b61ff;--color-magenta-glow:#5a1fd0;--color-iron:#474749;--color-iris:#6b57ff;--font-jetbrains-sans:'Inter',sans-serif; background:var(--color-obsidian-ground); padding:40px 24px; font-family:var(--font-jetbrains-sans); font-feature-settings:'calt','kern','liga'; box-sizing:border-box; width:600px;\">\n\n  <div style=\"position:relative;border:1px solid var(--color-magenta-glow);border-radius:24px;padding:40px 36px;overflow:hidden;background:rgba(10,5,25,0.6);\">\n\n    <!-- Abstract mesh background -->\n    <div style=\"position:absolute;right:-20px;top:0;bottom:0;width:55%;background:linear-gradient(135deg,rgba(90,31,208,0.15) 0%,rgba(180,30,200,0.25) 40%,rgba(240,50,100,0.2) 70%,rgba(100,20,180,0.1) 100%);z-index:0;\"></div>\n    <div style=\"position:absolute;right:30px;top:20px;width:220px;height:220px;background:conic-gradient(from 180deg at 50% 50%,rgba(120,30,220,0.4),rgba(220,30,150,0.5),rgba(30,100,240,0.3),rgba(120,30,220,0.4));border-radius:50%;filter:blur(2px);opacity:0.6;z-index:0;\"></div>\n    <!-- Grid lines suggestion -->\n    <div style=\"position:absolute;right:0;top:0;bottom:0;width:55%;background:repeating-linear-gradient(0deg,transparent,transparent 18px,rgba(180,80,240,0.12) 18px,rgba(180,80,240,0.12) 19px),repeating-linear-gradient(90deg,transparent,transparent 18px,rgba(180,80,240,0.12) 18px,rgba(180,80,240,0.12) 19px);z-index:1;\"></div>\n\n    <!-- Card content -->\n    <div style=\"position:relative;z-index:2;max-width:320px;\">\n\n      <!-- Title + Badge -->\n      <div style=\"display:flex;align-items:center;gap:12px;margin-bottom:20px;\">\n        <h2 style=\"color:var(--color-pure-white);font-size:29px;font-weight:600;line-height:1.34;letter-spacing:-0.029px;margin:0;\">JetBrains IDEs 2026.1</h2>\n        <span style=\"background:var(--color-iris);color:var(--color-pure-white);font-size:13px;font-weight:500;letter-spacing:0.065px;padding:2px 8px;border-radius:4px;white-space:nowrap;\">Now Live</span>\n      </div>\n\n      <!-- Description -->\n      <p style=\"color:var(--color-fog);font-size:16px;font-weight:400;line-height:1.5;letter-spacing:0.032px;margin:0 0 32px 0;\">An open agentic platform (Junie, Claude, and Codex built in; Cursor, GitHub Copilot, and more via the ACP Registry). Deeper code insight and analysis across IDEs.</p>\n\n      <!-- IDE Icon Grid Row 1 -->\n      <div style=\"display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap;\">\n\n        <!-- IntelliJ IDEA -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#ff8100,#e84393,#7c3aed);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">IntelliJ IDEA</span>\n        </div>\n\n        <!-- PhpStorm -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#b74af7,#7c3aed,#2563eb);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">PhpStorm</span>\n        </div>\n\n        <!-- RustRover -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#f97316,#ef4444,#7c3aed);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">RustRover</span>\n        </div>\n\n      </div>\n\n      <!-- IDE Icon Grid Row 2 -->\n      <div style=\"display:flex;align-items:center;gap:16px;margin-bottom:16px;flex-wrap:wrap;\">\n\n        <!-- DataGrip -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#06b6d4,#0ea5e9,#1e3a5f);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">DataGrip</span>\n        </div>\n\n        <!-- PyCharm -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#22c55e,#eab308,#16a34a);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">PyCharm</span>\n        </div>\n\n        <!-- WebStorm -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#06b6d4,#3b82f6,#1d4ed8);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">WebStorm</span>\n        </div>\n\n      </div>\n\n      <!-- IDE Icon Grid Row 3 -->\n      <div style=\"display:flex;align-items:center;gap:16px;flex-wrap:wrap;\">\n\n        <!-- GoLand -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#06b6d4,#8b5cf6,#1e40af);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">GoLand</span>\n        </div>\n\n        <!-- Rider -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#ef4444,#ec4899,#8b5cf6);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">Rider</span>\n        </div>\n\n        <!-- CLion -->\n        <div style=\"display:flex;align-items:center;gap:6px;\">\n          <div style=\"width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#06b6d4,#0891b2,#1c3a4a);flex-shrink:0;\"></div>\n          <span style=\"color:var(--color-pure-white);font-size:13px;font-weight:400;\">CLion</span>\n        </div>\n\n      </div>\n    </div>\n  </div>\n\n  <!-- Carousel Pagination -->\n  <div style=\"display:flex;align-items:center;justify-content:center;gap:16px;margin-top:24px;\">\n    <button style=\"background:transparent;border:1px solid var(--color-iron);border-radius:20px;padding:8px 12px;cursor:pointer;color:var(--color-fog);display:flex;align-items:center;justify-content:center;\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 12L6 8L10 4\" stroke=\"#bababb\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n    <span style=\"color:var(--color-fog);font-size:16px;font-weight:400;letter-spacing:0.032px;\">1 / 2</span>\n    <button style=\"background:transparent;border:1px solid var(--color-iron);border-radius:20px;padding:8px 12px;cursor:pointer;color:var(--color-fog);display:flex;align-items:center;justify-content:center;\">\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 4L10 8L6 12\" stroke=\"#bababb\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </button>\n  </div>\n\n</div>",
    "name": "Feature Announcement Card with IDE Grid",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-obsidian-ground:#000000;--color-deep-charcoal:#19191c;--color-pure-white:#ffffff;--color-electric-blue:#18a3fa;--color-violet-pulse:#7b61ff;--color-deep-violet:#2e106a;--color-fog:#bababb;--color-silver:#a3a3a4;--font-jetbrains-sans:'Inter',sans-serif; background:var(--color-obsidian-ground); padding:48px 32px; font-family:var(--font-jetbrains-sans); font-feature-settings:'calt','kern','liga'; box-sizing:border-box; width:600px;\">\n\n  <p style=\"color:var(--color-silver);font-size:13px;font-weight:500;letter-spacing:0.065px;text-transform:uppercase;margin:0 0 32px 0;\">Button Styles</p>\n\n  <!-- Primary White CTA -->\n  <div style=\"margin-bottom:32px;\">\n    <p style=\"color:var(--color-fog);font-size:13px;margin:0 0 10px 0;letter-spacing:0.065px;\">Primary \u2014 Hero CTA</p>\n    <div style=\"display:flex;gap:12px;align-items:center;\">\n      <button style=\"background:var(--color-pure-white);color:var(--color-deep-charcoal);border:none;border-radius:26px;padding:12px 32px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:500;letter-spacing:0.032px;cursor:pointer;\">Choose Your IDE</button>\n      <button style=\"background:transparent;color:var(--color-pure-white);border:1px solid var(--color-pure-white);border-radius:26px;padding:12px 32px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:500;letter-spacing:0.032px;cursor:pointer;\">For Business</button>\n    </div>\n    <p style=\"color:var(--color-silver);font-size:13px;margin:8px 0 0 0;letter-spacing:0.065px;\">Licenses for your organization</p>\n  </div>\n\n  <div style=\"height:1px;background:rgba(255,255,255,0.08);margin-bottom:32px;\"></div>\n\n  <!-- Violet Deep CTA -->\n  <div style=\"margin-bottom:32px;\">\n    <p style=\"color:var(--color-fog);font-size:13px;margin:0 0 10px 0;letter-spacing:0.065px;\">Violet Deep \u2014 Feature Card CTA</p>\n    <button style=\"background:var(--color-deep-violet);color:var(--color-electric-blue);border:1px solid var(--color-violet-pulse);border-radius:16px;padding:14px 24px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:500;letter-spacing:0.032px;cursor:pointer;\">Explore All IDEs</button>\n  </div>\n\n  <div style=\"height:1px;background:rgba(255,255,255,0.08);margin-bottom:32px;\"></div>\n\n  <!-- Violet Badge set -->\n  <div style=\"margin-bottom:32px;\">\n    <p style=\"color:var(--color-fog);font-size:13px;margin:0 0 12px 0;letter-spacing:0.065px;\">Status Badges</p>\n    <div style=\"display:flex;gap:8px;flex-wrap:wrap;align-items:center;\">\n      <span style=\"background:#6b57ff;color:#ffffff;font-size:13px;font-weight:500;letter-spacing:0.065px;padding:2px 8px;border-radius:4px;\">Now Live</span>\n      <span style=\"background:#6b57ff;color:#ffffff;font-size:13px;font-weight:500;letter-spacing:0.065px;padding:2px 8px;border-radius:4px;\">Featured</span>\n      <span style=\"background:rgba(107,87,255,0.5);color:#ffffff;font-size:13px;font-weight:500;letter-spacing:0.065px;padding:5px 11px;border-radius:6px 6px 0 0;\">2026.1</span>\n      <span style=\"background:rgba(243,17,180,0.2);color:#f31199;font-size:13px;font-weight:500;letter-spacing:0.065px;padding:2px 8px;border-radius:4px;\">Free for non-commercial use</span>\n    </div>\n  </div>\n\n  <div style=\"height:1px;background:rgba(255,255,255,0.08);margin-bottom:32px;\"></div>\n\n  <!-- Ghost borderless nav links -->\n  <div>\n    <p style=\"color:var(--color-fog);font-size:13px;margin:0 0 12px 0;letter-spacing:0.065px;\">Ghost Nav \u2014 Borderless</p>\n    <div style=\"display:flex;gap:4px;flex-wrap:wrap;\">\n      <a href=\"#\" style=\"color:var(--color-pure-white);background:transparent;border:none;border-radius:0;padding:4px 10px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;text-decoration:none;\">Products</a>\n      <a href=\"#\" style=\"color:var(--color-pure-white);background:transparent;border:none;border-radius:0;padding:4px 10px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;text-decoration:none;\">Education</a>\n      <a href=\"#\" style=\"color:var(--color-pure-white);background:transparent;border:none;border-radius:0;padding:4px 10px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;text-decoration:none;\">Solutions</a>\n      <a href=\"#\" style=\"color:var(--color-pure-white);background:transparent;border:none;border-radius:0;padding:4px 10px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;text-decoration:none;\">Support</a>\n      <a href=\"#\" style=\"color:var(--color-pure-white);background:transparent;border:none;border-radius:0;padding:4px 10px;font-family:var(--font-jetbrains-sans);font-size:16px;font-weight:400;letter-spacing:0.032px;text-decoration:none;\">Store</a>\n    </div>\n  </div>\n\n</div>",
    "name": "Button Group \u2014 Primary, Violet Deep, and Ghost",
    "role": "",
    "description": ""
  },
  {
    "name": "Hero CTA Button \u2014 Primary Dark",
    "role": "Main call-to-action on hero sections",
    "description": "White fill (#ffffff), #19191c text, 26px border-radius (pill), 12px top/bottom padding, 32px left/right padding. JetBrains Sans 16px weight 500. Used for 'Choose Your IDE' \u2014 solid white stands out starkly against the dark gradient hero."
  },
  {
    "name": "CTA Button \u2014 Violet Deep",
    "role": "Secondary prominent CTA on feature cards",
    "description": "Background #2e106a (Deep Violet), text #18a3fa (Electric Blue), border #7b61ff (Violet Pulse) 1px, 16px border-radius, 24px padding all sides. The neon-blue text on deep-violet background creates an illuminated button that reads like an active screen element inside the IDE itself."
  },
  {
    "name": "Ghost Button \u2014 White Outlined",
    "role": "Navigation links, secondary actions with text context",
    "description": "Background transparent, #ffffff text, 1px #ffffff border, 20px border-radius, 8px padding all sides. Used in nav contexts and as paired secondary to primary CTAs."
  },
  {
    "name": "Ghost Link Button \u2014 Borderless",
    "role": "Nav bar top-level items, inline text actions",
    "description": "Background transparent, #ffffff text, no border (0px radius, 0px top/bottom padding, 10px left/right padding). Pure text with horizontal padding only \u2014 becomes a tab-style navigation element."
  },
  {
    "name": "Feature Announcement Card",
    "role": "Hero carousel cards for product announcements like 'JetBrains IDEs 2026.1'",
    "description": "Background transparent with 1px border #5a1fd0 (Magenta Glow / vivid violet), 24px radius, internal padding 24-64px. Contains product name at 29-35px weight 600, body at 16px #bababb, IDE icon grid at 32px, and a 3D/abstract gradient visual asset on the right half. The violet border glows against black."
  },
  {
    "name": "Business Feature Card",
    "role": "Gradient content card for audience-segmented sections",
    "description": "Background linear-gradient(130deg, rgb(90,31,208) 10%, rgba(46,16,106,0) 70%) overlaid with organic blob shapes in deep red/purple, 24px radius, 64px padding. White headlines at 35-43px weight 600, #bababb body at 16px, white ghost pill button (26px radius, 32px horizontal padding). The gradient gives the impression of colored light bleeding from within."
  },
  {
    "name": "Pink Tinted Feature Card",
    "role": "Highlight cards for specific product moments",
    "description": "Background rgba(243,17,180,0.2) (20% opacity Neon Pink), 24px radius, 23px padding. The translucent magenta tint reads as a glowing selection highlight against the dark ground."
  },
  {
    "name": "Violet Badge \u2014 Filled",
    "role": "Status labels like 'Now Live', 'Featured', 'Free for non-commercial use'",
    "description": "Background #6b57ff (Iris), #ffffff text, 4px radius, 1px top/bottom padding, 7px left/right padding, JetBrains Sans 13px weight 500. Sharp-cornered relative to other components \u2014 badges are the most rectangular element in the system."
  },
  {
    "name": "Violet Badge \u2014 Tab Style",
    "role": "Contextual tab labels attached to card tops",
    "description": "Background rgba(107,87,255,0.5) (50% opacity Violet Pulse), #ffffff text, border-radius 6px 6px 0px 0px (top-rounded only), 5px top/bottom padding, 11px left/right padding. The flat bottom connects visually to the card it labels."
  },
  {
    "name": "IDE Product Icon Badge",
    "role": "Per-product identity marks in product grids and navigation",
    "description": "32px square icons with each IDE's distinct multicolor gradient fill (no single token \u2014 each product has unique chromatic identity: IntelliJ IDEA uses orange/red/purple, PyCharm uses green/yellow, DataGrip uses teal/dark). Displayed on 16px radius containers. These are the primary chromatic diversity element of the system \u2014 the only place vivid orange (#ff8100), vivid green (#00d886), vivid yellow (#f0eb18) appear."
  },
  {
    "name": "Navigation Bar",
    "role": "Top-level site navigation, always visible",
    "description": "Full-width, 72px height, background #19191c (Deep Charcoal). JetBrains logo mark (multicolor cube icon) + 'JETBRAINS' wordmark in #ffffff weight 500 at 16px, left-aligned. Nav items (#ffffff, no border, 10px horizontal padding) centered. Utility icons (search, account, cart, language) right-aligned in #a3a3a4 at 20px. No border-bottom \u2014 the header floats above the hero gradient."
  },
  {
    "name": "Carousel Pagination Control",
    "role": "Slide navigation for announcement cards",
    "description": "Left/right arrow buttons with transparent background, 1px #474749 border, 20px radius, 8px padding. Counter text '1 / 2' in #bababb at 16px between arrows. Sits below card carousels, horizontally centered."
  },
  {
    "name": "Audience Segmentation Tab Row",
    "role": "Segment switcher for 'For developers / For teams / For businesses'",
    "description": "Horizontal pill-group container with transparent background, each segment as a ghost button (20px radius). Active segment uses 1px #7b61ff border, #ffffff text. Inactive segments have no border, #bababb text. The group appears as a floating pill selector centered in the content area."
  }
]
