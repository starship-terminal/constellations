[
  {
    "html": "<style>\n  :root {\n    --color-ink-black: #0d0d0d;\n    --color-pure-white: #ffffff;\n    --color-mist: #f3f3f3;\n    --font-twk-lausanne: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .btn-group-wrapper {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    padding: 48px 24px;\n    background: var(--color-pure-white);\n    font-family: var(--font-twk-lausanne);\n  }\n\n  .btn-primary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--color-ink-black);\n    color: var(--color-pure-white);\n    font-family: var(--font-twk-lausanne);\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.5;\n    letter-spacing: 0;\n    padding: 16px 32px;\n    border-radius: 100px;\n    border: none;\n    cursor: pointer;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: opacity 0.15s ease;\n  }\n\n  .btn-primary:hover {\n    opacity: 0.88;\n  }\n\n  .btn-secondary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--color-mist);\n    color: var(--color-ink-black);\n    font-family: var(--font-twk-lausanne);\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.5;\n    letter-spacing: 0;\n    padding: 16px 32px;\n    border-radius: 146px;\n    border: 1px solid var(--color-ink-black);\n    cursor: pointer;\n    text-decoration: none;\n    white-space: nowrap;\n    transition: background 0.15s ease;\n  }\n\n  .btn-secondary:hover {\n    background: #e8e8e8;\n  }\n</style>\n\n<div class=\"btn-group-wrapper\">\n  <a href=\"#\" class=\"btn-primary\">Get started</a>\n  <a href=\"#\" class=\"btn-secondary\">View demo</a>\n</div>",
    "name": "CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-ink-black: #0d0d0d;\n    --color-pure-white: #ffffff;\n    --color-mist: #f3f3f3;\n    --color-coral-blush: #ffeaec;\n    --color-deep-coral: #690031;\n    --font-twk-lausanne: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .filter-section {\n    background: var(--color-pure-white);\n    padding: 48px 32px;\n    font-family: var(--font-twk-lausanne);\n  }\n\n  .filter-label {\n    font-family: var(--font-twk-lausanne);\n    font-size: 13px;\n    font-weight: 400;\n    color: #9ca6af;\n    letter-spacing: 0.04em;\n    text-transform: uppercase;\n    margin-bottom: 16px;\n  }\n\n  .filter-chips {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n    align-items: center;\n  }\n\n  .chip {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-twk-lausanne);\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1.3;\n    padding: 10px 22px;\n    border-radius: 999px;\n    cursor: pointer;\n    border: none;\n    text-decoration: none;\n    transition: background 0.15s ease, color 0.15s ease;\n    white-space: nowrap;\n  }\n\n  .chip-active {\n    background: var(--color-coral-blush);\n    color: var(--color-deep-coral);\n  }\n\n  .chip-inactive {\n    background: var(--color-mist);\n    color: var(--color-ink-black);\n  }\n\n  .chip-inactive:hover {\n    background: #e8e8e8;\n  }\n\n  .filter-content-hint {\n    margin-top: 32px;\n    padding: 24px;\n    background: #f9f9f9;\n    border-radius: 14px;\n    border: 1px solid #e7e7e7;\n  }\n\n  .hint-headline {\n    font-family: var(--font-twk-lausanne);\n    font-size: 22px;\n    font-weight: 500;\n    color: var(--color-ink-black);\n    margin: 0 0 8px 0;\n    line-height: 1.2;\n  }\n\n  .hint-body {\n    font-family: var(--font-twk-lausanne);\n    font-size: 15px;\n    font-weight: 300;\n    color: #3d3d3d;\n    margin: 0;\n    line-height: 1.6;\n  }\n</style>\n\n<div class=\"filter-section\">\n  <div class=\"filter-chips\">\n    <span class=\"chip chip-active\">Marketing</span>\n    <span class=\"chip chip-inactive\">Operations</span>\n    <span class=\"chip chip-inactive\">IT</span>\n    <span class=\"chip chip-inactive\">Leadership</span>\n  </div>\n  <div class=\"filter-content-hint\">\n    <p class=\"hint-headline\">Maximize campaign ROI</p>\n    <p class=\"hint-body\">Plan, track, and complete your campaigns all in one place \u2014 with AI that understands your team's goals and keeps every project moving forward.</p>\n  </div>\n</div>",
    "name": "Filter Chip Tab Bar",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-ink-black: #0d0d0d;\n    --color-pure-white: #ffffff;\n    --color-cloud: #e7e7e7;\n    --color-mist: #f3f3f3;\n    --color-charcoal: #3d3d3d;\n    --color-coral-ember: #ff584a;\n    --color-coral-petal: #e1bbc7;\n    --font-twk-lausanne: 'Inter', 'DM Sans', sans-serif;\n  }\n\n  .cards-section {\n    background: var(--color-pure-white);\n    padding: 40px 24px;\n    font-family: var(--font-twk-lausanne);\n  }\n\n  .cards-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 12px;\n  }\n\n  .feature-card {\n    background: var(--color-pure-white);\n    border: 1px solid var(--color-cloud);\n    border-radius: 14px;\n    padding: 24px;\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n    position: relative;\n    transition: border-color 0.15s ease;\n  }\n\n  .feature-card:hover {\n    border-color: #c8c8c8;\n  }\n\n  .card-icon {\n    width: 64px;\n    height: 64px;\n    margin-bottom: 20px;\n    flex-shrink: 0;\n  }\n\n  .card-title {\n    font-family: var(--font-twk-lausanne);\n    font-size: 18px;\n    font-weight: 500;\n    color: var(--color-ink-black);\n    line-height: 1.25;\n    margin: 0 0 10px 0;\n  }\n\n  .card-body {\n    font-family: var(--font-twk-lausanne);\n    font-size: 14px;\n    font-weight: 300;\n    color: var(--color-charcoal);\n    line-height: 1.6;\n    margin: 0 0 24px 0;\n    flex: 1;\n  }\n\n  .card-link {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-family: var(--font-twk-lausanne);\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--color-ink-black);\n    text-decoration: none;\n    margin-top: auto;\n  }\n\n  .card-link:hover .arrow-circle {\n    background: #333;\n  }\n\n  .arrow-circle {\n    width: 32px;\n    height: 32px;\n    border-radius: 100px;\n    background: var(--color-ink-black);\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    transition: background 0.15s ease;\n  }\n\n  .arrow-circle svg {\n    width: 14px;\n    height: 14px;\n  }\n</style>\n\n<div class=\"cards-section\">\n  <div class=\"cards-grid\">\n\n    <div class=\"feature-card\">\n      <svg class=\"card-icon\" viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"8\" y=\"20\" width=\"22\" height=\"28\" rx=\"3\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" fill=\"#ffeaec\"/>\n        <rect x=\"14\" y=\"28\" width=\"10\" height=\"12\" rx=\"1.5\" fill=\"#ff584a\" opacity=\"0.7\"/>\n        <rect x=\"32\" y=\"14\" width=\"22\" height=\"34\" rx=\"3\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" fill=\"#ffeaec\"/>\n        <rect x=\"37\" y=\"22\" width=\"7\" height=\"18\" rx=\"1.5\" fill=\"#ff584a\" opacity=\"0.5\"/>\n        <rect x=\"46\" y=\"30\" width=\"4\" height=\"10\" rx=\"1\" fill=\"#ff584a\"/>\n        <path d=\"M8 46 L20 34 L28 40 L38 28 L56 20\" stroke=\"#ff584a\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" fill=\"none\"/>\n      </svg>\n      <h3 class=\"card-title\">Campaign management</h3>\n      <p class=\"card-body\">Plan, track, and complete your campaigns all in one place.</p>\n      <a href=\"#\" class=\"card-link\">\n        See campaign management\n        <span class=\"arrow-circle\">\n          <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3 7h8M7.5 3.5L11 7l-3.5 3.5\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n\n    <div class=\"feature-card\">\n      <svg class=\"card-icon\" viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"18\" y=\"10\" width=\"28\" height=\"36\" rx=\"3\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" fill=\"#ffeaec\"/>\n        <line x1=\"18\" y1=\"20\" x2=\"46\" y2=\"20\" stroke=\"#e1bbc7\" stroke-width=\"1.5\"/>\n        <path d=\"M32 10 L32 6\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <path d=\"M26 6 L38 6\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" stroke-linecap=\"round\"/>\n        <rect x=\"24\" y=\"28\" width=\"6\" height=\"8\" rx=\"1\" fill=\"#ff584a\" opacity=\"0.8\"/>\n        <rect x=\"34\" y=\"24\" width=\"6\" height=\"12\" rx=\"1\" fill=\"#ff584a\"/>\n        <path d=\"M22 48 Q32 38 42 48\" stroke=\"#ff584a\" stroke-width=\"1.5\" fill=\"none\" stroke-linecap=\"round\"/>\n      </svg>\n      <h3 class=\"card-title\">Creative production</h3>\n      <p class=\"card-body\">Accelerate creative work by automating workflows from start to finish.</p>\n      <a href=\"#\" class=\"card-link\">\n        See creative production\n        <span class=\"arrow-circle\">\n          <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3 7h8M7.5 3.5L11 7l-3.5 3.5\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n\n    <div class=\"feature-card\">\n      <svg class=\"card-icon\" viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"10\" y=\"14\" width=\"44\" height=\"32\" rx=\"4\" stroke=\"#e1bbc7\" stroke-width=\"1.5\" fill=\"#ffeaec\"/>\n        <rect x=\"18\" y=\"26\" width=\"6\" height=\"12\" rx=\"1.5\" fill=\"#ff584a\"/>\n        <rect x=\"29\" y=\"20\" width=\"6\" height=\"18\" rx=\"1.5\" fill=\"#ff584a\" opacity=\"0.7\"/>\n        <rect x=\"40\" y=\"30\" width=\"6\" height=\"8\" rx=\"1.5\" fill=\"#ff584a\" opacity=\"0.5\"/>\n        <circle cx=\"18\" cy=\"18\" r=\"3\" fill=\"#ffeaec\" stroke=\"#e1bbc7\" stroke-width=\"1.2\"/>\n        <circle cx=\"32\" cy=\"12\" r=\"3\" fill=\"#ffeaec\" stroke=\"#ff584a\" stroke-width=\"1.2\"/>\n        <circle cx=\"46\" cy=\"16\" r=\"3\" fill=\"#ffeaec\" stroke=\"#e1bbc7\" stroke-width=\"1.2\"/>\n        <path d=\"M18 18 L32 12 L46 16\" stroke=\"#e1bbc7\" stroke-width=\"1\" stroke-dasharray=\"2 2\"/>\n      </svg>\n      <h3 class=\"card-title\">Project intake</h3>\n      <p class=\"card-body\">Capture, prioritize, and assign requests automatically so your teams have more time to work.</p>\n      <a href=\"#\" class=\"card-link\">\n        See project intake\n        <span class=\"arrow-circle\">\n          <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3 7h8M7.5 3.5L11 7l-3.5 3.5\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n\n    <div class=\"feature-card\">\n      <svg class=\"card-icon\" viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <path d=\"M32 8 L36 18 L46 18 L38 24 L41 34 L32 28 L23 34 L26 24 L18 18 L28 18 Z\" stroke=\"#e1bbc7\" stroke-width=\"1.2\" fill=\"#ffeaec\"/>\n        <ellipse cx=\"32\" cy=\"48\" rx=\"12\" ry=\"4\" fill=\"#ffeaec\" stroke=\"#e1bbc7\" stroke-width=\"1.2\"/>\n        <path d=\"M26 44 Q20 36 24 26\" stroke=\"#e1bbc7\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M38 44 Q44 36 40 26\" stroke=\"#e1bbc7\" stroke-width=\"1.2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <rect x=\"28\" y=\"46\" width=\"8\" height=\"6\" rx=\"1\" fill=\"#ff584a\" opacity=\"0.7\"/>\n      </svg>\n      <h3 class=\"card-title\">Product launches</h3>\n      <p class=\"card-body\">Coordinate teams, tasks, and timelines to keep every launch on schedule.</p>\n      <a href=\"#\" class=\"card-link\">\n        See product launches\n        <span class=\"arrow-circle\">\n          <svg viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M3 7h8M7.5 3.5L11 7l-3.5 3.5\" stroke=\"#ffffff\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n        </span>\n      </a>\n    </div>\n\n  </div>\n</div>",
    "name": "Use Case Feature Cards",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Button (Pill)",
    "role": "Main calls to action: 'Get started', primary conversion points",
    "description": "Background #0d0d0d, text #ffffff, border-radius 100px, padding 16px 32px. TWK Lausanne weight 500 at 16px. No border. The extreme pill radius against square card containers is the site's primary tension \u2014 the softness of the button against the geometry of surrounding content."
  },
  {
    "name": "Secondary Outline Button (Pill)",
    "role": "Secondary actions: 'View demo', alternate CTAs alongside primary",
    "description": "Background #f3f3f3, text #0d0d0d, border 1px solid #0d0d0d, border-radius 146px, padding 16px 32px. Matches primary pill shape but inverted surface \u2014 light fill with a defined border. Near-identical radius to primary (146px vs 100px) keeps the two visually paired."
  },
  {
    "name": "Ghost Nav Button",
    "role": "Navigation dropdown triggers and tertiary utility actions",
    "description": "Background transparent, text #6e6e6, border-color #6e6e6 (1px), border-radius 3px, padding 0 12px. No vertical padding. TWK Lausanne weight 400 at 14px. The 3px radius is the sharpest shape on the site \u2014 nav triggers are deliberately not pill-shaped to distinguish them from CTAs."
  },
  {
    "name": "Filter Chip (Active)",
    "role": "Active category filter in tabbed product sections: 'Marketing', 'Operations', etc.",
    "description": "Background #ffeaec, text #690031, border-radius 999px, padding 8-12px horizontal. Active state surfaces the coral brand family \u2014 warm against the white section background. Inactive sibling chips use #f3f3f3 background with #0d0d0d text."
  },
  {
    "name": "Product UI Screenshot Card",
    "role": "Hero and section feature showcases \u2014 framed product app screenshots",
    "description": "Background #222875 (Asana Violet), border-radius 16px, contains a rounded inner app window (radius 10px, white background) dropped inside the colored frame. The violet container makes the white app UI float as if lit from within. Used at large scale in the hero section (full-width up to 760px tall)."
  },
  {
    "name": "Logo Bar / Social Proof Strip",
    "role": "Fortune 100 trust signal section with partner logos",
    "description": "White background, no border, no shadow. Logos displayed in grayscale at medium opacity, horizontally spaced at 32-48px columnGap. Stat text ('85% of Fortune 100') at TWK Lausanne weight 500, 30px, #0d0d0d. Logos: Amazon, Accenture, Johnson & Johnson, Dell, Merck \u2014 all rendered in flat black/gray."
  },
  {
    "name": "Arrow Circle Icon Button",
    "role": "Carousel navigation and card-level CTA links",
    "description": "Circular button 40px diameter, background #0d0d0d (active) or #e7e7e7 (inactive), icon #ffffff or #0d0d0d respectively, border-radius 100px. Appears both as standalone navigation controls (carousel prev/next) and as inline link embellishments at the base of feature cards."
  },
  {
    "name": "Sticky Navigation Bar",
    "role": "Global top navigation, persistent on scroll",
    "description": "Background #ffffff, bottom border 1px solid #e7e7e7, height 56px. Logo left-aligned. Nav items (Ghost button style, transparent, #6e6e6e) center-grouped. Right side: 'Contact sales' text link (#0d0d0d), 'Log in' text link, 'Get started' primary pill button (#0d0d0d fill). TWK Lausanne 14px weight 400 for all nav text."
  },
  {
    "name": "Section Heading Block",
    "role": "Large section titles introducing content clusters",
    "description": "Ghost font weight 500, 60px, lineHeight 1.00, letter-spacing -0.42px, color #0d0d0d. Left-aligned on content sections, centered on hero. Subhead in TWK Lausanne weight 300, 20px, color #3d3d3d, max-width ~560px. Vertical gap between heading and subhead: 16-24px."
  },
  {
    "name": "Informational Tint Chip",
    "role": "Small inline labels and tag badges with semantic color tints",
    "description": "Background #cbefff (blue tint) or #ffeaec (coral tint), text #222875 or #690031 respectively, border-radius 999px, padding 4px 12px, TWK Lausanne weight 500 at 12px with letter-spacing +0.03em. Used to label feature categories inside product UI screenshots and callout blocks."
  }
]
