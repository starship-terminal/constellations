    "html": "<style>\n  :root {\n    --color-lego-yellow: #FFD502;\n    --color-brick-orange: #F47D20;\n    --color-ember-dark: #E96F14;\n    --color-lego-navy: #201D48;\n    --color-link-blue: #006DB7;\n    --color-action-blue: #005AD2;\n    --color-flag-red: #D0021B;\n    --color-off-black: #141414;\n    --color-graphite: #2C2C2C;\n    --color-pitch: #000000;\n    --color-snow: #FFFFFF;\n    --color-fog: #F2F2F2;\n    --color-pebble: #F6F6F6;\n    --color-steel: #757575;\n    --color-silver: #E0E0E0;\n    --font-cera-pro: 'Nunito', 'Poppins', sans-serif;\n    --shadow-sm: rgba(0,0,0,0.54) 0px 2px 4px 0px;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  body { background: var(--color-pebble); }\n  .card-grid {\n    display: flex;\n    gap: 16px;\n    padding: 32px 24px;\n    background: var(--color-pebble);\n    font-family: var(--font-cera-pro);\n    justify-content: center;\n    flex-wrap: wrap;\n  }\n  .card {\n    background: var(--color-snow);\n    border-radius: 8px;\n    width: 172px;\n    flex-shrink: 0;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n  .card-image-wrap {\n    position: relative;\n    width: 100%;\n    height: 160px;\n    background: var(--color-fog);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .card-badge {\n    position: absolute;\n    top: 0;\n    right: 0;\n    background: var(--color-lego-yellow);\n    color: var(--color-off-black);\n    font-family: var(--font-cera-pro);\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 0.01em;\n    padding: 4px 12px;\n    border-radius: 0;\n    line-height: 1.4;\n  }\n  .card-img-placeholder {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .card-body {\n    padding: 12px 12px 16px 12px;\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    flex: 1;\n  }\n  .card-meta {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 12px;\n    color: var(--color-graphite);\n    font-family: var(--font-cera-pro);\n    font-weight: 400;\n    margin-bottom: 4px;\n    flex-wrap: wrap;\n  }\n  .card-meta-item {\n    display: flex;\n    align-items: center;\n    gap: 3px;\n  }\n  .card-title {\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    line-height: 1.35;\n    margin-bottom: 4px;\n  }\n  .card-price {\n    font-family: var(--font-cera-pro);\n    font-size: 16px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    margin-bottom: 10px;\n    line-height: 1.2;\n  }\n  .card-actions {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-top: auto;\n  }\n  .btn-add {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    background: var(--color-brick-orange);\n    color: var(--color-pitch);\n    font-family: var(--font-cera-pro);\n    font-size: 13px;\n    font-weight: 700;\n    border: none;\n    border-radius: 999px;\n    padding: 8px 14px;\n    cursor: pointer;\n    flex: 1;\n    white-space: nowrap;\n    justify-content: center;\n    line-height: 1;\n  }\n  .btn-add:hover {\n    background: var(--color-ember-dark);\n    box-shadow: var(--shadow-sm);\n  }\n  .btn-wish {\n    background: var(--color-fog);\n    border: none;\n    border-radius: 999px;\n    width: 36px;\n    height: 36px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    flex-shrink: 0;\n  }\n  .star-icon { color: #F5A623; font-size: 11px; }\n</style>\n<div class=\"card-grid\">\n  <!-- Card 1 -->\n  <div class=\"card\">\n    <div class=\"card-image-wrap\">\n      <div class=\"card-img-placeholder\">\n        <div style=\"width:130px;height:110px;background:linear-gradient(135deg,#e8e8e8 0%,#d0d0d0 100%);border-radius:6px;display:flex;align-items:center;justify-content:center;\">\n          <svg width=\"60\" height=\"40\" viewBox=\"0 0 60 40\" fill=\"none\"><rect x=\"2\" y=\"18\" width=\"56\" height=\"16\" rx=\"3\" fill=\"#b0b8c8\"/><rect x=\"8\" y=\"10\" width=\"32\" height=\"14\" rx=\"2\" fill=\"#c8d4e0\"/><ellipse cx=\"14\" cy=\"36\" rx=\"5\" ry=\"5\" fill=\"#888\"/><ellipse cx=\"44\" cy=\"36\" rx=\"5\" ry=\"5\" fill=\"#888\"/><rect x=\"36\" y=\"6\" width=\"18\" height=\"10\" rx=\"1\" fill=\"#a0afc0\"/></svg>\n        </div>\n      </div>\n      <span class=\"card-badge\">New</span>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"card-meta\">\n        <span class=\"card-meta-item\">\ud83e\uddd1 18+</span>\n        <span class=\"card-meta-item\">\ud83e\uddf1 1903</span>\n        <span class=\"card-meta-item\" style=\"color:#F5A623;\">\u2605 4.8</span>\n      </div>\n      <div class=\"card-title\">Douglas\u2122 DC-3\u2122 PAN AM\u00ae Airliner</div>\n      <div class=\"card-price\">219,99 \u20ac</div>\n      <div class=\"card-actions\">\n        <button class=\"btn-add\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path d=\"M6 16a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM1 2h2l2.6 9.4a1 1 0 0 0 1 .6H15a1 1 0 0 0 1-.76L18 6H4\"/><path d=\"M1 2h2l2.6 9.4a1 1 0 0 0 1 .6H15a1 1 0 0 0 1-.76L18 6H4\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/></svg>\n          Add to Bag\n        </button>\n        <button class=\"btn-wish\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#141414\" stroke-width=\"2\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>\n        </button>\n      </div>\n    </div>\n  </div>\n  <!-- Card 2 -->\n  <div class=\"card\">\n    <div class=\"card-image-wrap\">\n      <div class=\"card-img-placeholder\">\n        <div style=\"width:110px;height:120px;background:linear-gradient(160deg,#f5e8d0 0%,#e8c890 100%);border-radius:6px;display:flex;align-items:center;justify-content:center;\">\n          <svg width=\"55\" height=\"65\" viewBox=\"0 0 55 65\" fill=\"none\"><ellipse cx=\"27\" cy=\"45\" rx=\"20\" ry=\"18\" fill=\"#c8944a\"/><ellipse cx=\"27\" cy=\"28\" rx=\"12\" ry=\"14\" fill=\"#d4a055\"/><ellipse cx=\"20\" cy=\"20\" rx=\"5\" ry=\"10\" fill=\"#b87830\" transform=\"rotate(-20 20 20)\"/><ellipse cx=\"34\" cy=\"20\" rx=\"5\" ry=\"10\" fill=\"#b87830\" transform=\"rotate(20 34 20)\"/><circle cx=\"23\" cy=\"32\" r=\"2.5\" fill=\"#141414\"/><circle cx=\"31\" cy=\"32\" r=\"2.5\" fill=\"#141414\"/><path d=\"M23 38 Q27 42 31 38\" stroke=\"#141414\" stroke-width=\"1.5\" fill=\"none\"/></svg>\n        </div>\n      </div>\n      <span class=\"card-badge\">New</span>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"card-meta\">\n        <span class=\"card-meta-item\">\ud83e\uddd1 18+</span>\n        <span class=\"card-meta-item\">\ud83e\uddf1 587</span>\n        <span class=\"card-meta-item\" style=\"color:#F5A623;\">\u2605 4.8</span>\n      </div>\n      <div class=\"card-title\">Eevee</div>\n      <div class=\"card-price\">59,99 \u20ac</div>\n      <div class=\"card-actions\">\n        <button class=\"btn-add\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M1 2h2l2.6 9.4a1 1 0 0 0 1 .6H15a1 1 0 0 0 1-.76L18 6H4\"/><circle cx=\"6\" cy=\"18\" r=\"2\"/><circle cx=\"16\" cy=\"18\" r=\"2\"/></svg>\n          Add to Bag\n        </button>\n        <button class=\"btn-wish\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#141414\" stroke-width=\"2\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>\n        </button>\n      </div>\n    </div>\n  </div>\n  <!-- Card 3 -->\n  <div class=\"card\">\n    <div class=\"card-image-wrap\">\n      <div class=\"card-img-placeholder\">\n        <div style=\"width:130px;height:110px;background:linear-gradient(135deg,#d8f0d8 0%,#90c870 100%);border-radius:6px;display:flex;align-items:center;justify-content:center;gap:4px;\">\n          <div style=\"width:32px;height:50px;background:#3a8c3a;border-radius:4px;\"></div>\n          <div style=\"width:32px;height:50px;background:#e07020;border-radius:4px;\"></div>\n          <div style=\"width:32px;height:50px;background:#6050a0;border-radius:4px;\"></div>\n        </div>\n      </div>\n      <span class=\"card-badge\">New</span>\n    </div>\n    <div class=\"card-body\">\n      <div class=\"card-meta\">\n        <span class=\"card-meta-item\">\ud83e\uddd1 10+</span>\n        <span class=\"card-meta-item\">\ud83e\uddf1 567</span>\n        <span class=\"card-meta-item\" style=\"color:#F5A623;\">\u2605 5.0</span>\n      </div>\n      <div class=\"card-title\">Teenage Mutant Ninja Turtles Figures</div>\n      <div class=\"card-price\">39,99 \u20ac</div>\n      <div class=\"card-actions\">\n        <button class=\"btn-add\">\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M1 2h2l2.6 9.4a1 1 0 0 0 1 .6H15a1 1 0 0 0 1-.76L18 6H4\"/><circle cx=\"6\" cy=\"18\" r=\"2\"/><circle cx=\"16\" cy=\"18\" r=\"2\"/></svg>\n          Add to Bag\n        </button>\n        <button class=\"btn-wish\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#141414\" stroke-width=\"2\"><path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/></svg>\n        </button>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Product Card \u2014 LEGO Set",
    "role": "",
    "description": ""
