  {
    "html": "<style>\n  :root {\n    --color-lego-yellow: #FFD502;\n    --color-brick-orange: #F47D20;\n    --color-off-black: #141414;\n    --color-graphite: #2C2C2C;\n    --color-snow: #FFFFFF;\n    --color-fog: #F2F2F2;\n    --color-pebble: #F6F6F6;\n    --color-steel: #757575;\n    --font-cera-pro: 'Nunito', 'Poppins', sans-serif;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  .section {\n    background: var(--color-off-black);\n    font-family: var(--font-cera-pro);\n    padding: 0;\n    width: 600px;\n  }\n  .tab-row {\n    display: flex;\n    gap: 0;\n    padding: 0 24px;\n    background: var(--color-off-black);\n    border-bottom: none;\n  }\n  .tab {\n    font-family: var(--font-cera-pro);\n    font-size: 16px;\n    font-weight: 500;\n    color: var(--color-snow);\n    padding: 16px 20px 14px 20px;\n    cursor: pointer;\n    border: none;\n    background: transparent;\n    border-bottom: 3px solid transparent;\n    opacity: 0.6;\n    text-decoration: none;\n    display: inline-block;\n    line-height: 1;\n  }\n  .tab.active {\n    color: var(--color-snow);\n    border-bottom: 3px solid var(--color-snow);\n    opacity: 1;\n    font-weight: 700;\n  }\n  .tiles-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 0;\n    width: 100%;\n  }\n  .tile {\n    position: relative;\n    height: 130px;\n    overflow: hidden;\n    cursor: pointer;\n    display: flex;\n    align-items: flex-start;\n    justify-content: center;\n    padding-top: 12px;\n  }\n  .tile-label {\n    position: relative;\n    z-index: 2;\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--color-snow);\n    text-align: center;\n    line-height: 1.2;\n    text-shadow: 0 1px 3px rgba(0,0,0,0.4);\n    padding: 0 4px;\n  }\n  .tile-bg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n  }\n  .tile-1 .tile-bg { background: linear-gradient(160deg, #1a9ad4 0%, #0d6fa0 100%); }\n  .tile-2 .tile-bg { background: linear-gradient(160deg, #1a2b5a 0%, #0d1a40 100%); }\n  .tile-3 .tile-bg { background: linear-gradient(160deg, #8b3dbf 0%, #5a1a8f 100%); }\n  .tile-4 .tile-bg { background: linear-gradient(160deg, #222222 0%, #111111 100%); }\n  .tile-5 .tile-bg { background: linear-gradient(160deg, #f5f5f5 0%, #e0e0e0 100%); }\n  .tile-5 .tile-label { color: var(--color-off-black); }\n  .tile-6 .tile-bg { background: linear-gradient(160deg, #1a7ad4 0%, #0d4fa0 100%); }\n  .tile-7 .tile-bg { background: linear-gradient(160deg, #e05a10 0%, #b03c00 100%); }\n  .tile-8 .tile-bg { background: linear-gradient(160deg, #888 0%, #555 100%); }\n  .tile-decoration {\n    position: absolute;\n    bottom: 8px;\n    left: 0;\n    right: 0;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n    z-index: 1;\n  }\n  /* Minifig silhouette for visual interest */\n  .mini-fig {\n    width: 28px;\n    height: 45px;\n    background: rgba(255,255,255,0.15);\n    border-radius: 4px 4px 0 0;\n  }\n  .brick-stack {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n    align-items: center;\n  }\n  .brick {\n    height: 10px;\n    border-radius: 2px;\n    background: rgba(255,255,255,0.2);\n  }\n</style>\n<div class=\"section\">\n  <div class=\"tab-row\">\n    <a class=\"tab active\" href=\"#\">What's new</a>\n    <a class=\"tab\" href=\"#\">Gifting</a>\n    <a class=\"tab\" href=\"#\">Themes</a>\n  </div>\n  <div class=\"tiles-grid\">\n    <div class=\"tile tile-1\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:50px;height:55px;background:rgba(255,255,255,0.12);border-radius:3px;\"></div>\n      </div>\n      <span class=\"tile-label\">All new sets</span>\n    </div>\n    <div class=\"tile tile-2\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div class=\"brick-stack\"><div class=\"brick\" style=\"width:44px;\"></div><div class=\"brick\" style=\"width:40px;\"></div><div class=\"brick\" style=\"width:36px;\"></div></div>\n      </div>\n      <span class=\"tile-label\">Exclusives</span>\n    </div>\n    <div class=\"tile tile-3\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:42px;height:42px;background:rgba(255,255,255,0.18);border-radius:50%;\"></div>\n      </div>\n      <span class=\"tile-label\">Offers</span>\n    </div>\n    <div class=\"tile tile-4\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:44px;height:36px;background:rgba(255,255,255,0.12);border-radius:50% 50% 0 0;\"></div>\n      </div>\n      <span class=\"tile-label\">Icons</span>\n    </div>\n    <div class=\"tile tile-5\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:44px;height:48px;background:rgba(0,0,0,0.06);border-radius:4px;\"></div>\n      </div>\n      <span class=\"tile-label\">LEGO\u00ae Editions</span>\n    </div>\n    <div class=\"tile tile-6\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:46px;height:52px;background:rgba(255,255,255,0.14);border-radius:4px 4px 0 0;\"></div>\n      </div>\n      <span class=\"tile-label\">LEGO\u00ae ONE PIECE</span>\n    </div>\n    <div class=\"tile tile-7\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:36px;height:36px;background:rgba(255,220,0,0.3);border-radius:50%;\"></div>\n      </div>\n      <span class=\"tile-label\">Pok\u00e9mon</span>\n    </div>\n    <div class=\"tile tile-8\">\n      <div class=\"tile-bg\"></div>\n      <div class=\"tile-decoration\">\n        <div style=\"width:48px;height:38px;background:rgba(255,255,255,0.1);border-radius:3px;\"></div>\n      </div>\n      <span class=\"tile-label\">18+ years</span>\n    </div>\n  </div>\n</div>",
    "name": "Tab Navigation + Category Tiles",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-lego-yellow: #FFD502;\n    --color-brick-orange: #F47D20;\n    --color-ember-dark: #E96F14;\n    --color-action-blue: #005AD2;\n    --color-off-black: #141414;\n    --color-graphite: #2C2C2C;\n    --color-snow: #FFFFFF;\n    --color-fog: #F2F2F2;\n    --color-pebble: #F6F6F6;\n    --color-silver: #E0E0E0;\n    --shadow-sm: rgba(0,0,0,0.54) 0px 2px 4px 0px;\n    --font-cera-pro: 'Nunito', 'Poppins', sans-serif;\n  }\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  .insiders-section {\n    background: var(--color-pebble);\n    font-family: var(--font-cera-pro);\n    padding: 40px 24px;\n    width: 600px;\n  }\n  .insiders-inner {\n    display: flex;\n    gap: 20px;\n    align-items: flex-start;\n  }\n  .insiders-left {\n    flex: 0 0 180px;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  .insiders-logo {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 4px;\n  }\n  .logo-badge {\n    width: 44px;\n    height: 44px;\n    background: var(--color-flag-red, #D0021B);\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    background: #D0021B;\n  }\n  .logo-text {\n    font-family: var(--font-cera-pro);\n    font-size: 20px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    letter-spacing: -0.01em;\n  }\n  .insiders-heading {\n    font-family: var(--font-cera-pro);\n    font-size: 24px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    line-height: 1.19;\n    letter-spacing: -0.48px;\n  }\n  .insiders-body {\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    line-height: 1.5;\n  }\n  .insiders-btns {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    margin-top: 4px;\n  }\n  .btn-primary-blue {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: var(--color-action-blue);\n    color: var(--color-snow);\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 700;\n    border: none;\n    border-radius: 999px;\n    padding: 10px 18px;\n    cursor: pointer;\n    text-decoration: none;\n    width: fit-content;\n    line-height: 1;\n  }\n  .btn-primary-blue:hover { opacity: 0.9; }\n  .btn-outline {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: transparent;\n    color: var(--color-off-black);\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 500;\n    border: 1.5px solid rgba(0,0,0,0.67);\n    border-radius: 999px;\n    padding: 9px 18px;\n    cursor: pointer;\n    text-decoration: none;\n    width: fit-content;\n    line-height: 1;\n  }\n  .insiders-right {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n  .benefit-card {\n    background: var(--color-snow);\n    border-radius: 8px;\n    overflow: hidden;\n    display: flex;\n    flex-direction: column;\n  }\n  .benefit-img {\n    width: 100%;\n    height: 80px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .benefit-img-red { background: #D0021B; }\n  .benefit-img-yellow { background: #FFD502; }\n  .benefit-img-green { background: #2D8B2D; }\n  .benefit-content {\n    padding: 12px 14px 14px 14px;\n    text-align: center;\n  }\n  .benefit-title {\n    font-family: var(--font-cera-pro);\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--color-off-black);\n    margin-bottom: 4px;\n    line-height: 1.3;\n  }\n  .benefit-desc {\n    font-family: var(--font-cera-pro);\n    font-size: 12px;\n    font-weight: 400;\n    color: var(--color-graphite);\n    line-height: 1.5;\n  }\n  .benefit-row {\n    display: flex;\n    gap: 10px;\n  }\n  .benefit-card { flex: 1; }\n</style>\n<div class=\"insiders-section\">\n  <div class=\"insiders-inner\">\n    <div class=\"insiders-left\">\n      <div class=\"insiders-logo\">\n        <div class=\"logo-badge\">\n          <svg width=\"28\" height=\"20\" viewBox=\"0 0 28 20\" fill=\"none\">\n            <rect width=\"28\" height=\"20\" rx=\"2\" fill=\"#D0021B\"/>\n            <text x=\"14\" y=\"15\" text-anchor=\"middle\" font-family=\"Arial\" font-weight=\"900\" font-size=\"11\" fill=\"#FFD502\">LEGO</text>\n          </svg>\n        </div>\n        <span class=\"logo-text\">insiders</span>\n      </div>\n      <h2 class=\"insiders-heading\">Join and earn points</h2>\n      <p class=\"insiders-body\">Collect points with your purchases and access exclusive member benefits.</p>\n      <div class=\"insiders-btns\">\n        <a href=\"#\" class=\"btn-primary-blue\">\n          Become a member\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 10h10M13 6l4 4-4 4\"/></svg>\n        </a>\n        <a href=\"#\" class=\"btn-outline\">\n          Learn more\n          <svg width=\"14\" height=\"14\" viewBox=\"0 0 20 20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M7 10h10M13 6l4 4-4 4\"/></svg>\n        </a>\n      </div>\n    </div>\n    <div class=\"insiders-right\">\n      <div class=\"benefit-row\">\n        <div class=\"benefit-card\">\n          <div class=\"benefit-img benefit-img-red\">\n            <svg width=\"40\" height=\"50\" viewBox=\"0 0 40 50\" fill=\"none\">\n              <rect x=\"8\" y=\"2\" width=\"24\" height=\"32\" rx=\"3\" fill=\"rgba(255,255,255,0.2)\" stroke=\"white\" stroke-width=\"2\"/>\n              <circle cx=\"20\" cy=\"16\" r=\"8\" fill=\"rgba(255,255,255,0.3)\"/>\n              <line x1=\"20\" y1=\"34\" x2=\"20\" y2=\"48\" stroke=\"white\" stroke-width=\"2\"/>\n              <text x=\"20\" y=\"24\" text-anchor=\"middle\" font-size=\"10\" fill=\"white\" font-weight=\"bold\">%</text>\n            </svg>\n          </div>\n          <div class=\"benefit-content\">\n            <div class=\"benefit-title\">Loyalty Points</div>\n            <div class=\"benefit-desc\">Earn redeemable points when you buy or register set you own.</div>\n          </div>\n        </div>\n        <div class=\"benefit-card\">\n          <div class=\"benefit-img benefit-img-yellow\">\n            <svg width=\"48\" height=\"48\" viewBox=\"0 0 48 48\" fill=\"none\">\n              <rect x=\"8\" y=\"14\" width=\"32\" height=\"26\" rx=\"4\" fill=\"rgba(0,0,0,0.15)\"/>\n              <rect x=\"14\" y=\"8\" width=\"20\" height=\"10\" rx=\"3\" fill=\"rgba(0,0,0,0.12)\"/>\n              <rect x=\"18\" y=\"22\" width=\"12\" height=\"8\" rx=\"2\" fill=\"rgba(0,0,0,0.1)\"/>\n            </svg>\n          </div>\n          <div class=\"benefit-content\">\n            <div class=\"benefit-title\">Member-only rewards</div>\n            <div class=\"benefit-desc\">LEGO gear, special discounts, LEGOLAND tickets and more.</div>\n          </div>\n        </div>\n        <div class=\"benefit-card\">\n          <div class=\"benefit-img benefit-img-green\">\n            <svg width=\"48\" height=\"50\" viewBox=\"0 0 48 50\" fill=\"none\">\n              <ellipse cx=\"24\" cy=\"28\" rx=\"14\" ry=\"16\" fill=\"rgba(255,255,255,0.25)\"/>\n              <polygon points=\"24,6 28,18 40,18 31,26 34,38 24,31 14,38 17,26 8,18 20,18\" fill=\"rgba(255,255,255,0.5)\"/>\n            </svg>\n          </div>\n          <div class=\"benefit-content\">\n            <div class=\"benefit-title\">Limited-time gifts</div>\n            <div class=\"benefit-desc\">Get more of what you love \u2014 gifts available with selected sets.</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "LEGO Insiders Membership Banner",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary CTA Pill Button",
    "role": "Purchase actions: 'Add to Bag', 'Buy now', 'Become a member'",
    "description": "Background #F47D20, text #000000, font Cera Pro 700 16px, border-radius 999px, padding 10px 16px. No border. Hover/pressed state adds rgba(0,0,0,0.54) 0px 2px 4px shadow and shifts to #E96F14 background. Icon (shopping bag) inline-left at 12px gap. The orange-on-white contrast ratio is visually loud \u2014 deliberate for a toy retail context."
  },
  {
    "name": "Outlined Pill Button",
    "role": "Secondary actions: 'Learn more', 'Shop all new', 'Join LEGO\u00ae Insiders'",
    "description": "Background transparent, text #141414, border 1px solid rgba(0,0,0,0.67), border-radius 999px, padding 10px 16px. Font Cera Pro 500 16px. Trailing chevron icon in 14px. On dark hero surfaces this border reads clearly against the image background."
  },
  {
    "name": "Circular Icon Button",
    "role": "Wishlist, cart, carousel controls",
    "description": "Background #F2F2F2, border-radius 999px, 40\u00d740px fixed size (padding 0). Icon centered in #141414. No border, no shadow. Used for wishlist hearts on product cards and prev/next carousel arrows."
  },
  {
    "name": "Ghost Text Button",
    "role": "Inline navigation actions, tab underlines",
    "description": "Background transparent, text #000000, border-radius 0px, no padding. Font Cera Pro 400 16px. Bottom-border underline style for active tab states (3px solid #141414). Zero radius signals this is a flat navigation control, not a CTA."
  },
  {
    "name": "New/Exclusives Badge",
    "role": "Product card status labels, hero content tags",
    "description": "Background #FFD502, text #141414, border-radius 0px, padding 4px 12px. Font Cera Pro 700 12px, letter-spacing +0.01em. Sharp corners are intentional \u2014 the badge reads like a price sticker, reinforcing the physical retail metaphor. Appears top-left of product card images."
  },
  {
    "name": "Category Navigation Tile",
    "role": "Theme/category browsing grid below hero tabs",
    "description": "Square tile with full-bleed product photography, category label in Cera Pro 700 16px white text overlaid top-center. No border-radius (0px). Hover state not visible in static data but tile grid is 8-column at desktop. Tiles for licensed categories (Pok\u00e9mon, TMNT) use character art backgrounds."
  },
  {
    "name": "Search Input",
    "role": "Global site search in header",
    "description": "Background #FFFFFF, border 1px solid #E0E0E0, border-radius 0px (sharp), padding 18px 20px. Font Cera Pro 400 16px #141414. Search icon (magnifier) at left edge. Full-width within header search zone. The sharp radius contrasts with all the 999px pill buttons \u2014 search is a field, not an action."
  },
  {
    "name": "Tab Navigation",
    "role": "Section content switcher ('What's new / Gifting / Themes', 'Featured / Formula 1\u00ae')",
    "description": "Underline tab pattern: active tab has 3px bottom border #141414, inactive tabs #757575 text, no border. Font Cera Pro 500 16px. Padding 0 0 12px 0. Row gap 16px between tabs. No background fill on any state \u2014 pure text + underline system."
  },
  {
    "name": "Announcement Banner",
    "role": "Promotional message bar at top of page",
    "description": "Background #141414, text #FFFFFF, Cera Pro 400 14px. Left: 'PLAY ZONE' in yellow pill tag (#FFD502, 0px radius). Center: offer copy with inline 'Shop now' link in #FFFFFF underlined. Prev/next arrow controls in #FFFFFF. Full-bleed width, ~40px height."
  },
  {
    "name": "Insiders Membership Card Row",
    "role": "Benefit showcase in membership section",
    "description": "3-column row of benefit tiles: each tile has a full-bleed colored image (red, yellow, green backgrounds with product photography), 16px label Cera Pro 700 below, 14px description Cera Pro 400 #2C2C2C. No card border or shadow \u2014 tiles are visually separated by 16px gap on white section background."
  },
  {
    "name": "Site Footer",
    "role": "Global navigation footer",
    "description": "Background #201D48, text #FFFFFF, Cera Pro 400 14px. 5-column link grid: section headers in Cera Pro 700 12px uppercase letter-spacing +0.01em, links at 400 14px. LEGO logo in white on yellow (#FFD502) square badge at top-left. Footer sits in strong visual contrast to the white page body \u2014 the navy is the only dark chromatic surface on the page."
  }
]
