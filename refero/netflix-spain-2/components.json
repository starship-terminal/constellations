    "html": "<div style=\"--color-netflix-red:#e50914;--color-deep-space:#000000;--color-graphite:#232323;--color-chalk-white:#ffffff;--color-silver:#b3b3b3;--font-netflix-sans:'Netflix Sans',Roboto,Inter,sans-serif;background:var(--color-deep-space);padding:24px;font-family:var(--font-netflix-sans);\"><div style=\"background:var(--color-graphite);border-radius:8px;padding:20px 24px;display:flex;align-items:center;gap:16px;\"><div style=\"flex-shrink:0;width:52px;height:52px;display:flex;align-items:center;justify-content:center;\"><div style=\"font-size:40px;line-height:1;\">\ud83c\udf7f</div></div><div style=\"flex:1;min-width:0;\"><p style=\"font-family:var(--font-netflix-sans);font-size:16px;font-weight:700;color:var(--color-chalk-white);margin:0 0 4px 0;line-height:1.4;\">The Netflix you love for just EUR 6.99.</p><p style=\"font-family:var(--font-netflix-sans);font-size:13px;font-weight:400;color:var(--color-silver);margin:0;line-height:1.5;\">Get our most affordable, ad-supported plan.</p></div><a href=\"#\" style=\"flex-shrink:0;background:transparent;color:var(--color-chalk-white);font-family:var(--font-netflix-sans);font-size:13px;font-weight:500;padding:8px 16px;border:1px solid var(--color-chalk-white);border-radius:4px;text-decoration:none;white-space:nowrap;display:inline-block;\">Learn More</a></div></div>",
