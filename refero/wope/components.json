[
  {
    "html": "<div style=\"--color-night-violet:#0a0118;--color-void-plum:#0c0616;--color-soft-quartz:#ffffff;--color-muted-steel:#d2d0dd;--color-ash-lilac:#9b96b0;--color-dim-fog:#85808c;--color-ultraviolet-core:#713dff;--color-lilac-beam:#b7a4fb;--color-horizon-glow:#8562ff;--font-inter-v:'Inter',sans-serif;--font-rebond-grotesque:'Sora',sans-serif; background:var(--color-night-violet);padding:48px 32px;display:flex;flex-direction:column;align-items:center;gap:24px;font-family:var(--font-inter-v);border-radius:16px;\">\n  <!-- Badge -->\n  <div style=\"background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.1);border-radius:999px;padding:4px 14px;display:inline-flex;align-items:center;gap:6px;\">\n    <span style=\"display:inline-block;width:6px;height:6px;border-radius:999px;background:var(--color-lilac-beam);\"></span>\n    <span style=\"font-family:var(--font-inter-v);font-size:13px;font-weight:500;color:var(--color-soft-quartz);letter-spacing:0.02em;\">New-Gen SEO Research Platform</span>\n  </div>\n\n  <!-- Headline -->\n  <div style=\"text-align:center;\">\n    <h2 style=\"font-family:var(--font-rebond-grotesque);font-size:40px;font-weight:700;line-height:1.12;letter-spacing:-0.8px;color:var(--color-soft-quartz);margin:0 0 12px 0;\">New Era of SEO Research</h2>\n    <p style=\"font-family:var(--font-inter-v);font-size:16px;font-weight:400;line-height:1.5;letter-spacing:-0.16px;color:var(--color-ash-lilac);margin:0;max-width:420px;\">Let our AI do the heavy lifting. Find hidden keyword opportunities and get clear & actionable insights.</p>\n  </div>\n\n  <!-- Button row -->\n  <div style=\"display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;\">\n    <!-- Primary CTA -->\n    <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);border-radius:999px;padding:10px 28px;text-decoration:none;\">\n      <span style=\"font-family:var(--font-inter-v);font-size:15px;font-weight:500;color:var(--color-soft-quartz);letter-spacing:-0.16px;\">Unlimited trial for 14 days</span>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2.5 7h9M8 3.5L11.5 7 8 10.5\" stroke=\"#fff\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </a>\n    <!-- Secondary -->\n    <a href=\"#\" style=\"display:inline-flex;align-items:center;gap:6px;background:transparent;border:none;border-radius:999px;padding:10px 20px;text-decoration:none;\">\n      <span style=\"font-family:var(--font-inter-v);font-size:15px;font-weight:500;color:var(--color-ash-lilac);letter-spacing:-0.16px;\">View Pricing</span>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M2.5 7h9M8 3.5L11.5 7 8 10.5\" stroke=\"#9b96b0\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n    </a>\n  </div>\n\n  <!-- Subtle glow underline -->\n  <div style=\"width:240px;height:1px;background:linear-gradient(90deg,rgba(113,61,255,0) 0%,rgba(183,164,251,0.5) 50%,rgba(113,61,255,0) 100%);margin-top:8px;\"></div>\n\n  <!-- Trust micro-copy -->\n  <p style=\"font-family:var(--font-inter-v);font-size:13px;font-weight:400;color:var(--color-dim-fog);letter-spacing:0.01em;margin:0;\">No credit card required &nbsp;\u00b7&nbsp; Cancel anytime</p>\n</div>",
    "name": "Primary CTA Button Group",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-night-violet:#0a0118;--color-soft-quartz:#ffffff;--color-muted-steel:#d2d0dd;--color-ash-lilac:#9b96b0;--color-dim-fog:#85808c;--color-ultraviolet-core:#713dff;--color-lilac-beam:#b7a4fb;--color-horizon-glow:#8562ff;--font-inter-v:'Inter',sans-serif; background:var(--color-night-violet);padding:0;border-radius:16px;border:1px solid rgba(255,255,255,0.08);overflow:hidden;font-family:var(--font-inter-v);width:100%;max-width:600px;\">\n  <!-- Card header -->\n  <div style=\"display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid rgba(255,255,255,0.06);\">\n    <div style=\"display:flex;align-items:center;gap:8px;\">\n      <div style=\"width:18px;height:18px;border-radius:4px;background:var(--color-ultraviolet-core);display:flex;align-items:center;justify-content:center;\">\n        <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"><circle cx=\"4\" cy=\"4\" r=\"3\" stroke=\"#fff\" stroke-width=\"1.2\"/><line x1=\"6.5\" y1=\"6.5\" x2=\"9\" y2=\"9\" stroke=\"#fff\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>\n      </div>\n      <span style=\"font-size:14px;font-weight:600;color:var(--color-soft-quartz);letter-spacing:-0.14px;\">Keyword Finder</span>\n      <span style=\"background:rgba(113,61,255,0.2);border:1px solid rgba(113,61,255,0.3);border-radius:999px;padding:1px 8px;font-size:11px;font-weight:500;color:var(--color-lilac-beam);\">AI</span>\n    </div>\n    <div style=\"display:flex;align-items:center;gap:8px;\">\n      <div style=\"display:flex;align-items:center;gap:4px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:999px;padding:3px 10px;\">\n        <span style=\"font-size:12px;color:var(--color-ash-lilac);\">\ud83c\uddfa\ud83c\uddf8</span>\n        <span style=\"font-size:12px;font-weight:500;color:var(--color-ash-lilac);\">ikea.com (US, en)</span>\n        <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"><path d=\"M2 4l3 3 3-3\" stroke=\"#9b96b0\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n      </div>\n      <div style=\"display:flex;align-items:center;gap:4px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:999px;padding:3px 10px;\">\n        <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"><path d=\"M1 3h8M2 5h6M3 7h4\" stroke=\"#9b96b0\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>\n        <span style=\"font-size:12px;font-weight:500;color:var(--color-ash-lilac);\">Filter</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Table -->\n  <div style=\"overflow-x:auto;\">\n    <table style=\"width:100%;border-collapse:collapse;font-size:12px;\">\n      <thead>\n        <tr style=\"border-bottom:1px solid rgba(255,255,255,0.06);\">\n          <th style=\"text-align:left;padding:10px 20px;font-weight:500;color:var(--color-dim-fog);letter-spacing:0.02em;font-size:11px;\">Keyword</th>\n          <th style=\"text-align:right;padding:10px 12px;font-weight:500;color:var(--color-dim-fog);font-size:11px;\">Volume</th>\n          <th style=\"text-align:center;padding:10px 12px;font-weight:500;color:var(--color-dim-fog);font-size:11px;\">K.D.</th>\n          <th style=\"text-align:center;padding:10px 12px;font-weight:500;color:var(--color-dim-fog);font-size:11px;\">Pos.</th>\n          <th style=\"text-align:right;padding:10px 12px;font-weight:500;color:var(--color-dim-fog);font-size:11px;\">Change</th>\n          <th style=\"text-align:right;padding:10px 20px 10px 8px;font-weight:500;color:var(--color-dim-fog);font-size:11px;\">Traffic</th>\n        </tr>\n      </thead>\n      <tbody>\n        <!-- Row 1 -->\n        <tr style=\"border-bottom:1px solid rgba(255,255,255,0.04);\">\n          <td style=\"padding:11px 20px;color:var(--color-muted-steel);font-weight:500;font-size:13px;\">fedex track</td>\n          <td style=\"padding:11px 12px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">7.5M</td>\n          <td style=\"padding:11px 12px;text-align:center;\">\n            <span style=\"display:inline-block;background:rgba(251,146,60,0.2);color:#fb923c;border-radius:999px;padding:1px 7px;font-size:11px;font-weight:600;\">42</span>\n          </td>\n          <td style=\"padding:11px 12px;text-align:center;color:var(--color-ash-lilac);font-size:12px;\">78</td>\n          <td style=\"padding:11px 12px;text-align:right;\">\n            <span style=\"color:#4ade80;font-size:12px;font-weight:500;\">+12</span>\n          </td>\n          <td style=\"padding:11px 20px 11px 8px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">15.7K</td>\n        </tr>\n        <!-- Row 2 -->\n        <tr style=\"border-bottom:1px solid rgba(255,255,255,0.04);\">\n          <td style=\"padding:11px 20px;color:var(--color-muted-steel);font-weight:500;font-size:13px;\">ikea</td>\n          <td style=\"padding:11px 12px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">7.5M</td>\n          <td style=\"padding:11px 12px;text-align:center;\">\n            <span style=\"display:inline-block;background:rgba(74,222,128,0.15);color:#4ade80;border-radius:999px;padding:1px 7px;font-size:11px;font-weight:600;\">44</span>\n          </td>\n          <td style=\"padding:11px 12px;text-align:center;color:var(--color-ash-lilac);font-size:12px;\">1</td>\n          <td style=\"padding:11px 12px;text-align:right;\">\n            <span style=\"color:var(--color-dim-fog);font-size:12px;\">0</span>\n          </td>\n          <td style=\"padding:11px 20px 11px 8px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">2.3M</td>\n        </tr>\n        <!-- Row 3 -->\n        <tr style=\"border-bottom:1px solid rgba(255,255,255,0.04);\">\n          <td style=\"padding:11px 20px;color:var(--color-muted-steel);font-weight:500;font-size:13px;\">store near me</td>\n          <td style=\"padding:11px 12px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">5M</td>\n          <td style=\"padding:11px 12px;text-align:center;\">\n            <span style=\"display:inline-block;background:rgba(239,68,68,0.2);color:#f87171;border-radius:999px;padding:1px 7px;font-size:11px;font-weight:600;\">100</span>\n          </td>\n          <td style=\"padding:11px 12px;text-align:center;color:var(--color-ash-lilac);font-size:12px;\">34</td>\n          <td style=\"padding:11px 12px;text-align:right;\">\n            <span style=\"color:#f87171;font-size:12px;font-weight:500;\">-18</span>\n          </td>\n          <td style=\"padding:11px 20px 11px 8px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">10.5K</td>\n        </tr>\n        <!-- Row 4 -->\n        <tr style=\"border-bottom:1px solid rgba(255,255,255,0.04);\">\n          <td style=\"padding:11px 20px;color:var(--color-muted-steel);font-weight:500;font-size:13px;\">home goods</td>\n          <td style=\"padding:11px 12px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">1.8M</td>\n          <td style=\"padding:11px 12px;text-align:center;\">\n            <span style=\"display:inline-block;background:rgba(251,146,60,0.2);color:#fb923c;border-radius:999px;padding:1px 7px;font-size:11px;font-weight:600;\">85</span>\n          </td>\n          <td style=\"padding:11px 12px;text-align:center;color:var(--color-ash-lilac);font-size:12px;\">31</td>\n          <td style=\"padding:11px 12px;text-align:right;\">\n            <span style=\"color:#4ade80;font-size:12px;font-weight:500;\">+26</span>\n          </td>\n          <td style=\"padding:11px 20px 11px 8px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">3.8K</td>\n        </tr>\n        <!-- Row 5 -->\n        <tr>\n          <td style=\"padding:11px 20px;color:var(--color-muted-steel);font-weight:500;font-size:13px;\">at home</td>\n          <td style=\"padding:11px 12px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">1.8M</td>\n          <td style=\"padding:11px 12px;text-align:center;\">\n            <span style=\"display:inline-block;background:rgba(74,222,128,0.15);color:#4ade80;border-radius:999px;padding:1px 7px;font-size:11px;font-weight:600;\">72</span>\n          </td>\n          <td style=\"padding:11px 12px;text-align:center;color:var(--color-ash-lilac);font-size:12px;\">8</td>\n          <td style=\"padding:11px 12px;text-align:right;\">\n            <span style=\"color:#4ade80;font-size:12px;font-weight:500;\">+n</span>\n          </td>\n          <td style=\"padding:11px 20px 11px 8px;text-align:right;color:var(--color-ash-lilac);font-size:12px;\">35.3K</td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n\n  <!-- Footer -->\n  <div style=\"padding:10px 20px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between;\">\n    <span style=\"font-size:11px;color:var(--color-dim-fog);\">Showing 5 of 2,847 keywords</span>\n    <a href=\"#\" style=\"font-size:12px;font-weight:500;color:var(--color-lilac-beam);text-decoration:none;display:flex;align-items:center;gap:4px;\">View all <svg width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" fill=\"none\"><path d=\"M2 5h6M5.5 2.5L8 5 5.5 7.5\" stroke=\"#b7a4fb\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>\n  </div>\n</div>",
    "name": "Keyword Data Table Card",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-night-violet:#0a0118;--color-soft-quartz:#ffffff;--color-ash-lilac:#9b96b0;--color-dim-fog:#85808c;--color-lilac-beam:#b7a4fb;--font-inter-v:'Inter',sans-serif;--font-rebond-grotesque:'Sora',sans-serif; background:var(--color-night-violet);padding:48px 32px;border-radius:16px;font-family:var(--font-inter-v);\">\n  <!-- Label -->\n  <p style=\"text-align:center;font-size:13px;font-weight:500;color:var(--color-dim-fog);letter-spacing:0.12em;text-transform:uppercase;margin:0 0 36px 0;\">Trusted by teams at</p>\n\n  <!-- Logo row -->\n  <div style=\"display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;\">\n    <!-- QNB -->\n    <div style=\"display:flex;align-items:center;gap:6px;opacity:0.55;\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\"><circle cx=\"9\" cy=\"9\" r=\"8\" stroke=\"#fff\" stroke-width=\"1.5\"/><path d=\"M5 9h8M9 5v8\" stroke=\"#fff\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n      <span style=\"font-size:15px;font-weight:700;color:var(--color-soft-quartz);letter-spacing:0.04em;\">QNB</span>\n    </div>\n\n    <!-- BMW -->\n    <div style=\"opacity:0.5;\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><circle cx=\"18\" cy=\"18\" r=\"17\" stroke=\"#fff\" stroke-width=\"1.2\"/><circle cx=\"18\" cy=\"18\" r=\"11\" stroke=\"#fff\" stroke-width=\"1\"/><path d=\"M18 7v22M7 18h22\" stroke=\"#fff\" stroke-width=\"1\"/><path d=\"M7 18h11V7\" fill=\"#fff\" opacity=\"0.2\"/><path d=\"M18 18h11v11\" fill=\"#fff\" opacity=\"0.2\"/></svg>\n    </div>\n\n    <!-- Delivery Hero -->\n    <div style=\"opacity:0.5;\">\n      <span style=\"font-size:15px;font-weight:700;color:var(--color-soft-quartz);font-family:var(--font-inter-v);letter-spacing:-0.3px;\">Delivery Hero</span>\n    </div>\n\n    <!-- MediaMarkt -->\n    <div style=\"opacity:0.5;\">\n      <span style=\"font-size:14px;font-weight:700;color:var(--color-soft-quartz);font-style:italic;letter-spacing:-0.2px;\">MediaMarkt</span>\n    </div>\n\n    <!-- Bayer -->\n    <div style=\"opacity:0.5;\">\n      <svg width=\"36\" height=\"36\" viewBox=\"0 0 36 36\" fill=\"none\"><circle cx=\"18\" cy=\"18\" r=\"17\" stroke=\"#fff\" stroke-width=\"1.2\"/><text x=\"18\" y=\"22\" text-anchor=\"middle\" fill=\"#fff\" font-size=\"9\" font-weight=\"700\" font-family=\"Inter,sans-serif\">BAYER</text></svg>\n    </div>\n\n    <!-- Amazon -->\n    <div style=\"opacity:0.5;\">\n      <span style=\"font-size:16px;font-weight:700;color:var(--color-soft-quartz);font-family:var(--font-inter-v);letter-spacing:-0.3px;\">amazon</span>\n    </div>\n  </div>\n\n  <!-- Divider glow -->\n  <div style=\"margin-top:40px;height:1px;background:linear-gradient(90deg,rgba(113,61,255,0) 0%,rgba(183,164,251,0.25) 40%,rgba(133,98,255,0.25) 60%,rgba(113,61,255,0) 100%);\"></div>\n\n  <!-- Stat row -->\n  <div style=\"margin-top:32px;display:flex;align-items:stretch;justify-content:center;gap:0;\">\n    <div style=\"flex:1;text-align:center;padding:0 16px;border-right:1px solid rgba(255,255,255,0.07);\">\n      <div style=\"font-family:var(--font-rebond-grotesque);font-size:28px;font-weight:700;color:var(--color-soft-quartz);letter-spacing:-0.56px;line-height:1.1;\">500K+</div>\n      <div style=\"font-size:12px;color:var(--color-ash-lilac);margin-top:4px;letter-spacing:-0.12px;\">Keywords tracked</div>\n    </div>\n    <div style=\"flex:1;text-align:center;padding:0 16px;border-right:1px solid rgba(255,255,255,0.07);\">\n      <div style=\"font-family:var(--font-rebond-grotesque);font-size:28px;font-weight:700;color:var(--color-soft-quartz);letter-spacing:-0.56px;line-height:1.1;\">180+</div>\n      <div style=\"font-size:12px;color:var(--color-ash-lilac);margin-top:4px;letter-spacing:-0.12px;\">Countries supported</div>\n    </div>\n    <div style=\"flex:1;text-align:center;padding:0 16px;\">\n      <div style=\"font-family:var(--font-rebond-grotesque);font-size:28px;font-weight:700;color:var(--color-soft-quartz);letter-spacing:-0.56px;line-height:1.1;\">4.9\u2605</div>\n      <div style=\"font-size:12px;color:var(--color-ash-lilac);margin-top:4px;letter-spacing:-0.12px;\">Average rating</div>\n    </div>\n  </div>\n</div>",
    "name": "Logo Rail Social Proof Strip",
    "role": "",
    "description": ""
  },
  {
    "name": "Primary Glass CTA Pill",
    "role": "Main action button in hero and high-attention areas",
    "description": "Use a 999px pill with background rgba(255,255,255,0.04), 1px solid rgba(255,255,255,0.1), white label text, and padding 7px 24px. Keep the fill translucent so the button reads like lit glass floating above #0a0118 rather than a solid chip."
  },
  {
    "name": "Header Outline Pill Button",
    "role": "Secondary header actions such as Log in",
    "description": "Transparent background, 1px solid rgba(255,255,255,0.1), 999px radius, padding 4px 16px, label in white or Ash Lilac depending on emphasis. This variant should feel lighter and smaller than the primary CTA."
  },
  {
    "name": "Text Navigation Pill",
    "role": "Minimal nav actions and tertiary controls",
    "description": "Transparent background, no visible border, 999px radius, padding 4px 24px, white text. Use when the interface wants pill spacing without a framed container."
  },
  {
    "name": "Hero Trial Badge",
    "role": "Compact promotional label above or below hero copy",
    "description": "Pill badge with background rgba(255,255,255,0.04), white text, 999px radius, and padding 4px 14px. Border may be omitted or kept at 1px rgba(255,255,255,0.1) when placed over a strong glow."
  },
  {
    "name": "Feature Surface Card",
    "role": "Primary content card for feature summaries and product panels",
    "description": "Use Night Violet #0a0118 background, 16px radius, no shadow, and internal padding of 28px when content sits inside. Separate from the page with 1px translucent white borders or slight glow edges rather than elevation."
  },
  {
    "name": "Frosted Info Card",
    "role": "Secondary glass panel for smaller callouts",
    "description": "Use background rgba(255,255,255,0.02), 16px radius, no shadow, 28px padding, and optional backdrop blur(4px). This reads as a lighter film over the dark canvas."
  },
  {
    "name": "Overlay Mini Card",
    "role": "Floating stat, tooltip, or decorative UI inset",
    "description": "Use background rgba(10,1,24,0.2), 10px radius, no shadow. Combine with blur(8px) and a thin rgba(255,255,255,0.1) border when it sits on top of product visuals."
  },
  {
    "name": "Product Screenshot Frame",
    "role": "Large hero UI showcase container",
    "description": "Large 16px rounded frame in #0a0118 with subtle internal glow, no shadow, and an underlighting treatment using the Ultraviolet Horizon gradient. The screenshot should appear embedded into the purple light field, not hovering above it."
  },
  {
    "name": "Header Bar",
    "role": "Top navigation container",
    "description": "Full-width bar over the dark canvas, content centered within 1248px, low-contrast links in Ash Lilac, and action pills aligned right. Use 16px horizontal grouping gaps and a restrained 78px height zone."
  },
  {
    "name": "Borderless Input Field",
    "role": "Email or search input inside dark callout forms",
    "description": "Transparent background, no visible border, 0px radius, white text, padding 14px 130px 14px 20px. Pair with a surrounding card or underline rather than boxing the field itself."
  },
  {
    "name": "Logo Rail",
    "role": "Social-proof brand strip",
    "description": "Contained horizontal row of monochrome partner logos in white or Dim Fog on the dark canvas. Keep the rail low contrast and evenly spaced so it sits as a quiet separator between hero and feature content."
  },
  {
    "name": "Section Block",
    "role": "Standard vertical content band",
    "description": "Transparent section wrapper with 124px top and bottom padding when used as a major page band. Inside, center content and keep internal stacks at 16px or 24px gaps."
  }
]
