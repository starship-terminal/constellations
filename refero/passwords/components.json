  {
    "name": "Primary CTA Button",
    "role": "The main call-to-action.",
    "description": "A pill-shaped button. Background: Brand Blue (#145fe4). Text: White (#ffffff). Radius: 9999px. Padding: 10px 24px. Font: agileSans, weight 500."
  },
  {
    "name": "Secondary CTA Button",
    "role": "A secondary call-to-action, typically used on dark backgrounds.",
    "description": "A pill-shaped outline button. Background: transparent. Border: 1px solid White (#ffffff). Text: White (#ffffff). Radius: 9999px. Padding: 10px 24px."
  },
  {
    "name": "Integration List Item",
    "role": "Represents a linked third-party service in a list.",
    "description": "A clickable row with a White (#ffffff) background. Padding: 16px 24px. Radius: 8px. Border: 1px solid Ash (#d7d7db). Contains a logo, title text, and a chevron icon."
  },
  {
    "name": "Business/Personal Toggle",
    "role": "Switches between two primary user segments.",
    "description": "A pill-shaped switch with a static background. An inner, smaller pill of Brand Blue (#145fe4) indicates the selected state ('Business' or 'Personal'). Radius: 9999px."
  },
  {
    "name": "Navigation Header",
    "role": "Sticky header for primary site navigation.",
    "description": "White (#ffffff) background with a 1px bottom border in Ash (#d7d7db). Navigation links use Graphite (#303136) text. The primary 'Get started free' button is a filled Primary CTA Button."
  },
  {
    "name": "Interactive Text Link",
    "role": "An in-text link to another page or section.",
    "description": "Text in Brand Blue (#145fe4), typically followed by a '\u2192' character. No underline by default, likely added on hover."
  },
  {
    "name": "Announcement Banner",
    "role": "A site-wide, non-critical notification at the top of the page.",
    "description": "A full-width bar with a Warning Tan (#cbb88e) background. Text is Onyx (#000000)."
  }
]
