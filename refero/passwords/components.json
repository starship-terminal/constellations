    "html": "<style>:root{--color-brand-blue:#145fe4;--color-white:#ffffff;--color-deep-space:#1d1d21;--color-ash:#d7d7db;--color-graphite:#303136;--font-agilesans:'Inter',Manrope,sans-serif;}*{box-sizing:border-box;margin:0;padding:0;}</style><div style=\"background:var(--color-deep-space);padding:48px 40px;border-radius:16px;display:flex;flex-direction:column;align-items:center;gap:24px;font-family:var(--font-agilesans);\"><p style=\"font-family:var(--font-agilesans);font-size:14px;font-weight:400;color:var(--color-ash);letter-spacing:0.04em;\">Switch between plans</p><div style=\"display:flex;align-items:center;gap:16px;\"><span style=\"font-family:var(--font-agilesans);font-size:16px;font-weight:500;color:var(--color-white);\">Business</span><div style=\"position:relative;width:56px;height:30px;background:#3a3a42;border-radius:9999px;cursor:pointer;flex-shrink:0;\"><div style=\"position:absolute;top:3px;left:3px;width:24px;height:24px;background:var(--color-brand-blue);border-radius:9999px;display:flex;align-items:center;justify-content:center;\"><div style=\"width:8px;height:8px;background:var(--color-white);border-radius:9999px;\"></div></div></div><span style=\"font-family:var(--font-agilesans);font-size:16px;font-weight:500;color:#8a8a96;\">Personal</span></div><div style=\"display:flex;gap:8px;margin-top:8px;\"><div style=\"padding:6px 18px;border-radius:9999px;background:var(--color-brand-blue);color:var(--color-white);font-family:var(--font-agilesans);font-size:14px;font-weight:500;cursor:pointer;\">Business</div><div style=\"padding:6px 18px;border-radius:9999px;background:transparent;color:#8a8a96;font-family:var(--font-agilesans);font-size:14px;font-weight:500;cursor:pointer;\">Personal</div></div></div>",
    "name": "Business / Personal Toggle",
    "role": "",
    "description": ""
