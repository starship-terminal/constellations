    "html": "<style>:root{--color-brand-blue:#145fe4;--color-white:#ffffff;--color-onyx:#000000;--color-deep-space:#1d1d21;--color-graphite:#303136;--color-ash:#d7d7db;--font-agilesans:'Inter',Manrope,sans-serif;}*{box-sizing:border-box;margin:0;padding:0;}</style><div style=\"background:var(--color-deep-space);padding:48px 40px;border-radius:16px;display:flex;flex-direction:column;align-items:center;gap:32px;font-family:var(--font-agilesans);\"><div style=\"text-align:center;\"><p style=\"font-family:var(--font-agilesans);font-size:14px;font-weight:500;color:var(--color-ash);letter-spacing:0.08em;text-transform:uppercase;margin-bottom:16px;\">Modern Identity Security</p><h2 style=\"font-family:var(--font-agilesans);font-size:48px;font-weight:300;color:var(--color-white);line-height:1.2;letter-spacing:-1.1px;margin-bottom:12px;\">Secure access<br>for every human<br>and AI agent</h2><p style=\"font-family:var(--font-agilesans);font-size:16px;font-weight:400;color:var(--color-ash);line-height:1.6;max-width:400px;margin:0 auto;\">Visibility and control for humans and AI agents, built on the most trusted vault for identities, credentials, and secrets.</p></div><div style=\"display:flex;flex-direction:row;gap:12px;align-items:center;flex-wrap:wrap;justify-content:center;\"><a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:var(--color-brand-blue);color:var(--color-white);font-family:var(--font-agilesans);font-size:16px;font-weight:500;padding:12px 28px;border-radius:9999px;text-decoration:none;border:none;cursor:pointer;white-space:nowrap;\">Talk to sales</a><a href=\"#\" style=\"display:inline-flex;align-items:center;justify-content:center;background:transparent;color:var(--color-white);font-family:var(--font-agilesans);font-size:16px;font-weight:500;padding:12px 28px;border-radius:9999px;text-decoration:none;border:1.5px solid var(--color-white);cursor:pointer;white-space:nowrap;\">View plans</a></div></div>",
    "name": "Button Group \u2014 Primary + Secondary CTAs",
    "role": "",
    "description": ""
  },
