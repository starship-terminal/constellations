[
  {
    "html": "<div style=\"--color-absolute-canvas:#ffffff;--color-structural-ink:#000000;--color-graphite-metadata:#595959;--color-boundary-frame:#e2e2e2;--color-context-action-violet:#4d49fc;--font-figmasans:'Inter',sans-serif;--font-figmamono:'JetBrains Mono',monospace;--shadow-xl:rgba(0,0,0,0.1) 0px 24px 70px 0px; background:var(--color-absolute-canvas); padding:48px 40px; display:flex; flex-direction:column; gap:32px; font-family:var(--font-figmasans); width:600px; box-sizing:border-box;\">\n  <div style=\"font-size:12px; letter-spacing:0.05em; color:var(--color-graphite-metadata); font-family:var(--font-figmamono); text-transform:uppercase; margin-bottom:4px;\">Global Action Buttons</div>\n  <div style=\"display:flex; align-items:center; gap:12px; flex-wrap:wrap;\">\n    <!-- Primary Global Pill -->\n    <a href=\"#\" style=\"display:inline-flex; align-items:center; justify-content:center; background:var(--color-structural-ink); color:var(--color-absolute-canvas); font-family:var(--font-figmasans); font-size:16px; font-weight:480; line-height:1.4; letter-spacing:-0.08px; padding:10px 20px; border-radius:50px; border:none; text-decoration:none; cursor:pointer; white-space:nowrap;\">Get started for free</a>\n    <!-- Navigation Utility Pill -->\n    <a href=\"#\" style=\"display:inline-flex; align-items:center; justify-content:center; background:transparent; color:var(--color-structural-ink); font-family:var(--font-figmasans); font-size:16px; font-weight:480; line-height:1.4; letter-spacing:-0.08px; padding:9px 20px; border-radius:50px; border:1.5px solid var(--color-structural-ink); text-decoration:none; cursor:pointer; white-space:nowrap;\">Contact sales</a>\n    <!-- Log in text link -->\n    <a href=\"#\" style=\"display:inline-flex; align-items:center; justify-content:center; background:transparent; color:var(--color-structural-ink); font-family:var(--font-figmasans); font-size:16px; font-weight:400; line-height:1.4; letter-spacing:-0.08px; padding:10px 8px; border-radius:50px; border:none; text-decoration:none; cursor:pointer; white-space:nowrap;\">Log in</a>\n  </div>\n  <div style=\"width:100%; height:1px; background:var(--color-boundary-frame);\"></div>\n  <!-- Panel Execution CTA -->\n  <div style=\"display:flex; flex-direction:column; gap:12px;\">\n    <div style=\"font-size:12px; letter-spacing:0.05em; color:var(--color-graphite-metadata); font-family:var(--font-figmamono); text-transform:uppercase;\">Panel Execution CTA</div>\n    <div style=\"display:flex; gap:12px; align-items:center;\">\n      <a href=\"#\" style=\"display:inline-flex; align-items:center; justify-content:center; background:var(--color-context-action-violet); color:var(--color-absolute-canvas); font-family:var(--font-figmasans); font-size:16px; font-weight:480; line-height:1.4; letter-spacing:-0.08px; padding:10px 20px; border-radius:8px; border:none; text-decoration:none; cursor:pointer; white-space:nowrap;\">Get started</a>\n      <span style=\"font-size:14px; color:var(--color-graphite-metadata); font-family:var(--font-figmasans); letter-spacing:-0.08px;\">8px radius \u00b7 violet \u00b7 inner panel only</span>\n    </div>\n  </div>\n</div>",
    "name": "Button Group \u2014 Global Action Pills",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-absolute-canvas:#ffffff;--color-structural-ink:#000000;--color-graphite-metadata:#595959;--color-boundary-frame:#e2e2e2;--color-context-action-violet:#4d49fc;--font-figmasans:'Inter',sans-serif;--font-figmamono:'JetBrains Mono',monospace;--shadow-xl:rgba(0,0,0,0.1) 0px 24px 70px 0px; background:#f5f5f5; padding:60px 40px; font-family:var(--font-figmasans); width:600px; box-sizing:border-box; display:flex; align-items:center; justify-content:center;\">\n  <div style=\"background:var(--color-absolute-canvas); border-radius:16px; box-shadow:var(--shadow-xl); padding:24px; width:100%; max-width:520px; box-sizing:border-box;\">\n    <!-- Heading -->\n    <div style=\"margin-bottom:20px;\">\n      <p style=\"font-family:var(--font-figmasans); font-size:18px; font-weight:400; color:var(--color-graphite-metadata); letter-spacing:-0.13px; line-height:1.4; margin:0 0 6px 0;\">Start a new project</p>\n      <h2 style=\"font-family:var(--font-figmasans); font-size:24px; font-weight:520; color:var(--color-structural-ink); letter-spacing:-0.24px; line-height:1.3; margin:0;\">Make anything possible, all in Figma</h2>\n    </div>\n    <!-- Input row -->\n    <div style=\"display:flex; align-items:center; gap:8px; border:1.5px solid var(--color-boundary-frame); border-radius:8px; padding:10px 14px; background:var(--color-absolute-canvas); margin-bottom:16px;\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 18 18\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"flex-shrink:0;\"><circle cx=\"8\" cy=\"8\" r=\"5.5\" stroke=\"#595959\" stroke-width=\"1.5\"/><line x1=\"12.5\" y1=\"12.5\" x2=\"16\" y2=\"16\" stroke=\"#595959\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>\n      <input type=\"text\" placeholder=\"Prompt, code, and design from first idea...\" style=\"border:none; outline:none; flex:1; font-family:var(--font-figmasans); font-size:16px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; background:transparent; line-height:1.4;\" />\n    </div>\n    <!-- Tag row -->\n    <div style=\"display:flex; gap:8px; flex-wrap:wrap; margin-bottom:20px;\">\n      <span style=\"display:inline-flex; align-items:center; gap:5px; background:#f0f0f0; border-radius:50px; padding:5px 12px; font-family:var(--font-figmasans); font-size:13px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px;\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><circle cx=\"6\" cy=\"6\" r=\"5\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"9\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/><line x1=\"3\" y1=\"6\" x2=\"9\" y2=\"6\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>\n        Design\n      </span>\n      <span style=\"display:inline-flex; align-items:center; gap:5px; background:#f0f0f0; border-radius:50px; padding:5px 12px; font-family:var(--font-figmasans); font-size:13px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px;\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><circle cx=\"6\" cy=\"6\" r=\"5\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"9\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/><line x1=\"3\" y1=\"6\" x2=\"9\" y2=\"6\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>\n        Prototype\n      </span>\n      <span style=\"display:inline-flex; align-items:center; gap:5px; background:#f0f0f0; border-radius:50px; padding:5px 12px; font-family:var(--font-figmasans); font-size:13px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px;\">\n        <svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" fill=\"none\"><circle cx=\"6\" cy=\"6\" r=\"5\" stroke=\"#000\" stroke-width=\"1.2\"/><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"9\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/><line x1=\"3\" y1=\"6\" x2=\"9\" y2=\"6\" stroke=\"#000\" stroke-width=\"1.2\" stroke-linecap=\"round\"/></svg>\n        Dev Mode\n      </span>\n    </div>\n    <!-- CTA row -->\n    <div style=\"display:flex; justify-content:flex-end; align-items:center; gap:12px;\">\n      <span style=\"font-family:var(--font-figmasans); font-size:14px; color:var(--color-graphite-metadata); letter-spacing:-0.08px;\">Free forever \u2014 no credit card needed</span>\n      <button style=\"background:var(--color-context-action-violet); color:var(--color-absolute-canvas); font-family:var(--font-figmasans); font-size:16px; font-weight:480; letter-spacing:-0.08px; padding:10px 20px; border-radius:8px; border:none; cursor:pointer; white-space:nowrap; line-height:1.4;\">Get started</button>\n    </div>\n  </div>\n</div>",
    "name": "Prompt Input Panel",
    "role": "",
    "description": ""
  },
  {
    "html": "<div style=\"--color-absolute-canvas:#ffffff;--color-structural-ink:#000000;--color-graphite-metadata:#595959;--color-boundary-frame:#e2e2e2;--color-context-action-violet:#4d49fc;--font-figmasans:'Inter',sans-serif;--font-figmamono:'JetBrains Mono',monospace; background:var(--color-absolute-canvas); padding:48px 32px; font-family:var(--font-figmasans); width:600px; box-sizing:border-box;\">\n  <!-- Section heading -->\n  <h2 style=\"font-family:var(--font-figmasans); font-size:40px; font-weight:520; color:var(--color-structural-ink); letter-spacing:-0.5px; line-height:1.1; margin:0 0 32px 0;\">Explore what people are making</h2>\n  <!-- 2-column grid -->\n  <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:24px 20px;\">\n    <!-- Card 1 -->\n    <div style=\"border-radius:0px; overflow:hidden;\">\n      <div style=\"width:100%; height:155px; background:linear-gradient(135deg,#0d0d2b 0%,#1a1060 50%,#2d1b8a 100%); border-radius:0px; overflow:hidden; position:relative;\">\n        <div style=\"position:absolute; inset:0; display:flex; align-items:center; justify-content:center;\">\n          <div style=\"width:60px; height:60px; border-radius:50%; border:2px solid #00b6ff; box-shadow:0 0 20px #00b6ff66;\"></div>\n          <div style=\"position:absolute; width:100px; height:2px; background:linear-gradient(90deg,transparent,#00b6ff,transparent);\"></div>\n        </div>\n      </div>\n      <div style=\"padding-top:12px;\">\n        <p style=\"font-family:var(--font-figmasans); font-size:16px; font-weight:480; color:var(--color-structural-ink); letter-spacing:-0.08px; line-height:1.3; margin:0 0 8px 0;\">Virtual Teleportation Portal App</p>\n        <div style=\"display:flex; align-items:center; gap:6px;\">\n          <div style=\"width:18px; height:18px; border-radius:50%; background:#d4a855; flex-shrink:0;\"></div>\n          <a href=\"#\" style=\"font-family:var(--font-figmasans); font-size:14px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; text-decoration:underline; text-underline-offset:2px;\">Masaya Takizawa</a>\n        </div>\n      </div>\n    </div>\n    <!-- Card 2 -->\n    <div style=\"border-radius:0px; overflow:hidden;\">\n      <div style=\"width:100%; height:155px; background:linear-gradient(135deg,#1a2a1a 0%,#0f1f2a 100%); border-radius:0px; overflow:hidden; position:relative; display:flex; align-items:flex-start; padding:16px; box-sizing:border-box;\">\n        <div style=\"background:#212b2b; border-radius:6px; padding:8px 12px;\">\n          <p style=\"font-family:var(--font-figmasans); font-size:14px; font-weight:700; color:#ffffff; margin:0 0 2px 0; letter-spacing:-0.08px;\">Bubbles DS</p>\n          <p style=\"font-family:var(--font-figmasans); font-size:11px; font-weight:400; color:#8aadad; margin:0; letter-spacing:0;\">Figma \u2014 Tokens \u2014 v1.4</p>\n        </div>\n      </div>\n      <div style=\"padding-top:12px;\">\n        <p style=\"font-family:var(--font-figmasans); font-size:16px; font-weight:480; color:var(--color-structural-ink); letter-spacing:-0.08px; line-height:1.3; margin:0 0 8px 0;\">Bubbles Design System</p>\n        <div style=\"display:flex; align-items:center; gap:6px;\">\n          <div style=\"width:18px; height:18px; border-radius:50%; background:#6b4e9e; flex-shrink:0;\"></div>\n          <a href=\"#\" style=\"font-family:var(--font-figmasans); font-size:14px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; text-decoration:underline; text-underline-offset:2px;\">Raul Marin Calleja</a>\n        </div>\n      </div>\n    </div>\n    <!-- Card 3 -->\n    <div style=\"border-radius:0px; overflow:hidden;\">\n      <div style=\"width:100%; height:155px; background:#c8c4be; border-radius:0px; overflow:hidden; position:relative;\">\n        <div style=\"position:absolute; bottom:10px; left:12px; right:12px; height:3px; background:linear-gradient(90deg,#ff4444,#ff8800,#ffcc00,#33cc33,#3399ff,#9933ff); border-radius:2px;\"></div>\n        <div style=\"position:absolute; top:20px; left:20px; right:20px; bottom:24px; display:flex; align-items:center; justify-content:center;\">\n          <svg viewBox=\"0 0 120 60\" width=\"120\" height=\"60\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10 40 Q30 10 50 35 Q70 55 90 20 Q100 10 115 30\" stroke=\"#111\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/></svg>\n        </div>\n      </div>\n      <div style=\"padding-top:12px;\">\n        <p style=\"font-family:var(--font-figmasans); font-size:16px; font-weight:480; color:var(--color-structural-ink); letter-spacing:-0.08px; line-height:1.3; margin:0 0 8px 0;\">Virtual Graffiti Wall</p>\n        <div style=\"display:flex; align-items:center; gap:6px;\">\n          <div style=\"width:18px; height:18px; border-radius:50%; background:#4a9e6e; flex-shrink:0;\"></div>\n          <a href=\"#\" style=\"font-family:var(--font-figmasans); font-size:14px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; text-decoration:underline; text-underline-offset:2px;\">Seungmee Lee</a>\n        </div>\n      </div>\n    </div>\n    <!-- Card 4 -->\n    <div style=\"border-radius:0px; overflow:hidden;\">\n      <div style=\"width:100%; height:155px; background:#1a1a1a; border-radius:0px; overflow:hidden; position:relative; display:flex; align-items:center; justify-content:center;\">\n        <div style=\"width:80px; height:80px; border:3px solid #ccff00; border-radius:4px; position:relative;\">\n          <div style=\"position:absolute; inset:6px; display:grid; grid-template-columns:repeat(5,1fr); grid-template-rows:repeat(5,1fr); gap:1px;\">\n            <div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div>\n            <div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div>\n            <div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div>\n            <div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div>\n            <div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div><div style=\"background:transparent;\"></div><div style=\"background:#ccff00;\"></div>\n          </div>\n        </div>\n      </div>\n      <div style=\"padding-top:12px;\">\n        <p style=\"font-family:var(--font-figmasans); font-size:16px; font-weight:480; color:var(--color-structural-ink); letter-spacing:-0.08px; line-height:1.3; margin:0 0 8px 0;\">Pixel Editor</p>\n        <div style=\"display:flex; align-items:center; gap:6px;\">\n          <div style=\"width:18px; height:18px; border-radius:50%; background:#2d2d2d; flex-shrink:0;\"></div>\n          <a href=\"#\" style=\"font-family:var(--font-figmasans); font-size:14px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; text-decoration:underline; text-underline-offset:2px;\">Ayaneshu Bhardwaj</a>\n        </div>\n      </div>\n    </div>\n  </div>\n  <!-- Explore more -->\n  <div style=\"text-align:center; margin-top:36px;\">\n    <a href=\"#\" style=\"font-family:var(--font-figmasans); font-size:16px; font-weight:400; color:var(--color-structural-ink); letter-spacing:-0.08px; text-decoration:underline; text-underline-offset:3px;\">Explore more</a>\n  </div>\n</div>",
    "name": "Community Artifact Cards",
    "role": "",
    "description": ""
  },
  {
    "name": "Global Action Pill",
    "role": "Page-level CTA and authentication boundaries",
    "description": "backgroundColor #000000, color #ffffff, extreme borderRadius 50px, padding 8px 18px. Typographically set in 16px weight 480."
  },
  {
    "name": "Navigation Utility Pill",
    "role": "Secondary global actions structurally matched to primary pill",
    "description": "Transparent background with a 1.5px solid #000000 border, text #000000. borderRadius 50px, padding 8px 18px."
  },
  {
    "name": "Prompt Input Panel",
    "role": "The central elevated workspace orchestrator",
    "description": "backgroundColor #ffffff, borderRadius 16px. Padding 16px all around, defined by an aggressive standalone shadow: rgba(0,0,0,0.1) 0px 24px 70px 0px."
  },
  {
    "name": "Panel Execution CTA",
    "role": "The localized trigger within a Prompt Input Panel",
    "description": "backgroundColor #4d49fc, color #ffffff. Notably distinct borderRadius of 8px (differentiating it from 50px global pills), padding 8px 16px."
  },
  {
    "name": "Community Artifact Card",
    "role": "Container framework for raw user-generated output",
    "description": "Strict 0px borderRadius grid cell. Image spans 100% full width to bleed at the top, bottom metadata stack uses 12px vertical gaps and no horizontal bounding padding against the grid frame."
  }
]
