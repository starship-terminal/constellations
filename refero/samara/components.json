    "html": "<div style=\"--color-sky-blue:#0096f7;--color-signal-orange:#ff4000;--color-ink:#000000;--color-pure-white:#ffffff;--color-parchment:#fdfdf7;--color-warm-sand:#f5f2de;--color-driftwood:#e7e3e1;--color-ash:#d3d3d3;--color-stone:#999999;--color-graphite:#666666;--font-regola:'Plus Jakarta Sans',Manrope,sans-serif;box-sizing:border-box;width:600px;background:var(--color-parchment);padding:40px;font-family:var(--font-regola);\"><div style=\"background:var(--color-warm-sand);border-radius:18px;padding:36px;box-shadow:rgba(0,0,0,0.12) 0px 0.5px 2px 0px;display:flex;flex-direction:column;gap:24px;\"><div style=\"width:100%;height:200px;background:linear-gradient(135deg,#e2ddc8 0%,#ccc8b0 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;\"><div style=\"display:flex;flex-direction:column;align-items:center;gap:6px;\"><div style=\"width:100px;height:48px;background:#4a5240;border-radius:6px 6px 0 0;position:relative;\"><div style=\"position:absolute;bottom:0;left:10px;width:18px;height:28px;background:#2a3020;border-radius:3px 3px 0 0;\"></div><div style=\"position:absolute;top:12px;right:12px;width:20px;height:14px;background:rgba(255,255,255,0.3);border-radius:2px;\"></div></div><div style=\"width:116px;height:8px;background:#3a3a3a;border-radius:0 0 3px 3px;\"></div></div></div><div style=\"display:flex;flex-direction:column;gap:8px;\"><div style=\"display:flex;align-items:baseline;justify-content:space-between;gap:12px;\"><h2 style=\"font-family:var(--font-regola);font-size:48px;line-height:1;letter-spacing:-1.3px;color:var(--color-ink);margin:0;font-weight:400;\">XL 10</h2><span style=\"font-family:var(--font-regola);font-size:14px;line-height:1.5;letter-spacing:-0.56px;color:var(--color-graphite);font-weight:400;\">New model</span></div><p style=\"font-family:var(--font-regola);font-size:18px;line-height:1.33;letter-spacing:-0.18px;color:var(--color-ink);margin:0;font-weight:400;\">Introducing Backyard XL 10: Two bedrooms, two