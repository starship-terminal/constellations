  {
    "html": "<style>\n  :root {\n    --color-cerulean-surge: #60CDFF;\n    --color-cobalt-vault: #002991;\n    --color-midnight: #000000;\n    --color-snow: #FFFFFF;\n    --font-plain: 'DM Sans', Inter, sans-serif;\n    --font-paypal-pro: 'Sohne', 'Aktiv Grotesk', 'Neue Haas Grotesk Display', sans-serif;\n  }\n\n  .toggle-wrapper {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--color-cerulean-surge);\n    padding: 64px 24px;\n    font-family: var(--font-plain);\n    box-sizing: border-box;\n    width: 100%;\n  }\n\n  .toggle-pill {\n    display: inline-flex;\n    align-items: center;\n    background: var(--color-midnight);\n    border-radius: 1000px;\n    padding: 6px;\n    gap: 2px;\n  }\n\n  .toggle-option {\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    line-height: 1.5;\n    padding: 10px 28px;\n    border-radius: 1000px;\n    cursor: pointer;\n    transition: background 0.18s, color 0.18s;\n    user-select: none;\n    border: none;\n    outline: none;\n  }\n\n  .toggle-option.active {\n    background: var(--color-snow);\n    color: var(--color-midnight);\n  }\n\n  .toggle-option.inactive {\n    background: transparent;\n    color: var(--color-snow);\n  }\n</style>\n<div class=\"toggle-wrapper\">\n  <div class=\"toggle-pill\">\n    <button class=\"toggle-option active\">Personal</button>\n    <button class=\"toggle-option inactive\">Negocios</button>\n  </div>\n</div>",
    "name": "Personal / Negocios Toggle Pill",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-cobalt-vault: #002991;\n    --color-snow: #FFFFFF;\n    --color-cerulean-surge: #60CDFF;\n    --font-paypal-pro: 'Sohne', 'Aktiv Grotesk', 'Neue Haas Grotesk Display', sans-serif;\n    --font-plain: 'DM Sans', Inter, sans-serif;\n    --shadow-xl: rgba(0,0,0,0.08) 0px 24px 48px 0px;\n  }\n\n  .headline-section {\n    background: var(--color-cobalt-vault);\n    padding: 56px 48px 64px 48px;\n    box-sizing: border-box;\n    width: 100%;\n    font-family: var(--font-paypal-pro);\n    display: flex;\n    flex-direction: column;\n    gap: 0;\n  }\n\n  .headline-stack {\n    display: flex;\n    flex-direction: column;\n    gap: 0px;\n    margin-bottom: 40px;\n  }\n\n  .headline-word {\n    font-family: var(--font-paypal-pro);\n    font-size: 67px;\n    font-weight: 900;\n    line-height: 1.08;\n    letter-spacing: -0.03em;\n    display: block;\n  }\n\n  .headline-word.active {\n    color: var(--color-snow);\n    opacity: 1;\n  }\n\n  .headline-word.inactive {\n    color: var(--color-snow);\n    opacity: 0.32;\n  }\n\n  .headline-body {\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 400;\n    color: var(--color-snow);\n    letter-spacing: -0.02em;\n    line-height: 1.5;\n    margin-bottom: 24px;\n    max-width: 320px;\n  }\n\n  .headline-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n    border: 1.5px solid var(--color-snow);\n    color: var(--color-snow);\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    padding: 14px 33px;\n    border-radius: 1000px;\n    cursor: pointer;\n    width: fit-content;\n    text-decoration: none;\n  }\n\n  .headline-btn:hover {\n    background: rgba(255,255,255,0.1);\n  }\n\n  .app-card {\n    background: rgba(0,0,0,0.30);\n    border-radius: 30px;\n    padding: 27px;\n    max-width: 280px;\n    margin-top: 40px;\n    align-self: flex-end;\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 20px;\n  }\n\n  .app-card-header {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    width: 100%;\n  }\n\n  .back-arrow {\n    color: var(--color-snow);\n    font-size: 18px;\n  }\n\n  .app-card-title {\n    font-family: var(--font-paypal-pro);\n    font-size: 18px;\n    font-weight: 900;\n    color: var(--color-snow);\n    letter-spacing: -0.02em;\n  }\n\n  .avatar-placeholder {\n    width: 72px;\n    height: 72px;\n    border-radius: 50%;\n    background: linear-gradient(135deg, #b87850 0%, #d4956a 100%);\n    flex-shrink: 0;\n  }\n\n  .app-amount {\n    font-family: var(--font-paypal-pro);\n    font-size: 55px;\n    font-weight: 900;\n    color: var(--color-snow);\n    letter-spacing: -0.03em;\n    line-height: 1;\n  }\n\n  .currency-pill {\n    border: 1.5px solid var(--color-snow);\n    border-radius: 1000px;\n    padding: 6px 18px;\n    font-family: var(--font-plain);\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--color-snow);\n    letter-spacing: -0.02em;\n  }\n</style>\n<div class=\"headline-section\">\n  <div class=\"headline-stack\">\n    <span class=\"headline-word active\">Enviar</span>\n    <span class=\"headline-word inactive\">Recibir</span>\n    <span class=\"headline-word inactive\">Bote</span>\n  </div>\n  <p class=\"headline-body\">Env\u00eda dinero de forma r\u00e1pida.</p>\n  <a href=\"#\" class=\"headline-btn\">Enviar dinero</a>\n\n  <div class=\"app-card\">\n    <div class=\"app-card-header\">\n      <span class=\"back-arrow\">&#8592;</span>\n      <span class=\"app-card-title\">Enviar dinero</span>\n    </div>\n    <div class=\"avatar-placeholder\"></div>\n    <div class=\"app-amount\">35 \u20ac</div>\n    <div class=\"currency-pill\">EURO \u2193</div>\n  </div>\n</div>",
    "name": "Animated Headline Stack \u2014 Enviar / Recibir / Bote",
    "role": "",
    "description": ""
  },
  {
    "html": "<style>\n  :root {\n    --color-cerulean-surge: #60CDFF;\n    --color-cobalt-vault: #002991;\n    --color-midnight: #000000;\n    --color-snow: #FFFFFF;\n    --color-parchment: #F1EFEA;\n    --font-plain: 'DM Sans', Inter, sans-serif;\n    --font-paypal-pro: 'Sohne', 'Aktiv Grotesk', 'Neue Haas Grotesk Display', sans-serif;\n  }\n\n  .button-showcase {\n    background: var(--color-snow);\n    padding: 48px 40px;\n    box-sizing: border-box;\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n    gap: 32px;\n    font-family: var(--font-plain);\n  }\n\n  .btn-row-label {\n    font-family: var(--font-plain);\n    font-size: 10px;\n    font-weight: 500;\n    letter-spacing: 0.08em;\n    text-transform: uppercase;\n    color: #888;\n    margin-bottom: 12px;\n  }\n\n  .btn-row {\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n    align-items: center;\n  }\n\n  /* Ghost Black \u2014 on white */\n  .btn-ghost-black {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n    border: 1.5px solid var(--color-midnight);\n    color: var(--color-midnight);\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    padding: 14px 33px;\n    border-radius: 1000px;\n    cursor: pointer;\n    text-decoration: none;\n    line-height: 1.2;\n  }\n\n  /* Solid Black \u2014 on white */\n  .btn-solid-black {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: var(--color-midnight);\n    border: 1.5px solid var(--color-midnight);\n    color: var(--color-snow);\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    padding: 14px 33px;\n    border-radius: 1000px;\n    cursor: pointer;\n    text-decoration: none;\n    line-height: 1.2;\n  }\n\n  /* Ghost White surface \u2014 on blue */\n  .blue-surface {\n    background: var(--color-cerulean-surge);\n    border-radius: 24px;\n    padding: 28px 24px;\n  }\n\n  .btn-ghost-white {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    background: transparent;\n    border: 1.5px solid var(--color-snow);\n    color: var(--color-snow);\n    font-family: var(--font-plain);\n    font-size: 16px;\n    font-weight: 500;\n    letter-spacing: -0.02em;\n    padding: 14px 33px;\n    border-radius: 1000px;\n    cursor: pointer;\n    text-decoration: none;\n    line-height: 1.2;\n  }\n\n  /* Navy surface */\n  .navy-surface {\n    background: var(--color-cobalt-vault);\n    border-radius: 24px;\n    padding: 28px 24px;\n  }\n\n  /* QR App Block */\n  .qr-block {\n    background: var(--color-midnight);\n    border-radius: 12px;\n    padding: 14px 16px;\n    display: inline-flex;\n    align-items: center;\n    gap: 16px;\n    max-width: 280px;\n  }\n\n  .qr-text {\n    font-family: var(--font-plain);\n    font-size: 14px;\n    font-weight: 500;\n    color: var(--color-cerulean-surge);\n    letter-spacing: -0.02em;\n    line-height: 1.4;\n  }\n\n  .qr-placeholder {\n    width: 52px;\n    height: 52px;\n    background: var(--color-snow);\n    border-radius: 6px;\n    flex-shrink: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .qr-grid {\n    display: grid;\n    grid-template-columns: repeat(5,8px);\n    grid-template-rows: repeat(5,8px);\n    gap: 1px;\n  }\n\n  .qr-cell {\n    background: var(--color-midnight);\n    border-radius: 1px;\n  }\n\n  .qr-cell.w {\n    background: var(--color-snow);\n  }\n\n  .section-divider {\n    width: 100%;\n    height: 1px;\n    background: #eee;\n  }\n</style>\n<div class=\"button-showcase\">\n  <!-- On white: ghost black + solid black -->\n  <div>\n    <div class=\"btn-row-label\">CTAs \u2014 Surface: White</div>\n    <div class=\"btn-row\">\n      <a href=\"#\" class=\"btn-ghost-black\">Iniciar sesi\u00f3n</a>\n      <a href=\"#\" class=\"btn-solid-black\">Crear cuenta</a>\n    </div>\n  </div>\n\n  <div class=\"section-divider\"></div>\n\n  <!-- On sky blue: ghost white -->\n  <div>\n    <div class=\"btn-row-label\">CTAs \u2014 Surface: Sky Blue (#60CDFF)</div>\n    <div class=\"blue-surface\">\n      <div class=\"btn-row\">\n        <a href=\"#\" class=\"btn-ghost-white\">Crear cuenta gratis</a>\n        <a href=\"#\" class=\"btn-ghost-white\">M\u00e1s informaci\u00f3n</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"section-divider\"></div>\n\n  <!-- On navy: ghost white -->\n  <div>\n    <div class=\"btn-row-label\">CTAs \u2014 Surface: Navy (#002991)</div>\n    <div class=\"navy-surface\">\n      <div class=\"btn-row\">\n        <a href=\"#\" class=\"btn-ghost-white\">Enviar dinero</a>\n        <a href=\"#\" class=\"btn-ghost-white\">Ver m\u00e1s</a>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"section-divider\"></div>\n\n  <!-- QR App Download Block -->\n  <div>\n    <div class=\"btn-row-label\">App Download Block</div>\n    <div class=\"qr-block\">\n      <div class=\"qr-text\">Descargar<br>la app<br>PayPal</div>\n      <div class=\"qr-placeholder\">\n        <div class=\"qr-grid\">\n          <div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell w\"></div><div class=\"qr-cell\"></div>\n          <div class=\"qr-cell\"></div><div class=\"qr-cell w\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div>\n          <div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell w\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div>\n          <div class=\"qr-cell w\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell w\"></div><div class=\"qr-cell\"></div>\n          <div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div><div class=\"qr-cell\"></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
    "name": "Button Group \u2014 Ghost Pills",
    "role": "",
    "description": ""
  },
  {
    "name": "Ghost Pill Button \u2014 White",
    "role": "Primary CTA on dark or colored (blue/navy) backgrounds",
    "description": "Transparent fill, #FFFFFF 1px border, #FFFFFF text, 1000px border-radius, 14px vertical padding, 33px horizontal padding. PayPal Pro or Plain weight 500. Used on sky-blue and navy sections where a solid fill would compete with the background energy."
  },
  {
    "name": "Ghost Pill Button \u2014 Black",
    "role": "Secondary CTA on white or light backgrounds",
    "description": "Transparent fill, #000000 1px border, #000000 text, 1000px border-radius, 14px vertical padding, 33px horizontal padding. Same geometry as White variant \u2014 color is the only difference."
  },
  {
    "name": "Inline Text Button",
    "role": "Tertiary action, inline link-style button within body copy",
    "description": "Transparent fill, #000000 1px border, #000000 text, 0px border-radius (square corners), 1px vertical padding, 6px horizontal padding. Functions as an underline-style call-to-action without pill shape."
  },
  {
    "name": "Rounded CTA Button",
    "role": "App download / secondary marketing CTA",
    "description": "Transparent fill, #000000 1px border, #000000 text, 25px border-radius (not full pill), 8px vertical padding, 32px right / 12px left padding (asymmetric \u2014 accommodates icon on left). Used for the 'Descargar la app' block."
  },
  {
    "name": "Frosted App Card",
    "role": "In-page mobile app screen preview overlay",
    "description": "Background rgba(0,0,0,0.30), border-radius 30px, 27px padding all sides, no box-shadow. Appears floating over lifestyle photography, simulating a frosted-glass phone UI with white text inside."
  },
  {
    "name": "Navy Feature Card",
    "role": "Highlighted product feature block with strong depth",
    "description": "Background #002991, border-radius 0px (sharp), box-shadow rgba(0,0,0,0.08) 0px 24px 48px 0px. The only component using elevation \u2014 the 48px blur shadow grounds the navy card against white sections without making it feel heavy."
  },
  {
    "name": "Full-Bleed Photo Section",
    "role": "Lifestyle hero band with oversized type overlay",
    "description": "Photography fills 100vw with no border-radius or container. PayPal Pro weight 900 at 99\u2013181px in #FFFFFF bleeds off crop edges \u2014 letters are cropped intentionally at both sides. No overlay scrim; high-key photography provides natural contrast for white text."
  },
  {
    "name": "Top Navigation Bar",
    "role": "Sticky global navigation",
    "description": "#FFFFFF background, 88px height, PayPal logo left-aligned, nav links in Plain 16px weight 400 #000000, 'Iniciar sesi\u00f3n' as Ghost Pill (black) and 'Crear cuenta' as solid black pill (#000000 fill, #FFFFFF text, 1000px radius, 14px/33px padding) on the right."
  },
  {
    "name": "QR Download Block",
    "role": "App download prompt with QR code",
    "description": "#000000 background, 8-12px border-radius, #FFFFFF text in Plain weight 500 at 14px, QR code image right-aligned. Appears fixed or sticky at bottom-right corner of hero sections."
  },
  {
    "name": "Animated Headline Stack",
    "role": "Feature section cycling headline (Enviar / Recibir / Bote)",
    "description": "#FFFFFF text, PayPal Pro weight 900 at 45\u201367px on #002991 background. Active word is full opacity white; inactive words appear in lower opacity (approximately 40%) in the same position, indicating the cycling state."
  }
]
